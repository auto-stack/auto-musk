// ============================================================
// Chats/Forge API (Phase 7) — 对应 useForge.ts 的 /api/chats/* 调用。
// 类型从 web/src/types/forge.ts 映射。
// ============================================================

pub type ForgeMessage = {
    id: str,
    role: str,
    content: str,
    timestamp: int,
    tool_calls: []str,
    profession_id: str,
    thinking: str,
}

pub type ForgeSession = {
    id: str,
    project_path: str,
    status: str,
    phase: str,
    messages: []ForgeMessage,
    active_profession: str,
    pending_spec_changes: []SpecChange,
}

// spec 变更项（对应 web/src/types/forge.ts SpecChange，GateCard 的 changes prop）。
pub type SpecChange = {
    section_id: str,
    old_content: str,
    new_content: str,
    old_status: str,
    new_status: str,
}

pub type ForgeSessionSummary = {
    id: str,
    name: str,
    preview: str,
    message_count: int,
    last_activity: int,
}

// 后端实际返回有包装层：{sessions:[...]} / {session:{...}}
pub type SessionListResponse = {
    sessions: []ForgeSessionSummary,
}
pub type SessionDetailResponse = {
    session: ForgeSession,
}

