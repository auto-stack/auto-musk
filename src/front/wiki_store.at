// wiki_store.at — Wiki 知识库状态 store（对应 web/src/composables/useWiki.ts）
//
// 单例 store：pages/page/tree/raw_tree + CRUD + search。
// Plan 022 Phase 6: WikiView 的数据层。

use back.api: wiki_list_pages, wiki_get_page, wiki_create_page, wiki_update_page, wiki_delete_page, wiki_search, wiki_tree, wiki_raw_tree

store WikiStore {
    model {
        var pages []Value = []
        var current_page Value = null
        var tree []Value = []
        var raw_tree []Value = []
        var loading bool = false
        var error str = ""
        var search_query str = ""
        var search_results []Value = []
        var workspace str = ""
    }

    msg Msg {
        Init,
        LoadPages,
        LoadPage(str),
        CreatePage(str, str, str),
        UpdatePage(str, str),
        DeletePage(str),
        Search(str),
        LoadTree,
        LoadRawTree,
        SetError(str),
    }

    on {
        // Init: 从 localStorage 读 workspace（为空则用默认值），加载 pages + tree。
        .Init -> {
            let ws = localStorage.getItem("musk_workspace");
            if ws != None {
                .workspace = ws
            } else {
                .workspace = "musk-demo"
            };
            LoadPages();
            LoadTree();
            LoadRawTree()
        }

        // LoadPages: GET /api/forge/wiki/{project}/pages。后端返回 {pages:[...]}。
        .LoadPages -> {
            .loading = true;
            .error = "";
            let resp = wiki_list_pages(.workspace);
            .loading = false;
            .pages = resp.pages
        }

        // LoadPage(slug): GET /api/forge/wiki/{project}/page/{slug}。后端返回 {page:{...}}。
        .LoadPage(slug) -> {
            .error = "";
            let resp = wiki_get_page(.workspace, slug);
            if resp != None {
                .current_page = resp.page
            }
        }

        // CreatePage(slug, title, content): POST 新建页面。后端返回 {page:{...}}。
        .CreatePage(slug, title, content) -> {
            .error = "";
            let resp = wiki_create_page(.workspace, slug, title, content, "manual", []);
            if resp != None {
                .current_page = resp.page;
                LoadPages()
            }
        }

        // UpdatePage(slug, content): PUT 更新页面内容。
        .UpdatePage(slug, content) -> {
            .error = "";
            if .current_page != null {
                let resp = wiki_update_page(.workspace, slug, content, .current_page.title, .current_page.tags);
                if resp != None {
                    .current_page = resp.page
                }
            }
        }

        // DeletePage(slug): DELETE 删除页面。
        .DeletePage(slug) -> {
            .error = "";
            wiki_delete_page(.workspace, slug);
            if .error == "" {
                .current_page = null;
                LoadPages()
            }
        }

        // Search(q): POST /api/forge/wiki/{project}/search。
        .Search(q) -> {
            .search_query = q;
            if q != "" {
                let resp = wiki_search(.workspace, q);
                .search_results = resp.results
            } else {
                .search_results = []
            }
        }

        // LoadTree: GET /api/forge/wiki/{project}/tree。
        .LoadTree -> {
            let resp = wiki_tree(.workspace);
            .tree = resp
        }

        // LoadRawTree: GET /api/forge/raw/{project}/tree。
        .LoadRawTree -> {
            let resp = wiki_raw_tree(.workspace);
            .raw_tree = resp
        }

        .SetError(msg) -> { .error = msg }
    }
}
