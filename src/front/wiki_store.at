// wiki_store.at — Wiki 知识库状态 store（对应 web/src/composables/useWiki.ts）
//
// 单例 store：pages/page/tree/raw_tree + CRUD + search。
// Plan 022 Phase 6: WikiView 的数据层。

use back.api: wiki_list_pages, wiki_get_page, wiki_create_page, wiki_update_page, wiki_delete_page, wiki_search, wiki_tree, wiki_raw_tree, wiki_raw_delete_file, wiki_raw_mkdir

store WikiStore {
    model {
        var pages []Value = []
        var current_page Value = null
        var tree []Value = []
        var raw_tree []Value = []
        var loading bool = false
        var error str = ""
        var search_query str = ""
        var search_results []Value = []
        var workspace str = ""
        // raw 操作状态（Plan 022 遗留：DropZone 完整闭环）。
        // active_raw_path = 当前选中的 raw 文件节点 path（viewing-raw 预览用）。
        var active_raw_path str = ""
        var upload_progress Value = null
    }

    msg Msg {
        Init,
        LoadPages,
        LoadPage(str),
        CreatePage(str, str, str),
        UpdatePage(str, str),
        DeletePage(str),
        Search(str),
        LoadTree,
        LoadRawTree,
        UploadRawFiles,
        DeleteRawFile(str),
        CreateRawFolder(str),
        SelectRawFile(str),
        SetUploadProgress(Value),
        SetError(str),
    }

    on {
        // Init: 从 localStorage 读 workspace（为空则用默认值），加载 pages + tree。
        .Init -> {
            let ws = localStorage.getItem("musk_workspace");
            if ws != None {
                .workspace = ws
            } else {
                .workspace = "musk-demo"
            };
            LoadPages();
            LoadTree();
            LoadRawTree()
        }

        // LoadPages: GET /api/forge/wiki/{project}/pages。后端返回 {pages:[...]}。
        .LoadPages -> {
            .loading = true;
            .error = "";
            let resp = wiki_list_pages(.workspace);
            .loading = false;
            .pages = resp.pages
        }

        // LoadPage(slug): GET /api/forge/wiki/{project}/page/{slug}。后端返回 {page:{...}}。
        .LoadPage(slug) -> {
            .error = "";
            let resp = wiki_get_page(.workspace, slug);
            if resp != None {
                .current_page = resp.page
            }
        }

        // CreatePage(slug, title, content): POST 新建页面。后端返回 {page:{...}}。
        .CreatePage(slug, title, content) -> {
            .error = "";
            let resp = wiki_create_page(.workspace, slug, title, content, "manual", []);
            if resp != None {
                .current_page = resp.page;
                LoadPages()
            }
        }

        // UpdatePage(slug, content): PUT 更新页面内容。
        .UpdatePage(slug, content) -> {
            .error = "";
            if .current_page != null {
                let resp = wiki_update_page(.workspace, slug, content, .current_page.title, .current_page.tags);
                if resp != None {
                    .current_page = resp.page
                }
            }
        }

        // DeletePage(slug): DELETE 删除页面。
        .DeletePage(slug) -> {
            .error = "";
            wiki_delete_page(.workspace, slug);
            if .error == "" {
                .current_page = null;
                LoadPages()
            }
        }

        // Search(q): POST /api/forge/wiki/{project}/search。
        .Search(q) -> {
            .search_query = q;
            if q != "" {
                let resp = wiki_search(.workspace, q);
                .search_results = resp.results
            } else {
                .search_results = []
            }
        }

        // LoadTree: GET /api/forge/wiki/{project}/tree。
        .LoadTree -> {
            let resp = wiki_tree(.workspace);
            .tree = resp
        }

        // LoadRawTree: GET /api/forge/raw/{project}/tree。
        .LoadRawTree -> {
            let resp = wiki_raw_tree(.workspace);
            .raw_tree = resp
        }

        // DeleteRawFile(path): DELETE /api/forge/raw/{project}/file/{path}。
        // 删除成功后刷新 raw tree。对齐原版 useWiki.ts:197-208 deleteRawFile。
        .DeleteRawFile(path) -> {
            wiki_raw_delete_file(.workspace, path);
            if .error == "" {
                if .active_raw_path == path {
                    .active_raw_path = ""
                };
                LoadRawTree()
            }
        }

        // CreateRawFolder(path): POST /api/forge/raw/{project}/mkdir。
        // 创建成功后刷新 raw tree。对齐原版 useWiki.ts:210-223 createRawFolder。
        .CreateRawFolder(path) -> {
            wiki_raw_mkdir(.workspace, path);
            if .error == "" {
                LoadRawTree()
            }
        }

        // UploadRawFiles: 上传完成信号（WikiNav DropZone 上传成功后 emit 'uploaded'
        // → wiki_view.at → 此处刷新 raw tree）。上传本身走逃生舱 raw_upload.ts XHR。
        .UploadRawFiles -> {
            .upload_progress = null;
            LoadRawTree()
        }

        // SelectRawFile(path): 记录当前选中的 raw 文件（viewing-raw 预览）。
        // 对齐原版 WikiView.vue:364-374 selectRawNode（文本读取在 view 层逃生舱）。
        .SelectRawFile(path) -> {
            .active_raw_path = path
        }

        .SetUploadProgress(p) -> { .upload_progress = p }

        .SetError(msg) -> { .error = msg }
    }
}
