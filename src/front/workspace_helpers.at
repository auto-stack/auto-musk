// workspace_helpers.at — WorkspaceSelector 数据逻辑 + ensure_workspace
// （单一真源，替代 workspace_helpers.ts + ensure_workspace.ts）
//
// Plan 029 T13：Http.get/post（F8，fetch 拦截器自动注入 jwt+workspace）+
// storage 内建（localStorage）+ 手写 find（.at 无数组 find）。
// 全部静默失败路径与原版一致（列表空/None 兜底）。
// workspace_status 的 id 走 ?workspace= 查询参数（对齐后端 WorkspaceQuery）。

/** 拉取最近打开的工作区列表（静默失败返回 []）。 */
fn ws_load_recent() []Value {
    try {
        let data = Http.get("/api/workspace/list")
        return data.workspaces ?? []
    } catch {
        return []
    }
}

/** 当前工作区元信息（localStorage wid + status；无/失败返回 None）。 */
fn ws_load_current() Value {
    let wid = storage.get("musk_workspace") ?? ""
    if wid == "" {
        return None
    }
    try {
        let data = Http.get("/api/workspace/status?workspace=" + encodeURIComponent(wid))
        if data.workspace != None {
            return data.workspace
        }
        return data
    } catch {
        return None
    }
}

/** 从最近列表按 id 找工作区（无则 None）。 */
fn ws_find(recent []Value, id str) Value {
    for w in recent {
        if w.id == id {
            return w
        }
    }
    return None
}

/** 弹出系统文件夹选择器（本机 serve 进程代弹原生对话框；取消/失败返回 None）。 */
fn ws_pick() Value {
    try {
        let data = Http.post("/api/workspace/pick", {})
        return data.path ?? None
    } catch {
        return None
    }
}

/** 打开/切换到指定路径的 workspace（失败返回 None）。响应为
 * {workspace: meta} 包裹结构，此处解包成 meta 本体（对齐 ws_load_current）。 */
fn ws_open(path str) Value {
    try {
        let data = Http.post("/api/workspace/open", { "path": path })
        if data.workspace != None {
            return data.workspace
        }
        return data
    } catch {
        return None
    }
}

/** App Init 时确保有默认 workspace（localStorage 无则选第一个非空项）。 */
fn ensure_workspace() {
    let existing = storage.get("musk_workspace") ?? ""
    if existing != "" {
        return
    }
    let token = storage.get("musk_jwt") ?? ""
    if token == "" {
        return
    }
    try {
        let data = Http.get("/api/workspace/list")
        let workspaces = data.workspaces ?? []
        var chosen = None
        for w in workspaces {
            if w.is_empty == false {
                chosen = w
                break
            }
        }
        if chosen == None {
            if workspaces.length > 0 {
                chosen = workspaces[0]
            }
        }
        if chosen != None {
            storage.set("musk_workspace", chosen.id)
        }
    } catch {
        // 静默失败——workspace 不是阻塞项（原 catch {}）
        return
    }
}
