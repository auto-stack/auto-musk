// workspace_helpers.at — WorkspaceSelector 数据逻辑 + ensure_workspace
// （单一真源，替代 workspace_helpers.ts + ensure_workspace.ts）
//
// Plan 029 T13：Http.get/post（F8，fetch 拦截器自动注入 jwt+workspace）+
// storage 内建（localStorage）+ 手写 find（.at 无数组 find）。
// 全部静默失败路径与原版一致（列表空/None 兜底）。
// workspace_status 的 id 走 ?workspace= 查询参数（对齐后端 WorkspaceQuery）。

/** 拉取最近打开的工作区列表（静默失败返回 []）。 */
fn ws_load_recent() []Value {
    try {
        let data = Http.get("/api/workspace/list")
        return data.workspaces ?? []
    } catch {
        return []
    }
}

/** 当前工作区元信息（localStorage wid + status；无/失败返回 None）。 */
fn ws_load_current() Value {
    let wid = storage.get("musk_workspace") ?? ""
    if wid == "" {
        return None
    }
    try {
        let data = Http.get("/api/workspace/status?workspace=" + encodeURIComponent(wid))
        if data.workspace != None {
            return data.workspace
        }
        return data
    } catch {
        return None
    }
}

/** PLAN-080 T-02：当前 workspace 单源解析器——ForgeStore 与 WorkspaceSelector
 * 初始化的收敛点。语义 = ws_load_current（localStorage wid + status 校验，
 * 失效自愈）+ 列表回退（首个非空，再退首个）+ 回写 localStorage。返回解析
 * 出的 meta 供 store 持真值（app.at/login.at 经 ForgeStore.SetWorkspace
 * 回填）；全灭返回 None——不落 "musk-demo" 硬编码（那是 store 引导值，
 * 不再写 localStorage 污染下次解析，实机验收定罪的占位文案根因）。 */
fn ws_resolve_current() Value {
    let cached = ws_load_current()
    if cached != None {
        return cached
    }
    try {
        let data = Http.get("/api/workspace/list")
        let workspaces = data.workspaces ?? []
        var chosen = None
        for w in workspaces {
            if w.is_empty == false {
                chosen = w
                break
            }
        }
        if chosen == None {
            if workspaces.length > 0 {
                chosen = workspaces[0]
            }
        }
        if chosen != None {
            storage.set("musk_workspace", chosen.id)
            return chosen
        }
    } catch {
        return None
    }
    return None
}

/** 从最近列表按 id 找工作区（无则 None）。 */
fn ws_find(recent []Value, id str) Value {
    for w in recent {
        if w.id == id {
            return w
        }
    }
    return None
}

/** 按名称子串过滤（大小写不敏感；query 空串返回原列表）。供选择器搜索框用：
 * str.contains 只在 fn 内正确转译为 includes，view 表达式侧不可用。 */
fn ws_filter_recent(recent []Value, query str) []Value {
    if query == "" {
        return recent
    }
    var out []Value = []
    let q = query.to_lower()
    for w in recent {
        if w.name.to_lower().contains(q) {
            out.push(w)
        }
    }
    return out
}

/** 弹出系统文件夹选择器（本机 serve 进程代弹原生对话框；取消/失败返回 None）。 */
fn ws_pick() Value {
    try {
        let data = Http.post("/api/workspace/pick", {})
        return data.path ?? None
    } catch {
        return None
    }
}

/** 打开/切换到指定路径的 workspace（失败返回 None）。响应为
 * {workspace: meta} 包裹结构，此处解包成 meta 本体（对齐 ws_load_current）。 */
fn ws_open(path str) Value {
    try {
        let data = Http.post("/api/workspace/open", { "path": path })
        if data.workspace != None {
            return data.workspace
        }
        return data
    } catch {
        return None
    }
}

/** App Init 时确保有默认 workspace（localStorage 无则选第一个非空项）。 */
fn ensure_workspace() {
    let existing = storage.get("musk_workspace") ?? ""
    if existing != "" {
        return
    }
    let token = storage.get("musk_jwt") ?? ""
    if token == "" {
        return
    }
    try {
        let data = Http.get("/api/workspace/list")
        let workspaces = data.workspaces ?? []
        var chosen = None
        for w in workspaces {
            if w.is_empty == false {
                chosen = w
                break
            }
        }
        if chosen == None {
            if workspaces.length > 0 {
                chosen = workspaces[0]
            }
        }
        if chosen != None {
            storage.set("musk_workspace", chosen.id)
        }
    } catch {
        // 静默失败——workspace 不是阻塞项（原 catch {}）
        return
    }
}
