// workspace_selector.at — WorkspaceSelector 组件（Plan 023 队列 A2：async + lifecycle 逃生舱原生化）
//
// 对标 src/front/components/WorkspaceSelector.vue（逃生舱，已删除）。
// 验证 §10.7 async handler（on .Init + .Toggle 内 .await）+ 宿主全局
// （localStorage/location，§10.3 白名单）。
//
// 关键转换：
//   - async 数据拉取（workspace_list/workspace_status + localStorage + find）
//     → workspace_helpers.ts fn（.at 无宿主 API 链式 + 数组 find）
//   - onMounted → on .Init（§10.7 async handler）
//   - toggle/choose/close → msg + model + on
//   - location.reload() 宿主全局直呼
//   - 动态 active class → 行内 if 表达式
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.ws-btn 等）。

component fn WorkspaceSelector() {
    use {
        component: Folder, FolderOpen, ChevronUp, ChevronDown, X from "lucide-vue-next"
        fn: ws_load_recent, ws_load_current, ws_find, ws_browse, ws_open from "src/front/workspace_helpers.at"
    }
    computed {
        currentName => if .current != None { .current.name } else { "选择工作目录" }
        currentTitle => if .current != None { .current.path } else { "选择工作目录" }
        hasCurrent => .current != None
        showEmpty => .recent.length == 0
    }
    msg Msg { Toggle, Choose(str), Close, OnBrowseInput, OpenCustom, SelectSuggestion(str) }
    model {
        var open bool = false
        var current obj = None
        var recent obj = []
        var custom_path str = ""
        var suggestions obj = []
    }
    on {
        .Init -> {
            // helpers 内部自带 try/catch（失败返回 []/null），.at 侧无需再包 try。
            .recent = ws_load_recent().await;
            .current = ws_load_current().await
        }
        .Toggle -> {
            .open = !.open;
            if .open {
                if .recent.length == 0 {
                    .recent = ws_load_recent().await
                }
            }
        }
        .Choose(id) -> {
            localStorage.setItem("musk_workspace", id);
            .current = ws_find(.recent, id);
            .open = false;
            location.reload()
        }
        .Close -> { .open = false }

        // browse：输入含路径分隔符时实时建议子目录
        .OnBrowseInput -> {
            .suggestions = ws_browse(.custom_path).await
        }

        // 选建议项 → 填入 custom_path
        .SelectSuggestion(path) -> {
            .custom_path = path;
            .suggestions = []
        }

        // 打开自定义路径（后端注册为新 workspace + reload 切换）
        .OpenCustom -> {
            if .custom_path != "" {
                let meta = ws_open(.custom_path).await;
                if meta != None {
                    .current = meta;
                    .open = false;
                    .custom_path = "";
                    .suggestions = [];
                    location.reload()
                }
            }
        }
    }
    div {
        style: "workspace-selector"
        button {
            onclick: .Toggle
            style: "ws-btn"
            title: .currentTitle
            Folder { size: 14 }
            span {
                style: "ws-name"
                text .currentName
            }
            if .open {
                ChevronUp { size: 12 }
            } else {
                ChevronDown { size: 12 }
            }
        }
        if .open {
            div {
                style: "ws-panel"
                div {
                    style: "ws-panel-header"
                    span "切换 Workspace"
                    button {
                        onclick: .Close
                        style: "ws-close"
                        X { size: 12 }
                    }
                }
                div {
                    style: "ws-section-label"
                    text "最近打开"
                }
                for w in .recent {
                    button {
                        onclick: .Choose(w.id)
                        class: if .hasCurrent && .current.id == w.id { "ws-item active" } else { "ws-item" }
                        Folder { size: 13 }
                        span {
                            style: "ws-item-name"
                            text .w.name
                        }
                        span {
                            style: "ws-item-path"
                            text .w.path
                        }
                    }
                }
                if .showEmpty {
                    div {
                        style: "ws-empty"
                        text "暂无工作区"
                    }
                }
                // 打开其他文件夹（browse 选目录）
                div { style: "ws-divider" }
                div {
                    style: "ws-section-label"
                    text "打开其他文件夹"
                }
                input {
                    value: .custom_path
                    oninput: .OnBrowseInput
                    placeholder: "D:\\path\\to\\project"
                    style: "ws-input"
                }
                if .suggestions.length > 0 {
                    div {
                        style: "ws-suggest"
                        for s in .suggestions {
                            button {
                                onclick: .SelectSuggestion(.s.path)
                                style: "ws-suggest-item"
                                text .s.name
                            }
                        }
                    }
                }
                button {
                    onclick: .OpenCustom
                    style: "ws-open-btn"
                    FolderOpen { size: 13 }
                    text "打开"
                }
            }
        }
    }
}
