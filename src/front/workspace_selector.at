// workspace_selector.at — WorkspaceSelector 组件（Plan 023 队列 A2：async + lifecycle 逃生舱原生化）
//
// 对标 src/front/components/WorkspaceSelector.vue（逃生舱，已删除）。
// 验证 §10.7 async handler（on .Init + .Toggle 内 .await）+ 宿主全局
// （localStorage/location，§10.3 白名单）。
//
// 关键转换：
//   - async 数据拉取（workspace_list/workspace_status + localStorage + find）
//     → workspace_helpers.ts fn（.at 无宿主 API 链式 + 数组 find）
//   - onMounted → on .Init（§10.7 async handler）
//   - toggle/choose/close → msg + model + on
//   - location.reload() 宿主全局直呼
//   - 动态 active class → 行内 if 表达式
//
// 弹窗风格（对齐参考稿）：顶部搜索框过滤、纯名称行 + 当前项右侧 Check、
// 底部"打开文件夹"动作行（弹系统文件夹选择器）、大圆角卡片、无头部；
// PLAN-059 T9 起弹层归 popover 家族原语（触发钮锚定、外点/ESC 关闭、
// 越界翻转），手搓 backdrop/panel 已退役。
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.ws-btn 等）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component Folder, FolderPlus, ChevronDown, Search, Check from "src/front/ports/icons.at"
use.web ws_load_recent, ws_load_current, ws_find, ws_filter_recent, ws_pick, ws_open from "src/front/workspace_helpers.at"

widget WorkspaceSelector() {
    computed {
        currentName => if .current != None { .current.name } else { "选择工作目录" }
        currentTitle => if .current != None { .current.path } else { "选择工作目录" }
        hasCurrent => .current != None
        showEmpty => .shown.length == 0
    }
    // PLAN-059 T9:弹层切 popover 自管嵌套形态（PLAN-422 P3/P4）——触发钮/面板
    // 入 popover-trigger/content,开合态归解释器自管注册表（锚钮无 onclick 时
    // 注入内部 toggle;外点/ESC/点锚 dismiss 走 __popover_close）。web 轨映射
    // shadcn Popover/PopoverTrigger(as-child)/PopoverContent,reka 原生开合同
    // 语义。此前手搓 ws-backdrop+ws-panel 流内承载,VM 不消费 absolute 退化为
    // 嵌入侧栏（用户原始吐槽点之一）。
    msg Msg { Choose(str), UpdateQuery(str), PickFolder }
    model {
        var current obj = None
        var recent obj = []
        // 搜索框可见行（handler 侧过滤；str.contains 只在 fn 内正确转译）
        var shown obj = []
        var query str = ""
    }
    on {
        .Init -> {
            // helpers 内部自带 try/catch（失败返回 []/null），.at 侧无需再包 try。
            .recent = ws_load_recent().await;
            .shown = .recent;
            .current = ws_load_current().await
        }
        .Choose(id) -> {
            localStorage.setItem("musk_workspace", id);
            .current = ws_find(.recent, id);
            location.reload()
        }
        .UpdateQuery(q) -> {
            .query = q;
            .shown = ws_filter_recent(.recent, .query)
        }

        // 弹系统文件夹选择器（本机 serve 进程经 rfd 代弹）→ 选中路径注册为
        // workspace 并写 localStorage（对齐 Choose），reload 后即当前 workspace。
        // 取消/失败静默不动。
        .PickFolder -> {
            let path = ws_pick().await;
            if path != None {
                let meta = ws_open(path).await;
                if meta != None {
                    storage.set("musk_workspace", meta.id);
                    .current = meta;
                    location.reload()
                }
            }
        }
    }
    // Plan 029 T22：原 inject_styles 全局兜底下放（scoped 生效于本组件 DOM）。
    style {
  .workspace-selector { position: relative; margin-top: auto; }
  .ws-btn {
    display: flex; align-items: center; gap: 0.35rem; width: 100%;
    padding: 0.35rem 0.5rem; border: 1px solid hsl(var(--border)); border-radius: 6px;
    background: transparent; color: hsl(var(--foreground)); font-size: 0.75rem; cursor: pointer;
    transition: background 0.15s;
  }
  .ws-btn:hover { background: hsl(var(--accent)); }
  .ws-name { flex: 1; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* PLAN-059 T9:面板/遮罩手搓 CSS（.ws-backdrop/.ws-panel）随 popover 家族
     切换退役——开合/悬浮/外点关闭归 popover 原语,面板 chrome 归
     PopoverContent 组件（web）与默认 w-72 面板（VM）。 */
  .ws-search {
    display: flex; align-items: center; gap: 0.5rem;
    background: hsl(var(--muted) / 0.4); border: 1px solid hsl(var(--border));
    border-radius: 8px; padding: 0.4rem 0.6rem; margin-bottom: 0.4rem;
    color: hsl(var(--muted-foreground));
  }
  .ws-search:focus-within { border-color: hsl(var(--ring)); }
  .ws-search-input {
    flex: 1; min-width: 0; border: none; outline: none; background: transparent;
    color: hsl(var(--foreground)); font-size: 0.8rem; padding: 0;
  }
  .ws-search-input::placeholder { color: hsl(var(--muted-foreground)); }
  .ws-item {
    /* justify-start：ui Button 基类自带 justify-center，内容超宽时从两侧
       溢出——scoped 高优先级钉回左对齐 */
    display: flex; justify-content: flex-start; align-items: center; gap: 0.6rem; width: 100%;
    padding: 0.5rem 0.6rem; border: none; border-radius: 8px; background: transparent;
    color: hsl(var(--foreground)); cursor: pointer; font-size: 0.82rem;
    text-align: left; white-space: nowrap;
  }
  .ws-item:hover { background: hsl(var(--accent)); }
  .ws-item-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }
  .ws-item-check { margin-left: auto; flex-shrink: 0; color: hsl(var(--primary)); display: inline-flex; }
  .ws-empty { padding: 0.6rem; text-align: left; font-size: 0.75rem; color: hsl(var(--muted-foreground)); }
  .ws-divider { height: 1px; background: hsl(var(--border)); margin: 0.4rem 0; }
  .ws-action {
    display: flex; justify-content: flex-start; align-items: center; gap: 0.6rem; width: 100%;
    padding: 0.5rem 0.6rem; border: none; border-radius: 8px; background: transparent;
    color: hsl(var(--foreground)); cursor: pointer; font-size: 0.82rem; text-align: left;
    white-space: nowrap;
  }
  .ws-action:hover { background: hsl(var(--accent)); }
  /* AI 思考中等待指示（streaming 但 draft 还没开始）—— pulse 动画 */
  .thinking-dots {
    color: hsl(var(--muted-foreground));
    font-size: 0.85rem;
    padding: 0.5rem 0.75rem;
    animation: thinking-pulse 1.5s ease-in-out infinite;
  }
  @keyframes thinking-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
    }

    view {
        div {
            style: "workspace-selector"
            popover {
                popover-trigger (as_child: true) {
                    button {
                        style: "ws-btn w-full flex items-center gap-1 py-1.5 px-2 border border-border rounded-md bg-transparent text-foreground text-xs"
                        title: .currentTitle
                        Folder { size: 14 }
                        span {
                            style: "ws-name flex-1 text-left truncate"
                            text .currentName
                        }
                        ChevronDown { size: 12 }
                    }
                }
                popover-content {
                    div {
                        style: "ws-search"
                        Search { size: 14 }
                        input {
                            style: "ws-search-input"
                            value: .query
                            oninput: .UpdateQuery
                            placeholder: "搜索工作区"
                        }
                    }
                    for w in .shown {
                        button {
                            onclick: .Choose(w.id)
                            style: "ws-item"
                            title: .w.path
                            Folder { size: 15 }
                            span {
                                style: "ws-item-name"
                                text .w.name
                            }
                            if .hasCurrent && .current.id == w.id {
                                span {
                                    style: "ws-item-check"
                                    Check { size: 15 }
                                }
                            }
                        }
                    }
                    if .showEmpty {
                        div {
                            style: "ws-empty"
                            text "暂无工作区"
                        }
                    }
                    // 打开文件夹（弹系统文件夹选择器，选中即切 workspace）
                    div { style: "ws-divider" }
                    button {
                        onclick: .PickFolder
                        style: "ws-action"
                        FolderPlus { size: 15 }
                        text "打开文件夹"
                    }
                }
            }
        }
    }
}
