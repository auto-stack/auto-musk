// auth_store.at — 认证状态 store（对应 web/src/composables/useAuth.ts）
//
// 单例 store：token/user/loading/error + login/register/me/logout。
// token 持久化到 localStorage('musk_jwt')，user 到 localStorage('musk_user')。
// 对应 useAuth.ts 的 _token/_user/_loading/_error 单例 ref + computed isAuthenticated。
//
// Plan 022 Phase 4: 覆盖 LoginView 所需的认证状态 + 动作。

use back.api: auth_login, auth_register, auth_me

store AuthStore {
    model {
        // 从 localStorage 恢复 token（null = 未登录）。
        var token Option<str> = None
        // 从 localStorage 恢复 user（缓存）。
        var user Option<AuthUser> = None
        var loading bool = false
        var error str = ""
    }

    msg Msg {
        Init,
        Login(str, str),
        Register(str, str),
        Me,
        Logout,
        SetError(str),
    }

    computed {
        // isAuthenticated = token 非空 且 user 非空。
        // 注意 U8: computed 保持简单（handler 需 .value）。
        authenticated => .token != None
    }

    on {
        // Init: 从 localStorage 恢复 token/user（App 挂载时调用）。
        // PLAN-061 T9 (D8):musk_user 写侧已 JSON.stringify,读侧 parse+
        // 守卫(旧串/坏串 parse 失败弃用,保持 None 走重新登录;catch 只
        // 自赋值,规避 store try 嵌 if-return 029 缺口③)。
        .Init -> {
            let saved_token = localStorage.getItem("musk_jwt")
            if saved_token != None {
                .token = saved_token
            }
            let saved_user = localStorage.getItem("musk_user")
            if saved_user != None {
                try {
                    let parsed = JSON.parse(saved_user)
                    .user = AuthUser {
                        username: parsed.username ?? "",
                        role: parsed.role ?? "",
                    }
                } catch {
                    .token = .token
                }
            }
        }

        // Login(username, password): 调 auth_login，成功则存 token/user。
        // 后端返回 {token, user:{username, role}}（嵌套 user 对象）。
        // 另存 musk_login_username/password 供登录页预填（LoginPage.Init
        // 读取；记住上次登录凭据，免重复输入——本地开发工具语义）。
        // PLAN-061 T4 (D2):auth_login 对 !ok 抛错，此前异常外泄致 loading
        // 恒 true（按钮卡 "Loading..."）且 error 横幅为死代码——包
        // try/catch，catch 只赋值（规避 store 内 try 嵌 if-return，029
        // 缺口③），loading 在成功/失败两路各自复位（finally 语义位）。
        .Login(username, password) -> {
            .loading = true
            .error = ""
            try {
                let resp = auth_login(username, password)
                .loading = false
                if resp != None {
                    .token = resp.token
                    .user = AuthUser {
                        username: resp.user.username,
                        role: resp.user.role,
                    }
                    localStorage.setItem("musk_jwt", resp.token)
                    localStorage.setItem("musk_user", JSON.stringify(.user))
                    localStorage.setItem("musk_login_username", username)
                    localStorage.setItem("musk_login_password", password)
                }
            } catch {
                .loading = false
                .error = "登录失败：用户名或密码错误，或后端不可达"
            }
        }

        // Register(username, password): 调 auth_register，同 login 流程。
        .Register(username, password) -> {
            .loading = true
            .error = ""
            try {
                let resp = auth_register(username, password)
                .loading = false
                if resp != None {
                    .token = resp.token
                    .user = AuthUser {
                        username: resp.user.username,
                        role: resp.user.role,
                    }
                    localStorage.setItem("musk_jwt", resp.token)
                    localStorage.setItem("musk_user", JSON.stringify(.user))
                    localStorage.setItem("musk_login_username", username)
                    localStorage.setItem("musk_login_password", password)
                }
            } catch {
                .loading = false
                .error = "注册失败：用户名已存在，或后端不可达"
            }
        }

        // Me: 拉 /api/auth/me 刷新 user 信息；失败则 logout。
        // PLAN-046 T5/T8 勘察注:store 层不可跨层调 ports——此处 Logout 后
        // VM 轨默认认证头滞留(web 无此问题,monkey-patch 每请求重读
        // localStorage)。清偿协议:UI 化 logout 派发点须同步调
        // platformRefreshAuth()(login.at:116 同款);401 兜底需上游暴露
        // Http status 面——已入 KNOWN-DEBT 046 同步义务。现状:.Me 零派发点
        // (预留),滞留实际暴露面为零。
        .Me -> {
            if .token == None { return None }
            let me = auth_me()
            if me == None {
                Logout()
            } else {
                .user = me
                localStorage.setItem("musk_user", JSON.stringify(.user))
            }
        }

        // Logout: 清空状态 + localStorage。
        .Logout -> {
            .token = None
            .user = None
            .error = ""
            localStorage.removeItem("musk_jwt")
            localStorage.removeItem("musk_user")
        }

        .SetError(msg) -> { .error = msg }
    }
}
