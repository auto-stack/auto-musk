/// canvas_helpers.at — PLAN-093 T-04: Canvas 共享生产投影 helper。
///
/// store/panel 共用的字段投影与样式拼装（扁平重建漏斗的产出侧——
/// JSON.parse 产物不直接落 store，经此处重建为字面量，PLAN-084 T-07
/// 处方）。纯函数：无 store/堆依赖，Vue/VM 双端同源。

/// 选中覆盖框内联 style（蓝，bbox_pct 百分比定位）。
fn canvasPickStyleFromBbox(bp obj) str {
    return "position:absolute;left:" + bp.x + "%;top:" + bp.y + "%;width:" + bp.w + "%;height:" + bp.h + "%;border:2px solid rgb(59,130,246);background:rgba(59,130,246,0.12);pointer-events:none;border-radius:2px"
}

/// agent 高亮框内联 style（琥珀）。
fn canvasOverlayStyleFromBbox(bp obj) str {
    return "position:absolute;left:" + bp.x + "%;top:" + bp.y + "%;width:" + bp.w + "%;height:" + bp.h + "%;border:2px solid rgb(245,158,11);background:rgba(245,158,11,0.15);pointer-events:none;border-radius:2px"
}

/// 帧直出 URL：身份+seq 双键（代次防串帧，seq 驱动缓存击穿；
/// 不用 Date.now——VM 门控遵循 vm-data-semantics 的 tick 处方）。
fn canvasFrameUrl(seq int, gen int) str {
    return "/api/canvas/frame?t=" + seq + "&gen=" + gen
}

/// PLAN-093 T-06: 帧内容包装层 style（适应/100% 双模式统一坐标系——
/// 覆盖框百分比定位与点选换算都以本盒为基准，修 object-contain 留白期
/// 选框相对容器错位）。fit=适应：aspect-ratio 定比 + max 约束 + margin
/// auto 居中（object-contain 等效盒；真实 CSS，生成侧 :style 直绑合法）；
/// 100%：帧物理 px 定尺寸（容器 overflow-auto 承担内滚）。
/// 尺寸未知（w/h≤0）退化为占满盒（旧行为；VM 轨 aspect-ratio 未证面，
/// 退化形态不改变既有 VM 渲染）。
fn canvasContentStyle(natural_w int, natural_h int, fit bool) str {
    if natural_w <= 0 || natural_h <= 0 {
        return "position:relative;max-width:100%;max-height:100%;margin:auto"
    }
    if fit {
        return "position:relative;aspect-ratio:" + natural_w + "/" + natural_h + ";max-width:100%;max-height:100%;margin:auto"
    }
    return "position:relative;width:" + natural_w + "px;height:" + natural_h + "px;margin:auto"
}

/// PLAN-093 T-06: 点选物理换算（单源规则——Vue/VM 同式，不得各猜）。
/// ox/oy = 点击点相对内容盒左上的 CSS px；box = 内容盒 CSS 尺寸；
/// natural = 帧物理尺寸。返回 {x,y,inside}（物理像素——§5.2 点选 API
/// 口径）。纯 int 乘前除后（VM int×float 未打标签前科）；整除截断
/// ≤1 CSS px（720 宽量级），框≤2px 预算内。
fn canvasMapPhysical(ox int, oy int, box_w int, box_h int, natural_w int, natural_h int) {
    if box_w <= 0 || box_h <= 0 || natural_w <= 0 || natural_h <= 0 {
        return { x: 0, y: 0, inside: false }
    }
    let x = ox * natural_w / box_w
    let y = oy * natural_h / box_h
    let inside = ox >= 0 && oy >= 0 && ox < box_w && oy < box_h
    return { x: x, y: y, inside: inside }
}

/// picked 锚点对象 → 扁平投影字面量（统一漏斗）。
/// pk 为 None（204/清选/stopped）时返回全空投影 = 统一清场。
/// PLAN-093 Q-04：confidence = 后端 source_confidence（exact/uncertain——
/// 多文件启发式来源前端必须显示"来源待确认"）；loop 三字段 = forctx
/// （§5.7 design_context loop_context DTO）。
fn canvasPickedProjection(pk obj) {
    var id = ""
    var kind = ""
    var label = ""
    var source = ""
    var source_path = ""
    var for_label = ""
    var style = ""
    var source_line = 0
    var confidence = ""
    var loop_var = ""
    var loop_index = -1
    var loop_value = ""
    if pk != None {
        id = pk.vnode_id ?? ""
        kind = pk.kind ?? ""
        label = pk.label ?? ""
        source = pk.source ?? ""
        source_path = pk.source_path ?? ""
        // T-07:行定位（pick_json source_line；缺省 0 = 无有效行）。
        source_line = pk.source_line ?? 0
        confidence = pk.source_confidence ?? ""
        var fc = pk.forctx
        if fc != None {
            var fi = fc.index
            if fi != None {
                for_label = "#" + fi
                loop_index = fi
            }
            // var_name = forctx"var"的关键字安全副本（fc.var 撞 .at 硬
            // 关键字——解析失败实证；后端 payload 双字段）。
            loop_var = fc.var_name ?? ""
            loop_value = fc.value ?? ""
        }
        var bp = pk.bbox_pct
        if bp != None {
            style = canvasPickStyleFromBbox(bp)
        }
    }
    return { id: id, kind: kind, label: label, source: source, source_path: source_path, for_label: for_label, style: style, source_line: source_line, confidence: confidence, loop_var: loop_var, loop_index: loop_index, loop_value: loop_value }
}

/// overlay 条目列表 → [{vid, style}]（agent 高亮=琥珀框，完整内联样式）。
fn rebuildCanvasOverlay(list obj) list {
    var out list = []
    for s in list {
        var vid = s.vnode_id ?? ""
        var style str = ""
        var bp = s.bbox_pct
        if bp != None {
            style = canvasOverlayStyleFromBbox(bp)
        }
        out.push({ vid: vid, style: style })
    }
    return out
}

/// PLAN-093 T-07: 层树扁平表（前序）→ 可见行。折叠键 = 节点 vid（稳定
/// 字符串 ID——跨帧/删改存活）；被折叠祖先掩盖的整枝跳过。行含 has_kids
/// （下一项深度 = 本深+1）与 open（有子且未折叠）供视图画折叠符。
/// obj 缺键读返回 None；depth 缺省 0；键经 k + "" 字符串化（editedSpecs
/// 先例）。纯 int/obj 运算（无 float）。
/// T-09 注：循环用 while 外计数——range 循环经 PLAN-671 ③ use-imported
/// fn 内联进 store 模块时不随行注入 range 助手（TS2552 实证，V01 门）；
/// while 形态在任何宿主模块零依赖（canvasSourceLines 同款）。语义等价
/// （V03 canvasTreeVisible 用例不变全绿）。
fn canvasTreeVisible(flat list, collapsed obj) list {
    var out list = []
    var lastAt obj = {}
    var n = flat.length
    var i = 0
    while i < n {
        let node = flat[i]
        let d = node.depth ?? 0
        var hidden = false
        var k = 0
        while k < d {
            let av = lastAt[k + ""]
            if av != None {
                if collapsed[av] == true {
                    hidden = true
                }
            }
            k = k + 1
        }
        if hidden == false {
            var hasKids = false
            if i + 1 < n {
                let nx = flat[i + 1]
                if (nx.depth ?? 0) == d + 1 {
                    hasKids = true
                }
            }
            let cv = collapsed[node.vid]
            out.push({
                vid: node.vid,
                depth: d,
                kind: node.kind ?? "",
                label: node.label ?? "",
                for_label: node.for_label ?? "",
                indent_style: node.indent_style ?? "",
                has_kids: hasKids,
                open: hasKids && cv != true,
            })
        }
        lastAt[d + ""] = node.vid
        i = i + 1
    }
    return out
}

/// PLAN-093 T-07: 源码文本 → 行列表（\n 切分，尾行无换行照收；char_code_at
/// 10 判行——estimateTokens 同族双轨原语，substring 前闭后开）。
fn canvasSourceLines(text str) list {
    var out list = []
    if text == None { return out }
    var start = 0
    let n = text.length
    var i = 0
    while i < n {
        if text.char_code_at(i) == 10 {
            out.push(text.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.push(text.substring(start, n))
    return out
}

/// PLAN-093 T-09: 工具事件投影 → 进度行（§5.8 生成/检查进度摘要的单源
/// 分类器；V03 被测对象）。messages = ForgeStore.messages（blocks 双形态：
/// live 块带 tc / 回放块扁平字段，messageBlocks r5b 同款读取）。
/// 规则：只投影有证据的行（不把工具完成顺序硬凑成固定五步）；状态只来自
/// 工具 status 字段与画布实时状态，不嗅探结果文本（绿勾禁令）；启动预览
/// 行以 CanvasStore 实际状态为权威（start 返回 ≠ 已可见），无实时状态时
/// 才回退 canvas_run 事件，代次章（details.canvas.generation_id）失配的
/// 陈旧事件不冒充当前预览。label_key 为完整 i18n 键（视图 t() 直查）。
fn canvasProgressRows(messages list, cv_state str, cv_seq int, cv_app str, cv_gen int, cv_error str) list {
    // 分类桶累计：生成=文件/Blueprint 读取类；lint=ui_lint；bp=bp_check；
    // run=canvas_run；verify=canvas_act/state/snapshot。
    var g_has = false
    var g_running = false
    var g_last = ""
    var g_name = ""
    var l_has = false
    var l_running = false
    var l_last = ""
    var b_has = false
    var b_running = false
    var b_last = ""
    var bp_used = false
    var r_has = false
    var r_running = false
    var r_last = ""
    var r_gen_meta = 0
    var v_has = false
    var v_running = false
    var v_last = ""
    var v_name = ""
    for m in messages {
        let blocks = m.blocks ?? []
        for b in blocks {
            if b.kind == "tool" {
                var name = ""
                var status = ""
                var gen_meta = 0
                let tc = b.tc ?? None
                if tc != None {
                    name = tc.name ?? ""
                    status = tc.status ?? ""
                    let dt = tc.details ?? None
                    if dt != None {
                        let cvd = dt.canvas ?? None
                        if cvd != None {
                            let gme = cvd.generation_id ?? 0
                            if gme > 0 { gen_meta = gme }
                        }
                    }
                } else {
                    name = b.tool_name ?? ""
                    status = b.tool_status ?? ""
                }
                var failed = false
                if status == "error" { failed = true }
                if status == "failed" { failed = true }
                var running = false
                if status == "running" { running = true }
                if status == "gate_waiting" { running = true }
                var is_gen = false
                if name == "write_file" { is_gen = true }
                if name == "edit_file" { is_gen = true }
                if name == "app_examples_list" { is_gen = true }
                if name == "app_example_read" { is_gen = true }
                if name == "bp_list" { is_gen = true }
                if name == "bp_show" { is_gen = true }
                if name == "bp_list" { bp_used = true }
                if name == "bp_show" { bp_used = true }
                if is_gen {
                    g_has = true
                    if running { g_running = true }
                    g_last = status
                    g_name = name
                }
                if name == "ui_lint" {
                    l_has = true
                    if running { l_running = true }
                    l_last = status
                }
                if name == "bp_check" {
                    b_has = true
                    bp_used = true
                    if running { b_running = true }
                    b_last = status
                }
                if name == "canvas_run" {
                    r_has = true
                    if running { r_running = true }
                    r_last = status
                    if gen_meta > 0 { r_gen_meta = gen_meta }
                }
                var is_verify = false
                if name == "canvas_act" { is_verify = true }
                if name == "canvas_state" { is_verify = true }
                if name == "canvas_snapshot" { is_verify = true }
                if is_verify {
                    v_has = true
                    if running { v_running = true }
                    v_last = status
                    v_name = name
                }
            }
        }
    }
    var rows = []
    if g_has {
        var st = "done"
        if g_last == "error" || g_last == "failed" { st = "failed" }
        if g_running { st = "running" }
        rows.push({ key: "generate", state: st, label_key: "canvas.progRowGenerate", tool: g_name })
    }
    if l_has {
        var st = "pass"
        if l_last == "error" || l_last == "failed" { st = "failed" }
        if l_running { st = "running" }
        rows.push({ key: "lint", state: st, label_key: "canvas.progRowLint", tool: "ui_lint" })
    }
    if bp_used {
        var st = "na"
        if b_has {
            st = "pass"
            if b_last == "error" || b_last == "failed" { st = "failed" }
            if b_running { st = "running" }
        }
        rows.push({ key: "bp", state: st, label_key: "canvas.progRowBp", tool: "bp_check" })
    }
    // 启动预览行（实时状态权威；stopped+无应用回退工具事件）。
    var p_present = false
    var p_state = ""
    if cv_state == "running" {
        p_present = true
        if cv_seq > 0 {
            p_state = "visible"
        } else {
            p_state = "waiting"
        }
    } else {
        if cv_state == "starting" { p_present = true; p_state = "starting" }
        if cv_state == "restarting" { p_present = true; p_state = "restarting" }
        if cv_state == "degraded" { p_present = true; p_state = "failed" }
        if cv_state == "stopped" {
            if cv_app != "" {
                p_present = true
                p_state = "stopped"
            } else {
                if r_has {
                    var stale = false
                    if r_gen_meta > 0 && cv_gen > 0 {
                        if r_gen_meta != cv_gen { stale = true }
                    }
                    if stale == false {
                        p_present = true
                        if r_last == "error" || r_last == "failed" {
                            p_state = "failed"
                        } else {
                            p_state = "requested"
                        }
                    }
                }
            }
        }
    }
    if p_present {
        rows.push({ key: "preview", state: p_state, label_key: "canvas.progRowPreview", tool: "canvas_run" })
    }
    // 交互验证行：有预览上下文才有意义；未执行显式"未验证"。
    if v_has || p_present {
        var st = "unverified"
        if v_has {
            st = "done"
            if v_last == "error" || v_last == "failed" { st = "failed" }
            if v_running { st = "running" }
        }
        rows.push({ key: "verify", state: st, label_key: "canvas.progRowVerify", tool: v_name })
    }
    // 帧行：纯实时投影（seq>0 = 最近画面已更新；无因果证据不写热更新）。
    if cv_seq > 0 {
        rows.push({ key: "frame", state: "info", label_key: "canvas.progRowFrame", tool: "" })
    }
    return rows
}
