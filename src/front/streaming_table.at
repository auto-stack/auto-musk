// streaming_table.at — StreamingTable 组件（Plan 023 P3 续：逃生舱原生化）
//
// 对标 src/front/components/StreamingTable.vue（逃生舱）。
// Plan 022 因 table 标签被 codegen 映射成 shadcn Table + 动态索引 row[col]
// 不支持而封逃生舱；现 408 P7（动态索引）+ P8（table 标签保持原生）已修。
//
// 关键转换：
//   - withDefaults 可选 props → computed if != None 兜底（.at 无 withDefaults）
//   - row[col] ?? '' → .row[.col]（P7 动态索引；undefined 渲染为空，等价 ?? ''）
//   - Math.max(1, length) → colspan computed（.at 无 Math API）
//   - table/thead/tbody/tr/th/td → P8 保持原生 HTML（不再映射 shadcn Table）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.streaming-table 等）。

component fn StreamingTable(columns: []str, rows: []obj, final: bool) {
    computed {
        hasColumns => .columns != None
        safeColumns => if .hasColumns { .columns } else { [] }
        hasRows => .rows != None
        safeRows => if .hasRows { .rows } else { [] }
        colCount => if .hasColumns { .columns.length } else { 0 }
        colspan => if .colCount > 0 { .colCount } else { 1 }
        showLoading => !.final
    }
    style {
/* 外距参与统一 block 节奏：代码块 0.4 + 表格 0.35 = 块间距 0.4 + 表格 0.35
   （两侧均 0.75rem），与 .msg-blocks 的 gap 协同（见 chat_message.at）。 */
.streaming-table { margin: 0.35rem 0; overflow-x: auto; }
.streaming-table table { border-collapse: collapse; width: 100%; font-size: 0.93rem; }
.streaming-table th, .streaming-table td { border: 1px solid hsl(var(--border)) !important; padding: 0.4rem 0.6rem !important; text-align: left; }
.streaming-table th { background: hsl(var(--card)); font-weight: 600; color: hsl(var(--foreground)); }
.streaming-table td { color: hsl(var(--foreground)); }
.streaming-table tbody tr:nth-child(even) { background: hsl(var(--muted) / 0.5); }
.streaming-table .loading-row td { color: hsl(var(--muted-foreground)); font-style: italic; text-align: center; }
.streaming-table .loading-dots::after { content: ''; animation: st-dots 1.4s infinite both; }
    }

    col {
        class: if .final { "streaming-table final" } else { "streaming-table" }
        table {
            thead {
                tr {
                    for col in .safeColumns {
                        th { text .col }
                    }
                }
            }
            tbody {
                for row in .safeRows {
                    tr {
                        for col in .safeColumns {
                            td { text .row[.col] }
                        }
                    }
                }
                if .showLoading {
                    tr {
                        style: "loading-row"
                        td {
                            colspan: .colspan
                            text "Loading" { style: "loading-dots" }
                        }
                    }
                }
            }
        }
    }
}
