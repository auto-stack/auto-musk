// canvas_store.at — PLAN-087 T-07 + PLAN-088 T-07 + PLAN-093 T-04: 画布会话
// 轮询 store（投影与展示状态重构）。
//
// 状态命名 cv_*：避让潜在 api 绑定撞名（whitelist wl_* 同款口径）。
// 轮询机制 = forge_store PollBackfill 同款：timer 拍发起 Http.get_msg
// （入队即返），载荷以字符串回填消息解析（{"ok","status","body"} 信封）。
// body = {state,seq,app_path,restarts,error,generation_id,...} + M2 锚定面
// {frame,picked,overlay,tree,pac}。M2 扁平重建漏斗（PLAN-084 T-07
// rebuildSessions 处方）：JSON.parse 产物直接落 store 后渲染上下文字段读
// 塌空（r5 家族）——handler 域经 canvas_helpers.at 投影函数逐字段重建为
// 字面量，视图读恢复。id 全程字符串形态（哈希 vnode > JS 2^53，数字静默
// 截断）。
//
// PLAN-093 T-04 重构面：
// - 工作台显隐与生命周期分离：cv_collapsed（用户偏好）独立于会话状态；
//   cv_open 为投影（有会话 且 未收起）——轮询不复开用户收起的工作台
//   （AC-01），停止保留已停止工作台（AC-03）。
// - 身份与陈旧防线：cv_gen 跟随 status.generation_id（T-02 契约），代次
//   变化统一清选中/overlay/帧（A→B 不串，AC-11）；帧 URL 身份+seq 双键。
// - 统一清场：picked=null（204/清选）、代次变化、stopped 三路都走
//   canvasPickedProjection 全字段清（AC-08，修原 picked=null 不清字段）。
// - poll 单飞（AC-14）：cv_inflight + 有界 tick 释放（>3 拍丢响应视为
//   失联释放，不照抄 web Date.now——vm-data-semantics tick 处方）；
//   非在途到达的回填载荷直接丢弃（迟到/自发载荷不落账）。
// VM 轨：状态轮询打到宿主桥（VMHTTP canvas 路由 T-03 已通，同
// CanvasManager）；面板行为双端同源（T-03 四模式探针护航）。

// PLAN-102 T-03：布局纯函数（canvas_helpers 同族跨轨消费；ext TS 生成面
// 由 canvas_workbench.at 的 use.web.fn 触发——合同脚本 canvas-layout-
// contract.mjs 直测生成模块）。
use canvas_layout_helpers: canvasLayoutPrefKey, canvasLayoutPrefEncode, canvasLayoutPrefDecode, canvasDockMode, canvasDockDragSize, canvasDockNudgeSize, canvasClampDockW, canvasClampDockH, canvasClampOuterW, canvasDockWDecl, canvasDockHDecl, canvasOuterWDecl, canvasWbEstH, canvasOuterContainerW, canvasLogicalToPx
// PLAN-097 T-05: canvasProgressRows 内联为本文件模块级 fn——VM 运行时
// 在 store handler 域调用模块级 fn 实测返回空列表(同文件与跨模块同症;
// PLAN-729 稳定点复验依旧),归 auto-lang VM 调用语义(见 baseline 附页③,
// 最小复现 probe-g15.mjs)。函数体与 canvas_helpers.at 单源一致(V03 直测
// 对象仍为 canvas_helpers.at 版本;此处为 VM 运行时副本,两处同步由本
// 注释锚定);web 轨不受影响。
use canvas_helpers: canvasPickedProjection, canvasFrameUrl, rebuildCanvasOverlay, canvasContentStyle, canvasTreeVisible, canvasSourceLines

fn canvasProgressRows(messages list, cv_state str, cv_seq int, cv_app str, cv_gen int, cv_error str) list {
    // 分类桶累计：生成=文件/Blueprint 读取类；lint=ui_lint；bp=bp_check；
    // run=canvas_run；verify=canvas_act/state/snapshot。
    var g_has = false
    var g_running = false
    var g_last = ""
    var g_name = ""
    var l_has = false
    var l_running = false
    var l_last = ""
    var b_has = false
    var b_running = false
    var b_last = ""
    var bp_used = false
    var r_has = false
    var r_running = false
    var r_last = ""
    var r_gen_meta = 0
    var v_has = false
    var v_running = false
    var v_last = ""
    var v_name = ""
    for m in messages {
        let blocks = m.blocks ?? []
        for b in blocks {
            if b.kind == "tool" {
                var name = ""
                var status = ""
                var gen_meta = 0
                let tc = b.tc ?? None
                if tc != None {
                    name = tc.name ?? ""
                    status = tc.status ?? ""
                    let dt = tc.details ?? None
                    if dt != None {
                        let cvd = dt.canvas ?? None
                        if cvd != None {
                            let gme = cvd.generation_id ?? 0
                            if gme > 0 { gen_meta = gme }
                        }
                    }
                } else {
                    name = b.tool_name ?? ""
                    status = b.tool_status ?? ""
                }
                var failed = false
                if status == "error" { failed = true }
                if status == "failed" { failed = true }
                var running = false
                if status == "running" { running = true }
                if status == "gate_waiting" { running = true }
                var is_gen = false
                if name == "write_file" { is_gen = true }
                if name == "edit_file" { is_gen = true }
                if name == "app_examples_list" { is_gen = true }
                if name == "app_example_read" { is_gen = true }
                if name == "bp_list" { is_gen = true }
                if name == "bp_show" { is_gen = true }
                if name == "bp_list" { bp_used = true }
                if name == "bp_show" { bp_used = true }
                if is_gen {
                    g_has = true
                    if running { g_running = true }
                    g_last = status
                    g_name = name
                }
                if name == "ui_lint" {
                    l_has = true
                    if running { l_running = true }
                    l_last = status
                }
                if name == "bp_check" {
                    b_has = true
                    bp_used = true
                    if running { b_running = true }
                    b_last = status
                }
                if name == "canvas_run" {
                    r_has = true
                    if running { r_running = true }
                    r_last = status
                    if gen_meta > 0 { r_gen_meta = gen_meta }
                }
                var is_verify = false
                if name == "canvas_act" { is_verify = true }
                if name == "canvas_state" { is_verify = true }
                if name == "canvas_snapshot" { is_verify = true }
                if is_verify {
                    v_has = true
                    if running { v_running = true }
                    v_last = status
                    v_name = name
                }
            }
        }
    }
    var rows = []
    if g_has {
        var st = "done"
        if g_last == "error" || g_last == "failed" { st = "failed" }
        if g_running { st = "running" }
        rows.push({ key: "generate", state: st, label_key: "canvas.progRowGenerate", tool: g_name })
    }
    if l_has {
        var st = "pass"
        if l_last == "error" || l_last == "failed" { st = "failed" }
        if l_running { st = "running" }
        rows.push({ key: "lint", state: st, label_key: "canvas.progRowLint", tool: "ui_lint" })
    }
    if bp_used {
        var st = "na"
        if b_has {
            st = "pass"
            if b_last == "error" || b_last == "failed" { st = "failed" }
            if b_running { st = "running" }
        }
        rows.push({ key: "bp", state: st, label_key: "canvas.progRowBp", tool: "bp_check" })
    }
    // 启动预览行（实时状态权威；stopped+无应用回退工具事件）。
    var p_present = false
    var p_state = ""
    if cv_state == "running" {
        p_present = true
        if cv_seq > 0 {
            p_state = "visible"
        } else {
            p_state = "waiting"
        }
    } else {
        if cv_state == "starting" { p_present = true; p_state = "starting" }
        if cv_state == "restarting" { p_present = true; p_state = "restarting" }
        if cv_state == "degraded" { p_present = true; p_state = "failed" }
        if cv_state == "stopped" {
            if cv_app != "" {
                p_present = true
                p_state = "stopped"
            } else {
                if r_has {
                    var stale = false
                    if r_gen_meta > 0 && cv_gen > 0 {
                        if r_gen_meta != cv_gen { stale = true }
                    }
                    if stale == false {
                        p_present = true
                        if r_last == "error" || r_last == "failed" {
                            p_state = "failed"
                        } else {
                            p_state = "requested"
                        }
                    }
                }
            }
        }
    }
    if p_present {
        rows.push({ key: "preview", state: p_state, label_key: "canvas.progRowPreview", tool: "canvas_run" })
    }
    // 交互验证行：有预览上下文才有意义；未执行显式"未验证"。
    if v_has || p_present {
        var st = "unverified"
        if v_has {
            st = "done"
            if v_last == "error" || v_last == "failed" { st = "failed" }
            if v_running { st = "running" }
        }
        rows.push({ key: "verify", state: st, label_key: "canvas.progRowVerify", tool: v_name })
    }
    // 帧行：纯实时投影（seq>0 = 最近画面已更新；无因果证据不写热更新）。
    if cv_seq > 0 {
        rows.push({ key: "frame", state: "info", label_key: "canvas.progRowFrame", tool: "" })
    }
    return rows
}

// 供 StatusBackfill 每拍重算调用(见上内联说明)。

// PLAN-093 T-07: 行列表 + 拾取行 → 渲染行对象 [{no, text, hl}]
// （视图体内 let 不受支持——行对象在 store 域预构建；no 为 1 基）。
fn canvasSourceRows(lines list, hl int) list {
    var out list = []
    var lineNo = 1
    // for-in + 外部计数（store 模块发射器不注入 range 助手——范围循环
    // 在 store 文件产出未定义调用，TS2552 实证；fn 模块有局部 range，
    // 上游缺口待立）。
    for lineText in lines {
        out.push({ no: lineNo, body: lineText, hl: lineNo == hl })
        lineNo = lineNo + 1
    }
    return out
}

// 层树扁平表 → [{vid, depth, kind, label, source, source_path, for_label,
// indent_style}]（行样式预拼：选中底色视图侧靠 id 等值三臂）。
fn rebuildCanvasTree(list obj) list {
    var out list = []
    for n in list {
        var vid = n.id ?? ""
        var depth = n.depth ?? 0
        var kind = n.kind ?? ""
        var label = n.label ?? ""
        var source = n.source ?? ""
        var source_path = n.source_path ?? ""
        var for_label str = ""
        var fi = n.loop_index
        if fi != None {
            var fv = n.loop_value ?? ""
            for_label = "#" + fi + " " + fv
        }
        var pad int = 4 + depth * 12
        var indent = "padding-left:" + pad + "px"
        out.push({ vid: vid, depth: depth, kind: kind, label: label, source: source, source_path: source_path, for_label: for_label, indent_style: indent })
    }
    return out
}

store CanvasStore {
    model {
        // 会话状态（后端 CanvasState 小写串）。
        var cv_state str = "stopped"
        // PLAN-093 T-04: 预览身份（status.generation_id；代次变化清场）。
        var cv_gen int = 0
        // 帧序号（单调递增；驱动 img src 缓存击穿）。
        var cv_seq int = 0
        // 帧直出 URL（身份+seq 双键；seq 不变零重写）。
        var cv_frame_url str = ""
        // 在跑的 app 目录显示名（停止后保留 = 已停止工作台的应用描述）。
        var cv_app str = ""
        // 最近错误（degraded 机理等）。
        var cv_error str = ""
        // 面板开合投影：有会话（非 stopped 或 有应用描述）且 未收起。
        // 用户收起走 Collapse（偏好位），轮询不改此偏好。
        var cv_open bool = false
        var cv_collapsed bool = false
        // poll 单飞：在途标记 + 有界释放计数（>3 拍丢响应视为失联）。
        var cv_inflight bool = false
        var cv_inflight_ticks int = 0
        // ── M2 锚定面（扁平重建漏斗产出） ──
        var cv_picked_id str = ""
        var cv_picked_kind str = ""
        var cv_picked_label str = ""
        var cv_picked_source str = ""
        var cv_picked_source_path str = ""
        var cv_picked_source_line int = 0
        var cv_picked_for str = ""
        // PLAN-093 Q-04:来源置信度（exact/uncertain——多文件启发式来源
        // 前端显示"来源待确认"，不假装准确锚定）+ 循环实例三字段（§5.7
        // design_context loop_context DTO）。
        var cv_picked_confidence str = ""
        var cv_picked_loop_var str = ""
        var cv_picked_loop_index int = -1
        var cv_picked_loop_value str = ""
        // 选中覆盖框内联 style（bbox_pct 百分比定位）。
        var cv_pick_style str = ""
        // agent 高亮框 [{vid, style}]。
        var cv_overlay []Value = []
        // 层树扁平表 [{vid, depth, kind, label, source, for_label}]。
        var cv_tree []Value = []
        // pac 头显示名。
        var cv_pac_title str = ""
        // 源码预览开合（锚点 chip → 源码抽屉）+ 已载文本。
        // PLAN-093 T-07:结构/源码左列页签（chip 点击=切源码）与源码状态
        // 机（""=无选中源码面 / "ok"=已载入 / "error"=读失败+cv_source_err）；
        // 行列表随载入切分（渲染侧按 cv_picked_source_line 高亮/提示）。
        var cv_source_tab str = "structure"
        var cv_source_state str = ""
        var cv_source_err str = ""
        var cv_source_lines []Value = []
        var cv_source_rows []Value = []
        // T-07:折叠键（稳定字符串 vid → bool）与可见行（随树回填/折叠
        // 切换单源重算）。
        var cv_tree_collapsed obj = {}
        var cv_tree_visible []Value = []
        // PLAN-093 T-05:视口宽（宽度分层驱动;web 键优先 VM 键兜底）。
        // studio 模式开关归 ChatsView 视图域（跨 store 写入无先例）。
        var cv_win_w int = 1280
        // PLAN-093 T-06:帧物理尺寸（status.frame 回填——内容包装层
        // aspect-ratio/100% 尺寸源）+ 适应/100% 缩放偏好 + 包装层 style
        // （真实 CSS——store 动作域经 canvasContentStyle 单源重算）。
        var cv_frame_w int = 0
        var cv_frame_h int = 0
        var cv_zoom_fit bool = true
        var cv_frame_wrap_style str = "position:relative;max-width:100%;max-height:100%;margin:auto"
        // PLAN-093 T-05 §5.2 窄层（768-1023）：结构列默认不占位，按钮切换
        // （受控面板；用户偏好，停止/轮询不改）。
        var cv_structure_open bool = false
        // PLAN-093 T-09:degraded 详情展开（视图态）+ 子进程输出 tail
        // （status_full.output_tail 回填——错误详情盒诊断面）。
        var cv_error_details_open bool = false
        var cv_output_tail str = ""
        // ── PLAN-102 T-04：呈现面板与双输入模式 ──
        // presentation 面板（status 回填）：embedded 会话携带 bridge WS
        // 端点；window 会话 url 空。cv_input_mode = operate|inspect（默认
        // operate；inspect 只走既有 pick 通道，不触应用副作用）。
        var cv_embed bool = false
        var cv_bridge_url str = ""
        var cv_input_mode str = "operate"
        // web 轨 embed 消费面就绪（installCanvasEmbed 写 canvas.embed_ready
        // 键；VM 轨无此键 → 帧区走既有 img 降级——J2 remote-frame 未就绪
        // 前不冒充，T-04 切片②收口）。
        var cv_embed_web bool = false
        // ── PLAN-102 T-03：停靠布局与偏好（canvas_layout_helpers 单源钳制）──
        // 停靠位 left|right|bottom|hidden；工具区水平宽/底部高；正常模式
        // 外框宽；load-once 门（轮询不覆写偏好）；拖动瞬态（kind/origin/
        // 取消基线）；tabs 降级单区页签（canvas|tools）。
        var cv_dock str = "left"
        var cv_dock_w int = 240
        var cv_dock_h int = 240
        var cv_outer_w int = 640
        // W-03-1 spike 裁定的动态尺寸通道：声明串字段随尺寸写点同步重算
        //（视图 style: .store.<decl> 单通道消费；canvas_layout_helpers 组合）。
        var cv_dock_w_decl str = "width:240px;height:100%;overflow:hidden;flex-shrink:0"
        var cv_dock_h_decl str = "height:240px;width:100%;overflow:hidden;flex-shrink:0"
        var cv_outer_w_decl str = "width:640px;height:100%;overflow:hidden;flex-shrink:0"
        // 布局模式投影（"dock"|"tabs"）：canvasDockMode 纯函数在动作域算，
        // 视图只读字段（视图域 fn 调用出程未证——不冒险）。
        var cv_layout_mode str = "dock"
        var cv_layout_loaded bool = false
        var cv_wb_w int = 0
        var cv_wb_h int = 0
        var cv_drag_kind str = ""
        var cv_drag_origin int = 0
        var cv_drag_size0 int = 0
        var cv_solo_tab str = "canvas"
        // PLAN-097 T-05（G-15 消除）:进度行 store 域预计算——cp_prog_msgs
        // 为挂载期推送的 messages 快照,cp_prog_rows 每拍重算。
        var cp_prog_msgs []Value = []
        var cp_prog_rows []Value = []
        // 行非空判言（视图免 .length 成员链——VM 视图/computed 成员链
        // 求值为空,本轮插桩实证;handler 域 .length 为 relay LoadRun 已证形态）。
        var cp_prog_has bool = false
        var cp_prog_err str = ""
    }

    timer {
        Poll (every_ms: 1000)
    }

    msg Msg {
        Poll,
        ProgInput(list),
        StatusBackfill(str),
        PickBackfill(str),
        ClearPick,
        Collapse,
        UnCollapse,
        ToggleSource,
        SourceBackfill(str),
        // PLAN-102 T-03：停靠布局动作族。
        SetDock(str),
        LayoutContainer(int, int),
        DockDragStart(str, int, int),
        DockDragMove(int),
        DockDragLogical(str, int),
        DockDragEnd,
        DockDragCancel,
        DockNudge(str, int),
        OuterDragStart(int, int),
        OuterDragMove(int),
        OuterDragLogical(int),
        OuterDragEnd,
        OuterDragCancel,
        SoloTab(str),
        // PLAN-102 T-04：双输入模式。
        ToggleInputMode,
    }

    on {
        // poll 单飞：在途则计数（>3 拍释放——丢响应有界恢复），否则发起。
        .Poll -> {
            // 视口宽随拍刷新（宽度分层布局的驱动源；写值才有视图意义）。
            var w int = 1280
            let aw = localStorage.getItem("app.viewport_w")
            if aw != None {
                let v = aw.to_int()
                if v > 0 { w = v }
            }
            if w == 1280 {
                let vw = localStorage.getItem("vm.window_inner_width")
                if vw != None {
                    let v2 = vw.to_int()
                    if v2 > 0 { w = v2 }
                }
            }
            if w != .cv_win_w {
                .cv_win_w = w
            }
            if .cv_layout_loaded == false {
                let ws102 = localStorage.getItem("musk_workspace") ?? ""
                let pref102 = canvasLayoutPrefDecode(localStorage.getItem(canvasLayoutPrefKey(ws102)) ?? "")
                .cv_dock = pref102.dock ?? "left"
                .cv_dock_w = pref102.dock_w ?? 240
                .cv_dock_h = pref102.dock_h ?? 240
                .cv_outer_w = pref102.outer_w ?? 640
                if .cv_wb_w > 0 { .cv_dock_w = canvasClampDockW(.cv_wb_w, .cv_dock_w) }
                if .cv_wb_h > 0 { .cv_dock_h = canvasClampDockH(.cv_wb_h, .cv_dock_h) }
                .cv_outer_w = canvasClampOuterW(canvasOuterContainerW(w), .cv_outer_w)
                .cv_dock_w_decl = canvasDockWDecl(.cv_dock_w)
                .cv_dock_h_decl = canvasDockHDecl(.cv_dock_h)
                .cv_outer_w_decl = canvasOuterWDecl(.cv_outer_w)
                .cv_layout_mode = canvasDockMode(.cv_dock, .cv_wb_w, .cv_wb_h)
                .cv_layout_loaded = true
            }
            // 工作台容器尺寸随拍（PLAN-102 T-03）：web 实测量
            //（installCanvasLayoutSync → canvas.wb_* 键）优先；VM 轨派生
            //（外框宽即工作台容器宽 / 窗口高 - chrome 常数）。变化即重钳
            //（窄→宽自动恢复；宽→窄降级判定由 canvasDockMode 承担）。
            var wbw int = 0
            var wbh int = 0
            let cww102 = localStorage.getItem("canvas.wb_w")
            if cww102 != None {
                let vv = cww102.to_int()
                if vv > 0 { wbw = vv }
            }
            let cwh102 = localStorage.getItem("canvas.wb_h")
            if cwh102 != None {
                let vv2 = cwh102.to_int()
                if vv2 > 0 { wbh = vv2 }
            }
            if wbw <= 0 { wbw = .cv_outer_w }
            if wbh <= 0 {
                let vh102 = localStorage.getItem("vm.window_inner_height")
                if vh102 != None {
                    let vv3 = vh102.to_int()
                    if vv3 > 29 { wbh = canvasWbEstH(vv3) }
                }
            }
            if wbw > 0 && wbh > 0 {
                if wbw != .cv_wb_w || wbh != .cv_wb_h {
                    .cv_wb_w = wbw
                    .cv_wb_h = wbh
                    .cv_dock_w = canvasClampDockW(wbw, .cv_dock_w)
                    .cv_dock_h = canvasClampDockH(wbh, .cv_dock_h)
                    .cv_dock_w_decl = canvasDockWDecl(.cv_dock_w)
                    .cv_dock_h_decl = canvasDockHDecl(.cv_dock_h)
                    .cv_layout_mode = canvasDockMode(.cv_dock, wbw, wbh)
                }
            }
            if .cv_inflight {
                .cv_inflight_ticks = .cv_inflight_ticks + 1
                if .cv_inflight_ticks > 3 {
                    .cv_inflight = false
                    .cv_inflight_ticks = 0
                }
            } else {
                .cv_inflight = true
                Http.get_msg("/api/canvas/status", "CanvasStore.StatusBackfill")
            }
        }

        .ProgInput(msgs list) -> {
            .cp_prog_msgs = msgs
        }

        .StatusBackfill(payload str) -> {
            // 单飞对账：非在途到达 = 迟到/自发载荷，直接丢弃（不落账）。
            if .cv_inflight {
                let r = JSON.parse(payload)
                if r != None {
                    if r.ok == true {
                        let body = JSON.parse(r.body)
                        if body != None {
                            .cv_inflight = false
                            .cv_inflight_ticks = 0
                            // 身份对账：代次变化（A→B/重启换代）统一清场。
                            var gen int = body.generation_id ?? 0
                            if gen != .cv_gen {
                                .cv_gen = gen
                                .cv_picked_id = ""
                                .cv_picked_kind = ""
                                .cv_picked_label = ""
                                .cv_picked_source = ""
                                .cv_picked_source_path = ""
                                .cv_picked_for = ""
                                .cv_pick_style = ""
                                .cv_picked_source_line = 0
                                .cv_picked_confidence = ""
                                .cv_picked_loop_var = ""
                                .cv_picked_loop_index = -1
                                .cv_picked_loop_value = ""
                                .cv_source_state = ""
                                .cv_source_lines = []
                                .cv_source_rows = []
                                .cv_overlay = []
                                .cv_frame_url = ""
                                .cv_tree_collapsed = {}
                                .cv_tree_visible = []
                                // T-06:代次清场连带帧尺寸（旧帧几何不跨代次）。
                                .cv_frame_w = 0
                                .cv_frame_h = 0
                                .cv_frame_wrap_style = canvasContentStyle(0, 0, .cv_zoom_fit)
                            }
                            .cv_state = body.state ?? "stopped"
                            // PLAN-102 T-04：presentation 面板（embedded
                            // 携带 bridge WS 端点；代次变化时清场由上方
                            // gen 分支承担——桥由消费模块按 url 重连）。
                            var pres = body.presentation
                            if pres != None {
                                var pm = pres.mode ?? "window"
                                if pm == "embedded" {
                                    .cv_embed = true
                                    .cv_bridge_url = pres.bridge_ws_url ?? ""
                                } else {
                                    .cv_embed = false
                                    .cv_bridge_url = ""
                                }
                            }
                            // 桥端点仅变化时落键（web 消费模块轮询本键建连；
                            // 1s 拍直写会淹键——SetDock 同款变化守卫）。
                            var prev_bridge = localStorage.getItem("canvas.bridge_url") ?? ""
                            if prev_bridge != .cv_bridge_url {
                                localStorage.setItem("canvas.bridge_url", .cv_bridge_url)
                            }
                            // web 消费面就绪标记（installCanvasEmbed 写键；
                            // VM 轨缺席 → img 降级）。
                            var embed_ready = localStorage.getItem("canvas.embed_ready")
                            .cv_embed_web = embed_ready == "1"
                            // 停止后保留应用描述（已停止工作台的标题）。
                            // T-11:app_path ?? "" 归一——部分载荷（gallery
                            // stub {} 体实机暴露）下 undefined 对 != "" 判
                            // 真，空标题渲染成"已停止"面（V04 VM 臂取证）。
                            var ap = body.app_path ?? ""
                            if ap != "" {
                                .cv_app = ap
                            }
                            .cv_error = body.error ?? ""
                            .cv_output_tail = body.output_tail ?? ""
                            var seq int = body.seq ?? 0
                            if .cv_state == "stopped" {
                                .cv_seq = seq
                                .cv_frame_url = ""
                            } else {
                                if seq != .cv_seq {
                                    .cv_seq = seq
                                    .cv_frame_url = canvasFrameUrl(seq, .cv_gen)
                                }
                            }
                            // picked 统一投影：null（204/清选/stopped）与有值
                            // 同走一个漏斗——全字段清/填不再分叉（AC-08）。
                            var pp = canvasPickedProjection(body.picked)
                            .cv_picked_id = pp.id
                            .cv_picked_kind = pp.kind
                            .cv_picked_label = pp.label
                            .cv_picked_source = pp.source
                            .cv_picked_source_path = pp.source_path
                            .cv_picked_for = pp.for_label
                            .cv_pick_style = pp.style
                            .cv_picked_source_line = pp.source_line
                            .cv_picked_confidence = pp.confidence
                            .cv_picked_loop_var = pp.loop_var
                            .cv_picked_loop_index = pp.loop_index
                            .cv_picked_loop_value = pp.loop_value
                            .cv_overlay = rebuildCanvasOverlay(body.overlay ?? [])
                            .cv_tree = rebuildCanvasTree(body.tree ?? [])
                            .cv_tree_visible = canvasTreeVisible(.cv_tree, .cv_tree_collapsed)
                            if .cv_source_state == "ok" {
                                .cv_source_rows = canvasSourceRows(.cv_source_lines, .cv_picked_source_line)
                            }
                            var pc = body.pac_head
                            if pc != None {
                                .cv_pac_title = pc.title ?? ""
                            } else {
                                .cv_pac_title = ""
                            }
                            // PLAN-093 T-06:帧物理尺寸回填（status.frame；
                            // 缺失/无效归零=包装层退化占满）+ 包装层样式
                            // 单源重算。
                            var fw2 = body.frame
                            if fw2 != None {
                                .cv_frame_w = fw2.w ?? 0
                                .cv_frame_h = fw2.h ?? 0
                            } else {
                                .cv_frame_w = 0
                                .cv_frame_h = 0
                            }
                            .cv_frame_wrap_style = canvasContentStyle(.cv_frame_w, .cv_frame_h, .cv_zoom_fit)
                            // 开合投影：有会话（非 stopped 或 有应用描述）且
                            // 未被用户收起。轮询不改 cv_collapsed。
                            var has_session bool = .cv_state != "stopped" || .cv_app != ""
                            .cv_open = has_session && !.cv_collapsed
                        }
                    } else {
                        // 错误信封：释放在途（下一拍重试），其余不落账。
                        .cv_inflight = false
                        .cv_inflight_ticks = 0
                    }
                }
            }
        }

        // 点选/树选即时回填（canvasPick 的 JSON 结果；不等下一拍轮询）。
        // 载荷 = pick 锚点对象文本（同 status.picked 形态）；经同一投影
        // 漏斗（与轮询对账面同源）。
        .PickBackfill(payload str) -> {
            let pd = JSON.parse(payload)
            if pd != None {
                var pp = canvasPickedProjection(pd)
                .cv_picked_id = pp.id
                .cv_picked_kind = pp.kind
                .cv_picked_label = pp.label
                .cv_picked_source = pp.source
                .cv_picked_source_path = pp.source_path
                .cv_picked_for = pp.for_label
                .cv_pick_style = pp.style
                .cv_picked_source_line = pp.source_line
                .cv_picked_confidence = pp.confidence
                .cv_picked_loop_var = pp.loop_var
                .cv_picked_loop_index = pp.loop_index
                .cv_picked_loop_value = pp.loop_value
            }
        }

        // 204/清选/节点消失统一清场（同投影漏斗空面）。
        .ClearPick -> {
            var pp = canvasPickedProjection(None)
            .cv_picked_id = pp.id
            .cv_picked_kind = pp.kind
            .cv_picked_label = pp.label
            .cv_picked_source = pp.source
            .cv_picked_source_path = pp.source_path
            .cv_picked_for = pp.for_label
            .cv_pick_style = pp.style
            .cv_picked_source_line = pp.source_line
            .cv_picked_confidence = pp.confidence
            .cv_picked_loop_var = pp.loop_var
            .cv_picked_loop_index = pp.loop_index
            .cv_picked_loop_value = pp.loop_value
            .cv_source_state = ""
            .cv_source_rows = []
        }

        // 收起 = 用户偏好（工作台显隐），与生命周期分离：停止/轮询不改；
        // PID、代次、帧序号继续有效。
        .Collapse -> {
            .cv_collapsed = true
            .cv_open = false
        }

        .UnCollapse -> {
            .cv_collapsed = false
            var has_session bool = .cv_state != "stopped" || .cv_app != ""
            .cv_open = has_session
        }

        .ToggleSource -> {
            .cv_source_tab = "source"
        }

        // T-07:左列页签切换（结构/源码）。
        .SourceTab(tab str) -> {
            .cv_source_tab = tab
        }

        // T-07:折叠切换（vid 稳定键）+ 可见行单源重算。
        .ToggleTreeNode(vid str) -> {
            let cur = .cv_tree_collapsed[vid]
            if cur == true {
                .cv_tree_collapsed[vid] = false
            } else {
                .cv_tree_collapsed[vid] = true
            }
            .cv_tree_visible = canvasTreeVisible(.cv_tree, .cv_tree_collapsed)
        }

        // T-07:源码读失败落账（面板 error 面文案）。
        .SourceLoadFail(err str) -> {
            .cv_source_state = "error"
            .cv_source_err = err
            .cv_source_lines = []
            .cv_source_rows = []
        }

        // PLAN-093 T-05 §5.2 窄层（768-1023）：结构列显隐切换（受控面板）。
        .ToggleStructure -> {
            .cv_structure_open = !.cv_structure_open
        }

        // PLAN-093 T-06:适应/100% 缩放切换（用户偏好;包装层样式单源重算）。
        .ToggleZoom -> {
            .cv_zoom_fit = !.cv_zoom_fit
            .cv_frame_wrap_style = canvasContentStyle(.cv_frame_w, .cv_frame_h, .cv_zoom_fit)
        }

        // PLAN-093 T-09:degraded 详情展开切换（视图态）。
        .ToggleErrorDetails -> {
            .cv_error_details_open = !.cv_error_details_open
        }

        // PLAN-093 T-09:重运行失败落 error 面（下一拍轮询以真实状态覆盖）。
        .SetCanvasError(err str) -> {
            .cv_error = err
        }

        .SourceBackfill(payload str) -> {
            .cv_source_lines = canvasSourceLines(payload)
            .cv_source_rows = canvasSourceRows(.cv_source_lines, .cv_picked_source_line)
            .cv_source_state = "ok"
            .cv_source_err = ""
        }

        // ── PLAN-102 T-03：停靠布局动作族 ──────────────────────────────

        // 停靠切换（hidden 保留方向外的一切：页签/选择/树折叠原样）。
        .SetDock(d str) -> {
            .cv_dock = d
            .cv_layout_mode = canvasDockMode(.cv_dock, .cv_wb_w, .cv_wb_h)
            let ws102 = localStorage.getItem("musk_workspace") ?? ""
            localStorage.setItem(canvasLayoutPrefKey(ws102), canvasLayoutPrefEncode(.cv_dock, .cv_dock_w, .cv_dock_h, .cv_outer_w))
        }

        // 宿主报告工作台容器实际尺寸（非视口替代——外框/停靠双钳制源）；
        // 变化即重钳当前偏好尺寸（窄→宽自动恢复合法值）+ 重算模式与声明串。
        .LayoutContainer(w int, h int) -> {
            if w != .cv_wb_w || h != .cv_wb_h {
                .cv_wb_w = w
                .cv_wb_h = h
                .cv_dock_w = canvasClampDockW(w, .cv_dock_w)
                .cv_dock_h = canvasClampDockH(h, .cv_dock_h)
                .cv_dock_w_decl = canvasDockWDecl(.cv_dock_w)
                .cv_dock_h_decl = canvasDockHDecl(.cv_dock_h)
                .cv_layout_mode = canvasDockMode(.cv_dock, .cv_wb_w, .cv_wb_h)
            }
        }

        // 内部分隔条拖动：Start 记基线（取消恢复）；Move 即时钳制预览
        //（不持久化）；End 持久化；Cancel 恢复起始尺寸（不停应用）。
        .DockDragStart(kind str, origin_px int, size0 int) -> {
            .cv_drag_kind = kind
            .cv_drag_origin = origin_px
            .cv_drag_size0 = size0
        }
        .DockDragMove(delta_px int) -> {
            if .cv_drag_kind == "h" {
                .cv_dock_w = canvasDockDragSize(.cv_dock, "h", .cv_wb_w, .cv_wb_h, .cv_drag_origin, delta_px)
                .cv_dock_w_decl = canvasDockWDecl(.cv_dock_w)
            } else {
                if .cv_drag_kind == "b" {
                    .cv_dock_h = canvasDockDragSize(.cv_dock, "b", .cv_wb_w, .cv_wb_h, .cv_drag_origin, delta_px)
                    .cv_dock_h_decl = canvasDockHDecl(.cv_dock_h)
                }
            }
        }
        // 分隔条 move 增量（4096 逻辑域；切片④形态——换算单源进 store，
        // 探针注入与真实指针共用同一常量）。容器维度未报（0）时丢弃。
        .DockDragLogical(kind str, delta_logical int) -> {
            if kind == "h" {
                if .cv_wb_w > 0 {
                    .cv_dock_w = canvasDockDragSize(.cv_dock, "h", .cv_wb_w, .cv_wb_h, .cv_drag_origin, canvasLogicalToPx(delta_logical, .cv_wb_w))
                    .cv_dock_w_decl = canvasDockWDecl(.cv_dock_w)
                }
            } else {
                if kind == "b" {
                    if .cv_wb_h > 0 {
                        .cv_dock_h = canvasDockDragSize(.cv_dock, "b", .cv_wb_w, .cv_wb_h, .cv_drag_origin, canvasLogicalToPx(delta_logical, .cv_wb_h))
                        .cv_dock_h_decl = canvasDockHDecl(.cv_dock_h)
                    }
                }
            }
        }
        .DockDragEnd -> {
            .cv_drag_kind = ""
            let ws102 = localStorage.getItem("musk_workspace") ?? ""
            localStorage.setItem(canvasLayoutPrefKey(ws102), canvasLayoutPrefEncode(.cv_dock, .cv_dock_w, .cv_dock_h, .cv_outer_w))
        }
        .DockDragCancel -> {
            if .cv_drag_kind == "h" {
                .cv_dock_w = .cv_drag_size0
                .cv_dock_w_decl = canvasDockWDecl(.cv_dock_w)
            } else {
                if .cv_drag_kind == "b" {
                    .cv_dock_h = .cv_drag_size0
                    .cv_dock_h_decl = canvasDockHDecl(.cv_dock_h)
                }
            }
            .cv_drag_kind = ""
        }

        // 键盘步进（±10 / 0=Home 恢复初值；nudge 亦持久化）。
        .DockNudge(kind str, step int) -> {
            if kind == "h" {
                .cv_dock_w = canvasDockNudgeSize(.cv_dock, "h", .cv_wb_w, .cv_wb_h, .cv_dock_w, step)
                .cv_dock_w_decl = canvasDockWDecl(.cv_dock_w)
            } else {
                if kind == "b" {
                    .cv_dock_h = canvasDockNudgeSize(.cv_dock, "b", .cv_wb_w, .cv_wb_h, .cv_dock_h, step)
                    .cv_dock_h_decl = canvasDockHDecl(.cv_dock_h)
                }
            }
            let ws102 = localStorage.getItem("musk_workspace") ?? ""
            localStorage.setItem(canvasLayoutPrefKey(ws102), canvasLayoutPrefEncode(.cv_dock, .cv_dock_w, .cv_dock_h, .cv_outer_w))
        }

        // 正常模式外框（与聊天区间的外部分隔条；与内部 DevTools 分隔条
        // 分别管理尺寸）。
        .OuterDragStart(origin_px int, size0 int) -> {
            .cv_drag_kind = "outer"
            .cv_drag_origin = origin_px
            .cv_drag_size0 = size0
        }
        .OuterDragMove(delta_px int) -> {
            // 容器 = 视口 - 侧栏估算（切片①误用 wb_w+outer_w——工作台容器
            // 宽≈outer_w，两者相加≠行宽；统一走 canvasOuterContainerW）。
            .cv_outer_w = canvasClampOuterW(canvasOuterContainerW(.cv_win_w), .cv_drag_origin + delta_px)
            .cv_outer_w_decl = canvasOuterWDecl(.cv_outer_w)
        }
        // 外部分隔条 move 增量（4096 逻辑域；换算容器 = 外框容器宽）。
        .OuterDragLogical(delta_logical int) -> {
            .cv_outer_w = canvasClampOuterW(canvasOuterContainerW(.cv_win_w), .cv_drag_origin + canvasLogicalToPx(delta_logical, canvasOuterContainerW(.cv_win_w)))
            .cv_outer_w_decl = canvasOuterWDecl(.cv_outer_w)
        }
        .OuterDragEnd -> {
            .cv_drag_kind = ""
            let ws102 = localStorage.getItem("musk_workspace") ?? ""
            localStorage.setItem(canvasLayoutPrefKey(ws102), canvasLayoutPrefEncode(.cv_dock, .cv_dock_w, .cv_dock_h, .cv_outer_w))
        }
        .OuterDragCancel -> {
            .cv_outer_w = .cv_drag_size0
            .cv_outer_w_decl = canvasOuterWDecl(.cv_outer_w)
            .cv_drag_kind = ""
        }

        // tabs 降级单区页签切换（画布/工具）。
        .SoloTab(tab str) -> {
            .cv_solo_tab = tab
        }

        // ── PLAN-102 T-04：双输入模式 ──────────────────────────────────

        // operate ↔ inspect（工具栏切换；operate 输入发应用，inspect 只
        // 拾取——web 消费模块经 canvas.input_mode 键感知）。
        .ToggleInputMode -> {
            if .cv_input_mode == "operate" {
                .cv_input_mode = "inspect"
            } else {
                .cv_input_mode = "operate"
            }
            localStorage.setItem("canvas.input_mode", .cv_input_mode)
        }

    }
}
