// canvas_store.at — PLAN-087 T-07 + PLAN-088 T-07: 画布会话轮询 store。
//
// 状态命名 cv_*：避让潜在 api 绑定撞名（whitelist wl_* 同款口径）。
// 轮询机制 = forge_store PollBackfill 同款：timer 拍发起 Http.get_msg
// （入队即返），载荷以字符串回填消息解析（{"ok","status","body"} 信封）。
// body = {state,seq,app_path,restarts,error} + M2 锚定面 {frame,picked,
// overlay,tree,pac}。M2 扁平重建漏斗（PLAN-084 T-07 rebuildSessions 处方）：
// JSON.parse 产物直接落 store 后渲染上下文字段读塌空（r5 家族）——handler
// 域逐字段重建为字面量，视图读恢复。id 全程字符串形态（哈希 vnode >
// JS 2^53，数字静默截断）。
// VM 轨：状态轮询会打到宿主桥（无 /api/canvas/* → ok!=true 被守卫吸收，
// 面板恒收起）；画布面板验收面=web 轨（087 §10-2 口径延续）。

// overlay 条目 → [{vid, style}]（agent 高亮=琥珀框，完整内联样式）。
fn rebuildCanvasOverlay(list obj) list {
    var out list = []
    for s in list {
        var vid = s.vnode_id ?? ""
        var style str = ""
        var bp = s.bbox_pct
        if bp != None {
            style = "position:absolute;left:" + bp.x + "%;top:" + bp.y + "%;width:" + bp.w + "%;height:" + bp.h + "%;border:2px solid rgb(245,158,11);background:rgba(245,158,11,0.15);pointer-events:none;border-radius:2px"
        }
        out.push({ vid: vid, style: style })
    }
    return out
}

// 层树扁平表 → [{vid, depth, kind, label, source, source_path, for_label,
// row_style, indent_style}]（行样式预拼：选中底色视图侧靠 id 等值三臂）。
fn rebuildCanvasTree(list obj) list {
    var out list = []
    for n in list {
        var vid = n.id ?? ""
        var depth = n.depth ?? 0
        var kind = n.kind ?? ""
        var label = n.label ?? ""
        var source = n.source ?? ""
        var source_path = n.source_path ?? ""
        var for_label str = ""
        var fi = n.loop_index
        if fi != None {
            var fv = n.loop_value ?? ""
            for_label = "#" + fi + " " + fv
        }
        var pad int = 4 + depth * 12
        var indent = "padding-left:" + pad + "px"
        out.push({ vid: vid, depth: depth, kind: kind, label: label, source: source, source_path: source_path, for_label: for_label, indent_style: indent })
    }
    return out
}

store CanvasStore {
    model {
        // 会话状态（后端 CanvasState 小写串）。
        var cv_state str = "stopped"
        // 帧序号（单调递增；驱动 img src 缓存击穿）。
        var cv_seq int = 0
        // 帧直出 URL（seq 变化才重写，避免无脑刷帧）。
        var cv_frame_url str = ""
        // 在跑的 app 目录显示名。
        var cv_app str = ""
        // 最近错误（degraded 机理等）。
        var cv_error str = ""
        // 面板开合（有非 stopped 会话自动展开；stop 后收起）。
        var cv_open bool = false
        // ── M2 锚定面（扁平重建漏斗产出） ──
        var cv_picked_id str = ""
        var cv_picked_kind str = ""
        var cv_picked_label str = ""
        var cv_picked_source str = ""
        var cv_picked_source_path str = ""
        var cv_picked_for str = ""
        // 选中覆盖框内联 style（bbox_pct 百分比定位）。
        var cv_pick_style str = ""
        // agent 高亮框 [{vid, style}]。
        var cv_overlay []Value = []
        // 层树扁平表 [{vid, depth, kind, label, source, for_label}]。
        var cv_tree []Value = []
        // pac 头显示名。
        var cv_pac_title str = ""
        // 源码预览开合（锚点 chip → 源码抽屉）+ 已载文本。
        var cv_source_open bool = false
        var cv_source_text str = ""
    }

    timer {
        Poll (every_ms: 1000)
    }

    msg Msg {
        Poll,
        StatusBackfill(str),
        PickBackfill(str),
        ClearPick,
        ToggleSource,
        SourceBackfill(str),
    }

    on {
        .Poll -> {
            Http.get_msg("/api/canvas/status", "CanvasStore.StatusBackfill")
        }

        .StatusBackfill(payload str) -> {
            let r = JSON.parse(payload)
            if r != None {
                if r.ok == true {
                    let body = JSON.parse(r.body)
                    if body != None {
                        .cv_state = body.state ?? "stopped"
                        .cv_app = body.app_path ?? ""
                        .cv_error = body.error ?? ""
                        var seq int = body.seq ?? 0
                        if seq != .cv_seq {
                            .cv_seq = seq
                            .cv_frame_url = "/api/canvas/frame?t=" + seq
                        }
                        if body.state == "stopped" {
                            .cv_open = false
                        } else {
                            .cv_open = true
                        }
                        var pk obj = body.picked
                        if pk != None {
                            .cv_picked_id = pk.vnode_id ?? ""
                            .cv_picked_kind = pk.kind ?? ""
                            .cv_picked_label = pk.label ?? ""
                            .cv_picked_source = pk.source ?? ""
                            .cv_picked_source_path = pk.source_path ?? ""
                            var fc obj = pk.forctx
                            if fc != None {
                                var fi obj = fc.index
                                if fi != None {
                                    .cv_picked_for = "#" + fi
                                } else {
                                    .cv_picked_for = ""
                                }
                            } else {
                                .cv_picked_for = ""
                            }
                            var bp obj = pk.bbox_pct
                            if bp != None {
                                .cv_pick_style = "position:absolute;left:" + bp.x + "%;top:" + bp.y + "%;width:" + bp.w + "%;height:" + bp.h + "%;border:2px solid rgb(59,130,246);background:rgba(59,130,246,0.12);pointer-events:none;border-radius:2px"
                            } else {
                                .cv_pick_style = ""
                            }
                        }
                        .cv_overlay = rebuildCanvasOverlay(body.overlay ?? [])
                        .cv_tree = rebuildCanvasTree(body.tree ?? [])
                        var pc = body.pac_head
                        if pc != None {
                            .cv_pac_title = pc.title ?? ""
                        } else {
                            .cv_pac_title = ""
                        }
                    }
                }
            }
        }

        // 点选/树选即时回填（canvasPick 的 JSON 结果；不等下一拍轮询）。
        // 载荷 = pick 锚点对象文本（同 status.picked 形态）。
        .PickBackfill(payload str) -> {
            let pd = JSON.parse(payload)
            if pd != None {
                .cv_picked_id = pd.vnode_id ?? ""
                .cv_picked_kind = pd.kind ?? ""
                .cv_picked_label = pd.label ?? ""
                .cv_picked_source = pd.source ?? ""
                .cv_picked_source_path = pd.source_path ?? ""
                var fc obj = pd.forctx
                if fc != None {
                    var fi obj = fc.index
                    if fi != None {
                        .cv_picked_for = "#" + fi
                    } else {
                        .cv_picked_for = ""
                    }
                } else {
                    .cv_picked_for = ""
                }
                var bp obj = pd.bbox_pct
                if bp != None {
                    .cv_pick_style = "position:absolute;left:" + bp.x + "%;top:" + bp.y + "%;width:" + bp.w + "%;height:" + bp.h + "%;border:2px solid rgb(59,130,246);background:rgba(59,130,246,0.12);pointer-events:none;border-radius:2px"
                } else {
                    .cv_pick_style = ""
                }
            }
        }

        .ClearPick -> {
            .cv_picked_id = ""
            .cv_picked_kind = ""
            .cv_picked_label = ""
            .cv_picked_source = ""
            .cv_picked_source_path = ""
            .cv_picked_for = ""
            .cv_pick_style = ""
            .cv_source_open = false
        }

        .ToggleSource -> {
            .cv_source_open = !.cv_source_open
        }

        .SourceBackfill(payload str) -> {
            .cv_source_text = payload
        }
    }
}
