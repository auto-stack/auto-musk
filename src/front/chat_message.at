// chat_message.at — 已废弃（Plan 022-B 改用逃生舱组件）
//
// ChatMessage 原设计为 view fn（内联展开），但在 ChatsView 通过
// use{component} 引用时 extract.rs 把它当外部组件跳过 VIEW_FRAGMENTS
// 查找，导致内联不生效，只生成空 <ChatMessage /> 标签。
//
// 改为 src/front/components/ChatMessage.vue 逃生舱组件（和
// StreamingRenderer/UserMessage 同级），ChatsView 通过
// use { component: ChatMessage } 引用，调用时传 msg + is_streaming props。
//
// 本文件保留为空壳（避免 codegen 扫描不到文件报错）。

widget ChatMessageDeprecated {
    model { var _unused int = 0 }
    view { col { text "deprecated" } }
    on { }
}
