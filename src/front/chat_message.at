// chat_message.at — ChatMessage 组件（有序 block 渲染模型）
//
// assistant 回复不再「整段文本 + 尾部 thinking + 后置工具卡」，而是按
// 到达顺序渲染 block 流：文本块（气泡）/ ThinkBlock（默认折叠，token 数，
// 展开滚动 + 最大高度）/ ToolBlock（tool-use 卡片）。已显示的块不会删除。
//
// 依赖：
//   - UserMessage / ThinkBlock / ToolBlock（本项目 component fn）
//   - StreamingRenderer（逃生舱，use{component from "..."} 引用）
//   - messageBlocks / isBlockStreaming / isMsgStreaming / estimateTokens /
//     msgTimeLabel fn（forge_helpers.ts；.at 无 Date/数组推导等宿主 API）
//
// 历史/重载消息无 msg.blocks 时，messageBlocks 从持久化字段合成
// （thinking → text → tool_calls），保证渲染模型统一。
//
// PLAN-049 T6 双轨收敛：原 style{} 块（.msg-row/.msg-blocks/.msg-bubble-* 等）
// 全量迁内联工具类；角色相关差异（用户行右对齐/徽章色）改 computed 条件类串
// （原 :has() 结构选择器的等价表达）。v-html 内部 .inline-mention 高亮与
// .streaming-document 深层排版为 web-only（inject_styles.web-only.ts）。
// AI 侧无边框正文（Claude 风格）不变：文本块透明、上下 hairline 由 msg-blocks
// 容器 utilities 承担（VM 侧单侧边框降级登记）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web useT from "src/front/ports/composables.at"
use.web component Markdown from "src/front/ports/renderer.at"
use.web component Copy, GitFork, Loader from "src/front/ports/icons.at"
// PLAN-055 T13: thinkLabel 进内联思考块（ThinkBlock 子件退役）；thinkIsOpen
// 走 store.think_open 键列表（键=msg.id）。
// 2026-09-03:工具卡内联（ToolBlock/GenericToolCard 子件退役,沿 ThinkBlock
// 先例——VM 子件 model 全实例共享 + 孙件 store 直调不可靠,回归根因）。补充
// toolIsOpen/toolArgsJson/extractRunId 与 relay 助手导入。
use.web expandedMessageBlocks, msgTimeLabel, messageDisplayBlocks, isBlockStreaming, estimateTokens, thinkLabel, thinkIsOpen, toolIsOpen, toolToggleList, toolArgsJson, extractRunId, agentDisplayName, streamThinkingTail, msgIsWaiting from "src/front/forge_helpers.at"
use.web relayReportView from "src/front/relay_run_helpers.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use user_message: UserMessage
// PLAN-071 r3：助手消息头部职业头像（复用 mention_dropdown 同款组件）。
use agent_avatar: AgentAvatar
use errand_card: ErrandCard
use relay_run_box: RelayRunBox
use task_plan_card: TaskPlanCard
use report_card: ReportCard
// PLAN-073 F-B：审批门卡片接入聊天消息视图——原 ToolGateCard 只挂在已退役
// 的 ToolBlock 链上，ChatMessage 内联工具模板没有 gate_waiting 分支：human
// 会话越界命令暂停后既无 approve/deny 入口（运行挂到 1800s 门超时），状态
// 又被 else 兜底渲染成绿色 completed（用户侧呈现"卡住但显示完成"）。
use tool_gate_card: ToolGateCard
// toolbar-icons 2026-10-10 r6：名字槽=消息 aname 字段（ForgeStore 在消息
// 创建点解析：乐观消息 Send/SendWithCtx 写、回填消息 rebuildParsedMessages
// 漏斗写——均为根上下文已证形态；名字源=/api/forge/relay/professions 的
// {id,name}，用户可编辑 professions.json）。子件不读职业表：store 绑定读
// 不达根态、list prop 跨界不可迭代（PLAN-051），视图循环解析两路皆弃。


widget ChatMessage(msg: obj, is_streaming: bool, errands: obj, relays: obj, task_plans: obj, think_open: str, tool_open: str, spin_char: str, hover_msg: str) {
    // PLAN-060 T2:ForkFrom 上抛分叉请求（mid=msg.id）——子件空 handler,
    // 经 onfork 声明路由直达宿主 BranchTo（零参帧对齐根修后单参载荷同链）。
    // toolbar-icons 2026-10-10:CancelRun 撤除——"停止回复"退出 AI 消息工具栏,
    // 归位 composer 发送钮（发送⇄停止 morph,oncancel→ForgeStore.CancelRun）。
    // toolbar-icons 2026-10-10 r7b：HoverIn/HoverOut——mouse-area hover
    // 上抛（空 handler 路由,父层 on_hover_in/on_hover_out 绑定直达宿主,
    // ForkFrom 同款 snake 全名绑定形态）。
    msg Msg { CopyContent, ToggleThink(str), ToolToggleKey(str), ForkFrom(str), HoverIn(str), HoverOut }
    on {
        // 【2026-09-04 三次定案】展开态回归 ForgeStore 键列表——二次修正的
        // 消息对象直写（.msg.think_expanded/.msg.tool_expanded）在 VM 为
        // for-in 循环副本写,读侧永不更新（用户实机:工具卡点不开）。写:子件
        // handler 直调 store（跨件沿 ForgeStore.Init() 先例,写入进共享根态）;
        // 读:think_list/tool_list prop 每帧重建刷新（chats_view 传 store 字段）。
        .ToggleThink(key str) -> {
            ForgeStore.ThinkToggle(key)
        }
        .ToolToggleKey(key) -> {
            ForgeStore.ToolToggle(key)
        }
        .ForkFrom(mid str) -> {
        }
        // toolbar-icons 2026-10-10 r7b：hover 上抛空路由（真处理在父层
        // on_hover_in/on_hover_out 绑定——ForkFrom 同款路由形态）。
        .HoverIn(mid str) -> {
        }
        .HoverOut -> {
        }
        // PLAN-055: AI 消息工具栏 copy（对齐 web 原版 message-toolbar）。
        .CopyContent -> {
            dom.copy_text(.msg.content)
        }
    }
// 2026-09-03:工具卡内联后 .tool-* scoped 样式随元素迁入本文件（scoped CSS
// 只打本组件模板;取值沿 generic_tool_card.at 原基准,web 精调/hover 兜底,
// VM 侧观感由元素内联工具类承载）。
style {
.tool-card { border: 1px solid hsl(var(--border)); border-radius: 8px; margin: 0; overflow: hidden; width: 100%; background: transparent; }
.tool-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem; cursor: pointer; user-select: none; }
.tool-header:hover { background: hsl(var(--muted-foreground) / 0.04); }
.tool-icon { font-size: 0.93rem; line-height: 1; flex-shrink: 0; }
.tool-name { font-size: 0.83rem; font-weight: 500; color: hsl(var(--foreground)); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tool-seg { font-size: 0.78rem; font-weight: 500; font-family: 'Geist Mono', 'Fira Code', monospace; flex-shrink: 0; }
.tool-seg.seg-path { color: hsl(190 80% 40%); }
.tool-seg.seg-loc { color: hsl(var(--muted-foreground)); }
.tool-seg.seg-pattern { color: hsl(280 60% 45%); }
.tool-seg.seg-desc { color: hsl(var(--foreground)); }
/* r12:命令参数灰（run_command 卡头的命令串，与工具名拉开层次） */
.tool-seg.seg-cmd { color: hsl(var(--muted-foreground)); }
.tool-status { font-size: 0.73rem; font-weight: 500; flex-shrink: 0; }
.tool-status.running { color: hsl(210 90% 52%); }
.tool-status.completed { color: hsl(142 71% 40%); }
.tool-status.failed { color: hsl(var(--destructive)); }
.tool-chevron { font-size: 0.7rem; color: hsl(var(--muted-foreground)); flex-shrink: 0; }
.tool-body { border-top: 1px solid hsl(var(--border)); padding: 0.5rem 0.6rem; }
.tool-section { margin-bottom: 0.4rem; }
.tool-section:last-child { margin-bottom: 0; }
.tool-section-title { font-size: 0.73rem; font-weight: 500; text-transform: uppercase; color: hsl(var(--muted-foreground)); margin-bottom: 0.2rem; letter-spacing: 0.02em; }
.tool-code { font-size: 0.83rem; color: hsl(var(--muted-foreground)); background: hsl(var(--muted-foreground) / 0.04); padding: 0.35rem 0.5rem; border-radius: 4px; overflow-x: auto; white-space: pre-wrap; word-break: break-word; font-family: 'Geist Mono', 'Fira Code', monospace; margin: 0; }
.tool-block-slot { width: 100%; }
/* PLAN-071 需求⑨：AI 启动窗口等待指示——原三点跳动（typing-dot keyframes）
   2026-10-10 退役：scoped 动画 VM 轨 style 块不注入且 span 无宽高即整组
   不可见（用户实机：VM 等待期无任何 loading）。改 lucide Loader 图标 +
   帧字符双通道：web 轨 animate-spin 旋转 Loader，帧字符由 .spin-char 隐藏
   （本 style 块 web-only 注入）；VM 轨 iced 无 CSS 动画，Loader 静态展示，
   帧字符（ForgeStore.SpinTick 120ms 换内容）承担动效——r1 的文字色 alpha
   呼吸实机无效（语义色 alpha 在 svg tint 链路被弃），本轨仅文本内容逐拍
   换为已证渲染路径。 */
.spin-char { display: none; }
}

    setup {
        let t = useT()
    }

    computed {
        role => .msg.role
        isUser => .role == "user"
        isAssistant => .role == "assistant"
        // PLAN-071 r4（需求③-1）：两侧对称限宽 70%——AI 回复不再占满全宽，
        // 与用户气泡同宽（用户 85%→70% 统一）。
        rowClass => if .isUser {
            "flex flex-col gap-[3px] max-w-[70%] self-end items-end"
        } else {
            "flex flex-col gap-[5px] self-stretch items-stretch max-w-[70%]"
        }
        headerClass => if .isUser {
            "flex items-center gap-2 px-1 justify-end"
        } else {
            "flex items-center gap-2 px-1"
        }
        badgeClass => if .isUser {
            "text-[13.6px] font-semibold text-primary"
        } else {
            "text-[13.6px] font-semibold text-muted-foreground"
        }
        badge => if .isUser { "You" } else { "AI" }
        // PLAN-071 r3：职业身份显示（名自 id 推导，不走 AgentConfigs——
        // 生成器 store 单别名限制；未携带身份回退 "🤖 AI" 徽章）。
        // PLAN-084 UAT⑪: 身份展示改漏斗预计算字段（aname）——视图 computed
        // 内 fn 调用静默返空（坑①），字段读已证；aname 空=乐观期回退徽章。
        // toolbar-icons 2026-10-10:aname→profession_id 双级兜底——乐观消息
        // （newAssistantMsg(modeRoleOf)）即带 profession_id 而回填投影才有
        // aname，原单级读使等待期头部恒落 "AI"（用户对拍 2026-10-10：应与
        // 完成态同为 assistant+徽章）。
        // toolbar-icons 2026-10-10 r5：名字槽/角色槽分离（用户对拍：头部
        // 双 assistant，名字应显 Agent 人名如 Nicole 而非角色）——名字槽=
        // AgentConfigs 职业表按 profession_id 解析（{id,name}，用户可编辑
        // professions.json；.store.configs 字段读+视图 for+if 均为已证形态，
        // 不涉坑①的 computed fn 调用）；badge 槽固定角色 id。表未载（首帧
        // 竞速）回退 aname→profession_id 链。
        agentAname => .msg.aname ?? ""
        agentApid => .msg.profession_id ?? ""
        agentName => if .agentAname != "" { .agentAname } else { .agentApid }
        showAgent => .isAssistant && .agentApid != ""
        // toolbar-icons 2026-10-10 r7b：消息级工具栏 hover 门——父层
        // hover_msg（mouse-area enter/exit 上抛的悬停消息 id）与本消息
        // id 相等即显（两 str prop 比较,子件 computed 已证形态）。
        tbVisible => .hover_msg == .msg.id
        userContent => .msg.content
        // PLAN-093 T-08:元素附件回放标记（轻量 chip——不塞 JSON 进气泡；
        // 单层链 computed，None 安全）。
        ctxKind => if .msg.design_context != None { .msg.design_context.kind ?? "" } else { "" }
        ctxLabel => if .msg.design_context != None { .msg.design_context.label ?? "" } else { "" }
        ctxSource => if .msg.design_context != None { .msg.design_context.source ?? "" } else { "" }
        // 展示用 blocks：text 已剥离问卷 JSON（问卷由 QuestionnaireCard 呈现），
        // 纯问卷消息的空 text 块已移除。多参 fn 收敛在 helper（.at if 条件不支持）。
        blocks => expandedMessageBlocks(.msg, .is_streaming, .think_open, .tool_open)
        time => msgTimeLabel(.msg.created_at)
        hasTime => .time != ""
        // PLAN-055 ④/T13：本消息思考块展开态（键=msg.id，每消息至多一个
        // thinking 块）。键列表经 prop 下传（chats_view 读 store 传 thinkList），
        // fn 调用收敛在 computed——事件实参须纯路径。2026-09-04 三次定案:
        // 展开态读 store 单槽字符串（str prop 每帧刷新,基元跨边界安全;
        // 列表 prop 跨界不可迭代）。r5：chev computed 移除（span 内联
        // if/else 旧渲染面已退役，chevron 改直挂 if/else text 节点，
        // 展开 flag 以块级 .block.expanded 为准）。
        thinkOpen => .think_open == .msg.id
        hasError => .msg.error != ""
        errorText => if .hasError { .msg.error } else { "" }
        // PLAN-071 需求⑨：AI 启动窗口（流式中且展示块为空）——等待指示显隐。
        // toolbar-icons 2026-10-10 r2：Loader 图标行类静态化（r1 alpha 呼吸
        // 实机无效）；帧字符 spin_char 经 store handler 域求值 + str prop
        // 下传（think_open 同款通道），VM 轨逐拍换内容承担动效。
        showWaiting => msgIsWaiting(.msg, .is_streaming)
        spinText => .spin_char ?? ""
    }
    view {
        col {
            class: .rowClass
            // header: 角色标识 + 时间（用户行右对齐,徽章随角色着色）。
            // PLAN-061 T11 (D17) 曾分支静态化规避 codegen :style= 缺陷;
            // PLAN-063 T21 回撤单路径——448 D 数组形态 style: [.computed]
            // 即动态类串的 sanctioned 通道(:class 发射),无需上游改码。
            row {
                style: [.headerClass]
                if .showAgent {
                    // PLAN-084 UAT⑪: 头像直渲染（AgentAvatar 组件内 computed
                    // fn 调用踩坑①渲染空——角色色块+首字母漏斗字段直读）。
                    // PLAN-084 UAT⑪: 头像 button 形态（w-5 h-5 标准刻度+
                    // flex 居中=rail 图标钮同构；span+任意值宽高触发 iced
                    // container unwrap 崩溃，二分实证）。
                    // PLAN-084 UAT⑪: 头像色块三形态（span 任意值宽高/disabled
                    // button/半透明 span）均触发 iced container.rs:291 unwrap
                    // 崩（渲染期，回填后即崩，X9-PANIC 三实锤）——暂撤，ainit
                    // 字段数据就绪，待 auto-lang 定位 container unwrap 触发
                    // 组合后复上（登记债）。
                    // toolbar-icons 2026-10-10 r6：名字槽=aname（ForgeStore
                    // 在消息创建点解析职业表写入，见 forge_store Send/
                    // rebuildParsedMessages），badge 槽固定角色 id（用户对拍：
                    // 名字显 Agent 人名而非角色）。
                    text .agentName { style: "text-[13.6px] font-semibold text-muted-foreground" }
                    // PLAN-084 UAT⑪: 角色 badge（用户裁定：icon+名称+角色）。
                    span {
                        style: "text-[11px] text-muted-foreground border border-border rounded-md px-1.5 py-[1px]"
                        text .agentApid
                    }
                } else {
                    text .badge { style: [.badgeClass] }
                }
                if .hasTime {
                    text .time { style: "text-xs text-muted-foreground" }
                }
            }
            // 内容（按 role 分支）
            if .isUser {
                col {
                    // PLAN-055: self-end——web 父列 items-end 已使气泡抱合右靠；
                    // VM 轨 visual-wrap 容器此前无条件 Fill（全宽紫条形态），
                    // renderer 对 self-end 列改为 Shrink+右对齐（055 配套），
                    // 该类是 VM 侧抱合的触发器（web 侧冗余无害）。
                    style: "msg-bubble-user self-end px-[14px] py-[10px] rounded-xl rounded-br text-[15px] leading-[1.6] break-words bg-primary/10 text-foreground"
                    // PLAN-093 T-08:附件回放标记（历史定位轻量标示）。
                    if .ctxKind != "" {
                        row {
                            style: "shrink-0 items-center gap-1 px-2 py-0.5 rounded-md bg-muted/50 text-[10.5px] text-muted-foreground"
                            if .ctxLabel != "" {
                                text "📎 " + t("canvas.ctxSelected") + "：" + .ctxKind + " · " + .ctxLabel
                            } else {
                                text "📎 " + t("canvas.ctxSelected") + "：" + .ctxKind
                            }
                        }
                    }
                    UserMessage(content: .userContent)
                }
            } else {
                // toolbar-icons 2026-10-10 r7b：hover 命中区——mouse-area 包
                // 正文+工具栏，enter/exit 上抛 HoverIn(.msg.id)/HoverOut（会话
                // 行 HoverSession 同款双轨已证形态；mouse-area 不捕获未声明
                // 事件，内层思考/工具卡交互不受影响）。
                mouse-area {
                    onmouseenter: .HoverIn(.msg.id)
                    onmouseleave: .HoverOut
                    style: "w-full"
                col {
                    // PLAN-081 r6：gap-3 撤除——VM 渲染器把 for 块包一层列，
                    // gap 只作用于直接子级故 VM 恒不生效；块间距改由每块
                    // wrapper 的 mb-[12px] 承担（margin 在 VM 已证生效，
                    // web 由 gap 改 margin 后双轨等价 12px）。
                    style: "msg-bubble-ai flex flex-col py-[11px] px-[3px]"
                    // PLAN-071 需求⑨：AI 启动窗口等待点——首个 thinking/delta
                    // 到达前气泡内动态 "..."（三点跳动），告知后台正在干活；
                    // 块到达即消失（msgIsWaiting 判定，块循环同窗渲染）。
                    if .showWaiting {
                        // toolbar-icons 2026-10-10 r2：lucide Loader 图标 +
                        // 帧字符。web：animate-spin 旋转图标，.spin-char 由
                        // scoped CSS 隐藏；VM：图标静态展示（iced 无 CSS
                        // 动画），帧字符逐拍换内容（SpinTick 120ms）承担动效。
                        row {
                            class: "msg-waiting flex items-center py-[2px] px-[2px] animate-spin text-muted-foreground"
                            Loader { size: 14 }
                            text .spinText { class: "spin-char text-[13px]" }
                        }
                    }
                    // 有序 block 流：文本 / 思考 / 工具按到达顺序，块不删除。
                    // text 块已在 computed（messageDisplayBlocks）里剥离问卷 JSON 并
                    // 过滤空块——纯问卷消息不出气泡，问卷本体由 QuestionnaireCard 呈现。
                    for block in .blocks {
                        if .block.kind == "text" {
                            col {
                                style: "px-[2px] py-[1px] bg-transparent border-none text-foreground rounded-none mb-[12px]"
                                Markdown(source: .block.text, streaming: isBlockStreaming(.is_streaming, .blocks, .block))
                            }
                        } else if .block.kind == "thinking" {
                            // PLAN-055 ④/T11/T13：思考块内联（ThinkBlock 子件
                            // 退役）——VM 子件上下文三缺陷叠加：ensure_child_state
                            // 全实例共享根态（expanded 末实例覆盖）、子件视图内
                            // if/computed 求值分歧（chevron 读共享值而 if 臂恒真）、
                            // row.onclick 派发不达。本层（ChatMessage）的 if/for/
                            // 按钮冻结实参（Copy 钮同款）均已实证可用；展开态走
                            // store.think_open 键列表（thinkToggleList 重建）。
                            // 类串与 ThinkBlock 时期逐类一致（双轨观感不变）。
                            col {
                                style: "think-block w-full box-border rounded-lg border border-border bg-muted/40 max-w-full overflow-hidden mb-[12px]"
                                // PLAN-073 需求⑧ T-35：流式期半开态——header
                                // (思考中) + 一行滚动最新思考尾（不依赖展开
                                // 操作，全程可见）；收束后收缩为已思考 chip
                                // （chevron 展开全量，双轨观感不变）。
                                // PLAN-073 r5：分支条件由消息级 is_streaming
                                // 改为块级 state——过去轮次的思考块在轮次
                                // 结束即落地为已思考，只有当前块保持思考中。
                                if .block.state == "streaming" {
                                    row {
                                        style: "think-header w-full flex items-center gap-[6px] py-[6px] px-[10px] text-[12.5px] text-muted-foreground select-none border-none bg-transparent text-left"
                                        text "💭"
                                        text "思考中 · " + estimateTokens(.block.text) + " tokens"
                                    }
                                    div {
                                        style: "text-[12px] text-muted-foreground/80 px-[10px] pb-[8px] whitespace-nowrap overflow-hidden text-left"
                                        text streamThinkingTail(.block.text)
                                    }
                                } else {
                                button {
                                    onclick: .ToggleThink(.block.tkey)
                                    style: "think-header w-full flex items-center gap-[6px] py-[6px] px-[10px] text-[12.5px] text-muted-foreground cursor-pointer select-none hover:bg-muted/50 border-none bg-transparent text-left"
                                    text "💭"
                                    text thinkLabel(estimateTokens(.block.text), false)
                                    // PLAN-081 r5：chevron 直挂 if/else text 节点
                                    // （工具卡 chevron 同款已证形态）——原 span 内
                                    // 内联 if/else 子树被 VM 丢弃（2026-09-03 定案
                                    // "span 文本元素内 if/else 会被丢"），实机思考
                                    // 卡右侧无箭头即此。
                                    if .block.expanded {
                                        text "▲" { style: "tool-chevron ml-auto text-[11px] text-muted-foreground shrink-0" }
                                    } else {
                                        text "▼" { style: "tool-chevron ml-auto text-[11px] text-muted-foreground shrink-0" }
                                    }
                                }
                                if .block.expanded {
                                    div {
                                        style: "think-content my-0 py-[9px] px-[12px] text-[13.5px] leading-[1.5] font-mono whitespace-pre-wrap break-words text-muted-foreground max-h-[240px] overflow-y-auto border-t border-border"
                                        text .block.text
                                    }
                                }
                                }
                            }
                        } else {
                            // 2026-09-03:工具卡内联（原 ToolBlock→GenericToolCard
                            // 子件链退役——VM 子件 model 全实例共享根态,点一张全
                            // 展开;孙件 store 直调 + 未导入符号叠加致全块展开
                            // 失效。沿 ThinkBlock 内联先例:分发/卡片段落上提至
                            // 本层,展开态走 toolList 键列表,冻结实参派发）。
                            col {
                                style: "tool-block-slot w-full mb-[12px]"
                                if .block.tc.status == "gate_waiting" {
                                    // PLAN-073 F-B：审批门卡（approve/deny 经
                                    // /api/chats/tool-gate/{id} 决议唤醒运行）。
                                    ToolGateCard {
                    gate_id: .block.tc.gate_id
                    pending_cmd: .block.tc.pending_cmd
                    escape_paths: .block.tc.escape_paths_text
                                    }
                                } else if .block.tc.name == "dispatch" {
                                    ErrandCard {
                                        tc: .block.tc
                                        errands: .errands
                                    }
                                } else if .block.tc.name == "spawn_relay" {
                                    // PLAN-100：run_id 双通道判定——预计算浅字段
                                    // （服务端 tool_run_id 直出）OR extractRunId
                                    // fn 调用（PLAN-749 视图条件位 CALL 通道根修
                                    // 后恢复可用；历史坑①观测以此验证）。双通道
                                    // 互为兜底：任一通道取到 run_id 即渲染运行框。
                                    if .block.tc.run_id != "" || extractRunId(.block.tc) != "" {
                                        RelayRunBox {
                                            runId: if .block.tc.run_id != "" { .block.tc.run_id } else { extractRunId(.block.tc) }
                                        }
                                    } else {
                                        col {
                                            style: "tool-card border border-border rounded-lg w-full"
                                            button {
                                                onclick: .ToolToggleKey(.block.tkey)
                                                style: "tool-header flex items-center gap-2 py-[6px] px-[10px] min-w-0 cursor-pointer bg-transparent border-none justify-start text-left h-auto w-full"
                                                text "🔧" { style: "tool-icon text-[14px] leading-none shrink-0" }
                                                text .block.tc.name { style: "tool-name text-[13.3px] font-medium text-foreground shrink-0" }
                                                text .block.tc.status { style: "ml-auto tool-status text-[11.7px] font-medium shrink-0 ml-auto text-blue-500" }
                                                if .block.expanded {
                                                    text "▲" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                                } else {
                                                    text "▼" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                                }
                                            }
                                        }
                                    }
                                } else if .block.tc.name == "task_plan" {
                                    TaskPlanCard {
                                        tc: .block.tc
                                        taskPlans: .task_plans
                                    }
                                } else if .block.tc.name == "report" {
                                    ReportCard {
                                        report: relayReportView(.block.tc.arguments)
                                    }
                                } else {
                                    col {
                                        style: if .block.tc.status == "gate_waiting" { "tool-card gate_waiting border border-amber-500/60 rounded-lg w-full" } else { if .block.tc.status == "failed" { "tool-card failed border border-border rounded-lg w-full" } else { if .block.tc.status == "running" { "tool-card running border border-border rounded-lg w-full" } else { "tool-card completed border border-border rounded-lg w-full" } } }
                                        // header（click toggle）——冻结实参 .block.tkey
                                        // 上抛 ToolToggleKey（沿 ToggleThink 形态）。
                                        button {
                                            onclick: .ToolToggleKey(.block.tkey)
                                            style: "tool-header flex items-center gap-2 py-[6px] px-[10px] min-w-0 cursor-pointer bg-transparent border-none justify-start text-left h-auto w-full"
                                            text "🔧" { style: "tool-icon text-[14px] leading-none shrink-0" }
                                            // r6：name/summary 弃 min-w-0 truncate（VM 把弹性
                                            // 盒撑宽致文字盒内居中、参数段漂到行中）与
                                            // font-mono（VM 串解析嫌疑、默认字体已等宽；
                                            // web mono 由 scoped .tool-seg 提供）——两者
                                            // shrink-0 紧跟排布，参数色 text-muted-foreground
                                            // （暗于 name 的 foreground）；web 截断由
                                            // scoped .tool-name 兜底。
                                            text .block.tc.name { style: "tool-name text-[13.3px] font-medium text-foreground shrink-0" }
                                            text .block.summary { style: "tool-seg seg-loc text-[12.5px] font-medium text-muted-foreground shrink-0" }
                                            text .block.tc.status { class: if .block.tc.status == "gate_waiting" { "tool-status gate_waiting text-[11.7px] font-medium shrink-0 ml-auto text-amber-500" } else { if .block.tc.status == "completed" { "tool-status completed text-[11.7px] font-medium shrink-0 ml-auto text-green-500" } else { if .block.tc.status == "failed" { "tool-status failed text-[11.7px] font-medium shrink-0 ml-auto text-red-500" } else { "tool-status running text-[11.7px] font-medium shrink-0 ml-auto text-blue-500" } } } }
                                            if .block.expanded {
                                                text "▲" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                            } else {
                                                text "▼" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                            }
                                        }
                                        // body（展开时）——键列表驱动,逐卡独立;
                                        // 段名大写字面量（VM 无 text-transform）。
                                        if .block.expanded {
                                            col {
                                                style: "tool-body border-t border-border px-[10px] py-[8px]"
                                                col {
                                                    style: "tool-section mb-[6px]"
                                                    text "ARGUMENTS" { style: "tool-section-title text-[11.7px] font-medium tracking-wide text-muted-foreground mb-[3px]" }
                                                    div {
                                                        style: "tool-code bg-muted-foreground/5 rounded px-[6px] py-[6px] font-mono text-[13.3px] text-muted-foreground whitespace-pre-wrap break-words"
                                                        text toolArgsJson(.block.tc)
                                                    }
                                                }
                                                if .block.tc.result != "" {
                                                    col {
                                                        style: "tool-section mb-[6px]"
                                                        text "RESULT" { style: "tool-section-title text-[11.7px] font-medium tracking-wide text-muted-foreground mb-[3px]" }
                                                        Markdown(source: .block.tc.result, streaming: false)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // toolbar-icons 2026-10-10 r7b：消息级工具栏——分割线常驻
                // （占位固定,无布局跳动）,按钮按 tbVisible 门控显隐（r4 的
                // "VM 无 hover 常驻降级"由此升格;web scoped CSS hover 退役,
                // 单机制双轨）。缩一号/去边框/图标 14 沿 r4/r7。
                if .tbVisible {
                    col {
                        class: "msg-toolbar self-stretch -mt-[10px] pt-[3px] border-t border-border"
                        row {
                            style: "flex items-center justify-start gap-1 px-[3px]"
                            button {
                                onclick: .CopyContent
                                style: "inline-flex items-center justify-center h-6 w-6 px-0 py-0 rounded-md border-0 bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer [&_svg]:size-[14px]"
                                title: "Copy"
                                Copy { size: 14 }
                            }
                            button {
                                onclick: .ForkFrom(.msg.id)
                                style: "inline-flex items-center justify-center h-6 w-6 px-0 py-0 rounded-md border-0 bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer [&_svg]:size-[14px]"
                                title: "Fork"
                                GitFork { size: 14 }
                            }
                        }
                    }
                }
                }
            }
            // PLAN-055: AI 消息工具栏。copy 靠左（用户反馈 2026-09-03：右侧是
            if .hasError {
                text .errorText { style: "text-destructive text-[14px] py-2 px-3 bg-destructive/10 rounded-lg self-start max-w-full" }
            }
        }
    }
}
