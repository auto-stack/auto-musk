// chat_message.at — ChatMessage 组件（有序 block 渲染模型）
//
// assistant 回复不再「整段文本 + 尾部 thinking + 后置工具卡」，而是按
// 到达顺序渲染 block 流：文本块（气泡）/ ThinkBlock（默认折叠，token 数，
// 展开滚动 + 最大高度）/ ToolBlock（tool-use 卡片）。已显示的块不会删除。
//
// 依赖：
//   - UserMessage / ThinkBlock / ToolBlock（本项目 component fn）
//   - StreamingRenderer（逃生舱，use{component from "..."} 引用）
//   - messageBlocks / isBlockStreaming / isMsgStreaming / estimateTokens /
//     msgTimeLabel fn（forge_helpers.ts；.at 无 Date/数组推导等宿主 API）
//
// 历史/重载消息无 msg.blocks 时，messageBlocks 从持久化字段合成
// （thinking → text → tool_calls），保证渲染模型统一。
//
// PLAN-049 T6 双轨收敛：原 style{} 块（.msg-row/.msg-blocks/.msg-bubble-* 等）
// 全量迁内联工具类；角色相关差异（用户行右对齐/徽章色）改 computed 条件类串
// （原 :has() 结构选择器的等价表达）。v-html 内部 .inline-mention 高亮与
// .streaming-document 深层排版为 web-only（inject_styles.web-only.ts）。
// AI 侧无边框正文（Claude 风格）不变：文本块透明、上下 hairline 由 msg-blocks
// 容器 utilities 承担（VM 侧单侧边框降级登记）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component Markdown from "src/front/ports/renderer.at"
use.web component Copy from "src/front/ports/icons.at"
// PLAN-055 T13: thinkLabel 进内联思考块（ThinkBlock 子件退役）；thinkIsOpen
// 走 store.think_open 键列表（键=msg.id）。
// 2026-09-03:工具卡内联（ToolBlock/GenericToolCard 子件退役,沿 ThinkBlock
// 先例——VM 子件 model 全实例共享 + 孙件 store 直调不可靠,回归根因）。补充
// toolIsOpen/toolArgsJson/extractRunId 与 relay 助手导入。
use.web msgTimeLabel, messageDisplayBlocks, isBlockStreaming, estimateTokens, thinkLabel, thinkIsOpen, toolIsOpen, toolArgsJson, extractRunId from "src/front/forge_helpers.at"
use.web relayReportView from "src/front/relay_run_helpers.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use user_message: UserMessage
use errand_card: ErrandCard
use relay_run_box: RelayRunBox
use task_plan_card: TaskPlanCard
use report_card: ReportCard

// PLAN-055 ④/T11：ThinkBlock 展开态读写走 ForgeStore 根态键列表。
use store: ForgeStore


widget ChatMessage(msg: obj, is_streaming: bool, errands: obj, relays: obj, task_plans: obj, thinkList: obj, toolList: obj) {
    msg Msg { CopyContent, ToggleThink(str), ToolToggleKey(str) }
    on {
        // PLAN-055 ④/T11：ThinkBlock 上抛（payload=构建期冻结的块键）——
        // 直调 store 切换根态展开键列表（跨件 handler 沿 ForgeStore.Init() 先例）。
        .ToggleThink(key) -> {
            ForgeStore.ThinkToggle(key)
        }
        // 2026-09-03:工具卡逐卡展开（键=block.tkey,冻结实参沿 ToggleThink;
        // 写侧 ForgeStore.ToolToggle → tool_open 键列表）。
        .ToolToggleKey(key) -> {
            ForgeStore.ToolToggle(key)
        }
        // PLAN-055: AI 消息工具栏 copy（对齐 web 原版 message-toolbar）。
        .CopyContent -> {
            dom.copy_text(.msg.content)
        }
    }
// 2026-09-03:工具卡内联后 .tool-* scoped 样式随元素迁入本文件（scoped CSS
// 只打本组件模板;取值沿 generic_tool_card.at 原基准,web 精调/hover 兜底,
// VM 侧观感由元素内联工具类承载）。
style {
.tool-card { border: 1px solid hsl(var(--border)); border-radius: 8px; margin: 0; overflow: hidden; width: 100%; background: transparent; }
.tool-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem; cursor: pointer; user-select: none; }
.tool-header:hover { background: hsl(var(--muted-foreground) / 0.04); }
.tool-icon { font-size: 0.93rem; line-height: 1; flex-shrink: 0; }
.tool-name { font-size: 0.83rem; font-weight: 500; color: hsl(var(--foreground)); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tool-seg { font-size: 0.78rem; font-weight: 500; font-family: 'Geist Mono', 'Fira Code', monospace; flex-shrink: 0; }
.tool-seg.seg-path { color: hsl(190 80% 40%); }
.tool-seg.seg-loc { color: hsl(var(--muted-foreground)); }
.tool-seg.seg-pattern { color: hsl(280 60% 45%); }
.tool-seg.seg-desc { color: hsl(var(--foreground)); }
.tool-status { font-size: 0.73rem; font-weight: 500; flex-shrink: 0; }
.tool-status.running { color: hsl(210 90% 52%); }
.tool-status.completed { color: hsl(142 71% 40%); }
.tool-status.failed { color: hsl(var(--destructive)); }
.tool-chevron { font-size: 0.7rem; color: hsl(var(--muted-foreground)); flex-shrink: 0; }
.tool-body { border-top: 1px solid hsl(var(--border)); padding: 0.5rem 0.6rem; }
.tool-section { margin-bottom: 0.4rem; }
.tool-section:last-child { margin-bottom: 0; }
.tool-section-title { font-size: 0.73rem; font-weight: 500; text-transform: uppercase; color: hsl(var(--muted-foreground)); margin-bottom: 0.2rem; letter-spacing: 0.02em; }
.tool-code { font-size: 0.83rem; color: hsl(var(--muted-foreground)); background: hsl(var(--muted-foreground) / 0.04); padding: 0.35rem 0.5rem; border-radius: 4px; overflow-x: auto; white-space: pre-wrap; word-break: break-word; font-family: 'Geist Mono', 'Fira Code', monospace; margin: 0; }
.tool-block-slot { width: 100%; }
}

    computed {
        role => .msg.role
        isUser => .role == "user"
        isAssistant => .role == "assistant"
        rowClass => if .isUser {
            "flex flex-col gap-[3px] max-w-[85%] self-end items-end"
        } else {
            "flex flex-col gap-[5px] self-stretch items-stretch max-w-full"
        }
        headerClass => if .isUser {
            "flex items-center gap-2 px-1 justify-end"
        } else {
            "flex items-center gap-2 px-1"
        }
        badgeClass => if .isUser {
            "text-[13.6px] font-semibold text-primary"
        } else {
            "text-[13.6px] font-semibold text-muted-foreground"
        }
        badge => if .isUser { "🧑 You" } else { "🤖 AI" }
        userContent => .msg.content
        // 展示用 blocks：text 已剥离问卷 JSON（问卷由 QuestionnaireCard 呈现），
        // 纯问卷消息的空 text 块已移除。多参 fn 收敛在 helper（.at if 条件不支持）。
        blocks => messageDisplayBlocks(.msg, .is_streaming)
        time => msgTimeLabel(.msg.created_at)
        hasTime => .time != ""
        // PLAN-055 ④/T13：本消息思考块展开态（键=msg.id，每消息至多一个
        // thinking 块）。键列表经 prop 下传（chats_view 读 store 传 thinkList），
        // fn 调用收敛在 computed——事件实参须纯路径、span 文本元素内 if/else
        // 会被丢，chevron 字符同 computed 化（badge 同款 if/else 形态）。
        thinkOpen => thinkIsOpen(.thinkList, .msg.id)
        chev => if .thinkOpen { "▲" } else { "▼" }
        hasError => .msg.error != ""
        errorText => if .hasError { .msg.error } else { "" }
    }
    view {
        col {
            class: .rowClass
            // header: 角色标识 + 时间（用户行右对齐,徽章随角色着色）
            row {
                style: .headerClass
                text .badge { style: .badgeClass }
                if .hasTime {
                    text .time { style: "text-xs text-muted-foreground" }
                }
            }
            // 内容（按 role 分支）
            if .isUser {
                col {
                    // PLAN-055: self-end——web 父列 items-end 已使气泡抱合右靠；
                    // VM 轨 visual-wrap 容器此前无条件 Fill（全宽紫条形态），
                    // renderer 对 self-end 列改为 Shrink+右对齐（055 配套），
                    // 该类是 VM 侧抱合的触发器（web 侧冗余无害）。
                    style: "msg-bubble-user self-end px-[14px] py-[10px] rounded-xl rounded-br text-[15px] leading-[1.6] break-words bg-primary text-primary-foreground"
                    UserMessage(content: .userContent)
                }
            } else {
                // 内容区容器：上下 hairline 只框 block 区，标题栏留在框线上方。
                // 块间节奏 0.4rem 与 markdown 流内间距对齐（原 style{} 块注记）。
                col {
                    style: "msg-bubble-ai flex flex-col gap-3 py-[11px] px-[3px] border-t border-b border-border/60"
                    // 有序 block 流：文本 / 思考 / 工具按到达顺序，块不删除。
                    // text 块已在 computed（messageDisplayBlocks）里剥离问卷 JSON 并
                    // 过滤空块——纯问卷消息不出气泡，问卷本体由 QuestionnaireCard 呈现。
                    for block in .blocks {
                        if .block.kind == "text" {
                            col {
                                style: "px-[2px] py-[1px] bg-transparent border-none text-foreground rounded-none"
                                Markdown(source: .block.text, streaming: isBlockStreaming(.is_streaming, .blocks, .block))
                            }
                        } else if .block.kind == "thinking" {
                            // PLAN-055 ④/T11/T13：思考块内联（ThinkBlock 子件
                            // 退役）——VM 子件上下文三缺陷叠加：ensure_child_state
                            // 全实例共享根态（expanded 末实例覆盖）、子件视图内
                            // if/computed 求值分歧（chevron 读共享值而 if 臂恒真）、
                            // row.onclick 派发不达。本层（ChatMessage）的 if/for/
                            // 按钮冻结实参（Copy 钮同款）均已实证可用；展开态走
                            // store.think_open 键列表（thinkToggleList 重建）。
                            // 类串与 ThinkBlock 时期逐类一致（双轨观感不变）。
                            col {
                                class: "think-block w-full box-border rounded-lg border border-border bg-muted/40 max-w-full overflow-hidden"
                                button {
                                    onclick: .ToggleThink(.msg.id)
                                    style: "think-header w-full flex items-center gap-[6px] py-[6px] px-[10px] text-[12.5px] text-muted-foreground cursor-pointer select-none hover:bg-muted/50 border-none bg-transparent text-left"
                                    text "💭"
                                    text thinkLabel(estimateTokens(.block.text), .is_streaming)
                                    span {
                                        style: "tool-chevron ml-auto"
                                        text .chev
                                    }
                                }
                                if .thinkOpen {
                                    div {
                                        style: "think-content my-0 py-[9px] px-[12px] text-[13.5px] leading-[1.5] font-mono whitespace-pre-wrap break-words text-muted-foreground max-h-[240px] overflow-y-auto border-t border-border"
                                        text .block.text
                                    }
                                }
                            }
                        } else {
                            // 2026-09-03:工具卡内联（原 ToolBlock→GenericToolCard
                            // 子件链退役——VM 子件 model 全实例共享根态,点一张全
                            // 展开;孙件 store 直调 + 未导入符号叠加致全块展开
                            // 失效。沿 ThinkBlock 内联先例:分发/卡片段落上提至
                            // 本层,展开态走 toolList 键列表,冻结实参派发）。
                            col {
                                style: "tool-block-slot w-full"
                                if .block.tc.name == "dispatch" {
                                    ErrandCard {
                                        tc: .block.tc
                                        errands: .errands
                                    }
                                } else if .block.tc.name == "spawn_relay" {
                                    if extractRunId(.block.tc) != "" {
                                        RelayRunBox {
                                            runId: extractRunId(.block.tc)
                                        }
                                    } else {
                                        col {
                                            class: "tool-card border border-border rounded-lg w-full"
                                            row {
                                                onclick: .ToolToggleKey(.block.tkey)
                                                style: "tool-header flex items-center gap-2 py-[6px] px-[10px] min-w-0 cursor-pointer"
                                                text "🔧" { style: "tool-icon text-[14px] leading-none shrink-0" }
                                                text .block.tc.name { style: "tool-name flex-1 min-w-0 truncate text-[13.3px] font-medium text-foreground" }
                                                text .block.tc.status { style: "tool-status text-[11.7px] font-medium shrink-0 text-blue-500" }
                                                if toolIsOpen(.toolList, .block.tkey) {
                                                    text "▲" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                                } else {
                                                    text "▼" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                                }
                                            }
                                        }
                                    }
                                } else if .block.tc.name == "task_plan" {
                                    TaskPlanCard {
                                        tc: .block.tc
                                        taskPlans: .task_plans
                                    }
                                } else if .block.tc.name == "report" {
                                    ReportCard {
                                        report: relayReportView(.block.tc.arguments)
                                    }
                                } else {
                                    col {
                                        class: if .block.tc.status == "failed" { "tool-card failed border border-border rounded-lg w-full" } else { if .block.tc.status == "running" { "tool-card running border border-border rounded-lg w-full" } else { "tool-card completed border border-border rounded-lg w-full" } }
                                        // header（click toggle）——冻结实参 .block.tkey
                                        // 上抛 ToolToggleKey（沿 ToggleThink 形态）。
                                        row {
                                            onclick: .ToolToggleKey(.block.tkey)
                                            style: "tool-header flex items-center gap-2 py-[6px] px-[10px] min-w-0 cursor-pointer"
                                            text "🔧" { style: "tool-icon text-[14px] leading-none shrink-0" }
                                            text .block.tc.name { style: "tool-name flex-1 min-w-0 truncate text-[13.3px] font-medium text-foreground" }
                                            for seg in .block.summary {
                                                text .seg.text { class: if .seg.type == "path" { "tool-seg seg-path text-[12.5px] font-medium font-mono shrink-0 text-info" } else { if .seg.type == "pattern" { "tool-seg seg-pattern text-[12.5px] font-medium font-mono shrink-0 text-primary" } else { if .seg.type == "desc" { "tool-seg seg-desc text-[12.5px] font-medium font-mono shrink-0 text-foreground" } else { "tool-seg seg-loc text-[12.5px] font-medium font-mono shrink-0 text-muted-foreground" } } } }
                                            }
                                            text .block.tc.status { class: if .block.tc.status == "completed" { "tool-status completed text-[11.7px] font-medium shrink-0 text-green-500" } else { if .block.tc.status == "failed" { "tool-status failed text-[11.7px] font-medium shrink-0 text-red-500" } else { "tool-status running text-[11.7px] font-medium shrink-0 text-blue-500" } } }
                                            if toolIsOpen(.toolList, .block.tkey) {
                                                text "▲" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                            } else {
                                                text "▼" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                            }
                                        }
                                        // body（展开时）——键列表驱动,逐卡独立;
                                        // 段名大写字面量（VM 无 text-transform）。
                                        if toolIsOpen(.toolList, .block.tkey) {
                                            col {
                                                style: "tool-body border-t border-border px-[10px] py-[8px]"
                                                col {
                                                    style: "tool-section mb-[6px]"
                                                    text "ARGUMENTS" { style: "tool-section-title text-[11.7px] font-medium tracking-wide text-muted-foreground mb-[3px]" }
                                                    div {
                                                        style: "tool-code bg-muted-foreground/5 rounded px-[6px] py-[6px] font-mono text-[13.3px] text-muted-foreground whitespace-pre-wrap break-words"
                                                        text toolArgsJson(.block.tc)
                                                    }
                                                }
                                                if .block.tc.result != "" {
                                                    col {
                                                        style: "tool-section mb-[6px]"
                                                        text "RESULT" { style: "tool-section-title text-[11.7px] font-medium tracking-wide text-muted-foreground mb-[3px]" }
                                                        Markdown(source: .block.tc.result, streaming: false)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // PLAN-055: AI 消息工具栏。copy 靠左（用户反馈 2026-09-03：右侧是
            // user 气泡的对齐侧,assistant 工具栏占右观感错位）——对齐 assistant
            // 内容列的左缘。单源新增,gen Vue 轨同步获得。
            if .isAssistant {
                row {
                    style: "flex items-center justify-start gap-1 mt-[2px] px-[3px]"
                    button {
                        onclick: .CopyContent
                        style: "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                        title: "Copy"
                        // size 13→16(用户对拍 2026-09-03:VM 图标观感偏小,统一抬到 16;
                        // web 端 lucide size 同步,两轨一致)。
                        Copy { size: 16 }
                    }
                }
            }
            if .hasError {
                text .errorText { style: "text-destructive text-[14px] py-2 px-3 bg-destructive/10 rounded-lg self-start max-w-full" }
            }
        }
    }
}
