// chat_message.at — ChatMessage 组件（Plan 023 P3 续：逃生舱原生化）
//
// 对标 src/front/components/ChatMessage.vue（逃生舱，Plan 022-B）。
// Plan 022-B 因 view fn 内联展开在 use{component} 引用时不生效而封逃生舱；
// 现 component fn（Plan 408）解决此问题——ChatMessage 作为独立 component fn。
//
// 依赖：
//   - UserMessage（已原生化为 component fn，use{component} 无 from 引用）
//   - StreamingRenderer（仍逃生舱，use{component from "..."} 引用）
//   - msgTimeLabel fn（时间格式化，.at 无 Date API）
//
// 关键转换：
//   - new Date(created_at * 1000).toLocaleTimeString() → msgTimeLabel fn
//   - role 分支（user/assistant）→ if/else + computed
//   - thinking/error 可选字段 → has* computed

component fn ChatMessage(msg: obj, is_streaming: bool) {
    use {
        component: UserMessage
        component: StreamingRenderer from "src/front/components/StreamingRenderer.vue"
        fn: msgTimeLabel from "src/front/forge_helpers.ts"
    }
    computed {
        role => .msg.role
        isUser => .role == "user"
        rowClass => if .isUser { "msg-row msg-row-user" } else { "msg-row msg-row-ai" }
        badge => if .isUser { "🧑 You" } else { "🤖 AI" }
        hasContent => .msg.content != ""
        content => .msg.content
        time => msgTimeLabel(.msg.created_at)
        hasTime => .time != ""
        hasThinking => .msg.thinking != ""
        thinkingText => if .hasThinking { .msg.thinking } else { "" }
        hasError => .msg.error != ""
        errorText => if .hasError { .msg.error } else { "" }
    }
    // PLAN-026 缺陷②: component fn 的 style 块（气泡布局/对齐/宽度）。
    // 由修复后的生成器 emit 到 SFC <style scoped>。
    // msg-error / msg-thinking 在 inject_styles.ts（ext）已定义，此处不重复。
    style {
.msg-row {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  max-width: 85%;
}
.msg-row-user {
  align-self: flex-end;
  align-items: flex-end;
}
.msg-row-ai {
  align-self: flex-start;
  align-items: flex-start;
}
.msg-bubble {
  padding: 0.6rem 0.9rem;
  border-radius: 0.75rem;
  word-wrap: break-word;
  line-height: 1.5;
}
.msg-bubble-user {
  background: hsl(var(--primary) / 0.1);
  border: 1px solid hsl(var(--primary) / 0.2);
}
.msg-bubble-ai {
  background: hsl(var(--muted-foreground) / 0.05);
  border: 1px solid hsl(var(--border));
}
.msg-role-badge {
  font-size: 0.8rem;
  font-weight: 500;
  color: hsl(var(--muted-foreground));
}
.msg-time {
  font-size: 0.75rem;
  color: hsl(var(--muted-foreground));
}
    }
    col {
        class: .rowClass
        // header: 角色标识 + 时间
        row {
            style: "msg-header"
            text .badge { style: "msg-role-badge" }
            if .hasTime {
                text .time { style: "msg-time" }
            }
        }
        // 气泡内容（按 role 分支）
        if .isUser {
            col {
                style: "msg-bubble msg-bubble-user"
                UserMessage(content: .content)
            }
        } else {
            if .hasContent {
                col {
                    style: "msg-bubble msg-bubble-ai"
                    StreamingRenderer(source: .content, streaming: .is_streaming)
                }
            }
        }
        // thinking 推理链（仅 assistant）
        if .hasThinking {
            text .thinkingText { style: "msg-thinking" }
        }
        if .hasError {
            text .errorText { style: "msg-error" }
        }
    }
}
