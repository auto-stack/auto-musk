// chat_message.at — ChatMessage 组件（有序 block 渲染模型）
//
// assistant 回复不再「整段文本 + 尾部 thinking + 后置工具卡」，而是按
// 到达顺序渲染 block 流：文本块（气泡）/ ThinkBlock（默认折叠，token 数，
// 展开滚动 + 最大高度）/ ToolBlock（tool-use 卡片）。已显示的块不会删除。
//
// 依赖：
//   - UserMessage / ThinkBlock / ToolBlock（本项目 component fn）
//   - StreamingRenderer（逃生舱，use{component from "..."} 引用）
//   - messageBlocks / isBlockStreaming / isMsgStreaming / estimateTokens /
//     msgTimeLabel fn（forge_helpers.ts；.at 无 Date/数组推导等宿主 API）
//
// 历史/重载消息无 msg.blocks 时，messageBlocks 从持久化字段合成
// （thinking → text → tool_calls），保证渲染模型统一。

component fn ChatMessage(msg: obj, is_streaming: bool, errands: obj, relays: obj, task_plans: obj) {
    use {
        component: UserMessage, ThinkBlock, ToolBlock
        component: Markdown from "platform:markdown"
        fn: msgTimeLabel, messageDisplayBlocks, isBlockStreaming, estimateTokens from "src/front/forge_helpers.at"
        fn: renderMentions from "src/front/mention_helpers.ts"
    }
    computed {
        role => .msg.role
        isUser => .role == "user"
        rowClass => if .isUser { "msg-row msg-row-user" } else { "msg-row msg-row-ai" }
        badge => if .isUser { "🧑 You" } else { "🤖 AI" }
        userContent => .msg.content
        // 展示用 blocks：text 已剥离问卷 JSON（问卷由 QuestionnaireCard 呈现），
        // 纯问卷消息的空 text 块已移除。多参 fn 收敛在 helper（.at if 条件不支持）。
        blocks => messageDisplayBlocks(.msg, .is_streaming)
        time => msgTimeLabel(.msg.created_at)
        hasTime => .time != ""
        hasError => .msg.error != ""
        errorText => if .hasError { .msg.error } else { "" }
    }
    // PLAN-026 缺陷②: component fn 的 style 块。AI 回复采用"无边框正文 + 内容区
    // 上下边界"布局（Claude 风格）：标题栏（icon/time）在框线上方，hairline 只
    // 框 block 区；文本块透明无气泡（inject_styles 侧改），思考/工具等特殊块以
    // "内嵌"卡片呈现；块间统一 gap；align-items: stretch 让折叠块标题栏等宽。
    // ⚠️ 不要重复定义 .msg-bubble/.msg-bubble-user/.msg-bubble-ai —— inject_styles
    // 已含完整气泡颜色（AI 侧改为透明）。
    style {
.msg-row {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  max-width: 85%;
}
.msg-row-user {
  align-self: flex-end;
  align-items: flex-end;
}
.msg-row-ai {
  align-self: stretch;
  align-items: stretch;
  max-width: 100%;
  gap: 0.3rem;
}
.msg-blocks {
  display: flex;
  flex-direction: column;
  /* 块间节奏：gap 0.4 + 前块尾部 margin 0.35（如 streaming-table）= 0.75rem，
     与 markdown 流内 代码块 0.4 + 表格 0.35 = 0.75rem 对齐，块内外一致。 */
  gap: 0.4rem;
  padding: 0.7rem 0.2rem;
  border-top: 1px solid hsl(var(--border) / 0.6);
  border-bottom: 1px solid hsl(var(--border) / 0.6);
}
.msg-role-badge {
  font-size: 0.85rem; font-weight: 600;
}
.msg-time {
  font-size: 0.72rem; color: hsl(var(--muted-foreground));
}
.msg-bubble-user {
  background: hsl(var(--primary)); color: hsl(var(--primary-foreground));
  border-bottom-right-radius: 4px;
}
.user-text .inline-mention {
  background: hsl(220 90% 56% / 0.12); color: hsl(220 90% 56%);
  border-radius: 3px; padding: 0 0.2rem; font-weight: 500;
}
.msg-bubble-user .user-text { color: hsl(var(--primary-foreground)); white-space: pre-wrap; }
.msg-bubble-user .user-text .inline-mention { color: hsl(var(--primary-foreground)); font-weight: 600; background: hsl(0 0% 100% / 0.15); }
.msg-bubble-ai {
  /* 无边框正文（Claude 风格）：AI 回复文本不设气泡边界/底色/圆角，
     整条回复由 .msg-row-ai 的上下边界框定；思考/工具等特殊块内嵌其中。 */
  background: transparent; border: none; color: hsl(var(--foreground));
  border-radius: 0; padding: 0.05rem 0.15rem;
}
.msg-bubble-ai .streaming-document { color: hsl(var(--foreground)); }
/* ⚠️ 不要在这里写 .streaming-document p/pre/code 等深层的规则——本组件 style
   块是 scoped 的，属性只落在子组件根节点，深层元素永远匹配不到（此前那组
   pre/code 规则整组失效）。代码块样式唯一落点：PrismCodeBlock.vue。 */
.msg-thinking { font-size: 0.82rem; color: hsl(var(--muted-foreground)); font-style: italic; padding: 0.25rem 0.5rem; align-self: flex-start; max-width: 100%; }
.msg-error { color: hsl(var(--destructive)); font-size: 0.88rem; padding: 0.5rem 0.75rem; background: hsl(var(--destructive) / 0.08); border-radius: 8px; align-self: flex-start; max-width: 100%; }
    }
    col {
        class: .rowClass
        // header: 角色标识 + 时间
        row {
            style: "msg-header"
            text .badge { style: "msg-role-badge" }
            if .hasTime {
                text .time { style: "msg-time" }
            }
        }
        // 内容（按 role 分支）
        if .isUser {
            col {
                style: "msg-bubble msg-bubble-user"
                UserMessage(content: .userContent)
            }
        } else {
            // 内容区容器（msg-blocks）：上下 hairline 只框 block 区，标题栏
            // （icon/time）留在框线上方。
            col {
                style: "msg-blocks"
                // 有序 block 流：文本 / 思考 / 工具按到达顺序，块不删除。
                // text 块已在 computed（messageDisplayBlocks）里剥离问卷 JSON 并
                // 过滤空块——纯问卷消息不出气泡，问卷本体由 QuestionnaireCard 呈现。
                for block in .blocks {
                    if .block.kind == "text" {
                        col {
                            style: "msg-bubble msg-bubble-ai"
                            Markdown(source: .block.text, streaming: isBlockStreaming(.is_streaming, .blocks, .block))
                        }
                    } else if .block.kind == "thinking" {
                        ThinkBlock(text: .block.text, tokens: estimateTokens(.block.text), streaming: .is_streaming)
                    } else {
                        ToolBlock(tc: .block.tc, errands: .errands, relays: .relays, task_plans: .task_plans)
                    }
                }
            }
        }
        if .hasError {
            text .errorText { style: "msg-error" }
        }
    }
}
