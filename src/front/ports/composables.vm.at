// ports/composables.vm.at — PLAN-442 Phase B2:composables 域 VM adapter。
//
// 翻译直绑 auto-i18n 纯 .at 实现（src/front/lib/i18n.at,PLAN-038 Phase 1
// 对拍资产）：locale 状态存 Plan 401 会话 KV（键对齐 web 轨的
// localStorage 'musk-language'——442 B 配合的 getItem/setItem 桥同存储后端,
// 双轨读写互通）。useGateRouter 是 vue 路由组合式,VM 轨视图切换走状态机,
// 降级为 no-op 桩（返回空对象,调用面仅判空）。

use.web i18nT from "src/front/lib/i18n.at"
// (装载钩子:i18n.at 经此进编译图;调用面用模块限定名 i18n.i18nT——adapter
//  内部 use.web 别名不进 codegen 绑定面,442 B 探针实测。)

fn settings_locale_get() str {
    let saved = storage.get("musk-language")
    if saved != None {
        if saved != "" {
            return saved
        }
    }
    return "zh"
}

fn settingsInitLocale() str {
    return settings_locale_get()
}

fn settingsChangeLocale(l str) {
    storage.set("musk-language", l)
}

/** useT 的 VM 形态:返回闭包 t(key, params?) —— locale 在调用时读取,
    使 settingsChangeLocale 后的文案即时跟随(对齐 vue-i18n 反应语义)。 */
fn useT() {
    return (key, params) => {
        return i18n.i18nT(settings_locale_get(), key, params)
    }
}

fn useGateRouter() {
    // web-only:vue-router 组合式。VM 轨导航走视图状态机,返回空记录。
    return {}
}
