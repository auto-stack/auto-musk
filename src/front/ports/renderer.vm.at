// ports/renderer.vm.at — PLAN-076: 渲染域 VM adapter (统一转接原生 autodown 引擎)。
//
// 废除旧 PLAN-047 纯文本降级，实现全量 Markdown 富文本/高亮/表格/流式双端对齐。
// 统一提供 Markdown 与 MarkdownRender 两个端口组件，内部均映射至原生 autodown。

widget Markdown(source: str, streaming: bool = false) {
    view {
        autodown {
            content: .source
            streaming: .streaming
        }
    }
}

widget MarkdownRender(content: str, final: bool = true) {
    view {
        autodown {
            content: .content
            streaming: !.final
        }
    }
}
