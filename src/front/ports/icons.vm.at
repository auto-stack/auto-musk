// PLAN-077: native icon adapter for the existing lucide facade.
// Shared names and sizes; icon geometry is owned by AutoUI, not copied UI templates.

widget ArrowDown(size: int = 24) {
    view {
        icon { name: "arrow-down", size: .size }
    }
}

