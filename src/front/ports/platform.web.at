// ports/platform.at — PLAN-037 Phase 5:平台域 web facade。
//
// web 耦合集中点:绑定三个手写 TS 纯调用(inject_styles / setup_auth_fetch /
// relay_command_runner),以 Auto 空间命名(platform*)转发。调用方只经
// use.web 引用本文件(.at 路径),不再直接触碰 .ts 路径——rust 目标接入时
// 只需提供同名实现的 adapter(Phase 6 拆 .web.at)。
//
// 历史留调用点(KNOWN-DEBT)已于 Plan 424(2026-08-23)全部收口:
//   - composables 域(useT/gate_router/vue-i18n)→ ports/composables.web.at;
//   - icons/npm 组件(lucide/markstream/platform:markdown/deck.vue)→
//     ports/icons.web.at + ports/renderer.web.at;
//   - raw_upload(ref 常量与 fn 混居)→ ports/upload.web.at(fn re-export
//     原样转发全部符号)。
// 调用面 use.web 非 .at 目标零命中。

// PLAN-049 T8：inject_styles.ts 退役,余量（全局段+web-only 增强）拆本文件。
use.web injectStyles from "src/front/inject_styles.web-only.ts"
use.web setupAuthFetch from "src/front/setup_auth_fetch.ts"
use.web runRelayCommand from "src/front/composables/relay_command_runner.ts"
// PLAN-061 T16 (D22):新建会话后聚焦 composer(DOM 查询逃生舱)。
use.web focusComposer from "src/front/focus_composer.ts"

fn platformInjectStyles() {
    injectStyles()
}

fn platformSetupAuthFetch() {
    setupAuthFetch()
}

fn platformRunRelayCommand(cmd Value) {
    runRelayCommand(cmd)
}

// PLAN-061 T16 (D22):.chats-input 稳定类定位 composer textarea 并聚焦。
fn platformFocusComposer() {
    focusComposer()
}

// PLAN-045: 视口高度端口——mention 锚点定位用（原裸 window.innerHeight 的
// 端口化收口,web 侧恒等回传）。
fn platformViewportHeight() int {
    return window.innerHeight
}

// PLAN-045-E4/446-E4: web 侧 no-op——fetch 拦截器每请求读 localStorage,
// 无需重注入(避免二次 monkey-patch 的 workspace query 重复追加)。
fn platformRefreshAuth() {
}
