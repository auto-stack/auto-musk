// ports/platform.vm.at — PLAN-442 Phase B1:平台域 VM adapter。
//
// web 侧三绑定（inject_styles.ts / setup_auth_fetch.ts /
// relay_command_runner.ts）均为浏览器概念,VM/iced 目标按验收"显式降级登记"：
//   - platformInjectStyles:CSS 全局样式注入 → no-op（iced 主题自管）;
//   - platformSetupAuthFetch:window.fetch monkey-patch 注 Bearer/workspace →
//     ✅ PLAN-045-E4/446-E4 已实装(auto-lang Http.set_default_header/
//     set_default_query/clear_default_auth natives,3130-3132)——经
//     platformRefreshAuth 注入,token 变更由 auth_store 重调用;
//   - platformRunRelayCommand:跨 RelayStore/ForgeStore 的执行桥（web 侧受
//     单 store per file 限制的接线）→ 降级为会话 KV 留痕 + 控制台 warn,
//     完整 VM 实现待多 store 放开后并入（与 web 侧 D 组登记同源）。
// dom.*/location.reload 已由 auto-lang 442 native 桥承接（2774-2780）,
// 不在本 adapter 面。

fn platformInjectStyles() {
    // web-only:全局 CSS 注入。iced 渲染主题由 renderer 自管,空实现。
}

fn platformSetupAuthFetch() {
    // PLAN-045-E4/446-E4 实装:经 auto-lang Http.set_default_header/query
    // natives 注入(默认头/默认 query 于两 send 汇聚处生效)。web 侧等价物
    // = fetch monkey-patch 每请求读 localStorage——VM 侧默认项为进程级,
    // token 变更后须经 platformRefreshAuth 重注入(auth_store 接线)。
    platformRefreshAuth()
}

// 认证面重注入(login/register/restore 后经 login.at Submit / App Init 调用;
// web adapter 为 no-op)。过期边缘(PLAN-046 T5/T8 刷新):auth_store.Me 内部
// Logout() 无法跨层调端口,VM 默认头滞留至重登录/重启;Me 当前零派发点
// (预留死码),滞留实际暴露面为零。清偿协议:UI 化 logout 派发点必须同步调
// 本 fn(login.at:116 同款);401 兜底待上游暴露 Http status 面(auto-lang
// stdlib,KNOWN-DEBT 046 同步义务,plan-447 冲突批后)。
fn platformRefreshAuth() {
    let token = localStorage.getItem("musk_jwt") ?? ""
    let wid = localStorage.getItem("musk_workspace") ?? ""
    if token != "" {
        Http.set_default_header("Authorization", "Bearer " + token)
    } else {
        Http.clear_default_auth()
    }
    if wid != "" {
        Http.set_default_query("workspace", wid)
    }
}

fn platformRunRelayCommand(cmd Value) {
    // 降级留痕:relay 快捷命令在 VM 轨暂不启动工作流。
    let flow = cmd["flow"] ?? ""
    print("relay command skipped on vm target: " + flow)
}

// PLAN-045 立项 / PLAN-046-T7 真值化:视口高度端口。web 侧 window.innerHeight
// 恒等;VM 侧读会话 KV vm.window_inner_height——iced renderer 于
// startup_window_size() 发布基线、双 __window_resized 漏斗实时刷新
// (auto-lang master plan-046-B 桥)。读不到(旧宿主/极端时序)回落 720。
fn platformViewportHeight() int {
    let raw = localStorage.getItem("vm.window_inner_height")
    if raw != None {
        let h = raw.to_int()
        if h > 0 { return h }
    }
    return 720
}
