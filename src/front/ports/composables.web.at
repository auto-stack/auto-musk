// ports/composables.web.at — Plan 424 T3:composables 域 web facade。
//
// 组合式函数与伴生 fn 经本端口 re-export。自动调用(const t = useT())与
// refs 标注([locale] → .value)是调用方 setup 机制,不随转发移动——
// 调用方改引本端口后机制照旧,re-export 只换 import 来源,反应性完整
// 保留(PLAN-037 待澄清 1 关闭)。
//
// rust 目标接入时提供 composables.rust.at 同名 adapter。

use.web composable useT from "src/front/composables/useT.ts"
use.web composable useGateRouter from "src/front/composables/gate_router.ts"
use.web composable useViewRouter from "src/front/composables/viewstate_router.ts"
use.web composable useI18n from "vue-i18n"
use.web settingsInitLocale, settingsChangeLocale from "src/front/composables/useT.ts"
// PLAN-041 T8:URL 路由端口(viewstate 域 web adapter——history API;
// T7 勘察裁定 routes 块为 hash-router 语义不匹配,详见 viewstate_router.ts 头注)。
use.web vsCurrentView, vsSetView, vsCurrentDetail, vsSetDetailPath from "src/front/composables/viewstate_router.ts"
// PLAN-038 Phase 1: auto-i18n 纯 .at 实现经端口可见（对拍资产；直绑替换属跨平台
// 迁移接线步骤,见计划待澄清 7——现阶段仅入编译图,运行路径仍走 vue-i18n）。
use.web i18nT from "src/front/lib/i18n.at"
