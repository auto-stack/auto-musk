// mention_helpers.at — MentionInput/MentionDropdown 过滤/定位/输入逻辑
// （单一真源，替代 mention_helpers.ts）
//
// Plan 029 T8。原文件的三大不可表达点及等价改写：
//   1) 回调式 regex replace（renderMentions）超出 F4 子集 → 手写 @word
//      扫描器（for-condition while 循环 + sub(i, i+1) 逐字符，\w = [A-Za-z0-9_]）；
//   2) Map（buildMentionNames）→ dict，键加 "k_" 前缀——裸 \w 键（如
//      "constructor"）会命中 Object.prototype 原型链；
//   3) lastIndexOf 无映射 → 手写反向扫描 mention_last_at。
// resolveMention 在 Auto 轨无消费方，不迁。
// window.innerHeight 经 platform 端口 platformViewportHeight（PLAN-045 VM-clean:
// 裸 window 在 VM 目标为未定义符号;web adapter 恒等回传,vm 为常量降级）。

use.web platformViewportHeight from "src/front/ports/platform.at"

/** 默认职业列表（props 未传且 configs 为空时的兜底）。 */
fn mention_default_professions() []Value {
    return [
        { "id": "assistant", "name": "Assistant Agent" },
        { "id": "advisor", "name": "Advisor" },
        { "id": "architect", "name": "Architect" },
        { "id": "planner", "name": "Planner" },
        { "id": "coder", "name": "Coder" },
        { "id": "tester", "name": "Tester" },
        { "id": "reviewer", "name": "Reviewer" },
        { "id": "documenter", "name": "Documenter" },
        { "id": "gofer", "name": "Gofer" },
    ]
}

/** id/name（小写）→ 显示名映射（键加 k_ 前缀防原型链命中）。 */
fn build_mention_names(professions []Value) obj {
    let names map = {}
    for p in (professions ?? []) {
        names["k_" + p.id.to_lower()] = p.name
        names["k_" + p.name.to_lower()] = p.name
    }
    return names
}

/** \w 字符判断（[A-Za-z0-9_]）。 */
fn mention_is_word_char(c str) bool {
    if c >= "0" && c <= "9" {
        return true
    }
    if c >= "a" && c <= "z" {
        return true
    }
    if c >= "A" && c <= "Z" {
        return true
    }
    if c == "_" {
        return true
    }
    return false
}

/** PLAN-071 需求⑭：引用 token 路径字符（\w + - . /）。 */
fn mention_is_path_char(c str) bool {
    if mention_is_word_char(c) {
        return true
    }
    if c == "-" {
        return true
    }
    if c == "." {
        return true
    }
    if c == "/" {
        return true
    }
    return false
}

/** 转义 HTML，然后把 @mention 包成高亮 span（手写扫描，等价 /@(\w+)/g 回调）。
 *  PLAN-071 需求⑭：@plan/<seq> 与 @spec/<relpath> 引用 token 识别为特殊
 *  inline 组件（📋/📄 前缀 + 独立着色，区别于 Agent @词）——路径字符集
 *  [\w./-]，空白终止；后端运行时把 token 解析为真实文件路径注入上下文。
 *  r6（PLAN-073 续）：token 分支升级独立 badge 小组件（胶囊圆角+边框+悬停
 *  加深），并带 title= 真实文件路径（plan 查 paths 映射,spec 用 relpath
 *  本身）；paths 为空（plans 未加载）时无 title,降级为纯 badge。cls 参数
 *  仅作用于 Agent @词;token badge 样式独立（气泡/白底上下文恒可读）。 */
fn render_mentions(text str, names obj, cls str, paths obj) str {
    let escaped = Regex.replace(Regex.replace(Regex.replace(text, "&", "&amp;", "g"), "<", "&lt;", "g"), ">", "&gt;", "g")
    // F-UAT-1（PLAN-080 UAT 2026-09-21）：VM 字符串原语 length=字符数、
    // sub=字节切片（str-parity audit B1 字节语义 + Plan 057 边界钳制），
    // 旧逐字符扫描 sub(i, i+1) 在 CJK 上恒为空串 → out 累计为空 → 气泡
    // 空文本（真机空泡实证：中文空泡、英文正常）。重写为 split("@") 分段
    // + 段内字节游标：mention token 恒 ASCII（\w 与 -/. path 字节），字节
    // =字符；非 ASCII 尾段整段拼接（sub 剩余段 LEN 用字符数请求，必然
    // 覆盖到串尾由钳制收口），绝不逐字符切片。对字符/字节两种语义双世界
    // 正确；web 轨（JS length/sub 均 code-unit）行为不变。
    let parts = escaped.split("@")
    var out = parts[0] ?? ""
    var k = 1
    for k < parts.length {
        let seg = parts[k] ?? ""
        // plan/ 分支（5 字节前缀 + 数字 run）
        var token = ""
        var ticon = ""
        var consumed = 0
        if seg.sub(0, 5) == "plan/" {
            var d = 5
            var dig = ""
            for d < seg.length {
                let c2 = seg.sub(d, d + 1)
                if c2 >= "0" && c2 <= "9" {
                    dig = dig + c2
                    d = d + 1
                } else {
                    break
                }
            }
            if dig != "" {
                token = "@plan/" + dig
                ticon = "📋"
                consumed = d
            }
        }
        if token == "" {
            if seg.sub(0, 5) == "spec/" {
                var d2 = 5
                var rel = ""
                for d2 < seg.length {
                    let c3 = seg.sub(d2, d2 + 1)
                    if mention_is_path_char(c3) {
                        rel = rel + c3
                        d2 = d2 + 1
                    } else {
                        break
                    }
                }
                if rel != "" {
                    token = "@spec/" + rel
                    ticon = "📄"
                    consumed = d2
                }
            }
        }
        if token != "" {
            // r6：hover 路径——spec 的 relpath 即路径；plan 查 paths 映射
            // （key 对齐 build_mention_names 的 k_ 前缀防原型链）。
            var href = ""
            if token.sub(1, 2) == "s" {
                href = token.sub(6)
            } else {
                let hit = paths["k_" + token.sub(1)]
                if hit != None {
                    if hit != "" {
                        href = hit
                    }
                }
            }
            var title_attr = ""
            if href != "" {
                title_attr = " title=\"" + mention_attr_escape(href) + "\""
            }
            out = out + "<span class=\"mention-ref inline-flex items-center gap-[0.2rem] rounded-full border border-white/40 bg-white/15 hover:bg-white/30 px-[0.45rem] py-[0.04rem] font-mono text-[0.82em] font-medium leading-[1.5] cursor-help whitespace-nowrap align-baseline\"" + title_attr + ">" + ticon + " " + token + "</span>"
            out = out + seg.sub(consumed, seg.length)
        } else {
            var word = ""
            var j = 0
            for j < seg.length {
                let c = seg.sub(j, j + 1)
                if mention_is_word_char(c) {
                    word = word + c
                    j = j + 1
                } else {
                    break
                }
            }
            // 正则 \w+ 至少 1 字符才命中；word 为空串时按字面 @ 处理。
            if word != "" {
                let display = names["k_" + word.to_lower()]
                if display != None && display != "" {
                    out = out + "<span class=\"inline-mention " + cls + "\">@" + display + "</span>"
                    out = out + seg.sub(j, seg.length)
                } else {
                    out = out + "@" + seg
                }
            } else {
                out = out + "@" + seg
            }
        }
        k = k + 1
    }
    return out
}

/** HTML 属性值转义（title= 等：& < " 会破坏属性边界；> 属性值内合法仍转义求稳）。 */
fn mention_attr_escape(s str) str {
    return Regex.replace(Regex.replace(Regex.replace(Regex.replace(s, "&", "&amp;", "g"), "<", "&lt;", "g"), ">", "&gt;", "g"), "\"", "&quot;", "g")
}

/** r6：PlansStore.plans（List<PlanFile>）→ 引用 token hover 路径映射
 *  （"k_plan/<id>" → path || filename）。未加载/空表返回空映射
 *  （render_mentions 无 title 降级为纯 badge）。 */
fn build_ref_path_map(plans []Value) obj {
    var out map = {}
    for pl in (plans ?? []) {
        if pl != None {
            let pid = pl.id ?? ""
            if pid != "" {
                let p = pl.path ?? ""
                let fname = pl.filename ?? ""
                if p != "" {
                    out["k_plan/" + pid] = p
                } else {
                    if fname != "" {
                        out["k_plan/" + pid] = fname
                    }
                }
            }
        }
    }
    return out
}

/** renderMentions 的默认职业版本（原 TS 默认参数）。 */
// PLAN-050 B1: 气泡上下文 mention 样式内联（原 web-only 后代选择器规则迁移）。
// r6：签名加 paths（传 None——默认版不接 plans 数据源，token badge 无 title）。
fn render_mentions_default(text str) str {
    return render_mentions(text, build_mention_names(mention_default_professions()), "text-primary-foreground font-semibold bg-white/15 rounded-[3px] px-[0.2rem]", None)
}

/** r6：用户气泡版（带 plans 路径映射）——UserMessage 专用。cls 与
 *  render_mentions_default 同款（Agent @词口径不变）;token badge 的
 *  hover title 查 paths。 */
fn render_mentions_ref(text str, paths obj) str {
    return render_mentions(text, build_mention_names(mention_default_professions()), "text-primary font-semibold bg-primary/10 rounded-[3px] px-[0.2rem]", paths)
}

// PLAN-493: render_input_mentions（输入框 backdrop 专用，末尾加换行）删除——
// composer 高亮改由 textarea `mentions:` 能力声明承载（叠加技法下沉实现层），
// 无消费方；聊天气泡路径 render_mentions_default 不动。

/** 按 filter 过滤 professions（id/name 大小写不敏感 contains）。 */
fn mention_filtered(professions []Value, filter str) []Value {
    let f = (filter ?? "").to_lower()
    var out = []
    for p in (professions ?? []) {
        let pid = (p.id ?? "").to_lower()
        let pname = (p.name ?? "").to_lower()
        if pid.contains(f) || pname.contains(f) {
            out.push(p)
        }
    }
    return out
}

/** PLAN-071 需求⑬：合并三源提及条目——Agent（@id）+ 计划（@plan/<id>）+
 *  规范文件（@spec/<relpath>）。plans 为 plans_list() 响应（{plans:[…]}，
 *  PlanFile 字段 id/seq/filename/feature_name/status）；spec_files 为
 *  specs_tree() 扁平节点（{path,name,…}，仅取 path）。kind 驱动下拉渲染
 *  与插入语义（agent 插 @显示名；plan/spec 插 @token，后端运行时解析）。 */
fn mention_combined_items(professions []Value, plans obj, spec_files []Value) []Value {
    var out = []
    for p in (professions ?? []) {
        out.push({ "kind": "agent", "id": p.id ?? "", "name": p.name ?? "" })
    }
    if plans != None {
        if plans.plans != None {
            for pl in plans.plans {
                let pid = pl.id ?? pl.seq
                out.push({ "kind": "plan", "id": "plan/" + pid, "name": (pl.id ?? "") + " — " + (pl.feature_name ?? "") })
            }
        }
    }
    for f in (spec_files ?? []) {
        if f != None {
            if f.path != None {
                if f.path != "" {
                    out.push({ "kind": "spec", "id": "spec/" + f.path, "name": f.path })
                }
            }
        }
    }
    return out
}

/** 锚点定位（anchorRect 为空返回 {}；window.innerHeight passthrough）。 */
fn mention_position(anchor_rect obj) obj {
    if anchor_rect == None {
        return {}
    }
    let bottom_px = (platformViewportHeight() - anchor_rect.top + 4).to_string() + "px"
    return { "position": "fixed", "left": anchor_rect.left.to_string() + "px", "bottom": bottom_px }
}

/** 当前高亮项 id（filtered[index]?.id，无则空串）。 */
fn mention_current_id(filtered []Value, index int) str {
    let p = filtered[index]
    if p == None {
        return ""
    }
    return p.id ?? ""
}

/** 键盘导航索引 clamp（moveUp/moveDown 共用）。 */
fn mention_clamp_index(index int, len int) int {
    if len <= 0 {
        return 0
    }
    return Math.max(0, Math.min(index, len - 1))
}

/** 鼠标 hover 按 id 定位索引（首个匹配，无则 0）。 */
fn mention_index_of(filtered []Value, id str) int {
    var i = 0
    for p in filtered {
        if p.id == id {
            return i
        }
        i = i + 1
    }
    return 0
}

/** 发送按钮可用性（文本非空白）。 */
fn mention_can_send(text str) bool {
    return mention_trim(text) != ""
}

/** trim。 */
fn mention_trim(text str) str {
    return text.trim()
}

/** 按键名（e?.key || ''）。 */
fn mention_key_action(e obj) str {
    if e == None {
        return ""
    }
    return e.key ?? ""
}

/** professions 列表兜底（props.professions > 动态 configs > 默认列表）。 */
fn mention_professions_list(prop_prof []Value, configs []Value) []Value {
    if prop_prof != None {
        if prop_prof.length > 0 {
            return prop_prof
        }
    }
    var out = []
    for c in (configs ?? []) {
        out.push({ "id": c.profession_id ?? c.id, "name": c.name })
    }
    if out.length > 0 {
        return out
    }
    return mention_default_professions()
}

/** professions 兜底链 → mention 名单 List<str]（id + 显示名）。
 *  PLAN-493: textarea `mentions:` 能力消费——名单须 state-rooted（model var，
 *  handler 上下文刷新），builder/Vue 双轨对同一份名单着色 @词原文。 */
fn build_mention_name_list(prop_prof []Value, configs []Value) []Value {
    let profs = mention_professions_list(prop_prof, configs)
    var out = []
    for p in profs {
        let pid = p.id ?? ""
        let pname = p.name ?? ""
        if pid != "" {
            out.push(pid)
        }
        if pname != "" {
            out.push(pname)
        }
    }
    return out
}

/** s 中最后一个 @ 的下标（无则 -1；替代无映射的 lastIndexOf）。 */
fn mention_last_at(s str) int {
    var i = s.length - 1
    for i >= 0 {
        if s.sub(i, i + 1) == "@" {
            return i
        }
        i = i - 1
    }
    return -1
}

/** @mention 检测（光标前找 @ → 行首/空白后 → @后无空格 → 记录 filter/anchor/visible/pos）。

    入参双形态兼容：PLAN-051 P3-② 单参 oninput 双轨契约下,vue codegen 把
    oninput 实参自动包成纯文本串（.value）,事件对象不可达——串入参时
    e.target 为 undefined,此前直接读 el.value 在此抛 TypeError 并中断
    Input 链（mention 下拉/锚点/composer 自适应增高静默失效）。串入参时
    元素回退 activeElement（input 事件时 textarea 必持焦点）,串本身即
    val;事件对象入参（既有调用形态）走原路不受影响。 */
fn mention_detect(e obj) obj {
    // PLAN-066 T-12: var 化——el 在 None 臂重赋值（web let 语义），VM 轨
    // let 不可变纪律拒绝重赋值（重赋值编译错曾毒化本导出）。
    var el = e.target
    var val = ""
    if el == None {
        el = document.activeElement
        val = e ?? ""
    } else {
        val = el.value ?? ""
    }
    let pos = el.selectionStart ?? val.length
    let before = val.sub(0, pos)
    let at_idx = mention_last_at(before)
    if at_idx >= 0 {
        var char_before = ""
        if at_idx > 0 {
            char_before = val.sub(at_idx - 1, at_idx)
        }
        if char_before == "" || Regex.test(char_before, "\\s") {
            let after_at = before.sub(at_idx + 1)
            if after_at.contains(" ") {
                return { "filter": "", "anchor": None, "visible": false, "pos": pos }
            }
            return { "filter": after_at, "anchor": el.getBoundingClientRect(), "visible": true, "pos": pos }
        }
    }
    return { "filter": "", "anchor": None, "visible": false, "pos": pos }
}

fn mention_detect_filter(e obj) str {
    return mention_detect(e).filter
}

fn mention_detect_anchor(e obj) obj {
    return mention_detect(e).anchor
}

fn mention_detect_visible(e obj) bool {
    return mention_detect(e).visible
}

fn mention_detect_pos(e obj) int {
    return mention_detect(e).pos
}

/** 插入 mention 文本（@ 位置前插 @token + 保留光标后文本）。
 *  PLAN-071 需求⑬：items 为合并三源列表——kind=agent 插 @显示名（既有
 *  语义，渲染高亮消费）；kind=plan/spec 插 @<id>（id 即 "plan/001"/
 *  "spec/<relpath>" token，后端运行时解析注入）。 */
fn mention_insert(items []Value, id str, val str, pos int) str {
    var token = id
    for it in items {
        if it.id == id {
            if it.kind == "agent" {
                token = it.name
            } else {
                token = id
            }
            break
        }
    }
    let before = val.sub(0, pos)
    let at_idx = mention_last_at(before)
    if at_idx >= 0 {
        let part1 = val.sub(0, at_idx)
        let part2 = val.sub(pos)
        return part1 + "@" + token + " " + part2
    }
    return "@" + token + " " + val
}

/** r10：Backspace 引用 token 原子删除定位——光标 pos 处按删除键时，若
 *  pos 紧邻某引用 token（kind!=agent）末尾、或处于其内部，返回该 token
 *  的 '@' 起始下标（应整块删除）；否则 -1（默认逐字符删除）。
 *  判定链：从 pos-1 反向扫描路径字符到 '@'（遇其他字符即非 token 场景）；
 *  '@' 前须为空白/文本起点；"@…pos" 段须为某 token 全文的非空前缀（支持
 *  光标在 token 中间整删）。Agent @词不原子删（保持逐字符编辑）。 */
fn mention_backspace_target(text str, pos int, items []Value) int {
    if pos <= 0 {
        return -1
    }
    var i = pos - 1
    var at_idx = -1
    for i >= 0 {
        let c = text.sub(i, i + 1)
        if c == "@" {
            at_idx = i
            break
        }
        if !mention_is_path_char(c) {
            return -1
        }
        i = i - 1
    }
    if at_idx < 0 {
        return -1
    }
    // '@' 前不得是路径字符（"x@plan" 形态 @ 属于词内，非独立 token；
    // 中文/空格/行首等非路径字符均认可——与渲染端不查前置的口径对齐）。
    if at_idx > 0 {
        let prev = text.sub(at_idx - 1, at_idx)
        if mention_is_path_char(prev) {
            return -1
        }
    }
    let seg = text.sub(at_idx, pos)
    if seg.length < 2 {
        return -1
    }
    for it in (items ?? []) {
        if it != None {
            if it.kind != "agent" {
                let full = "@" + (it.id ?? "")
                if full.length >= seg.length {
                    if full.sub(0, seg.length) == seg {
                        return at_idx
                    }
                }
            }
        }
    }
    return -1
}
