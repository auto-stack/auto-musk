// forge_helpers.at — Forge 卡片渲染纯函数（单一真源，替代 forge_helpers.ts）
//
// Plan 028 T9/T10（M1）：逃生舱纯函数迁回 .at。依赖 F1（字典字面量 + 索引
// + ?? 兜底）、F3（JSON/Date.format/Math/char_code_at/split）、F4（Regex）。
// 行为与 forge_helpers.ts 逐函数对齐（demo 会话 fixture 对拍验证）。
//
// 未迁移（mention 域，回调式 replace 超出 F4 子集，归后续 G-对话壳/输入组）：
//   mention 域已由 mention_helpers.at 承载（Plan 029 T8）。原遗留：
//   （DEFAULT_PROFESSIONS/renderMentions 等曾在 mention_helpers.ts。）

// ─── Task plan helpers ───────────────────────────────────────────────────────

/** task_plan status 中文 label（F1 字典 + 缺键 ?? 兜底）。 */
fn taskPlanStatusLabel(status str) str {
    let labels map = { "started": "启动中", "running": "运行中", "completed": "已完成", "failed": "失败", "idle": "就绪" }
    return labels[status] ?? status
}

fn getTaskPlan(taskPlans obj, tc obj) obj {
    let args = tc.arguments ?? {}
    let instanceId = args.instance_id ?? ""
    if instanceId == "" { return None }
    return taskPlans[instanceId] ?? None
}

// ─── Errand helpers ──────────────────────────────────────────────────────────

/** 按 tool_call_id 在 errands record 里查 errand 状态。 */
fn getErrandByToolCallId(errands obj, toolCallId str) obj {
    // PLAN-046 T6 回撤:Object.values().find 自然形态(auto-lang 454-E5 解锁)
    let es = Object.values(errands)
    return es.find(e => e.tool_call_id == toolCallId)
}

fn getErrandTask(tc obj) str {
    let a = tc.arguments ?? {}
    return a.task || "Research task"
}

fn getErrandState(errands obj, tc obj) obj {
    return getErrandByToolCallId(errands, tc.id)
}

fn getErrandContent(errands obj, tc obj) str {
    let e = getErrandState(errands, tc)
    if e == None { return "" }
    return e.content ?? ""
}

fn getErrandToolCalls(errands obj, tc obj) obj {
    let e = getErrandState(errands, tc)
    if e == None { return [] }
    return e.tool_calls ?? []
}

// ─── Relay helpers ───────────────────────────────────────────────────────────

/** 从 tool_call 的 arguments.run_id 或 result JSON 里提取 run_id。 */
fn extractRunId(tc obj) str {
    try {
        let a = tc.arguments ?? {}
        if a.run_id != None { return a.run_id }
        if tc.result != None {
            if tc.result != "" {
                let result = JSON.parse(tc.result)
                if result.run_id != None { return result.run_id }
            }
        }
        return ""
    } catch {
        return ""
    }
}

fn getRelayStatus(relays obj, tc obj) obj {
    let runId = extractRunId(tc)
    if runId == "" { return None }
    return relays[runId] ?? None
}

// ─── Generic tool card helpers ───────────────────────────────────────────────

/** 工具参数 JSON 格式化（F3 JSON.stringify 直通）。 */
fn toolArgsJson(tc obj) str {
    let s = JSON.stringify(tc.arguments, null, 2)
    if s != None { return s }
    // PLAN-055 T0：VM 对 JSON.stringify 是静默 no-op 桩（等价性缺陷族③，恒
    // None）——降级为参数键名占位（Object.keys 在 VM 可用），避免工具卡参数区
    // 整块空白；PLAN-057 上游 natives 落地后回归完整 JSON 展示。
    if tc.arguments == None { return "" }
    let ks = Object.keys(tc.arguments)
    if ks.length == 0 { return "{}" }
    return "[args] " + ks.join(", ")
}

/** PLAN-042:details.truncation 的截断徽标文本。 */
fn toolTruncBadge(details obj) str {
    let trunc = details.truncation
    let by = trunc.truncated_by ?? "bytes"
    return "Showing " + trunc.output_lines + " of " + trunc.total_lines + " lines (by " + by + ")"
}

/** 消息时间格式化（F3 Date.format → toLocaleTimeString）。
 * PLAN-055 ⑦：乐观/流式消息此前写 `timestamp`（毫秒）而后端契约字段是
 * `created_at`（秒）——读侧得 undefined → NaN → "Invalid Date"。此处双保险：
 * None/0 → ""，量级自适应（毫秒判定 >1000 亿档，除法式避开超 i32 字面量
 * ——.at 字面量解析 i32，1e12 会被丢弃；口径对齐 web/ formatTime）。 */
fn msgTimeLabel(createdAt int) str {
    if createdAt == None { return "" }
    if createdAt == 0 { return "" }
    var ms = createdAt * 1000
    if createdAt / 1000000000 > 1000 { ms = createdAt }
    return Date.format(ms, "HH:mm:ss")
}

/** AgentAvatar 渲染数据（F1 字典（对象值）+ F3 char_code_at hash）。 */
fn agentAvatarData(professionId str, name str, size str) obj {
    let professionColors map = {
        "assistant": { "h": 25, "s": 80, "l": 48 },
        "advisor": { "h": 270, "s": 60, "l": 52 },
        "architect": { "h": 205, "s": 70, "l": 50 },
        "planner": { "h": 145, "s": 65, "l": 38 },
        "coder": { "h": 340, "s": 75, "l": 52 },
        "tester": { "h": 45, "s": 90, "l": 42 },
        "reviewer": { "h": 170, "s": 65, "l": 38 },
        "documenter": { "h": 220, "s": 65, "l": 52 },
        "gofer": { "h": 160, "s": 65, "l": 42 }
    }
    var c = professionColors[professionId]
    if c == None {
        var hash = 0
        for ch in professionId {
            // (hash << 5) - hash == hash*31（Math.imul 保持 32 位回绕语义）
            hash = ch.char_code_at(0) + Math.imul(hash, 31)
        }
        c = { "h": Math.abs(hash) % 360, "s": 60, "l": 48 }
    }
    let bg = "hsl(" + c.h + " " + c.s + "% " + c.l + "%)"
    var text = ""
    if c.l > 55 {
        text = "hsl(220 15% 12%)"
    } else {
        text = "#fff"
    }
    var source = name.trim()
    if source == "" { source = professionId }
    let initials = source.char_at(0).to_upper()
    var title = ""
    if name != "" {
        title = name + " (" + professionId + ")"
    } else {
        title = professionId
    }
    var sizeClass = size
    if sizeClass == "" { sizeClass = "md" }
    return { bg: bg, text: text, initials: initials, title: title, sizeClass: sizeClass }
}

/** 提取工具调用的摘要段（path/pattern/desc），用于通用卡片 header 显示。 */
fn getToolSummary(tc obj) obj {
    let segs list = []
    let args = tc.arguments ?? {}

    let path = args.path ?? ""
    let slug = args.slug ?? ""
    let sectionId = args.section_id ?? ""
    let pattern = args.pattern ?? ""
    let query = args.query ?? ""
    let task = args.task ?? ""
    var command = args.command ?? ""
    if command == "" { command = args.cmd ?? "" }
    let limit = args.limit
    let offset = args.offset

    if path != "" {
        segs.push({ type: "path", text: path })
        if limit != None || offset != None {
            segs.push({ type: "loc", text: ":" + (limit ?? "") + ":" + (offset ?? "") })
        }
    }
    if slug != "" { segs.push({ type: "path", text: slug }) }
    if sectionId != "" { segs.push({ type: "path", text: sectionId }) }
    if pattern != "" {
        var s = pattern
        if pattern.length > 60 { s = pattern.substring(0, 57) + "…" }
        segs.push({ type: "pattern", text: "\"" + s + "\"" })
    }
    if query != "" {
        var s2 = query
        if query.length > 60 { s2 = query.substring(0, 57) + "…" }
        segs.push({ type: "pattern", text: "\"" + s2 + "\"" })
    }
    if task != "" && segs.length == 0 {
        var s3 = task
        if task.length > 60 { s3 = task.substring(0, 57) + "…" }
        segs.push({ type: "desc", text: s3 })
    }
    if command != "" && segs.length == 0 {
        var s4 = command
        if command.length > 80 { s4 = command.substring(0, 77) + "…" }
        segs.push({ type: "desc", text: s4 })
    }
    return segs
}

// ─── Message blocks（有序 block 渲染模型，T10） ──────────────────────────────

/** 从展示文本中剥离问卷 JSON 代码块（含流式未闭合块隐藏）。
 * 历史上在 questionnaire.ts，唯一消费方 messageDisplayBlocks 在本文件。 */
fn stripQuestionnaire(text str, streaming bool) str {
    if text == "" { return text }
    var out = Regex.replace(text, "```json\\s*\\n\\{[\\s\\S]*?\"type\"\\s*:\\s*\"questionnaire\"[\\s\\S]*?\\}\\s*\\n\\s*```", "", "g")
    if streaming {
        let tail = out.lastIndexOf("```json")
        if tail != -1 {
            if out.indexOf("```", tail + 3) == -1 {
                let head = out.substring(0, tail)
                // 只有当未闭合块看起来是问卷开头时才隐藏（行尾容差）
                if head.length == 0 || Regex.test(head, "\\n\\s*$") {
                    let partial = out.substring(tail)
                    if Regex.test(partial, "questionnaire|\"questions\"") || partial.length <= 40 {
                        out = head
                    }
                }
            }
        }
    }
    return out.trimEnd()
}

/**
 * 取消息的有序 blocks。流式中的消息由流消费方维护 msg.blocks（保序）；
 * 重载的历史消息无 blocks，则从持久化字段合成（thinking → text → tools）。
 * 持久化 tool 状态规范化为 completed/failed/running。
 */
fn messageBlocks(msg obj) obj {
    if Array.isArray(msg.blocks) { return msg.blocks }
    var out list = []
    if msg.thinking != None { out.push({ kind: "thinking", text: msg.thinking }) }
    if msg.content != None {
        if msg.content != "" { out.push({ kind: "text", text: msg.content }) }
    }
    let toolCalls = msg.tool_calls ?? []
    for raw in toolCalls {
        var status = "completed"
        if raw.status == "error" || raw.status == "failed" {
            status = "failed"
        } else {
            if raw.status == "running" { status = "running" }
        }
        // PLAN-055 T0：VM 等价性缺陷族①规避——对象新键赋值(raw.status = …)在 VM
        // 抛 RuntimeError 炸掉 computed blocks，改字面量重建（探针 c7_nested_push
        // 验证形态）；PLAN-057 根修 SET_FIELD 后可回归原位修改。
        out.push({
            kind: "tool",
            tc: {
                name: raw.name,
                id: raw.id,
                arguments: raw.arguments,
                result: raw.result,
                details: raw.details,
                status: status
            }
        })
    }
    return out
}

/**
 * 取消息的有序 blocks（展示用）：text 块经 stripQuestionnaire 剥离问卷
 * JSON，剥离后为空的 text 块（纯问卷消息）直接移除。
 */
fn messageDisplayBlocks(msg obj, streaming bool) obj {
    var out list = []
    let tools list = []
    // PLAN-051 T8: 迭代源先 let 绑定再 for——直接以调用结果作 for-in 源在
    // VM 触发栈失衡(返回值错位,上游债登记),绑定局部变量即绕开。
    let src_blocks = messageBlocks(msg)
    for b in src_blocks {
        if b.kind == "text" {
            let stripped = stripQuestionnaire(b.text ?? "", streaming)
            if stripped != "" { out.push({ kind: "text", text: stripped }) }
        } else if b.kind == "thinking" {
            out.push(b)
        } else {
            tools.push(b)
        }
    }
    // 展示顺序统一：文字/思考在前、工具块在后——与持久化重载的渲染口径
    // 一致。修复：实时流里工具先到（spawn_relay）、说明文字后流完时，Run
    // 窗口与说明顺序颠倒（刷新后又反过来）。分区对实时/重载同时生效。
    for t in tools {
        out.push(t)
    }
    return out
}

/**
 * 粗略 token 估算（显示用）：CJK 字符 ≈ 0.9 token/字，其余 ≈ 4 字符/token。
 *
 * PLAN-055 双轨等价重写（P055 探针链实锤）：
 *   - 旧形态 `c.char_code_at(0)` 作用在 for-in 循环字符上——VM 轨码点接收者
 *     方法分派落 Nil，cjk 恒 0；
 *   - 旧形态 `Math.round(cjk * 0.9 + …)`——VM 轨 int×float 产出未打标签的
 *     位型垃圾、Math.round 归 0，恒得 max(1,0)=1（"1 tokens" 现场根因）。
 *   现改索引式 char_code_at（TS charCodeAt / VM str 臂同值）+ for-in 计数
 *   （TS for-of 码点数 / VM ARRAY_LEN 字符数同值）+ 整数定点四舍五入
 *   （×10000 定点，TS 侧 `/` 注入 Math.trunc 与 VM int 除同语义）。
 */
fn estimateTokens(text str) int {
    if text == None { return 0 }
    if text == "" { return 0 }
    var total = 0
    for c in text {
        total = total + 1
    }
    var cjk = 0
    for i in 0..total {
        let code = text.char_code_at(i)
        if (code >= 19968 && code <= 40959) || (code >= 12352 && code <= 12543) || (code >= 44032 && code <= 55215) {
            cjk = cjk + 1
        }
    }
    let nonCjk = total - cjk
    // 0.9 / 0.25 的 ×10000 定点；+5000 实现四舍五入（旧 Math.round 语义）。
    let scaled = cjk * 9000 + nonCjk * 2500
    return Math.max(1, (scaled + 5000) / 10000)
}

/** ThinkBlock 头部 label。 */
fn thinkLabel(tokens int, streaming bool) str {
    if streaming {
        return "思考中 · " + tokens + " tokens"
    } else {
        return "已思考 · " + tokens + " tokens"
    }
}

/** 只有流式中的最后一个文本块显示打字光标（is_streaming × 是末块 × 文本块）。 */
fn isBlockStreaming(isStreaming bool, blocks obj, block obj) bool {
    if isStreaming == false { return false }
    let last = blocks[blocks.length - 1]
    return last == block && block.kind == "text"
}

/** 该消息是否正处于流式接收中（最后一条 assistant 消息 × streaming）。 */
fn isMsgStreaming(streaming bool, messages obj, msg obj) bool {
    if streaming == false { return false }
    if messages == None { return false }
    if messages.length == 0 { return false }
    let last = messages[messages.length - 1]
    return last.id == msg.id && last.role == "assistant"
}

// ─── ReportCard helper ───────────────────────────────────────────────────────

/** ReportCard confidence class。 */
fn reportConfidenceClass(confidence str) str {
    let v = confidence || "Medium"
    var c = v.to_lower()
    return "report-confidence " + c
}

/** 秒 → 可读时长（"42s" / "3m 07s"）——RunReport hero/指标格用。 */
fn reportDurationLabel(s int) str {
    if s < 60 { return s + "s" }
    let m int = Math.floor(s / 60)
    let r int = s % 60
    if r < 10 { return m + "m 0" + r + "s" }
    return m + "m " + r + "s"
}

// ─── Chat 搜索过滤（Plan 028 T15，原 useChatSearch composable）──────────────

/** 按关键字过滤消息（content/role 大小写不敏感包含；空查询原样返回）。 */
fn chatSearchFilter(messages obj, q str) obj {
    if q == None { return messages }
    if q.trim() == "" { return messages }
    let query = q.to_lower()
    var out list = []
    for m in messages {
        let content = (m.content ?? "").to_lower()
        let role = (m.role ?? "").to_lower()
        if content.includes(query) || role.includes(query) { out.push(m) }
    }
    return out
}

/** PLAN-043: 活跃路径投影（对齐后端 chats.rs active_path）：
 * leaf→root 链 + 线性前缀；无 parent 链的旧数据退化为全量。 */
fn chatActivePath(messages obj, leaf str) obj {
    if leaf == None || leaf == "" { return messages }
    if messages == None { return messages }
    let n = messages.length
    var leafIdx = -1
    var i = 0
    while i < n {
        if messages[i].id == leaf { leafIdx = i }
        i = i + 1
    }
    if leafIdx == -1 { return messages }
    // leaf → root 回溯（父索引必须在前——无前向引用/环）。
    let chain list = []
    var cur = leafIdx
    var guard = 0
    while guard < n + 1 {
        let pid = messages[cur].parent_id
        if pid == None || pid == "" { break }
        var pi = -1
        var j = 0
        while j < n {
            if messages[j].id == pid { pi = j }
            j = j + 1
        }
        if pi == -1 || pi >= cur { break }
        chain.push(pi)
        cur = pi
        guard = guard + 1
    }
    if chain.length == 0 {
        // obj 接收者无 VM slice native——循环重建前缀（语义 = slice(0, leafIdx+1)）
        var head list = []
        var hi = 0
        while hi <= leafIdx {
            head.push(messages[hi])
            hi = hi + 1
        }
        return head
    }
    let anchor = chain[chain.length - 1]
    var out list = []
    var k = 0
    while k <= anchor {
        out.push(messages[k])
        k = k + 1
    }
    var c = chain.length - 2
    while c >= 0 {
        out.push(messages[chain[c]])
        c = c - 1
    }
    return out
}

/** PLAN-043: 同一分叉点的兄弟分支（切换器用）。 */
/** 分支切换器按钮文案:内容前 18 字符(空内容回退空串)。
    (view 内 `(x ?? "").slice(0,18)` 括号化 ?? 链破坏 UI parser——043 引入时
    被旧 gen 掩盖,442-B 后新 CLI 升为致命;提升到 fn 内规避,同 a2ts 优先级
    存量债务的中间变量惯例。) */
fn chatBranchLabel(content obj) str {
    // obj → str 边界定型：.slice 在 obj 接收者上无 VM native（str.slice 才有）
    var c str = content ?? ""
    return c.slice(0, 18)
}

/** 分叉切换器扁平条目:每条 {for_id, sib}（for_id = 拥有兄弟的消息 id,
    sib = 该分叉点的一个兄弟）。视图 for-in 迭代器限制的预算侧配套。 */
fn chatBranchEntries(messages obj) list {
    var out list = []
    if messages == None { return out }
    for m in messages {
        let sibs = chatSiblings(messages, m)
        if sibs.length > 1 {
            for sib in sibs {
                let e obj = { for_id: m.id, sib: sib }
                out.push(e)
            }
        }
    }
    return out
}

fn chatSiblings(messages obj, msg obj) obj {
    var out list = []
    if messages == None { return out }
    let pid = msg.parent_id
    if pid == None || pid == "" { return out }
    var hasTree = false
    for m in messages {
        if m.parent_id != None && m.parent_id != "" { hasTree = true }
    }
    if !hasTree { return out }
    for m in messages {
        if m.parent_id == pid {
            if m.id != msg.id { out.push(m) }
        }
    }
    return out
}

/** 过滤后最后一条消息 id（问卷卡只随最新一条消息显示）。 */
fn chatLastMessageId(messages obj) str {
    if messages == None { return "" }
    if messages.length == 0 { return "" }
    let last = messages[messages.length - 1]
    return last.id ?? ""
}
