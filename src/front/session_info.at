// session_info.at — SessionInfo 组件（Plan 023 队列 B 续：store + 宿主全局 逃生舱原生化）
//
// 对标 src/front/components/SessionInfo.vue（逃生舱，已删除）。
//
// 关键转换：
//   - store 访问（session_id/messages/errands）→ use store: ForgeStore
//   - errands 遍历求和 + clipboard + setTimeout 回调闭包 → session_info_helpers.ts fn
//     （copy 完成态用共享 ref sessionCopied，computed 读取）
//   - document 点击外部关闭 + wrapperRef template ref → 舍弃（同 SettingsMenu，
//     info 按钮再次点击关闭，登记轻微差异）
//   - @click.stop 舍弃（无外部关闭逻辑，无冒泡需求）
//
// 样式：PLAN-049 T6 双轨收敛——session-info-* 迁内联工具类（wiki-* 寄居规则待 T7）。

use store: ForgeStore

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component Info, Copy, CopyCheck from "src/front/ports/icons.at"
use.web session_token_cost, session_message_count from "src/front/session_data_helpers.at"
use.web useI18n from "src/front/ports/composables.at"

widget SessionInfo() {

    setup {
        let i18n = useI18n()
        refs i18n: [locale]
    }
    computed {
        sessionIdText => if .sessionId != "" { .sessionId } else { "—" }
        sessionId => .store.session_id
        messageCount => session_message_count(.store.messages)
        tokenCost => session_token_cost(.store.errands)
        copied => .copy_done
    }
    msg Msg { Toggle, CopyId }
    // Plan 029 T21：copy 完成态本地化（dom.copy_text）。原版 2s 自动复位经
    // setTimeout 闭包——.at 不表达，保持 ✓ 直至下次复制（轻微差异，登记）。
    model {
        var open bool = false
        var copy_done bool = false
    }
    on {
        .Toggle -> { .open = !.open }
        .CopyId -> {
            dom.copy_text(.sessionId);
            .copy_done = true
        }
    }
    // PLAN-049 T6：session-info-* 已迁内联工具类（单一样式源）；tooltip 阴影
    // 为 web-only 增强（box-shadow 白名单）,z-100 收敛为 z-50（视觉等价,登记）。
    // wiki-* 规则系 Plan 029 下放时寄居本块,归 T7 wiki 域切片迁移。
    style {
  .wiki-nav-item {
    display: block; width: 100%; text-align: left;
    padding: 0.4rem 0.75rem; border: none; border-radius: 6px; font-size: 0.85rem;
    background: transparent; color: hsl(var(--foreground)); cursor: pointer;
  }
  .wiki-nav-item:hover { background: hsl(var(--accent)); }
  .wiki-nav-item.active { background: hsl(var(--accent)); font-weight: 500; }
  .wiki-main { flex: 1; overflow-y: auto; display: flex; flex-direction: column; }
  .wiki-content-actions { display: flex; gap: 0.25rem; }
  .wiki-content { padding: 0 1.25rem 1.25rem; font-size: 0.9rem; line-height: 1.6; color: hsl(var(--foreground)); }
  .wiki-raw { padding: 0 1.25rem 1.25rem; }
  .wiki-markdown { font-size: 0.9rem; line-height: 1.6; }
  .wiki-editor { margin: 1.25rem; padding: 1rem; border: 1px solid hsl(var(--border)); border-radius: 8px; background: hsl(var(--card)); }
  .wiki-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: hsl(var(--muted-foreground)); gap: 0.5rem; text-align: center; }
  .text-muted { color: hsl(var(--muted-foreground)); }
    }

    view {
        div {
            style: "relative"
            button {
                onclick: .Toggle
                style: "flex items-center justify-center w-7 h-7 border-none rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                title: i18n.t("chat.sessionInfo")
                Info { size: 15 }
            }
            if .open {
                div {
                    style: "absolute top-[calc(100%+0.5rem)] right-0 min-w-[280px] bg-background border border-border rounded-lg p-3 shadow-[0_4px_12px_rgba(0,0,0,0.15)] z-50 flex flex-col gap-2"
                    div {
                        style: "flex items-center gap-2"
                        span { style: "text-xs text-muted-foreground min-w-[5rem]", text i18n.t("chat.chatId") }
                        code {
                            style: "text-xs text-foreground flex-1 font-mono truncate"
                            text .sessionIdText
                        }
                        button {
                            onclick: .CopyId
                            style: "flex items-center justify-center w-6 h-6 border-none rounded bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground shrink-0 cursor-pointer"
                            title: i18n.t("chat.copyChatId")
                            if .copied {
                                CopyCheck { size: 12 }
                            } else {
                                Copy { size: 12 }
                            }
                        }
                    }
                    div {
                        style: "flex items-center gap-2"
                        span { style: "text-xs text-muted-foreground min-w-[5rem]", text i18n.t("chat.messages") }
                        span { style: "text-[13px] text-foreground flex-1", text .messageCount }
                    }
                    div {
                        style: "flex items-center gap-2"
                        span { style: "text-xs text-muted-foreground min-w-[5rem]", text i18n.t("chat.tokenCost") }
                        span { style: "text-[13px] text-foreground flex-1", text .tokenCost }
                    }
                }
            }
        }
    }
}
