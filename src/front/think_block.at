// think_block.at — ThinkBlock 组件（有序 block 渲染模型）
//
// 思考内容折叠块：默认收起，只显示 💭 + token 数；点击展开后显示思考全文
// （滚动条 + 最大高度，样式在 inject_styles.ts 的 .think-* 全局兜底）。
// streaming 时 token 数实时增长。

component fn ThinkBlock(text: str, tokens: int, streaming: bool) {
    use {
        fn: thinkLabel from "src/front/forge_helpers.at"
    }
    computed {
        // 折叠/展开指示,与 GenericToolCard 的 ▼/▲ 同款
        chevron => if .expanded { "▲" } else { "▼" }
    }
    msg Msg { Toggle }
    model {
        var expanded bool = false
    }
    on {
        .Toggle -> { .expanded = !.expanded }
    }
    style {
.think-block {
  width: 100%; box-sizing: border-box;
  border: 1px solid hsl(var(--border));
  border-radius: 8px;
  background: hsl(var(--muted) / 0.4);
  max-width: 100%;
  overflow: hidden;
}
.think-header {
  display: flex; align-items: center; gap: 0.35rem;
  padding: 0.35rem 0.65rem;
  font-size: 0.78rem; color: hsl(var(--muted-foreground));
  cursor: pointer; user-select: none;
}
.think-header:hover { background: hsl(var(--muted) / 0.5); }
.think-header .tool-chevron { margin-left: auto; }
.think-content {
  margin: 0; padding: 0.55rem 0.75rem;
  font-size: 0.78rem; line-height: 1.5;
  font-family: inherit;
  white-space: pre-wrap; word-break: break-word;
  color: hsl(var(--muted-foreground));
  max-height: 240px;
  overflow-y: auto;
  border-top: 1px solid hsl(var(--border));
}
    }

    col {
        class: if .expanded { "think-block expanded" } else { "think-block" }
        row {
            onclick: .Toggle
            style: "think-header"
            text "💭"
            text thinkLabel(.tokens, .streaming)
            span {
                style: "tool-chevron"
                text .chevron
            }
        }
        if .expanded {
            pre {
                style: "think-content"
                text .text
            }
        }
    }
}
