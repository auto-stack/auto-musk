// think_block.at — ThinkBlock 组件（有序 block 渲染模型）
//
// 思考内容折叠块：默认收起，只显示 💭 + token 数；点击展开后显示思考全文
// （最大高度 + 展开区顶部 hairline）。streaming 时 token 数实时增长。
//
// PLAN-055: style{} CSS 块迁内联工具类（PLAN-049 双轨收敛同款，单一样式源）。
// 原 .think-* 规则只活在 web 轨（style{} 组件 CSS），VM 轨整块被忽略——
// 思考块在 VM 排成一行裸文本，无框无底色，与普通正文无区分（用户反馈
// "独立的 Block" 消失）。迁移后两轨同源：
//   - w-full + rounded-lg border bg-muted/40 → VM 有 visual-wrap 臂全支持；
//   - chevron ml-auto 贴行右端（VM ml-auto 消费，054 T4 同款）；
//   - 内容区 max-h-[240px] overflow-y-auto：web 滚动；VM 轨 pre 无滚动臂，
//     长思考展开后整段铺开（降级登记，无信息损失）。
//   - rem 值就近取整为 px（VM 任意值只认 px）：0.65rem→10px、0.35rem→6px、
//     0.78rem→12.5px、0.55/0.75rem→9px/12px。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web thinkLabel from "src/front/forge_helpers.at"

// PLAN-055 ④/T11：无状态化——VM 轨 ensure_child_state 使所有 ThinkBlock 实例
// 共享同一根态模型字段（expanded 全实例联动）；对象新键/索引插入在 VM 均崩
// （keyed map 不可行）。改为：expanded 由父级按 thinkKey 从根态展开键列表
// 计算（每实例构建期求值，天然隔离）；点击以小写 toggle msg 携构建期冻结的
// .id 实参上抛（.Pick(.s.id) 同款已证形态），父级 ChatMessage 收流直调
// ForgeStore.ThinkToggle 键列表重建。PLAN-057 子件状态分槽根修后可回归
// 子件自持模型形态。
widget ThinkBlock(id: str, text: str, tokens: int, streaming: bool, expanded: bool) {
    computed {
        // 折叠/展开指示,与 GenericToolCard 的 ▼/▲ 同款
        chevron => if .expanded { "▲" } else { "▼" }
    }
    msg Msg { toggle(str) }
    on {
        // 空体：声明式 emit（child_emit C2①）以首实参（构建期冻结的 id）回送父级。
        .toggle(id) -> {}
    }

    view {
        col {
            class: "think-block w-full box-border rounded-lg border border-border bg-muted/40 max-w-full overflow-hidden"
            // PLAN-055 T13：头改为全宽 button——VM 轨子件内 row.onclick 派发
            // 不达（5 连按零 dispatch 实测；musk 全部可靠点击面均为 button，
            // 会话列表 .SelectSession(.s.id) 同款带实参形态）。web 侧样式
            // 重置类（border-none bg-transparent）保持与原 row 观感一致。
            button {
                onclick: .toggle(.id)
                style: "think-header w-full flex items-center gap-[6px] py-[6px] px-[10px] text-[12.5px] text-muted-foreground cursor-pointer select-none hover:bg-muted/50 border-none bg-transparent text-left"
                text "💭"
                text thinkLabel(.tokens, .streaming)
                span {
                    style: "tool-chevron ml-auto"
                    text .chevron
                }
            }
            if .expanded {
                div {
                    style: "think-content my-0 py-[9px] px-[12px] text-[13.5px] leading-[1.5] font-mono whitespace-pre-wrap break-words text-muted-foreground max-h-[240px] overflow-y-auto border-t border-border"
                    text .text
                }
            }
        }
    }
    }
