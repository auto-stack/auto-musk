// secretary_helpers.at — SecretaryMessage 时间格式化（单一真源，
// 替代 secretary_helpers.ts）
//
// Plan 029 T5：Date.now/Math.floor（F3）+ 字符串拼接即可原生表达。
// 注：整型除法生成 Math.trunc(a/b)——耗时非负时 trunc == floor，等价。

/** 距 since 的时间标签（just now / Xm / Xh / Xd）。 */
fn secretary_format_elapsed(since int) str {
    // 差值先落中间变量——直接写 (Date.now() - since) / 60000 会被 Bina
    // 括号扁平化错排成 Date.now() - since / 60000（优先级错误）。
    let diff = Date.now() - since
    let mins = Math.floor(diff / 60000)
    if mins < 1 {
        return "just now"
    }
    if mins < 60 {
        return mins.to_string() + "m"
    }
    let hrs = Math.floor(mins / 60)
    if hrs < 24 {
        return hrs.to_string() + "h"
    }
    return Math.floor(hrs / 24).to_string() + "d"
}
