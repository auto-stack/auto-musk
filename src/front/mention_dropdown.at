// mention_dropdown.at — MentionDropdown 组件（Plan 023 队列 B3：emit 逃生舱原生化）
//
// 对标 src/front/components/MentionDropdown.vue（逃生舱，已删除）。
//
// 设计调整：component fn 不支持 expose 块（仅 widget 支持，codegen 缺口已登记），
// 键盘导航状态（index/filtered）上移到父组件 MentionInput（逃生舱）：
//   - 父组件用 mentionFiltered/mentionClampIndex/mentionIndexOf（mention_helpers）
//     管理 mentionIndex，传 activeIndex prop 给本组件
//   - 本组件纯渲染 + emit：select(id) / hover(id)
//
// 其他转换：
//   - filter+includes + DOMRect 位置对象 → mention_helpers.ts fn
//   - active class 用 activeId（filtered[activeIndex].id）对比，避免 for 索引变量
//   - teleport 用花括号 props 形式（`teleport (to:...)` 与 ident+LParen fn-call
//     检测冲突）
//
// 样式：PLAN-049 T6 双轨收敛——mention-* 迁内联工具类。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web mention_filtered, mention_position, mention_current_id from "src/front/mention_helpers.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use agent_avatar: AgentAvatar

widget MentionDropdown(professions: obj, visible: bool, filter: str, anchorRect: obj, activeIndex: int) {
    computed {
        filtered => mention_filtered(.professions, .filter)
        position => mention_position(.anchorRect)
        activeId => mention_current_id(.filtered, .activeIndex)
    }
    msg Msg { select(str), hover }
    on {
        .select(id) -> {}
        .hover(id) -> {}
    }
    // PLAN-049 T6：mention-* 已迁内联工具类（块删除）。阴影 web-only（白名单）;
    // teleport/绝对定位 VM 降级（与原 scoped 形态一致）。

    view {
        teleport {
            to: "body"
            if .visible && .filtered.len > 0 {
                div {
                    class: "min-w-[220px] max-h-[260px] overflow-y-auto bg-card border border-border rounded-lg shadow-[0_4px_16px_rgba(0,0,0,0.12)] p-1 z-[200]"
                    style: .position
                    for item in .filtered {
                        button {
                            key: .item.id
                            onclick: .select(.item.id)
                            onmouseenter: .hover(.item.id)
                            // PLAN-071 需求⑬：脚手架 Button 预设 justify-center
                            // h-10 会居中且撑高行（r4 教训）——justify-start/h-auto
                            // 显式覆盖，内容左对齐。
                            class: if .activeId == .item.id { "flex items-center justify-start gap-2 w-full h-auto py-1.5 px-2.5 border-none rounded-md bg-primary/10 text-primary text-sm text-left cursor-pointer" } else { "flex items-center justify-start gap-2 w-full h-auto py-1.5 px-2.5 border-none rounded-md bg-transparent text-foreground text-sm text-left cursor-pointer hover:bg-primary/10" }
                            if .item.kind == "agent" {
                                AgentAvatar { professionId: .item.id, name: .item.name, size: "sm" }
                                span {
                                    style: "font-semibold font-mono"
                                    text "@"
                                    text .item.id
                                }
                                span {
                                    style: "text-muted-foreground text-[13px]"
                                    text .item.name
                                }
                            } else {
                                if .item.kind == "plan" {
                                    span {
                                        style: "flex items-center justify-center w-6 h-6 rounded-md bg-primary/15 text-[12px] shrink-0"
                                        text "📋"
                                    }
                                    span {
                                        style: "font-semibold font-mono"
                                        text "@"
                                        text .item.id
                                    }
                                    span {
                                        style: "text-muted-foreground text-[13px] truncate max-w-[220px]"
                                        text .item.name
                                    }
                                } else {
                                    span {
                                        style: "flex items-center justify-center w-6 h-6 rounded-md bg-muted text-[12px] shrink-0"
                                        text "📄"
                                    }
                                    span {
                                        style: "font-semibold font-mono"
                                        text "@"
                                        text .item.id
                                    }
                                    span {
                                        style: "text-muted-foreground text-[13px] truncate max-w-[220px]"
                                        text .item.name
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
