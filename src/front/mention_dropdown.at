// mention_dropdown.at — MentionDropdown 组件（Plan 023 队列 B3：emit 逃生舱原生化）
//
// 对标 src/front/components/MentionDropdown.vue（逃生舱，已删除）。
//
// 设计调整：component fn 不支持 expose 块（仅 widget 支持，codegen 缺口已登记），
// 键盘导航状态（index/filtered）上移到父组件 MentionInput（逃生舱）：
//   - 父组件用 mentionFiltered/mentionClampIndex/mentionIndexOf（mention_helpers）
//     管理 mentionIndex，传 activeIndex prop 给本组件
//   - 本组件纯渲染 + emit：select(id) / hover(id)
//
// 其他转换：
//   - filter+includes + DOMRect 位置对象 → mention_helpers.ts fn
//   - active class 用 activeId（filtered[activeIndex].id）对比，避免 for 索引变量
//   - teleport 用花括号 props 形式（`teleport (to:...)` 与 ident+LParen fn-call
//     检测冲突）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.mention-dropdown 等）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web mention_filtered, mention_position, mention_current_id from "src/front/mention_helpers.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use agent_avatar: AgentAvatar

widget MentionDropdown(professions: obj, visible: bool, filter: str, anchorRect: obj, activeIndex: int) {
    computed {
        filtered => mention_filtered(.professions, .filter)
        position => mention_position(.anchorRect)
        activeId => mention_current_id(.filtered, .activeIndex)
    }
    msg Msg { select(str), hover }
    on {
        .select(id) -> {}
        .hover(id) -> {}
    }
    // Plan 029 T22：原 inject_styles 全局兜底下放（scoped 生效于本组件 DOM）。
    style {
  .mention-dropdown {
    min-width: 180px; max-height: 220px; overflow-y: auto;
    background: var(--af-card, #fff); border: 1px solid var(--af-border, hsl(220 13% 91%));
    border-radius: 8px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12); padding: 4px; z-index: 200;
  }
  .mention-item {
    display: flex; align-items: center; gap: 0.5rem; width: 100%;
    padding: 6px 10px; border: none; border-radius: 5px; background: transparent;
    color: var(--af-fg, hsl(220 14% 10%)); font-size: 0.88rem; cursor: pointer; text-align: left;
    transition: background 0.1s;
  }
  .mention-item:hover, .mention-item.active { background: hsl(var(--primary, 220 90% 56%) / 0.08); }
  .mention-item.active { color: var(--af-primary, hsl(220 90% 56%)); }
  .mention-name { font-weight: 600; font-family: monospace; }
  .mention-label { color: var(--af-muted, hsl(220 9% 46%)); font-size: 0.83rem; }
    }

    view {
        teleport {
            to: "body"
            if .visible && .filtered.len > 0 {
                div {
                    class: "mention-dropdown"
                    style: .position
                    for prof in .filtered {
                        button {
                            key: .prof.id
                            onclick: .select(.prof.id)
                            onmouseenter: .hover(.prof.id)
                            class: if .activeId == .prof.id { "mention-item active" } else { "mention-item" }
                            AgentAvatar { professionId: .prof.id, name: .prof.name, size: "sm" }
                            span {
                                style: "mention-name"
                                text "@"
                                text .prof.id
                            }
                            span {
                                style: "mention-label"
                                text .prof.name
                            }
                        }
                    }
                }
            }
        }
    }
}
