// files_view.at — 文件浏览器视图（PLAN-068）。
//
// 左 FileTree（workspace 根，PLAN-614 移植组件）+ 右分类型查看器。
// 模式同源：RawPreview（分型预览）/ SpecsView（树消费 + t() 惯用法）。
// markdown/代码经 autodown 管线渲染（files_store.active_markdown 单一真源）；
// 视频以 html: 兜底内嵌（.at 无原生 video 映射，raw iframe 同款逃生舱）。

use store: FilesStore
use filetree: FileTree
use content_header: ContentHeader
use.web component MarkdownRender from "src/front/ports/renderer.at"
use.web component FileIcon from "src/front/ports/icons.at"
// PLAN-089 T-07: 正文加载走 #[api] files_text 后端通道（JSON 包裹——
// 绑定固定 response.json()，纯文本必炸旧约束以此绕开）；VM 轨 no-op 桩
// （ports/files.*.at loadFilesFileText）退役。视图直引 back.api 有
// chats_view 先例。
use back.api: files_text
use.web useT from "src/front/ports/composables.at"

widget FilesView {

    setup {
        let t = useT()
    }

    msg Msg {
        Init,
        Pick(str),
    }

    on {
        // vue 轨挂载期 Init 派发；App.ShowFiles 兜底重拉（VM 轨 Init 不
        // 派发——PLAN-048 T5 口径，App 级代驱）。
        .Init -> {
            if .store.file_loaded != true {
                FilesStore.LoadTree()
            }
        }

        .Pick(path) -> {
            FilesStore.SelectFile(path);
            // 文本类经 #[api] files_text 后端通道加载（JSON {content}）。
            // 错误双臂：非 2xx 时 VM get_json 包错误对象（{error,status}，
            // `?? ""` 兜缺键）、web 生成绑定 throw——两臂同落 SetLoadFailed。
            if .store.active_kind == "code" || .store.active_kind == "markdown" {
                try {
                    let resp = files_text(path)
                    var err str = resp.error ?? ""
                    if err != "" {
                        FilesStore.SetLoadFailed()
                    } else {
                        FilesStore.SetContent(resp.content ?? "")
                    }
                } catch (e) {
                    FilesStore.SetLoadFailed()
                }
            }
        }
    }

    view {
        row (style: "h-full w-full min-h-0") {
            // 二级导航：文件树栏
            col {
                style: "w-[240px] shrink-0 flex flex-col h-full overflow-hidden bg-muted/20 border-r border-border"
                row {
                    style: "flex items-center h-12 shrink-0 px-3 border-b border-border"
                    text t("workspaceUi.filesTitle") { style: "text-base font-semibold text-foreground" }
                }
                col {
                style: "flex-1 overflow-auto p-2"
                if !.store.file_loaded {
                    text t("files.loading") { style: "text-sm text-muted-foreground p-3" }
                }
                if .store.file_truncated {
                    div (style: "text-xs text-amber-500 mb-2 px-2") {
                        text t("files.truncated")
                    }
                }
                if .store.file_loaded {
                    if .store.file_tree.len() == 0 {
                        div (style: "text-sm text-muted-foreground p-4") {
                            text t("files.emptyTree")
                        }
                    } else {
                        FileTree (nodes: .store.file_tree, onselect: .Pick($event))
                    }
                }
                }
            }
            // 内容面板
            col { style: "flex-1 min-w-0 h-full"
            ContentHeader {
                title: t("workspaceUi.filesTitle")
                slot(name: "middle") {
                    text .store.active_path { style: "text-sm text-muted-foreground truncate" }
                }
            }
            main (style: "flex-1 min-w-0 overflow-auto p-4") {
                if .store.active_path == "" {
                    div (style: "h-full flex flex-col items-center justify-center gap-2 text-muted-foreground") {
                        FileIcon { size: 28 }
                        text t("workspaceUi.filesEmptyTitle") { style: "text-xl font-semibold text-foreground" }
                        text t("workspaceUi.filesBody") { style: "text-sm text-muted-foreground max-w-[400px] leading-6" }
                    }
                } else {
                    if .store.active_loading {
                        div (style: "text-sm text-muted-foreground p-4") {
                            text t("files.loading")
                        }
                    } else {
                        if .store.active_failed {
                        div (style: "h-full flex flex-col items-center justify-center gap-2 text-muted-foreground") {
                            FileIcon { size: 28 }
                            text t("files.loadFailed") { style: "text-sm" }
                        }
                        } else if .store.active_kind == "image" {
                            img { src: .store.active_url, style: "max-w-full max-h-[70vh] rounded-md" }
                        } else if .store.active_kind == "video" {
                            div { html: .store.active_video_html }
                        } else if .store.active_kind == "markdown" {
                            // .md/.ad 同臂：autodown 真渲染（T-08——.ad 原生
                            // 文档格式随 autodown 引擎解析）。
                            MarkdownRender { content: .store.active_content }
                        } else if .store.active_kind == "code" {
                            // T-09：原生 code_editor 只读查看器（高亮/行号；
                            // 编辑归 auto-edit 域，§6 裁定衔接）。key 恒定：
                            // 切文件靠 §5.4 外部差分回写（readonly 无内部
                            // 编辑，无残留面）。readonly 需 auto-lang
                            // musk-089-dev readonly 穿透。
                            code_editor (key: "files-viewer", lang: .store.active_lang, value: .store.active_content, readonly: true, line_numbers: true, style: "h-[560px] w-full rounded-md border") {}
                        } else {
                            div (style: "h-full flex flex-col items-center justify-center gap-2 text-muted-foreground") {
                                FileIcon { size: 28 }
                                text t("files.cannotOpen") { style: "text-sm" }
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
