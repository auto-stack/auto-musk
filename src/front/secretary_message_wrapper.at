// secretary_message_wrapper.at — SecretaryMessageWrapper 组件（Plan 023 队列 B 续：§10.4 composable facade 原生化）
//
// 对标 src/front/components/SecretaryMessageWrapper.vue（逃生舱，已删除）。
// Plan 029 T12：useGateInbox composable → GateInbox store（.store facade）；
// badge 由 gates 列表本地过滤（原 badgeCount computed 等价）。
//
// 语义对齐：approve/reject 本地 resolveGate（不向父重发——原 onApprove 不 emit，
// 用大写 Approve/Reject 变体让 auto-emit 不匹配父 @approve/@reject）；snooze 转发
// 父（小写 snooze → 父 SecretarySnooze → store.ClearGate）。

use store: GateInbox

component fn SecretaryMessageWrapper() {
    use {
        component: SecretaryMessage
        fn: gate_pending_count from "src/front/gate_inbox.at"
    }
    computed {
        gate => .store.current_secretary
        queuePosition => gate_pending_count(.store.gates)
        hasGate => .gate != None
    }
    msg Msg { Approve, Reject, snooze }
    on {
        .Approve -> { if .hasGate { store.Resolve(.gate.gateId, "approved") } }
        .Reject -> { if .hasGate { store.Resolve(.gate.gateId, "rejected") } }
        .snooze -> {}
    }
    if .hasGate {
        SecretaryMessage {
            gate: .gate
            queuePosition: .queuePosition
            onapprove: .Approve
            onreject: .Reject
            onsnooze: .snooze
        }
    }
}
