// secretary_message_wrapper.at — SecretaryMessageWrapper 组件（Plan 023 队列 B 续：§10.4 composable facade 原生化）
//
// 对标 src/front/components/SecretaryMessageWrapper.vue（逃生舱，已删除）。
// §10.4（composable facade ref .value 正式修复）后不再需要逃生舱包装：
// useGateInbox refs 标注 currentSecretary/badgeCount 自动 .value。
//
// 语义对齐：approve/reject 本地 resolveGate（不向父重发——原 onApprove 不 emit，
// 用大写 Approve/Reject 变体让 auto-emit 不匹配父 @approve/@reject）；snooze 转发
// 父（小写 snooze → 父 SecretarySnooze → store.ClearGate）。

component fn SecretaryMessageWrapper() {
    use {
        composable: useGateInbox refs: [currentSecretary, badgeCount] from "src/front/composables/useGateInbox.ts"
        component: SecretaryMessage
    }
    computed {
        gate => gateInbox.currentSecretary
        queuePosition => gateInbox.badgeCount
        hasGate => .gate != None
    }
    msg Msg { Approve, Reject, snooze }
    on {
        .Approve -> { if .hasGate { gateInbox.resolveGate(.gate.gateId, "approved") } }
        .Reject -> { if .hasGate { gateInbox.resolveGate(.gate.gateId, "rejected") } }
        .snooze -> {}
    }
    if .hasGate {
        SecretaryMessage {
            gate: .gate
            queuePosition: .queuePosition
            onapprove: .Approve
            onreject: .Reject
            onsnooze: .snooze
        }
    }
}
