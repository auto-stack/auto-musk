// mention_input.at — MentionInput 组件（Plan 023 队列 B5：最复杂输入组件原生化）
//
// 对标 src/front/components/MentionInput.vue（逃生舱，已删除）。
//
// 关键转换：
//   - v-html backdrop（@mention 高亮）→ textarea `mentions:` 能力声明（PLAN-493：
//     叠加技法整体下沉双端实现层——Vue 由 codegen 发射 backdrop+透明 textarea
//     兄弟对，VM 走原生 Highlighter 着色；.at 声明层不再出现 backdrop 结构）
//   - textarea v-model（固定 key）→ value: + oninput:（v-model 优化触发）
//   - @mention 检测（regex/slice/DOM 读取）→ mention_helpers.ts fn + $event
//   - 键盘导航（dropdown 已原生，状态在本组件）→ Keydown handler + mentionKeyAction
//   - 插入文本拼接 + professions 兜底 → mention_helpers.ts fn
//   - selectionStart 实时读取（template ref 缺口）→ input 时捕获 mentionPos
//   - nextTick focus 舍弃（template ref）
//   - i18n t + useAgentConfigs → composable facade（refs 标注）
//
// 样式：PLAN-049 T6 双轨收敛——容器迁内联工具类;@mention 高亮为 textarea
// 能力（PLAN-493：web 侧 text-transparent 由 codegen 注入,VM 侧文字可见+
// 原生着色）。原 send-btn 渐变底收敛为 bg-primary 单色（登记）;rounded-[20px]
// VM 无 arbitrary 圆角臂,登记降级。
//
// composer 一体化改版（2026-09-07,zcode/codex 式）：
//   - 输入面与工具栏（思考档位 dropdown + 发送钮）同框：外层大圆角容器持
//     边框/底色/焦点环;chats_view 的独立思考档位行（PLAN-064 形态）收编进
//     本组件工具栏——经 thinkingLevel prop + pick 事件与 ForgeStore 解耦,
//     档位落库仍在 chats_view.PickThinking。
//   - textarea 自适应增高：web 侧 platformComposerAutoGrow 逃生舱按内容
//     驱动 wrapper 高度（backdrop 类由 textarea 声明类逐 token 镜像推导,
//     textarea 恒 absolute inset-0 h-full 才能正确叠加——故增高打 wrapper,
//     0px 复位测 scrollHeight 防 h-full 下"只涨不缩"）;VM 轨 text_editor
//     固定 height:72 内滚降级。

use store: AgentConfigs
// PLAN-071 需求⑬：@ 菜单三源——计划（plans_list）与规范文件（specs_tree）
// 经 back.api 直取（MentionInput 无 store 绑定，codegen 单别名限制）。
use back.api: plans_list, specs_tree

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component ArrowUp, Brain, Check, ChevronDown, Square from "src/front/ports/icons.at"
use.web useI18n from "src/front/ports/composables.at"
use.web build_mention_name_list, mention_combined_items from "src/front/mention_helpers.at"
use.web mention_filtered, mention_clamp_index, mention_index_of, mention_key_action, mention_detect_filter, mention_detect_anchor, mention_detect_visible, mention_detect_pos, mention_insert, mention_can_send, mention_trim, mention_professions_list, mention_current_id from "src/front/mention_helpers.at"
use.web platformComposerAutoGrow from "src/front/ports/platform.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use mention_dropdown: MentionDropdown

widget MentionInput(disabled: bool, professions: obj, thinkingLevel: str, approvalMode: str) {

    setup {
        let i18n = useI18n()
        refs i18n: [locale]
    }
    computed {
        professionsList => mention_professions_list(.professions, .store.configs)
        canSend => mention_can_send(.text)
        // PLAN-071 需求⑬：三源合并（Agent + 计划 + 规范文件），过滤与键盘
        // 导航沿用既有扁平管线。
        mentionItems => mention_combined_items(.professionsList, .plansRaw, .specFiles)
        mentionFilteredList => mention_filtered(.mentionItems, .mentionFilter)
        hasMentionItems => .mentionFilteredList.length > 0
        // 触发钮档位文案（""/off 同归"关",与选中态口径一致）。
        thinkingLabel => if .thinkingLevel == "low" { i18n.t("chat.thinkingLow") } else if .thinkingLevel == "high" { i18n.t("chat.thinkingHigh") } else if .thinkingLevel == "max" { i18n.t("chat.thinkingMax") } else { i18n.t("chat.thinkingOff") }
        // PLAN-067 T-05: 审批模式文案（human=人工[缺省],auto=自动放行）。
        approvalLabel => if .approvalMode == "auto" { i18n.t("chat.approvalAuto") } else { i18n.t("chat.approvalHuman") }
    }
    msg Msg { Init, Input, Keydown, Select, Hover, send(str), cancel, pick(str), pickapproval(str) }
    model {
        var text str = ""
        var mentionVisible bool = false
        var mentionFilter str = ""
        var mentionAnchor obj = None
        var mentionIndex int = 0
        var mentionPos int = 0
        // PLAN-493: mention 名单（state-rooted——mentions prop 的 VM 受限解析
        // 只认 var/store 字段，computed 会踩 call 链 UAF 红线）。Init 即取默认
        // 表；Input 再刷一次收敛异步到达的 configs（静置缺口登记计划待澄清④）。
        var mentionNames []Value = []
        // 思考档位 dropdown 开合态（触发钮 toggle 关闭,无外点关闭——
        // 同 SessionInfo 登记差异）。
        var thinkOpen bool = false
        // PLAN-067 T-05: 审批模式 dropdown 开合态（同 thinkOpen 口径）。
        var approvalOpen bool = false
        // PLAN-071 需求⑬：@ 菜单扩展数据——计划列表 + 规范文件树，首次
        // 触发 @ 时懒加载（extLoaded 防重复拉取）。
        var extLoaded bool = false
        var plansRaw obj = None
        var specFiles []Value = []
        // PLAN-071 需求⑭：候选框打开时 Enter 已用于补全的标记——textarea
        // 上 `onkeydown.enter.exact.prevent: .send` 与 Keydown 处理器并存，
        // 补全后 send 依此标记跳过（正常输入态 Enter 才发送）。
        var mentionHandled bool = false
    }
    on {
        .Init -> {
            AgentConfigs.Init();
            .mentionNames = build_mention_name_list(.professions, .store.configs);
            // r9：追加引用 token id（plan/<seq>、spec/<relpath>）进高亮名单
            // ——codegen __autoMentionHtml 的 token 匹配是名单驱动的（含
            // . / - 字符的扩展扫描 + 最长匹配），名单不含 token 则输入框
            // backdrop 永远不亮。mentionItems 由 computed 即时重算，此处
            // 直读即可（plans/spec 拉取后的下一拍起生效）。
            for it in .mentionItems {
                if it.kind != "agent" {
                    .mentionNames.push(it.id)
                }
            }
            // web 侧装 document 级委托监听 + 初次定高（空态 ~1 行）。
            platformComposerAutoGrow()
        }

        .Input(e) -> {
            .mentionFilter = mention_detect_filter(e);
            .mentionAnchor = mention_detect_anchor(e);
            .mentionVisible = mention_detect_visible(e);
            .mentionPos = mention_detect_pos(e);
            // PLAN-071 需求⑭：筛选/输入变化即重置高亮到第一项（默认选中
            // 首条语义），并清除 Enter 消费标记。
            .mentionIndex = 0;
            .mentionHandled = false;
            .mentionNames = build_mention_name_list(.professions, .store.configs);
            // r9：追加引用 token id（plan/<seq>、spec/<relpath>）进高亮名单
            // ——codegen __autoMentionHtml 的 token 匹配是名单驱动的（含
            // . / - 字符的扩展扫描 + 最长匹配），名单不含 token 则输入框
            // backdrop 永远不亮。mentionItems 由 computed 即时重算，此处
            // 直读即可（plans/spec 拉取后的下一拍起生效）。
            for it in .mentionItems {
                if it.kind != "agent" {
                    .mentionNames.push(it.id)
                }
            }
            // PLAN-071 需求⑬：首次触发 @ 懒加载计划列表与规范文件树。
            if .mentionVisible {
                if .extLoaded == false {
                    .extLoaded = true;
                    .plansRaw = plans_list();
                    let tr = specs_tree();
                    var files []Value = []
                    for node in (tr ?? []) {
                        if node != None {
                            if node.type == "file" {
                                if node.path != "" {
                                    files.push({ "path": node.path, "name": node.name })
                                }
                            }
                        }
                    }
                    .specFiles = files
                }
            }
            platformComposerAutoGrow()
        }
        .Keydown(e) -> {
            if .mentionVisible {
                if .hasMentionItems {
                    if mention_key_action(e) == "ArrowDown" {
                        .mentionIndex = mention_clamp_index(.mentionIndex + 1, .mentionFilteredList.length)
                    } else if mention_key_action(e) == "ArrowUp" {
                        .mentionIndex = mention_clamp_index(.mentionIndex - 1, .mentionFilteredList.length)
                    } else if mention_key_action(e) == "Enter" || mention_key_action(e) == "Tab" {
                        // r6：补全消费按键必须阻断默认行为——Tab 默认把焦点
                        // 移到 tabindex 序下一个可聚焦元素（工具栏"思考"钮），
                        // Enter 默认可能触发表单提交；Enter 常另有
                        // .prevent 修饰符兜底,Tab 无修饰符臂,必须在此阻断。
                        e.preventDefault();
                        .text = mention_insert(.mentionItems, mention_current_id(.mentionFilteredList, .mentionIndex), .text, .mentionPos);
                        .mentionVisible = false;
                        // PLAN-071 需求⑭：标记本次 Enter 已用于补全——send
                        // 处理器读到标记即跳过（候选框打开时 Enter 优先补全，
                        // 不发送）。
                        .mentionHandled = true;
                        platformComposerAutoGrow()
                    } else if mention_key_action(e) == "Escape" {
                        .mentionVisible = false
                    }
                }
            }
        }
        .Select(id) -> {
            .text = mention_insert(.mentionItems, id, .text, .mentionPos);
            .mentionVisible = false;
            platformComposerAutoGrow()
        }
        .Hover(id) -> { .mentionIndex = mention_index_of(.mentionFilteredList, id) }
        .send(t) -> {
            // PLAN-071 需求⑭：候选框打开时 Enter 已被补全消费（Keydown 置
            // mentionHandled）——本次 Enter 不发送；正常输入态才发送。
            if .mentionHandled {
                .mentionHandled = false;
                return
            }
            // PLAN-051 T8: 实参改 t（原 .send(mention_trim(.text)) 的 fn 调用
            // 实参在 VM 构建期求值面不可达，会落字面量串）——trim 内移，净效果
            // 等价（vue 轨求值点从调用位移到 handler 内，守卫口径不变）。
            let tt = mention_trim(t)
            if tt != "" {
                .text = "";
                .mentionVisible = false;
                // 程序化清空不冒泡 input 事件——显式调度回落到单行高。
                platformComposerAutoGrow()
            }
        }
        .cancel -> {}
        // 思考档位：菜单开合 + 选中收菜单（落库经父层 onpick →
        // chats_view.PickThinking → ForgeStore.SetThinkingLevel）。
        .ToggleThinkMenu -> { .thinkOpen = !.thinkOpen }
        .pick(level) -> { .thinkOpen = false }
        // PLAN-067 T-05: 审批模式 dropdown 开合 + 选中收菜单（事件经父层
        // PickApproval → store.SetApprovalMode 落库）。
        // r6：msg 名 pick_approval → pickapproval——codegen emit 用 msg
        // 原名（emit('pick_approval')），父层模板绑定却是 @pickapproval
        // （onPickapproval）；Vue3 事件名精确匹配（camelize 兜底要
        // onPickApproval 也不等于 onPickapproval），下划线版事件永远
        // 悬空 → 选"自动"后 store 未收到任何调用（实测无网络请求）。
        .ToggleApprovalMenu -> { .approvalOpen = !.approvalOpen }
        .pickapproval(mode) -> { .approvalOpen = false }
    }
    view {
        div {
            style: "w-full"
            div {
                style: "max-w-[960px] mx-auto w-full"
                // zcode/codex 式一体化 composer：大圆角容器 = 输入面 + 工具栏。
                div {
                    style: "composer-box flex flex-col w-full bg-muted-foreground/5 border border-primary/15 rounded-[20px] focus-within:border-primary/45 focus-within:shadow-[0_0_0_3px_hsl(var(--primary)/0.08)]"
                    // 输入面：wrapper 高度由 web 侧 JS 按内容驱动（min-h 兜
                    // 首帧）；textarea absolute inset-0 h-full 镜像 backdrop。
                    div {
                        style: "relative w-full min-h-[44px]"
                        textarea {
                            style: "chats-input absolute inset-0 h-full py-2.5 px-3.5 block w-full border-none rounded-none bg-transparent text-[15px] leading-[1.5] caret-[hsl(var(--foreground))] outline-none resize-none focus:outline-none focus:shadow-none focus:border-none"
                            value: .text
                            mentions: .mentionNames
                            mention_class: "text-[hsl(220_90%_56%)] bg-[hsl(220_90%_56%/0.12)] rounded-[3px] px-[0.2rem] font-medium"
                            // VM 轨多行编辑面——text_editor 缺省 Fixed(30) 单行高
                            // （h-full/min-h 类为 CSS-only,Plan 053 注记）,显式
                            // height 固定编辑面;web 轨不消费此 prop（几何由
                            // wrapper 内联高度承载）。
                            height: 72
                            oninput: .Input($event)
                            onkeydown: .Keydown($event)
                            onkeydown.enter.exact.prevent: .send(.text)
                            placeholder: i18n.t("chat.inputPlaceholder")
                            disabled: .disabled
                        }
                    }
                    // 工具栏行：思考档位 dropdown（左）+ 弹性留白 + 发送钮（右）。
                    div {
                        style: "flex items-center gap-1.5 px-2 pb-2 w-full shrink-0"
                        div {
                            style: "relative"
                            button {
                                onclick: .ToggleThinkMenu
                                disabled: .disabled
                                title: i18n.t("chat.thinkingLevel")
                                class: if .thinkOpen {
                                    "flex items-center gap-1 h-8 px-2 rounded-md text-[13px] border-none bg-accent text-foreground cursor-pointer"
                                } else {
                                    "flex items-center gap-1 h-8 px-2 rounded-md text-[13px] border-none bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                                }
                                Brain { size: 15 }
                                text .thinkingLabel
                                ChevronDown { size: 13 }
                            }
                            // 向上弹出菜单（zcode 式）：当前档位打勾。
                            if .thinkOpen {
                                div {
                                    style: "absolute bottom-full left-0 mb-2 min-w-[120px] bg-card border border-border rounded-lg shadow-[0_4px_16px_rgba(0,0,0,0.12)] p-1 z-50 flex flex-col"
                                    button {
                                        // PLAN-071 需求⑩：显式"关"持久化为 "off"
                                        // （原发 "" 会被后端归一成 None=默认 low，
                                        // 无法真正关闭）。
                                        onclick: .pick("off")
                                        disabled: .disabled
                                        class: if .thinkingLevel == "off" {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-primary/10 text-primary text-[13px] text-left cursor-pointer"
                                        } else {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-transparent text-foreground text-[13px] text-left cursor-pointer hover:bg-primary/10"
                                        }
                                        text i18n.t("chat.thinkingOff")
                                        if .thinkingLevel == "off" {
                                            Check { size: 14 }
                                        }
                                    }
                                    button {
                                        onclick: .pick("low")
                                        disabled: .disabled
                                        class: if .thinkingLevel == "low" {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-primary/10 text-primary text-[13px] text-left cursor-pointer"
                                        } else {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-transparent text-foreground text-[13px] text-left cursor-pointer hover:bg-primary/10"
                                        }
                                        text i18n.t("chat.thinkingLow")
                                        if .thinkingLevel == "low" {
                                            Check { size: 14 }
                                        }
                                    }
                                    button {
                                        onclick: .pick("high")
                                        disabled: .disabled
                                        class: if .thinkingLevel == "high" {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-primary/10 text-primary text-[13px] text-left cursor-pointer"
                                        } else {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-transparent text-foreground text-[13px] text-left cursor-pointer hover:bg-primary/10"
                                        }
                                        text i18n.t("chat.thinkingHigh")
                                        if .thinkingLevel == "high" {
                                            Check { size: 14 }
                                        }
                                    }
                                    button {
                                        onclick: .pick("max")
                                        disabled: .disabled
                                        class: if .thinkingLevel == "max" {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-primary/10 text-primary text-[13px] text-left cursor-pointer"
                                        } else {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-transparent text-foreground text-[13px] text-left cursor-pointer hover:bg-primary/10"
                                        }
                                        text i18n.t("chat.thinkingMax")
                                        if .thinkingLevel == "max" {
                                            Check { size: 14 }
                                        }
                                    }
                                }
                            }
                        }
                        // PLAN-067 T-05: 审批模式 dropdown（思考档位右侧,
                        // 同款开合/选中勾口径;human=人工[缺省],auto=自动）。
                        div {
                            style: "relative"
                            button {
                                onclick: .ToggleApprovalMenu
                                disabled: .disabled
                                title: i18n.t("chat.approvalMode")
                                class: if .approvalOpen {
                                    "flex items-center gap-1 h-8 px-2 rounded-md text-[13px] border-none bg-accent text-foreground cursor-pointer"
                                } else {
                                    "flex items-center gap-1 h-8 px-2 rounded-md text-[13px] border-none bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                                }
                                text .approvalLabel
                                ChevronDown { size: 13 }
                            }
                            if .approvalOpen {
                                div {
                                    style: "absolute bottom-full left-0 mb-2 min-w-[120px] bg-card border border-border rounded-lg shadow-[0_4px_16px_rgba(0,0,0,0.12)] p-1 z-50 flex flex-col"
                                    button {
                                        onclick: .pickapproval("human")
                                        disabled: .disabled
                                        class: if .approvalMode != "auto" {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-primary/10 text-primary text-[13px] text-left cursor-pointer"
                                        } else {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-transparent text-foreground text-[13px] text-left cursor-pointer hover:bg-primary/10"
                                        }
                                        text i18n.t("chat.approvalHuman")
                                        if .approvalMode != "auto" {
                                            Check { size: 14 }
                                        }
                                    }
                                    button {
                                        onclick: .pickapproval("auto")
                                        disabled: .disabled
                                        class: if .approvalMode == "auto" {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-primary/10 text-primary text-[13px] text-left cursor-pointer"
                                        } else {
                                            "flex items-center justify-between gap-3 w-full py-1.5 px-2.5 border-none rounded-md bg-transparent text-foreground text-[13px] text-left cursor-pointer hover:bg-primary/10"
                                        }
                                        text i18n.t("chat.approvalAuto")
                                        if .approvalMode == "auto" {
                                            Check { size: 14 }
                                        }
                                    }
                                }
                            }
                        }
                        div {
                            style: "flex-1"
                        }
                        if .disabled {
                            button {
                                onclick: .cancel
                                style: "w-9 h-9 min-w-9 rounded-full bg-primary text-primary-foreground flex items-center justify-center shrink-0 border-none cursor-pointer hover:opacity-85 disabled:opacity-40"
                                Square { size: 18 }
                            }
                        } else {
                            button {
                                onclick: .send(.text)
                                style: "w-9 h-9 min-w-9 rounded-full bg-primary text-primary-foreground flex items-center justify-center shrink-0 border-none cursor-pointer hover:opacity-85 disabled:opacity-40"
                                disabled: !.canSend
                                ArrowUp { size: 18 }
                            }
                        }
                    }
                }
                MentionDropdown {
                    professions: .mentionItems
                    visible: .mentionVisible
                    filter: .mentionFilter
                    anchorRect: .mentionAnchor
                    activeIndex: .mentionIndex
                    onselect: .Select($event)
                    onhover: .Hover($event)
                }
            }
        }
    }
}
