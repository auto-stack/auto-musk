// mention_input.at — MentionInput 组件（Plan 023 队列 B5：最复杂输入组件原生化）
//
// 对标 src/front/components/MentionInput.vue（逃生舱，已删除）。
//
// 关键转换：
//   - v-html backdrop（@mention 高亮）→ html: prop（UserMessage 已验）
//   - textarea v-model（固定 key）→ value: + oninput:（v-model 优化触发）
//   - @mention 检测（regex/slice/DOM 读取）→ mention_helpers.ts fn + $event
//   - 键盘导航（dropdown 已原生，状态在本组件）→ Keydown handler + mentionKeyAction
//   - 插入文本拼接 + professions 兜底 → mention_helpers.ts fn
//   - selectionStart 实时读取（template ref 缺口）→ input 时捕获 mentionPos
//   - nextTick focus 舍弃（template ref）
//   - i18n t + useAgentConfigs → composable facade（refs 标注）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.chats-input-bar 等）。

component fn MentionInput(disabled: bool, professions: obj) {
    use {
        component: Send, Square from "lucide-vue-next"
        composable: useAgentConfigs refs: [configs] from "src/front/composables/useAgentConfigs.ts"
        composable: useI18n refs: [locale] from "vue-i18n"
        fn: renderInputMentions, buildMentionNames from "src/front/mention_helpers.ts"
        fn: mentionFiltered, mentionClampIndex, mentionIndexOf, mentionKeyAction, mentionDetectFilter, mentionDetectAnchor, mentionDetectVisible, mentionDetectPos, mentionInsert, mentionCanSend, mentionTrim, mentionProfessionsList, mentionCurrentId from "src/front/mention_helpers.ts"
        component: MentionDropdown
    }
    computed {
        professionsList => mentionProfessionsList(.professions, agentConfigs.configs)
        mentionNames => buildMentionNames(.professionsList)
        backdropHtml => renderInputMentions(.text, .mentionNames)
        canSend => mentionCanSend(.text)
        mentionFilteredList => mentionFiltered(.professionsList, .mentionFilter)
        hasMentionItems => .mentionFilteredList.length > 0
    }
    msg Msg { Input, Keydown, Select, Hover, send(str), cancel }
    model {
        var text str = ""
        var mentionVisible bool = false
        var mentionFilter str = ""
        var mentionAnchor obj = None
        var mentionIndex int = 0
        var mentionPos int = 0
    }
    on {
        .Input(e) -> {
            .mentionFilter = mentionDetectFilter(e);
            .mentionAnchor = mentionDetectAnchor(e);
            .mentionVisible = mentionDetectVisible(e);
            .mentionPos = mentionDetectPos(e)
        }
        .Keydown(e) -> {
            if .mentionVisible {
                if .hasMentionItems {
                    if mentionKeyAction(e) == "ArrowDown" {
                        .mentionIndex = mentionClampIndex(.mentionIndex + 1, .mentionFilteredList.length)
                    } else if mentionKeyAction(e) == "ArrowUp" {
                        .mentionIndex = mentionClampIndex(.mentionIndex - 1, .mentionFilteredList.length)
                    } else if mentionKeyAction(e) == "Enter" || mentionKeyAction(e) == "Tab" {
                        .text = mentionInsert(.professionsList, mentionCurrentId(.mentionFilteredList, .mentionIndex), .text, .mentionPos);
                        .mentionVisible = false
                    } else if mentionKeyAction(e) == "Escape" {
                        .mentionVisible = false
                    }
                }
            }
        }
        .Select(id) -> {
            .text = mentionInsert(.professionsList, id, .text, .mentionPos);
            .mentionVisible = false
        }
        .Hover(id) -> { .mentionIndex = mentionIndexOf(.mentionFilteredList, id) }
        .send(t) -> {
            if t != "" {
                .text = "";
                .mentionVisible = false
            }
        }
        .cancel -> {}
    }
    div {
        style: "chats-input-bar"
        div {
            style: "input-inner"
            div {
                style: "input-row"
                div {
                    style: "input-compose"
                    div {
                        style: "input-backdrop"
                        html: .backdropHtml
                    }
                    textarea {
                        style: "chats-input"
                        value: .text
                        oninput: .Input($event)
                        onkeydown: .Keydown($event)
                        onkeydown.enter.exact.prevent: .send(mentionTrim(.text))
                        placeholder: i18n.t("chat.inputPlaceholder")
                        disabled: .disabled
                    }
                }
                if .disabled {
                    button {
                        onclick: .cancel
                        style: "send-btn stop"
                        Square { size: 16 }
                    }
                } else {
                    button {
                        onclick: .send(mentionTrim(.text))
                        style: "send-btn"
                        disabled: !.canSend
                        Send { size: 16 }
                    }
                }
            }
            MentionDropdown {
                professions: .professionsList
                visible: .mentionVisible
                filter: .mentionFilter
                anchorRect: .mentionAnchor
                activeIndex: .mentionIndex
                onselect: .Select($event)
                onhover: .Hover($event)
            }
        }
    }
}
