// mention_input.at — MentionInput 组件（Plan 023 队列 B5：最复杂输入组件原生化）
//
// 对标 src/front/components/MentionInput.vue（逃生舱，已删除）。
//
// 关键转换：
//   - v-html backdrop（@mention 高亮）→ html: prop（UserMessage 已验）
//   - textarea v-model（固定 key）→ value: + oninput:（v-model 优化触发）
//   - @mention 检测（regex/slice/DOM 读取）→ mention_helpers.ts fn + $event
//   - 键盘导航（dropdown 已原生，状态在本组件）→ Keydown handler + mentionKeyAction
//   - 插入文本拼接 + professions 兜底 → mention_helpers.ts fn
//   - selectionStart 实时读取（template ref 缺口）→ input 时捕获 mentionPos
//   - nextTick focus 舍弃（template ref）
//   - i18n t + useAgentConfigs → composable facade（refs 标注）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.chats-input-bar 等）。

use store: AgentConfigs

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component Send, Square from "src/front/ports/icons.at"
use.web useI18n from "src/front/ports/composables.at"
use.web render_input_mentions, build_mention_names from "src/front/mention_helpers.at"
use.web mention_filtered, mention_clamp_index, mention_index_of, mention_key_action, mention_detect_filter, mention_detect_anchor, mention_detect_visible, mention_detect_pos, mention_insert, mention_can_send, mention_trim, mention_professions_list, mention_current_id from "src/front/mention_helpers.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use mention_dropdown: MentionDropdown

widget MentionInput(disabled: bool, professions: obj) {

    setup {
        let i18n = useI18n()
        refs i18n: [locale]
    }
    computed {
        professionsList => mention_professions_list(.professions, .store.configs)
        mentionNames => build_mention_names(.professionsList)
        backdropHtml => render_input_mentions(.text, .mentionNames)
        canSend => mention_can_send(.text)
        mentionFilteredList => mention_filtered(.professionsList, .mentionFilter)
        hasMentionItems => .mentionFilteredList.length > 0
    }
    msg Msg { Init, Input, Keydown, Select, Hover, send(str), cancel }
    model {
        var text str = ""
        var mentionVisible bool = false
        var mentionFilter str = ""
        var mentionAnchor obj = None
        var mentionIndex int = 0
        var mentionPos int = 0
    }
    on {
        .Init -> { store.Init() }

        .Input(e) -> {
            .mentionFilter = mention_detect_filter(e);
            .mentionAnchor = mention_detect_anchor(e);
            .mentionVisible = mention_detect_visible(e);
            .mentionPos = mention_detect_pos(e)
        }
        .Keydown(e) -> {
            if .mentionVisible {
                if .hasMentionItems {
                    if mention_key_action(e) == "ArrowDown" {
                        .mentionIndex = mention_clamp_index(.mentionIndex + 1, .mentionFilteredList.length)
                    } else if mention_key_action(e) == "ArrowUp" {
                        .mentionIndex = mention_clamp_index(.mentionIndex - 1, .mentionFilteredList.length)
                    } else if mention_key_action(e) == "Enter" || mention_key_action(e) == "Tab" {
                        .text = mention_insert(.professionsList, mention_current_id(.mentionFilteredList, .mentionIndex), .text, .mentionPos);
                        .mentionVisible = false
                    } else if mention_key_action(e) == "Escape" {
                        .mentionVisible = false
                    }
                }
            }
        }
        .Select(id) -> {
            .text = mention_insert(.professionsList, id, .text, .mentionPos);
            .mentionVisible = false
        }
        .Hover(id) -> { .mentionIndex = mention_index_of(.mentionFilteredList, id) }
        .send(t) -> {
            if t != "" {
                .text = "";
                .mentionVisible = false
            }
        }
        .cancel -> {}
    }
    view {
        div {
            style: "chats-input-bar"
            div {
                style: "input-inner"
                div {
                    style: "input-row"
                    div {
                        style: "input-compose"
                        div {
                            style: "input-backdrop"
                            html: .backdropHtml
                        }
                        textarea {
                            style: "chats-input"
                            value: .text
                            oninput: .Input($event)
                            onkeydown: .Keydown($event)
                            onkeydown.enter.exact.prevent: .send(mention_trim(.text))
                            placeholder: i18n.t("chat.inputPlaceholder")
                            disabled: .disabled
                        }
                    }
                    if .disabled {
                        button {
                            onclick: .cancel
                            style: "send-btn stop"
                            Square { size: 16 }
                        }
                    } else {
                        button {
                            onclick: .send(mention_trim(.text))
                            style: "send-btn"
                            disabled: !.canSend
                            Send { size: 16 }
                        }
                    }
                }
                MentionDropdown {
                    professions: .professionsList
                    visible: .mentionVisible
                    filter: .mentionFilter
                    anchorRect: .mentionAnchor
                    activeIndex: .mentionIndex
                    onselect: .Select($event)
                    onhover: .Hover($event)
                }
            }
        }
    }
}
