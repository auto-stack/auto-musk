// canvas_prog_feed.at — PLAN-097 T-05: CanvasProgFeed 零可见件。
// studio 挂载时把当前 ForgeStore.messages 快照推入 CanvasStore
//（cp_prog_msgs），作为进度行 store 域预计算（cp_prog_rows）的消息源。
// Init 派发形态 = relay_run_box（store.LoadRun）/ PlanProgressCard
//（store.Attach）已证通道；单 store 文件。独立成文件：.at 模块 parser
// 对单文件双 widget + widget 内 use store 解析失败（T-05 实测）。
use store: CanvasStore

widget CanvasProgFeed(msgs: []obj) {

    on {
        .Init -> {
            store.ProgInput(.msgs)
        }
    }

    view {
        col {
            style: "hidden"
        }
    }
}
