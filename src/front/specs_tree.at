// specs_tree.at — PLAN-041 T5:TreeView(wiki 文件树,递归)。

use.web treeRowClass from "src/front/specs_helpers.at"
use.web component ChevronRight, ChevronDown, Folder, FileText from "src/front/ports/icons.at"

widget TreeView(node: obj, active_path: str) {
    msg Msg {
        Select(Value),
        ToggleFolder,
    }
    model {
        var expanded bool = true
    }
    computed {
        isActive => .node.path == .active_path
        isFolder => .node.type == "folder"
        rowCls => treeRowClass(.isActive)
        children => .node.children ?? []
    }
    view {
        div {
            class: "tree-node"
            div {
                class: .rowCls
                onclick: .Select(.node)
                if .isFolder {
                    span {
                        class: "tree-chevron"
                        onclick: .ToggleFolder()
                        if .expanded {
                            ChevronDown {
                                size: 12
                            }
                        } else {
                            ChevronRight {
                                size: 12
                            }
                        }
                    }
                    Folder {
                        size: 13
                    }
                } else {
                    span {
                        class: "tree-chevron-spacer"
                    }
                    FileText {
                        size: 13
                    }
                }
                span {
                    class: "tree-name"
                    title: .node.name
                    text .node.name
                }
            }
            if .isFolder {
                if .expanded {
                    div {
                        class: "tree-children"
                        for child in .children {
                            TreeView {
                                key: child.path
                                node: child
                                active_path: .active_path
                            }
                        }
                    }
                }
            }
        }
    }
}
