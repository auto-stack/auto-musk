// plans_store.at — Plans 状态 store（对应 web/src/composables/usePlans.ts）
//
// 单例 store：plans/current/loading/error + LoadPlans/LoadPlan/CreatePlan/
// UpdatePlan/TransitionPlan/ArchivePlan/MergePlan。
// PLAN-024 任务6：Auto 轨 plans 数据层。

use back.api: plans_list, plans_get, plans_create, plans_update, plans_transition, plans_archive, plans_merge

// plans_front_slice(content)：frontmatter 剥离（store handler 域专用）。
// web 轨同义实现在 plans_frontmatter.ts——use.web fn 在 VM computed 静默
// 返空（视图坑 #1），故 VM 侧加载即拆、拍平进 store 标量。body=第二道
// --- 之后正文；step_label="cur/total"（total 缺省=空）。原语
// split/join/trim/starts_with 均有 questionnaire.at 先例。
fn plans_front_slice(content str) obj {
    var body = content
    var fm = ""
    if content.starts_with("---") {
        let lines = content.split("\n")
        var seen = 0
        // list.join 在 VM 链接期 Undefined symbol（实机 X9 实证）——手拼。
        var fm_acc = ""
        var body_acc = ""
        for l in lines {
            if l.trim() == "---" {
                seen = seen + 1
            } else {
                if seen < 2 {
                    fm_acc = fm_acc + l + "\n"
                } else {
                    body_acc = body_acc + l + "\n"
                }
            }
        }
        if seen >= 2 {
            fm = fm_acc
            body = body_acc.trim()
        }
    }
    var cur = ""
    var total = ""
    if fm != "" {
        for l in fm.split("\n") {
            if l.starts_with("current_step:") {
                cur = l.split(":")[1].trim()
            }
            if l.starts_with("total_steps:") {
                total = l.split(":")[1].trim()
            }
        }
    }
    var step_label = ""
    if total != "" {
        step_label = cur + "/" + total
    }
    return { body: body, step_label: step_label }
}

store PlansStore {
    model {
        // plan 列表（按 seq 升序）。
        var plans List<PlanFile> = []
        // 0923 用户裁定：已归档栏目——include_archived=true 同车拉回后
        // 分流（后端 PlansQuery 既有开关；archived/ 子目录判定）。
        var archived_plans List<PlanFile> = []
        // 计数烤进 handler 域标量（VM computed 内 .length 静默返空实锤
        // ——组头 `if count>0` 判空必须走它）。
        var archived_count int = 0
        // 当前选中的 plan（None = 未选中）。
        var current Option<PlanFile> = None
        var loading bool = false
        var error str = ""
        // 详情正文/步进标尺——LoadPlan/UpdatePlan 时 handler 域拆好
        // （视图坑 #1 处方；视图直读标量，Markdown 组件聊天轨已实证
        // autodown 渲染）。
        var current_body str = ""
        var current_step_label str = ""
        // PLAN-081：列表是否已拉取过——PlansView.Init 防双拉守卫用
        // （对齐 FilesView/file_loaded 先例：web 轨视图挂载 Init 与
        // App.ShowPlans 代派二选一）。
        var plans_loaded bool = false
    }

    msg Msg {
        Init,
        Reload,
        LoadPlans,
        LoadPlan(int),
        CreatePlan(str),
        UpdatePlan(int, str),
        TransitionPlan(int, str),
        ArchivePlan(int),
        MergePlan(int),
        SetError(str),
        // PLAN-083 T-04：列表加载异步化（Http.get_msg 消息桥回填段）。
        PlansLoaded(str),
    }

    on {
        // Init: 加载 plans 列表（PlansView 挂载时调用）。
        .Init -> {
            LoadPlans()
        }

        // PLAN-081: workspace 切换后的强刷——current 持旧 workspace 的
        // plan（LoadPlans 的"current 已有值即跳过"守卫会保住它 → 详情
        // 串台），先重置再重拉（current==None 自动选新列表首篇）。
        .Reload -> {
            .current = None;
            LoadPlans()
        }

        // LoadPlans: GET /api/plans 拉活跃 plan 列表。
        // PLAN-083 T-04：两段式——发起段置 loading + Http.get_msg 入队即
        // 返回（旧形同步 plans_list() 在 call_fn_by_name 忙等，Choose 链
        // 的第三段冻结源）；回填段 PlansLoaded。
        .LoadPlans -> {
            .loading = true;
            .error = "";
            // include_archived=true：归档栏数据同车拉回（PlansLoaded 分流）。
            Http.get_msg("/api/plans?include_archived=true", "PlansStore.PlansLoaded")
        }

        // PLAN-083 T-04：回填段——payload={ok,status,body}，
        // body={plans:[...]}。
        .PlansLoaded(payload str) -> {
            .loading = false;
            .plans_loaded = true;
            var resp = None;
            let r = JSON.parse(payload)
            if r != None {
                if r.ok == true {
                    resp = JSON.parse(r.body)
                }
            }
            if resp != None {
                if resp.plans != None {
                    // 归档分流：活跃表 + 已归档栏（archived 标志后端现算，
                    // archived/ 子目录判定）。
                    var act list = []
                    var arc list = []
                    for p in resp.plans {
                        if p.archived == true {
                            arc.push(p)
                        } else {
                            act.push(p)
                        }
                    }
                    .plans = act;
                    .archived_plans = arc;
                    .archived_count = arc.length
                } else {
                    .error = "plans_load_failed"
                }
            } else {
                .error = "plans_load_failed"
            }
            // PLAN-071 需求⑫：初始无选中时默认加载第一篇（与会话轨 Init
            // 自动选中首会话同口径）。Transition/Archive/Merge 后的列表
            // 刷新不抢当前选中（current 已有值即跳过）。
            if .current == None {
                if .plans.length > 0 {
                    LoadPlan(.plans[0].seq)
                }
            }
        }

        // LoadPlan(seq): GET /api/plans/{seq} 读单个 plan（plans.rs 搜到
        // archived/ 为止，归档行点击同链路）。
        .LoadPlan(seq) -> {
            .error = "";
            let plan = plans_get(seq);
            if plan != None {
                .current = plan;
                // 正文/步进标尺 handler 域拆分（视图坑 #1 处方）。
                let sl = plans_front_slice(plan.content);
                .current_body = sl.body;
                .current_step_label = sl.step_label
            }
        }

        // CreatePlan(feature_name): POST /api/plans 新建。
        .CreatePlan(feature_name) -> {
            .error = "";
            let plan = plans_create(feature_name, "");
            if plan != None {
                LoadPlans()
            }
        }

        // UpdatePlan(seq, content): PUT /api/plans/{seq} 更新正文。
        .UpdatePlan(seq, content) -> {
            .error = "";
            let plan = plans_update(seq, content);
            if plan != None {
                .current = plan;
                let sl = plans_front_slice(plan.content);
                .current_body = sl.body;
                .current_step_label = sl.step_label
            }
        }

        // TransitionPlan(seq, status): POST /api/plans/{seq}/transition。
        .TransitionPlan(seq, status) -> {
            .error = "";
            let plan = plans_transition(seq, status);
            if plan != None {
                .current = plan;
                LoadPlans()
            }
        }

        // ArchivePlan(seq): POST /api/plans/{seq}/archive。
        .ArchivePlan(seq) -> {
            .error = "";
            let plan = plans_archive(seq);
            if plan != None {
                .current = plan;
                LoadPlans()
            }
        }

        // MergePlan(seq): POST /api/plans/{seq}/merge 沉淀到 Spec。
        .MergePlan(seq) -> {
            .error = "";
            let result = plans_merge(seq);
            if result != None {
                LoadPlans()
            }
        }

        .SetError(msg) -> { .error = msg }
    }
}
