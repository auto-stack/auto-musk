// gate_card.at — GateCard 组件（Plan 023 队列 B2：emit + lifecycle 逃生舱原生化）
//
// 对标 src/front/components/GateCard.vue（逃生舱，已删除）。
// 验证 emit 带负载（approve + editedSpecs → 父组件 onapprove）+ watch（changes
// 初始化 editedSpecs）+ §10.7。
//
// 关键转换：
//   - expandedDiffs Set<string> → model obj（expanded[sid]，.at 无 Set）
//   - editedSpecs 动态键记录 → 受控 textarea（value: + oninput(.sid, $event)，
//     动态键 v-model 缺口同 B1）
//   - watch changes → .editedSpecs = gateInitEditedSpecs(...)（helper 合并缺失键）
//   - title/profession 可选 props（.at 无可选 props）→ 必填声明 + chats_view
//     传 "" + titleText 兜底 computed
//   - approveBtnRef 自动聚焦（template ref）→ 舍弃（登记轻微差异）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.gate-card 等）。

component fn GateCard(title: str, profession: str, changes: obj) {
    use {
        component: Check, X, Eye, ChevronDown, ChevronUp from "lucide-vue-next"
        fn: gate_toggle_expanded, gate_with_expanded, gate_init_edited_specs, gate_title_text from "src/front/gate_helpers.at"
        fn: eventInputValue from "src/front/questionnaire_helpers.at"
    }
    computed {
        titleText => gate_title_text(.title)
        hasChanges => .changes != None && .changes.length > 0
        reviewLabel => if .isReviewing { "Hide" } else { "Review" }
        diffList => gate_with_expanded(.changes, .expanded)
    }
    msg Msg { ToggleDiff, ToggleReview, EditedChanged, approve, reject }
    model {
        var expanded obj = {}
        var editedSpecs obj = {}
        var isReviewing bool = false
    }
    watch {
        .changes -> { .editedSpecs = gate_init_edited_specs(.changes, .editedSpecs) }
    }
    on {
        .Init -> { .editedSpecs = gate_init_edited_specs(.changes, .editedSpecs) }
        .ToggleDiff(sid) -> { .expanded[sid] = gate_toggle_expanded(.expanded, sid) }
        .ToggleReview -> { .isReviewing = !.isReviewing }
        .EditedChanged(sid, e) -> { .editedSpecs[sid] = eventInputValue(e) }
        .approve(specs) -> {}
        .reject -> {}
    }
    // Plan 029 T22：原 inject_styles 全局兜底下放（scoped 生效于本组件 DOM）。
    style {
  .gate-card {
    display: flex; flex-direction: column; gap: 0.6rem;
    padding: 0.75rem 1.25rem; border-top: 1px solid var(--af-border, hsl(220 13% 91%));
    flex-shrink: 0; background: hsl(220 14% 50% / 0.02);
  }
  .gate-card-header { display: flex; align-items: center; gap: 0.5rem; font-size: 0.93rem; color: var(--af-fg, hsl(220 14% 10%)); }
  .gate-icon { font-size: 1.18rem; }
  .gate-title { flex: 1; }
  .gate-profession {
    font-size: 0.78rem; padding: 0.15rem 0.4rem; border-radius: 4px;
    background: hsl(220 90% 56% / 0.08); color: hsl(220 90% 56%); font-weight: 500;
  }
  .gate-diff-list { display: flex; flex-direction: column; gap: 0.35rem; max-height: 300px; overflow-y: auto; }
  .diff-card { border: 1px solid var(--af-border, hsl(220 13% 91%)); border-radius: 8px; overflow: hidden; }
  .diff-header {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.4rem 0.6rem; cursor: pointer; user-select: none;
  }
  .diff-header:hover { background: hsl(220 14% 50% / 0.03); }
  .diff-title { font-size: 0.88rem; font-weight: 500; color: var(--af-fg, hsl(220 14% 10%)); text-transform: capitalize; flex: 1; }
  .diff-status { font-size: 0.73rem; font-weight: 500; color: hsl(38 92% 50%); }
  .diff-status.approved { color: hsl(142 71% 45%); }
  .diff-chevron { color: var(--af-muted, hsl(220 9% 46%)); }
  .diff-body {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;
    padding: 0.5rem 0.6rem; background: hsl(220 14% 50% / 0.02); border-top: 1px solid var(--af-border, hsl(220 13% 91%));
  }
  .diff-side { display: flex; flex-direction: column; gap: 0.2rem; }
  .diff-label { font-size: 0.73rem; font-weight: 500; text-transform: uppercase; color: var(--af-muted, hsl(220 9% 46%)); letter-spacing: 0.02em; }
  .diff-content {
    font-size: 0.83rem; font-family: 'JetBrains Mono', 'Fira Code', monospace;
    background: var(--af-bg, #fff); border: 1px solid var(--af-border, hsl(220 13% 91%));
    border-radius: 4px; padding: 0.35rem; overflow-x: auto;
    white-space: pre-wrap; word-break: break-word;
    color: var(--af-fg, hsl(220 14% 10%)); margin: 0;
  }
  .diff-content.old { color: var(--af-muted, hsl(220 9% 46%)); }
  .diff-editor {
    font-size: 0.83rem; font-family: 'JetBrains Mono', 'Fira Code', monospace;
    background: var(--af-bg, #fff); border: 1px solid var(--af-border, hsl(220 13% 91%));
    border-radius: 4px; padding: 0.35rem; color: var(--af-fg, hsl(220 14% 10%));
    resize: vertical; outline: none; width: 100%; box-sizing: border-box;
  }
  .diff-editor:focus { border-color: hsl(220 90% 56% / 0.4); }
  .gate-actions { display: flex; gap: 0.5rem; }
  .approve-btn, .reject-btn, .review-btn {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.4rem 0.9rem; border: none; border-radius: 6px;
    font-size: 0.88rem; font-weight: 500; cursor: pointer; transition: opacity 0.15s;
  }
  .approve-btn { background: hsl(142 71% 45%); color: #fff; }
  .reject-btn { background: transparent; color: var(--af-fg, hsl(220 14% 10%)); border: 1px solid var(--af-border, hsl(220 13% 91%)); }
  .review-btn { background: hsl(220 14% 50% / 0.08); color: var(--af-fg, hsl(220 14% 10%)); border: 1px solid var(--af-border, hsl(220 13% 91%)); }
  .approve-btn:hover, .reject-btn:hover, .review-btn:hover { opacity: 0.85; }
    }

    div {
        style: "gate-card"
        div {
            style: "gate-card-header"
            span { style: "gate-icon", text "🔒" }
            span { style: "gate-title", text .titleText }
            if .profession != "" {
                span { style: "gate-profession", text .profession }
            }
        }
        if .hasChanges {
            div {
                style: "gate-diff-list"
                for change in .diffList {
                    div {
                        key: .change.section_id
                        style: "diff-card"
                        div {
                            onclick: .ToggleDiff(.change.section_id)
                            style: "diff-header"
                            span { style: "diff-title", text .change.section_id }
                            span {
                                class: if .change.new_status == "approved" { "diff-status approved" } else { "diff-status" }
                                text .change.old_status
                                text " → "
                                text .change.new_status
                            }
                            if .change._expanded {
                                ChevronUp { size: 14, class: "diff-chevron" }
                            } else {
                                ChevronDown { size: 14, class: "diff-chevron" }
                            }
                        }
                        if .change._expanded {
                            div {
                                style: "diff-body"
                                div {
                                    style: "diff-side"
                                    div { style: "diff-label", text "Before" }
                                    pre { style: "diff-content old", text .change.old_content }
                                }
                                div {
                                    style: "diff-side"
                                    div { style: "diff-label", text "After" }
                                    textarea {
                                        rows: "6"
                                        style: "diff-editor"
                                        value: .editedSpecs[change.section_id]
                                        oninput: .EditedChanged(.change.section_id, $event)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        div {
            style: "gate-actions"
            button {
                onclick: .approve(.editedSpecs)
                style: "approve-btn"
                Check { size: 14 }
                text "Approve & Execute"
            }
            button {
                onclick: .reject
                style: "reject-btn"
                X { size: 14 }
                text "Reject & Redraft"
            }
            button {
                onclick: .ToggleReview
                style: "review-btn"
                Eye { size: 14 }
                text .reviewLabel
            }
        }
    }
}
