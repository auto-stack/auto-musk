// gate_card.at — GateCard 组件（Plan 023 队列 B2：emit + lifecycle 逃生舱原生化）
//
// 对标 src/front/components/GateCard.vue（逃生舱，已删除）。
// 验证 emit 带负载（approve + editedSpecs → 父组件 onapprove）+ watch（changes
// 初始化 editedSpecs）+ §10.7。
//
// 关键转换：
//   - expandedDiffs Set<string> → model obj（expanded[sid]，.at 无 Set）
//   - editedSpecs 动态键记录 → 受控 textarea（value: + oninput(.sid, $event)，
//     动态键 v-model 缺口同 B1）
//   - watch changes → .editedSpecs = gateInitEditedSpecs(...)（helper 合并缺失键）
//   - title/profession 可选 props（.at 无可选 props）→ 必填声明 + chats_view
//     传 "" + titleText 兜底 computed
//   - approveBtnRef 自动聚焦（template ref）→ 舍弃（登记轻微差异）
//
// 样式：PLAN-049 T6 双轨收敛——原 style{} 块（.gate-card/.diff-* 系）全量迁
// 内联工具类（代表验收点）。色裁定：旧字面 hsl(220 90% 56%)≈blue-500、
// hsl(38 92% 50%)=amber-500、hsl(142 71% 45%)=green-500 逐一对齐 tailwind
// token;2%-alpha 底纹（gate-card/diff-body）视觉近零,删除并登记;
// hover/focus 增强走变体（VM 白名单丢弃）;uppercase/capitalize/resize 等
// iced 无对应属性为 web-only 增强。VM 侧 diff-body grid 降级单行（Plan 412）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component Check, X, Eye, ChevronDown, ChevronUp from "src/front/ports/icons.at"
use.web gate_toggle_expanded, gate_with_expanded, gate_init_edited_specs, gate_title_text from "src/front/gate_helpers.at"
use.web eventInputValue from "src/front/questionnaire_helpers.at"

widget GateCard(title: str, profession: str, changes: obj) {
    computed {
        titleText => gate_title_text(.title)
        hasChanges => .changes != None && .changes.length > 0
        reviewLabel => if .isReviewing { "Hide" } else { "Review" }
        diffList => gate_with_expanded(.changes, .expanded)
    }
    msg Msg { ToggleDiff, ToggleReview, EditedChanged, approve, reject }
    model {
        var expanded obj = {}
        var editedSpecs obj = {}
        var isReviewing bool = false
    }
    watch {
        .changes -> { .editedSpecs = gate_init_edited_specs(.changes, .editedSpecs) }
    }
    on {
        .Init -> { .editedSpecs = gate_init_edited_specs(.changes, .editedSpecs) }
        .ToggleDiff(sid) -> { .expanded[sid] = gate_toggle_expanded(.expanded, sid) }
        .ToggleReview -> { .isReviewing = !.isReviewing }
        .EditedChanged(sid, e) -> { .editedSpecs[sid] = eventInputValue(e) }
        .approve(specs) -> {}
        .reject -> {}
    }
    view {
        div {
            style: "flex flex-col gap-[10px] px-5 py-3 border-t border-border shrink-0"
            div {
                style: "flex items-center gap-2 text-[15px] text-foreground"
                span { style: "text-[19px]", text "🔒" }
                span { style: "flex-1", text .titleText }
                if .profession != "" {
                    span { style: "text-xs py-0.5 px-1.5 rounded bg-blue-500/10 text-blue-500 font-medium", text .profession }
                }
            }
            if .hasChanges {
                div {
                    style: "flex flex-col gap-1.5 max-h-[300px] overflow-y-auto"
                    for change in .diffList {
                        div {
                            key: .change.section_id
                            style: "border border-border rounded-lg overflow-hidden"
                            div {
                                onclick: .ToggleDiff(.change.section_id)
                                style: "flex items-center gap-2 py-1.5 px-2.5 cursor-pointer select-none hover:bg-accent"
                                span { style: "text-sm font-medium text-foreground flex-1 capitalize", text .change.section_id }
                                span {
                                    class: if .change.new_status == "approved" { "text-xs font-medium text-green-500" } else { "text-xs font-medium text-amber-500" }
                                    text .change.old_status
                                    text " → "
                                    text .change.new_status
                                }
                                if .change._expanded {
                                    ChevronUp { size: 14, class: "text-muted-foreground" }
                                } else {
                                    ChevronDown { size: 14, class: "text-muted-foreground" }
                                }
                            }
                            if .change._expanded {
                                div {
                                    style: "grid grid-cols-2 gap-2 py-2 px-2.5 border-t border-border"
                                    div {
                                        style: "flex flex-col gap-[3px]"
                                        div { style: "text-xs font-medium uppercase text-muted-foreground", text "Before" }
                                        pre { style: "text-[13px] font-mono bg-background border border-border rounded p-1.5 overflow-x-auto whitespace-pre-wrap break-words text-muted-foreground", text .change.old_content }
                                    }
                                    div {
                                        style: "flex flex-col gap-[3px]"
                                        div { style: "text-xs font-medium uppercase text-muted-foreground", text "After" }
                                        textarea {
                                            rows: "6"
                                            style: "text-[13px] font-mono bg-background border border-border rounded p-1.5 text-foreground w-full outline-none resize-y focus:border-blue-500/40"
                                            value: .editedSpecs[change.section_id]
                                            oninput: .EditedChanged(.change.section_id, $event)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            div {
                style: "flex gap-2"
                button {
                    onclick: .approve(.editedSpecs)
                    style: "inline-flex items-center gap-1.5 py-1.5 px-3.5 rounded-md text-sm font-medium bg-green-500 text-white hover:opacity-85"
                    Check { size: 14 }
                    text "Approve & Execute"
                }
                button {
                    onclick: .reject
                    style: "inline-flex items-center gap-1.5 py-1.5 px-3.5 rounded-md text-sm font-medium bg-transparent text-foreground border border-border hover:opacity-85"
                    X { size: 14 }
                    text "Reject & Redraft"
                }
                button {
                    onclick: .ToggleReview
                    style: "inline-flex items-center gap-1.5 py-1.5 px-3.5 rounded-md text-sm font-medium bg-muted text-foreground border border-border hover:opacity-85"
                    Eye { size: 14 }
                    text .reviewLabel
                }
            }
        }
    }
}
