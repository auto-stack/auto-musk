// login.at — 登录/注册页（对应 web/src/views/LoginView.vue）
//
// LoginView.vue 核心：表单(username/password) + 登录/注册切换 + error 显示。
// 206 行(含 scoped CSS)。
//
// Plan 022 Phase 4 设计：纯 store 驱动（Elm 架构）——LoginPage 只调
// store.Login/store.Register，store.authenticated 变化自动驱动 App.vue 的
// auth guard v-if 切换。不需要 auth-success 事件回调（比原生更简洁）。

use store: AuthStore
// PLAN-045-E4/446-E4: 登录/注册成功后重注入 VM 默认认证头(web adapter
// no-op——web 拦截器逐请求读 localStorage,时序无关)。
use.web platformRefreshAuth from "src/front/ports/platform.at"

widget LoginPage {
    msg Msg {
        Init,
        Submit,
        ToggleMode,
        UsernameChanged,
        PasswordChanged,
    }

    model {
        var username str = ""
        var password str = ""
        var register_mode bool = false
        // 上次登录凭据预填一次性守卫：VM 轨子 widget Init 每渲染帧重放
        // (auto-lang Plan 437 v1 近似)，布尔守卫保证只预填一次；web 轨
        // onMounted 只跑一次，守卫无害。
        var prefilled bool = false
    }

    view {
        col {
            style: "min-h-screen items-center justify-center bg-background"
            col {
                style: "w-full max-w-sm p-8 bg-card border border-border rounded-xl shadow-lg gap-6"
                // 品牌
                row {
                    style: "items-center gap-3 mb-2"
                    text "🔥" { style: "text-2xl" }
                    h1 "AutoForge" { style: "text-2xl font-bold text-foreground" }
                }
                // 表单
                col {
                    style: "gap-4"
                    col {
                        style: "gap-1"
                        label "Username" { style: "text-sm font-medium text-muted-foreground" }
                        input {
                            value: .username
                            oninput: .UsernameChanged
                            placeholder: "Enter username"
                            style: "px-2.5 py-2 border border-border rounded-md bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring"
                        }
                    }
                    col {
                        style: "gap-1"
                        label "Password" { style: "text-sm font-medium text-muted-foreground" }
                        input {
                            value: .password
                            oninput: .PasswordChanged
                            password: true
                            placeholder: "Enter password"
                            style: "px-2.5 py-2 border border-border rounded-md bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring"
                        }
                    }
                    // 错误显示
                    if store.error != "" {
                        text store.error { style: "px-3 py-2 rounded-md bg-destructive/10 text-destructive text-sm" }
                    }
                    // 提交按钮（loading 时禁用，文本随模式切换）。
                    // variant: "submit" = form 提交钮语义：视图内任意 input
                    // 按 Enter 都触发本按钮的 onclick（此前 password 独享
                    // onenter,username 回车无响应）。
                    button {
                        onclick: .Submit
                        variant: "submit"
                        style: "py-2.5 px-4 rounded-md bg-primary text-primary-foreground text-sm font-semibold hover:opacity-90 transition-opacity"
                        if store.loading {
                            text "Loading..."
                        } else if .register_mode {
                            text "Register"
                        } else {
                            text "Login"
                        }
                    }
                }
                // 切换 登录/注册 模式
                col {
                    style: "mt-1 text-center"
                    button {
                        onclick: .ToggleMode
                        style: "bg-transparent border-none text-primary text-sm underline cursor-pointer hover:opacity-80"
                        if .register_mode {
                            text "Already have an account?"
                        } else {
                            text "No account? Register"
                        }
                    }
                }
            }
        }
    }

    on {
        // Init（Plan 437 后子 widget Init 在 VM 轨也派发）：预填上次登录
        // 的用户名/密码（AuthStore Login/Register 成功时写入），免重复输入。
        .Init -> {
            if .prefilled != true {
                .prefilled = true
                .username = localStorage.getItem("musk_login_username") ?? ""
                .password = localStorage.getItem("musk_login_password") ?? ""
            }
        }

        // v-model 语义 marker handler（U5）。
        .UsernameChanged -> { .username = .username }
        .PasswordChanged -> { .password = .password }

        // ToggleMode: 切换登录/注册，清空 error。
        .ToggleMode -> {
            .register_mode = !.register_mode
            AuthStore.SetError("")
        }

        // Submit: 根据 register_mode 调 store.Login 或 store.Register。
        // 成功后 store.authenticated 自动变 true → App.vue 的 v-if 切换（无需回调）。
        .Submit -> {
            if .register_mode {
                AuthStore.Register(.username, .password)
            } else {
                store.Login(.username, .password)
            }
            // PLAN-048:VM 轨登录态变化无视图重挂载信号(web 由 guard 切换
            // 驱动 ChatsView onMounted)——登录后显式拉一次会话列表。
            ForgeStore.LoadSessionList()
            platformRefreshAuth()
        }
    }
}
