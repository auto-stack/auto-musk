// wiki_view.at — Wiki 知识库视图（对应 web/src/views/WikiView.vue）
//
// WikiView.vue 865 行：wiki-nav(pages tree + raw tree + 搜索) + 主内容区
// (page 渲染/编辑)。Phase 6a: 骨架——pages 列表 + 当前 page 渲染 + 创建。

use store: WikiStore

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web ensure_workspace from "src/front/workspace_helpers.at"
use.web uploadRawFiles, loadRawFileText, wikiUploadDrop, rawUploadProgress from "src/front/ports/upload.at"
use.web raw_file_url from "src/front/raw_helpers.at"
use.web useT from "src/front/ports/composables.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use wiki_nav: WikiNav
use raw_preview: RawPreview
use content_header: ContentHeader

widget WikiView {

    setup {
        let t = useT()
    }

    msg Msg {
        Init,
        SelectPage(str),
        StartCreate,
        CreatePage,
        CancelCreate,
        EditPage,
        SavePage,
        DeletePage(str),
        SlugChanged,
        TitleChanged,
        ContentChanged,
        SelectRawNode(str),
        HandleRawUploaded,
        DeleteRawFile(str),
        StartNewFolder,
        FolderPathChanged,
        CreateFolder,
        CancelNewFolder,
        ClearRaw,
    }

    model {
        var active_slug str = ""
        var creating bool = false
        var editing bool = false
        var new_slug str = ""
        var new_title str = ""
        var new_content str = ""
        var nav_collapsed bool = false
        // raw 交互状态（Plan 022 遗留：DropZone 完整闭环）。
        var viewing_raw bool = false
        var creating_folder bool = false
        var new_folder_path str = ""
    }

    view {
        row {
            style: "flex flex-row h-full overflow-hidden"
            // WikiNav 组件（双树 + 搜索 + 图标 + DropZone 上传，对齐原版）
            WikiNav {
                wikiTree: .store.tree
                rawTree: .store.raw_tree
                activeWikiPath: .active_slug
                activeRawPath: .store.active_raw_path
                workspace: .store.workspace
                onNewPage: .StartCreate
                onSelectWiki: .SelectPage($event)
                onSelectRaw: .SelectRawNode($event)
                onDeleteRaw: .DeleteRawFile($event)
                onNewFolder: .StartNewFolder
                onUploaded: .HandleRawUploaded
            }
            // 主内容区
            col {
                style: "flex-1 overflow-y-auto flex flex-col"
                if .creating {
                    // 创建新页面表单
                    col {
                        style: "p-4 border border-border rounded-lg bg-card mb-4"
                        h2 "New Page" { style: "text-xl font-bold mb-4" }
                        col {
                            style: "flex flex-col gap-[5px] mb-3"
                            label "Slug"
                            input {
                                value: .new_slug
                                oninput: .SlugChanged
                                placeholder: t("wiki.slugPlaceholder")
                                style: "py-2 px-2.5 border border-border rounded-md bg-background text-foreground text-sm"
                            }
                        }
                        col {
                            style: "flex flex-col gap-[5px] mb-3"
                            label "Title"
                            input {
                                value: .new_title
                                oninput: .TitleChanged
                                placeholder: t("wiki.titlePlaceholder")
                                style: "py-2 px-2.5 border border-border rounded-md bg-background text-foreground text-sm"
                            }
                        }
                        col {
                            style: "flex flex-col gap-[5px] mb-3"
                            label "Content (Markdown)"
                            textarea {
                                value: .new_content
                                oninput: .ContentChanged
                                placeholder: t("wiki.contentPlaceholder")
                                style: "py-2 px-2.5 border border-border rounded-md bg-background text-foreground text-sm min-h-[120px] font-mono resize-y"
                            }
                        }
                        row {
                            style: "flex gap-2 justify-end"
                            button {
                                onclick: .CreatePage
                                style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-primary hover:text-primary-foreground hover:border-primary"
                                text t("wiki.create")
                            }
                            button {
                                onclick: .CancelCreate
                                style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-accent"
                                text t("common.cancel")
                            }
                        }
                    }
                } else if .editing {
                    // 编辑现有页面
                    col {
                        style: "p-4 border border-border rounded-lg bg-card mb-4"
                        h2 "Edit Page" { style: "text-xl font-bold mb-4" }
                        textarea {
                            value: .new_content
                            oninput: .ContentChanged
                            style: "py-2 px-2.5 border border-border rounded-md bg-background text-foreground text-sm min-h-[120px] font-mono resize-y"
                        }
                        row {
                            style: "flex gap-2 justify-end"
                            button {
                                onclick: .SavePage
                                style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-primary hover:text-primary-foreground hover:border-primary"
                                text t("common.save")
                            }
                            button {
                                onclick: .EditPage
                                style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-accent"
                                text t("common.cancel")
                            }
                        }
                    }
                } else if .creating_folder {
                    // 新建文件夹表单（对齐原版 WikiView.vue:190-205 new-folder 分支）
                    col {
                        style: "p-4 border border-border rounded-lg bg-card mb-4"
                        col {
                            style: "flex flex-col gap-[5px] mb-3"
                            label "Folder Path"
                            input {
                                value: .new_folder_path
                                oninput: .FolderPathChanged
                                placeholder: "datasheets/stm32"
                                style: "py-2 px-2.5 border border-border rounded-md bg-background text-foreground text-sm"
                            }
                        }
                        row {
                            style: "flex gap-2 justify-end"
                            button {
                                onclick: .CreateFolder
                                style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-primary hover:text-primary-foreground hover:border-primary"
                                text t("common.create")
                            }
                            button {
                                onclick: .CancelNewFolder
                                style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-accent"
                                text t("common.cancel")
                            }
                        }
                    }
                } else if .viewing_raw && .store.active_raw_path != "" {
                    // raw 文件预览（对齐原版 viewing-raw 分支：img/pdf/文本/下载）
                    // Plan 023 §3.1：ContentHeader 贴顶全宽（wiki-main 无 padding），
                    // 内容容器 wiki-raw 单独 padding。
                    ContentHeader {
                        title: .store.active_raw_path
                        slot(name: "actions") {
                            div {
                                style: "flex gap-1"
                                button {
                                    onclick: .DeleteRawFile(.store.active_raw_path)
                                    style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border text-destructive hover:bg-destructive/10"
                                    text t("common.delete")
                                }
                                button {
                                    onclick: .ClearRaw
                                    style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border"
                                    text t("common.cancel")
                                }
                            }
                        }
                    }
                    col {
                        style: "px-5 pb-5"
                        RawPreview {
                            workspace: .store.workspace
                            path: .store.active_raw_path
                        }
                    }
                } else if .store.current_page != None {
                    // 渲染当前 page（markdown 内容）
                    // Plan 023 §3.1：ContentHeader 贴顶全宽，内容容器 wiki-content 单独 padding。
                    ContentHeader {
                        title: .store.current_page.title
                        slot(name: "actions") {
                            div {
                                style: "flex gap-1"
                                button {
                                    onclick: .EditPage
                                    style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border"
                                    text t("wiki.edit")
                                }
                                button {
                                    onclick: .DeletePage(.active_slug)
                                    style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border text-destructive hover:bg-destructive/10"
                                    text t("wiki.delete")
                                }
                            }
                        }
                    }
                    col {
                        style: "px-5 pb-5 text-sm leading-[1.6] text-foreground"
                        // markdown 渲染（Phase 3 内置 tag）
                        markdown {
                            content: .store.current_page.content
                            style: "text-sm leading-[1.6]"
                        }
                    }
                } else {
                    col {
                        style: "flex-1 flex flex-col items-center justify-center text-muted-foreground gap-2 text-center"
                        text t("wiki.selectPage") { style: "text-muted-foreground" }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            ensure_workspace();
            WikiStore.Init()
        }

        .SelectPage(slug) -> {
            .active_slug = slug;
            .creating = false;
            .editing = false;
            .viewing_raw = false;
            .creating_folder = false;
            store.LoadPage(slug)
        }

        .StartCreate -> {
            .creating = true;
            .editing = false;
            .viewing_raw = false;
            .creating_folder = false;
            .new_slug = "";
            .new_title = "";
            .new_content = ""
        }

        .CreatePage -> {
            if .new_slug != "" {
                store.CreatePage(.new_slug, .new_title, .new_content);
                .creating = false
            }
        }

        .CancelCreate -> { .creating = false }

        .EditPage -> {
            if .store.current_page != None {
                .editing = true;
                .new_content = .store.current_page.content
            }
        }

        .SavePage -> {
            if .active_slug != "" {
                store.UpdatePage(.active_slug, .new_content);
                .editing = false
            }
        }        .DeletePage(slug) -> {
            store.DeletePage(slug);
            .active_slug = ""
        }

        // ─── raw 交互（Plan 022 遗留：DropZone 完整闭环）───
        // SelectRawNode(path): 点击 raw 文件 → 记录选中 + 进入预览态。
        // 对齐原版 WikiView.vue:364-374 selectRawNode（type!=='file' return；
        // 文本内容读取在 RawPreview 逃生舱内做）。
        .SelectRawNode(path) -> {
            .creating = false;
            .editing = false;
            .creating_folder = false;
            .viewing_raw = true;
            store.SelectRawFile(path)
        }

        // HandleRawUploaded: WikiNav DropZone 上传成功 → 刷新 raw tree。
        .HandleRawUploaded -> {
            store.UploadRawFiles()
        }

        // DeleteRawFile(path): 删除 raw 文件 → 退出预览态。
        .DeleteRawFile(path) -> {
            store.DeleteRawFile(path);
            .viewing_raw = false
        }

        // StartNewFolder: 显示新建文件夹表单。
        .StartNewFolder -> {
            .creating = false;
            .editing = false;
            .viewing_raw = false;
            .creating_folder = true;
            .new_folder_path = ""
        }

        .FolderPathChanged -> { .new_folder_path = .new_folder_path }

        // CreateFolder: 创建文件夹 → 刷新 tree + 退出表单。
        .CreateFolder -> {
            if .new_folder_path != "" {
                store.CreateRawFolder(.new_folder_path);
                .creating_folder = false;
                .new_folder_path = ""
            }
        }

        .CancelNewFolder -> { .creating_folder = false }

        // ClearRaw: 退出 raw 预览。
        .ClearRaw -> {
            .viewing_raw = false;
            store.SelectRawFile("")
        }

        // v-model marker handlers（U5）。
        .SlugChanged -> { .new_slug = .new_slug }
        .TitleChanged -> { .new_title = .new_title }
        .ContentChanged -> { .new_content = .new_content }
    }
}
