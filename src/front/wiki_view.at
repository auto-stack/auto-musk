// wiki_view.at — Wiki 知识库视图（对应 web/src/views/WikiView.vue）
//
// WikiView.vue 865 行：wiki-nav(pages tree + raw tree + 搜索) + 主内容区
// (page 渲染/编辑)。Phase 6a: 骨架——pages 列表 + 当前 page 渲染 + 创建。

use store: WikiStore

widget WikiView {
    use {
        fn: ensureWorkspace from "src/front/ensure_workspace.ts"
        // raw_upload 是 WikiNav component fn 的 use{fn} 依赖（上传 + 进度共享 ref），
        // 声明仅为触发 ext 复制（codegen ext 复制只看 use 块，不看 component fn 的 use{fn}）。
        fn: uploadRawFiles, rawFileUrl, loadRawFileText, rawFileKind, wikiUploadDrop, rawUploadProgress from "src/front/raw_upload.ts"
        // wiki_helpers 是 WikiNav component fn 的 use{fn} 依赖，声明仅为触发 ext 复制。
        fn: wikiFilterTree from "src/front/wiki_helpers.ts"
        composable: useT from "src/front/composables/useT.ts"
        // Plan 023 队列 B6：WikiNav 已原生化为 component fn（src/front/wiki_nav.at），
        // 逃生舱 .vue 已删除（DropZone 拖拽上传 + 双树 + 搜索）。
        component: WikiNav
        // Plan 023 队列 A1：RawPreview 已原生化为 component fn（src/front/raw_preview.at），
        // 逃生舱 .vue 已删除。跨文件引用（无 from）。
        component: RawPreview
        // Plan 023 §3.1：共用 ContentHeader（内容标题栏收敛）。
        component: ContentHeader
    }

    msg Msg {
        Init,
        SelectPage(str),
        StartCreate,
        CreatePage,
        CancelCreate,
        EditPage,
        SavePage,
        DeletePage(str),
        SlugChanged,
        TitleChanged,
        ContentChanged,
        SelectRawNode(str),
        HandleRawUploaded,
        DeleteRawFile(str),
        StartNewFolder,
        FolderPathChanged,
        CreateFolder,
        CancelNewFolder,
        ClearRaw,
    }

    model {
        var active_slug str = ""
        var creating bool = false
        var editing bool = false
        var new_slug str = ""
        var new_title str = ""
        var new_content str = ""
        var nav_collapsed bool = false
        // raw 交互状态（Plan 022 遗留：DropZone 完整闭环）。
        var viewing_raw bool = false
        var creating_folder bool = false
        var new_folder_path str = ""
    }

    view {
        row {
            style: "wiki-view"
            // WikiNav 组件（双树 + 搜索 + 图标 + DropZone 上传，对齐原版）
            WikiNav {
                wikiTree: .store.tree
                rawTree: .store.raw_tree
                activeWikiPath: .active_slug
                activeRawPath: .store.active_raw_path
                workspace: .store.workspace
                onNewPage: .StartCreate
                onSelectWiki: .SelectPage($event)
                onSelectRaw: .SelectRawNode($event)
                onDeleteRaw: .DeleteRawFile($event)
                onNewFolder: .StartNewFolder
                onUploaded: .HandleRawUploaded
            }
            // 主内容区
            col {
                style: "wiki-main"
                if .creating {
                    // 创建新页面表单
                    col {
                        style: "wiki-editor"
                        h2 "New Page" { style: "text-xl font-bold mb-4" }
                        col {
                            style: "form-group"
                            label "Slug"
                            input {
                                value: .new_slug
                                oninput: .SlugChanged
                                placeholder: t("wiki.slugPlaceholder")
                                style: "form-input"
                            }
                        }
                        col {
                            style: "form-group"
                            label "Title"
                            input {
                                value: .new_title
                                oninput: .TitleChanged
                                placeholder: t("wiki.titlePlaceholder")
                                style: "form-input"
                            }
                        }
                        col {
                            style: "form-group"
                            label "Content (Markdown)"
                            textarea {
                                value: .new_content
                                oninput: .ContentChanged
                                placeholder: t("wiki.contentPlaceholder")
                                style: "form-input content-input"
                            }
                        }
                        row {
                            style: "edit-actions"
                            button {
                                onclick: .CreatePage
                                style: "save-btn"
                                text t("wiki.create")
                            }
                            button {
                                onclick: .CancelCreate
                                style: "cancel-btn"
                                text t("common.cancel")
                            }
                        }
                    }
                } else if .editing {
                    // 编辑现有页面
                    col {
                        style: "wiki-editor"
                        h2 "Edit Page" { style: "text-xl font-bold mb-4" }
                        textarea {
                            value: .new_content
                            oninput: .ContentChanged
                            style: "form-input content-input"
                        }
                        row {
                            style: "edit-actions"
                            button {
                                onclick: .SavePage
                                style: "save-btn"
                                text t("common.save")
                            }
                            button {
                                onclick: .EditPage
                                style: "cancel-btn"
                                text t("common.cancel")
                            }
                        }
                    }
                } else if .creating_folder {
                    // 新建文件夹表单（对齐原版 WikiView.vue:190-205 new-folder 分支）
                    col {
                        style: "wiki-editor"
                        col {
                            style: "form-group"
                            label "Folder Path"
                            input {
                                value: .new_folder_path
                                oninput: .FolderPathChanged
                                placeholder: "datasheets/stm32"
                                style: "form-input"
                            }
                        }
                        row {
                            style: "edit-actions"
                            button {
                                onclick: .CreateFolder
                                style: "save-btn"
                                text t("common.create")
                            }
                            button {
                                onclick: .CancelNewFolder
                                style: "cancel-btn"
                                text t("common.cancel")
                            }
                        }
                    }
                } else if .viewing_raw && .store.active_raw_path != "" {
                    // raw 文件预览（对齐原版 viewing-raw 分支：img/pdf/文本/下载）
                    // Plan 023 §3.1：ContentHeader 贴顶全宽（wiki-main 无 padding），
                    // 内容容器 wiki-raw 单独 padding。
                    ContentHeader {
                        title: .store.active_raw_path
                        slot(name: "actions") {
                            div {
                                style: "wiki-content-actions"
                                button {
                                    onclick: .DeleteRawFile(.store.active_raw_path)
                                    style: "action-btn danger"
                                    text t("common.delete")
                                }
                                button {
                                    onclick: .ClearRaw
                                    style: "action-btn"
                                    text t("common.cancel")
                                }
                            }
                        }
                    }
                    col {
                        style: "wiki-raw"
                        RawPreview {
                            workspace: .store.workspace
                            path: .store.active_raw_path
                        }
                    }
                } else if .store.current_page != None {
                    // 渲染当前 page（markdown 内容）
                    // Plan 023 §3.1：ContentHeader 贴顶全宽，内容容器 wiki-content 单独 padding。
                    ContentHeader {
                        title: .store.current_page.title
                        slot(name: "actions") {
                            div {
                                style: "wiki-content-actions"
                                button {
                                    onclick: .EditPage
                                    style: "action-btn"
                                    text t("wiki.edit")
                                }
                                button {
                                    onclick: .DeletePage(.active_slug)
                                    style: "action-btn danger"
                                    text t("wiki.delete")
                                }
                            }
                        }
                    }
                    col {
                        style: "wiki-content"
                        // markdown 渲染（Phase 3 内置 tag）
                        markdown {
                            content: .store.current_page.content
                            style: "wiki-markdown"
                        }
                    }
                } else {
                    col {
                        style: "wiki-empty"
                        text t("wiki.selectPage") { style: "text-muted" }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            ensureWorkspace();
            store.Init()
        }

        .SelectPage(slug) -> {
            .active_slug = slug;
            .creating = false;
            .editing = false;
            .viewing_raw = false;
            .creating_folder = false;
            store.LoadPage(slug)
        }

        .StartCreate -> {
            .creating = true;
            .editing = false;
            .viewing_raw = false;
            .creating_folder = false;
            .new_slug = "";
            .new_title = "";
            .new_content = ""
        }

        .CreatePage -> {
            if .new_slug != "" {
                store.CreatePage(.new_slug, .new_title, .new_content);
                .creating = false
            }
        }

        .CancelCreate -> { .creating = false }

        .EditPage -> {
            if .store.current_page != None {
                .editing = true;
                .new_content = .store.current_page.content
            }
        }

        .SavePage -> {
            if .active_slug != "" {
                store.UpdatePage(.active_slug, .new_content);
                .editing = false
            }
        }        .DeletePage(slug) -> {
            store.DeletePage(slug);
            .active_slug = ""
        }

        // ─── raw 交互（Plan 022 遗留：DropZone 完整闭环）───
        // SelectRawNode(path): 点击 raw 文件 → 记录选中 + 进入预览态。
        // 对齐原版 WikiView.vue:364-374 selectRawNode（type!=='file' return；
        // 文本内容读取在 RawPreview 逃生舱内做）。
        .SelectRawNode(path) -> {
            .creating = false;
            .editing = false;
            .creating_folder = false;
            .viewing_raw = true;
            store.SelectRawFile(path)
        }

        // HandleRawUploaded: WikiNav DropZone 上传成功 → 刷新 raw tree。
        .HandleRawUploaded -> {
            store.UploadRawFiles()
        }

        // DeleteRawFile(path): 删除 raw 文件 → 退出预览态。
        .DeleteRawFile(path) -> {
            store.DeleteRawFile(path);
            .viewing_raw = false
        }

        // StartNewFolder: 显示新建文件夹表单。
        .StartNewFolder -> {
            .creating = false;
            .editing = false;
            .viewing_raw = false;
            .creating_folder = true;
            .new_folder_path = ""
        }

        .FolderPathChanged -> { .new_folder_path = .new_folder_path }

        // CreateFolder: 创建文件夹 → 刷新 tree + 退出表单。
        .CreateFolder -> {
            if .new_folder_path != "" {
                store.CreateRawFolder(.new_folder_path);
                .creating_folder = false;
                .new_folder_path = ""
            }
        }

        .CancelNewFolder -> { .creating_folder = false }

        // ClearRaw: 退出 raw 预览。
        .ClearRaw -> {
            .viewing_raw = false;
            store.SelectRawFile("")
        }

        // v-model marker handlers（U5）。
        .SlugChanged -> { .new_slug = .new_slug }
        .TitleChanged -> { .new_title = .new_title }
        .ContentChanged -> { .new_content = .new_content }
    }
}
