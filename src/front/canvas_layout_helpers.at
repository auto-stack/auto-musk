// canvas_layout_helpers.at — PLAN-102 T-03: Canvas 工作台停靠布局纯函数
//（钳制/窄容器降级/拖动结果/偏好序列化）。被 canvas_workbench.at 与
// canvas_store.at 消费；边界测试 = scripts/ui-parity/canvas-layout-contract.mjs
//（经 use.web.fn 生成链直测本模块，不复制算法）。
//
// 常量表（§5.3；模块级 const 不进 ext TS 发射面——字面量内联，本表单源）：
//   工具区水平 240/最小 180；底部 240/最小 140；画布最小 240x180；
//   正常模式外框初值 640、聊天区最小 320；
//   VM 工作台容器高派生 chrome = 78（ContentHeader 49 + 停靠条 29）；
//   外框容器侧栏估算 = 240。

// ── 钳制 ────────────────────────────────────────────────────────────────

/** 工具区水平宽钳制：[180, container - 240]（容器不足时收敛到 180——
 * 降级判定由 canvasDockNarrow 承担，这里只保数值合法：不负、不塌）。 */
fn canvasClampDockW(container_w int, w int) int {
    var hi int = container_w - 240
    if hi < 180 { hi = 180 }
    var v int = w
    if v < 180 { v = 180 }
    if v > hi { v = hi }
    return v
}

/** 底部工具区高钳制：[140, container_h - 180]。 */
fn canvasClampDockH(container_h int, h int) int {
    var hi int = container_h - 180
    if hi < 140 { hi = 140 }
    var v int = h
    if v < 140 { v = 140 }
    if v > hi { v = hi }
    return v
}

/** 正常模式外框宽钳制：[240, container_w - 320]（容器不足时收敛到
 * 240——页签单区判定在宿主层）。 */
fn canvasClampOuterW(container_w int, w int) int {
    var hi int = container_w - 320
    if hi < 240 { hi = 240 }
    var v int = w
    if v < 240 { v = 240 }
    if v > hi { v = hi }
    return v
}

// ── 布局决策 ────────────────────────────────────────────────────────────

/** 水平窄容器判定：容器容不下「画布最小宽 240 + 工具最小宽 180」→
 * 工具/画布降为单区页签（用户停靠与尺寸偏好保留，变宽自动恢复）。
 * 底部停靠不受宽约束（只受高约束，canvasDockNarrowH）。 */
fn canvasDockNarrow(container_w int) bool {
    return container_w < 420
}

/** 垂直窄容器判定（底部停靠）：容器容不下「画布最小高 180 + 底部最小
 * 高 140」。 */
fn canvasDockNarrowH(container_h int) bool {
    return container_h < 320
}

/** 当前停靠下的布局模式："tabs"（单区页签降级）| "dock"（正常停靠）。
 * hidden 恒 dock（工具区不占位，无降级面）。容器尺寸未知（<=0，宿主
 * LayoutContainer 未报到）时不降级——降级必须有窄容器证据。 */
fn canvasDockMode(dock str, container_w int, container_h int) str {
    if dock == "hidden" { return "dock" }
    if container_w <= 0 || container_h <= 0 { return "dock" }
    if dock == "bottom" {
        if canvasDockNarrowH(container_h) { return "tabs" }
        return "dock"
    }
    if canvasDockNarrow(container_w) { return "tabs" }
    return "dock"
}

// ── 拖动 ────────────────────────────────────────────────────────────────

/** 内部分隔条拖动结果：kind "h"（水平宽，left/right 停靠）/ "b"（底部
 * 高）；delta_px = 指针位移（右/下为正）。left/bottom：正位移 = 工具区
 * 变大；right 停靠反向。返回钳制后的新尺寸。 */
fn canvasDockDragSize(dock str, kind str, container_w int, container_h int, origin int, delta_px int) int {
    var d int = delta_px
    if dock == "right" && kind == "h" { d = 0 - delta_px }
    if kind == "h" {
        return canvasClampDockW(container_w, origin + d)
    }
    return canvasClampDockH(container_h, origin + d)
}

/** 键盘步进（方向键 ±10；Home 恢复初值）。step_px 可负。 */
fn canvasDockNudgeSize(dock str, kind str, container_w int, container_h int, origin int, step_px int) int {
    if step_px == 0 {
        if kind == "h" { return canvasClampDockW(container_w, 240) }
        return canvasClampDockH(container_h, 240)
    }
    var d int = step_px
    if dock == "right" && kind == "h" { d = 0 - step_px }
    if kind == "h" {
        return canvasClampDockW(container_w, origin + d)
    }
    return canvasClampDockH(container_h, origin + d)
}

// ── 偏好（workspace 键；轮询不覆写——load-once 由 store 门） ─────────────

fn canvasLayoutPrefKey(ws str) str {
    var w str = ws
    if w == "" { w = "default" }
    return "canvas.layout." + w
}

/** 偏好序列化（dock|w|h|outer 竖线串——localStorage 单键面）。 */
fn canvasLayoutPrefEncode(dock str, dock_w int, dock_h int, outer_w int) str {
    return dock + "|" + dock_w + "|" + dock_h + "|" + outer_w
}

/** 偏好解析：畸形段回落缺省；dock 值域外回落 "left"。负尺寸回落初值。 */
fn canvasLayoutPrefDecode(raw str) obj {
    var dock str = "left"
    var w int = 240
    var h int = 240
    var outer int = 640
    if raw != "" && raw != None {
        var parts list = raw.split("|")
        if parts.len() == 4 {
            var d str = parts[0] ?? "left"
            if d == "left" || d == "right" || d == "bottom" || d == "hidden" { dock = d }
            var pw int = (parts[1] ?? "0").to_int()
            if pw >= 180 { w = pw }
            var ph int = (parts[2] ?? "0").to_int()
            if ph >= 140 { h = ph }
            var po int = (parts[3] ?? "0").to_int()
            if po >= 240 { outer = po }
        }
    }
    return { dock: dock, dock_w: w, dock_h: h, outer_w: outer }
}

// ── 动态尺寸声明串（W-03-1 spike 裁定形态） ─────────────────────────────
// 双轨单通道：`style: .store.<decl>` 装 CSS 声明串。VM 侧经
// split_css_declarations（PLAN-095）映射 width/height/overflow；web 侧
// 生成 :style 真 CSS。web 专属键（flex-shrink）VM 词法扫描落 remainder
// token 管线、未知类静默跳过——双轨各自消费可懂段。禁止 class:+style:
// 并存承载动态值（VM extract class 优先短路 style——spike C1 臂 472 实测）。

/** 左/右停靠工具列声明串。 */
fn canvasDockWDecl(w int) str {
    return "width:" + w + "px;height:100%;overflow:hidden;flex-shrink:0"
}

/** 底部停靠工具行声明串。 */
fn canvasDockHDecl(h int) str {
    return "height:" + h + "px;width:100%;overflow:hidden;flex-shrink:0"
}

/** 正常模式外框声明串（宿主 = CanvasPanel 右列；分隔线走外部分隔件）。 */
fn canvasOuterWDecl(w int) str {
    return "width:" + w + "px;height:100%;overflow:hidden;flex-shrink:0"
}

// ── 容器尺寸推导（VM 轨派生源；web 轨实测量优先） ───────────────────────
// chrome 常数 = 工作台自身停靠条（h-7=28 + border-b 1 = 29）——切片④实机
// 校准：ContentHeader 在聊天列内部、面板根即全窗高（wb 根 bbox=窗口高），
// 拆分容器 = 根高 - 停靠条。侧栏宽估算 = 展开 240（收窄时外框 max 偏
// 保守——聊天区只会更宽，无害；跨 store 读侧栏真实态在 VM 轨是断路面
// ——PLAN-101 毒签先例）。web 轨 canvas.wb_* 键缺席时本族生效。

/** VM 轨工作台容器高（窗口高 - chrome 常数）。 */
fn canvasWbEstH(win_h int) int {
    var v int = win_h - 29
    if v < 1 { v = 1 }
    return v
}

/** 外框钳制容器宽（视口宽 - 侧栏估算 240）。 */
fn canvasOuterContainerW(win_w int) int {
    var v int = win_w - 240
    if v < 240 { v = 240 }
    return v
}

/** 4096 逻辑域 delta → 像素（容器维度单源换算；分隔条 move 增量与探针
 * 注入共用——逻辑域语义 = 全容器宽映射到 4096）。.to_int() 是 VM 轨唯
 * 一可靠的 float→int 收整（engine 按 receiver tag 解码 f64→i32，Plan
 * 402 §13.10；ext TS 生成 parseInt）——Math.floor 返回外源浮点，穿 int
 * 边界后 str 拼接位型缺陷把它写成 0（切片④实测 width:0px）。 */
fn canvasLogicalToPx(delta int, container int) int {
    var v int = (delta * container / 4096).to_int()
    return v
}
