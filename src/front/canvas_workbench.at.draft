// canvas_workbench.at — PLAN-102 T-03: Canvas 工作台组合件（共用停靠
// 布局）。CanvasPanel（正常模式右列，含外框宽 + 外部分隔条）与
// CanvasStudioSlot（studio 中列）仅作宿主配置——布局/停靠/分隔条/窄容器
// 降级全部收敛在本件 + canvas_layout_helpers.at（单源）。
//
// 拖动机制（双轨同构）：分隔条 mouse-area 记迹（move 持续更新最后位），
// mousedown 起拖；起拖后覆盖全工作台的捕获层接管 move/up（越界继续——
// 捕获层坐标域固定 4096，handler 以 store 已知容器实际尺寸换算回像素，
// 双轨精确）；Escape 取消恢复起始尺寸。键盘面 = 分隔条旁紧凑步进钮组
//（±10 / Home / Esc——原生按钮键盘可达；方向键直挂分隔条归 T-05 打磨）。

use store: CanvasStore
use canvas_structure: CanvasStructureColumn
use canvas_panel: CanvasCanvasColumn
use.web useT from "src/front/ports/composables.at"
// 布局纯函数生成面（合同脚本 canvas-layout-contract.mjs 直测 ext TS）。
use.web.fn canvasDockMode, canvasClampDockW, canvasClampDockH, canvasClampOuterW from "src/front/canvas_layout_helpers.at"

widget CanvasWorkbench {

    setup {
        let t = useT()
    }

    model {
        // 拖动瞬态：kind = h|b|outer|""；起拖逻辑坐标（4096 域）。
        var drag str = ""
        var x0 float = 0.0
        var y0 float = 0.0
    }

    msg Msg {
        Dock(str),
        Solo(str),
        // 分隔条 hover 记迹 + 起拖。
        DivMove(float, float),
        DivDownH,
        DivDownB,
        DivDownOuter,
        // 捕获层：move（换算像素 delta）/ up（提交）/ esc（取消）。
        CapMove(float, float),
        CapUp,
        CapCancel,
        KeyNudge(str, int),
        KeyHome(str),
    }

    view {
        col {
            style: "relative w-full h-full flex flex-col overflow-hidden bg-card"
            // 停靠条（紧凑——T-04 并入预览顶部工具栏）：left/right/bottom/
            // hidden 四停靠 + 单区页签（tabs 降级时）。
            row {
                style: "h-7 shrink-0 flex items-center gap-0.5 px-1 border-b border-border bg-muted/30"
                button {
                    onclick: .Dock("left")
                    style: "h-5 px-1.5 rounded text-[10px] cursor-pointer " + if .store.cv_dock == "left" { "bg-primary/15 text-primary" } else { "bg-transparent text-muted-foreground hover:bg-accent" }
                    title: t("canvas.dockLeft")
                    text "◧"
                }
                button {
                    onclick: .Dock("bottom")
                    style: "h-5 px-1.5 rounded text-[10px] cursor-pointer " + if .store.cv_dock == "bottom" { "bg-primary/15 text-primary" } else { "bg-transparent text-muted-foreground hover:bg-accent" }
                    title: t("canvas.dockBottom")
                    text "▄"
                }
                button {
                    onclick: .Dock("right")
                    style: "h-5 px-1.5 rounded text-[10px] cursor-pointer " + if .store.cv_dock == "right" { "bg-primary/15 text-primary" } else { "bg-transparent text-muted-foreground hover:bg-accent" }
                    title: t("canvas.dockRight")
                    text "◨"
                }
                button {
                    onclick: .Dock("hidden")
                    style: "h-5 px-1.5 rounded text-[10px] cursor-pointer " + if .store.cv_dock == "hidden" { "bg-primary/15 text-primary" } else { "bg-transparent text-muted-foreground hover:bg-accent" }
                    title: t("canvas.dockHidden")
                    text "✕"
                }
                // 键盘步进组（§5.3：方向键 ±10 / Home 初值——原生按钮键盘
                // 可达 + title 可读名）。
                if .store.cv_dock == "left" || .store.cv_dock == "right" {
                    button { onclick: .KeyNudge("h", -10); style: "h-5 px-1 rounded bg-transparent text-muted-foreground hover:bg-accent text-[10px] cursor-pointer"; title: t("canvas.dockNarrower"); text "‹‹" }
                    button { onclick: .KeyNudge("h", 10); style: "h-5 px-1 rounded bg-transparent text-muted-foreground hover:bg-accent text-[10px] cursor-pointer"; title: t("canvas.dockWider"); text "››" }
                    button { onclick: .KeyHome("h"); style: "h-5 px-1 rounded bg-transparent text-muted-foreground hover:bg-accent text-[10px] cursor-pointer"; title: t("canvas.dockReset"); text "⌂" }
                }
                if .store.cv_dock == "bottom" {
                    button { onclick: .KeyNudge("b", -10); style: "h-5 px-1 rounded bg-transparent text-muted-foreground hover:bg-accent text-[10px] cursor-pointer"; title: t("canvas.dockShorter"); text "⌃⌃" }
                    button { onclick: .KeyNudge("b", 10); style: "h-5 px-1 rounded bg-transparent text-muted-foreground hover:bg-accent text-[10px] cursor-pointer"; title: t("canvas.dockTaller"); text "⌄⌄" }
                    button { onclick: .KeyHome("b"); style: "h-5 px-1 rounded bg-transparent text-muted-foreground hover:bg-accent text-[10px] cursor-pointer"; title: t("canvas.dockReset"); text "⌂" }
                }
                // tabs 降级页签。
                if canvasDockMode(.store.cv_dock, .store.cv_wb_w, .store.cv_wb_h) == "tabs" {
                    button {
                        onclick: .Solo("canvas")
                        style: "h-5 px-1.5 rounded text-[10px] cursor-pointer " + if .store.cv_solo_tab == "canvas" { "bg-primary/15 text-primary" } else { "bg-transparent text-muted-foreground hover:bg-accent" }
                        text t("canvas.soloCanvas")
                    }
                    button {
                        onclick: .Solo("tools")
                        style: "h-5 px-1.5 rounded text-[10px] cursor-pointer " + if .store.cv_solo_tab == "tools" { "bg-primary/15 text-primary" } else { "bg-transparent text-muted-foreground hover:bg-accent" }
                        text t("canvas.soloTools")
                    }
                }
            }
            // 主体区。
            if canvasDockMode(.store.cv_dock, .store.cv_wb_w, .store.cv_wb_h) == "tabs" {
                // 窄容器降级：单区页签（偏好保留——变宽自动恢复方向）。
                if .store.cv_solo_tab == "tools" {
                    col { style: "flex-1 min-h-0 flex flex-col overflow-hidden"; CanvasStructureColumn {} }
                } else {
                    col { style: "flex-1 min-h-0 flex flex-col overflow-hidden"; CanvasCanvasColumn {} }
                }
            } else {
                if .store.cv_dock == "left" {
                    row {
                        style: "flex-1 min-h-0 w-full flex flex-row overflow-hidden"
                        col {
                            style: "shrink-0 h-full flex flex-col overflow-hidden border-r border-border"
                            style2: "w-[" + .store.cv_dock_w + "px]"
                            CanvasStructureColumn {}
                        }
                        DivH {}
                        col { style: "flex-1 min-w-0 h-full flex flex-col overflow-hidden"; CanvasCanvasColumn {} }
                    }
                } else {
                    if .store.cv_dock == "right" {
                        row {
                            style: "flex-1 min-h-0 w-full flex flex-row overflow-hidden"
                            col { style: "flex-1 min-w-0 h-full flex flex-col overflow-hidden"; CanvasCanvasColumn {} }
                            DivH {}
                            col {
                                style: "shrink-0 h-full flex flex-col overflow-hidden border-l border-border"
                                style2: "w-[" + .store.cv_dock_w + "px]"
                                CanvasStructureColumn {}
                            }
                        }
                    } else {
                        if .store.cv_dock == "bottom" {
                            col {
                                style: "flex-1 min-h-0 w-full flex flex-col overflow-hidden"
                                col { style: "flex-1 min-h-0 w-full flex flex-col overflow-hidden"; CanvasCanvasColumn {} }
                                DivB {}
                                col {
                                    style: "shrink-0 w-full flex flex-col overflow-hidden border-t border-border"
                                    style2: "h-[" + .store.cv_dock_h + "px]"
                                    CanvasStructureColumn {}
                                }
                            }
                        } else {
                            // hidden：画布独占（停靠条即重新打开入口）。
                            col { style: "flex-1 min-h-0 w-full flex flex-col overflow-hidden"; CanvasCanvasColumn {} }
                        }
                    }
                }
            }
            // 拖动捕获层（起拖后覆盖全工作台：越界继续、up 提交、esc 取消；
            // 坐标域 4096——CapMove 内按容器实际尺寸换算像素）。
            if .drag != "" {
                mouse-area {
                    coords: "4096x4096"
                    onmousemove: .CapMove
                    onmouseup: .CapUp
                    style: "absolute inset-0 z-50 cursor-col-resize"
                }
            }
        }
    }

    on {
        .Dock(d str) -> {
            store.SetDock(d)
        }
        .Solo(tab str) -> {
            store.SoloTab(tab)
        }
        .DivMove(x float, y float) -> {
            .x0 = x
            .y0 = y
        }
        .DivDownH -> {
            .drag = "h"
            store.DockDragStart("h", int(.x0 * 4096.0 / 4096.0), .store.cv_dock_w)
            store.DockDragMove(0)
        }
        .DivDownB -> {
            .drag = "b"
            store.DockDragStart("b", int(.y0), .store.cv_dock_h)
            store.DockDragMove(0)
        }
        .DivDownOuter -> {
            .drag = "outer"
            store.OuterDragStart(int(.x0), .store.cv_outer_w)
            store.OuterDragMove(0)
        }
        .CapMove(x float, y float) -> {
            if .drag == "h" {
                var span float = x - .x0
                var px int = int(span * .store.cv_wb_w / 4096.0)
                store.DockDragMove(px)
            } else {
                if .drag == "b" {
                    var spanb float = y - .y0
                    var pxb int = int(spanb * .store.cv_wb_h / 4096.0)
                    store.DockDragMove(pxb)
                } else {
                    if .drag == "outer" {
                        var spano float = x - .x0
                        var pxo int = int(spano * .store.cv_outer_w / 4096.0)
                        store.OuterDragMove(pxo)
                    }
                }
            }
        }
        .CapUp -> {
            if .drag == "outer" {
                store.OuterDragEnd
            } else {
                store.DockDragEnd
            }
            .drag = ""
        }
        .CapCancel -> {
            if .drag == "outer" {
                store.OuterDragCancel
            } else {
                store.DockDragCancel
            }
            .drag = ""
        }
        .KeyNudge(kind str, step int) -> {
            store.DockNudge(kind, step)
        }
        .KeyHome(kind str) -> {
            store.DockNudge(kind, 0)
        }
    }
}

// ── 内部分隔条（水平宽 / 底部高；可见线 1px、命中 6px） ─────────────────
// 局部 widget（文件内私有组合件）。

widget DivH {
    use store: CanvasStore
    setup { let t = useT() }
    msg Msg { Down }
    view {
        mouse-area {
            coords: "4096x4096"
            onmousemove: .Move
            onmousedown: .Down
            style: "shrink-0 w-1.5 h-full flex items-center justify-center cursor-col-resize hover:bg-primary/20"
            div { style: "w-px h-full bg-border" }
        }
    }
    msg Msg2 { Move(float, float) }
    model { var mx float = 0.0 var my float = 0.0 }
    on {
        .Move(x float, y float) -> {
            .mx = x
            .my = y
        }
        .Down -> {
            store.DockDragStart("h", int(.mx), .store.cv_dock_w)
        }
    }
}

widget DivB {
    use store: CanvasStore
    msg Msg { Move(float, float), Down }
    model { var mx float = 0.0 var my float = 0.0 }
    view {
        mouse-area {
            coords: "4096x4096"
            onmousemove: .Move
            onmousedown: .Down
            style: "shrink-0 w-full h-1.5 flex items-center justify-center cursor-row-resize hover:bg-primary/20"
            div { style: "h-px w-full bg-border" }
        }
    }
    on {
        .Move(x float, y float) -> {
            .mx = x
            .my = y
        }
        .Down -> {
            store.DockDragStart("b", int(.my), .store.cv_dock_h)
        }
    }
}
