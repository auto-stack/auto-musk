// specs_category.at — PLAN-041 T3:分类组件组(category/ 7 件)。
// 薄包装 ×5(Section 固定 + summary 分派)对标 web category/*Cards.vue;
// GoalsTable 树形(父子展平 + 展开态)对标 GoalsTable.vue。
// Cards 的 detail 槽位(SpecItemDetail/编辑器)分别归 T4/Phase 2——本阶段
// CategoryList 的展开分支仍为占位,对拍面为折叠态 + 空态。

use.web component ChevronRight, Inbox from "src/front/ports/icons.at"
use.web specSummaryFor, goalsTreeRows from "src/front/specs_helpers.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use category_list: CategoryList
use spec_item_row: SpecItemRow
use status_badge: StatusBadge

widget ArchitectureCards(items: obj, project: str, expanded_id: str, editing_id: str) {
    view {
        CategoryList {
            items: .items
            project: .project
            expanded_id: .expanded_id
            editing_id: .editing_id
            section_type: "architecture"
            summary_kind: "architecture"
        }
    }
}

