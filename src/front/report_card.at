// report_card.at — ReportCard 组件（Plan 023 P3 续：逃生舱原生化）
//
// 对标 src/front/components/ReportCard.vue（逃生舱）。
// 验证 P4/P10 emit（msg → defineEmits + handler auto-emit）在重交互组件的效果。
//
// 关键转换：
//   - expanded toggle → model + on（P4）
//   - $emit('view-full'/'download'/'open-files') → msg + emit（P4/P10）
//   - @click.stop（action 阻止冒泡到 header toggle）→ onclick.stop
//   - (confidence || 'medium').toLowerCase() → reportConfidenceClass fn
//   - {collapsed: !expanded} 对象 class → 嵌套 if 表达式
//   - report.xxx 字段访问 → 直接（report 是 props，简单字段名）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.report-card 等）。

component fn ReportCard(report: obj) {
    use {
        component: ChevronDown, ChevronUp, FileText, Download, FolderOpen from "lucide-vue-next"
        fn: reportConfidenceClass from "src/front/forge_helpers.at"
    }
    computed {
        runId => .report.runId
        goalsMet => .report.goalsMet
        testsPass => .report.testsPass
        driftDetected => .report.driftDetected
        cost => .report.cost
        confidenceClass => reportConfidenceClass(.report.confidence)
        confidenceLabel => .report.confidence
        hasDeliverables => if .report.deliverables != None { .report.deliverables.length > 0 } else { false }
        deliverables => if .report.deliverables != None { .report.deliverables } else { [] }
        hasDrift => .driftDetected != "None"
        cardClass => if .expanded { "report-card" } else { "report-card collapsed" }
    }
    msg Msg { Toggle, ViewFull, DownloadReport, OpenFiles }
    model { var expanded bool = false }
    on {
        .Toggle -> { .expanded = !.expanded }
    }
    // Plan 029 T22：原 inject_styles 全局兜底下放（scoped 生效于本组件 DOM）。
    style {
  .report-card { border: 1px solid hsl(142 70% 45% / 0.25); border-radius: 10px; background: hsl(142 70% 45% / 0.04); margin: 0.5rem 0; overflow: hidden; transition: all 0.2s; }
  .report-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.8rem; cursor: pointer; user-select: none; }
  .report-header:hover { background: hsl(142 70% 45% / 0.06); }
  .report-status { font-size: 1rem; flex-shrink: 0; }
  .report-title-prefix, .report-title { flex: 1; font-size: 0.93rem; font-weight: 500; color: hsl(var(--foreground)); }
  .report-confidence { font-size: 0.73rem; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 500; text-transform: uppercase; }
  .report-confidence.high { background: hsl(142 70% 45% / 0.15); color: hsl(142 70% 35%); }
  .report-confidence.medium { background: hsl(38 90% 50% / 0.15); color: hsl(38 80% 40%); }
  .report-confidence.low { background: hsl(0 70% 50% / 0.15); color: hsl(0 70% 45%); }
  .report-chevron { color: hsl(var(--muted-foreground)); flex-shrink: 0; }
  .report-body { padding: 0.5rem 0.8rem 0.75rem; border-top: 1px solid hsl(142 70% 45% / 0.15); display: flex; flex-direction: column; gap: 0.6rem; }
  .report-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
  .metric-row { display: flex; justify-content: space-between; align-items: center; padding: 0.3rem 0.4rem; background: hsl(220 14% 50% / 0.04); border-radius: 5px; font-size: 0.83rem; }
  .metric-label { color: hsl(var(--muted-foreground)); }
  .metric-value { font-weight: 500; color: hsl(var(--foreground)); }
  .metric-value.drift { color: hsl(var(--destructive)); }
  .report-deliverables .section-title, .section-title { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; color: hsl(var(--muted-foreground)); letter-spacing: 0.03em; margin-bottom: 0.2rem; }
  .report-deliverables { font-size: 0.88rem; color: hsl(var(--foreground)); line-height: 1.5; }
  .deliverable-item { margin: 0.1rem 0; }
  .report-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .report-btn { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.6rem; border: 1px solid hsl(var(--border)); border-radius: 5px; background: transparent; color: hsl(var(--foreground)); font-size: 0.83rem; font-weight: 500; cursor: pointer; transition: all 0.15s; }
  .report-btn:hover { background: hsl(220 14% 50% / 0.06); border-color: hsl(var(--primary) / 0.3); }
    }

    col {
        class: .cardClass
        // header（click toggle）
        row {
            onclick: .Toggle
            style: "report-header"
            text "✅" { style: "report-status" }
            text "Relay Complete — Report " { style: "report-title-prefix" }
            text .runId { style: "report-title" }
            text .confidenceLabel { class: .confidenceClass }
            if .expanded {
                ChevronUp { size: 14, style: "report-chevron" }
            } else {
                ChevronDown { size: 14, style: "report-chevron" }
            }
        }
        // body（展开时）
        if .expanded {
            col {
                style: "report-body"
                // metrics
                col {
                    style: "report-metrics"
                    row {
                        style: "metric-row"
                        text "Goals Met" { style: "metric-label" }
                        text .goalsMet { style: "metric-value" }
                    }
                    row {
                        style: "metric-row"
                        text "Tests Pass" { style: "metric-label" }
                        text .testsPass { style: "metric-value" }
                    }
                    row {
                        style: "metric-row"
                        text "Drift Detected" { style: "metric-label" }
                        text .driftDetected { class: if .hasDrift { "metric-value drift" } else { "metric-value" } }
                    }
                    row {
                        style: "metric-row"
                        text "Cost" { style: "metric-label" }
                        text .cost { style: "metric-value" }
                    }
                }
                // deliverables
                if .hasDeliverables {
                    col {
                        style: "report-deliverables"
                        text "Deliverables" { style: "section-title" }
                        for d in .deliverables {
                            text .d { style: "deliverable-item" }
                        }
                    }
                }
                // actions
                row {
                    style: "report-actions"
                    button {
                        onclick.stop: .ViewFull
                        style: "report-btn"
                        FileText { size: 13 }
                        text "View Full Report"
                    }
                    button {
                        onclick.stop: .DownloadReport
                        style: "report-btn"
                        Download { size: 13 }
                        text "Download Markdown"
                    }
                    button {
                        onclick.stop: .OpenFiles
                        style: "report-btn"
                        FolderOpen { size: 13 }
                        text "Open Changed Files"
                    }
                }
            }
        }
    }
}
