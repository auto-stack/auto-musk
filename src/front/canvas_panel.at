// canvas_panel.at — PLAN-087 T-07 + PLAN-088 T-07 + PLAN-093 T-05: 画布面板
// （可组合三件套：结构列/画布列/组合面板）。
//
// T-05 拆分：CanvasPanel（正常模式 520px 右列）= CanvasStructureColumn +
// CanvasCanvasColumn 组合；studio 模式宿主 = CanvasStudioSlot（cv_open 分
// 两列/空工作台，输入与启动流走 store 域）——chats_view 只持视图域开关
// studio_mode，画布状态单源于 CanvasStore（子件各自 store 声明同一单例），
// 视图模板零复制。帧 img 以 身份+seq 双键缓存击穿（T-04 canvasFrameUrl）。
// 帧点选委托（web 侧 document 委托，幂等）随画布列 setup 装。
// 树点选 ↔ 画布高亮双向联动（pick 单源：后端 picked，前端经轮询/即时
// 回填双路取）。点选结果 ≤1s 滞后（轮询拍）。
// VM 轨：VMHTTP canvas 路由 T-03 已通，双端同源（四模式探针护航）。

use store: CanvasStore
use.web useT from "src/front/ports/composables.at"
use.web canvasStop, canvasStart from "src/front/ports/canvas.at"
use.web canvasPickNode, canvasClearPick, canvasPickAt, canvasLoadSource from "src/front/ports/canvas.at"
// PLAN-093 T-06:点选换算单源的 ext TS 模块生成面（canvas_web.ts 点击委托
// 消费同一规则；本件视图不直调）。
use.web.fn canvasMapPhysical from "src/front/canvas_helpers.at"

// PLAN-093 T-07:结构列迁出至 canvas_structure.at（页签化结构树/源码）——
// 本文件经 use canvas_structure 跨文件引用（子件两形态之 use 行形态）。
use canvas_structure: CanvasStructureColumn

// ── 画布列：标题条 + 降级红条 + 帧叠层 + 锚点 chip（studio 模式=中列）──
widget CanvasCanvasColumn {

    setup {
        let t = useT()
        // 帧点选委托由 ChatsView setup 统一安装（幂等；plan-093 T-05）。
    }

    msg Msg {
        Stop,
        Collapse,
        ClearPick,
        ToggleSource,
        ToggleZoom,
        ToggleErrorDetails,
        RerunApp,
        // PLAN-093 T-06（VM 轨收口）：帧区坐标点选——mouse-area 逻辑坐标
        // move 记迹 + click 取最后位置（onclick 无坐标，Plan 498；move 流
        // 仅 VM 臂派发（Plan 499），web 臂 move_has 恒 false = 委托独家，
        // 双轨互斥由构造保证）。
        FrameMove(float, float),
        FrameClick,
    }

    model {
        var move_x float = 0
        var move_y float = 0
        var move_has bool = false
    }

    view {
        col {
            style: "w-full h-full flex flex-col overflow-hidden"
            // 标题条：状态点 + app 名 + 收起/停止钮。
            row {
                style: "h-9 shrink-0 flex items-center justify-between px-3 border-b border-border"
                row {
                    style: "flex items-center gap-1.5 min-w-0"
                    if .store.cv_state == "running" {
                        span { style: "w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" }
                    } else {
                        if .store.cv_state == "degraded" {
                            span { style: "w-1.5 h-1.5 rounded-full bg-destructive shrink-0" }
                        } else {
                            span { style: "w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0" }
                        }
                    }
                    span {
                        title: .store.cv_app
                        style: "text-[12.5px] font-medium text-foreground truncate"
                        text .store.cv_app
                    }
                }
                row {
                    style: "flex items-center gap-1 shrink-0"
                    // PLAN-093 T-06:适应/100% 缩放切换（钮面=将切往的模式）。
                    button {
                        onclick: .ToggleZoom
                        style: "inline-flex items-center justify-center h-6 min-w-[24px] px-1 shrink-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent cursor-pointer text-[11px] leading-none"
                        title: t("canvas.zoomToggle")
                        if .store.cv_zoom_fit {
                            text "1:1"
                        } else {
                            text "⤢"
                        }
                    }
                    button {
                        onclick: .Collapse
                        style: "inline-flex items-center justify-center h-6 w-6 px-0 py-0 shrink-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent cursor-pointer text-sm leading-none"
                        title: t("canvas.collapse")
                        text "–"
                    }
                    button {
                        onclick: .Stop
                        style: "inline-flex items-center justify-center h-6 w-6 px-0 py-0 shrink-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-destructive cursor-pointer text-sm leading-none"
                        title: t("canvas.stop")
                        text "×"
                    }
                }
            }
            // degraded 红条（简短原因 + 可展开详情 + 重新运行入口——
            // §5.3 degraded 面契约；原始日志 tail 待后端暴露，记录）。
            if .store.cv_state == "degraded" {
                div {
                    style: "shrink-0 px-3 py-1.5 text-[12px] text-destructive bg-destructive/10 border-b border-destructive/20 flex items-center gap-2"
                    span {
                        style: "flex-1 min-w-0 truncate"
                        text .store.cv_error
                    }
                    button {
                        onclick: .ToggleErrorDetails
                        style: "shrink-0 h-5 px-1 rounded bg-transparent border-none text-destructive text-[11px] cursor-pointer"
                        title: t("canvas.errorDetails")
                        if .store.cv_error_details_open {
                            text "▴"
                        } else {
                            text "▾"
                        }
                    }
                    button {
                        onclick: .RerunApp
                        style: "shrink-0 h-5 px-2 rounded bg-destructive/20 border-none text-destructive text-[11px] cursor-pointer"
                        title: t("canvas.rerun")
                        text t("canvas.rerun")
                    }
                }
                if .store.cv_error_details_open {
                    col {
                        style: "shrink-0 max-h-[200px] overflow-auto bg-destructive/5 border-b border-destructive/20"
                        div {
                            style: "px-3 py-1.5 text-[11px] font-mono text-destructive/90 whitespace-pre-wrap"
                            text .store.cv_error
                        }
                        if .store.cv_output_tail != "" {
                            div {
                                style: "px-3 pb-1.5 text-[11px] font-mono text-muted-foreground whitespace-pre-wrap border-t border-destructive/10 pt-1"
                                text .store.cv_output_tail
                            }
                        }
                    }
                }
            }
            // 帧区：有帧显帧（身份+seq 双键）+ 覆盖框层；无帧显占位 + 状态语。
            // T-06:内容包装层（cv-frame-wrap）——bbox_pct 以帧物理尺寸为基，
            // 盒=内容盒（aspect-ratio 定比/100% 定尺寸，store 单源样式）时
            // 覆盖框与点选换算才对齐；容器留白区点击=显式清选（web 委托）。
            if .store.cv_frame_url != "" {
                div {
                    class: "cv-frame-box"
                    style: if .store.cv_zoom_fit {
                        "relative flex-1 min-h-0 w-full bg-background flex items-center justify-center overflow-hidden"
                    } else {
                        "relative flex-1 min-h-0 w-full bg-background overflow-auto"
                    }
                    div {
                        style: .store.cv_frame_wrap_style
                        class: "cv-frame-wrap"
                        mouse-area {
                            coords: "480x680"
                            onmousemove: .FrameMove
                            onclick: .FrameClick
                            style: "w-full h-full"
                            img {
                                src: .store.cv_frame_url
                                style: "w-full h-full object-contain bg-background"
                            }
                            // agent 高亮框层（琥珀）。
                            for ov in .store.cv_overlay {
                                div {
                                    style: ov.style
                                }
                            }
                            // 选中覆盖框（蓝）。
                            if .store.cv_pick_style != "" {
                                div {
                                    style: .store.cv_pick_style
                                }
                            }
                        }
                    }
                }
            } else {
                // §5.3 状态矩阵空态面：初始无应用（stopped+无 app 描述）≠
                // 已停止（stopped+有 app 描述——保留标题与"重新运行"入口，
                // 不得隐去全部操作）；starting/restarting 显等待原因。
                col {
                    style: "flex-1 min-h-0 flex flex-col items-center justify-center gap-2 text-muted-foreground"
                    if .store.cv_state == "stopped" {
                        if .store.cv_app != "" {
                            span {
                                style: "text-[13px] font-medium text-foreground"
                                text .store.cv_app
                            }
                            span {
                                style: "text-[11px]"
                                text t("canvas.stoppedNote")
                            }
                            button {
                                onclick: .RerunApp
                                style: "h-8 px-3 mt-1 rounded-md bg-primary text-primary-foreground text-[12px] cursor-pointer border-none"
                                text t("canvas.rerun")
                            }
                        } else {
                            span {
                                style: "text-[11px]"
                                text t("canvas.waiting")
                            }
                        }
                    } else {
                        text t("canvas.waiting")
                        if .store.cv_state == "starting" {
                            span { style: "text-[11px]"; text t("canvas.starting") }
                        } else {
                            if .store.cv_state == "restarting" {
                                span { style: "text-[11px]"; text t("canvas.restarting") }
                            } else {
                                if .store.cv_state == "degraded" {
                                    span { style: "text-[11px]"; text t("canvas.degraded") }
                                } else {
                                    span { style: "text-[11px]"; text .store.cv_state }
                                }
                            }
                        }
                    }
                }
            }
            // 锚点 chip：kind+label（for 实例缀）+ source 行；点击开
            // 源码抽屉；⨯ 清选（后端+本地双面）。
            if .store.cv_picked_id != "" {
                row {
                    style: "shrink-0 flex items-center gap-2 px-3 py-1.5 border-t border-border bg-muted/30"
                    button {
                        onclick: .ToggleSource
                        style: "inline-flex items-center gap-1.5 h-6 px-2 rounded-md bg-primary/10 text-primary cursor-pointer text-[11px] font-medium"
                        title: .store.cv_picked_source
                        span { text .store.cv_picked_kind }
                        if .store.cv_picked_label != "" {
                            span {
                                style: "text-muted-foreground font-normal"
                                text .store.cv_picked_label
                            }
                        }
                        if .store.cv_picked_for != "" {
                            span {
                                style: "text-amber-500 font-normal"
                                text .store.cv_picked_for
                            }
                        }
                        if .store.cv_picked_source != "" {
                            span {
                                style: "text-muted-foreground font-normal"
                                text .store.cv_picked_source
                            }
                        }
                        // PLAN-093 Q-04:多文件启发式来源标记（待确认，不假装
                        // 准确锚定；详情见结构列源码面板提示条）。
                        if .store.cv_picked_confidence == "uncertain" {
                            span {
                                style: "text-amber-500 font-normal"
                                title: t("canvas.sourceUncertain")
                                text "？"
                            }
                        }
                    }
                    button {
                        onclick: .ClearPick
                        style: "inline-flex items-center justify-center h-6 w-6 px-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent cursor-pointer text-xs leading-none"
                        title: "clear"
                        text "⨯"
                    }
                }
            }
        }
    }

    on {
        // 停止：POST /api/canvas/stop（双端真调）；面板收起与状态复位由
        // 下一拍轮询统一落账（单源，不本地抢写）。
        .Stop -> {
            canvasStop().await
        }
        // 收起 = 用户偏好（store 投影），与停止分离（AC-03）。
        .Collapse -> {
            store.Collapse()
        }
        // 芯片 ⨯：后端 {clear:true} + 本地投影清（AC-08 双面）。
        .ClearPick -> {
            canvasClearPick().await
            store.ClearPick()
        }
        .ToggleSource -> {
            store.ToggleSource()
            if .store.cv_picked_source_path != "" {
                let r = canvasLoadSource(.store.cv_picked_source_path).await
                if r.ok == true {
                    store.SourceBackfill(r.text ?? "")
                }
            }
        }
        // 适应/100% 缩放切换（store 偏好单源 + 包装层样式重算）。
        .ToggleZoom -> {
            store.ToggleZoom()
        }
        // PLAN-093 T-09:degraded 详情展开切换（视图态，store 域字段）。
        .ToggleErrorDetails -> {
            store.ToggleErrorDetails()
        }
        // PLAN-093 T-06:VM 坐标点选——move 记迹（引擎 screen→logical，
        // 原点=mouse-area 即内容盒）。
        .FrameMove(x float, y float) -> {
            .move_x = x
            .move_y = y
            .move_has = true
        }
        .FrameClick -> {
            if .move_has {
                if .store.cv_frame_w > 0 {
                    let px = .move_x * .store.cv_frame_w / 480
                    let py = .move_y * .store.cv_frame_h / 680
                    let r = canvasPickAt(px, py).await
                    if r.ok == true {
                        if r.pick != "" {
                            store.PickBackfill(r.pick)
                        }
                    } else {
                        // 204 未命中：后端已清 picked（T-02），前端规范化
                        // 为清选成功（§5.4；同委托 204 臂）。
                        if r.miss == true {
                            store.ClearPick()
                        }
                    }
                }
            }
        }
        // PLAN-093 T-09:重新运行（已停止/degraded 面可执行入口——
        // canvasStart 走既有校验与启动流；失败原因经下一拍轮询落 error 面）。
        .RerunApp -> {
            if .store.cv_app != "" {
                let r = canvasStart("", .store.cv_app).await
                if r.ok != true {
                    store.SetCanvasError(r.error ?? "rerun failed")
                }
            }
        }
    }
}

// ── 组合面板（正常模式右列 520px）：结构列 + 画布列 ──────────────────
// studio 宽度分支随 CanvasStudioSlot（本件只在正常模式被挂）。
widget CanvasPanel {

    setup {
        let t = useT()
    }

    view {
        if .store.cv_open {
            row {
                style: "w-[520px] shrink-0 h-full flex flex-row overflow-hidden border-l border-border bg-card"
                col {
                    style: "w-[170px] shrink-0 h-full flex flex-col overflow-hidden border-r border-border"
                    CanvasStructureColumn {}
                }
                col {
                    style: "flex-1 min-w-0 h-full flex flex-col overflow-hidden"
                    CanvasCanvasColumn {}
                }
            }
        }
    }
}

// ── studio 工作台槽（chats_view studio 模式宿主）：cv_open 分两列/空
// 工作台；§5.2 宽度分层——结构 220（≥1280）/200（<1280），768-1023 结构
// 受控显隐（切换钮列），<768 页签单区（tab: "canvas"/"structure"，对话
// 页签由宿主塌缩类承载）。"打开已有应用"启动流在本件动作域（canvasStart
// web 端口），输入草稿与错误是本件 model 本地态（gate_card 先例）——
// chats_view 的 ForgeStore 不跨域读画布状态。 ──────────────────────────
widget CanvasStudioSlot(tab: str) {

    setup {
        let t = useT()
    }

    model {
        var path str = ""
        var err str = ""
    }

    msg Msg {
        PathInput,
        StartApp,
        ToggleStructure,
    }

    computed {
        // 结构列宽分层（单层链——080 实证嵌套 if 分支值丢 return）。
        structureW => if .store.cv_win_w >= 1280 { "w-[220px]" } else { "w-[200px]" }
        structureColClass => .structureW + " shrink-0 h-full flex flex-col overflow-hidden border-r border-border"
    }

    view {
        if .store.cv_open {
            if .store.cv_win_w < 768 {
                // <768 页签单区：结构页签 = 结构列独占；画布页签 = 画布列独占。
                if .tab == "structure" {
                    row {
                        style: "flex-1 min-w-0 h-full flex flex-row overflow-hidden"
                        col {
                            style: "flex-1 min-w-0 h-full flex flex-col overflow-hidden"
                            CanvasStructureColumn {}
                        }
                    }
                } else {
                    row {
                        style: "flex-1 min-w-0 h-full flex flex-row overflow-hidden"
                        col {
                            style: "flex-1 min-w-0 h-full flex flex-col overflow-hidden"
                            CanvasCanvasColumn {}
                        }
                    }
                }
            } else {
                row {
                    style: "flex-1 min-w-0 h-full flex flex-row overflow-hidden"
                    if .store.cv_win_w < 1024 {
                        // 768-1023:结构列受控显隐 + 左缘切换钮列（不叠加）。
                        if .store.cv_structure_open {
                            col {
                                style: [.structureColClass]
                                CanvasStructureColumn {}
                            }
                        }
                        col {
                            style: "w-9 shrink-0 h-full flex flex-col items-center pt-2 border-r border-border bg-muted/20"
                            button {
                                onclick: .ToggleStructure
                                style: if .store.cv_structure_open {
                                    "inline-flex items-center justify-center h-7 w-7 rounded-md bg-accent text-foreground cursor-pointer"
                                } else {
                                    "inline-flex items-center justify-center h-7 w-7 rounded-md bg-transparent text-muted-foreground hover:bg-accent cursor-pointer"
                                }
                                title: t("canvas.structureToggle")
                                icon (name: "list-todo", size: 15) {}
                            }
                        }
                    } else {
                        col {
                            style: [.structureColClass]
                            CanvasStructureColumn {}
                        }
                    }
                    col {
                        style: "flex-1 min-w-0 h-full flex flex-col overflow-hidden"
                        CanvasCanvasColumn {}
                    }
                }
            }
        } else {
            col {
                style: "flex-1 min-h-0 flex flex-col items-center justify-center gap-3 px-6"
                span {
                    style: "text-[13px] text-muted-foreground"
                    text t("canvas.studioEmpty")
                }
                div {
                    style: "flex items-center gap-2 w-full max-w-[360px]"
                    input {
                        style: "flex-1 min-w-0 h-8 text-[13px] text-foreground bg-background border border-border rounded-md px-2 outline-none"
                        value: .path
                        oninput: .PathInput($event)
                        placeholder: t("canvas.openAppPath")
                    }
                    button {
                        onclick: .StartApp
                        style: "h-8 px-3 shrink-0 rounded-md bg-primary text-primary-foreground text-[12px] cursor-pointer disabled:opacity-50"
                        text t("canvas.openAppStart")
                    }
                }
                if .err != "" {
                    span {
                        style: "text-[12px] text-destructive max-w-[360px] text-center"
                        text .err
                    }
                }
            }
        }
    }

    on {
        .PathInput(val) -> {
            .path = val
        }
        // 打开已有应用：canvasStart 走既有校验与启动流（越界/无 pac.at
        // 错误原样展示；成功清输入，面板经状态轮询展开）。
        .StartApp -> {
            let r = canvasStart("", .path).await
            if r.ok == true {
                .err = ""
                .path = ""
            } else {
                .err = r.error
            }
        }
        // 结构列显隐（窄层受控面板;store 偏好单源）。
        .ToggleStructure -> {
            store.ToggleStructure()
        }
    }
}
