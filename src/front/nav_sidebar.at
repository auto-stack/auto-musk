// nav_sidebar.at — NavSidebar 组件（Plan 023 §3.1：三视图二级导航收敛）
//
// 收敛目标：三视图的二级导航（chats 的 session-sidebar / specs 的 section-nav /
// wiki 的 WikiNav 外壳）共用一个 component fn——header（48px 贴顶全宽 border）+
// 列表骨架（slot）+ 折叠态。
//
// 折叠态由父视图持有（component fn 子内部调用 prop 作 handler 不工作，探针 B），
// 父传 collapsed prop；折叠按钮由各视图在 actions slot 注入（wiki 的 PanelLeft）。
//
// PLAN-049 T6：宽度参数化——原宽度由 `.xxx-view > div:first-child` 位置选择器
// 给出（chats/plans 220px、specs 200px、wiki 240px），单一样式源后改由父视图传
// width_class（w-[220px] 等）；底色（bg-card）与右边框一并落根 div 工具类。
// 样式：inject_styles.ts 的 .nav-sidebar 系列已迁内联工具类（PLAN-049 双轨收敛）。

widget NavSidebar(title: str, collapsed: bool, width_class: str) {
    // PLAN-093 T-05:宽度单源化——折叠 w-12 与展开 width_class 此前分落
    // 静态 class 与条件 style 两处（VM 轨 style 内联语义下折叠可胜;web 轨
    // 两者皆类、级联让 240 压过 w-12,studio 强制收起失效实测 335px 之谜）。
    // 类全串按态计算,两宽互斥（app 轨 railClass 同款;widget computed
    // 先例 WorkspaceSelector）。
    computed {
        sidebarClass => if .collapsed {
            "w-12 flex flex-col h-full shrink-0 overflow-hidden bg-muted/20 border-r border-border"
        } else {
            .width_class + " flex flex-col h-full shrink-0 overflow-hidden bg-muted/20 border-r border-border"
        }
    }
    view {
        div {
            style: [.sidebarClass]
            div {
                style: "flex items-center gap-1.5 py-2 px-3 shrink-0 h-12 border-b border-border"
                span {
                    // PLAN-055: 标题字号与 ContentHeader 主标题对齐（用户裁定
                    // 两级标题同字体同字号；原 text-base 与 text-xl 不一致，
                    // VM 轨观感差异更明显）。
                    style: "flex-1 text-base font-semibold text-foreground"
                    text .title
                }
                slot(name: "actions") {}
            }
            slot(name: "list") {}
        }
    }
}
