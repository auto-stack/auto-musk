// questionnaire.at — 消息内问卷解析（单一真源，替代 questionnaire.ts）
//
// Plan 028 T11（M2）：纯前端解析函数迁回 .at。依赖 F3（JSON.parse）、
// F4（Regex.match/replace/split，Rust 语法子集 + a2ts 机械转换）。
// 行为与 questionnaire.ts 逐分支对齐（demo 会话 fixture 对拍验证）。
//
// 注意：stripQuestionnaire/blockDisplayText 在 forge_helpers.at（该文件
// 的 messageDisplayBlocks 是其唯一历史消费方，就近放置避免模块间导入）。

/** 解析 assistant 消息内的问卷：结构化 JSON 块优先，其次 free-text 问题
 * （子弹点选项 / 行内选项 / markdown 表格三趟启发式）。返回
 * { questions, strippedContent } 或 None。 */
fn questionnaireFor(msg obj) obj {
    if msg.role != "assistant" { return None }

    // 1. 结构化 JSON 块（```json 围栏内 type == "questionnaire"）。
    // PLAN-057 T11：围栏提取由 Regex.match 改 indexOf 纯串通道——VM 的
    // Regex native 对本形态恒空（055-3 ① regex 族，探针 wl_probe18 实证
    // 0 匹配），问卷卡在 VM 整体不渲染；indexOf/substring/JSON.parse 在
    // 双轨同语义。guard 循环沿 forge_helpers.at:406 先例。
    var rest = msg.content
    var guard = 0
    while guard < 32 {
        let start = rest.indexOf("```json")
        if start == -1 { break }
        let innerStart = start + 7
        let end = rest.indexOf("```", innerStart)
        if end == -1 { break }
        var inner = rest.substring(innerStart, end).trim()
        try {
            let json = JSON.parse(inner)
            if json.type == "questionnaire" {
                if json.questions != None {
                    if json.questions.length > 0 {
                        // 字面串 replace（收字符串参数时不做正则解释）
                        let fence = rest.substring(start, end + 3)
                        let stripped = msg.content.replace(fence, "")
                        return { questions: json.questions, strippedContent: stripped.trim() }
                    }
                }
            }
        } catch {
            // 无效 JSON：继续找下一个围栏
        }
        rest = rest.substring(end + 3)
        guard = guard + 1
    }

    // 2. free-text 问题启发式（三趟）
    let lines = msg.content.split("\n")
    let questions list = []
    var consumedLines list = []

    // Pass 1: 父问题 + 子弹点/编号选项
    var i = 0
    while i < lines.length {
        let line = lines[i].trim()
        if line == "" || line.starts_with("```") || consumedLines.contains(i) {
            i = i + 1
            continue
        }
        let isNumberedQuestion = questionnaireIsNumbered(line) && line.contains("?") && line.length > 10
        let isStandaloneQuestion = questionnaireIsNumbered(line) == false && questionnaireIsBullet(line) == false && line.ends_with("?") && line.length > 15
        if isNumberedQuestion || isStandaloneQuestion {
            let childOptions list = []
            var j = i + 1
            while j < lines.length {
                let nextLine = lines[j]
                if questionnaireIsBullet(nextLine) || questionnaireIsNumbered(nextLine) {
                    let optText = questionnaireStripMarkdown(Regex.replace(nextLine, "^\\s*(?:[-*•]|\\d+\\.)\\s+", "", "g").trim())
                    if optText != "" { childOptions.push(optText) }
                    j = j + 1
                } else {
                    if nextLine.trim() == "" {
                        j = j + 1
                    } else {
                        break
                    }
                }
            }
            let parentText = questionnaireStripMarkdown(questionnaireStripNumbering(line))
            if childOptions.length >= 2 {
                let qid = questions.length + 1
                questions.push({ id: "q" + qid, text: parentText, type: "multiple", options: childOptions, otherLabel: "Other:", otherPlaceholder: "Type additional details..." })
                consumedLines.push(i)
                var k = i + 1
                while k < j {
                    consumedLines.push(k)
                    k = k + 1
                }
                i = j
                continue
            } else {
                if childOptions.length == 1 {
                    let qid2 = questions.length + 1
                    questions.push({ id: "q" + qid2, text: parentText, type: "single", options: [childOptions[0]], otherLabel: "Other:", otherPlaceholder: "Type additional details..." })
                    consumedLines.push(i)
                    var k2 = i + 1
                    while k2 < j {
                        consumedLines.push(k2)
                        k2 = k2 + 1
                    }
                    i = j
                    continue
                } else {
                    let qid3 = questions.length + 1
                    questions.push({ id: "q" + qid3, text: parentText, type: "text", placeholder: "Type your answer..." })
                    consumedLines.push(i)
                    i = i + 1
                    continue
                }
            }
        }
        i = i + 1
    }

    // Pass 2: 冒号后的行内选项（逗号/顿号/斜杠/ or 分隔）
    var i2 = 0
    while i2 < lines.length {
        if consumedLines.contains(i2) {
            i2 = i2 + 1
            continue
        }
        let line2 = lines[i2].trim()
        if line2.ends_with("?") == false || line2.starts_with("```") || line2.length <= 15 {
            i2 = i2 + 1
            continue
        }
        let colonMatch = Regex.match(line2, "^(.+?)[:：—–―-]\\s*(.+)\\?\\s*$")
        if colonMatch.length > 0 {
            let label = questionnaireStripMarkdown(colonMatch[1]).trim()
            let optsRaw = Regex.split(colonMatch[2], "[,，、/]|\\s+or\\s+")
            let opts list = []
            for o in optsRaw {
                var s = questionnaireStripMarkdown(o).trim()
                if s.length > 0 && s.to_lower() != "etc" { opts.push(s) }
            }
            if opts.length >= 2 {
                let qid4 = questions.length + 1
                questions.push({ id: "q" + qid4, text: label, type: "single", options: opts, otherLabel: "Other:", otherPlaceholder: "Type additional details..." })
                consumedLines.push(i2)
            }
        }
        i2 = i2 + 1
    }

    // Pass 3: markdown 表格问卷（? 占位或 priority 表头）
    if questions.length == 0 {
        var tableStart = -1
        var tableEnd = -1
        var i3 = 0
        while i3 < lines.length {
            if lines[i3].trim().starts_with("|") && lines[i3].indexOf("|", lines[i3].indexOf("|") + 1) != -1 {
                if tableStart == -1 { tableStart = i3 }
                tableEnd = i3
            } else {
                if tableStart != -1 && lines[i3].trim() == "" { break }
            }
            i3 = i3 + 1
        }
        if tableStart != -1 && tableEnd > tableStart + 1 {
            let tableLines list = []
            var tidx = tableStart
            while tidx <= tableEnd {
                tableLines.push(lines[tidx])
                tidx = tidx + 1
            }
            let dataRows list = []
            for l in tableLines {
                if l.contains("---") == false && l.contains(":--") == false { dataRows.push(l) }
            }
            if dataRows.length >= 2 {
                let headerCells = questionnaireNonEmpty(dataRows[0].split("|"))
                var hasPriorityHeader = false
                for h in headerCells {
                    if Regex.test(h, "priority", "i") { hasPriorityHeader = true }
                }
                let rows list = []
                var ridx0 = 1
                while ridx0 < dataRows.length {
                    rows.push(dataRows[ridx0])
                    ridx0 = ridx0 + 1
                }
                var hasPlaceholders = false
                for r in rows {
                    if r.contains("?") { hasPlaceholders = true }
                }
                if hasPriorityHeader || hasPlaceholders {
                    let precedingLines []str = []
                    var pidx = 0
                    while pidx < tableStart {
                        precedingLines.push(lines[pidx])
                        pidx = pidx + 1
                    }
                    let precedingText = precedingLines.join("\n")
                    let p0 = Regex.match(precedingText, "P0\\s*\\(([^)]+)\\)")
                    let p1 = Regex.match(precedingText, "P1\\s*\\(([^)]+)\\)")
                    let p2 = Regex.match(precedingText, "P2\\s*\\(([^)]+)\\)")
                    var priorityOptions = ["P0 (Critical)", "P1 (Important)", "P2 (Nice-to-have)"]
                    if p0.length > 0 && p1.length > 0 && p2.length > 0 {
                        priorityOptions = ["P0 (" + p0[1] + ")", "P1 (" + p1[1] + ")", "P2 (" + p2[1] + ")"]
                    }
                    for row in rows {
                        let cells = questionnaireNonEmpty(row.split("|"))
                        if cells.length >= 2 {
                            let featureName = Regex.replace(cells[0], "\\*\\*", "", "g").trim()
                            if featureName != "" && featureName.to_lower().contains("other") == false {
                                let qid5 = questions.length + 1
                                questions.push({ id: "q" + qid5, text: "Priority for \"" + featureName + "\"", type: "single", options: priorityOptions })
                            }
                        }
                    }
                    consumedLines = []
                    var idx = tableStart
                    while idx <= tableEnd {
                        consumedLines.push(idx)
                        idx = idx + 1
                    }
                }
            }
        }
    }

    if questions.length >= 2 {
        let remainingLines []str = []
        var ridx = 0
        while ridx < lines.length {
            if consumedLines.contains(ridx) == false { remainingLines.push(lines[ridx]) }
            ridx = ridx + 1
        }
        return { questions: questions, strippedContent: remainingLines.join("\n").trim() }
    }
    return None
}

/** 便捷谓词：消息是否含问卷。 */
fn hasQuestionnaire(msg obj) bool {
    return questionnaireFor(msg) != None
}

/** 便捷取值：消息的 questions 数组（无则空数组）。 */
fn getQuestions(msg obj) obj {
    let r = questionnaireFor(msg)
    if r == None { return [] }
    return r.questions ?? []
}

/** 该消息是否为消息列表的最后一条（问卷卡只随最新一条消息显示）。 */
fn isLastMessage(messages obj, msg obj) bool {
    if messages == None { return false }
    if messages.length == 0 { return false }
    let last = messages[messages.length - 1]
    return last.id == msg.id
}

/** 最后一条消息的 id（空列表返回 ""）。 */
fn lastMessageId(messages obj) str {
    if messages == None { return "" }
    if messages.length == 0 { return "" }
    let last = messages[messages.length - 1]
    return last.id ?? ""
}

// ─── 行级判定辅助（questionnaireFor 专用，保持纯函数） ────────────────────

fn questionnaireIsBullet(line str) bool {
    return Regex.test(line, "^\\s*(?:[-*•])\\s+")
}

fn questionnaireIsNumbered(line str) bool {
    return Regex.test(line, "^\\s*\\d+\\.\\s+")
}

fn questionnaireStripNumbering(text str) str {
    return Regex.replace(text, "^\\s*\\d+\\.\\s+", "", "g").trim()
}

fn questionnaireStripMarkdown(text str) str {
    return Regex.replace(text, "\\*\\*", "", "g").trim()
}

fn questionnaireNonEmpty(cells obj) obj {
    let out list = []
    for c in cells {
        if c.trim() != "" { out.push(c.trim()) }
    }
    return out
}
