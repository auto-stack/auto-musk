// relay_store.at — Relay 运行状态 store（单一真源，替代 useRelay.ts + useEventRouter.ts）
//
// Plan 030 T12：随 RelayView 移除收敛到 chat 内联面——退役 LoadProfessions/
// LoadSouls/RerunRun/SubmitHandoff/DeleteRun/UpdateRunTitle 及 professions/
// souls 状态（与 useRelay.ts 修剪保持 parity）。
//
// Plan 028 T16（M6）：F8 平台协议（Http.get/post/patch/delete + Sse.open/close）
// + F3 JSON/Date 承载。原 useRelay.ts 的 fetch/SSE 逻辑逐路径对齐：
//   - runs 列表加载排序 + 失效 current_run 清理
//   - loadRun 详情 + 持久化 events → 会话日志重建 + per-profession tokens
//   - startRun/advanceRun/rerunRun/resolveGate/submitHandoff/deleteRun/updateRunTitle
//   - subscribeToRun：SSE（query token/workspace 鉴权）→ OnRelayEvent
//     （live_log + session_logs 累积合并 + tokens 累计 + 事件触发的自动刷新）
// 原 useEventRouter.handleEvent 的有效路由（gate_reached/gate_resolved →
// useGateInbox）经 gate_signal 模型字段中转；setEventCallbacks 从无调用方，死代码不迁。

store RelayStore {
    model {
        var runs []Value = []
        var current_run Value = None
        var loading bool = false
        var error str = ""
        var live_log []Value = []
        var profession_tokens Value = {}
        // runId → 会话日志条目数组
        var session_logs Value = {}
        // runId → 历史回放（run 内存态被 serve 重启清空后，从持久化 Flow
        // 会话重建的只读视图：{status,title,entries}）
        var run_histories Value = {}
        // runId → 完成报告（run_completed 事件载荷；PLAN-031 T5）
        var run_reports Value = {}
        // runId → 汇报报告元数据 {format,title,path}（PLAN-032：report_emitted
        // 事件 / run_completed 载荷双通道写入）
        var run_report_meta Value = {}
        // runId → 汇报报告 HTML 全文（FetchReport 拉取缓存；deck 层数据源）
        var run_report_html Value = {}
        // runId → SSE 订阅句柄（Sse.open 产物；close 经 Sse.close）
        var relay_subs Value = {}
        // relay gate 事件中转信号（useGateInbox watch 消费：{kind: reached|resolved, ...}）
        var gate_signal Value = None
    }

    msg Msg {
        LoadRuns(str),
        LoadRun(str),
        LoadRunHistory(str),
        StartRun(obj),
        AdvanceRun(str),
        ResolveGate(str, str, str),
        Subscribe(str),
        Unsubscribe(str),
        FetchReport(str),
        OnRelayEvent(Value),
    }

    on {
        .LoadRuns(projectPath) -> {
            try {
                let q = ""
                if projectPath != "" { q = "?project_path=" + encodeURIComponent(projectPath) }
                let raw = Http.get("/api/forge/relay/runs" + q)
                let data = raw
                if raw.runs != None { data = raw.runs }
                // 按更新时间倒序
                data.sort((a, b) => b.updated_at - a.updated_at)
                .runs = data
                // 失效 current_run 清理（列表已无此 run）
                if .current_run != None {
                    let cid = .current_run.run_id
                    let still = data.find(r => r.run_id == cid)
                    if still == None { .current_run = None }
                }
            } catch {
                .error = "load runs failed"
                .runs = []
            }
        }

        // 历史回放：run 不在内存（服务重启/历史消息）时，从持久化 Flow 会话
        // （= run 日志唯一归档，D7）重建只读视图。无会话（已删）保持空 → UI 失效态。
        .LoadRunHistory(runId) -> {
            try {
                let data = Http.get("/api/conversations/" + encodeURIComponent(runId))
                if data.id != None {
                    let hv = relayHistoryFromConversation(data)
                    .run_histories[runId] = hv
                    if hv.report != None {
                        .run_report_meta[runId] = hv.report
                        .FetchReport(runId)
                    }
                }
            } catch {
                // 无会话或网络异常 → 不写历史，保持失效态
            }
        }

        .LoadRun(runId) -> {
            try {
                let data = Http.get("/api/forge/relay/runs/" + encodeURIComponent(runId))
                if data.run_id == None {
                    // 404/异常响应体：清理并报错（对齐旧实现的 404 分支）
                    .current_run = None
                    .session_logs[runId] = None
                    .error = "load run failed"
                } else {
                    .current_run = data
                    if data.events != None {
                        if data.events.length > 0 {
                            .session_logs[runId] = relayEventsToSessionLog(runId, data.events)
                        }
                        // 回扫 run_completed 报告载荷（刷新/重启后恢复 ReportBlock）
                        var ri int = data.events.length - 1
                        while ri >= 0 {
                            let rev = data.events[ri]
                            if rev.type == "run_completed" {
                                if rev.report != None {
                                    .run_reports[runId] = rev.report
                                    if rev.report.report != None {
                                        .run_report_meta[runId] = rev.report.report
                                    }
                                }
                                ri = -1
                            } else {
                                ri = ri - 1
                            }
                        }
                        // 回扫 report_emitted 元数据（document 相位先于完成事件）
                        var rj int = data.events.length - 1
                        while rj >= 0 {
                            let revj = data.events[rj]
                            if revj.type == "report_emitted" {
                                .run_report_meta[runId] = { format: revj.format ?? "html", title: revj.title ?? "", path: revj.path ?? "" }
                                rj = -1
                            } else {
                                rj = rj - 1
                            }
                        }
                    }
                    if data.profession_tokens != None {
                        .profession_tokens = data.profession_tokens
                    }
                }
            } catch {
                .error = "load run failed"
            }
        }

        .StartRun(req) -> {
            .loading = true
            .error = ""
            let runId = None
            try {
                let data = Http.post("/api/forge/relay/runs", req)
                .current_run = data.state
                let rid = data.run_id ?? ""
                // codegen 修复：前一行 let 的 RHS 会被下一行 `.x()` 续链
                //（曾生成 (data.run_id ?? '').LoadRuns('') → TypeError 被 catch 吞掉）
                if rid != "" { .LoadRuns("") }
                .loading = false
                return rid
            } catch {
                .error = "start run failed"
                .loading = false
                return ""
            }
        }

        .AdvanceRun(runId) -> {
            try {
                Http.post("/api/forge/relay/runs/" + encodeURIComponent(runId) + "/advance", {})
                if runId != "" { .LoadRun(runId) }
            } catch {
                .error = "advance run failed"
            }
        }

        .ResolveGate(runId, decision, feedback) -> {
            try {
                let body map = { decision: decision }
                if feedback != "" { body.feedback = feedback }
                Http.post("/api/forge/relay/runs/" + encodeURIComponent(runId) + "/gate", body)
                // codegen 修复：原 `.LoadRun` 续链到 Http.post 结果上（批准后
                // 刷新被吞——用户点批准无任何反馈的直接根因）
                if runId != "" { .LoadRun(runId) }
            } catch {
                .error = "resolve gate failed"
            }
        }

        .Subscribe(runId) -> {
            if .relay_subs[runId] != None { return }
            if .session_logs[runId] == None { .session_logs[runId] = [] }
            // EventSource 不能设 header：token/workspace 走 query 参数鉴权
            let qs = ""
            let ws = localStorage.getItem("musk_workspace")
            if ws != None { qs = "?workspace=" + encodeURIComponent(ws) }
            let tk = localStorage.getItem("musk_jwt")
            if tk != None {
                if qs == "" {
                    qs = "?token=" + encodeURIComponent(tk)
                } else {
                    qs = qs + "&token=" + encodeURIComponent(tk)
                }
            }
            .relay_subs[runId] = Sse.open("/api/forge/relay/runs/" + encodeURIComponent(runId) + "/events" + qs, .OnRelayEvent, runId)
        }

        .Unsubscribe(runId) -> {
            .relay_subs[runId] = Sse.close(.relay_subs[runId])
        }

        // PLAN-032: 拉取汇报报告 HTML 全文（幂等缓存；deck 层数据源）
        .FetchReport(runId) -> {
            if .run_report_html[runId] != None { return }
            let meta = .run_report_meta[runId]
            if meta == None { return }
            try {
                let qs = ""
                let ws = localStorage.getItem("musk_workspace")
                if ws != None { qs = "?workspace=" + encodeURIComponent(ws) }
                let html = Http.get("/api/forge/relay/runs/" + encodeURIComponent(runId) + "/report" + qs)
                if html != None {
                    if html != "" { .run_report_html[runId] = html }
                }
            } catch {
                // 404/网络异常 → 保持空，ReportCard 不渲染 deck 层
            }
        }

        // relay SSE 事件 → 会话日志/live_log/tokens/自动刷新（对应旧 subscribeToRun
        // 的 onmessage 体 + useEventRouter.run_completed 分支；runId 经 __ctx 注入）
        .OnRelayEvent(ev) -> {
            if ev == None { return }
            let runId = ev.__ctx
            if runId == None { return }
            if .session_logs[runId] == None { .session_logs[runId] = [] }
            let et = ev.event_type
            let p = ev.payload ?? {}
            // 后端 RunEvent 用 role_id（relay_store.at 后端侧），兼容 profession_id
            let prof = p.role_id ?? p.profession_id ?? "unknown"
            let time = relayNowTime()

            // ─── live_log ───
            if et == "handoff_submitted" {
                let hp = ev.profession_id ?? ev.from_profession ?? "unknown"
                let ht = ev.to_profession ?? "next"
                .live_log.push({ time: time, profession: hp, action: "Handoff to " + ht })
            }
            if et == "step_advanced" {
                let sp = ev.profession_id ?? "system"
                .live_log.push({ time: time, profession: sp, action: "Step advanced: " + (ev.step_id ?? "") })
            }

            // ─── session_logs 累积（相邻同类文本/思考合并；tool_result 并入 tool_call）───
            let log = .session_logs[runId]

            // turn_delta / turn_thinking：相邻同类同职业合并，否则新条目
            if et == "turn_delta" {
                if relayMergeLast(log, "text", prof, p.text ?? "") == false {
                    log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "text", content: p.text ?? "" })
                }
            }
            if et == "turn_thinking" {
                if relayMergeLast(log, "thinking", prof, p.thinking ?? "") == false {
                    log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "thinking", content: p.thinking ?? "" })
                }
            }
            if et == "turn_tool_call" {
                log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "tool_call", content: "", tool_name: p.tool_name, tool_id: p.tool_id, arguments: p.arguments })
            }
            if et == "turn_tool_result" {
                let last2 = log[log.length - 1]
                if last2 != None {
                    if last2.type == "tool_call" {
                        if last2.tool_id == p.tool_id {
                            last2.type = "tool"
                            last2.result = p.result ?? ""
                        } else {
                            log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "tool_result", content: p.result ?? "", tool_id: p.tool_id })
                        }
                    } else {
                        log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "tool_result", content: p.result ?? "", tool_id: p.tool_id })
                    }
                } else {
                    log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "tool_result", content: p.result ?? "", tool_id: p.tool_id })
                }
            }
            if et == "turn_complete" {
                log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "complete", content: "Turn completed" })
            }
            if et == "turn_error" {
                log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "error", content: p.message ?? "Unknown error" })
            }
            if et == "turn_budget_warning" {
                let rem = p.remaining ?? 0
                log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "budget_warning", content: "Budget warning: " + rem + " tokens remaining", remaining: p.remaining })
            }
            if et == "turn_budget_exceeded" {
                log.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "budget_exceeded", content: "Budget exceeded — turn stopped" })
            }
            // ─── 步骤生命周期事件 ───
            if et == "step_started" {
                let sp2 = p.profession_id ?? "system"
                let sid2 = p.step_id ?? ""
                log.push({ id: relayMakeId(runId), time: time, profession_id: sp2, type: "step_started", content: "Step \"" + sid2 + "\" started" })
            }
            if et == "step_completed" {
                let sp3 = p.profession_id ?? "system"
                let sid3 = p.step_id ?? ""
                log.push({ id: relayMakeId(runId), time: time, profession_id: sp3, type: "step_completed", content: "Step \"" + sid3 + "\" completed" })
            }
            if et == "gate_waiting" {
                let sp4 = p.profession_id ?? "system"
                let gs4 = p.step_id ?? ""
                // 审批标题可解析化（与 Step 'x' 同构）——阶段块标题栏显示
                // "审批 · 计划执行 · 等待"而非泛化英文
                log.push({ id: relayMakeId(runId), time: time, profession_id: sp4, type: "gate_waiting", content: "Gate '" + gs4 + "' waiting" })
            }
            if et == "run_completed" {
                log.push({ id: relayMakeId(runId), time: time, profession_id: "system", type: "run_completed", content: "Run completed successfully" })
                // 完成报告载荷（PLAN-031 T5）——RunBox 内嵌 ReportCard 数据源
                if p.report != None {
                    .run_reports[runId] = p.report
                    if p.report.report != None {
                        .run_report_meta[runId] = p.report.report
                    }
                }
            }
            // PLAN-032: 汇报报告元数据（document 相位先于 run_completed 到达）
            if et == "report_emitted" {
                .run_report_meta[runId] = { format: p.format ?? "html", title: p.title ?? "", path: p.path ?? "" }
                .FetchReport(runId)
            }
            if et == "run_failed" {
                log.push({ id: relayMakeId(runId), time: time, profession_id: "system", type: "run_failed", content: p.error ?? "Run failed" })
            }

            // ─── per-profession tokens 累计 ───
            if ev.tokens_used != None {
                if ev.profession_id != None {
                    let prev = .profession_tokens[ev.profession_id] ?? 0
                    .profession_tokens[ev.profession_id] = prev + ev.tokens_used
                }
            }

            // ─── gate 事件中转（useGateInbox watch gate_signal 消费）───
            if et == "gate_reached" {
                let gid = ev.gate_id ?? ""
                if gid == "" { gid = runId + "-" + (ev.step_id ?? "") }
                let gprof = ev.profession ?? "unknown"
                let gtitle = ev.title ?? ""
                if gtitle == "" { gtitle = (ev.profession_id ?? "agent") + " needs approval" }
                .gate_signal = { kind: "reached", gate_id: gid, run_id: runId, profession: gprof, title: gtitle, section_id: ev.section_id ?? "" }
            }
            if et == "gate_resolved" {
                let gid2 = ev.gate_id ?? ""
                if gid2 == "" { gid2 = runId + "-" + (ev.step_id ?? "") }
                .gate_signal = { kind: "resolved", gate_id: gid2, decision: ev.decision ?? "approved" }
            }

            // ─── 事件触发自动刷新 ───
            // PLAN-030 试用修复：对齐 RunEvent 真实枚举——原列表里 run_started/
            // step_advanced/handoff_submitted/run_title_updated 并非真实事件名，
            // 且 gate_waiting/run_failed 缺席：run 停靠审批/失败时 UI 从不刷新。
            if et == "step_started" { .LoadRun(runId) }
            if et == "step_completed" { .LoadRun(runId) }
            if et == "gate_waiting" { .LoadRun(runId) }
            if et == "gate_resolved" { .LoadRun(runId) }
            if et == "run_failed" { .LoadRun(runId) }
            if et == "run_completed" { .LoadRun(runId) }
        }
    }
}

// ─── 模块 fn（纯逻辑，对应旧 useRelay 内部 helper）──────────────────────────

/** 会话日志条目 id：runId-时间-随机段。 */
fn relayMakeId(runId str) str {
    return runId + "-" + Date.now() + "-" + Math.random().toString(36).slice(2, 7)
}

/** 当前时刻 HH:mm:ss。 */
fn relayNowTime() str {
    return Date.format(Date.now(), "HH:mm:ss")
}

/** 秒级时间戳 → HH:mm:ss。 */
fn relayFormatTimestamp(ts int) str {
    return Date.format(ts * 1000, "HH:mm:ss")
}

/** 末条为 (type, profession_id) 时拼接 text 返回 true；否则 false。 */
fn relayMergeLast(log Value, ty str, prof str, text str) bool {
    if log.length == 0 { return false }
    let last = log[log.length - 1]
    if last == None { return false }
    if last.type == ty {
        if last.profession_id == prof {
            last.content = last.content + text
            return true
        }
    }
    return false
}

/** 持久化 events → 会话日志（历史 run 重建，对应旧 eventsToSessionLog）。 */
fn relayHistoryFromConversation(conv Value) Value {
    // run 历史回放重建：turns（流式 message 按来源合并）→ 回放条目；
    // 状态从 system turns 推导（conversation.status 对 REST 启动的 run 不可靠）。
    var entries List<Value> = []
    var bufProf str = ""
    var bufText str = ""
    var sawCompleted bool = false
    var sawFailed bool = false
    let turns = conv.turns ?? []
    var i int = 0
    while i < turns.length {
        let t = turns[i]
        let k = t.kind ?? ""
        if k == "message" {
            let prof = t.from ?? "unknown"
            if prof == bufProf {
                bufText = bufText + (t.content ?? "")
            } else {
                if bufText != "" {
                    entries.push({ id: "h" + entries.length, profession_id: bufProf, type: "text", content: bufText })
                }
                bufProf = prof
                bufText = t.content ?? ""
            }
        } else {
            if bufText != "" {
                entries.push({ id: "h" + entries.length, profession_id: bufProf, type: "text", content: bufText })
                bufText = ""
                bufProf = ""
            }
            if k == "tool_call" {
                var tname str = ""
                if t.tool != None {
                    tname = t.tool.name ?? ""
                }
                // 与聊天侧一致：带 arguments（操作目标展示用），结果由紧随的
                // tool_result 配对合并（支撑 RunBox 工具卡展开）。
                let targs Value = None
                if t.tool != None {
                    targs = t.tool.args ?? None
                }
                entries.push({ id: "h" + entries.length, profession_id: t.from ?? "unknown", type: "tool_call", content: "", tool_name: tname, arguments: targs, result: "" })
            } else if k == "tool_result" {
                // 并入最近一个 tool 条目（展开态显示结果）
                var lastTool Value = None
                var j int = entries.length - 1
                while j >= 0 {
                    if entries[j].type == "tool_call" || entries[j].type == "tool" {
                        lastTool = entries[j]
                        j = -1
                    } else {
                        j = j - 1
                    }
                }
                if lastTool != None {
                    // 结果字段双兼容：新版镜像写 t.content；旧版会话写
                    // t.tool.result（content 空）——否则回放工具卡结果全空
                    var gres str = t.content ?? ""
                    if gres == "" {
                        if t.tool != None {
                            gres = t.tool.result ?? ""
                        }
                    }
                    lastTool.result = gres
                    lastTool.type = "tool"
                }
            } else if k == "gate" {
                // 审批标题可解析化：step_id 优先取 GateRecord，兜底从
                // "Waiting for gate approval: execute" 尾段抽取
                var gs str = ""
                if t.gate != None {
                    gs = t.gate.step_id ?? ""
                }
                if gs == "" {
                    let gc = t.content ?? ""
                    let ci = gc.indexOf(":")
                    if ci != -1 { gs = gc.substring(ci + 1).trim() }
                }
                entries.push({ id: "h" + entries.length, profession_id: "system", type: "gate_waiting", content: "Gate '" + gs + "' waiting" })
            } else if k == "system" {
                let c = t.content ?? ""
                if c.starts_with("Step '") {
                    if c.contains(" completed") {
                        entries.push({ id: "h" + entries.length, profession_id: "system", type: "step_completed", content: c })
                    } else if c.contains(" started") {
                        entries.push({ id: "h" + entries.length, profession_id: "system", type: "step_started", content: c })
                    }
                } else if c.contains("Flow completed") {
                    // T13: 后端曾双写 RunCompleted（advance 终态重复追加已修），
                    // 回放侧去重防御
                    if sawCompleted == false {
                        sawCompleted = true
                        entries.push({ id: "h" + entries.length, profession_id: "system", type: "run_completed", content: "Run 已完成" })
                    }
                } else if c.contains("failed") {
                    sawFailed = true
                    entries.push({ id: "h" + entries.length, profession_id: "system", type: "error", content: c })
                }
            }
        }
        i = i + 1
    }
    if bufText != "" {
        entries.push({ id: "h" + entries.length, profession_id: bufProf, type: "text", content: bufText })
    }

    var status str = "interrupted"
    if sawCompleted { status = "completed" }
    if sawFailed && sawCompleted == false { status = "failed" }
    if (conv.status ?? "") == "failed" { status = "failed" }
    // PLAN-032: 会话镜像 system turn「汇报报告已生成：T（F，path：P）」→ 元数据
    var repFmt str = ""
    var repTitle str = ""
    var repPath str = ""
    var ti int = 0
    let turs = conv.turns ?? []
    while ti < turs.length {
        let tc = turs[ti].content ?? ""
        if tc.starts_with("汇报报告已生成：") {
            let body = tc.substring(9)
            let pa = body.indexOf("（")
            let pb = body.indexOf("，path：")
            let pc = body.lastIndexOf("）")
            if pa != -1 && pb != -1 {
                repTitle = body.substring(0, pa)
                repFmt = body.substring(pa + 1, pb - pa - 1)
                if pc > pb {
                    repPath = body.substring(pb + 7, pc - pb - 7)
                }
            }
            ti = turs.length
        } else {
            ti = ti + 1
        }
    }
    var reportMeta Value = None
    if repPath != "" {
        reportMeta = { format: repFmt, title: repTitle, path: repPath }
    }
    return { status: status, title: conv.title ?? "", entries: entries, report: reportMeta }
}

fn relayEventsToSessionLog(runId str, events Value) Value {
    let result list = []
    for ev in events {
        let time = relayNowTime()
        if ev.timestamp != None { time = relayFormatTimestamp(ev.timestamp) }
        let prof = ev.role_id ?? ev.profession_id ?? "unknown"

        if ev.type == "turn_delta" {
            if relayMergeLast(result, "text", prof, ev.text ?? "") == false {
                result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "text", content: ev.text ?? "" })
            }
        }
        if ev.type == "turn_thinking" {
            if relayMergeLast(result, "thinking", prof, ev.thinking ?? "") == false {
                result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "thinking", content: ev.thinking ?? "" })
            }
        }
        if ev.type == "turn_tool_call" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "tool_call", content: "", tool_name: ev.tool_name, tool_id: ev.tool_id, arguments: ev.arguments })
        }
        if ev.type == "turn_tool_result" {
            let last = result[result.length - 1]
            if last != None {
                if last.type == "tool_call" {
                    if last.tool_id == ev.tool_id {
                        last.type = "tool"
                        last.result = ev.result ?? ""
                    } else {
                        result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "tool_result", content: ev.result ?? "", tool_id: ev.tool_id })
                    }
                } else {
                    result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "tool_result", content: ev.result ?? "", tool_id: ev.tool_id })
                }
            } else {
                result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "tool_result", content: ev.result ?? "", tool_id: ev.tool_id })
            }
        }
        if ev.type == "turn_complete" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "complete", content: "Turn completed" })
        }
        if ev.type == "turn_error" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "error", content: ev.message ?? "Unknown error" })
        }
        if ev.type == "turn_budget_warning" {
            let rem = ev.remaining ?? 0
            result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "budget_warning", content: "Budget warning: " + rem + " tokens remaining", remaining: ev.remaining })
        }
        if ev.type == "turn_budget_exceeded" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: prof, type: "budget_exceeded", content: "Budget exceeded — turn stopped" })
        }
        // ─── 步骤/门禁/run 生命周期（持久化 events 同样携带；此前只映射
        // turn_* —— 刷新重建的日志丢失 step/gate/失败行，收起态预览与
        // 失败原因在重载后消失）。字段形状与 SSE 路径对齐（顶层平铺）。───
        if ev.type == "step_started" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: ev.role_id ?? "system", type: "step_started", content: "Step \"" + (ev.step_id ?? "") + "\" started" })
        }
        if ev.type == "step_completed" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: ev.role_id ?? "system", type: "step_completed", content: "Step \"" + (ev.step_id ?? "") + "\" completed" })
        }
        if ev.type == "gate_waiting" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: "system", type: "gate_waiting", content: "Waiting for human gate approval" })
        }
        if ev.type == "run_completed" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: "system", type: "run_completed", content: "Run completed successfully" })
        }
        if ev.type == "run_failed" {
            result.push({ id: relayMakeId(runId), time: time, profession_id: "system", type: "run_failed", content: ev.error ?? "Run failed" })
        }
    }
    return result
}
