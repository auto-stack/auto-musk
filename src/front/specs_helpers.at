// specs_helpers.at — Specs 视图条目 ID/状态工具（单一真源，
// 替代 utils/itemTemplates.ts）
//
// Plan 029 T3：仅迁 SpecsView 消费中的两个 fn。ITEM_TEMPLATES 常量在
// Auto 轨无消费方，不迁（原生轨 web/src/utils/itemTemplates.ts 自持）。
//
// 对拍要点（与原 TS 逐函数对齐）：
//   - getNextId 兼容旧格式（G1）与新格式（Module-G1）；用 Regex.match
//     （F4）捕获尾部数字，省略原 isNaN 检查——NaN 参与大小比较恒为 false，
//     与 `!isNaN(num) && num > maxNum` 行为等价。
//   - .at 字符串里正则反斜杠双写（"\\d" → 生成 JS '\d'）。

/** 新建条目的初始状态（goals → proposed，其余 draft）。 */
fn spec_default_status(section_type str) str {
    if section_type == "goals" {
        return "proposed"
    }
    return "draft"
}

/** 下一个条目 ID：prefix + 现有最大序号 + 1。 */
fn spec_next_id(section_type str, existing_ids []str) str {
    let prefix_map map = { "goals": "G", "architecture": "A", "designs": "D", "plans": "P", "tests": "T", "reviews": "V", "reports": "R" }
    let prefix = prefix_map[section_type] ?? section_type.char_at(0).to_upper()
    var max_num = 0
    for id in existing_ids {
        // Regex pattern 必须是字面量（拼接表达式不被 F4 转译）——prefix 经
        // 捕获组取出后手动比较。旧格式 G12：首字母 + 纯数字。
        let m = Regex.match(id, "^([A-Za-z])(\\d+)$")
        if m.length > 1 {
            if m[1] == prefix {
                let num = m[2].to_int()
                if num > max_num {
                    max_num = num
                }
            }
        } else {
            // 新格式 Module-G12：-prefix + 数字结尾
            let m2 = Regex.match(id, "-([A-Za-z])(\\d+)$")
            if m2.length > 1 {
                if m2[1] == prefix {
                    let num2 = m2[2].to_int()
                    if num2 > max_num {
                        max_num = num2
                    }
                }
            }
        }
    }
    return prefix + (max_num + 1).to_string()
}


// ── PLAN-041 T2:Specs 组件组辅助(web parseTag/summaryFn 对拍面)──

/** tag 串 `type:value` 解析(无冒号 → other);对拍 web SpecItemRow.parseTag。 */
fn specTagParse(tag str) obj {
    let idx = tag.find(":")
    if idx > 0 {
        return { type: tag.slice(0, idx), value: tag.slice(idx + 1), full: tag }
    }
    return { type: "other", value: tag, full: tag }
}

/** 越界安全的 tag 取解(computed 不支持对象字面量,经 fn 返回)。 */
fn specTagOther() obj {
    return { type: "other", value: "", full: "" }
}

fn specTagAt(tags obj, i int) obj {
    if tags.length > i {
        return specTagParse(tags[i])
    }
    return specTagOther()
}

/** 行摘要(T2 占位:空串;T4 接线时按 section 细化——web summaryFn 语义)。 */
fn specRowSummary(item obj) str {
    return ""
}

// ── PLAN-041 T3:分类摘要(web utils/categorySummary.ts 对拍面)──

fn specSummaryArchitecture(item obj) str {
    let c = item.content ?? ""
    let m = Regex.match(c, "\\*\\*Decision:\\*\\*\\s*(.+)")
    let decision = ""
    if m.length > 1 {
        decision = m[1].trim().slice(0, 120)
    }
    let hasDiagram = c.contains("```mermaid")
    if decision != "" && hasDiagram { return decision + " · 📊 Diagram" }
    if decision != "" { return decision }
    if hasDiagram { return "📊 Diagram" }
    return ""
}

fn specSummaryDesign(item obj) str {
    let c = item.content ?? ""
    let m = Regex.match(c, "```\\w*\\n([^(\\n]+\\([^)]*\\))")
    let iface = ""
    if m.length > 1 {
        iface = m[1].trim().slice(0, 120)
    }
    let module = item.module ?? ""
    if iface != "" && module != "" { return iface + " · 📦 " + module }
    if iface != "" { return iface }
    if module != "" { return "📦 " + module }
    return ""
}

fn specSummaryPlan(item obj) str {
    let c = item.content ?? ""
    let m = Regex.match(c, "\\*\\*Objective:\\*\\*\\s*(.+)")
    let objective = ""
    if m.length > 1 {
        objective = m[1].trim().slice(0, 80)
    }
    let phaseCount = 0
    let plines = c.split("\n")
    for pl in plines {
        if pl.length > 0 {
            if pl.char_at(0) == "|" {
                phaseCount = phaseCount + 1
            }
        }
    }
    phaseCount = phaseCount - 1
    if phaseCount < 0 { phaseCount = 0 }
    if objective != "" && phaseCount > 0 { return "Objective: " + objective + " · " + phaseCount + " phases" }
    if objective != "" { return "Objective: " + objective }
    if phaseCount > 0 { return phaseCount + " phases" }
    return ""
}

fn specSummaryTest(item obj) str {
    let c = item.content ?? ""
    let m = Regex.match(c, "\\*\\*Type:\\*\\*\\s*(\\w+)")
    let ty = ""
    if m.length > 1 {
        ty = m[1].trim()
    }
    let stepCount = 0
    let slines = c.split("\n")
    for sl in slines {
        let t = sl.trim()
        if t.length > 1 {
            if t.char_at(0) >= "0" && t.char_at(0) <= "9" && t.char_at(1) == "." {
                stepCount = stepCount + 1
            }
        }
    }
    let parts = ""
    if ty != "" { parts = ty }
    let tf = item.test_file ?? ""
    if tf != "" {
        let segs = tf.split("/")
        let base = segs[segs.length - 1]
        if parts != "" { parts = parts + " · 📄 " + base } else { parts = "📄 " + base }
    }
    if stepCount > 0 {
        if parts != "" { parts = parts + " · " + stepCount + " steps" } else { parts = stepCount + " steps" }
    }
    return parts
}

fn specSummaryReview(item obj) str {
    let c = item.content ?? ""
    let passed = Regex.match(c, "[☑✅✓]").length
    let partial = Regex.match(c, "[⚠]").length
    let failed = Regex.match(c, "[❌✗]").length
    let issues = Regex.match(c, "####\s+V\d+-I\d+").length
    let parts = ""
    if passed > 0 || partial > 0 || failed > 0 {
        parts = passed + " passed"
        if partial > 0 { parts = parts + ", " + partial + " partial" }
        if failed > 0 { parts = parts + ", " + failed + " failed" }
    }
    if issues > 0 {
        if parts != "" { parts = parts + " · " }
        parts = parts + issues + " issue"
        if issues > 1 { parts = parts + "s" }
    }
    return parts
}

fn specSummaryReport(item obj) str {
    let c = item.content ?? ""
    let phaseCount = 0
    let plines = c.split("\n")
    for pl in plines {
        if pl.length > 0 {
            if pl.char_at(0) == "|" {
                phaseCount = phaseCount + 1
            }
        }
    }
    phaseCount = phaseCount - 1
    if phaseCount < 0 { phaseCount = 0 }
    let metricCount = phaseCount
    let blockers = Regex.match(c, "\*\*B\d+\*\*").length
    let parts = ""
    if metricCount > 0 { parts = metricCount + " metrics" }
    if blockers > 0 {
        if parts != "" { parts = parts + " · " }
        parts = parts + blockers + " blocker"
        if blockers > 1 { parts = parts + "s" }
    }
    return parts
}

fn specSummaryApi(item obj) str {
    let c = item.content ?? ""
    let m = Regex.match(c, "\\*\\*Version:\\*\\*\\s*(.+)")
    let version = ""
    if m.length > 1 {
        version = m[1].trim()
    }
    let endpoints = Regex.match(c, "(?i)####\s+(GET|POST|PUT|DELETE|PATCH)").length
    let parts = ""
    if version != "" { parts = "v" + version }
    if endpoints > 0 {
        if parts != "" { parts = parts + " · " }
        parts = parts + endpoints + " endpoint"
        if endpoints > 1 { parts = parts + "s" }
    }
    return parts
}

fn specSummaryGeneric(item obj) str {
    let c = item.content ?? ""
    let lines = c.split("\n")
    for line in lines {
        let t = line.trim()
        if t == "" { continue }
        if t.char_at(0) == "#" { continue }
        if t.slice(0, 3) == "```" { continue }
        if t.slice(0, 4) == "<!--" { continue }
        if t.char_at(0) == "|" { continue }
        if t.slice(0, 2) == "- " { continue }
        if t.slice(0, 2) == "-[" { continue }
        return t.slice(0, 160)
    }
    return ""
}

/** 按 section 分派摘要 fn(CategoryList 经 summary_kind 消费)。 */
fn specSummaryFor(kind str, item obj) str {
    if kind == "architecture" { return specSummaryArchitecture(item) }
    if kind == "designs" { return specSummaryDesign(item) }
    if kind == "plans" { return specSummaryPlan(item) }
    if kind == "tests" { return specSummaryTest(item) }
    if kind == "reviews" { return specSummaryReview(item) }
    if kind == "reports" { return specSummaryReport(item) }
    if kind == "api" { return specSummaryApi(item) }
    return specSummaryGeneric(item)
}

// ── PLAN-041 T3:GoalsTable 树形展平(web buildChildMap/treeRows 对拍)──

/** G12.3 → G12 父 id;无层级形态返回 ""。 */
fn goalsParentId(id str) str {
    let m = Regex.match(id, "^(G\\d+)\\.")
    if m.length > 1 {
        return m[1]
    }
    return ""
}

/** 展平行序列:根项 + (展开时)递归子项。expanded = id→bool。 */
fn goalsTreeRows(items obj, expanded obj) list {
    let out list = []
    let ids obj = {}
    for it in items {
        ids[it.id] = true
    }
    for it in items {
        let pid = goalsParentId(it.id)
        if pid == "" || ids[pid] != true {
            goalsAppendNode(out, items, it, 0, expanded)
        }
    }
    return out
}

fn goalsAppendNode(out list, items obj, it obj, level int, expanded obj) {
    let children list = []
    for ch in items {
        if goalsParentId(ch.id) == it.id {
            children.push(ch)
        }
    }
    let cls = "goal-node is-root"
    if level > 0 {
        cls = "goal-node is-sub"
    }
    if children.length > 0 {
        cls = cls + " has-children"
    }
    let toggleCls = "node-toggle-area"
    if expanded[it.id] == true {
        toggleCls = "node-toggle-area expanded"
    }
    let e obj = { item: it, level: level, cls: cls, toggleCls: toggleCls, hasChildren: children.length > 0, childCount: children.length }
    out.push(e)
    if children.length > 0 && expanded[it.id] == true {
        for ch in children {
            goalsAppendNode(out, items, ch, level + 1, expanded)
        }
    }
}

/** PLAN-041 T3:document.sections 中 section_type 命中的 items(无命中空表)。 */
fn specSectionItems(document obj, section_type str) list {
    let out list = []
    if document == None { return out }
    let sections = document.sections ?? []
    for section in sections {
        if section.section_type == section_type {
            let items = section.items ?? []
            for it in items {
                out.push(it)
            }
        }
    }
    return out
}

// ── PLAN-041 T4:StatusTransition 辅助 ──

fn specSectionStatuses(section_type str) list {
    if section_type == "goals" { return ["empty", "proposed", "draft", "under_review", "approved", "in_progress", "implemented", "verified", "done", "archived", "rejected"] }
    if section_type == "architecture" { return ["empty", "draft", "under_review", "approved", "superseded", "outdated"] }
    if section_type == "designs" { return ["empty", "draft", "under_review", "approved", "superseded", "outdated"] }
    if section_type == "tests" { return ["empty", "draft", "implemented", "done", "verified", "blocked"] }
    if section_type == "reviews" { return ["empty", "draft", "published"] }
    if section_type == "reports" { return ["empty", "draft", "published"] }
    return ["empty", "proposed", "draft", "under_review", "approved"]
}

fn specStatusLabel(s str) str {
    return s.replace("_", " ")
}

fn specSectionIcon(t str) str {
    if t == "goals" { return "🎯" }
    if t == "architecture" { return "🏗️" }
    if t == "designs" { return "🎨" }
    if t == "plans" { return "📅" }
    if t == "tests" { return "🧪" }
    if t == "reviews" { return "📝" }
    if t == "reports" { return "📊" }
    return "📄"
}

fn treeRowClass(active bool) str {
    if active { return "tree-row active" }
    return "tree-row"
}
