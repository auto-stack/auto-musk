// wiki_nav.at — WikiNav 组件（Plan 023 队列 B6：最复杂逃生舱原生化）
//
// 对标 src/front/components/WikiNav.vue（逃生舱，已删除）。
//
// 关键转换：
//   - 6 个 emit 全小写（newpage/selectwiki/selectraw/deleteraw/newfolder/uploaded）
//     匹配父视图 @newpage/@selectwiki/... 绑定
//   - DropZone 拖拽：dragenter/dragover/dragleave/drop + .prevent 修饰符
//   - 上传（XHR + 进度回调）→ wikiUploadDrop helper + rawUploadProgress 共享 ref
//     （.at 无法存回调闭包；进度条 computed 读取共享 ref）
//   - drop handler 命名 uploaded（auto-emit 同名触发父刷新——失败时也会触发，
//     父刷新幂等，登记轻微差异）
//   - 树过滤 → wiki_helpers.at fn 模块；动态 component :is → if/else 图标切换
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.wiki-nav 等）。

component fn WikiNav(wikiTree: obj, rawTree: obj, activeWikiPath: str, activeRawPath: str, workspace: str) {
    use {
        component: Plus, PanelLeft, Search, BookOpen, FolderInput, FolderPlus, UploadCloud, Trash2, ChevronDown, ChevronRight, FileText, File from "lucide-vue-next"
        fn: wiki_filter_tree from "src/front/wiki_helpers.at"
        fn: wikiUploadDrop, rawUploadProgress from "src/front/raw_upload.ts"
        composable: useI18n refs: [locale] from "vue-i18n"
        // Plan 023 §3.1：共用 NavSidebar（wiki 导航外壳收敛）。
        component: NavSidebar
    }
    computed {
        filteredWikiTree => wiki_filter_tree(.wikiTree, .query)
        filteredRawTree => wiki_filter_tree(.rawTree, .query)
        uploadProgress => rawUploadProgress.value
        isUploading => .uploadProgress != None
        rawEmpty => .filteredRawTree.length == 0
        wikiEmpty => .filteredWikiTree.length == 0
        dropText => if .isDragging { "Drop files here" } else { "Drag files to upload" }
    }
    msg Msg { ToggleCollapsed, QueryChanged, ToggleRaw, ToggleWiki, newpage, newfolder, selectwiki(str), selectraw(str), deleteraw(str), DragEnter, DragOver, DragLeave, uploaded }
    model {
        var collapsed bool = false
        var query str = ""
        var rawExpanded bool = true
        var wikiExpanded bool = true
        var isDragging bool = false
    }
    on {
        .ToggleCollapsed -> { .collapsed = !.collapsed }
        .QueryChanged -> {}
        .ToggleRaw -> { .rawExpanded = !.rawExpanded }
        .ToggleWiki -> { .wikiExpanded = !.wikiExpanded }
        .newpage -> {}
        .newfolder -> {}
        .selectwiki(path) -> {}
        .selectraw(path) -> {}
        .deleteraw(path) -> {}
        .DragEnter -> { .isDragging = true }
        .DragOver -> {}
        .DragLeave -> { .isDragging = false }
        .uploaded(e) -> {
            .isDragging = false;
            wikiUploadDrop(.workspace, e).await
        }
    }
    // Plan 029 T22：原 inject_styles 全局兜底下放（scoped 生效于本组件 DOM）。
    style {
  .wiki-search {
    display: flex; align-items: center; gap: 0.35rem;
    margin: 0.5rem 0.5rem; padding: 0.3rem 0.6rem;
    background: hsl(var(--muted-foreground) / 0.06);
    border: 1px solid hsl(var(--muted-foreground) / 0.12);
    border-radius: 6px; color: hsl(var(--muted-foreground));
  }
  .wiki-search:focus-within { border-color: hsl(var(--primary) / 0.35); }
  .wiki-search-input { border: none; background: transparent; outline: none; font-size: 0.8rem; color: hsl(var(--foreground)); width: 100%; }
  .wiki-search-input::placeholder { color: hsl(var(--muted-foreground)); }
  .wiki-nav-list { padding: 0 0.25rem; }
  .tree-section { margin-bottom: 0.25rem; }
  .tree-section-header {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.35rem 0.5rem; cursor: pointer; border-radius: 4px;
    color: hsl(var(--muted-foreground)); font-size: 0.75rem; font-weight: 600;
  }
  .tree-section-header:hover { background: hsl(var(--accent)); }
  .tree-section-title { flex: 1; }
  .tree-section-body { padding-left: 0.75rem; }
  .tree-item {
    display: flex; align-items: center; gap: 0.35rem;
    width: 100%; padding: 0.25rem 0.5rem; border: none; border-radius: 4px;
    background: transparent; color: hsl(var(--foreground)); font-size: 0.8rem;
    cursor: pointer; text-align: left;
  }
  .tree-item:hover { background: hsl(var(--accent)); }
  .tree-item.active { background: hsl(var(--primary) / 0.08); color: hsl(var(--primary)); }
  .tree-item-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .tree-item-del {
    display: none; align-items: center; justify-content: center;
    width: 18px; height: 18px; border: none; border-radius: 4px;
    background: transparent; color: hsl(var(--muted-foreground)); cursor: pointer; padding: 0;
  }
  .tree-item:hover .tree-item-del { display: flex; }
  .tree-item-del:hover { background: hsl(var(--destructive) / 0.12); color: hsl(var(--destructive)); }
  .tree-empty { display: flex; align-items: center; gap: 0.4rem; padding: 0.5rem; color: hsl(var(--muted-foreground)); font-size: 0.75rem; }
  .drop-zone {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.3rem; padding: 0.5rem; margin: 0.25rem 0.25rem 0.5rem;
    border: 1px dashed hsl(var(--border)); border-radius: 6px;
    color: hsl(var(--muted-foreground)); transition: all 0.15s; cursor: pointer;
  }
  .drop-zone.active { border-color: hsl(var(--primary)); background: hsl(var(--primary) / 0.04); color: hsl(var(--primary)); }
  .drop-text { font-size: 0.72rem; }
  .progress-bar { width: 100%; height: 3px; background: hsl(var(--muted-foreground) / 0.1); border-radius: 2px; overflow: hidden; }
  .progress-fill { height: 100%; background: hsl(var(--primary)); transition: width 0.2s; }
    }

    NavSidebar {
        title: i18n.t("wiki.title")
        collapsed: .collapsed
        slot(name: "actions") {
            div {
                style: "wiki-nav-actions"
                button {
                    onclick: .newpage
                    style: "nav-icon-btn"
                    title: i18n.t("wiki.newPage")
                    Plus { size: 14 }
                }
                button {
                    onclick: .ToggleCollapsed
                    style: "nav-icon-btn"
                    title: i18n.t("wiki.toggleSidebar")
                    PanelLeft { size: 14 }
                }
            }
        }
        slot(name: "list") {
            // 搜索框
            div {
                style: "wiki-search"
                Search { size: 13 }
                input {
                    value: .query
                    oninput: .QueryChanged
                    type: "text"
                    style: "wiki-search-input"
                    placeholder: i18n.t("wiki.searchPlaceholder")
                }
            }
            // tree list
            if !.collapsed {
                div {
                    style: "wiki-nav-list"
                // ── Raw section ──
                div {
                    style: "tree-section"
                    div {
                        onclick: .ToggleRaw
                        style: "tree-section-header"
                        if .rawExpanded {
                            ChevronDown { size: 12 }
                        } else {
                            ChevronRight { size: 12 }
                        }
                        FolderInput { size: 13 }
                        span {
                            style: "tree-section-title"
                            text i18n.t("wiki.raw")
                        }
                        button {
                            onclick.stop: .newfolder
                            style: "nav-icon-btn"
                            title: i18n.t("wiki.newFolder")
                            FolderPlus { size: 13 }
                        }
                    }
                    if .rawExpanded {
                        div {
                            style: "tree-section-body"
                            // DropZone
                            div {
                                class: if .isDragging { "drop-zone active" } else { "drop-zone" }
                                ondragenter.prevent: .DragEnter
                                ondragover.prevent: .DragOver
                                ondragleave.prevent: .DragLeave
                                ondrop.prevent: .uploaded($event)
                                UploadCloud { size: 14 }
                                span { style: "drop-text", text .dropText }
                                if .isUploading {
                                    div {
                                        style: "progress-bar"
                                        div {
                                            class: "progress-fill"
                                            style: "width: " + .uploadProgress + "%"
                                        }
                                    }
                                }
                            }
                            for node in .filteredRawTree {
                                button {
                                    onclick: .selectraw(.node.path)
                                    key: .node.path
                                    class: if .activeRawPath == .node.path { "tree-item active" } else { "tree-item" }
                                    File { size: 12 }
                                    span { style: "tree-item-name", text .node.name }
                                    button {
                                        onclick.stop: .deleteraw(.node.path)
                                        style: "tree-item-del"
                                        title: i18n.t("common.delete")
                                        Trash2 { size: 12 }
                                    }
                                }
                            }
                            if .rawEmpty {
                                div {
                                    style: "tree-empty"
                                    FileText { size: 14 }
                                    span { text i18n.t("wiki.noPages") }
                                }
                            }
                        }
                    }
                }
                // ── Wiki section ──
                div {
                    style: "tree-section"
                    div {
                        onclick: .ToggleWiki
                        style: "tree-section-header"
                        if .wikiExpanded {
                            ChevronDown { size: 12 }
                        } else {
                            ChevronRight { size: 12 }
                        }
                        BookOpen { size: 13 }
                        span {
                            style: "tree-section-title"
                            text i18n.t("wiki.title")
                        }
                    }
                    if .wikiExpanded {
                        div {
                            style: "tree-section-body"
                            for node in .filteredWikiTree {
                                button {
                                    onclick: .selectwiki(.node.path)
                                    key: .node.path
                                    class: if .activeWikiPath == .node.path { "tree-item active" } else { "tree-item" }
                                    FileText { size: 12 }
                                    span { style: "tree-item-name", text .node.name }
                                }
                            }
                            if .wikiEmpty {
                                div {
                                    style: "tree-empty"
                                    FileText { size: 14 }
                                    span { text i18n.t("wiki.noPages") }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
