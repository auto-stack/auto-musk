// wiki_nav.at — WikiNav 组件（Plan 023 队列 B6：最复杂逃生舱原生化）
//
// 对标 src/front/components/WikiNav.vue（逃生舱，已删除）。
//
// 关键转换：
//   - 6 个 emit 全小写（newpage/selectwiki/selectraw/deleteraw/newfolder/uploaded）
//     匹配父视图 @newpage/@selectwiki/... 绑定
//   - DropZone 拖拽：dragenter/dragover/dragleave/drop + .prevent 修饰符
//   - 上传（XHR + 进度回调）→ wikiUploadDrop helper + rawUploadProgress 共享 ref
//     （.at 无法存回调闭包；进度条 computed 读取共享 ref）
//   - drop handler 命名 uploaded（auto-emit 同名触发父刷新——失败时也会触发，
//     父刷新幂等，登记轻微差异）
//   - 树过滤 → wiki_helpers.at fn 模块；动态 component :is → if/else 图标切换
//
// 样式：PLAN-049 T7 双轨收敛——wiki 树/搜索/dropzone 迁内联工具类。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component Plus, PanelLeft, Search, BookOpen, FolderInput, FolderPlus, UploadCloud, Trash2, ChevronDown, ChevronRight, FileText, File from "src/front/ports/icons.at"
use.web wiki_filter_tree from "src/front/wiki_helpers.at"
use.web wikiUploadDrop, rawUploadProgress from "src/front/ports/upload.at"
use.web useI18n from "src/front/ports/composables.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use nav_sidebar: NavSidebar

widget WikiNav(wikiTree: obj, rawTree: obj, activeWikiPath: str, activeRawPath: str, workspace: str) {

    setup {
        let i18n = useI18n()
        refs i18n: [locale]
    }
    computed {
        filteredWikiTree => wiki_filter_tree(.wikiTree, .query)
        filteredRawTree => wiki_filter_tree(.rawTree, .query)
        uploadProgress => rawUploadProgress.value
        isUploading => .uploadProgress != None
        rawEmpty => .filteredRawTree.length == 0
        wikiEmpty => .filteredWikiTree.length == 0
        dropText => if .isDragging { "Drop files here" } else { "Drag files to upload" }
    }
    msg Msg { ToggleCollapsed, QueryChanged, ToggleRaw, ToggleWiki, newpage, newfolder, selectwiki(str), selectraw(str), deleteraw(str), DragEnter, DragOver, DragLeave, uploaded }
    model {
        var collapsed bool = false
        var query str = ""
        var rawExpanded bool = true
        var wikiExpanded bool = true
        var isDragging bool = false
    }
    on {
        .ToggleCollapsed -> { .collapsed = !.collapsed }
        .QueryChanged -> {}
        .ToggleRaw -> { .rawExpanded = !.rawExpanded }
        .ToggleWiki -> { .wikiExpanded = !.wikiExpanded }
        .newpage -> {}
        .newfolder -> {}
        .selectwiki(path) -> {}
        .selectraw(path) -> {}
        .deleteraw(path) -> {}
        .DragEnter -> { .isDragging = true }
        .DragOver -> {}
        .DragLeave -> { .isDragging = false }
        .uploaded(e) -> {
            .isDragging = false;
            wikiUploadDrop(.workspace, e).await
        }
    }
    // PLAN-049 T7：wiki 搜索/树/dropzone/进度条样式已迁内联工具类（块删除）。
    // tree-item-del 悬停显隐与搜索 placeholder 色为 web-only
    //（inject_styles.ts 暂存段,T8 拆出）;focus-within/transition 走变体白名单。

    view {
        NavSidebar {
            title: i18n.t("wiki.title")
            collapsed: .collapsed
            width_class: "w-[240px]"
            slot(name: "actions") {
                div {
                    style: "flex gap-1"
                    button {
                        onclick: .newpage
                        style: "w-7 h-7 inline-flex items-center justify-center border border-border rounded-md bg-transparent cursor-pointer text-foreground text-base hover:bg-accent"
                        title: i18n.t("wiki.newPage")
                        Plus { size: 14 }
                    }
                    button {
                        onclick: .ToggleCollapsed
                        style: "w-7 h-7 inline-flex items-center justify-center border border-border rounded-md bg-transparent cursor-pointer text-foreground text-base hover:bg-accent"
                        title: i18n.t("wiki.toggleSidebar")
                        PanelLeft { size: 14 }
                    }
                }
            }
            slot(name: "list") {
                // 搜索框
                div {
                    style: "flex items-center gap-[5px] mx-2 my-2 px-[10px] py-[5px] bg-muted-foreground/5 border border-muted-foreground/10 rounded-md text-muted-foreground focus-within:border-primary/35"
                    Search { size: 13 }
                    input {
                        value: .query
                        oninput: .QueryChanged
                        type: "text"
                        style: "border-none bg-transparent outline-none text-[13px] text-foreground w-full placeholder:text-muted-foreground"
                        placeholder: i18n.t("wiki.searchPlaceholder")
                    }
                }
                // tree list
                if !.collapsed {
                    div {
                        style: "flex-1 overflow-y-auto px-1"
                    // ── Raw section ──
                    div {
                        style: "mb-1"
                        div {
                            onclick: .ToggleRaw
                            style: "flex items-center gap-[5px] py-1.5 px-2 cursor-pointer rounded bg-transparent text-muted-foreground text-xs font-semibold hover:bg-accent"
                            if .rawExpanded {
                                ChevronDown { size: 12 }
                            } else {
                                ChevronRight { size: 12 }
                            }
                            FolderInput { size: 13 }
                            span {
                                style: "flex-1"
                                text i18n.t("wiki.raw")
                            }
                            button {
                                onclick.stop: .newfolder
                                style: "w-7 h-7 inline-flex items-center justify-center border border-border rounded-md bg-transparent cursor-pointer text-foreground text-base hover:bg-accent"
                                title: i18n.t("wiki.newFolder")
                                FolderPlus { size: 13 }
                            }
                        }
                        if .rawExpanded {
                            div {
                                style: "pl-3"
                                // DropZone
                                div {
                                    class: if .isDragging { "flex flex-col items-center justify-center gap-[5px] p-2 mx-1 mt-1 mb-2 border border-dashed border-primary rounded-md text-primary bg-primary/5 cursor-pointer" } else { "flex flex-col items-center justify-center gap-[5px] p-2 mx-1 mt-1 mb-2 border border-dashed border-border rounded-md text-muted-foreground cursor-pointer" }
                                    ondragenter.prevent: .DragEnter
                                    ondragover.prevent: .DragOver
                                    ondragleave.prevent: .DragLeave
                                    ondrop.prevent: .uploaded($event)
                                    UploadCloud { size: 14 }
                                    span { style: "text-xs", text .dropText }
                                    if .isUploading {
                                        div {
                                            style: "w-full h-[3px] bg-muted-foreground/10 rounded-[2px] overflow-hidden"
                                            div {
                                                class: "progress-fill"
                                                style: "width: " + .uploadProgress + "%"
                                            }
                                        }
                                    }
                                }
                                for node in .filteredRawTree {
                                    button {
                                        onclick: .selectraw(.node.path)
                                        key: .node.path
                                        class: if .activeRawPath == .node.path { "flex items-center gap-[5px] w-full py-1 px-2 border-none rounded bg-primary/10 text-primary text-[13px] cursor-pointer text-left" } else { "flex items-center gap-[5px] w-full py-1 px-2 border-none rounded bg-transparent text-foreground text-[13px] cursor-pointer text-left hover:bg-accent" }
                                        File { size: 12 }
                                        span { style: "truncate flex-1", text .node.name }
                                        // PLAN-061 T8 (D7):内层删除钮改 span 形态
                                        // ——button 嵌 button 违 HTML 规范(vite
                                        // 每编译告警,浏览器提前闭合外层致布局/
                                        // 交互不可靠);span + onclick.stop 同语义
                                        // (头部 div onclick 先例证普通元素可挂)。
                                        span {
                                            onclick.stop: .deleteraw(.node.path)
                                            style: "flex items-center justify-center w-[18px] h-[18px] shrink-0 rounded bg-transparent text-muted-foreground cursor-pointer p-0 hover:text-foreground"
                                            title: i18n.t("common.delete")
                                            Trash2 { size: 12 }
                                        }
                                    }
                                }
                                if .rawEmpty {
                                    div {
                                        style: "flex items-center gap-1.5 p-2 text-muted-foreground text-xs"
                                        FileText { size: 14 }
                                        span { text i18n.t("wiki.noPages") }
                                    }
                                }
                            }
                        }
                    }
                    // ── Wiki section ──
                    div {
                        style: "mb-1"
                        div {
                            onclick: .ToggleWiki
                            style: "flex items-center gap-[5px] py-1.5 px-2 cursor-pointer rounded bg-transparent text-muted-foreground text-xs font-semibold hover:bg-accent"
                            if .wikiExpanded {
                                ChevronDown { size: 12 }
                            } else {
                                ChevronRight { size: 12 }
                            }
                            BookOpen { size: 13 }
                            span {
                                style: "flex-1"
                                text i18n.t("wiki.title")
                            }
                        }
                        if .wikiExpanded {
                            div {
                                style: "pl-3"
                                for node in .filteredWikiTree {
                                    button {
                                        onclick: .selectwiki(.node.path)
                                        key: .node.path
                                        class: if .activeWikiPath == .node.path { "flex items-center gap-[5px] w-full py-1 px-2 border-none rounded bg-primary/10 text-primary text-[13px] cursor-pointer text-left" } else { "flex items-center gap-[5px] w-full py-1 px-2 border-none rounded bg-transparent text-foreground text-[13px] cursor-pointer text-left hover:bg-accent" }
                                        FileText { size: 12 }
                                        span { style: "truncate flex-1", text .node.name }
                                    }
                                }
                                if .wikiEmpty {
                                    div {
                                        style: "flex items-center gap-1.5 p-2 text-muted-foreground text-xs"
                                        FileText { size: 14 }
                                        span { text i18n.t("wiki.noPages") }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
