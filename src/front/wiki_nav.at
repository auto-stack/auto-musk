// wiki_nav.at — WikiNav 组件（Plan 023 队列 B6：最复杂逃生舱原生化）
//
// 对标 src/front/components/WikiNav.vue（逃生舱，已删除）。
//
// 关键转换：
//   - 6 个 emit 全小写（newpage/selectwiki/selectraw/deleteraw/newfolder/uploaded）
//     匹配父视图 @newpage/@selectwiki/... 绑定
//   - DropZone 拖拽：dragenter/dragover/dragleave/drop + .prevent 修饰符
//   - 上传（XHR + 进度回调）→ wikiUploadDrop helper + rawUploadProgress 共享 ref
//     （.at 无法存回调闭包；进度条 computed 读取共享 ref）
//   - drop handler 命名 uploaded（auto-emit 同名触发父刷新——失败时也会触发，
//     父刷新幂等，登记轻微差异）
//   - 树过滤 → wiki_helpers.ts fn；动态 component :is → if/else 图标切换
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.wiki-nav 等）。

component fn WikiNav(wikiTree: obj, rawTree: obj, activeWikiPath: str, activeRawPath: str, workspace: str) {
    use {
        component: Plus, PanelLeft, Search, BookOpen, FolderInput, FolderPlus, UploadCloud, Trash2, ChevronDown, ChevronRight, FileText, File from "lucide-vue-next"
        fn: wikiFilterTree from "src/front/wiki_helpers.ts"
        fn: wikiUploadDrop, rawUploadProgress from "src/front/raw_upload.ts"
        composable: useI18n refs: [locale] from "vue-i18n"
        // Plan 023 §3.1：共用 NavSidebar（wiki 导航外壳收敛）。
        component: NavSidebar
    }
    computed {
        filteredWikiTree => wikiFilterTree(.wikiTree, .query)
        filteredRawTree => wikiFilterTree(.rawTree, .query)
        uploadProgress => rawUploadProgress.value
        isUploading => .uploadProgress != None
        rawEmpty => .filteredRawTree.length == 0
        wikiEmpty => .filteredWikiTree.length == 0
        dropText => if .isDragging { "Drop files here" } else { "Drag files to upload" }
    }
    msg Msg { ToggleCollapsed, QueryChanged, ToggleRaw, ToggleWiki, newpage, newfolder, selectwiki(str), selectraw(str), deleteraw(str), DragEnter, DragOver, DragLeave, uploaded }
    model {
        var collapsed bool = false
        var query str = ""
        var rawExpanded bool = true
        var wikiExpanded bool = true
        var isDragging bool = false
    }
    on {
        .ToggleCollapsed -> { .collapsed = !.collapsed }
        .QueryChanged -> {}
        .ToggleRaw -> { .rawExpanded = !.rawExpanded }
        .ToggleWiki -> { .wikiExpanded = !.wikiExpanded }
        .newpage -> {}
        .newfolder -> {}
        .selectwiki(path) -> {}
        .selectraw(path) -> {}
        .deleteraw(path) -> {}
        .DragEnter -> { .isDragging = true }
        .DragOver -> {}
        .DragLeave -> { .isDragging = false }
        .uploaded(e) -> {
            .isDragging = false;
            wikiUploadDrop(.workspace, e).await
        }
    }
    NavSidebar {
        title: i18n.t("wiki.title")
        collapsed: .collapsed
        slot(name: "actions") {
            div {
                style: "wiki-nav-actions"
                button {
                    onclick: .newpage
                    style: "nav-icon-btn"
                    title: i18n.t("wiki.newPage")
                    Plus { size: 14 }
                }
                button {
                    onclick: .ToggleCollapsed
                    style: "nav-icon-btn"
                    title: i18n.t("wiki.toggleSidebar")
                    PanelLeft { size: 14 }
                }
            }
        }
        slot(name: "list") {
            // 搜索框
            div {
                style: "wiki-search"
                Search { size: 13 }
                input {
                    value: .query
                    oninput: .QueryChanged
                    type: "text"
                    style: "wiki-search-input"
                    placeholder: i18n.t("wiki.searchPlaceholder")
                }
            }
            // tree list
            if !.collapsed {
                div {
                    style: "wiki-nav-list"
                // ── Raw section ──
                div {
                    style: "tree-section"
                    div {
                        onclick: .ToggleRaw
                        style: "tree-section-header"
                        if .rawExpanded {
                            ChevronDown { size: 12 }
                        } else {
                            ChevronRight { size: 12 }
                        }
                        FolderInput { size: 13 }
                        span {
                            style: "tree-section-title"
                            text i18n.t("wiki.raw")
                        }
                        button {
                            onclick.stop: .newfolder
                            style: "nav-icon-btn"
                            title: i18n.t("wiki.newFolder")
                            FolderPlus { size: 13 }
                        }
                    }
                    if .rawExpanded {
                        div {
                            style: "tree-section-body"
                            // DropZone
                            div {
                                class: if .isDragging { "drop-zone active" } else { "drop-zone" }
                                ondragenter.prevent: .DragEnter
                                ondragover.prevent: .DragOver
                                ondragleave.prevent: .DragLeave
                                ondrop.prevent: .uploaded($event)
                                UploadCloud { size: 14 }
                                span { style: "drop-text", text .dropText }
                                if .isUploading {
                                    div {
                                        style: "progress-bar"
                                        div {
                                            class: "progress-fill"
                                            style: "width: " + .uploadProgress + "%"
                                        }
                                    }
                                }
                            }
                            for node in .filteredRawTree {
                                button {
                                    onclick: .selectraw(.node.path)
                                    key: .node.path
                                    class: if .activeRawPath == .node.path { "tree-item active" } else { "tree-item" }
                                    File { size: 12 }
                                    span { style: "tree-item-name", text .node.name }
                                    button {
                                        onclick.stop: .deleteraw(.node.path)
                                        style: "tree-item-del"
                                        title: i18n.t("common.delete")
                                        Trash2 { size: 12 }
                                    }
                                }
                            }
                            if .rawEmpty {
                                div {
                                    style: "tree-empty"
                                    FileText { size: 14 }
                                    span { text i18n.t("wiki.noPages") }
                                }
                            }
                        }
                    }
                }
                // ── Wiki section ──
                div {
                    style: "tree-section"
                    div {
                        onclick: .ToggleWiki
                        style: "tree-section-header"
                        if .wikiExpanded {
                            ChevronDown { size: 12 }
                        } else {
                            ChevronRight { size: 12 }
                        }
                        BookOpen { size: 13 }
                        span {
                            style: "tree-section-title"
                            text i18n.t("wiki.title")
                        }
                    }
                    if .wikiExpanded {
                        div {
                            style: "tree-section-body"
                            for node in .filteredWikiTree {
                                button {
                                    onclick: .selectwiki(.node.path)
                                    key: .node.path
                                    class: if .activeWikiPath == .node.path { "tree-item active" } else { "tree-item" }
                                    FileText { size: 12 }
                                    span { style: "tree-item-name", text .node.name }
                                }
                            }
                            if .wikiEmpty {
                                div {
                                    style: "tree-empty"
                                    FileText { size: 14 }
                                    span { text i18n.t("wiki.noPages") }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
