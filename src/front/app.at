// app.at — auto-musk 前端入口根 widget（Plan 022 Phase 5 骨架）
//
// 对应 web/src/App.vue。auth guard + view rail + view 切换。
// 注意: 字段名用 current_view 而非 view（view 是 AutoUI 保留关键字）。

use store: AuthStore
use login: LoginPage
use specs_view: SpecsView
use wiki_view: WikiView
use chats_view: ChatsView
use plans_view: PlansView

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web setupAuthFetch from "src/front/setup_auth_fetch.ts"
use.web injectStyles from "src/front/inject_styles.ts"
use.web ensure_workspace from "src/front/workspace_helpers.at"
use.web composable useT from "src/front/composables/useT.ts"
use.web composable useGateRouter from "src/front/composables/gate_router.ts"
use.web component MessageSquare, ListTodo, Scroll, BookOpen from "lucide-vue-next"

widget App {
    use {
        component: WorkspaceSelector
        component: SettingsMenu
    }

    msg Msg {
        Init,
        ShowChats,
        ShowPlans,
        ShowSpecs,
        ShowWiki,
        GlobalKeydown,
    }

    model {
        // 当前视图（chats/specs/wiki）。不用 view（保留字）。
        var current_view str = "chats"
    }

    view {
        if store.authenticated != true {
            LoginPage
        } else {
            row {
                style: "h-screen w-full"
                // Plan 029 T20：全局快捷键挂视图根（见 .GlobalKeydown）。
                onkeydown: .GlobalKeydown($event)
                // view rail（侧边导航栏）
                // Plan 407：text 节点 t() 化 + WorkspaceSelector 逃生舱接入（原生支持）。
                col {
                    style: "w-48 shrink-0 bg-card border-r border-border gap-3 px-3 pb-3 pt-0 h-full"
                    row {
                        style: "app-header px-0 gap-2 items-baseline"
                        text t("app.brandName") { style: "text-base font-bold text-primary" }
                        text t("app.version") { style: "text-xs text-muted-foreground" }
                    }
                    col {
                        style: "gap-1"
                        button {
                            onclick: .ShowChats
                            style: if .current_view == "chats" {
                                "rail-tab active"
                            } else {
                                "rail-tab"
                            }
                            MessageSquare { size: 16 }
                            text t("nav.chat")
                        }
                        button {
                            onclick: .ShowPlans
                            style: if .current_view == "plans" {
                                "rail-tab active"
                            } else {
                                "rail-tab"
                            }
                            ListTodo { size: 16 }
                            text t("nav.plans")
                        }
                        button {
                            onclick: .ShowSpecs
                            style: if .current_view == "specs" {
                                "rail-tab active"
                            } else {
                                "rail-tab"
                            }
                            Scroll { size: 16 }
                            text t("nav.specs")
                        }
                        button {
                            onclick: .ShowWiki
                            style: if .current_view == "wiki" {
                                "rail-tab active"
                            } else {
                                "rail-tab"
                            }
                            BookOpen { size: 16 }
                            text t("nav.wiki")
                        }
                    }
                    // Plan 407：WorkspaceSelector + SettingsMenu 在导航栏底部。
                    row {
                        style: "rail-footer"
                        WorkspaceSelector
                        SettingsMenu
                    }
                }
                // view main（v-if 切换视图）
                col {
                    style: "flex-1 min-h-0 min-w-0 overflow-hidden"
                    if .current_view == "plans" {
                        PlansView
                    } else if .current_view == "specs" {
                        SpecsView
                    } else if .current_view == "wiki" {
                        WikiView
                    } else {
                        ChatsView
                    }
                }
            }
        }
    }

    on {
        .Init -> { injectStyles(); setupAuthFetch(); store.Init() }
        .ShowChats -> { .current_view = "chats" }
        // Plan 029 T20：全局快捷键（原 useKeyboardShortcuts composable）。
        // Ctrl/Cmd+Shift+S 聚焦搜索框；Ctrl/Cmd+Shift+N 点新建会话按钮。
        // 监听挂在视图根元素（document 级监听不可表达——焦点需在应用内，
        // 实际等价：快捷键的目标元素都在应用内）。
        .GlobalKeydown(e) -> {
            if (e.ctrlKey || e.metaKey) && e.shiftKey {
                if e.key.to_lower() == "s" {
                    e.preventDefault();
                    dom.focus_first(".search-input")
                } else {
                    if e.key.to_lower() == "n" {
                        e.preventDefault();
                        dom.click_first(".sidebar-new-btn")
                    }
                }
            }
        }
        .ShowPlans -> { .current_view = "plans" }
        .ShowSpecs -> { .current_view = "specs" }
        .ShowWiki -> { .current_view = "wiki" }
    }
}
