// app.at — auto-musk 前端入口根 widget（Plan 022 Phase 5 骨架）
//
// 对应 web/src/App.vue。auth guard + view rail + view 切换。
// 注意: 字段名用 current_view 而非 view（view 是 AutoUI 保留关键字）。

use store: AuthStore
use login: LoginPage
use specs_view: SpecsView
use wiki_view: WikiView
use chats_view: ChatsView

widget App {
    use {
        fn: setupAuthFetch from "src/front/setup_auth_fetch.ts"
        fn: injectStyles from "src/front/inject_styles.ts"
        fn: ensureWorkspace from "src/front/ensure_workspace.ts"
        // Plan 407：i18n t() + WorkspaceSelector 接入（parser 增强后原生支持）。
        // t 走 composable 包装（vue-i18n 的 t 是 useI18n() 解构返回值，非静态导出）。
        // codegen: import { useT } + const t = useT()（去 use 前缀小写得变量名 t）。
        composable: useT from "src/front/composables/useT.ts"
        // Plan 022 视觉对齐：主题 + 强调色切换 composable。
        composable: useTheme from "src/front/composables/useTheme.ts"
        composable: useAccentColor from "src/front/composables/useAccentColor.ts"
        component: WorkspaceSelector from "src/front/components/WorkspaceSelector.vue"
        component: SettingsMenu from "src/front/components/SettingsMenu.vue"
    }

    msg Msg {
        Init,
        ShowChats,
        ShowSpecs,
        ShowWiki,
    }

    model {
        // 当前视图（chats/specs/wiki）。不用 view（保留字）。
        var current_view str = "chats"
    }

    view {
        if store.authenticated != true {
            LoginPage
        } else {
            row {
                style: "h-screen w-full"
                // view rail（侧边导航栏）
                // Plan 407：text 节点 t() 化 + WorkspaceSelector 逃生舱接入（原生支持）。
                col {
                    style: "w-48 shrink-0 bg-card border-r border-border gap-3 p-3 h-full"
                    row {
                        style: "app-header px-2 py-1 gap-2 items-baseline"
                        text t("app.brandName") { style: "text-base font-bold text-primary" }
                        text t("app.version") { style: "text-xs text-muted-foreground" }
                    }
                    col {
                        style: "gap-1"
                        button {
                            onclick: .ShowChats
                            style: "w-full text-left px-3 py-2 rounded-md text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors bg-transparent border-none cursor-pointer"
                            text t("nav.chat")
                        }
                        button {
                            onclick: .ShowSpecs
                            style: "w-full text-left px-3 py-2 rounded-md text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors bg-transparent border-none cursor-pointer"
                            text t("nav.specs")
                        }
                        button {
                            onclick: .ShowWiki
                            style: "w-full text-left px-3 py-2 rounded-md text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors bg-transparent border-none cursor-pointer"
                            text t("nav.wiki")
                        }
                    }
                    // Plan 407：WorkspaceSelector + SettingsMenu 在导航栏底部。
                    row {
                        style: "rail-footer"
                        WorkspaceSelector
                        SettingsMenu
                    }
                }
                // view main（v-if 切换视图）
                col {
                    style: "flex-1 min-h-0 min-w-0 overflow-hidden"
                    if .current_view == "specs" {
                        SpecsView
                    } else if .current_view == "wiki" {
                        WikiView
                    } else {
                        ChatsView
                    }
                }
            }
        }
    }

    on {
        .Init -> { injectStyles(); setupAuthFetch(); store.Init() }
        .ShowChats -> { .current_view = "chats" }
        .ShowSpecs -> { .current_view = "specs" }
        .ShowWiki -> { .current_view = "wiki" }
    }
}
