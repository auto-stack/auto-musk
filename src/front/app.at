// app.at — auto-musk 前端入口根 widget（Plan 022 Phase 5 骨架）
//
// 对应 web/src/App.vue。auth guard + view rail + view 切换。
// 注意: 字段名用 current_view 而非 view（view 是 AutoUI 保留关键字）。

use store: AuthStore
use login: LoginPage
use specs_view: SpecsView
use wiki_view: WikiView
use chats_view: ChatsView
use plans_view: PlansView

widget App {
    use {
        fn: setupAuthFetch from "src/front/setup_auth_fetch.ts"
        fn: injectStyles from "src/front/inject_styles.ts"
        fn: ensureWorkspace from "src/front/ensure_workspace.ts"
        // Plan 407：i18n t() + WorkspaceSelector 接入（parser 增强后原生支持）。
        // t 走 composable 包装（vue-i18n 的 t 是 useI18n() 解构返回值，非静态导出）。
        // codegen: import { useT } + const t = useT()（去 use 前缀小写得变量名 t）。
        composable: useT from "src/front/composables/useT.ts"
        // Plan 022 视觉对齐：主题 + 强调色切换 composable。
        composable: useTheme from "src/front/composables/useTheme.ts"
        composable: useAccentColor from "src/front/composables/useAccentColor.ts"
        // workspace_helpers 是 WorkspaceSelector component fn 的 use{fn} 依赖，
        // 声明仅为触发 ext 复制（codegen ext 复制只看 use 块，不看 component fn 的 use{fn}）。
        fn: loadRecentWorkspaces, loadCurrentWorkspace, findWorkspace from "src/front/workspace_helpers.ts"
        // Plan 023 队列 A2：WorkspaceSelector 已原生化为 component fn
        // （src/front/workspace_selector.at），逃生舱 .vue 已删除。跨文件引用（无 from）。
        component: WorkspaceSelector
        // settings_helpers 是 SettingsMenu component fn 的 use{fn} 依赖，声明仅为触发 ext 复制。
        fn: settingsInitLocale, settingsChangeLocale, settingsLoadForgeMode, settingsSetForgeMode, settingsOpenAutoOs from "src/front/settings_helpers.ts"
        // Plan 023 队列 A4：SettingsMenu 已原生化为 component fn（src/front/settings_menu.at），
        // 逃生舱 .vue 已删除。跨文件引用（无 from）。
        component: SettingsMenu
        // 导航图标（lucide）
        component: MessageSquare, ListTodo, Scroll, BookOpen from "lucide-vue-next"
    }

    msg Msg {
        Init,
        ShowChats,
        ShowPlans,
        ShowSpecs,
        ShowWiki,
    }

    model {
        // 当前视图（chats/specs/wiki）。不用 view（保留字）。
        var current_view str = "chats"
    }

    view {
        if store.authenticated != true {
            LoginPage
        } else {
            row {
                style: "h-screen w-full"
                // view rail（侧边导航栏）
                // Plan 407：text 节点 t() 化 + WorkspaceSelector 逃生舱接入（原生支持）。
                col {
                    style: "w-48 shrink-0 bg-card border-r border-border gap-3 px-3 pb-3 pt-0 h-full"
                    row {
                        style: "app-header px-0 gap-2 items-baseline"
                        text t("app.brandName") { style: "text-base font-bold text-primary" }
                        text t("app.version") { style: "text-xs text-muted-foreground" }
                    }
                    col {
                        style: "gap-1"
                        button {
                            onclick: .ShowChats
                            style: if .current_view == "chats" {
                                "rail-tab active"
                            } else {
                                "rail-tab"
                            }
                            MessageSquare { size: 16 }
                            text t("nav.chat")
                        }
                        button {
                            onclick: .ShowPlans
                            style: if .current_view == "plans" {
                                "rail-tab active"
                            } else {
                                "rail-tab"
                            }
                            ListTodo { size: 16 }
                            text t("nav.plans")
                        }
                        button {
                            onclick: .ShowSpecs
                            style: if .current_view == "specs" {
                                "rail-tab active"
                            } else {
                                "rail-tab"
                            }
                            Scroll { size: 16 }
                            text t("nav.specs")
                        }
                        button {
                            onclick: .ShowWiki
                            style: if .current_view == "wiki" {
                                "rail-tab active"
                            } else {
                                "rail-tab"
                            }
                            BookOpen { size: 16 }
                            text t("nav.wiki")
                        }
                    }
                    // Plan 407：WorkspaceSelector + SettingsMenu 在导航栏底部。
                    row {
                        style: "rail-footer"
                        WorkspaceSelector
                        SettingsMenu
                    }
                }
                // view main（v-if 切换视图）
                col {
                    style: "flex-1 min-h-0 min-w-0 overflow-hidden"
                    if .current_view == "plans" {
                        PlansView
                    } else if .current_view == "specs" {
                        SpecsView
                    } else if .current_view == "wiki" {
                        WikiView
                    } else {
                        ChatsView
                    }
                }
            }
        }
    }

    on {
        .Init -> { injectStyles(); setupAuthFetch(); store.Init() }
        .ShowChats -> { .current_view = "chats" }
        .ShowPlans -> { .current_view = "plans" }
        .ShowSpecs -> { .current_view = "specs" }
        .ShowWiki -> { .current_view = "wiki" }
    }
}
