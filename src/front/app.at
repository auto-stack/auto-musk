// app.at — auto-musk 前端入口根 widget（Plan 022 Phase 5 骨架）
//
// 对应 web/src/App.vue。auth guard + view rail + view 切换。
// 注意: 字段名用 current_view 而非 view（view 是 AutoUI 保留关键字）。

use store: AuthStore
use login: LoginPage
use specs_view: SpecsView
use wiki_view: WikiView
use chats_view: ChatsView
use plans_view: PlansView
use files_view: FilesView
use whitelist_view: WhitelistView

// PLAN-037 Phase 3: web ecosystem imports (use.web).
// PLAN-081: platformRefreshAuth 增入——boot 解析回填前重注入 VM 默认 query。
use.web platformInjectStyles, platformSetupAuthFetch, platformRefreshAuth from "src/front/ports/platform.at"
use.web ensure_workspace, ws_resolve_current from "src/front/workspace_helpers.at"
use.web useT from "src/front/ports/composables.at"
use.web useGateRouter from "src/front/ports/composables.at"
// PLAN-041 T8:URL 路由桥(popstate→rail 点击;vsSetView pushState)。
use.web useViewRouter, vsCurrentView, vsSetView from "src/front/ports/composables.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use workspace_selector: WorkspaceSelector
use settings_menu: SettingsMenu

widget App {

    setup {
        let t = useT()
        let gateRouter = useGateRouter()
        let viewRouter = useViewRouter()
    }

    msg Msg {
        Init,
        ShowChats,
        ShowPlans,
        ShowSpecs,
        ShowWiki,
        ShowFiles,
        ShowWhitelist,
        GlobalKeydown,
        ToggleRail,
    }

    model {
        // 当前视图（chats/specs/wiki）。不用 view（保留字）。
        var current_view str = "chats"
        // PLAN-084 UAT：rail active 绑定用纯 bool computed——表达式 prop
        // （active: .current_view == "chats"）在 VM extract_bool_expr 不消费
        // （落回路由判定恒 false → 会话恒不高亮，用户实机反馈④）。
        var is_chats bool = true
        var is_plans bool = false
        var is_specs bool = false
        var is_wiki bool = false
        var is_files bool = false
        var is_whitelist bool = false
        // PLAN-071 r4（需求③-3）：侧边栏收缩态。
        // PLAN-084 UAT⑥（用户裁定修正）：一级导航栏默认收起（w-16 图标态），
        // 横向空间优先给内容；ToggleRail 随时展开。
        var rail_collapsed bool = true
    }

    computed {
        railClass => if .rail_collapsed {
            "w-16 shrink-0 bg-muted/40 border-r border-border gap-3 px-2 pb-3 pt-0 h-full items-center"
        } else {
            "w-48 shrink-0 bg-muted/40 border-r border-border gap-3 px-3 pb-3 pt-0 h-full"
        }
        // 小鹿 logo（auto-os 虚拟桌面同款 assets/icons/{dark,light}/auto-musk.png，
        // 64px 量化内嵌）——dark 常显，light 由 inject_styles 随 html.dark 切换。
        deerDarkSrc => "data:image/png;base64,"
        deerLightSrc => "data:image/png;base64,"
    }

    view {
        if store.authenticated != true {
            LoginPage
        } else {
            row {
                style: "h-screen w-full bg-background"
                // bg-background：web 轨 body CSS 已有同色（冗余无害）；VM 轨
                // 此前无背景类落 iced 默认黑——用户对拍 2026-09-03：VM 内容
                // 面板与二级导航同色。补上后 VM 三栏 = bg-secondary(左)/
                // bg-card(二级)/bg-background(内容) 三档渐进,与 Vue 层次一致。
                // Plan 029 T20：全局快捷键挂视图根（见 .GlobalKeydown）。
                onkeydown: .GlobalKeydown($event)
                // view rail（侧边导航栏）
                // Plan 407：text 节点 t() 化 + WorkspaceSelector 逃生舱接入（原生支持）。
                col {
                    style: [.railClass]
                    // 标题行对齐三级头约定（NavSidebar/ContentHeader 均为
                    // h-12 + border-b,2026-08-29 用户实测 rail 标题高度不齐）。
                    // 内层保留 items-baseline 的字号配对。
                    // PLAN-058 二期：border-b 换 border-white/10——实测
                    // border-border(亮度18%) 与 bg-secondary(16%) 仅差 2 点
                    // 完全不可见（bg-card 10% 上才可见），白 10% 叠加后为
                    // 可辨细线；h-12 对齐天然成立（两线均 y=48）。
                    row {
                        style: "h-12 shrink-0 flex items-center border-b border-white/10"
                        // r8：标题行收敛为单一 deer icon 按钮（原展开态
                        // "Auto Musk"+版本号双 text 在窄 rail 里挤成两行，
                        // 用户实测截图）——版本号转 hover title，可自检
                        // bundle 新旧（r3 引入该锚点的初衷保留）。
                        if .rail_collapsed {
                            button {
                                onclick: .ToggleRail
                                title: "Auto Musk v0.1.0-p073r8"
                                style: "w-10 h-10 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent mx-auto"
                                img (src: .deerDarkSrc) { class: "deer-icon-dark w-6 h-6 rounded-lg" }
                                // PLAN-081 需求③a：VM 轨无 CSS 引擎，双鹿并排
                                // （light 鹿恒渲染）——hidden 类在 VM 按桌面语义
                                // 不渲染；web 亮色由 inject_styles 的
                                // display:block !important 翻回（Tailwind hidden
                                // 无 !important，必输），双轨各得其所。
                                img (src: .deerLightSrc) { class: "deer-icon-light w-6 h-6 rounded-lg hidden" }
                            }
                        } else {
                            button {
                                onclick: .ToggleRail
                                title: "Auto Musk v0.1.0-p073r8"
                                style: "w-8 h-8 shrink-0 flex items-center justify-center rounded-lg hover:bg-accent cursor-pointer"
                                img (src: .deerDarkSrc) { class: "deer-icon-dark w-6 h-6 rounded-lg" }
                                img (src: .deerLightSrc) { class: "deer-icon-light w-6 h-6 rounded-lg hidden" }
                            }
                            button {
                                onclick: .ToggleRail
                                title: "收起侧边栏"
                                style: "ml-auto w-7 h-7 flex items-center justify-center rounded-md hover:bg-accent text-muted-foreground cursor-pointer"
                                icon (name: "panel-left-close", size: 18) {}
                            }
                        }
                    }
                    if .rail_collapsed {
                        col {
                            style: "gap-1 app-rail items-center"
                            // PLAN-081 需求③b：选中态背景改由外层 div 承载
                            //（bg-foreground/10=比底色稍亮一档，用户裁定
                            // 2026-09-21）——按钮自身的 bg-* 在当前 VM 二进制
                            // 不上色（容器 bg 渲染可靠，按钮面裸），div 包裹
                            // 双轨同形；web 侧等价（Tailwind 同类）。图标色
                            // text-primary 仍在按钮上。
                            col { style: if .current_view == "chats" { "w-10 h-10 rounded-md bg-primary/10" } else { "w-10 h-10" }
                                button { onclick: .ShowChats; title: "会话"; style: if .current_view == "chats" { "w-10 h-10 flex items-center justify-center rounded-md text-primary" } else { "w-10 h-10 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }; icon (name: "message-square", size: 24) {} }
                            }
                            col { style: if .current_view == "plans" { "w-10 h-10 rounded-md bg-primary/10" } else { "w-10 h-10" }
                                button { onclick: .ShowPlans; title: "计划"; style: if .current_view == "plans" { "w-10 h-10 flex items-center justify-center rounded-md text-primary" } else { "w-10 h-10 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }; icon (name: "list-todo", size: 24) {} }
                            }
                            col { style: if .current_view == "specs" { "w-10 h-10 rounded-md bg-primary/10" } else { "w-10 h-10" }
                                button { onclick: .ShowSpecs; title: "规范"; style: if .current_view == "specs" { "w-10 h-10 flex items-center justify-center rounded-md text-primary" } else { "w-10 h-10 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }; icon (name: "scroll", size: 24) {} }
                            }
                            col { style: if .current_view == "wiki" { "w-10 h-10 rounded-md bg-primary/10" } else { "w-10 h-10" }
                                button { onclick: .ShowWiki; title: "知识库"; style: if .current_view == "wiki" { "w-10 h-10 flex items-center justify-center rounded-md text-primary" } else { "w-10 h-10 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }; icon (name: "book-open", size: 24) {} }
                            }
                            col { style: if .current_view == "files" { "w-10 h-10 rounded-md bg-primary/10" } else { "w-10 h-10" }
                                button { onclick: .ShowFiles; title: "文件"; style: if .current_view == "files" { "w-10 h-10 flex items-center justify-center rounded-md text-primary" } else { "w-10 h-10 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }; icon (name: "folder-open", size: 24) {} }
                            }
                            col { style: if .current_view == "whitelist" { "w-10 h-10 rounded-md bg-primary/10" } else { "w-10 h-10" }
                                button { onclick: .ShowWhitelist; title: "白名单"; style: if .current_view == "whitelist" { "w-10 h-10 flex items-center justify-center rounded-md text-primary" } else { "w-10 h-10 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }; icon (name: "shield-check", size: 24) {} }
                            }
                        }
                    } else {
                    col {
                        style: "gap-1 app-rail"
                        // Plan 562（上游 auto-lang nav 族退役）：nav-item →
                        // sidebar_menu_item + sidebar_menu_button。onclick/active/
                        // size 语义不变（548/561 双端契约）；icon/label 改 children
                        // 形态（Vue 548 臂不处理 icon:/label: props）。
                        // size=lg：图标 20px——用户对拍 2026-09-03:VM 图标观感偏小,
                        // 主导航抬档。
                        sidebar_provider (class: "w-full min-h-0 flex flex-col") {
                            sidebar_menu {
                                sidebar_menu_item {
                                    sidebar_menu_button (onclick: .ShowChats, active: .is_chats, size: "lg") {
                                        icon (name: "message-square") {}
                                        text "会话" {}
                                    }
                                }
                                sidebar_menu_item {
                                    sidebar_menu_button (onclick: .ShowPlans, active: .is_plans, size: "lg") {
                                        icon (name: "list-todo") {}
                                        text "计划" {}
                                    }
                                }
                                sidebar_menu_item {
                                    sidebar_menu_button (onclick: .ShowSpecs, active: .is_specs, size: "lg") {
                                        icon (name: "scroll") {}
                                        text "规范" {}
                                    }
                                }
                                sidebar_menu_item {
                                    sidebar_menu_button (onclick: .ShowWiki, active: .is_wiki, size: "lg") {
                                        icon (name: "book-open") {}
                                        text "知识库" {}
                                    }
                                }
                                sidebar_menu_item {
                                    sidebar_menu_button (onclick: .ShowFiles, active: .is_files, size: "lg") {
                                        icon (name: "folder-open") {}
                                        text "文件" {}
                                    }
                                }
                                // PLAN-070：工作区目录白名单管理视图入口。
                                sidebar_menu_item {
                                    sidebar_menu_button (onclick: .ShowWhitelist, active: .is_whitelist, size: "lg") {
                                        icon (name: "shield-check") {}
                                        text "白名单" {}
                                    }
                                }
                            }
                        }
                    }
                    }
                    // Plan 407：WorkspaceSelector + SettingsMenu 在导航栏底部。
                    // PLAN-058 二期：横排（justify-between 撑宽主导航）改纵排
                    // ——工程目录在上，分割线，设置(icon+文字)在下。分割线同
                    // T10 用 border-white/10（border-border 在 bg-secondary 上
                    // 不可见），归属 SettingsMenu 根容器 border-t。
                    col {
                        style: if .rail_collapsed { "mt-auto shrink-0 w-full flex flex-col items-center" } else { "mt-auto shrink-0" }
                        WorkspaceSelector { collapsed: .rail_collapsed }
                        SettingsMenu { collapsed: .rail_collapsed }
                    }
                }
                // view main（v-if 切换视图）
                col {
                    style: "flex-1 min-h-0 min-w-0 overflow-hidden"
                    if .current_view == "plans" {
                        PlansView
                    } else if .current_view == "specs" {
                        SpecsView
                    } else if .current_view == "wiki" {
                        WikiView
                    } else if .current_view == "files" {
                        FilesView
                    } else if .current_view == "whitelist" {
                        WhitelistView
                    } else {
                        ChatsView
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            platformInjectStyles();
            platformSetupAuthFetch();
            ensure_workspace();
            AuthStore.Init();
            // PLAN-048 T5:VM 轨子部件 Init 生命周期不派发(ChatsView.Init→
            // ForgeStore.Init→LoadSessionList 永不执行),App 级代派等价
            // vue 轨 onMounted 语义——会话列表契约 GET + workspace 兜底。
            ForgeStore.Init();
            // PLAN-080 T-02: workspace 单源解析回填 store（boot 末位 await，
            // 不挡登录页首绘；selector 触发器自此读 store 真值）。await 经
            // let 语句中转（调用实参内 .await 的 VM 语义未证实）。
            let resolved_ws = ws_resolve_current().await;
            // PLAN-081 需求②：ws_resolve_current 内部已回写 localStorage，
            // 在 SetWorkspace 之前重注入 VM 默认 query——否则解析出的 id 与
            // 引导值不同时，SetWorkspace 内部的会话重拉（chats_list_sessions
            // 无参、全靠默认 query 带 workspace）会打错工作区。web no-op。
            platformRefreshAuth();
            ForgeStore.SetWorkspace(resolved_ws);
            // URL → 视图(挂载恢复,web useViewState 初始解析对拍)。
            .current_view = vsCurrentView()
        }
        .ToggleRail -> {
            .rail_collapsed = !.rail_collapsed
        }
        .ShowChats -> {
            .current_view = "chats";
            .is_chats = true;
            .is_plans = false;
            .is_specs = false;
            .is_wiki = false;
            .is_files = false;
            .is_whitelist = false;
            vsSetView("chats")
        }
        // Plan 029 T20：全局快捷键（原 useKeyboardShortcuts composable）。
        // Ctrl/Cmd+Shift+S 聚焦搜索框；Ctrl/Cmd+Shift+N 点新建会话按钮。
        // 监听挂在视图根元素（document 级监听不可表达——焦点需在应用内，
        // 实际等价：快捷键的目标元素都在应用内）。
        .GlobalKeydown(e) -> {
            if (e.ctrlKey || e.metaKey) && e.shiftKey {
                if e.key.to_lower() == "s" {
                    e.preventDefault();
                    dom.focus_first(".search-input")
                } else {
                    if e.key.to_lower() == "n" {
                        e.preventDefault();
                        dom.click_first(".sidebar-new-btn")
                    }
                }
            }
        }
        .ShowPlans -> {
            .current_view = "plans";
            .is_chats = false;
            .is_plans = true;
            .is_specs = false;
            .is_wiki = false;
            .is_files = false;
            .is_whitelist = false;
            vsSetView("plans");
            // PLAN-081：VM 轨子件 Init 不派发（PLAN-048 T5 口径），App 级
            // 代派进视图重拉（.ShowFiles → FilesStore.LoadTree 同款；web 轨
            // 由 PlansView.Init 的 plans_loaded 守卫防双拉）。workspace 切换
            // 后的强刷走 selector 的 PlansStore.Reload 链。
            PlansStore.Init()
        }
        .ShowSpecs -> {
            .current_view = "specs";
            .is_chats = false;
            .is_plans = false;
            .is_specs = true;
            .is_wiki = false;
            .is_files = false;
            .is_whitelist = false;
            vsSetView("specs");
            SpecsStore.LoadDocument();
            SpecsStore.LoadOverview()
        }
        .ShowWiki -> {
            .current_view = "wiki";
            .is_chats = false;
            .is_plans = false;
            .is_specs = false;
            .is_wiki = true;
            .is_files = false;
            .is_whitelist = false;
            vsSetView("wiki");
            WikiStore.Init()
        }
        // PLAN-068: 进入文件视图即重拉 workspace 树（freshness 优先；
        // FilesView.Init 的 files_loaded 守卫只拦挂载期双触发）。
        .ShowFiles -> {
            .current_view = "files";
            .is_chats = false;
            .is_plans = false;
            .is_specs = false;
            .is_wiki = false;
            .is_files = true;
            .is_whitelist = false;
            vsSetView("files");
            FilesStore.LoadTree()
        }
        // PLAN-070：白名单视图——进入即由视图 Init 重拉（v-if 重挂载语义，
        // 无需 App 驱动 store）。
        .ShowWhitelist -> {
            .current_view = "whitelist";
            .is_chats = false;
            .is_plans = false;
            .is_specs = false;
            .is_wiki = false;
            .is_files = false;
            .is_whitelist = true;
            vsSetView("whitelist")
        }
    }
}
