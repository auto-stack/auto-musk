// app.at — auto-musk 前端入口根 widget（Plan 022 Phase 4 骨架）
//
// 对应 web/src/App.vue。Phase 4 先做 auth guard：
//   未登录 → LoginPage；登录后 → 主应用占位（view 切换留 Phase 5-7）。
// App.vue 的 Ctrl+1/2/3 + view rail + OnboardingDialog 留待后续 Phase。
//
// 设计：纯 store 驱动——LoginPage 调 store.Login，store.authenticated 变化
// 自动驱动本组件 v-if 切换（无需 auth-success 事件）。

use store: AuthStore
use login: LoginPage

widget App {
    msg Msg {
        Init,
    }

    view {
        // auth guard：未认证显示 LoginPage，认证后显示主应用占位。
        if store.authenticated.value != true {
            LoginPage
        } else {
            col {
                style: "musk-app"
                text f"Logged in as ${store.user.value.username}" {
                    style: "p-4"
                }
                // Phase 5-7 会在此插入 view rail + ChatsView/SpecsView/WikiView。
            }
        }
    }

    on {
        // Init: App 挂载时从 localStorage 恢复 auth 状态。
        .Init -> { store.Init() }
    }
}
