// app.at — auto-musk 前端入口根 widget（Plan 022 Phase 5 骨架）
//
// 对应 web/src/App.vue。auth guard + view rail + view 切换。
// 注意: 字段名用 current_view 而非 view（view 是 AutoUI 保留关键字）。

use store: AuthStore
use login: LoginPage
use specs_view: SpecsView
use wiki_view: WikiView
use chats_view: ChatsView
use plans_view: PlansView

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web platformInjectStyles, platformSetupAuthFetch from "src/front/ports/platform.at"
use.web ensure_workspace from "src/front/workspace_helpers.at"
use.web useT from "src/front/ports/composables.at"
use.web useGateRouter from "src/front/ports/composables.at"
// PLAN-041 T8:URL 路由桥(popstate→rail 点击;vsSetView pushState)。
use.web useViewRouter, vsCurrentView, vsSetView from "src/front/ports/composables.at"
use.web component MessageSquare, ListTodo, Scroll, BookOpen from "src/front/ports/icons.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use workspace_selector: WorkspaceSelector
use settings_menu: SettingsMenu

widget App {

    setup {
        let t = useT()
        let gateRouter = useGateRouter()
        let viewRouter = useViewRouter()
    }

    msg Msg {
        Init,
        ShowChats,
        ShowPlans,
        ShowSpecs,
        ShowWiki,
        GlobalKeydown,
    }

    model {
        // 当前视图（chats/specs/wiki）。不用 view（保留字）。
        var current_view str = "chats"
    }

    view {
        if store.authenticated != true {
            LoginPage
        } else {
            row {
                style: "h-screen w-full"
                // Plan 029 T20：全局快捷键挂视图根（见 .GlobalKeydown）。
                onkeydown: .GlobalKeydown($event)
                // view rail（侧边导航栏）
                // Plan 407：text 节点 t() 化 + WorkspaceSelector 逃生舱接入（原生支持）。
                col {
                    style: "w-48 shrink-0 bg-secondary border-r border-border gap-3 px-3 pb-3 pt-0 h-full"
                    // 标题行对齐三级头约定（NavSidebar/ContentHeader 均为
                    // h-12 + border-b,2026-08-29 用户实测 rail 标题高度不齐）。
                    // 内层保留 items-baseline 的字号配对。
                    row {
                        style: "h-12 shrink-0 flex items-center border-b border-border"
                        row {
                            style: "flex items-baseline gap-2"
                            // PLAN-048:字面量化(VM 视图文本无裸调用臂,t() 恒空;
                            // 见 KD 048 行 UPSTREAM④)。
                            text "Auto Musk" { style: "text-base font-bold text-primary" }
                            text "v0.1.0" { style: "text-xs text-muted-foreground" }
                        }
                    }
                    col {
                        style: "gap-1"
                        button {
                            onclick: .ShowChats
                            style: if .current_view == "chats" {
                                "w-full flex items-center justify-start gap-2 px-3 py-2 rounded-md text-sm text-left text-primary bg-primary/10 font-medium hover:bg-accent"
                            } else {
                                "w-full flex items-center justify-start gap-2 px-3 py-2 rounded-md text-sm text-left text-muted-foreground bg-transparent hover:bg-accent"
                            }
                            MessageSquare { size: 16 }
                            text "会话"
                        }
                        button {
                            onclick: .ShowPlans
                            style: if .current_view == "plans" {
                                "w-full flex items-center justify-start gap-2 px-3 py-2 rounded-md text-sm text-left text-primary bg-primary/10 font-medium hover:bg-accent"
                            } else {
                                "w-full flex items-center justify-start gap-2 px-3 py-2 rounded-md text-sm text-left text-muted-foreground bg-transparent hover:bg-accent"
                            }
                            ListTodo { size: 16 }
                            text "计划"
                        }
                        button {
                            onclick: .ShowSpecs
                            style: if .current_view == "specs" {
                                "w-full flex items-center justify-start gap-2 px-3 py-2 rounded-md text-sm text-left text-primary bg-primary/10 font-medium hover:bg-accent"
                            } else {
                                "w-full flex items-center justify-start gap-2 px-3 py-2 rounded-md text-sm text-left text-muted-foreground bg-transparent hover:bg-accent"
                            }
                            Scroll { size: 16 }
                            text "规范"
                        }
                        button {
                            onclick: .ShowWiki
                            style: if .current_view == "wiki" {
                                "w-full flex items-center justify-start gap-2 px-3 py-2 rounded-md text-sm text-left text-primary bg-primary/10 font-medium hover:bg-accent"
                            } else {
                                "w-full flex items-center justify-start gap-2 px-3 py-2 rounded-md text-sm text-left text-muted-foreground bg-transparent hover:bg-accent"
                            }
                            BookOpen { size: 16 }
                            text "知识库"
                        }
                    }
                    // Plan 407：WorkspaceSelector + SettingsMenu 在导航栏底部。
                    row {
                        style: "mt-auto flex items-center justify-between gap-1.5 px-1"
                        WorkspaceSelector
                        SettingsMenu
                    }
                }
                // view main（v-if 切换视图）
                col {
                    style: "flex-1 min-h-0 min-w-0 overflow-hidden"
                    if .current_view == "plans" {
                        PlansView
                    } else if .current_view == "specs" {
                        SpecsView
                    } else if .current_view == "wiki" {
                        WikiView
                    } else {
                        ChatsView
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            platformInjectStyles();
            platformSetupAuthFetch();
            AuthStore.Init();
            // PLAN-048 T5:VM 轨子部件 Init 生命周期不派发(ChatsView.Init→
            // ForgeStore.Init→LoadSessionList 永不执行),App 级代派等价
            // vue 轨 onMounted 语义——会话列表契约 GET + workspace 兜底。
            ForgeStore.Init();
            // URL → 视图(挂载恢复,web useViewState 初始解析对拍)。
            .current_view = vsCurrentView()
        }
        .ShowChats -> {
            .current_view = "chats";
            vsSetView("chats")
        }
        // Plan 029 T20：全局快捷键（原 useKeyboardShortcuts composable）。
        // Ctrl/Cmd+Shift+S 聚焦搜索框；Ctrl/Cmd+Shift+N 点新建会话按钮。
        // 监听挂在视图根元素（document 级监听不可表达——焦点需在应用内，
        // 实际等价：快捷键的目标元素都在应用内）。
        .GlobalKeydown(e) -> {
            if (e.ctrlKey || e.metaKey) && e.shiftKey {
                if e.key.to_lower() == "s" {
                    e.preventDefault();
                    dom.focus_first(".search-input")
                } else {
                    if e.key.to_lower() == "n" {
                        e.preventDefault();
                        dom.click_first(".sidebar-new-btn")
                    }
                }
            }
        }
        .ShowPlans -> {
            .current_view = "plans";
            vsSetView("plans")
        }
        .ShowSpecs -> {
            .current_view = "specs";
            vsSetView("specs")
        }
        .ShowWiki -> {
            .current_view = "wiki";
            vsSetView("wiki")
        }
    }
}
