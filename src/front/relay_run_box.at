// relay_run_box.at — RelayRunBox 组件（Plan 023 队列 A3：async + composable 逃生舱原生化）
//
// 对标 src/front/components/RelayRunBox.vue（逃生舱，已删除）。
// 验证 §10.7 async handler（approve/reject .await）+ §10.4 composable facade
// refs 标注（runs/currentRun 访问自动 .value）。
//
// 关键转换：
//   - useRelay composable → use { composable: useRelay refs: [runs, currentRun] }
//   - 订阅闭包（unsubscribe 存模块 Map）+ 数组 find + 字典映射 → relay_run_helpers.ts fn
//   - onMounted loadRun → on .Init；onUnmounted 取消订阅 → .Destroy
//   - watch 自动滚底 + template ref → 舍弃（日志面板仍可手动滚动，登记轻微差异）
//   - 7 分支 entry type → if-else-if + || + relayEntryClass fn（避免超长嵌套 if）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.relay-box 等）。

use store: RelayStore

component fn RelayRunBox(runId: str) {
    use {
        component: ChevronDown, ChevronUp, Orbit, Wrench, FileText from "lucide-vue-next"
        component: ReportCard
        component: Markdown from "platform:markdown"
        fn: relayFindRun, relayStatusLabel, relayStatusClass, relayProfessionIcon, relayRunTitle, relayWaitingGate, relayEntryClass, relaySessionLogFor, relayToolTarget, relayPreviewLines, relayStepViews, relayBadgePos, relayReportView, relayTextPlanFile, relayTextBody, relayIsDoc, relayDocTitle, relayPhaseKind, relayPhaseAction, relayPhaseIcon, relayPhaseClass, relayPhaseText, relayPhaseDetail, relayToolIsDocKind from "src/front/relay_run_helpers.at"
    }
    computed {
        run => relayFindRun(store.runs, store.current_run, .runId)
        hasRun => .run != None
        // 历史回放：run 内存态被清空后，从持久化 run 日志（Flow 会话）重建
        history => store.run_histories[.runId] ?? None
        hasHistory => .history != None
        // 试用修复：run 与历史均无 → missing 失效态
        status => if .run != None { .run.status } else { if .history != None { .history.status } else { "missing" } }
        statusClass => relayStatusClass(.status)
        statusLabel => if .run != None { relayStatusLabel(.status) } else { if .history != None { relayStatusLabel(.status) + "（历史）" } else { "已失效" } }
        titleText => if .hasRun { relayRunTitle(.run, .runId) } else { if .history != None { .history.title } else { .runId } }
        progressCur => if .hasRun { .run.current_step } else { 0 }
        progressTotal => if .hasRun { .run.total_steps } else { 0 }
        steps => if .run != None { .run.steps ?? [] } else { [] }
        // 进度视图（悬浮列表 + 迷你分段条）：失败 run 的当前步按 status 修正为 ✗
        stepViews => relayStepViews(.steps, .progressCur, .status)
        // 徽标 1-based 位置（current_step 是 0-based"即将执行"索引，直接展示会
        // 把第 2 步显示成 1/4）
        badgePos => relayBadgePos(.progressCur, .progressTotal, .status)
        waitingGate => relayWaitingGate(.run)
        hasWaitingGate => .waitingGate != None
        gateStepId => if .hasWaitingGate { .waitingGate.step_id } else { "" }
        logEntries => if .hasRun || .hasHistory == false { relaySessionLogFor(store.session_logs, .runId) } else { .history.entries }
        // run 与历史均无 → missing 失效态（此前模板引用了未定义的 .missing，
        // 生成码 undefined==false 恒假——收起态预览条在 gen 轨从未显示过的暗 bug）
        isMissing => .hasRun == false && .hasHistory == false
        // 运行中（实时 run 且状态 running）→ 图标旋转
        isLiveRunning => .hasRun && .status == "running"
        // 终态：失败/完成/失效——此时不再显示任何"进行中"指示
        isTerminal => .statusClass == "failed" || .statusClass == "completed" || .statusClass == "missing"
        // 收起态预览（最多 3 行）：run 内最新变化；gate 时由审批条接管
        previewLines => relayPreviewLines(.logEntries)
        // run 完成报告（completed 载荷；store.run_reports 或 LoadRun 回扫注入）
        report => store.run_reports[.runId] ?? None
        reportView => if .report != None { relayReportView(.report) } else { None }
        // 预览圆点：仅运行中脉动；gate 琥珀/失败红/完成绿/失效灰（终态常亮
        // 表示"停在这里"，不再闪烁误导）
        dotClass => if .isLiveRunning { "live-preview-dot live" } else { "live-preview-dot dot-" + .statusClass }
    }
    msg Msg { Toggle, ToggleEntry(Value), ToggleDoc(Value), Approve, Reject }
    model {
        var expanded bool = false
        var gateBusy bool = false
        var subscribed bool = false
    }
    on {
        // Init：拉取 run 详情；若正等待人工审批则自动展开 + 订阅事件流
        // （需要用户交互的块不能默认折叠）。
        .Init -> {
            // 试用修复：挂载即订阅 + 拉取（原 Init 只 LoadRun、仅在"已可见的
            // gate"才订阅——mount 时 run 未加载完，条件永假，折叠态收不到任何
            // 事件，停靠/完成/失败状态全靠手刷页面）。
            store.LoadRun(.runId);
            store.LoadRunHistory(.runId);
            if !.subscribed {
                store.Subscribe(.runId);
                .subscribed = true
            }
            // gate 到达不自动展开：收起态由标题下方内联审批条承接（无滚动跳变）
        }
        .Destroy -> { store.Unsubscribe(.runId) }
        .ToggleEntry(entry) -> {
            if entry._expanded == true {
                entry._expanded = false
            } else {
                entry._expanded = true
            }
        }
        .ToggleDoc(entry) -> {
            if entry._docOpen == true {
                entry._docOpen = false
            } else {
                entry._docOpen = true
            }
        }
        .Toggle -> {
            .expanded = !.expanded;
            if .expanded {
                // 试用修复：展开即重拉最新状态（原只订阅不刷新，展开看到的
                // 仍是挂载时的旧快照——审批按钮/进度不出现）。
                store.LoadRun(.runId);
                if !.subscribed {
                    store.Subscribe(.runId);
                    .subscribed = true
                }
            }
        }
        .Approve -> {
            .gateBusy = true;
            store.ResolveGate(.runId, "approve", "");
            .gateBusy = false
        }
        .Reject -> {
            .gateBusy = true;
            store.ResolveGate(.runId, "reject", "需要修改");
            .gateBusy = false
        }
    }
    style {
.box-header {
  display: flex; align-items: center; gap: 0.4rem;
  padding: 0.5rem 0.75rem; cursor: pointer; font-size: 0.82rem; color: var(--af-fg);
}
.box-header:hover { background: hsl(var(--muted-foreground) / 0.06); }
.box-title { font-weight: 500; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.box-progress { font-size: 0.72rem; color: var(--af-muted); }
.box-status { font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 3px; }
.box-body { padding: 0.5rem 0.75rem; border-top: 1px solid var(--af-border); }
.entry-prof { margin-right: 0.3rem; }
.entry-tool-card { border: 1px solid var(--af-border); border-radius: 6px; overflow: hidden; margin: 0.15rem 0; }
.entry-tool-head { display: flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.5rem; cursor: pointer; font-size: 0.75rem; }
.entry-tool-head .tool-target { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: hsl(190 80% 35%); font-family: monospace; }
.tool-chevron { color: #999; }
.entry-tool-body { border-top: 1px solid var(--af-border); }
.entry-tool-body pre { margin: 0; padding: 0.4rem 0.5rem; font-size: 0.72rem; white-space: pre-wrap; word-break: break-all; max-height: 260px; overflow-y: auto; }
.tool-args { background: hsl(0 0% 96%); }
.tool-result { background: hsl(140 30% 96%); border-top: 1px dashed var(--af-border); }
.gate-strip { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.75rem; border-top: 1px dashed hsl(38 92% 50%); background: hsl(38 92% 50% / 0.06); }
@keyframes rb-spin { to { transform: rotate(360deg); } }
.run-icon { color: hsl(var(--primary)); }
.run-icon.spinning { animation: rb-spin 1.2s linear infinite; }
.head-chevron { color: var(--af-muted); flex-shrink: 0; }
/* 展开态正文：Markdown 全宽（与工具块左对齐，无图标前缀） */
.entry-md { width: 100%; min-width: 0; }
/* 统一 Block 头图标盒：所有块（工具卡/阶段行/文档块/预览行）的头部 icon
   同尺寸（14×14 盒内 12px 图标/emoji）且垂直居中——消除 read_plan/阶段/
   Run 完成 icon 高低不齐 */
.blk-icon {
  width: 14px; height: 14px; flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
}
/* 阶段 Log 行：[icon] [类型·着色] [阶段名] [动作] [短尾线]（左对齐 log 风格，
   替代居中分割线——信息量优先） */
.phase-line { display: flex; align-items: center; gap: 0.4rem; margin: 0.35rem 0 0.2rem; font-size: 0.75rem; }
.phase-line .ph-icon {
  width: 14px; height: 14px; flex-shrink: 0; font-size: 0.74rem; line-height: 1;
  display: inline-flex; align-items: center; justify-content: center;
}
.phase-line .ph-kind {
  flex-shrink: 0; font-weight: 600; font-size: 0.7rem; letter-spacing: 0.05em;
  padding: 0.02rem 0.35rem; border-radius: 3px;
}
.phase-line .ph-name { flex-shrink: 0; font-weight: 500; color: var(--af-fg); }
.phase-line .ph-action { flex-shrink: 0; font-weight: 500; }
.phase-line .ph-err-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.phase-line .ph-tail { flex: 1; max-width: 2.2rem; height: 1px; border-bottom: 1px dashed currentColor; opacity: 0.4; margin-left: 0.3rem; }
/* 类型着色：阶段蓝 / 审批琥珀 / 完成绿 / 失败红 */
.phase-line.ph-step { color: var(--af-muted); }
.phase-line.ph-step .ph-icon, .phase-line.ph-step .ph-action { color: hsl(var(--primary)); }
.phase-line.ph-step .ph-kind { background: hsl(var(--primary) / 0.12); color: hsl(var(--primary)); }
.phase-line.ph-step.done { color: var(--af-muted); }
.phase-line.ph-step.done .ph-icon, .phase-line.ph-step.done .ph-action { color: hsl(142 71% 45%); }
.phase-line.ph-step.done .ph-kind { background: hsl(142 71% 45% / 0.12); color: hsl(142 71% 45%); }
.phase-line.ph-gate { color: var(--af-muted); }
.phase-line.ph-gate .ph-icon, .phase-line.ph-gate .ph-action { color: hsl(38 92% 50%); }
.phase-line.ph-gate .ph-kind { background: hsl(38 92% 50% / 0.15); color: hsl(38 80% 40%); }
.phase-line.ph-done { color: var(--af-muted); }
.phase-line.ph-done .ph-icon, .phase-line.ph-done .ph-action { color: hsl(142 71% 45%); }
.phase-line.ph-done .ph-kind { background: hsl(142 71% 45% / 0.12); color: hsl(142 71% 45%); }
.phase-line.ph-fail { color: var(--af-muted); }
.phase-line.ph-fail .ph-icon, .phase-line.ph-fail .ph-action { color: hsl(var(--af-error)); }
.phase-line.ph-fail .ph-kind { background: hsl(var(--af-error) / 0.12); color: hsl(var(--af-error)); }
.phase-line.ph-fail .ph-err-text { color: hsl(var(--af-error)); }
/* 工具文档型结果子窗：Markdown 渲染，比 Run 普通文档（0.85rem）小一号 */
.tool-doc-body {
  padding: 0.4rem 0.55rem; font-size: 0.78rem; line-height: 1.5;
  background: hsl(140 30% 97%); border-top: 1px dashed var(--af-border);
  max-height: 360px; overflow-y: auto;
}
/* 长文本/计划文档 → 折叠文档块（Markdown 文件 Block）；PLAN_FILE 路径
   并入头部做标题 chip。内容字号比 Run 普通文档小一号（0.72rem） */
.doc-block { border: 1px solid var(--af-border); border-radius: 8px; margin: 0.3rem 0; overflow: hidden; background: hsl(var(--muted-foreground) / 0.02); }
.doc-head { display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.6rem; cursor: pointer; font-size: 0.8rem; }
.doc-head:hover { background: hsl(var(--muted-foreground) / 0.05); }
.doc-file-chip {
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-family: 'Geist Mono', 'Fira Code', monospace; font-size: 0.74rem;
  color: hsl(190 80% 32%); background: hsl(190 80% 45% / 0.08);
  border: 1px solid hsl(190 80% 45% / 0.25); border-radius: 5px; padding: 0.1rem 0.45rem;
}
.doc-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; color: var(--af-fg); }
.doc-body { border-top: 1px solid var(--af-border); padding: 0.45rem 0.6rem; font-size: 0.72rem; max-height: 420px; overflow-y: auto; }
/* 阶段详情子窗（step_completed 的 handoff 摘要）——与文档块同小字号 */
.ph-block { border: 1px dashed var(--af-border); border-radius: 6px; margin: 0.25rem 0; overflow: hidden; }
.ph-block-head { padding: 0.3rem 0.45rem; margin: 0; cursor: pointer; }
.ph-block-head:hover { background: hsl(var(--muted-foreground) / 0.04); }
.ph-detail { border-top: 1px dashed var(--af-border); padding: 0.45rem 0.6rem; font-size: 0.72rem; max-height: 360px; overflow-y: auto; }
.entry-thinking {
  color: var(--af-muted); font-style: italic; font-size: 0.78rem;
  padding: 0.15rem 0; white-space: pre-wrap; word-break: break-word;
}
.run-report-slot { margin-top: 0.5rem; }
@keyframes rb-pulse { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
/* 预览条 v2：圆点对齐末行（flex-end + 末行居中边距），行距 0.2rem */
.live-preview {
  display: flex; align-items: flex-end; gap: 0.5rem;
  padding: 0.32rem 0.75rem 0.38rem;
  border-top: 1px solid var(--af-border); background: hsl(var(--primary) / 0.03);
}
.live-preview-dot {
  width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
  margin-bottom: 0.36rem; background: var(--af-muted, #999);
}
/* 仅运行中脉动；终态常亮（失败红/完成绿/gate 琥珀/失效灰）——
   失败后圆点仍在闪烁会让用户误以为命令还在跑 */
.live-preview-dot.live { background: hsl(var(--primary)); animation: rb-pulse 1.4s ease-in-out infinite; }
.live-preview-dot.dot-gate { background: hsl(38 92% 50%); }
.live-preview-dot.dot-failed { background: hsl(var(--af-error)); }
.live-preview-dot.dot-completed { background: hsl(142 71% 45%); }
.live-preview-lines { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
/* 预览行：排版对齐 Block 头（工具名 500/前景色 + 目标 青色 monospace），
   但不做标题栏底色 */
.preview-line { display: flex; align-items: center; gap: 0.35rem; min-width: 0; font-size: 0.74rem; line-height: 1.45; }
.preview-mark {
  width: 14px; height: 14px; flex-shrink: 0; font-size: 0.72rem; line-height: 1;
  display: inline-flex; align-items: center; justify-content: center;
}
.preview-tool-name { flex-shrink: 0; font-weight: 500; color: var(--af-fg); }
.preview-tool-target {
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  color: hsl(190 80% 40%); font-family: 'Geist Mono', 'Fira Code', monospace; font-size: 0.72rem;
}
.preview-text {
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  color: var(--af-fg-secondary, #777);
}
.preview-err { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: hsl(var(--af-error)); }
.preview-ok { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: hsl(142 71% 45%); }
.preview-warn { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: hsl(38 60% 35%); }
.gate-strip-prompt { flex: 1; font-size: 0.78rem; color: hsl(38 60% 35%); }
.entry-step { color: var(--af-muted); font-size: 0.75rem; padding: 0.2rem 0; }
.entry-step.done { color: hsl(142 71% 45%); }
.entry-gate { color: hsl(38 92% 50%); padding: 0.3rem 0; font-weight: 500; }
.entry-error { color: hsl(var(--af-error)); }
.entry-done { color: hsl(142 71% 45%); font-weight: 500; padding: 0.3rem 0; }
.relay-box {
  border: 1px solid var(--af-border); border-radius: 8px; margin: 0; width: 100%;
  overflow: visible; background: hsl(var(--muted-foreground) / 0.03);
}
/* overflow 改 visible（进度悬浮列表要伸出盒外）；子元素圆角补位防溢角 */
.relay-box > :first-child { border-radius: 8px 8px 0 0; }
.relay-box > :last-child { border-radius: 0 0 8px 8px; }
.relay-box > :only-child { border-radius: 8px; }
/* 工具卡全宽（左右边缘齐平，与聊天侧工具卡同款；行级 flex 会把它收缩成
   内容宽度——"长短不一"的根因） */
.entry-tool { display: block; padding-left: 0; }
.tool-interrupted {
  flex-shrink: 0; font-size: 0.68rem; color: hsl(var(--af-error));
  border: 1px solid hsl(var(--af-error) / 0.35); border-radius: 3px;
  padding: 0 0.25rem;
}
/* 进度区：徽标 + 迷你分段条；hover 悬浮步骤清单（CSS-only） */
.progress-wrap { position: relative; display: flex; align-items: center; gap: 0.3rem; cursor: help; }
.progress-segs { display: flex; gap: 2px; }
.progress-segs .seg { width: 10px; height: 4px; border-radius: 2px; background: hsl(var(--af-border)); }
.progress-segs .seg.done { background: hsl(142 71% 45%); }
.progress-segs .seg.active { background: hsl(var(--primary)); animation: rb-pulse 1.4s ease-in-out infinite; }
.progress-segs .seg.gate { background: hsl(38 92% 50%); }
.progress-segs .seg.failed { background: hsl(var(--af-error)); }
.progress-pop {
  display: none; position: absolute; top: 100%; right: 0; margin-top: 4px;
  background: var(--af-bg, #fff); border: 1px solid var(--af-border);
  border-radius: 6px; padding: 0.4rem 0.6rem; min-width: 128px; z-index: 30;
  box-shadow: 0 4px 12px hsl(0 0% 0% / 0.12);
}
.progress-wrap:hover .progress-pop { display: block; }
.pop-row { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; padding: 0.1rem 0; }
.pop-mark { width: 1em; flex-shrink: 0; text-align: center; }
.pop-mark.done { color: hsl(142 71% 45%); }
.pop-mark.active { color: hsl(var(--primary)); }
.pop-mark.gate { color: hsl(38 92% 50%); }
.pop-mark.failed { color: hsl(var(--af-error)); }
.pop-mark.pending { color: var(--af-muted); }
.pop-label { color: var(--af-fg); white-space: nowrap; }
.status-running { border-left: 3px solid hsl(var(--primary)); }
.status-completed { border-left: 3px solid hsl(142 71% 45%); }
.status-failed { border-left: 3px solid hsl(var(--af-error)); }
.status-gate { border-left: 3px solid hsl(38 92% 50%); }
.status-missing { border-left: 3px solid hsl(var(--af-border)); opacity: 0.75; }
.missing-note { padding: 0.5rem 0.75rem; font-size: 0.78rem; }
.badge-missing { background: hsl(var(--af-border)); }
.badge-running { background: hsl(var(--primary) / 0.15); color: hsl(var(--primary)); }
.badge-completed { background: hsl(142 71% 45% / 0.15); color: hsl(142 71% 45%); }
.badge-failed { background: hsl(var(--af-error) / 0.15); color: hsl(var(--af-error)); }
.badge-gate { background: hsl(38 92% 50% / 0.15); color: hsl(38 92% 50%); }
.log-entries { max-height: 400px; overflow-y: auto; font-size: 0.78rem; line-height: 1.5; }
.log-entry { padding: 0.15rem 0; }
.gate-actions {
  display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0;
  border-top: 1px solid var(--af-border); margin-top: 0.5rem;
}
.gate-prompt { font-size: 0.78rem; color: hsl(38 92% 50%); flex: 1; }
.gate-btn { padding: 0.25rem 0.8rem; border-radius: 4px; border: 1px solid var(--af-border); cursor: pointer; font-size: 0.78rem; }
.gate-btn.approve { background: hsl(142 71% 45%); color: #fff; border-color: transparent; }
.gate-btn.reject { background: hsl(var(--af-error) / 0.1); color: hsl(var(--af-error)); }
.gate-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    }

    div {
        class: if .statusClass == "completed" { "relay-box status-completed" } else { if .statusClass == "failed" { "relay-box status-failed" } else { if .statusClass == "gate" { "relay-box status-gate" } else { if .statusClass == "missing" { "relay-box status-missing" } else { "relay-box status-running" } } } }
        // header（click toggle）——折叠 UI 与其它 Block 统一：右侧上下箭头
        //（ChevronDown=收起 / ChevronUp=展开），Orbit 身份图标留左（主题色）
        row {
            onclick: .Toggle
            style: "box-header"
            Orbit {
                size: 14,
                class: if .isLiveRunning { "run-icon spinning" } else { "run-icon" }
            }
            span {
                style: "box-title"
                text .titleText
            }
            if .hasRun {
                // 进度区：徽标(1-based) + 迷你分段条；hover 弹出步骤清单
                //（4 步各是什么、当前在哪——方案 b+a 混合，不占独立行）
                div {
                    style: "progress-wrap"
                    span {
                        style: "box-progress"
                        text .badgePos
                        text "/"
                        text .progressTotal
                    }
                    div {
                        style: "progress-segs"
                        for sv in .stepViews {
                            span { class: .sv.seg_class }
                        }
                    }
                    div {
                        style: "progress-pop"
                        for sv in .stepViews {
                            div {
                                style: "pop-row"
                                span { class: .sv.mark_class, text .sv.mark }
                                span { style: "pop-label", text .sv.label }
                            }
                        }
                    }
                }
            }
            span {
                class: if .statusClass == "completed" { "badge-completed" } else { if .statusClass == "failed" { "badge-failed" } else { if .statusClass == "gate" { "badge-gate" } else { if .statusClass == "missing" { "badge-missing" } else { "badge-running" } } } }
                text .statusLabel
            }
            if .expanded {
                ChevronUp { size: 14, style: "head-chevron" }
            } else {
                ChevronDown { size: 14, style: "head-chevron" }
            }
        }
        // 收起态：停靠 gate → 审批条；否则 → 最新动态预览（最多 3 行；
        // 流式文本时为其尾部 3 行）。高度与审批条近似，随 SSE 自动更新。
        if .expanded == false && .hasWaitingGate {
            div {
                style: "gate-strip"
                span {
                    style: "gate-strip-prompt"
                    text "⏸ 等待审批：" + .gateStepId
                }
                button {
                    style: "gate-btn approve"
                    onclick: .Approve
                    text "批准"
                }
                button {
                    style: "gate-btn reject"
                    onclick: .Reject
                    text "拒绝"
                }
            }
        }
        if .expanded == false && .hasWaitingGate == false && .isMissing == false {
            div {
                style: "live-preview"
                span {
                    class: .dotClass
                }
                div {
                    style: "live-preview-lines"
                    for row in .previewLines {
                        div {
                            style: "preview-line"
                            span {
                                style: "preview-mark"
                                text row.mark
                            }
                            if row.name != "" {
                                span {
                                    style: "preview-tool-name"
                                    text row.name
                                }
                            }
                            if row.target != "" {
                                span {
                                    style: "preview-tool-target"
                                    text row.target
                                }
                            }
                            if row.text != "" {
                                span {
                                    class: row.text_class
                                    text row.text
                                }
                            }
                        }
                    }
                }
            }
        }
        // body（展开时）
        if .expanded {
            div {
                style: "box-body"
                // 试用修复：run 与历史均无（已删除/从未存在）才提示失效；
                // 有历史时 logEntries 已切到回放条目，正常渲染日志。
                if .run == None && .hasHistory == false {
                    div {
                        style: "missing-note"
                        text "⚠️ Run 已失效（run 为内存态，服务重启后清空；活动日志见对应会话记录）。重新发送需求即可续跑——计划文件会幂等复用。"
                    }
                }
                div {
                    style: "log-entries"
                    for entry in .logEntries {
                        div {
                            class: relayEntryClass(.entry.type)
                            if .entry.type == "text" {
                                // 与 chat 一致：AutoDown/Markdown 渲染，全宽
                                // 与工具块左对齐（不再加职业图标——单独占行且
                                // 缩进正文）。PLAN_FILE 行/长文本 → 折叠文档块
                                //（PLAN_FILE 路径并入头部标题，不再单独成行）。
                                if relayIsDoc(.entry.content) {
                                    div {
                                        style: "doc-block"
                                        row {
                                            onclick: .ToggleDoc(.entry)
                                            style: "doc-head"
                                            span {
                                                style: "blk-icon"
                                                FileText { size: 12 }
                                            }
                                            if relayTextPlanFile(.entry.content) != "" {
                                                span {
                                                    style: "doc-file-chip"
                                                    text relayTextPlanFile(.entry.content)
                                                }
                                            } else {
                                                span {
                                                    style: "doc-title"
                                                    text relayDocTitle(.entry.content)
                                                }
                                            }
                                            if .entry._docOpen == true {
                                                ChevronUp { size: 12, style: "tool-chevron" }
                                            } else {
                                                ChevronDown { size: 12, style: "tool-chevron" }
                                            }
                                        }
                                        if .entry._docOpen == true {
                                            div {
                                                style: "doc-body"
                                                Markdown(source: relayTextBody(.entry.content), streaming: false)
                                            }
                                        }
                                    }
                                } else {
                                    if relayTextBody(.entry.content) != "" {
                                        div {
                                            style: "entry-md"
                                            Markdown(source: relayTextBody(.entry.content), streaming: false)
                                        }
                                    }
                                }
                            } else if .entry.type == "thinking" {
                                // 思考条目：muted 斜体（此前无分支不渲染）
                                div {
                                    style: "entry-thinking"
                                    text .entry.content
                                }
                            } else if .entry.type == "tool" || .entry.type == "tool_call" {
                                // 与聊天侧工具卡一致：默认收起、显示操作目标、
                                // 点击头部展开参数与结果（展示态存 _expanded）。
                                // 文档读取型（read_plan 等/结果长）：📄 图标 +
                                // 结果按 Markdown 渲染于子窗（字号小一号）。
                                div {
                                    style: "entry-tool-card"
                                    div {
                                        style: "entry-tool-head"
                                        onclick: .ToggleEntry(.entry)
                                        span {
                                            style: "blk-icon"
                                            if relayToolIsDocKind(.entry) {
                                                FileText { size: 12 }
                                            } else {
                                                Wrench { size: 12 }
                                            }
                                        }
                                        span {
                                            style: "tool-name"
                                            text .entry.tool_name
                                        }
                                        span {
                                            style: "tool-target"
                                            text relayToolTarget(.entry)
                                        }
                                        // 终态下仍无结果的工具调用 → 标记中断
                                        //（此前收起态一直留"进行中"观感，误导）
                                        if .entry.type == "tool_call" && .isTerminal {
                                            span {
                                                style: "tool-interrupted"
                                                text "已中断"
                                            }
                                        }
                                        ChevronDown { size: 12, style: "tool-chevron" }
                                    }
                                    if .entry._expanded == true {
                                        div {
                                            style: "entry-tool-body"
                                            if .entry.arguments != None {
                                                pre {
                                                    style: "tool-args"
                                                    text JSON.stringify(.entry.arguments, null, 2)
                                                }
                                            }
                                            if .entry.result != None && .entry.result != "" {
                                                if relayToolIsDocKind(.entry) {
                                                    // 文档型结果：Markdown 子窗（比 Run 普通文档小一号）
                                                    div {
                                                        style: "tool-doc-body"
                                                        Markdown(source: .entry.result, streaming: false)
                                                    }
                                                } else {
                                                    pre {
                                                        style: "tool-result"
                                                        text .entry.result
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else if .entry.type == "step_started" || .entry.type == "step_completed" || .entry.type == "gate_waiting" || .entry.type == "run_completed" || .entry.type == "run_failed" || .entry.type == "error" {
                                // 阶段 Log 行：[icon] [类型·着色] [阶段名] [动作] [短尾线]。
                                // step_completed 携带 handoff 摘要 → 可展开块
                                //（标题栏即 log 行，详情子窗 Markdown 小字号）。
                                if relayPhaseDetail(.entry.type, .entry.content) != "" {
                                    div {
                                        style: "ph-block"
                                        row {
                                            class: relayPhaseClass(.entry.type)
                                            style: "ph-block-head"
                                            onclick: .ToggleEntry(.entry)
                                            span { style: "ph-icon", text relayPhaseIcon(.entry.type) }
                                            span { style: "ph-kind", text relayPhaseKind(.entry.type) }
                                            if relayPhaseText(.entry.type, .entry.content) != "" {
                                                span { style: "ph-name", text relayPhaseText(.entry.type, .entry.content) }
                                            }
                                            span { style: "ph-action", text relayPhaseAction(.entry.type) }
                                            span { style: "ph-tail" }
                                            if .entry._expanded == true {
                                                ChevronUp { size: 12, style: "tool-chevron" }
                                            } else {
                                                ChevronDown { size: 12, style: "tool-chevron" }
                                            }
                                        }
                                        if .entry._expanded == true {
                                            div {
                                                style: "ph-detail"
                                                Markdown(source: relayPhaseDetail(.entry.type, .entry.content), streaming: false)
                                            }
                                        }
                                    }
                                } else {
                                    row {
                                        class: relayPhaseClass(.entry.type)
                                        span { style: "ph-icon", text relayPhaseIcon(.entry.type) }
                                        span { style: "ph-kind", text relayPhaseKind(.entry.type) }
                                        if relayPhaseText(.entry.type, .entry.content) != "" {
                                            span { style: "ph-name", text relayPhaseText(.entry.type, .entry.content) }
                                        }
                                        span { style: "ph-action", text relayPhaseAction(.entry.type) }
                                        if .entry.type == "run_failed" || .entry.type == "error" {
                                            if relayPhaseText(.entry.type, .entry.content) != "" {
                                                span { style: "ph-err-text", text relayPhaseText(.entry.type, .entry.content) }
                                            }
                                        }
                                        span { style: "ph-tail" }
                                    }
                                }
                            }
                        }
                    }
                }
                // run 完成报告（PLAN-031 T5）：PPT 风格 ReportBlock 内嵌于
                // RunBox 底部（gen 轨位置；web 轨由 ChatsView 全局位承接）
                if .reportView != None {
                    div {
                        style: "run-report-slot"
                        ReportCard { report: .reportView }
                    }
                }
                // inline gate 审批（对齐原 gate-actions）
                if .hasWaitingGate {
                    div {
                        style: "gate-actions"
                        span {
                            style: "gate-prompt"
                            text "等待审批："
                            text .gateStepId
                        }
                        button {
                            onclick: .Approve
                            style: "gate-btn approve"
                            disabled: .gateBusy
                            text "批准"
                        }
                        button {
                            onclick: .Reject
                            style: "gate-btn reject"
                            disabled: .gateBusy
                            text "拒绝"
                        }
                    }
                }
            }
        }
    }
}
