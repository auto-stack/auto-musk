// secretary_message.at — SecretaryMessage 组件（Plan 023 队列 B4：emit + 宿主全局 逃生舱原生化）
//
// 对标 src/front/components/SecretaryMessage.vue（逃生舱，已删除）。
//
// 关键转换：
//   - formatElapsed（Date.now 时间差）→ secretary_helpers.at fn
//   - gate.xxx 字段访问 → computed（.at 模板 text 节点只取简单变量）
//   - approve/reject/snooze 小写 msg + gateId 负载 → 父组件 @approve/@reject/@snooze
//   - review-in-specs（连字符事件名 .at 无法表达）→ ReviewInSpecs camelCase，
//     wrapper 未接线该事件（现状即不转发），按钮视觉保留
//   - dismiss 的 setTimeout（回调空）→ 直接置 isDismissed
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.secretary-message 等）。

component fn SecretaryMessage(gate: obj, queuePosition: int) {
    use {
        component: Check, X, Clock, Eye from "lucide-vue-next"
        fn: secretary_format_elapsed from "src/front/secretary_helpers.at"
        component: AgentAvatar
    }
    computed {
        gateTitle => .gate.title
        gateProfession => .gate.profession
        waitingText => "Waiting " + secretary_format_elapsed(.gate.since)
        gateGateId => .gate.gateId
        gateSectionId => .gate.sectionId
        hasSection => .gate.sectionId != None && .gate.sectionId != ""
        queueLabel => if .queuePosition > 1 { .queuePosition + " more gates queued" } else { .queuePosition + " more gate queued" }
    }
    msg Msg { Dismiss, approve(str), reject(str), snooze(str), ReviewInSpecs(str) }
    model { var isDismissed bool = false }
    on {
        .Dismiss -> { .isDismissed = true }
        .approve(id) -> {}
        .reject(id) -> {}
        .snooze(id) -> {}
        .ReviewInSpecs(sid) -> {}
    }
    div {
        class: if .isDismissed { "secretary-message dismissed" } else { "secretary-message" }
        div {
            style: "secretary-header"
            AgentAvatar { professionId: .gateProfession, name: "", size: "md" }
            div {
                style: "secretary-info"
                div { style: "secretary-title", text .gateTitle }
                div {
                    style: "secretary-meta"
                    span { style: "secretary-profession", text .gateProfession }
                    span { style: "secretary-waiting", text .waitingText }
                }
            }
            button {
                onclick: .Dismiss
                style: "secretary-dismiss"
                title: "Dismiss"
                X { size: 14 }
            }
        }
        div {
            style: "secretary-actions"
            button {
                onclick: .approve(.gateGateId)
                style: "secretary-btn approve"
                Check { size: 13 }
                text "Approve"
            }
            button {
                onclick: .reject(.gateGateId)
                style: "secretary-btn reject"
                X { size: 13 }
                text "Reject"
            }
            button {
                onclick: .snooze(.gateGateId)
                style: "secretary-btn snooze"
                Clock { size: 13 }
                text "Snooze"
            }
            if .hasSection {
                button {
                    onclick: .ReviewInSpecs(.gateSectionId)
                    style: "secretary-btn review"
                    Eye { size: 13 }
                    text "Review in Specs"
                }
            }
        }
        if .queuePosition > 0 {
            div {
                style: "secretary-queue"
                text .queueLabel
            }
        }
    }
}
