// secretary_message.at — SecretaryMessage 组件（Plan 023 队列 B4：emit + 宿主全局 逃生舱原生化）
//
// 对标 src/front/components/SecretaryMessage.vue（逃生舱，已删除）。
//
// 关键转换：
//   - formatElapsed（Date.now 时间差）→ secretary_helpers.at fn
//   - gate.xxx 字段访问 → computed（.at 模板 text 节点只取简单变量）
//   - approve/reject/snooze 小写 msg + gateId 负载 → 父组件 @approve/@reject/@snooze
//   - review-in-specs（连字符事件名 .at 无法表达）→ ReviewInSpecs camelCase，
//     wrapper 未接线该事件（现状即不转发），按钮视觉保留
//   - dismiss 的 setTimeout（回调空）→ 直接置 isDismissed
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.secretary-message 等）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component Check, X, Clock, Eye from "src/front/ports/icons.at"
use.web secretary_format_elapsed from "src/front/secretary_helpers.at"

widget SecretaryMessage(gate: obj, queuePosition: int) {
    use {
        component: AgentAvatar
    }
    computed {
        gateTitle => .gate.title
        gateProfession => .gate.profession
        waitingText => "Waiting " + secretary_format_elapsed(.gate.since)
        gateGateId => .gate.gateId
        gateSectionId => .gate.sectionId
        hasSection => .gate.sectionId != None && .gate.sectionId != ""
        queueLabel => if .queuePosition > 1 { .queuePosition + " more gates queued" } else { .queuePosition + " more gate queued" }
    }
    msg Msg { Dismiss, approve(str), reject(str), snooze(str), ReviewInSpecs(str) }
    model { var isDismissed bool = false }
    on {
        .Dismiss -> { .isDismissed = true }
        .approve(id) -> {}
        .reject(id) -> {}
        .snooze(id) -> {}
        .ReviewInSpecs(sid) -> {}
    }
    // Plan 029 T22：原 inject_styles 全局兜底下放（scoped 生效于本组件 DOM）。
    style {
  .secretary-message {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 0.6rem 0.8rem; border-radius: 10px;
    border: 1px solid hsl(var(--primary) / 0.2); background: hsl(var(--primary) / 0.04);
    margin: 0.5rem 0; transition: opacity 0.3s, transform 0.3s;
  }
  .secretary-message.dismissed { opacity: 0; transform: translateX(20px); pointer-events: none; }
  .secretary-header { display: flex; align-items: flex-start; gap: 0.5rem; }
  .secretary-info { flex: 1; min-width: 0; }
  .secretary-title { font-size: 0.93rem; font-weight: 500; color: var(--af-fg); line-height: 1.3; }
  .secretary-meta { display: flex; align-items: center; gap: 0.4rem; margin-top: 0.15rem; }
  .secretary-profession { font-size: 0.78rem; padding: 0.1rem 0.35rem; border-radius: 4px; background: hsl(var(--primary) / 0.1); color: var(--af-primary); font-weight: 500; }
  .secretary-waiting { font-size: 0.78rem; color: var(--af-muted); }
  .secretary-dismiss {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; background: transparent; border: none; border-radius: 4px;
    color: var(--af-muted); cursor: pointer; transition: all 0.15s; flex-shrink: 0;
  }
  .secretary-dismiss:hover { background: hsl(var(--muted-foreground) / 0.08); color: var(--af-fg); }
  .secretary-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .secretary-btn {
    display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.3rem 0.6rem; border: none; border-radius: 5px;
    font-size: 0.83rem; font-weight: 500; cursor: pointer; transition: opacity 0.15s;
  }
  .secretary-btn.approve { background: hsl(142 70% 45% / 0.15); color: hsl(142 70% 35%); }
  .secretary-btn.reject { background: hsl(0 70% 45% / 0.1); color: hsl(0 70% 45%); }
  .secretary-btn.snooze { background: hsl(38 90% 50% / 0.1); color: hsl(38 80% 40%); }
  .secretary-btn.review { background: hsl(var(--muted-foreground) / 0.08); color: var(--af-fg); }
  .secretary-btn:hover { opacity: 0.85; }
  .secretary-queue { font-size: 0.78rem; color: var(--af-muted); padding-top: 0.2rem; }
    }

    view {
        div {
            class: if .isDismissed { "secretary-message dismissed" } else { "secretary-message" }
            div {
                style: "secretary-header"
                AgentAvatar { professionId: .gateProfession, name: "", size: "md" }
                div {
                    style: "secretary-info"
                    div { style: "secretary-title", text .gateTitle }
                    div {
                        style: "secretary-meta"
                        span { style: "secretary-profession", text .gateProfession }
                        span { style: "secretary-waiting", text .waitingText }
                    }
                }
                button {
                    onclick: .Dismiss
                    style: "secretary-dismiss"
                    title: "Dismiss"
                    X { size: 14 }
                }
            }
            div {
                style: "secretary-actions"
                button {
                    onclick: .approve(.gateGateId)
                    style: "secretary-btn approve"
                    Check { size: 13 }
                    text "Approve"
                }
                button {
                    onclick: .reject(.gateGateId)
                    style: "secretary-btn reject"
                    X { size: 13 }
                    text "Reject"
                }
                button {
                    onclick: .snooze(.gateGateId)
                    style: "secretary-btn snooze"
                    Clock { size: 13 }
                    text "Snooze"
                }
                if .hasSection {
                    button {
                        onclick: .ReviewInSpecs(.gateSectionId)
                        style: "secretary-btn review"
                        Eye { size: 13 }
                        text "Review in Specs"
                    }
                }
            }
            if .queuePosition > 0 {
                div {
                    style: "secretary-queue"
                    text .queueLabel
                }
            }
        }
    }
}
