// specs_view.at — Spec Ledger 视图（对应 web/src/views/SpecsView.vue）
//
// Phase 5a: section-nav 7 类导航 + overview + item 列表
// Phase 5b: item CRUD（新建/编辑/删除）+ 编辑面板 + 工具函数逃生舱

use store: SpecsStore

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web spec_next_id, spec_default_status, specSectionItems, specItemPatch, specFindItem, specSectionOfItem from "src/front/specs_helpers.at"
use.web useT from "src/front/ports/composables.at"
use.web vsCurrentDetail, vsSetDetailPath from "src/front/ports/composables.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use nav_sidebar: NavSidebar
use goals_table: GoalsTable
use architecture_cards: ArchitectureCards
use design_cards: DesignCards
use tests_cards: TestsCards
use review_cards: ReviewCards
use report_cards: ReportCards
use category_list: CategoryList
use content_header: ContentHeader
use goal_detail_modal: GoalDetailModal

widget SpecsView {

    setup {
        let t = useT()
    }

    msg Msg {
        Init,
        SelectSection(str),
        ToggleOverview,
        SelectItem(str),
        AddItem,
        StartEditItem(str),
        CancelEdit,
        SaveEditItem,
        DeleteItem(str),
        EditTitleChanged,
        EditContentChanged,
        EnterStructuredMode,
        EnterTreeMode,
        SelectSpecFile(str),
        // PLAN-041 债务收口:行内编辑/详情接线(web handleSave/status/jump 族)。
        EditItem(Value),
        RowStatusChange(str),
        RowDelete(str),
        JumpToItem(str),
        SaveTestItem(obj),
        // GoalDetailModal(web openDetailModal 族)。
        OpenDetailModal(obj),
        CloseDetailModal,
        DetailEdit,
        DetailCancelEdit,
        DetailSaveGoal(obj),
        DetailStatusChange(str),
        DetailDelete(str),
        DetailJump(str),
    }

    model {
        // 6 类 section（对应 SectionType；PLAN-024 移除 plans）。
        var section_types List<str> = ["goals", "architecture", "designs", "tests", "reviews", "reports"]
        var active_section str = "goals"
        var show_overview bool = true
        var active_item_id Option<str> = None
        var nav_collapsed bool = false
        // PLAN-025: 文件树模式 toggle（structured | tree）。
        var view_mode str = "structured"
        // 编辑面板状态
        var editing_item_id Option<str> = None
        var edit_title str = ""
        var edit_content str = ""
        var edit_status str = "draft"
        // PLAN-041 债务收口:Add 流走底部面板(edit-panel),既有条目编辑走
        // 行内编辑器(与 web CategoryList 一致)——adding_item 区分两态。
        var adding_item bool = false
        // GoalDetailModal 状态(web detailItem/detailEditing)。
        var detail_item obj = None
        var detail_editing bool = false
    }

    // Plan 028 T9：模板内联 `view_mode == "…"` 三元会被 vue-tsc 流窄化，
    // 兄弟节点的反向比较报 TS2367 —— 收敛为 computed 布尔。
    computed {
        structuredMode => .view_mode == "structured"
        treeMode => .view_mode == "tree"
    }

    view {
        if .structuredMode {
        row {
            style: "specs-view"
            // 左侧 section-nav（Plan 023 §3.1：共用 NavSidebar——header + list slot）
            NavSidebar {
                title: t("specs.title")
                collapsed: .nav_collapsed
                slot(name: "list") {
                    col {
                        style: "section-nav-list"
                        button {
                            onclick: .ToggleOverview
                            style: if .show_overview { "overview-entry active" } else { "overview-entry" }
                            text t("specs.overview")
                        }
                        for section in .section_types {
                            button {
                                key: .section
                                onclick: .SelectSection(.section)
                                style: if .section == .active_section {
                                    "section-nav-item active"
                                } else {
                                    "section-nav-item"
                                }
                                text .section
                            }
                        }
                    }
                }
            }
            // 右侧主内容区
            col {
                style: "specs-main"
                if .show_overview {
                    col {
                        style: "overview-content"
                        h2 "Overview" { style: "text-xl font-bold mb-4" }
                        if .store.overview != "" {
                            text .store.overview
                        } else {
                            text t("specs.loading")
                        }
                    }
                } else {
                    // Plan 023 §3.1：ContentHeader 贴顶全宽（specs-main 无 padding），
                    // 内容容器 section-content 单独 padding（原负 margin hack 消除）。
                    ContentHeader {
                        title: .active_section
                        slot(name: "middle") {
                            row {
                                style: "view-mode-toggle"
                                button {
                                    onclick: .EnterStructuredMode
                                    class: if .structuredMode { "mode-btn active" } else { "mode-btn" }
                                    text t("specs.structuredMode")
                                }
                                button {
                                    onclick: .EnterTreeMode
                                    class: if .treeMode { "mode-btn active" } else { "mode-btn" }
                                    text t("specs.fileTreeMode")
                                }
                            }
                        }
                        slot(name: "actions") {
                            button {
                                onclick: .AddItem
                                style: "add-btn"
                                text t("specs.addItem")
                            }
                        }
                    }
                    col {
                        style: "section-content"
                        if .store.document != None {
                            // PLAN-041 T3:分域组件接线(web SpecsView 同构)。
                            if .active_section == "goals" {
                                GoalsTable {
    items: specSectionItems(.store.document, .active_section)
    project: .store.project
}
                            } else {
                                if .active_section == "architecture" {
                                    ArchitectureCards {
    items: specSectionItems(.store.document, .active_section)
    project: .store.project
    expanded_id: .active_item_id
    editing_id: .editing_item_id
}
                                } else {
                                    if .active_section == "designs" {
                                        DesignCards {
    items: specSectionItems(.store.document, .active_section)
    project: .store.project
    expanded_id: .active_item_id
    editing_id: .editing_item_id
}
                                    } else {
                                        if .active_section == "tests" {
                                            TestsCards {
    items: specSectionItems(.store.document, .active_section)
    project: .store.project
    expanded_id: .active_item_id
    editing_id: .editing_item_id
}
                                        } else {
                                            if .active_section == "reviews" {
                                                ReviewCards {
    items: specSectionItems(.store.document, .active_section)
    project: .store.project
    expanded_id: .active_item_id
    editing_id: .editing_item_id
}
                                            } else {
                                                if .active_section == "reports" {
                                                    ReportCards {
    items: specSectionItems(.store.document, .active_section)
    project: .store.project
    expanded_id: .active_item_id
    editing_id: .editing_item_id
}
                                                } else {
                                                    // plans/api 及未知 section:通用 CategoryList。
                                                    CategoryList {
    items: specSectionItems(.store.document, .active_section)
    project: .store.project
    expanded_id: .active_item_id
    editing_id: .editing_item_id
    section_type: .active_section
    summary_kind: .active_section
    detail_kind: ""
    ontoggle: .SelectItem($event)
    onjump: .JumpToItem($event)
    onedititem: .EditItem($event)
    onstatuschange: .RowStatusChange($event)
    ondelete: .RowDelete($event)
    onsavetest: .SaveTestItem($event)
    oncanceledit: .CancelEdit
}
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            text t("specs.noDoc")
                        }
                        // 编辑面板(Add 流专用;既有条目编辑走行内编辑器)。
                        if .adding_item {
                            col {
                                style: "edit-panel"
                                h3 "Edit Item" { style: "text-lg font-bold mb-2" }
                                col {
                                    style: "form-group"
                                    label "Title"
                                    input {
                                        value: .edit_title
                                        oninput: .EditTitleChanged
                                        style: "form-input"
                                    }
                                }
                                col {
                                    style: "form-group"
                                    label "Status"
                                    input {
                                        value: .edit_status
                                        oninput: .EditContentChanged
                                        style: "form-input"
                                    }
                                }
                                col {
                                    style: "form-group"
                                    label "Content"
                                    textarea {
                                        value: .edit_content
                                        oninput: .EditContentChanged
                                        style: "form-input content-input"
                                    }
                                }
                                row {
                                    style: "edit-actions"
                                    button {
                                        onclick: .SaveEditItem
                                        style: "save-btn"
                                        text t("common.save")
                                    }
                                    button {
                                        onclick: .CancelEdit
                                        style: "cancel-btn"
                                        text t("common.cancel")
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // PLAN-041 债务收口:GoalDetailModal(web Teleport→原位渲染,
            // position:fixed 全屏遮罩,DOM 挂载点差异登记)。
            GoalDetailModal {
                item: .detail_item
                project: .store.project
                section_type: "goals"
                is_editing: .detail_editing
                onclose: .CloseDetailModal
                onedit: .DetailEdit
                onsavegoal: .DetailSaveGoal($event)
                oncanceledit: .DetailCancelEdit
                onstatuschange: .DetailStatusChange($event)
                ondelete: .DetailDelete($event)
                onjump: .DetailJump($event)
            }
        }
        } else {
            // PLAN-025 §10: 扁平文件树渲染（递归留作 KNOWN-DEBT）
            row {
                style: "specs-view"
                col {
                    style: "filetree-nav"
                    for node in .store.spec_tree {
                        button {
                            key: .node.path
                            onclick: .SelectSpecFile(.node.path)
                            class: if .store.active_spec_file_path == .node.path { "tree-item active" } else { "tree-item" }
                            text .node.name
                        }
                    }
                }
                col {
                    style: "specs-main"
                    ContentHeader {
                        title: t("specs.fileTreeMode")
                        slot(name: "middle") {
                            row {
                                style: "view-mode-toggle"
                                button {
                                    onclick: .EnterStructuredMode
                                    class: if .structuredMode { "mode-btn active" } else { "mode-btn" }
                                    text t("specs.structuredMode")
                                }
                                button {
                                    onclick: .EnterTreeMode
                                    class: if .treeMode { "mode-btn active" } else { "mode-btn" }
                                    text t("specs.fileTreeMode")
                                }
                            }
                        }
                    }
                    col {
                        style: "filetree-editor"
                        if .store.active_spec_file_content != "" {
                            text .store.active_spec_file_content
                        } else {
                            text t("specs.selectFile")
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            store.Init();
            store.LoadOverview();
            // URL detail 子路径恢复(web restoreSpecsFromUrl:/<view>/<section>/<item>)。
            let d = vsCurrentDetail()
            if d != "" {
                let parts = d.split("/")
                if parts.length > 0 {
                    let sec = parts[0]
                    if sec != "" {
                        .active_section = sec;
                        .show_overview = false
                    }
                    if parts.length > 1 {
                        .active_item_id = parts[1]
                    }
                }
            }
        }

        .SelectSection(section) -> {
            .active_section = section;
            .show_overview = false;
            vsSetDetailPath(section)
        }

        .ToggleOverview -> { .show_overview = !.show_overview }

        .SelectItem(id) -> {
            // web toggleItem:再点折叠。
            if .active_item_id == id {
                .active_item_id = None;
                vsSetDetailPath(.active_section)
            } else {
                .active_item_id = id;
                vsSetDetailPath(.active_section + "/" + id)
            }
        }

        // AddItem: 用 getNextId/getDefaultStatus 创建新 item，进入编辑。
        .AddItem -> {
            let new_id = spec_next_id(.active_section, []);
            .edit_title = "New " + .active_section;
            .edit_content = "";
            .edit_status = spec_default_status(.active_section);
            .editing_item_id = new_id;
            .adding_item = true;
            .active_item_id = new_id
        }

        // StartEditItem(id): 加载现有 item 到编辑面板。
        .StartEditItem(id) -> {
            .editing_item_id = id;
            .edit_title = id;
            .edit_content = "";
            .edit_status = "draft"
        }

        .CancelEdit -> {
            .editing_item_id = None;
            .adding_item = false
        }

        // SaveEditItem: 保存编辑（新建或更新）。
        .SaveEditItem -> {
            if .editing_item_id != None {
                // VM 轨:struct 字面量字段值经通用表达式编译,`.x` 的 self 别名
                // 不在绑定面——状态读取先提升为局部变量(442 B 探针裁定)。
                let eid = .editing_item_id
                let etitle = .edit_title
                let econtent = .edit_content
                let estatus = .edit_status
                let item = SpecItem {
                    id: eid,
                    title: etitle,
                    content: econtent,
                    status: estatus,
                    depends_on: [],
                    related: [],
                    priority: "",
                    assignee: "",
                    test_file: "",
                    file: "",
                    milestone: "",
                    module: "",
                    tags: [],
                    created_at: 0,
                    modified_at: 0,
                    completed_at: 0,
                };
                store.SaveItem(.active_section, item);
                .editing_item_id = None;
                .adding_item = false
            }
        }

        // DeleteItem(id): 删除 item。
        .DeleteItem(id) -> {
            store.DeleteItem(.active_section, id);
            .active_item_id = None
        }

        // v-model marker handlers（U5）。
        .EditTitleChanged -> { .edit_title = .edit_title }
        .EditContentChanged -> { .edit_status = .edit_status }

        // PLAN-025: 文件树模式 toggle。首次切到 tree 时加载 docs/specs/ 树。
        .EnterStructuredMode -> {
            .view_mode = "structured"
        }

        .EnterTreeMode -> {
            .view_mode = "tree"
            if !.store.spec_tree_loaded {
                store.LoadSpecTree()
            }
        }

        // PLAN-025: 选中文件 → 读正文（文件夹点击忽略；扁平渲染不展开）。
        .SelectSpecFile(path) -> {
            store.LoadSpecFile(path)
        }

        // ── PLAN-041 债务收口:行内编辑/详情接线(web handleSave 族) ──

        // EditItem(item):既有条目进入行内编辑(web startEditItem)。
        .EditItem(item) -> {
            .active_item_id = item.id;
            .editing_item_id = item.id;
            .adding_item = false
        }

        // RowStatusChange(status):当前展开条目的状态迁移(web handleStatusChange
        // ——payload 只携带新状态,id 取展开行 active_item_id)。
        .RowStatusChange(status) -> {
            if .active_item_id != None {
                let item = specFindItem(.store.document, .active_item_id)
                if item != None {
                    store.SaveItem(.active_section, specItemPatch(item, {status: status}))
                }
            }
        }

        // RowDelete(id):行内删除(web handleDelete)。
        .RowDelete(id) -> {
            store.DeleteItem(.active_section, id);
            .active_item_id = None
        }

        // JumpToItem(id):跨 section 跳转(web jumpToItem,flash 高亮舍弃)。
        .JumpToItem(id) -> {
            let section = specSectionOfItem(.store.document, id)
            if section != "" {
                .active_section = section;
                .active_item_id = id;
                .show_overview = false
            }
        }

        // SaveTestItem(item):TestEditor 保存(payload 已在行级合并为完整 item)。
        .SaveTestItem(item) -> {
            store.SaveItem(.active_section, item);
            .editing_item_id = None;
            .adding_item = false
        }

        // ── GoalDetailModal 接线(web openDetailModal 族) ──

        .OpenDetailModal(item) -> {
            .detail_item = item;
            .detail_editing = false
        }

        .CloseDetailModal -> {
            .detail_item = None;
            .detail_editing = false
        }

        .DetailEdit -> {
            .detail_editing = true
        }

        .DetailCancelEdit -> {
            .detail_editing = false
        }

        .DetailSaveGoal(payload) -> {
            if .detail_item != None {
                let item = specFindItem(.store.document, .detail_item.id)
                if item != None {
                    store.SaveItem("goals", specItemPatch(item, payload))
                }
            }
            .detail_editing = false
        }

        .DetailStatusChange(status) -> {
            if .detail_item != None {
                let item = specFindItem(.store.document, .detail_item.id)
                if item != None {
                    store.SaveItem("goals", specItemPatch(item, {status: status}))
                }
            }
        }

        .DetailDelete(id) -> {
            store.DeleteItem("goals", id);
            .detail_item = None;
            .detail_editing = false
        }

        .DetailJump(id) -> {
            .CloseDetailModal();
            .JumpToItem(id)
        }
    }
}
