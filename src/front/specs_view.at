// specs_view.at — Spec Ledger 视图（对应 web/src/views/SpecsView.vue）
//
// SpecsView.vue 1396 行：左侧 section-nav（7 类 section + overview + module
// accordion + 搜索）+ 右侧主内容（当前 section 的 item 列表 + detail 编辑）。
//
// Plan 022 Phase 5a: 先做核心骨架——section-nav（7 类导航 + overview）+
// 主内容区（当前 section 的 item 列表）。CRUD 编辑/module accordion/搜索/
// gate 审批/detail 编辑留 Phase 5b。

use store: SpecsStore

widget SpecsView {
    msg Msg {
        Init,
        SelectSection(str),
        ToggleOverview,
        SelectItem(str),
    }

    model {
        // 7 类 section（对应 SectionType）。
        var sections List<str> = ["goals", "architecture", "designs", "plans", "tests", "reviews", "reports"]
        var active_section str = "goals"
        var show_overview bool = true
        var active_item_id Option<str> = None
        var nav_collapsed bool = false
    }

    computed {
        // 当前 section 的标题（i18n key 形式，Phase 5b 接 t()）。
        active_title => .active_section
        // section_count 留 Phase 5b（依赖 document.value.sections.len()，
        // 当前 document 是 Option，computed 保持简单）。
    }

    view {
        row {
            style: "specs-view"
            // 左侧 section-nav
            col {
                style: if .nav_collapsed { "section-nav collapsed" } else { "section-nav" }
                // 标题
                row {
                    style: "section-nav-header"
                    text "Specs" { style: "section-nav-title" }
                }
                // Overview 条目
                button {
                    onclick: .ToggleOverview
                    style: if .show_overview { "overview-entry active" } else { "overview-entry" }
                    text "Overview"
                }
                // 7 类 section 导航
                for section in .sections {
                    button {
                        onclick: .SelectSection(.section)
                        style: if .section == .active_section {
                            "section-nav-item active"
                        } else {
                            "section-nav-item"
                        }
                        text .section
                    }
                }
            }
            // 右侧主内容区
            col {
                style: "specs-main"
                if .show_overview {
                    // Overview 内容（markdown 摘要）
                    col {
                        style: "overview-content"
                        h2 "Overview" { style: "text-xl font-bold mb-4" }
                        if .store.overview.value != "" {
                            text .store.overview.value
                        } else {
                            text "Loading overview..."
                        }
                    }
                } else {
                    // 当前 section 的 item 列表
                    col {
                        style: "section-content"
                        row {
                            style: "section-header"
                            h2 .active_section { style: "text-xl font-bold" }
                        }
                        if .store.document.value != None {
                            for section in .store.document.value.sections {
                                if .section.section_type == .active_section {
                                    for item in .section.items {
                                        button {
                                            onclick: .SelectItem(.item.id)
                                            style: if .item.id == .active_item_id {
                                                "spec-item-row active"
                                            } else {
                                                "spec-item-row"
                                            }
                                            col {
                                                style: "spec-item-main"
                                                text .item.title { style: "spec-item-title" }
                                                text .item.status { style: "spec-item-status" }
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            text "No document loaded"
                        }
                    }
                }
            }
        }
    }

    on {
        // Init: 加载 document + overview。
        .Init -> {
            store.Init()
            store.LoadOverview()
        }

        // SelectSection(section): 切换 active section，关闭 overview。
        .SelectSection(section) -> {
            .active_section = section
            .show_overview = false
        }

        // ToggleOverview: 切换 overview 显示。
        .ToggleOverview -> {
            .show_overview = !.show_overview
        }

        // SelectItem(id): 选中一个 item（Phase 5b 打开 detail 编辑）。
        .SelectItem(id) -> {
            .active_item_id = id
        }
    }
}
