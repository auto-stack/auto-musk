// specs_view.at — Spec Ledger 视图（对应 web/src/views/SpecsView.vue）
//
// Phase 5a: section-nav 7 类导航 + overview + item 列表
// Phase 5b: item CRUD（新建/编辑/删除）+ 编辑面板 + 工具函数逃生舱

use store: SpecsStore

widget SpecsView {
    use {
        fn: getNextId, getDefaultStatus from "src/front/utils/itemTemplates.ts"
        composable: useT from "src/front/composables/useT.ts"
        // Plan 023 §3.1：共用 NavSidebar + ContentHeader。
        component: NavSidebar
        component: ContentHeader
    }

    msg Msg {
        Init,
        SelectSection(str),
        ToggleOverview,
        SelectItem(str),
        AddItem,
        StartEditItem(str),
        CancelEdit,
        SaveEditItem,
        DeleteItem(str),
        EditTitleChanged,
        EditContentChanged,
        EnterStructuredMode,
        EnterTreeMode,
        SelectSpecFile(str),
    }

    model {
        // 6 类 section（对应 SectionType；PLAN-024 移除 plans）。
        var section_types List<str> = ["goals", "architecture", "designs", "tests", "reviews", "reports"]
        var active_section str = "goals"
        var show_overview bool = true
        var active_item_id Option<str> = None
        var nav_collapsed bool = false
        // PLAN-025: 文件树模式 toggle（structured | tree）。
        var view_mode str = "structured"
        // 编辑面板状态
        var editing_item_id Option<str> = None
        var edit_title str = ""
        var edit_content str = ""
        var edit_status str = "draft"
    }

    // Plan 028 T9：模板内联 `view_mode == "…"` 三元会被 vue-tsc 流窄化，
    // 兄弟节点的反向比较报 TS2367 —— 收敛为 computed 布尔。
    computed {
        structuredMode => .view_mode == "structured"
        treeMode => .view_mode == "tree"
    }

    view {
        if .structuredMode {
        row {
            style: "specs-view"
            // 左侧 section-nav（Plan 023 §3.1：共用 NavSidebar——header + list slot）
            NavSidebar {
                title: t("specs.title")
                collapsed: .nav_collapsed
                slot(name: "list") {
                    col {
                        style: "section-nav-list"
                        button {
                            onclick: .ToggleOverview
                            style: if .show_overview { "overview-entry active" } else { "overview-entry" }
                            text t("specs.overview")
                        }
                        for section in .section_types {
                            button {
                                key: .section
                                onclick: .SelectSection(.section)
                                style: if .section == .active_section {
                                    "section-nav-item active"
                                } else {
                                    "section-nav-item"
                                }
                                text .section
                            }
                        }
                    }
                }
            }
            // 右侧主内容区
            col {
                style: "specs-main"
                if .show_overview {
                    col {
                        style: "overview-content"
                        h2 "Overview" { style: "text-xl font-bold mb-4" }
                        if .store.overview != "" {
                            text .store.overview
                        } else {
                            text t("specs.loading")
                        }
                    }
                } else {
                    // Plan 023 §3.1：ContentHeader 贴顶全宽（specs-main 无 padding），
                    // 内容容器 section-content 单独 padding（原负 margin hack 消除）。
                    ContentHeader {
                        title: .active_section
                        slot(name: "middle") {
                            row {
                                style: "view-mode-toggle"
                                button {
                                    onclick: .EnterStructuredMode
                                    class: if .structuredMode { "mode-btn active" } else { "mode-btn" }
                                    text t("specs.structuredMode")
                                }
                                button {
                                    onclick: .EnterTreeMode
                                    class: if .treeMode { "mode-btn active" } else { "mode-btn" }
                                    text t("specs.fileTreeMode")
                                }
                            }
                        }
                        slot(name: "actions") {
                            button {
                                onclick: .AddItem
                                style: "add-btn"
                                text t("specs.addItem")
                            }
                        }
                    }
                    col {
                        style: "section-content"
                        if .store.document != None {
                            for section in .store.document.sections {
                                if .section.section_type == .active_section {
                                    for item in .section.items {
                                        col {
                                            style: if .item.id == .active_item_id {
                                                "spec-item-row active"
                                            } else {
                                                "spec-item-row"
                                            }
                                            button {
                                                onclick: .SelectItem(.item.id)
                                                style: "spec-item-btn"
                                                row {
                                                    style: "spec-item-main"
                                                    text .item.title { style: "spec-item-title" }
                                                    text .item.status { style: "spec-item-status" }
                                                }
                                            }
                                            // 编辑/删除按钮（选中时显示）
                                            if .item.id == .active_item_id {
                                                row {
                                                    style: "spec-item-actions"
                                                    button {
                                                        onclick: .StartEditItem(.item.id)
                                                        style: "action-btn"
                                                        text t("common.edit")
                                                    }
                                                    button {
                                                        onclick: .DeleteItem(.item.id)
                                                        style: "action-btn danger"
                                                        text t("common.delete")
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            text t("specs.noDoc")
                        }
                        // 编辑面板（editing_item_id 非 None 时显示）
                        if .editing_item_id != None {
                            col {
                                style: "edit-panel"
                                h3 "Edit Item" { style: "text-lg font-bold mb-2" }
                                col {
                                    style: "form-group"
                                    label "Title"
                                    input {
                                        value: .edit_title
                                        oninput: .EditTitleChanged
                                        style: "form-input"
                                    }
                                }
                                col {
                                    style: "form-group"
                                    label "Status"
                                    input {
                                        value: .edit_status
                                        oninput: .EditContentChanged
                                        style: "form-input"
                                    }
                                }
                                col {
                                    style: "form-group"
                                    label "Content"
                                    textarea {
                                        value: .edit_content
                                        oninput: .EditContentChanged
                                        style: "form-input content-input"
                                    }
                                }
                                row {
                                    style: "edit-actions"
                                    button {
                                        onclick: .SaveEditItem
                                        style: "save-btn"
                                        text t("common.save")
                                    }
                                    button {
                                        onclick: .CancelEdit
                                        style: "cancel-btn"
                                        text t("common.cancel")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        } else {
            // PLAN-025 §10: 扁平文件树渲染（递归留作 KNOWN-DEBT）
            row {
                style: "specs-view"
                col {
                    style: "filetree-nav"
                    for node in .store.spec_tree {
                        button {
                            key: .node.path
                            onclick: .SelectSpecFile(.node.path)
                            class: if .store.active_spec_file_path == .node.path { "tree-item active" } else { "tree-item" }
                            text .node.name
                        }
                    }
                }
                col {
                    style: "specs-main"
                    ContentHeader {
                        title: t("specs.fileTreeMode")
                        slot(name: "middle") {
                            row {
                                style: "view-mode-toggle"
                                button {
                                    onclick: .EnterStructuredMode
                                    class: if .structuredMode { "mode-btn active" } else { "mode-btn" }
                                    text t("specs.structuredMode")
                                }
                                button {
                                    onclick: .EnterTreeMode
                                    class: if .treeMode { "mode-btn active" } else { "mode-btn" }
                                    text t("specs.fileTreeMode")
                                }
                            }
                        }
                    }
                    col {
                        style: "filetree-editor"
                        if .store.active_spec_file_content != "" {
                            text .store.active_spec_file_content
                        } else {
                            text t("specs.selectFile")
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            store.Init();
            store.LoadOverview()
        }

        .SelectSection(section) -> {
            .active_section = section;
            .show_overview = false
        }

        .ToggleOverview -> { .show_overview = !.show_overview }

        .SelectItem(id) -> { .active_item_id = id }

        // AddItem: 用 getNextId/getDefaultStatus 创建新 item，进入编辑。
        .AddItem -> {
            let new_id = getNextId(.active_section, []);
            .edit_title = "New " + .active_section;
            .edit_content = "";
            .edit_status = getDefaultStatus(.active_section);
            .editing_item_id = new_id;
            .active_item_id = new_id
        }

        // StartEditItem(id): 加载现有 item 到编辑面板。
        .StartEditItem(id) -> {
            .editing_item_id = id;
            .edit_title = id;
            .edit_content = "";
            .edit_status = "draft"
        }

        .CancelEdit -> {
            .editing_item_id = None
        }

        // SaveEditItem: 保存编辑（新建或更新）。
        .SaveEditItem -> {
            if .editing_item_id != None {
                let item = SpecItem {
                    id: .editing_item_id,
                    title: .edit_title,
                    content: .edit_content,
                    status: .edit_status,
                    depends_on: [],
                    related: [],
                    priority: "",
                    assignee: "",
                    test_file: "",
                    file: "",
                    milestone: "",
                    module: "",
                    tags: [],
                    created_at: 0,
                    modified_at: 0,
                    completed_at: 0,
                };
                store.SaveItem(.active_section, item);
                .editing_item_id = None
            }
        }

        // DeleteItem(id): 删除 item。
        .DeleteItem(id) -> {
            store.DeleteItem(.active_section, id);
            .active_item_id = None
        }

        // v-model marker handlers（U5）。
        .EditTitleChanged -> { .edit_title = .edit_title }
        .EditContentChanged -> { .edit_status = .edit_status }

        // PLAN-025: 文件树模式 toggle。首次切到 tree 时加载 docs/specs/ 树。
        .EnterStructuredMode -> {
            .view_mode = "structured"
        }

        .EnterTreeMode -> {
            .view_mode = "tree"
            if !.store.spec_tree_loaded {
                store.LoadSpecTree()
            }
        }

        // PLAN-025: 选中文件 → 读正文（文件夹点击忽略；扁平渲染不展开）。
        .SelectSpecFile(path) -> {
            store.LoadSpecFile(path)
        }
    }
}
