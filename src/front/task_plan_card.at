// task_plan_card.at — TaskPlanCard 组件（Plan 023 P3 续：逃生舱原生化）
//
// 对标 src/front/components/TaskPlanCard.vue（逃生舱）。
// 沿用 ErrandCard 验证过的迁移模式（408 P4-P9 全落地）。
//
// 迁移要点（ErrandCard 沉淀）：
//   - template text 节点只用简单变量引用（无拼接/行内 if/链式字段，否则 parser 陷阱）
//   - 动态 class 用嵌套 if 表达式（生成 :class）；拼接会生成 :style 失效
//   - computed 字段的子字段访问提到独立 computed（如 plan.id → taskId computed）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.task-plan-card 等）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web getTaskPlan, taskPlanStatusLabel from "src/front/forge_helpers.at"

component fn TaskPlanCard(tc: obj, taskPlans: obj) {
    computed {
        plan => getTaskPlan(.taskPlans, .tc)
        hasPlan => .plan != None
        status => if .hasPlan { .plan.status } else { "idle" }
        statusLabel => taskPlanStatusLabel(.status)
        chevron => if .expanded { "▲" } else { "▼" }
        hasPhases => if .hasPlan { .plan.phases != None } else { false }
        phasesList => if .hasPlan { .plan.phases } else { [] }
        phasesLabel => if .hasPhases { .plan.phases.length + " phases" } else { "" }
        hasTaskPlanId => if .hasPlan { .plan.task_plan_id != "" } else { false }
        taskPlanId => if .hasPlan { .plan.task_plan_id } else { "" }
        hasInstanceId => if .hasPlan { .plan.instance_id != "" } else { false }
        instanceId => if .hasPlan { .plan.instance_id } else { "" }
    }
    msg Msg { Toggle }
    model { var expanded bool = false }
    on {
        .Toggle -> { .expanded = !.expanded }
    }
    style {
.tp-header { display: flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.75rem; cursor: pointer; font-size: 0.82rem; }
.tp-header:hover { background: hsl(280 60% 96% / 0.7); }
.tp-icon { font-size: 0.9rem; }
.tp-title { font-weight: 500; flex: 1; }
.tp-status { font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 3px; }
.tp-status.running, .tp-status.started { background: hsl(var(--primary) / 0.15); color: hsl(var(--primary)); }
.tp-status.completed { background: hsl(142 71% 45% / 0.15); color: hsl(142 71% 45%); }
.tp-status.failed { background: hsl(var(--destructive) / 0.15); color: hsl(var(--destructive)); }
.tp-progress { font-size: 0.72rem; color: hsl(var(--muted-foreground)); }
.tp-body { padding: 0.5rem 0.75rem; border-top: 1px solid hsl(var(--border)); font-size: 0.8rem; }
.tp-field { display: flex; gap: 0.4rem; margin: 0.2rem 0; }
.tp-field-label { color: hsl(var(--muted-foreground)); min-width: 60px; }
.tp-field-value { font-family: monospace; font-size: 0.75rem; }
.tp-phases { margin: 0.4rem 0; display: flex; flex-direction: column; gap: 0.2rem; }
.tp-phase { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; padding: 0.15rem 0; }
.tp-phase-icon { font-size: 0.75rem; }
.tp-phase-name { flex: 1; color: hsl(var(--foreground)); }
.tp-phase-status { font-size: 0.68rem; color: hsl(var(--muted-foreground)); }
.tp-empty { font-size: 0.78rem; color: hsl(var(--muted-foreground)); font-style: italic; }
.task-plan-card { border: 1px solid hsl(var(--border)); border-radius: 8px; margin: 0; overflow: hidden; background: hsl(280 60% 96% / 0.4); width: 100%; }
    }

    col {
        class: if .status == "completed" { "task-plan-card completed" } else { if .status == "failed" { "task-plan-card failed" } else { "task-plan-card running" } }
        row {
            onclick: .Toggle
            style: "tp-header"
            text "📋" { style: "tp-icon" }
            text "Task Plan" { style: "tp-title" }
            text .statusLabel { class: if .status == "completed" { "tp-status completed" } else { if .status == "failed" { "tp-status failed" } else { "tp-status running" } } }
            if .hasPhases {
                text .phasesLabel { style: "tp-progress" }
            }
            text .chevron { style: "tool-chevron" }
        }
        if .expanded {
            col {
                style: "tp-body"
                if .hasTaskPlanId {
                    row {
                        style: "tp-field"
                        text "Plan:" { style: "tp-field-label" }
                        text .taskPlanId { style: "tp-field-value" }
                    }
                }
                if .hasInstanceId {
                    row {
                        style: "tp-field"
                        text "Instance:" { style: "tp-field-label" }
                        text .instanceId { style: "tp-field-value" }
                    }
                }
                if .hasPhases {
                    col {
                        style: "tp-phases"
                        for ph in .phasesList {
                            row {
                                class: if .ph.status == "completed" { "tp-phase completed" } else { if .ph.status == "failed" { "tp-phase failed" } else { "tp-phase running" } }
                                if .ph.status == "completed" {
                                    text "✓" { style: "tp-phase-icon" }
                                } else if .ph.status == "running" {
                                    text "▶" { style: "tp-phase-icon" }
                                } else if .ph.status == "failed" {
                                    text "✗" { style: "tp-phase-icon" }
                                } else {
                                    text "○" { style: "tp-phase-icon" }
                                }
                                text .ph.phase { style: "tp-phase-name" }
                                text .ph.status { style: "tp-phase-status" }
                            }
                        }
                    }
                }
                if !.hasPlan {
                    text "等待 task plan 数据…" { style: "tp-empty" }
                }
            }
        }
    }
}
