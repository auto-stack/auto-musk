// forge_store.at — Forge 聊天状态 store（对应 useForge.ts）
//
// Phase 7: 极简状态层。复杂逻辑（SSE 消费、消息构造、事件分发）全部在
// forge_stream.ts 逃生舱里，store 只管状态 + 简单调用，避开 codegen 对 store
// handler 复杂控制流（嵌套 if/return/结构体字面量）的 parser 边界。

use back.api: chats_list_sessions, chats_create_session, chats_send_message, chats_approve, chats_reject_all, chats_fork_session, chats_navigate_session, chats_set_thinking, chats_set_approval, chats_cancel_session

store ForgeStore {
    model {
        var session_id str = ""
        var messages []Value = []
        // PLAN-043: 活跃分支叶（空 = 线性/旧数据）。
        var active_leaf str = ""
        var session_list []Value = []
        var loading bool = false
        var error str = ""
        var streaming bool = false
        // PLAN-536 T12: 发送前回合基线（StartStream 乐观 push 后写定）——
        // PollStream 完成启发式的回合增长守卫用（防旧 assistant 尾部误判完成）。
        var pre_stream_len int = 0
        var poll_window []Value = []
        // PLAN-067 T-02: 最近一次流事件时间戳（OnStreamEvent 入口写定）——
        // PollStream 的 SSE 健康门：流活着就不做全量回填（运行中服务端
        // 快照不含未完成 assistant,回填会反复清掉流式内容）。
        var last_sse_at int = 0
        var current_draft str = ""
        var thinking str = ""
        var workspace str = ""
        // PLAN-080 T-02: workspace 单源真值（ws_resolve_current 解析后经
        // SetWorkspace 回填；name/path 供 WorkspaceSelector 触发器显示）。
        var workspace_name str = ""
        var workspace_path str = ""
        var token str = ""
        // Phase 7c: errand/relay/task_plan 内联卡片状态（逃生舱 forge_stream.ts 直操作）
        var errands Value = {}
        var relays Value = {}
        var task_plans Value = {}
        // Phase 7.3 续: session 审批态 + gate + report（forge_stream 回写 + LoadSession 回写）
        var session_status str = "idle"
        var session_phase str = "intake"
        var active_profession str = ""
        var pending_spec_changes []Value = []
        var current_gate Value = null
        var report_data Value = null
        // Plan 028 T14：SSE 流句柄（Sse.open/close 平台协议，替代 forge_stream.ts）
        var stream_es Value = null
        // PLAN-055 ④/T11 + PLAN-059 T9：思考块/工具卡展开态——单槽字符串
        // （手风琴式,同 id 再点收起）。【2026-09-04 三次定案】消息对象直写
        // （msg.think_expanded/tool_expanded）在 VM 为 for-in 循环副本写,读侧
        // 永不更新;列表 prop 跨子件边界不可迭代（051 T8 返回值错位族）——
        // 唯 store 字符串字段:子件 handler 直调 ForgeStore.*Toggle 写共享根态
        // （autoui_state 实证可达）,ChatMessage 经 str prop 每帧重建刷新读取。
        var think_open str = ""
        var tool_open str = ""
        // PLAN-064: 本会话思考档位（"" = 关闭/跟随 role 默认；off|low|high|max）。
        // 仅 UI 态 + PATCH 持久化到会话，发送链路不携带（后端 run 时读会话）。
        var thinking_level str = "low"
        // PLAN-067 T-05: 本会话审批模式（human|auto;缺省 human）。仅 UI 态 +
        // PATCH 持久化到会话;后端 relay driver 遇 gate 时读会话模式。
        var approval_mode str = "human"
        // PLAN-071 需求⑧ T-34：当前会话 mode（乐观 assistant 气泡的职业
        // 身份映射用；LoadSession/SwitchSession/NewSession 回填）。
        var session_mode str = "superpowers"
        // PLAN-071 需求⑥调试：PollStream 决策去重打点。
        var dbg_last str = ""
        // PLAN-071 需求⑮：运行在途时排队的待发消息（FIFO；流式收束后
        // FlushQueue 逐条自动发送）。
        var pending_msgs []Value = []
        // PLAN-083 T-03：异步数据链状态——workspace 切换骨架门（列表+首屏
        // 两跳共用）、历史分页游标（/page 端点 has_more/next_before）、滚动
        // 加载在途门、PollStream 异步回填在途门（防重入：上一拍请求未回收
        // 不再发起新拍）。
        var ws_loading bool = false
        var has_more bool = false
        var next_before str = ""
        var older_loading bool = false
        var poll_inflight bool = false
    }

        msg Msg {
        Init,
        LoadSessionList,
        NewSession,
        SwitchSession(str),
        StreamStarted(str),
        Send(str),
        StopStream,
        CancelRun,
        SetThinking(str),
        FinalizeDraft,
        SetError(str),
        // PLAN-071 需求⑮：运行在途时消息排队（流式收束后 FlushQueue 自动
        // 发送），替代"拒绝 + 请重发"。
        QueueMessage(str),
        FlushQueue,
        // PLAN-064: 思考档位切换（off|low|high|max；PLAN-071 需求⑩起未设置
        // 即默认 low，"off" 为显式关闭）。
        SetThinkingLevel(str),
        // PLAN-067 T-05: 审批模式切换（human|auto）。
        SetApprovalMode(str),
        ClearGate,
        ApproveGate,
        RejectGate,
        // Plan 028 T14：SSE 流生命周期（替代 forge_stream.ts 的 start/stopForgeStream）
        StartStream(str, str, str, str),
        AttachStream,
        OnStreamEvent(Value),
        // Plan 051 T10（G1 阶段1）：VM 轮询降级的流式回填拍。
        PollStream,
        // PLAN-055 ④/T11 + PLAN-059 T9：思考块/工具卡展开切换（子件上抛,
        // 键 think=msg.id / tool=block.tkey）。
        ThinkToggle(str),
        ToolToggle(str),
        // PLAN-080 T-02: workspace 单源回填（app.at/login.at 经
        // ws_resolve_current() 解析后入 store；selector 读 store）。
        SetWorkspace(Value),
        // PLAN-083 T-03：异步消息桥回填段（Http.get_msg 完成以字符串载荷
        // {"ok","status","body"} 到达——发起段在 LoadSessionList/
        // FireDetailLoad/LoadOlder/PollStream，全部即返不冻结 UI）。
        SessionsLoaded(str),
        DetailLoaded(str),
        OlderLoaded(str),
        PollBackfill(str),
        FireDetailLoad,
        LoadOlder,
    }

    // Plan 051 T10（G1 阶段1）：VM 轨无 SSE 形态期间，流式回复以 500ms
    // 轮询回填替代（.streaming 门控——Send 置真、末条非空 assistant 置假；
    // 条件假不派发不停底层计时）。web 轨仍走 Sse.open 流式（timer 拍在
    // vue 轨同样存在但 handler 逻辑幂等——全量回填与 SSE 增量回写共存时
    // 以轮询覆盖为最终态，SSE 到达的增量会在下一拍被全量快照校正）。
    // PLAN-083 T-03：回填取数异步化（Http.get_msg 发起即返 + PollBackfill
    // 回填段）——快照换分页端点（最近 50 条 + blocks_normalized 直出），
    // 轮询拍不再同步忙等/全量解析。SSE 桥泛化（阶段2）后退役。
    timer {
        // PLAN-536 T12(D4 修复,musk 侧⑥)：when 门摘除——.streaming 的跨模块
        // SET_FIELD 不可达根态（见 PollStream 注④），when 门恒假把轮询拍
        // 在 handler 之前整体丢弃，deadman 窗（handler 内）永无执行机会。
        // 门控职责已由 handler 内 deadman 窗接管。
        PollStream (every_ms: 500)
    }

    on {
        // PLAN-059 T9:展开态切换（chat_message 子件 handler 直调;键取反经
        // 内联 fn——store 文件不消费 use.web.fn 导入,沿 nowSec 内联先例）。
        .ThinkToggle(key str) -> {
            .think_open = toggleBlockExpansion(.think_open, key)
        }
        .ToolToggle(key str) -> {
            .tool_open = toggleBlockExpansion(.tool_open, key)
        }

        // PLAN-080 T-02: workspace 单源回填——meta 为 ws_resolve_current()
        // 产物（{id,name,path}）；None 时 no-op（保留引导值，等下一轮解析）。
        // PLAN-081: id 变化时本 msg 同时是 VM 轨"切换完成"事件——VM 的
        // location.reload() 是 no-op（auto.dom.reload stub，见 selector 注），
        // web 靠 reload 完成的整页重载语义由这里承接：清会话域状态 + 关旧
        // 流 + 重拉列表（LoadSessionList 对空 session_id 自动选首个会话）。
        // id 未变（boot 解析回填同值）仅更新显示字段，防启动双拉。
        .SetWorkspace(meta Value) -> {
            if meta != None {
                var switched bool = false
                if meta.id != None {
                    if meta.id != .workspace {
                        switched = true;
                        .workspace = meta.id
                    }
                }
                .workspace_name = meta.name ?? ""
                .workspace_path = meta.path ?? ""
                if .workspace != "" {
                    localStorage.setItem("musk_workspace", .workspace)
                }
                if switched {
                    // 清场对齐 SwitchSession 先例（gate/报表/卡片跨会话残留）
                    // + 会话主体 + 在途流与轮询窗（Sse.close + poll_window 清
                    // 空=PollStream 永久沉默）+ 发送队列。
                    .session_id = ""
                    .messages = []
                    .active_leaf = ""
                    .session_status = "idle"
                    .session_phase = "intake"
                    .streaming = false
                    .current_draft = ""
                    .thinking = ""
                    .think_open = ""
                    .tool_open = ""
                    .current_gate = None
                    .report_data = None
                    .errands = {}
                    .relays = {}
                    .task_plans = {}
                    .pending_msgs = []
                    .poll_window = []
                    // PLAN-083 T-03：分页游标/骨架/在途门随清场复位（在途
                    // 异步请求的迟到回填由各 handler 的防御臂吸收）。
                    .has_more = false
                    .next_before = ""
                    .older_loading = false
                    .poll_inflight = false
                    .ws_loading = false
                    .stream_es = Sse.close(.stream_es)
                    .error = ""
                    .LoadSessionList()
                }
            }
        }

        .Init -> {
            // PLAN-080 T-02: workspace 单源化——localStorage wid 引导；真值由
            // app.at/login.at 的 ws_resolve_current() → SetWorkspace 回填（web
            // 全链已验：触发器显示完整路径）。VM 侧 back.api workspace_list 在
            // store Init 返回空 + 本地 JSON 数组索引/迭代求值异常（返索引，
            // 实测 "0"）——VM 回填链暂缓（auto-lang 债登记，见 plan 余项），
            // 触发器维持占位文案（与修前一致，无回归）。musk-demo 硬编码兜底
            // 退役（曾持久化失效 id）。workspace 为空时后端查询缺省走 registry
            // 默认工作区，语义不变。
            var ws = localStorage.getItem("musk_workspace");
            if ws != None && ws != "" {
                .workspace = ws
            };
            // PLAN-054 T6: Http.set_default_* 调用摘除——store 级宿主对象
            // 调用在 web store codegen 无降级臂(新 CLI 直出裸 Http.* →
            // vue-tsc TS2304),旧 CLI 则静默丢弃且 generated api client 亦无
            // 默认查询载体,两轨恒为死代码。f6a5422 的 workspace 查询默认
            // 意图需 api client 载体,登记 KNOWN-DEBT。
            let tk = localStorage.getItem("musk_jwt");
            // PLAN-048:VM 扁平化单状态里 AuthStore.token 与本 store 的 token
            // 撞名合并(均落根状态裸名 token)——缺席时不得清写,否则覆写认证
            // 门的 nil 语义(登录墙失效);仅在有存档 JWT 时回填。
            if tk != None {
                .token = tk
            };
            .LoadSessionList()
        }

        // LoadSessionList（PLAN-083 T-03 两段式）：发起段只置骨架门 +
        // Http.get_msg 入队即返回——handler 当场收尾，UI 全程可响应
        // （旧形：chats_list_sessions 同步 await + 首会话
        // chats_get_session 全量 578KB 同帧解析+normalizeToolBlocks 循环
        // =call_fn_by_name 忙等冻结 20.9s 的主链）。列表数据由
        // SessionsLoaded 回填；无选中会话时自动选首个并接 FireDetailLoad。
        .LoadSessionList -> {
            .ws_loading = true
            Http.get_msg("/api/chats/sessions", "ForgeStore.SessionsLoaded")
        }

        // PLAN-083 T-03：列表回填段——payload = {"ok","status","body"}，
        // body = {"sessions":[...]}。空选中时自动选首个 + 发起首屏详情
        // （第二跳异步）；list 空或失败时收骨架门。
        .SessionsLoaded(payload str) -> {
            var ok = false
            var resp = None
            let r = JSON.parse(payload)
            if r != None {
                if r.ok == true {
                    resp = JSON.parse(r.body)
                }
            }
            if resp != None {
                if resp.sessions != None {
                    .session_list = resp.sessions
                    ok = true
                }
            }
            if ok {
                if .session_id == "" {
                    if .session_list.length > 0 {
                        .session_id = .session_list[0].id
                        .FireDetailLoad()
                    } else {
                        .ws_loading = false
                    }
                } else {
                    .ws_loading = false
                }
            } else {
                .ws_loading = false
                .error = "会话列表加载失败"
            }
        }

        // PLAN-083 T-03：首屏/切换详情发起段——分页端点（limit=50 最近
        // N 条 + blocks_normalized 拍平直出）。SwitchSession/BranchTo/
        // SessionsLoaded 共用。
        .FireDetailLoad -> {
            if .session_id == "" {
                .ws_loading = false
                return
            }
            .ws_loading = true
            Http.get_msg("/api/chats/session/" + encodeURIComponent(.session_id) + "/page?limit=50", "ForgeStore.DetailLoaded")
        }

        // PLAN-083 T-03：详情回填段——body = {session:{...},
        // has_more, next_before, blocks_normalized:true}。messages 直接
        // 落 store（后端已拍平为纯字符串块，免本地 normalizeToolBlocks
        // 解释器循环；JSON.parse 产物即纯 VM 值，免 r5 根修一的二次
        // 往返）。失败臂对齐 SwitchSession 053 自愈：清消息 + 错误提示
        // + 列表刷新让过期项消失。
        .DetailLoaded(payload str) -> {
            var resp = None
            let r = JSON.parse(payload)
            if r != None {
                if r.ok == true {
                    resp = JSON.parse(r.body)
                }
            }
            if resp == None || resp.session == None {
                .ws_loading = false
                .messages = []
                .active_leaf = ""
                .has_more = false
                .next_before = ""
                .error = "会话加载失败（可能已删除），列表已刷新，请重新选择 [收到 id=" + .session_id + "]"
                .LoadSessionList()
                return
            }
            .messages = rebuildParsedMessages(resp.session.messages)
            .active_leaf = resp.session.active_leaf ?? ""
            .thinking_level = resp.session.thinking_level ?? "low"
            // PLAN-067 T-05: 会话审批模式随载入回填（缺省 human）。
            .approval_mode = resp.session.approval_mode ?? "human"
            // PLAN-071 需求⑧：会话 mode 回填（乐观气泡职业映射用）。
            .session_mode = resp.session.mode ?? "superpowers"
            .has_more = resp.has_more ?? false
            .next_before = resp.next_before ?? ""
            .error = ""
            .ws_loading = false
            // PLAN-073 P2-T4：载入即重挂在途 run（无在途即收）。
            .AttachStream()
        }

        // PLAN-083 T-03：历史向上翻页发起段（"加载更早的消息"按钮触发；
        // V-3）。before=next_before 游标（本页首条 id）。
        .LoadOlder -> {
            if .has_more == false { return }
            if .older_loading == true { return }
            if .session_id == "" { return }
            if .next_before == "" { return }
            .older_loading = true
            Http.get_msg("/api/chats/session/" + encodeURIComponent(.session_id) + "/page?limit=50&before=" + encodeURIComponent(.next_before), "ForgeStore.OlderLoaded")
        }

        // PLAN-083 T-03：历史回填段——前插合并（older 页 + 现有去重尾），
        // 流式/乐观消息不丢。
        .OlderLoaded(payload str) -> {
            .older_loading = false
            var resp = None
            let r = JSON.parse(payload)
            if r != None {
                if r.ok == true {
                    resp = JSON.parse(r.body)
                }
            }
            if resp == None { return }
            if resp.session == None { return }
            let older = rebuildParsedMessages(resp.session.messages)
            if older == None { return }
            // 前插：older 全量 + 现有中 id 不在 older 的条目（页边界重叠
            // 去重；流式乐观尾部天然保留）。
            var merged list = []
            var oi = 0
            while oi < older.length {
                merged.push(older[oi])
                oi = oi + 1
            }
            var ci = 0
            while ci < .messages.length {
                let m = .messages[ci]
                var dup = false
                var dj = 0
                while dj < older.length {
                    if older[dj].id == m.id { dup = true }
                    dj = dj + 1
                }
                if dup == false { merged.push(m) }
                ci = ci + 1
            }
            .messages = merged
            .has_more = resp.has_more ?? false
            .next_before = resp.next_before ?? ""
        }

        .NewSession -> {
            var resp = chats_create_session(.workspace);
            if resp != None && resp.session != None {
                .session_id = resp.session.id;
                .session_mode = resp.session.mode ?? "superpowers"
                // 新会话为空会话：清空旧消息视图，否则右侧面板仍挂上一会话内容
                // （2026-08-29 用户实测：新建后面板不切换、误判未选中）。
                .messages = []
                .active_leaf = ""
                .thinking_level = "low"
                .error = ""
                let list = chats_list_sessions();
                if list != None && list.sessions != None {
                    .session_list = list.sessions
                }
            } else {
                .error = "创建会话失败"
            }
        }

        // SwitchSession: 切换 + 回写 session 详情（messages）。
        // PLAN-083 T-03：详情改两段式（FireDetailLoad 异步发起，回填走
        // DetailLoaded——含 053 失败自愈臂）；清场面保持同步（内存快）。
        .SwitchSession(id) -> {
            print("[ForgeStore.SwitchSession] ENTER id=" + id)
            .session_id = id;
            // PLAN-051 P3-④: 清会话域状态——current_gate/report_data/卡片表
            // 此前跨会话残留，切到空会话时旧 gate/run 卡仍杵在面板上，
            // 观感为"切换不生效"。
            .current_gate = None
            .report_data = None
            .errands = {}
            .relays = {}
            .task_plans = {}
            .streaming = false
            .current_draft = ""
            .thinking = ""
            // PLAN-083 T-03：分页游标复位（新会话从首屏起）。
            .has_more = false
            .next_before = ""
            .older_loading = false
            .FireDetailLoad()
        }

        // PLAN-043: 切换活跃分支（fork/navigate 同机制），随后重载会话。
        // PLAN-083 T-03：详情重载改两段式（FireDetailLoad；失败自愈归
        // DetailLoaded）。
        .BranchTo(message_id str, mode str) -> {
            let sid = .session_id
            if sid == "" { return }
            var resp = None
            if mode == "fork" {
                resp = chats_fork_session(sid, message_id)
            } else {
                resp = chats_navigate_session(sid, message_id)
            }
            .has_more = false
            .next_before = ""
            .FireDetailLoad()
        }

        .StreamStarted(sid) -> { .session_id = sid }

        .Send(content) -> {
            .current_draft = "";
            .thinking = "";
            .error = "";
            // 发送消息到后端。不覆盖 messages（避免和 SSE 回写竞态）——
            // user 消息由 startForgeStream 在建连前乐观 push（见 forge_stream.ts），
            // assistant 消息由 SSE delta 事件回写。
            // PLAN-055 ⑧(D1)：run=true 显式触发后端 agent 运行——VM 轨 Sse.open
            // 为 no-op，订阅触发路径不可达；gen/web 轨双保险无害（订阅侧守卫防双跑）。
            var resp = chats_send_message(.session_id, content, "", true, false);
            .streaming = true
        }

        .StopStream -> {
            .streaming = false
        }

        // PLAN-071 需求⑤ T-25：取消在途运行——后端置位取消旗标（agent 于
        // 迭代边界收束并落盘已有内容），本地立即退出流式态。
        .CancelRun -> {
            if .session_id != "" {
                chats_cancel_session(.session_id)
            }
            .streaming = false
        }

        // PLAN-055 ④/T11：ThinkBlock 独立展开——键列表重建回写（VM 安全：
        // 既有字段整列表赋值，无新键写入）。

        .SetThinking(text) -> { .thinking = text }
        .FinalizeDraft -> { .streaming = false }
        .SetError(msg) -> { .error = msg; .streaming = false; .FlushQueue() }

        // PLAN-071 需求⑮：入队（运行在途时由 SendInput 调用）。
        .QueueMessage(text) -> {
            .pending_msgs.push(text)
        }

        // PLAN-071 需求⑮：流式收束后排空队列——取最旧一条直接 POST
        // （queued=true：守卫占用只回 busy:true 不落提示）。busy = 收束
        // 竞态窗口（done 已见、守卫未清）——整条退回队首，由 PollStream
        // 下一拍重试；成功则置流式态 + 挂 SSE（余下条目等下一次收束）。
        // streaming 为真时是 no-op（防双发）。
        .FlushQueue -> {
            if .streaming == false {
                if .pending_msgs.length > 0 {
                    let first = .pending_msgs[0]
                    var rest []Value = []
                    var idx = 0
                    for m in .pending_msgs {
                        if idx > 0 {
                            rest.push(m)
                        }
                        idx = idx + 1
                    }
                    var resp = chats_send_message(.session_id, first, "", true, true);
                    if resp != None {
                        if resp.busy == true {
                            var restored []Value = []
                            restored.push(first)
                            for m in rest {
                                restored.push(m)
                            }
                            .pending_msgs = restored
                            return
                        }
                    }
                    .pending_msgs = rest
                    .streaming = true
                    .StartStream(.session_id, .workspace, .token, first)
                }
            }
        }
        // PLAN-064: 档位切换——先写 UI 态再 PATCH 持久化（失败不回滚，下次
        // 切会话会以服务端为准回填）。
        .SetThinkingLevel(level) -> {
            .thinking_level = level
            if .session_id != "" {
                chats_set_thinking(.session_id, level)
            }
        }

        // PLAN-067 T-05: 审批模式切换——先写 UI 态再 PATCH 持久化（口径同
        // SetThinkingLevel;后端 relay driver 遇 gate 时读会话模式,auto 即刻
        // 放行并留 GateResolved 审计事件）。
        .SetApprovalMode(mode) -> {
            .approval_mode = mode
            if .session_id != "" {
                chats_set_approval(.session_id, mode)
            }
        }

        // ClearGate: 用户批准/拒绝 spec 变更后清审批门状态（7.3）。
        .ClearGate -> { .current_gate = None }

        // B 类批4：ApproveGate/RejectGate 调真实 API + 清审批门。
        .ApproveGate -> {
            chats_approve(.session_id, 0);
            .current_gate = None
        }
        .RejectGate -> {
            chats_reject_all(.session_id);
            .current_gate = None
        }

        // ─── Plan 028 T14：SSE 流消费（原 forge_stream.ts；F8 Sse.open/close + 消息分发）───
        .StartStream(sid0, ws0, tk0, userContent) -> {
            // PLAN-536 T12(D4 修复,musk 侧②)：头部不再走 .StopStream()——
            // 它把 .streaming 打回 false,而 VM 轨尾部 Sse.open 的
            // handler-as-value 实参抛点(KD-047/055-4②)会终止 handler,
            // 门控若在抛点前落 false 则 PollStream 兜底链死亡(KD 059-FU1
            // 题1 残余通路)。此处仅需关闭上一条 SSE 句柄,直连
            // Sse.close 等价且不动门控;web 轨行为不变(close 后仍会重开)。
            .stream_es = Sse.close(.stream_es)
            // PLAN-083 T-05 复验根修：完成启发式基线改 **乐观 push 之前**的
            // 长度——旧位（push 后=乐观 user+assistant 2 条）与服务端终态
            // 计数恒等，`msgs.length > pre_stream_len` 永假，streaming 永不
            // 收束（实测卡死；旧链同构，靠 120s deadman 窗静默+Stop 钮
            // 残留暴露）。基线=发送前存量，服务端到货 2 条必 > 0。
            .pre_stream_len = .messages.length
            // 乐观插入 user 消息（不等 API 返回；与 Send 并发执行）
            if userContent.trim() != "" {
                let msgs = .messages
                var dup = false
                if msgs.length > 0 {
                    if msgs[msgs.length - 1].role == "user" {
                        if msgs[msgs.length - 1].content == userContent { dup = true }
                    }
                }
                if dup == false {
                    let uid = "u-" + Date.now()
                    // PLAN-055 ⑦：乐观消息改写后端契约字段 created_at（秒）
                    // ——此前写 timestamp（毫秒）导致重载/格式化读不到值。
                    // PLAN-067 T-02：乐观 user 消息挂 parent_id（=当前叶）并
                    // 推进 active_leaf——渲染按 chatActivePath 叶链投影,
                    // 不入链的消息（无 parent_id）在活跃会话里永远不可见,
                    // 只能靠刷新重载才出现（T-01 实测定责）。
                    .messages.push({ id: uid, role: "user", content: userContent, created_at: nowSec(), thinking: "", tool_calls: [], profession_id: "", parent_id: .active_leaf })
                    .active_leaf = uid
                }
                // PLAN-536 T12(D4 修复,musk 侧⑤)：deadman 窗戳走**列表 push**
                // ——跨模块调用帧的 SET_FIELD 重绑定不达根态（见 PollStream
                // 注④）,而共享 vmref 的列表突变实证可靠（同帧 messages.push
                // 落地实录）,故轮询窗戳以列表承载。
                .poll_window.push(Date.now())
                // PLAN-071 需求⑧ T-34：乐观 assistant 气泡——发送即创建
                // （标题栏立即可见；profession=会话 mode 映射 role）。后续
                // thinking/delta 事件经 currentAssistantMsgIn 命中本消息
                // 追加；done 后回填换入持久化版本（含思考块）。
                var amsg = newAssistantMsg(modeRoleOf(.session_mode))
                amsg.parent_id = .active_leaf
                .active_leaf = amsg.id
                .messages.push(amsg)
            }
            let path0 = "/api/chats/session/" + encodeURIComponent(sid0) + "/stream"
            var qs = ""
            if ws0 != "" { qs = "?workspace=" + encodeURIComponent(ws0) }
            if tk0 != "" {
                if qs == "" {
                    qs = "?token=" + encodeURIComponent(tk0)
                } else {
                    qs = qs + "&token=" + encodeURIComponent(tk0)
                }
            }
            // 防御：record 初值兜底（历史 codegen 曾把 {} 生成 null）
            if .errands == None { .errands = {} }
            if .relays == None { .relays = {} }
            if .task_plans == None { .task_plans = {} }
            // PLAN-536 T12(D4 修复,musk 侧):streaming 置位必须在 Sse.open
            // **之前**——VM 轨 Sse.open 的 handler-as-value 实参
            // (.OnStreamEvent)求值抛 Field not found(KD-047/055-4②,根修归
            // 上游 SSE 专项),抛点若在置位前,轮询兜底链(PollStream 的
            // .streaming 门控)随抛点死亡,"AI 回复了但界面不动"复发(KD
            // 059-FU1 题1 残余通路,auto-lang plan536_t12 探针锁定该契约)。
            // web 轨 Sse.open 正常返回,置位次序无行为差异。
            .streaming = true
            print("[SSE] open: " + path0 + qs)
            .stream_es = Sse.open(path0 + qs, .OnStreamEvent)
        }

        .StopStream -> {
            .stream_es = Sse.close(.stream_es)
            // PLAN-062：显式停止即关 deadman 窗——pop 清空窗戳（完成/
            // 异常/手动停止后窗口立即关闭；列表突变经共享 vmref 可靠，
            // 与 StartStream 的 push 同机制）。
            while .poll_window.length > 0 {
                let _pw0 = .poll_window.pop()
            }
 }

        // PLAN-073 P2-T4：会话打开（切换/刷新载入）即重挂在途 run——后端
        // chat_run_stream 入口窥探守卫：无在途立即回 idle 帧收流；有在途则
        // 后续事件照常经 OnStreamEvent 上屏（刷新前的前缀由 P2-T3 turn 增量
        // 快照落盘补足）。不注入乐观消息（userContent 为空），与 StartStream
        // 的发送路径分离；deadman 窗照 push——done 后轮询换入终版（快照
        // pending 防提前清窗，见 PollStream）。**不预置 streaming**：运行态
        // 由首个真实流事件置位（OnStreamEvent 入口）——旧后端（无 idle 帧/
        // 无在途）attach 后零事件即零运行态，不留幽灵"运行中"；VM 轨
        // Sse.open no-op 同理无需复位。
        .AttachStream -> {
            if .session_id == "" { return }
            .stream_es = Sse.close(.stream_es)
            let path0 = "/api/chats/session/" + encodeURIComponent(.session_id) + "/stream"
            var qs = ""
            if .workspace != "" { qs = "?workspace=" + encodeURIComponent(.workspace) }
            if .token != "" {
                if qs == "" {
                    qs = "?token=" + encodeURIComponent(.token)
                } else {
                    qs = qs + "&token=" + encodeURIComponent(.token)
                }
            }
            .pre_stream_len = .messages.length
            .poll_window.push(Date.now())
            print("[SSE] attach: " + path0 + qs)
            .stream_es = Sse.open(path0, .OnStreamEvent)
        }

        // Plan 051 T10（G1 阶段1）：轮询拍——全量回填 + 完成启发式。
        .PollStream -> {
            // PLAN-071 需求⑮：每拍驱动队列重试（busy 竞态退回后由此重发；
            // streaming 为真或队列空时是 no-op）。
            .FlushQueue()
            // PLAN-536 T12(D4 修复,musk 侧④)：门控改 **deadman 时间窗**。
            // 原因链（536 T12 实机时序实证）:跨模块调用帧（SendInput 体内
            // `store.Send/store.StartStream`）对 store 字段的 SET_FIELD
            // 重绑定不达根态（同帧 .messages.push 经共享 vmref 可见、同帧
            // .streaming/.pre_stream_len 重绑定不可见,autoui_state 对拍
            // 实证;新立案 auto-lang KD——state-scope 专项）,.streaming 置位
            // 不可靠 → when 门/handler 自守卫恒假 → 轮询永不启动。改以
            // 发送时间戳 deadman 窗（2 分钟,窗戳经列表 push 承载,见
            // StartStream 注⑤）门控:窗口内恒轮询（timer 派发走根态,回填
            // 写入可靠）,窗口外静默;web 轨语义不受影响。
            let wins = .poll_window
            if wins.length == 0 { return }
            let started = wins[wins.length - 1]
            // PLAN-071 需求⑥：deadman 窗随流式自动续期——原 120s 硬过期使
            // 长任务（如 467s 深度思考）在窗口过期后 PollStream 永久沉默，
            // SSE 侧任何迟滞都只能靠手动刷新看到结果。流式进行中每 tick
            // 续窗；收束后窗口自然过期，恢复原语义。
            if .streaming == true {
                .poll_window.push(Date.now())
            }
            let dbg str = "wins=" + wins.length + " streaming=" + .streaming + " es=" + (.stream_es != None) + " last_sse=" + .last_sse_at
            if dbg != .dbg_last {
                .dbg_last = dbg
                print("[POLL] " + dbg)
            }
            if Date.now() - started > 120000 {
                print("[POLL] window expired (>120s) — backfill off")
                return
            }
            // PLAN-069 F-04：流式期（web 轨 SSE 已附加）**绝不全量回填**——
            // 回填快照不含在途 assistant，LLM 长思考/迭代间隙超过 3 秒健康
            // 门就放开，回填反复清掉已上屏的直播内容（用户实测：每轮边界
            // "删掉重显"）。直播期 SSE 是唯一实时源；done 臂落 .streaming=
            // false 后回填恢复兜底语义。VM 轨 Sse.open no-op（stream_es 为
            // None）不受影响，轮询仍是其直播机制。
            // PLAN-083 T-05 复验补修：SSE 真活判据改 last_sse_at——auto-lang
            // master 起 Sse.open 不再抛（KD-047 根修后返回句柄），stream_es
            // 恒非 None，旧形 `streaming && es != None` 把 stub 句柄当真流
            // 令轮询永久沉默（发送链实测卡收束）。真流事件必置 last_sse_at
            //（OnStreamEvent 入口），健康门独立兜底；stub 句柄无事件=不拦。
            if .streaming == true && .stream_es != None && .last_sse_at != 0 { return }
            // PLAN-067 T-02：SSE 健康门——3 秒内有流事件就不回填。运行中
            // 服务端快照不含未完成 assistant（完成后才持久化）,回填会反复
            // 清掉 SSE 已上屏的流式内容;且回填不推进 active_leaf,叶链投影
            // 会把新回合整体排除在渲染外（T-01 实测:轮询取到新数据但
            // hasSent 恒 false）。SSE 断流（>3s 无事件）时本门自动放开,
            // 轮询恢复兜底语义。
            if .last_sse_at != 0 && Date.now() - .last_sse_at < 3000 { return }
            let sid = .session_id
            if sid == "" { return }
            // PLAN-083 T-03：回填请求异步化——Http.get_msg 入队即返（旧形
            // 同步 chats_get_session 在 call_fn_by_name 忙等，流式期每
            // 500ms 一拍全量 578KB 同步解析=切换冻结同源的 UI 卡顿）。
            // poll_inflight 防重入：上一拍未回收不再发新拍（单飞轮询）。
            if .poll_inflight { return }
            .poll_inflight = true
            Http.get_msg("/api/chats/session/" + encodeURIComponent(sid) + "/page?limit=50", "ForgeStore.PollBackfill")
        }

        // PLAN-083 T-03：轮询回填段（旧 PollStream 的取数后半）——分页+
        // 归一化载荷，按已加载窗口合并（073 链适配：has_more 历史前缀不
        // 因轮询整表替换丢失），完成启发式与 071⑮ 排空语义原样保留。
        .PollBackfill(payload str) -> {
            .poll_inflight = false
            let sid = .session_id
            if sid == "" { return }
            var resp = None
            let r = JSON.parse(payload)
            if r != None {
                if r.ok == true {
                    resp = JSON.parse(r.body)
                }
            }
            if resp == None { return }
            if resp.session == None { return }
            // PLAN-071 需求⑧ T-36：流式期回填防清除——服务端快照在收束前
            // 不含 assistant，整表替换会把乐观消息连思考一起清掉（用户截图3
            // 实证：内容全清冻结至刷新）。仅当快照末消息已是 assistant
            // （收束落盘）才换入；换入后完成启发式自然清窗收束。
            if .streaming == true {
                let srv_msgs = resp.session.messages ?? []
                let last_srv = srv_msgs[srv_msgs.length - 1] ?? None
                if last_srv == None || last_srv.role != "assistant" { return }
            }
            // 按已加载窗口合并：快照首条在现表有锚点→保锚点前缀（用户已
            // 翻页加载的历史）换尾部；无锚点（fork/叶切换/空表）→整表
            // 换入。归一化免本地（blocks_normalized 直出）。
            .messages = mergeTailWindow(.messages, rebuildParsedMessages(resp.session.messages))
            // PLAN-067 T-02：回填时同步服务端活跃叶——否则叶链投影沿旧叶
            // 回溯,新回合不在链上,依旧"数据到了但不渲染"。
            if resp.session.active_leaf != None { .active_leaf = resp.session.active_leaf }
            // PLAN-536 T12(D4 修复,musk 侧③)：完成启发式补**回合增长守卫**
            // ——原形只看"末回合=非空 assistant",竞态:发送后首个轮询拍若
            // 后端读模型尚无新 user turn（或上一对话尾部本就是 assistant）,
            // 启发式误判"已完成"→streaming 提前落 false→真正的回复永远
            // 不再被轮询（536 T12 实机时序实证:tick1 误杀,回复无人取）。
            // 守卫口径:轮询到的回合数须 ≥ 发送前基线(pre_stream_len=乐观
            // push 后的长度),回复到货时回合数必然 > 基线。
            let msgs = .messages
            if msgs.length > 0 {
                let last = msgs[msgs.length - 1]
                if last.role == "assistant" {
                    if (last.content ?? "") != "" {
                        if msgs.length > .pre_stream_len {
                            // PLAN-073 P2-T3：末条若是 run 增量快照（pending
                            // ==true）则终版未落——不清窗不收束，等收束终版
                            // 同 id 换入（pending 随之清除）后自然收束。
                            if last.pending == true { return }
                            .streaming = false
                            // PLAN-062：完成即关 deadman 窗（pop 清窗戳，
                            // 防长会话堆积；机制注同 .StopStream）。
                            while .poll_window.length > 0 {
                                let _pw1 = .poll_window.pop()
                            }
                            // PLAN-071 需求⑮：收束即排空排队消息。
                            .FlushQueue()
                        }
                    }
                }
            }
        }

        // forge 流事件 → blocks/卡片状态回写（对应 forge_stream.ts handleForgeEvent；
        // 平台层已 JSON 预解析——直接按 ev.type 分支，零样板）
        .OnStreamEvent(ev) -> {
            if ev == None { return }
            if ev.type == None { return }
            // PLAN-067 T-02：SSE 心跳——PollStream 健康门的依据（流活着
            // 就不做全量回填,防运行中快照清掉流式内容）。
            .last_sse_at = Date.now()
            // PLAN-073 P2-T4：真实流事件 = 运行在途——attach 路径不预置
            // streaming（旧后端兼容）,由首事件置位；done/idle/error 各臂
            // 自行复位。
            if ev.type == "delta" || ev.type == "thinking" || ev.type == "tool_call" || ev.type == "tool_result" || ev.type == "turn_start" || ev.type == "turn_end" || ev.type == "tool_gate_waiting" {
                if .streaming == false { .streaming = true }
            }
            print("[SSE] ev=" + ev.type + " msgs=" + .messages.length + " draft=" + .current_draft.length + " think=" + .thinking.length)

            if ev.type == "delta" {
                if ev.text != None {
                    if ev.text != "" {
                        var msg = currentAssistantMsgIn(.messages)
                        if msg == None {
                            msg = newAssistantMsg("")
                            // PLAN-067 T-02：新 assistant 挂 parent_id（=当前
                            // 叶）并推进叶——不入叶链的消息不被渲染投影。
                            msg.parent_id = .active_leaf
                            .active_leaf = msg.id
                            .messages.push(msg)
                        }
                        msg.content = msg.content + ev.text
                        .current_draft = .current_draft + ev.text
                        // PLAN-073 r5：正文开始 = 思考结束——先落地思考块。
                        landThinkingBlocks(msg)
                        let _ab = appendBlockText(msg, "text", ev.text)
                        print("[SSE] delta: chunk=" + ev.text.length + " draft=" + .current_draft.length + " blocks=" + msg.blocks.length)
                    }
                }
                return
            }
            if ev.type == "thinking" {
                if ev.thinking != None {
                    if ev.thinking != "" {
                        var msg2 = currentAssistantMsgIn(.messages)
                        if msg2 == None {
                            msg2 = newAssistantMsg("")
                            msg2.parent_id = .active_leaf
                            .active_leaf = msg2.id
                            .messages.push(msg2)
                        }
                        let th = msg2.thinking ?? ""
                        msg2.thinking = th + ev.thinking
                        .thinking = msg2.thinking
                        let _ab = appendBlockText(msg2, "thinking", ev.thinking)
                        print("[SSE] thinking: chunk=" + ev.thinking.length + " acc=" + msg2.thinking.length + " blocks=" + msg2.blocks.length)
                    }
                }
                return
            }
            if ev.type == "tool_call" {
                var msg3 = currentAssistantMsgIn(.messages)
                if msg3 == None {
                    msg3 = newAssistantMsg("")
                    msg3.parent_id = .active_leaf
                    .active_leaf = msg3.id
                    .messages.push(msg3)
                }
                // PLAN-073 r5：思考结束转入行动——落地思考块。
                landThinkingBlocks(msg3)
                var callId = ev.id ?? ""
                if callId == "" { callId = "tc-" + Date.now() }
                let callName = ev.name ?? "unknown"
                let callArgs = ev.arguments ?? {}
                // PLAN-073 F-C：result/tkey 必须就地初始化——result 缺省时
                // `block.tc.result != ""` 对 undefined 恒真，展开卡即以
                // source=undefined 喂 Markdown（StreamingRenderer Gye/flatMap
                // 崩溃循环）；tkey 缺省时 tool_open == block.tkey 双 undefined
                // 恒真，所有卡默认展开。
                msg3.tool_calls.push({ id: callId, name: callName, arguments: callArgs, result: "", status: "running" })
                let lastIdx = msg3.tool_calls.length - 1
                msg3.blocks.push({ kind: "tool", tc: msg3.tool_calls[lastIdx], tkey: callId })
                return
            }
            if ev.type == "tool_gate_waiting" {
                // PLAN-069 W3：human 会话越界命令首触暂停——最后一个 running
                // 工具块置 gate_waiting，携带 gate_id/命令/越界路径供卡片渲染。
                let msgg = currentAssistantMsgIn(.messages)
                if msgg != None {
                    var i = msgg.tool_calls.length - 1
                    while i >= 0 {
                        if msgg.tool_calls[i].status == "running" {
                            msgg.tool_calls[i].status = "gate_waiting"
                            msgg.tool_calls[i].gate_id = ev.gate_id ?? ""
                            msgg.tool_calls[i].pending_cmd = ev.cmd ?? ""
                            msgg.tool_calls[i].escape_paths = ev.paths ?? []
                            break
                        }
                        i = i - 1
                    }
                }
                return
            }
            if ev.type == "tool_result" {
                let msg4 = currentAssistantMsgIn(.messages)
                if msg4 != None {
                    let calls = msg4.tool_calls
                    var call = None
                    if ev.id != None {
                        var i = 0
                        while i < calls.length {
                            if calls[i].id == ev.id { call = calls[i] }
                            i = i + 1
                        }
                    }
                    if call == None {
                        var j = calls.length - 1
                        while j >= 0 {
                            let c = calls[j]
                            if c.status == "running" {
                                if ev.name == None { call = c } else { if c.name == ev.name { call = c } }
                            }
                            j = j - 1
                        }
                    }
                    if call != None {
                        let result = ev.result ?? ""
                        call.result = result
                        // PLAN-042:结构化载荷(edit diff/截断/全量输出路径)随调用留存。
                        call.details = ev.details ?? None
                        // 027 债闭环（PLAN-065 T2）：status 真字段，服务端单点判定
                        // （server.rs tool_result_status），前端不再嗅探 result 前缀。
                        var failed = false
                        if ev.status == "error" { failed = true }
                        if failed { call.status = "failed" } else { call.status = "completed" }
                    }
                }
                return
            }
            if ev.type == "done" {
                print("[SSE] done: msgs=" + .messages.length)
                // PLAN-071 需求⑧ T-36：done 不清 deadman 窗——保留窗让最后
                // 一拍回填换入持久化消息（含思考块）后由完成启发式自然清窗
                // 收束（原立即清窗+停轮询导致"刷新才见结果"，用户截图3/4
                // 实证）。仅停流（Sse.close 释放连接）。
                .streaming = false
                .stream_es = Sse.close(.stream_es)
                // PLAN-071 需求⑮：收束即排空排队消息。
                .FlushQueue()
                return
            }
            if ev.type == "idle" {
                // PLAN-073 P2-T4：附加窥探回执——服务端无在途 run（chat_run_
                // stream 入口 chat_run_active 探测），立即收流不算运行中。
                // 已载入的消息（含 run 增量快照）就是全部现场。
                print("[SSE] idle: no run in flight")
                .streaming = false
                .stream_es = Sse.close(.stream_es)
                return
            }
            if ev.type == "error" {
                .error = ev.message ?? "unknown error"
                .streaming = false
                // PLAN-062：error 即关 deadman 窗（机制注同 done 臂）。
                while .poll_window.length > 0 {
                    let _pw3 = .poll_window.pop()
                }
                .StopStream()
                // PLAN-071 需求⑮：收束即排空排队消息。
                .FlushQueue()
                return
            }

            // ─── errand 事件 ───
            if ev.type == "errand_start" {
                if ev.errand_id != None {
                    .errands[ev.errand_id] = { errand_id: ev.errand_id, profession_id: ev.profession_id ?? "gofer", tool_call_id: ev.tool_call_id ?? "", task: ev.task ?? "", content: "", tool_calls: [], status: "running" }
                }
                return
            }
            if ev.type == "errand_delta" {
                if ev.errand_id != None {
                    if ev.text != None {
                        let e0 = .errands[ev.errand_id]
                        if e0 != None { e0.content = e0.content + ev.text }
                    }
                }
                return
            }
            if ev.type == "errand_tool_call" {
                if ev.errand_id != None {
                    let e1 = .errands[ev.errand_id]
                    if e1 != None {
                        var tcid = ev.id ?? ""
                        if tcid == "" { tcid = "etc-" + Date.now() }
                        e1.tool_calls.push({ id: tcid, name: ev.name ?? "unknown", arguments: ev.arguments ?? {}, status: "running" })
                    }
                }
                return
            }
            if ev.type == "errand_tool_result" {
                if ev.errand_id != None {
                    let e2 = .errands[ev.errand_id]
                    if e2 != None {
                        let tcs = e2.tool_calls
                        var k = 0
                        while k < tcs.length {
                            if tcs[k].id == ev.id {
                                tcs[k].result = ev.result ?? ""
                                tcs[k].status = "success"
                            }
                            k = k + 1
                        }
                    }
                }
                return
            }
            if ev.type == "errand_complete" {
                if ev.errand_id != None {
                    let e3 = .errands[ev.errand_id]
                    if e3 != None {
                        e3.status = ev.status ?? "completed"
                        var r0 = ev.result ?? ""
                        if r0 == "" { r0 = e3.content }
                        e3.result = r0
                        e3.token_usage = ev.token_usage
                    }
                }
                return
            }

            // ─── relay 事件 ───
            if ev.type == "relay_spawned" {
                if ev.run_id != None {
                    .relays[ev.run_id] = { run_id: ev.run_id, flow_id: ev.flow_id ?? "standard", status: "started", steps: [], title: ev.title }
                }
                return
            }
            if ev.type == "relay_update" {
                if ev.run_id != None {
                    let r1 = .relays[ev.run_id]
                    if r1 != None {
                        r1.steps.push({ step_id: ev.step_id ?? "", profession_id: ev.profession_id ?? "" })
                        r1.status = "running"
                    }
                }
                return
            }
            if ev.type == "relay_gate_waiting" {
                if ev.run_id != None {
                    let r2 = .relays[ev.run_id]
                    if r2 != None { r2.status = "gate_waiting" }
                }
                return
            }
            if ev.type == "relay_complete" {
                if ev.run_id != None {
                    let r3 = .relays[ev.run_id]
                    if r3 != None {
                        if ev.status == "failed" { r3.status = "failed" } else { r3.status = "completed" }
                        r3.summary = ev.summary ?? ""
                        r3.tokens_used = ev.tokens_used ?? 0
                    }
                }
                return
            }

            // ─── task_plan 事件 ───
            if ev.type == "task_plan_spawned" {
                if ev.instance_id != None {
                    .task_plans[ev.instance_id] = { instance_id: ev.instance_id, task_plan_id: ev.task_plan_id ?? "", status: "started", phases: [] }
                }
                return
            }

            // ─── 会话状态事件 ───
            if ev.type == "turn_start" {
                let p0 = ev.profession_id ?? ""
                var _ea = currentAssistantMsgIn(.messages)
                if _ea == None { _ea = newAssistantMsg(p0) ; .messages.push(_ea) } else { if _ea.profession_id == None { _ea.profession_id = p0 } }
                // PLAN-073 r5：新轮次开始——上一轮思考块落地。
                landThinkingBlocks(_ea)
                return
            }
            if ev.type == "turn_end" {
                // PLAN-073 r5：轮次边界——思考块落地（原先落到无名分支只打日志）。
                let _eb = currentAssistantMsgIn(.messages)
                landThinkingBlocks(_eb)
                return
            }
            if ev.type == "phase_change" {
                if ev.phase != None { .session_phase = ev.phase }
                return
            }
            if ev.type == "agent_handoff" {
                if ev.to_profession != None { .active_profession = ev.to_profession }
                return
            }

            // ─── gate / run_completed 事件（SecretaryMessage 由 chats_view watch current_gate 驱动）───
            if ev.type == "gate_reached" {
                var gateId = ev.gate_id ?? ""
                if gateId == "" { gateId = (ev.run_id ?? "") + "-" + (ev.step_id ?? "") }
                if gateId != "" {
                    .current_gate = { gate_id: gateId, run_id: ev.run_id ?? "", profession: ev.profession ?? "", title: ev.title ?? "", section_id: ev.section_id ?? "", since: Date.now() }
                }
                return
            }
            if ev.type == "run_completed" {
                .report_data = { runId: ev.run_id ?? "", goalsMet: ev.goals_met ?? "", testsPass: ev.tests_pass ?? "", driftDetected: ev.drift_detected ?? "", cost: ev.cost ?? "", confidence: ev.confidence ?? "Medium", deliverables: ev.deliverables ?? [] }
                return
            }
            print("[forge stream] " + (ev.type ?? ""))
        }
    }
}

// ─── Plan 028 T14：流消费模块 fn（原 forge_stream.ts 的累积/查找逻辑）───

/** 追加流式 text/thinking 到消息有序 blocks：同类连续块合并，异类开新块。 */
/** 当前秒级时间戳（PLAN-055 ⑦：乐观/新 assistant 消息对齐后端契约字段
 * created_at=秒）。Math.trunc 显式截断——TS 侧 Date.now() 为宿主调用，`/`
 * 不自动注入 trunc（浮点除）；VM 侧 int 除原生截断、trunc(int) 恒等。
 * store 文件不消费 use.web.fn 导入（codegen 只发调用不发 import），沿
 * relay_store.relayFormatTimestamp 先例内联定义。 */
fn nowSec() int {
    return Math.trunc(Date.now() / 1000)
}


/** ThinkBlock 展开列表取反（PLAN-055 T11；内联同 nowSec 缘由——
 * forge_helpers 版 thinkToggleList 供渲染侧读，此处 store 侧写路径用同构
 * fn，避免 store 文件引入 use.web.fn 导入缺口）。 */
// PLAN-073 r5：思考块生命周期——state: "streaming" | "done"。
// 追加规则：末块同 kind 且（非 thinking 或 未落地）→ 追加文本；
// 已落地的 thinking 块不再追加（新轮次思考开新 streaming 块）。
fn appendBlockText(msg Value, kind str, text str) {
    if msg.blocks == None { msg.blocks = [] }
    let blocks = msg.blocks
    var last = blocks[blocks.length - 1]
    if last != None {
        if last.kind == kind {
            if kind == "thinking" && last.state == "done" {
                // 落地态不再追加——新轮次思考开新块
            } else {
                if last.text != None {
                    last.text = last.text + text
                    return
                }
            }
        }
    }
    if kind == "thinking" {
        blocks.push({ kind: kind, text: text, state: "streaming" })
    } else {
        blocks.push({ kind: kind, text: text })
    }
}

// PLAN-073 r5：把当前消息里所有 streaming 态思考块落为 done——在
// delta（同轮正文开始）/ tool_call（思考结束转入行动）/ turn_start /
// turn_end（轮次边界）时调用。模板按 state 选形态：streaming = 尾部
// 滚动条 + "思考中"；done = 折叠头 + "已思考"（可展开）。
fn landThinkingBlocks(msg Value) {
    if msg == None { return }
    if msg.blocks == None { return }
    var bi = 0
    while bi < msg.blocks.length {
        let b = msg.blocks[bi]
        if b.kind == "thinking" {
            let st = b.state ?? None
            if st == None || st == "streaming" { b.state = "done" }
        }
        bi = bi + 1
    }
}

/** 当前（末条）assistant 消息；末条非 assistant 返回 None。 */
// PLAN-045 VM-clean:普通 fn 直读 .messages 在 VM 合成为未定义符号——
// 拆纯读 fn(state 由 handler 传入) + handler 侧承接 push/backfill 副作用。
fn currentAssistantMsgIn(msgs Value) Value {
    if msgs.length == 0 { return None }
    let last = msgs[msgs.length - 1]
    if last.role == "assistant" { return last }
    return None
}

// PLAN-073 F-A：后端持久化 ChatBlock 的工具载荷挂在 `tool` 键（Rust 字段名），
// 而渲染模板（chat_message.at）统一读 `tc`——会话载入/回填后历史视图的
// 工具卡 name/arguments/result 全空。
// VM 语义（PLAN-044 engine.rs）：__json_object GET 缺键返 null（安全），
// SET 缺键硬崩。持久化块是稀疏键集（{kind,text}/{kind,tool}，无 tc/state），
// 故本函数**构造新块替换**而非原地补写——msg.blocks 键存在（非 null 分支）
// 对它 SET 合法；块对象一律重建为全字段形态。
/** r5b：工具卡 header 单行摘要串（forge_helpers.getToolSummaryText 的
 * store 内联副本，改名防 VM 扁平命名空间撞名——store 文件不消费跨文件
 * fn 导入，沿 nowSec 内联先例）。分支/截断口径与 helpers 版一致。 */
fn summaryTextOf(tc obj) str {
    let args = tc.arguments ?? {}

    let path = args.path ?? ""
    let slug = args.slug ?? ""
    let sectionId = args.section_id ?? ""
    let pattern = args.pattern ?? ""
    let query = args.query ?? ""
    let task = args.task ?? ""
    var command = args.command ?? ""
    if command == "" { command = args.cmd ?? "" }
    let limit = args.limit
    let offset = args.offset

    var out = ""
    if path != "" {
        out = path
        if limit != None || offset != None {
            out = out + ":" + (limit ?? "") + ":" + (offset ?? "")
        }
    }
    if slug != "" { out = segJoin(out, slug) }
    if sectionId != "" { out = segJoin(out, sectionId) }
    if pattern != "" {
        var s = pattern
        if pattern.length > 60 { s = pattern.substring(0, 57) + "…" }
        out = segJoin(out, "\"" + s + "\"")
    }
    if query != "" {
        var s2 = query
        if query.length > 60 { s2 = query.substring(0, 57) + "…" }
        out = segJoin(out, "\"" + s2 + "\"")
    }
    let skillName = args.skill_name ?? ""
    if skillName != "" { out = segJoin(out, skillName) }
    if task != "" && out == "" {
        var s3 = task
        if task.length > 60 { s3 = task.substring(0, 57) + "…" }
        out = s3
    }
    if command != "" && out == "" {
        var s4 = command
        if command.length > 80 { s4 = command.substring(0, 77) + "…" }
        out = s4
    }
    return out
}

/** 摘要段空格拼接（空段透传）。 */
fn segJoin(a str, b str) str {
    if a == "" { return b }
    return a + " " + b
}

fn normalizeToolBlocks(msgs Value) Value {
    // PLAN-083 T-03 注：本 fn 随数据链迁分页端点（blocks_normalized 直出）
    // 退出热路径，保留为全量端点（/session/{id} 缺省形态）消费与
    // 073 r5 契约参照——勿在新路径调用（VM 解释器逐块循环=冻结放大器）。
    if msgs == None { return msgs }
    // r5 根修一：API 值树入 store 前整树 JSON 往返重建为纯 VM 值（往返
    // 产物异常时回退原值）。r5 根修二（r5b 拍平）：tool 块重建为纯字符串
    // 字段（见下方 tool 臂注）。
    var cur = msgs
    let snap = JSON.stringify(msgs)
    if snap != "" {
        let reparsed = JSON.parse(snap)
        if reparsed != None { cur = reparsed }
    }
    var mi = 0
    while mi < cur.length {
        let m = cur[mi]
        let mblocks = m.blocks ?? None
        if mblocks != None {
            var nb list = []
            var bi = 0
            while bi < mblocks.length {
                let b = mblocks[bi]
                let kind = b.kind ?? "text"
                if kind == "tool" {
                    let tcv = b.tc ?? None
                    if tcv == None {
                        let tv = b.tool ?? None
                        if tv != None {
                            // r5b 拍平：handler 上下文把 tool 载荷重建为**纯字符串
                            // 字段**（name/id/status/result/gate_* + args_json +
                            // summary 现算成串）——字符串读在全部上下文可靠
                            // （think 文本/kind/status 实证），对象型字段读在渲染/
                            // 计算上下文产出 "0"（实机两实例对照实证：同代码
                            // 同会话，vtree 真值 vs 像素全 "0"）。messageBlocks
                            // 侧只读这些字符串字段，不再触碰 b.tool 嵌套对象。
                            // summary 摘要串内联计算（store 文件不消费跨文件
                            // fn 导入，沿 nowSec 内联先例；改名防 VM 扁平
                            // 命名空间与 forge_helpers.getToolSummaryText 撞名）。
                            nb.push({
                                kind: "tool",
                                tool_name: tv.name ?? "",
                                tool_id: tv.id ?? "",
                                tool_status: tv.status ?? "",
                                tool_result: tv.result ?? "",
                                tool_gate_id: tv.gate_id ?? "",
                                tool_pending_cmd: tv.pending_cmd ?? "",
                                tool_escape_paths_text: JSON.stringify(tv.escape_paths ?? []),
                                tool_args_json: JSON.stringify(tv.arguments ?? {}),
                                summary: summaryTextOf(tv)
                            })
                        } else {
                            nb.push(b)
                        }
                    } else {
                        nb.push(b)
                    }
                } else if kind == "thinking" {
                    // PLAN-073 r5：落盘的思考块必然已结束——重建为带 done
                    // 态的全字段形态（原 `b.state = "done"` 是缺键 SET，VM 崩）。
                    nb.push({ kind: "thinking", text: b.text ?? "", state: b.state ?? "done" })
                } else {
                    nb.push(b)
                }
                bi = bi + 1
            }
            m.blocks = nb
        }
        mi = mi + 1
    }
    return cur
}

/** 新建 assistant 消息骨架(不落 store——由调用方 push);profession_id 来自 turn_start。 */
/** PLAN-071 需求⑧ T-34：会话 mode → 职业 role（内置四模式静态映射；
    用户自定义 mode 回退 mode 名本身）。乐观 assistant 气泡身份用。 */
fn modeRoleOf(mode str) str {
    if mode == "superpowers" { return "assistant" }
    if mode == "basic" { return "coder" }
    if mode == "coding" { return "coder" }
    if mode == "review" { return "reviewer" }
    return mode
}

// PLAN-083 T-03：分页回填的扁平重建漏斗——JSON.parse 产物直接落 store 时，
// 渲染/computed 上下文对 blocks 深度字段读产出 "0"（PLAN-081 r5 定罪的
// 家族；旧链 normalizeToolBlocks 的 handler 上下文重建正是承重件，分页
// 直出跳过它曾在 V-4 实测翻车：652KB 会话 assistant 气泡整空）。此处以
// handler 上下文把每消息/每块重建为字面量对象——分页载荷已是扁平字符串
// 块（blocks_normalized），重建是纯拷贝非拍平，有界（≤50 消息，毫秒级）。
// 三个回填 handler（DetailLoaded/OlderLoaded/PollBackfill）统一过此漏斗。
fn rebuildParsedMessages(msgs Value) Value {
    if msgs == None { return [] }
    var out list = []
    var mi = 0
    while mi < msgs.length {
        let m = msgs[mi]
        var nb list = []
        let mblocks = m.blocks ?? None
        if mblocks != None {
            var bi = 0
            while bi < mblocks.length {
                let b = mblocks[bi]
                nb.push({
                    kind: b.kind ?? "text",
                    text: b.text ?? "",
                    state: b.state ?? None,
                    tkey: b.tkey ?? "",
                    tool_name: b.tool_name ?? "",
                    tool_id: b.tool_id ?? "",
                    tool_status: b.tool_status ?? "",
                    tool_result: b.tool_result ?? "",
                    tool_gate_id: b.tool_gate_id ?? "",
                    tool_pending_cmd: b.tool_pending_cmd ?? "",
                    tool_escape_paths_text: b.tool_escape_paths_text ?? "[]",
                    tool_args_json: b.tool_args_json ?? "{}",
                    summary: b.summary ?? "",
                    truncated: b.truncated ?? None
                })
                bi = bi + 1
            }
        }
        out.push({
            id: m.id ?? "",
            role: m.role ?? "user",
            content: m.content ?? "",
            thinking: m.thinking ?? "",
            created_at: m.created_at ?? 0,
            parent_id: m.parent_id ?? None,
            blocks: nb,
            profession_id: m.profession_id ?? None,
            pending: m.pending ?? None
        })
        mi = mi + 1
    }
    return out
}

// PLAN-083 T-03：轮询回填的窗口合并——fresh（快照最近 N 条）首条在 cur
// 有锚点 → 保 cur 锚点前缀（用户已翻页加载的历史）+ fresh 全量；无锚点
// （fork/叶切换/cur 空）→ 整表换入。fresh 空表防御：直接透传（清场语义
// 由调用方负责，快照空=会话被清）。
fn mergeTailWindow(cur Value, fresh Value) Value {
    if fresh == None { return cur }
    if fresh.length == 0 { return fresh }
    if cur == None { return fresh }
    if cur.length == 0 { return fresh }
    var anchor = -1
    var i = 0
    while i < cur.length {
        if cur[i].id == fresh[0].id { anchor = i }
        i = i + 1
    }
    if anchor == -1 { return fresh }
    var out list = []
    var h = 0
    while h < anchor {
        out.push(cur[h])
        h = h + 1
    }
    var f = 0
    while f < fresh.length {
        out.push(fresh[f])
        f = f + 1
    }
    return out
}

fn newAssistantMsg(professionId str) Value {
    return { id: "a-" + Date.now(), role: "assistant", content: "", thinking: "", created_at: nowSec(), tool_calls: [], blocks: [], profession_id: professionId }
}

// PLAN-077: stable, independent expansion IDs, serialized for primitive props.
fn toggleBlockExpansion(encoded str, key str) str {
    if key == "" { return "" }
    var ids list = []
    if encoded != "" { ids = JSON.parse(encoded) }
    var out list = []
    var found = false
    for id in ids {
        if id == key { found = true } else { out.push(id) }
    }
    if !found { out.push(key) }
    return JSON.stringify(out)
}
