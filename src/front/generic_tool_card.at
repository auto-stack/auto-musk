// generic_tool_card.at — GenericToolCard 组件（Plan 023 P3 续：逃生舱原生化）
//
// 对标 src/front/components/GenericToolCard.vue（逃生舱）。
// 沿用 ErrandCard/TaskPlanCard 验证过的迁移模式（408 P4-P9）。
//
// 关键转换：
//   - JSON.stringify(tc.arguments, null, 2) → toolArgsJson fn（.at 无宿主 API）
//   - getToolSummary → use{fn}（P5）
//   - summary segments for 循环 + 动态 class（seg.type）→ 嵌套 if 表达式
//     （循环变量字段，非 computed，不受缺陷 8 嵌套残留影响）
//   - expanded toggle → model + on（P4）
//   - 行内三元/拼接 → 提 computed（parser 陷阱规避）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.tool-card 等）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web getToolSummary, toolArgsJson, toolTruncBadge from "src/front/forge_helpers.at"
use.web component Markdown from "src/front/ports/renderer.at"

widget GenericToolCard(tc: obj) {
    computed {
        name => .tc.name
        status => if .tc.status != "" { .tc.status } else { "running" }
        cardClass => "tool-card " + .status
        statusClass => "tool-status " + .status
        hasResult => if .tc.result != "" { true } else { false }
        resultText => if .hasResult { .tc.result } else { "" }
        argsJson => toolArgsJson(.tc)
        summary => getToolSummary(.tc)
        chevron => if .expanded { "▲" } else { "▼" }
        // PLAN-042:details 载荷(edit diff/截断/全量输出路径)。
        hasDiff => if .tc.details == None { false } else { if .tc.details.diff == None { false } else { true } }
        diffText => if .hasDiff { .tc.details.diff } else { "" }
        hasTrunc => if .tc.details == None { false } else { if .tc.details.truncation == None { false } else { true } }
        truncBadge => if .hasTrunc { toolTruncBadge(.tc.details) } else { "" }
        hasFullOutput => if .tc.details == None { false } else { if .tc.details.full_output_path == None { false } else { true } }
        fullOutputPath => if .hasFullOutput { .tc.details.full_output_path } else { "" }
    }
    msg Msg { Toggle }
    model { var expanded bool = false }
    on {
        .Toggle -> { .expanded = !.expanded }
    }
    // 样式必须放本组件的 style 块（scoped）：元素在 GenericToolCard 自己的
    // 模板里。此前放在 ToolBlock（父组件）的 style 块，scoped 打不到子组件
    // 元素，整组规则失效（行高细/icon 不右对齐/文字不居中的直接原因）。
    // 取值对齐原生 web/src/views/ChatsView.vue 的 .tool-* 基准。
    style {
.tool-card { border: 1px solid hsl(var(--border)); border-radius: 8px; margin: 0; overflow: hidden; width: 100%; background: transparent; }
.tool-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem; cursor: pointer; user-select: none; }
.tool-header:hover { background: hsl(var(--muted-foreground) / 0.04); }
.tool-icon { font-size: 0.93rem; line-height: 1; flex-shrink: 0; }
.tool-name { font-size: 0.83rem; font-weight: 500; color: hsl(var(--foreground)); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tool-seg { font-size: 0.78rem; font-weight: 500; font-family: 'Geist Mono', 'Fira Code', monospace; flex-shrink: 0; }
.tool-seg.seg-path { color: hsl(190 80% 40%); }
.tool-seg.seg-loc { color: hsl(var(--muted-foreground)); }
.tool-seg.seg-pattern { color: hsl(280 60% 45%); }
.tool-seg.seg-desc { color: hsl(var(--foreground)); }
.tool-status { font-size: 0.73rem; font-weight: 500; flex-shrink: 0; }
.tool-status.running { color: hsl(210 90% 52%); }
.tool-status.completed { color: hsl(142 71% 40%); }
.tool-status.failed { color: hsl(var(--destructive)); }
.tool-chevron { font-size: 0.7rem; color: hsl(var(--muted-foreground)); flex-shrink: 0; }
.tool-body { border-top: 1px solid hsl(var(--border)); padding: 0.5rem 0.6rem; }
.tool-section { margin-bottom: 0.4rem; }
.tool-section:last-child { margin-bottom: 0; }
.tool-section-title { font-size: 0.73rem; font-weight: 500; text-transform: uppercase; color: hsl(var(--muted-foreground)); margin-bottom: 0.2rem; letter-spacing: 0.02em; }
.tool-code.tool-diff { white-space: pre; }
.tool-code { font-size: 0.83rem; color: hsl(var(--muted-foreground)); background: hsl(var(--muted-foreground) / 0.04); padding: 0.35rem 0.5rem; border-radius: 4px; overflow-x: auto; white-space: pre-wrap; word-break: break-word; font-family: 'Geist Mono', 'Fira Code', monospace; margin: 0; }
    }
    view {
        col {
            class: if .status == "completed" { "tool-card completed border border-border rounded-lg w-full" } else { if .status == "failed" { "tool-card failed border border-border rounded-lg w-full" } else { "tool-card running border border-border rounded-lg w-full" } }
            // header（click toggle）
            row {
                onclick: .Toggle
                style: "tool-header py-[0.4rem] px-[0.6rem]"
                text "🔧" { style: "tool-icon" }
                text .name { style: "tool-name" }
                for seg in .summary {
                    text .seg.text { class: if .seg.type == "path" { "tool-seg seg-path" } else { if .seg.type == "pattern" { "tool-seg seg-pattern" } else { if .seg.type == "desc" { "tool-seg seg-desc" } else { "tool-seg seg-loc" } } } }
                }
                text .status { class: if .status == "completed" { "tool-status completed" } else { if .status == "failed" { "tool-status failed" } else { "tool-status running" } } }
                text .chevron { style: "tool-chevron" }
            }
            // body（展开时）——Result 走 Markdown 渲染（与原生 MarkdownRender 一致，
            // 内容里的代码/表格带高亮），Arguments 保持 JSON pre。
            if .expanded {
                col {
                    style: "tool-body border-t border-border px-[0.6rem] py-[0.5rem]"
                    col {
                        style: "tool-section"
                        text "Arguments" { style: "tool-section-title" }
                        div {
                            style: "tool-code bg-muted-foreground/[0.04] rounded-[4px] px-[0.35rem] py-[0.5rem]"
                            text .argsJson
                        }
                    }
                    if .hasResult {
                        col {
                            style: "tool-section"
                            text "Result" { style: "tool-section-title" }
                            Markdown(source: .resultText, streaming: false)
                        }
                    }
                    // PLAN-042:details 载荷区(存在才渲染)。
                    if .hasDiff {
                        col {
                            style: "tool-section"
                            text "Diff" { style: "tool-section-title" }
                            div {
                                style: "tool-code tool-diff"
                                text .diffText
                            }
                        }
                    }
                    if .hasTrunc {
                        col {
                            style: "tool-section"
                            text "Truncated" { style: "tool-section-title" }
                            div {
                                style: "tool-code bg-muted-foreground/[0.04] rounded-[4px] px-[0.35rem] py-[0.5rem]"
                                text .truncBadge
                            }
                        }
                    }
                    if .hasFullOutput {
                        col {
                            style: "tool-section"
                            text "Full output" { style: "tool-section-title" }
                            div {
                                style: "tool-code bg-muted-foreground/[0.04] rounded-[4px] px-[0.35rem] py-[0.5rem]"
                                text .fullOutputPath
                            }
                        }
                    }
                }
            }
        }
    }
}
