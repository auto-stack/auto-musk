// i18n.at — auto-i18n：vue-i18n 语义子集纯 .at 实现（PLAN-038 Phase 1）
//
// 语义按 vue-i18n 9 实测锁定（基准 fixtures：scripts/lib-parity/fixtures/i18n-expected.json，
// 对拍：scripts/lib-parity/i18n.mjs）：
//   1. 嵌套点分键查找；叶子非字符串（对象/数组）或路径中断 → 返回 key 本身
//   2. 具名插值 {name}：params 提供则替换为其值的字符串形式，未提供 → 空串
//   3. 字面量转义 {'x'} → x
//   4. locale 不在目录 → 返回 key 本身
//
// locale 状态（切换/持久化）是宿主职责：vue 轨 = useT 桥，VM 轨 = 迁移侧信号机制。
// 本模块自足：不引用任何外部模块/生态绑定（验收 1 grep 零命中的字面口径）；
// 目录数据内嵌于 @gen 标记区块，由 scripts/gen-i18n-catalog.mjs 从
// src/front/i18n/{zh,en}.json 再生——勿手改区块。

/** [a-zA-Z0-9_] 判断（插值名扫描）。 */
fn i18n_is_word_char(c str) bool {
    if c >= "0" && c <= "9" { return true }
    if c >= "a" && c <= "z" { return true }
    if c >= "A" && c <= "Z" { return true }
    if c == "_" { return true }
    return false
}

/** 值转字符串（Num 42 → "42"；str 原样）。 */
fn i18n_to_str(v Value) str {
    if v == None { return "" }
    return "" + v
}

/**
 * 插值渲染（手写扫描，等价 vue-i18n message 编译器在 musk 使用面的行为）：
 *   {name}   → params[name]（缺参 → 空串）
 *   {'lit'}  → lit
 * 未闭合/未知形态按字面输出。
 */
fn i18n_interp(template str, params obj) str {
    let out = ""
    let i = 0
    let n = template.length
    for i < n {
        if template.char_at(i) == "{" && i + 1 < n {
            if template.char_at(i + 1) == "'" {
                // 字面量 {'x'}
                let j = i + 2
                let lit = ""
                let closed = false
                for j < n {
                    let lc = template.char_at(j)
                    if lc == "'" {
                        if j + 1 < n && template.char_at(j + 1) == "}" {
                            closed = true
                            j = j + 2
                        } else {
                            break
                        }
                    } else {
                        lit = lit + lc
                        j = j + 1
                    }
                }
                if closed {
                    out = out + lit
                    i = j
                } else {
                    out = out + template.char_at(i)
                    i = i + 1
                }
            } else {
                // 具名 {name}
                let j = i + 1
                let name = ""
                for j < n {
                    let wc = template.char_at(j)
                    if i18n_is_word_char(wc) {
                        name = name + wc
                        j = j + 1
                    } else {
                        break
                    }
                }
                if name != "" && j < n && template.char_at(j) == "}" {
                    out = out + i18n_to_str(params[name])
                    i = j + 1
                } else {
                    out = out + template.char_at(i)
                    i = i + 1
                }
            }
        } else {
            out = out + template.char_at(i)
            i = i + 1
        }
    }
    return out
}

/**
 * t() 语义子集：嵌套点分查找 → 插值 → 缺键回退 key。
 * i18nT("zh", "chat.msgs", { "count": 42 }) == "42 条"
 */
fn i18nT(locale str, key str, params obj) str {
    if key == None { return "" }
    let catalog = i18n_catalog()
    let messages = catalog[locale]
    if messages == None { return key }
    let parts = key.split(".")
    let cur = messages
    for p in parts {
        if cur == None { return key }
        cur = cur[p]
    }
    // 叶子非字符串（None/对象/数组——.split 为 str 原生属性）视为缺键：vue-i18n 返回 key
    if cur == None || cur.split == None { return key }
    return i18n_interp(cur, params ?? {})
}

