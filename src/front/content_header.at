// content_header.at — ContentHeader 组件（Plan 023 §3.1：三视图内容标题栏收敛）
//
// 收敛目标：三个内容标题栏（chats 的 chats-header / specs 的 section-header /
// wiki 的 wiki-content-header）共用一个 component fn——标题 + 中间区（slot，
// chats 的搜索）+ 操作区（slot）。
//
// 架构：header 贴顶全宽自带宽（48px + border-bottom），内容容器单独 padding。
// 各视图把 header 提到内容容器外（section/wiki 原负 margin hack 消除）。
//
// 样式：`.content-header` 系列为单一真源（inject_styles.ts），替代分散的
// chats-header/section-header/wiki-content-header 规则 + !important 覆盖。

widget ContentHeader(title: str) {
    view {
        div {
            style: "content-header"
            span {
                style: "content-header-title"
                text .title
            }
            div {
                style: "content-header-middle"
                slot(name: "middle") {}
            }
            slot(name: "actions") {}
        }
    }
}
