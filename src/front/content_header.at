// content_header.at — ContentHeader 组件（Plan 023 §3.1：三视图内容标题栏收敛）
//
// 收敛目标：三个内容标题栏（chats 的 chats-header / specs 的 section-header /
// wiki 的 wiki-content-header）共用一个 component fn——标题 + 中间区（slot，
// chats 的搜索）+ 操作区（slot）。
//
// 架构：header 贴顶全宽自带宽（48px + border-bottom），内容容器单独 padding。
// 各视图把 header 提到内容容器外（section/wiki 原负 margin hack 消除）。
//
// 样式：inject_styles.ts 的 .content-header 系列已迁内联工具类
//（PLAN-049 双轨收敛,单一样式源）。

// PLAN-084 T-06: 可选 fallback（title 为空串时的回退文案，如"聊天"）、
// subtitle（agent 身份徽章文案）与 status（""|"running"|"idle"，头部流式
// 状态点）——缺省空串不渲染，wiki/specs 既有调用零改动。标题/徽章/状态
// 由调用方 store handler 域维护（视图 prop 内联 use.web.fn 调用 VM 侧
// 不可靠，T-07 实证）。
widget ContentHeader(title: str, fallback: str = "", subtitle: str = "", status: str = "") {
    view {
        div {
            style: "flex items-center justify-between gap-3 h-12 shrink-0 px-5 border-b border-border bg-card"
            div {
                style: "flex items-center gap-2 flex-1 min-w-0 overflow-hidden"
                if .title != "" {
                    span {
                        style: "text-base font-semibold text-foreground w-[250px] truncate"
                        text .title
                    }
                }
                if .title == "" {
                    span {
                        style: "text-base font-semibold text-foreground w-[250px] truncate"
                        text .fallback
                    }
                }
                if .subtitle != "" {
                    span {
                        style: "text-xs text-muted-foreground border border-border rounded-md px-1.5 py-[1px] shrink-0 max-w-[160px] truncate"
                        text .subtitle
                    }
                }
                // 流式状态点：绿=运行中 / 灰=空闲（VM 轨呼吸动画未证，
                // 常亮形态，T-07 实机核）。
                if .status == "running" {
                    span {
                        style: "text-[10px] leading-none text-emerald-400 shrink-0"
                        text "●"
                    }
                }
                if .status == "idle" {
                    span {
                        style: "text-[10px] leading-none text-muted-foreground shrink-0"
                        text "●"
                    }
                }
            }
            div {
                style: "shrink-0 min-w-0"
                slot(name: "middle") {}
            }
            slot(name: "actions") {}
        }
    }
}
