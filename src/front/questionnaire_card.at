// questionnaire_card.at — QuestionnaireCard 组件（Plan 023 队列 B1：纯 emit 逃生舱原生化）
//
// 对标 src/front/components/QuestionnaireCard.vue（逃生舱，已删除）。
// 验证 emit 带负载（msg 变体小写 submit + answers payload → 父组件 onsubmit($event)）。
//
// 关键转换：
//   - answers 动态键记录（answers[q.id]）→ model obj + handler 动态键赋值
//     （.answers[qid] = ...，StreamingTable 动态索引模式）
//   - radio/checkbox v-model（.at 无法同时表达 v-model + :value）→ 可点击
//     q-option 按钮 + SelectSingle/SelectMultiple handler
//   - 数组 includes/toggle + canSubmit 遍历校验 + placeholder 兜底 → questionnaire_helpers.ts fn
//   - 文本输入 v-model（value: + oninput:）→ 动态键 answers[q.id]
//
// 样式：PLAN-049 T6 双轨收敛（沿 GateCard 先例）——原 style{} 块（.q-* 系）
// 全量迁内联工具类，VM 轨不再出现"整卡纯 primary 色块"（旧卡 bg-primary/[0.04]
// 的分数 alpha 括号形 VM 解析回退 100% 饱和，自定义类名又全被跳过）。
// 色裁定：hsl(var(--primary)/0.04)→bg-primary/5、/0.15→border-primary/15、
// hover /0.06→hover:bg-primary/5、checked /0.08→bg-primary/10（5 的倍数刻度，
// tailwind 刻度内且 VM u8 百分比可解析）；0.85/0.88/0.82rem→13.6/14.1/13.1px。
// checked 圈内白点/白勾原为 ::after 伪元素（iced 无对应）→ 条件渲染子元素：
// radio 内点 5px 圆、checkbox 白勾近似为 ✓ 字形（web 同形）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component HelpCircle, Send from "src/front/ports/icons.at"
use.web questionnaireSingleChecked, questionnaireMultiChecked, questionnaireToggleAnswer, questionnaireOtherKey, questionnaireCanSubmit, questionnairePlaceholder, eventInputValue, formatQuestionnaireAnswers from "src/front/questionnaire_helpers.at"

widget QuestionnaireCard(questions: obj) {
    // 注意：视图内 reactive 位（class/disabled/onclick 载荷）一律 helpers 直调，
    // 不走 computed——VM 端 PLAN-047 computed 信号网对 model obj 的动态键原地
    // mutation（.answers[qid] = ...）不失效，computed 值会卡在首帧（实测
    // SelectSingle 后 canSubmit 恒 false → Submit 永久禁用；同缺口使旧版
    // VM 轨 Submit 从未真正可点）。helpers 直调每帧重算，Vue 模板同表达式
    // 亦天然响应式，双轨一致。
    // 注意：msg 变体不声明 payload——多参变体的 emit 类型在 Vue 路径只取第一个参数
    // （codegen 注释：multi-param variants are a Rust-backend feature）。让 on-block
    // handler 参数驱动 emit 类型（fallback 给 [any, any]），避免 TS 不匹配。
    msg Msg { SelectSingle, SelectMultiple, TextChanged, OtherChanged, submit }
    model { var answers obj = {} }
    on {
        .SelectSingle(qid, opt) -> { .answers[qid] = opt }
        .SelectMultiple(qid, opt) -> { .answers[qid] = questionnaireToggleAnswer(.answers, qid, opt) }
        // 文本/other 输入：动态键 v-model 是 codegen 缺口（value: 仅 Ident/Dot 触发
        // v-model，Index 不触发）→ 受控组件：value: + oninput(.q.id, $event) 显式更新。
        .TextChanged(qid, e) -> { .answers[qid] = eventInputValue(e) }
        .OtherChanged(qid, e) -> { .answers[questionnaireOtherKey(qid)] = eventInputValue(e) }
        .submit(answers) -> {}
    }
    view {
        div {
            style: "w-full mt-[8.8px] px-[16px] py-[12px] rounded-lg border border-primary/15 bg-primary/5 flex flex-col gap-[12px] box-border"
            div {
                style: "flex items-center gap-[6.4px] text-[13.6px] font-semibold text-primary"
                HelpCircle { size: 16 }
                span "Quick Questions"
            }
            for q in .questions {
                div {
                    key: .q.id
                    style: "flex flex-col gap-[5.6px]"
                    div {
                        style: "text-[14.1px] font-medium text-foreground leading-[1.4]"
                        text "Q" + .q.text
                    }
                    if .q.type == "single" {
                        div {
                            style: "flex flex-col items-stretch gap-[2.4px] pl-[17.6px]"
                            for opt in .q.options {
                                button {
                                    onclick: .SelectSingle(.q.id, opt)
                                    key: "single-" + opt
                                    class: if questionnaireSingleChecked(.answers, .q.id, opt) {
                                        "w-full flex items-center justify-start gap-[6.4px] py-[5.6px] px-2 rounded-md border-none bg-primary/10 text-left text-[13.6px] text-foreground cursor-pointer leading-[1.3] hover:bg-primary/10"
                                    } else {
                                        "w-full flex items-center justify-start gap-[6.4px] py-[5.6px] px-2 rounded-md border-none bg-transparent text-left text-[13.6px] text-foreground cursor-pointer leading-[1.3] hover:bg-primary/5"
                                    }
                                    div {
                                        class: if questionnaireSingleChecked(.answers, .q.id, opt) {
                                            "w-[14px] h-[14px] shrink-0 rounded-full border-2 border-primary bg-primary flex items-center justify-center"
                                        } else {
                                            "w-[14px] h-[14px] shrink-0 rounded-full border-2 border-border bg-transparent flex items-center justify-center"
                                        }
                                        if questionnaireSingleChecked(.answers, .q.id, opt) {
                                            span { style: "w-[5px] h-[5px] rounded-full bg-white" }
                                        }
                                    }
                                    span { style: "leading-[1.3]", text opt }
                                }
                            }
                            if .q.otherLabel != None {
                                div {
                                    style: "flex items-center gap-[6.4px] py-[5.6px] px-2 text-[13.6px] text-foreground"
                                    span {
                                        style: "shrink-0 text-muted-foreground"
                                        text .q.otherLabel
                                    }
                                    input {
                                        type: "text"
                                        style: "w-full py-[6.4px] px-[9.6px] border border-border rounded-md bg-background text-foreground text-[13.6px] outline-none focus:border-primary"
                                        value: .answers[questionnaireOtherKey(.q.id)]
                                        oninput: .OtherChanged(.q.id, $event)
                                        placeholder: questionnairePlaceholder(.q, "Type here...")
                                    }
                                }
                            }
                        }
                    } else if .q.type == "multiple" {
                        div {
                            style: "flex flex-col items-stretch gap-[2.4px] pl-[17.6px]"
                            for choice in .q.options {
                                button {
                                    onclick: .SelectMultiple(.q.id, choice)
                                    key: "multi-" + choice
                                    class: if questionnaireMultiChecked(.answers, .q.id, choice) {
                                        "w-full flex items-center justify-start gap-[6.4px] py-[5.6px] px-2 rounded-md border-none bg-primary/10 text-left text-[13.6px] text-foreground cursor-pointer leading-[1.3] hover:bg-primary/10"
                                    } else {
                                        "w-full flex items-center justify-start gap-[6.4px] py-[5.6px] px-2 rounded-md border-none bg-transparent text-left text-[13.6px] text-foreground cursor-pointer leading-[1.3] hover:bg-primary/5"
                                    }
                                    div {
                                        class: if questionnaireMultiChecked(.answers, .q.id, choice) {
                                            "w-[14px] h-[14px] shrink-0 rounded border-2 border-primary bg-primary flex items-center justify-center"
                                        } else {
                                            "w-[14px] h-[14px] shrink-0 rounded border-2 border-border bg-transparent flex items-center justify-center"
                                        }
                                        if questionnaireMultiChecked(.answers, .q.id, choice) {
                                            span { style: "text-[9px] leading-none font-bold text-white", text "✓" }
                                        }
                                    }
                                    span { style: "leading-[1.3]", text choice }
                                }
                            }
                            if .q.otherLabel != None {
                                div {
                                    style: "flex items-center gap-[6.4px] py-[5.6px] px-2 text-[13.6px] text-foreground"
                                    span {
                                        style: "shrink-0 text-muted-foreground"
                                        text .q.otherLabel
                                    }
                                    input {
                                        type: "text"
                                        style: "w-full py-[6.4px] px-[9.6px] border border-border rounded-md bg-background text-foreground text-[13.6px] outline-none focus:border-primary"
                                        value: .answers[questionnaireOtherKey(.q.id)]
                                        oninput: .OtherChanged(.q.id, $event)
                                        placeholder: questionnairePlaceholder(.q, "Type here...")
                                    }
                                }
                            }
                        }
                    } else if .q.type == "text" {
                        div {
                            input {
                                type: "text"
                                style: "w-full py-[6.4px] px-[9.6px] border border-border rounded-md bg-background text-foreground text-[13.6px] outline-none focus:border-primary"
                                value: .answers[q.id]
                                oninput: .TextChanged(.q.id, $event)
                                placeholder: questionnairePlaceholder(.q, "Type your answer...")
                            }
                        }
                    }
                }
            }
            div {
                style: "flex"
                button {
                    onclick: .submit(formatQuestionnaireAnswers(.questions, .answers))
                    disabled: !questionnaireCanSubmit(.questions, .answers)
                    // w-auto：iced 0.14 button 宽度=内容 size_hint 的 fluid()，文本子节点
                    // 带 Fill 时按钮被撑满整行——显式 Shrink 收缩到内容宽（对齐 Vue
                    // align-self:flex-start 的左置窄钮）。
                    // 禁用变暗：VM 无 disabled:opacity 消费面（Plan 423 只压灰文本色），
                    // Vue codegen 对 button 的 disabled: 恒不发射 :disabled（既有缺口，
                    // 迁移前 q-submit 时代同样缺失）——故 canSubmit 条件化底色
                    // bg-primary/50 在双轨承载 disabled:opacity-50 的观感。
                    class: if questionnaireCanSubmit(.questions, .answers) {
                        "w-auto inline-flex items-center justify-center gap-[4.8px] py-[6.4px] px-[12.8px] rounded-md border-none bg-primary text-white text-[13.1px] font-medium cursor-pointer hover:opacity-90"
                    } else {
                        "w-auto inline-flex items-center justify-center gap-[4.8px] py-[6.4px] px-[12.8px] rounded-md border-none bg-primary/50 text-white text-[13.1px] font-medium cursor-pointer"
                    }
                    Send { size: 13 }
                    text "Submit Answers"
                }
            }
        }
    }
}
