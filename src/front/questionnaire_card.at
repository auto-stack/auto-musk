// questionnaire_card.at — QuestionnaireCard 组件（Plan 023 队列 B1：纯 emit 逃生舱原生化）
//
// 对标 src/front/components/QuestionnaireCard.vue（逃生舱，已删除）。
// 验证 emit 带负载（msg 变体小写 submit + answers payload → 父组件 onsubmit($event)）。
//
// 关键转换：
//   - answers 动态键记录（answers[q.id]）→ model obj + handler 动态键赋值
//     （.answers[qid] = ...，StreamingTable 动态索引模式）
//   - radio/checkbox v-model（.at 无法同时表达 v-model + :value）→ 可点击
//     q-option 按钮 + SelectSingle/SelectMultiple handler
//   - 数组 includes/toggle + canSubmit 遍历校验 + placeholder 兜底 → questionnaire_helpers.ts fn
//   - 文本输入 v-model（value: + oninput:）→ 动态键 answers[q.id]
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.questionnaire-card 等）。

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component HelpCircle, Send from "src/front/ports/icons.at"
use.web questionnaireSingleChecked, questionnaireMultiChecked, questionnaireToggleAnswer, questionnaireOtherKey, questionnaireCanSubmit, questionnairePlaceholder, eventInputValue, formatQuestionnaireAnswers from "src/front/questionnaire_helpers.at"

widget QuestionnaireCard(questions: obj) {
    computed {
        canSubmit => questionnaireCanSubmit(.questions, .answers)
        // 提交载荷：格式化后的可读文本（"Q1: A; Q2: B"），父组件直接作为
        // user 消息发送——而非裸 answers 对象（对话历史不可读）。
        submitText => formatQuestionnaireAnswers(.questions, .answers)
    }
    // 注意：msg 变体不声明 payload——多参变体的 emit 类型在 Vue 路径只取第一个参数
    // （codegen 注释：multi-param variants are a Rust-backend feature）。让 on-block
    // handler 参数驱动 emit 类型（fallback 给 [any, any]），避免 TS 不匹配。
    msg Msg { SelectSingle, SelectMultiple, TextChanged, OtherChanged, submit }
    model { var answers obj = {} }
    on {
        .SelectSingle(qid, opt) -> { .answers[qid] = opt }
        .SelectMultiple(qid, opt) -> { .answers[qid] = questionnaireToggleAnswer(.answers, qid, opt) }
        // 文本/other 输入：动态键 v-model 是 codegen 缺口（value: 仅 Ident/Dot 触发
        // v-model，Index 不触发）→ 受控组件：value: + oninput(.q.id, $event) 显式更新。
        .TextChanged(qid, e) -> { .answers[qid] = eventInputValue(e) }
        .OtherChanged(qid, e) -> { .answers[questionnaireOtherKey(qid)] = eventInputValue(e) }
        .submit(answers) -> {}
    }
    style {
.q-header { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; font-weight: 600; color: var(--af-primary); }
.q-item { display: flex; flex-direction: column; gap: 0.35rem; }
.q-text { font-size: 0.88rem; font-weight: 500; color: var(--af-fg); line-height: 1.4; }
.q-options { display: flex; flex-direction: column; gap: 0.15rem; padding-left: 1.1rem; align-items: stretch; }
.q-option {
  display: flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.5rem;
  border: none; border-radius: 6px; background: transparent; cursor: pointer;
  transition: background 0.1s; font-size: 0.85rem; color: var(--af-fg); text-align: left; width: 100%; justify-content: flex-start;
}
.q-option:hover { background: hsl(var(--primary) / 0.06); }
.q-option.checked { background: hsl(var(--primary) / 0.08); }
.q-check {
  width: 14px; height: 14px; border: 2px solid var(--af-border); border-radius: 50%;
  flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all 0.15s;
}
.q-check.square { border-radius: 4px; }
.q-option.checked .q-check { border-color: var(--af-primary); background: var(--af-primary); }
.q-option.checked .q-check::after {
  content: ''; width: 5px; height: 5px; border-radius: 50%; background: #fff;
}
.q-option.checked .q-check.square::after {
  width: 6px; height: 3px; border-radius: 0; background: transparent;
  border-left: 2px solid #fff; border-bottom: 2px solid #fff;
  transform: rotate(-45deg); margin-bottom: 1px;
}
.q-label { line-height: 1.3; }
.q-text-input input, .q-other-input {
  width: 100%; padding: 0.4rem 0.6rem; border: 1px solid var(--af-border); border-radius: 6px;
  background: var(--af-bg); color: var(--af-fg); font-size: 0.85rem; outline: none; transition: border-color 0.15s;
}
.q-text-input input:focus, .q-other-input:focus { border-color: var(--af-primary); }
.q-other-row { display: flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.5rem; font-size: 0.85rem; color: var(--af-fg); }
.q-other-label { flex-shrink: 0; color: var(--af-muted); }
.q-other-input { flex: 1; min-width: 0; }
.q-submit {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.3rem;
  align-self: flex-start; padding: 0.4rem 0.8rem; border: none; border-radius: 6px;
  background: var(--af-primary); color: #fff; font-size: 0.82rem; font-weight: 500;
  cursor: pointer; transition: opacity 0.15s;
}
.q-submit:disabled { opacity: 0.5; cursor: not-allowed; }
.q-submit:hover:not(:disabled) { opacity: 0.9; }
.questionnaire-card {
  background: hsl(var(--primary) / 0.04); border: 1px solid hsl(var(--primary) / 0.15);
  border-radius: 10px; padding: 0.75rem 1rem; margin-top: 0.55rem; width: 100%; box-sizing: border-box;
  display: flex; flex-direction: column; gap: 0.75rem;
}
    }

    view {
        div {
            style: "questionnaire-card"
            div {
                style: "q-header"
                HelpCircle { size: 16 }
                span "Quick Questions"
            }
            for q in .questions {
                div {
                    key: .q.id
                    style: "q-item"
                    div {
                        style: "q-text"
                        text "Q"
                        text .q.text
                    }
                    if .q.type == "single" {
                        div {
                            style: "q-options"
                            for opt in .q.options {
                                button {
                                    onclick: .SelectSingle(.q.id, opt)
                                    key: opt
                                    class: if questionnaireSingleChecked(.answers, .q.id, opt) { "q-option checked" } else { "q-option" }
                                    span { style: "q-check" }
                                    span { style: "q-label", text opt }
                                }
                            }
                            if .q.otherLabel != None {
                                div {
                                    style: "q-other-row"
                                    span {
                                        style: "q-other-label"
                                        text .q.otherLabel
                                    }
                                    input {
                                        type: "text"
                                        style: "q-other-input"
                                        value: .answers[questionnaireOtherKey(.q.id)]
                                        oninput: .OtherChanged(.q.id, $event)
                                        placeholder: questionnairePlaceholder(.q, "Type here...")
                                    }
                                }
                            }
                        }
                    } else if .q.type == "multiple" {
                        div {
                            style: "q-options"
                            for opt in .q.options {
                                button {
                                    onclick: .SelectMultiple(.q.id, opt)
                                    key: opt
                                    class: if questionnaireMultiChecked(.answers, .q.id, opt) { "q-option checked" } else { "q-option" }
                                    span { style: "q-check square" }
                                    span { style: "q-label", text opt }
                                }
                            }
                            if .q.otherLabel != None {
                                div {
                                    style: "q-other-row"
                                    span {
                                        style: "q-other-label"
                                        text .q.otherLabel
                                    }
                                    input {
                                        type: "text"
                                        style: "q-other-input"
                                        value: .answers[questionnaireOtherKey(.q.id)]
                                        oninput: .OtherChanged(.q.id, $event)
                                        placeholder: questionnairePlaceholder(.q, "Type here...")
                                    }
                                }
                            }
                        }
                    } else if .q.type == "text" {
                        div {
                            style: "q-text-input"
                            input {
                                type: "text"
                                class: "q-text-input-field"
                                value: .answers[q.id]
                                oninput: .TextChanged(.q.id, $event)
                                placeholder: questionnairePlaceholder(.q, "Type your answer...")
                            }
                        }
                    }
                }
            }
            button {
                onclick: .submit(.submitText)
                style: "q-submit"
                disabled: !.canSubmit
                Send { size: 13 }
                text "Submit Answers"
            }
        }
    }
}
