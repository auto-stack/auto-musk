// errand_card.at — ErrandCard 组件（Plan 023 P3 续：逃生舱原生化）
//
// 对标 src/front/components/ErrandCard.vue（逃生舱）。
// 原生化动机：Plan 022 Phase 7c 因 ".at 无法表达 @click toggle" 封逃生舱；
// 现 Plan 408 P4（model/on/emit）+ P5（use{fn}）+ P6（prop 绑定）
//   + P7（动态索引）+ P9（computed 三元 + .value unwrap）全落地，可脱离逃生舱。
//
// 关键转换：
//   - expanded ref → model + on toggle（P4）
//   - task/errandStatus → computed 调 getErrandTask/getErrandState（P5 use{fn}）
//   - computed 互相引用（status 依赖 errandStatus/hasState）—— P9 修复 .value unwrap
//   - errandStatus?.field || default → if != None 分支（.at 无 ?.，用 computed 派生）
//   - 行内三元/拼接 → 全部提到 computed（避免 view body 行内 if 与属性 {} 歧义）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.errand-* 规则，见末尾追加）。

component fn ErrandCard(tc: obj, errands: obj) {
    use {
        fn: getErrandTask, getErrandState from "src/front/forge_helpers.at"
    }
    computed {
        task => getErrandTask(.tc)
        errandStatus => getErrandState(.errands, .tc)
        hasState => .errandStatus != None
        status => if .hasState { .errandStatus.status } else { "running" }
        chevron => if .expanded { "▲" } else { "▼" }
        hasToken => if .hasState { .errandStatus.token_usage != "" } else { false }
        tokenText => if .hasState { .errandStatus.token_usage + " tok" } else { "" }
        hasContent => if .hasState { .errandStatus.content != "" } else { false }
        contentText => if .hasState { .errandStatus.content } else { "" }
        hasToolCalls => if .hasState { .errandStatus.tool_calls != None } else { false }
        toolCallsList => if .hasState { .errandStatus.tool_calls } else { [] }
        hasResult => if .hasState { .errandStatus.result != "" } else { false }
        resultText => if .hasState { .errandStatus.result } else { "" }
        showResult => if .hasResult { .status != "running" } else { false }
    }
    msg Msg { Toggle }
    model { var expanded bool = false }
    on {
        .Toggle -> { .expanded = !.expanded }
    }
    style {
.errand-header { display: flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.75rem; cursor: pointer; font-size: 0.82rem; }
.errand-header:hover { background: hsl(38 92% 50% / 0.06); }
.errand-icon { font-size: 0.9rem; }
.errand-name-prefix { font-weight: 500; }
.errand-name { font-weight: 500; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.errand-status { font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 3px; }
.errand-status.running { background: hsl(var(--primary) / 0.15); color: hsl(var(--primary)); }
.errand-status.completed { background: hsl(142 71% 45% / 0.15); color: hsl(142 71% 45%); }
.errand-status.failed { background: hsl(var(--destructive) / 0.15); color: hsl(var(--destructive)); }
.errand-cost { font-size: 0.7rem; color: hsl(var(--muted-foreground)); }
.errand-body { padding: 0.5rem 0.75rem; border-top: 1px solid hsl(var(--border)); }
.errand-task { font-size: 0.8rem; margin-bottom: 0.3rem; color: hsl(var(--foreground)); }
.errand-content { font-size: 0.78rem; white-space: pre-wrap; margin: 0.3rem 0; max-height: 300px; overflow-y: auto; }
.errand-tool-calls { margin-top: 0.4rem; }
.errand-sub-tool { padding: 0.2rem 0; border-left: 2px solid hsl(var(--border)); padding-left: 0.6rem; margin: 0.2rem 0; }
.errand-sub-tool-header { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; }
.errand-sub-tool-name { font-family: monospace; color: hsl(var(--muted-foreground)); }
.errand-sub-tool-status { font-size: 0.68rem; padding: 0.05rem 0.3rem; border-radius: 3px; }
.errand-sub-tool-status.running { background: hsl(var(--primary) / 0.15); color: hsl(var(--primary)); }
.errand-sub-tool-status.completed { background: hsl(142 71% 45% / 0.15); color: hsl(142 71% 45%); }
.errand-sub-tool-status.failed { background: hsl(var(--destructive) / 0.15); color: hsl(var(--destructive)); }
.errand-sub-tool-result { font-size: 0.72rem; white-space: pre-wrap; margin: 0.2rem 0; max-height: 150px; overflow-y: auto; }
.errand-result { margin-top: 0.5rem; }
.errand-result-label { font-size: 0.72rem; color: hsl(var(--muted-foreground)); margin-bottom: 0.2rem; }
.errand-result-text { font-size: 0.78rem; white-space: pre-wrap; max-height: 400px; overflow-y: auto; }
    }

    col {
        class: if .status == "completed" { "errand-card completed" } else { if .status == "failed" { "errand-card failed" } else { "errand-card running" } }
        // header（click toggle）
        row {
            onclick: .Toggle
            style: "errand-header"
            text "🔍" { style: "errand-icon" }
            text "Errand: " { style: "errand-name-prefix" }
            text .task { style: "errand-name" }
            text .status { class: if .status == "completed" { "errand-status completed" } else { if .status == "failed" { "errand-status failed" } else { "errand-status running" } } }
            if .hasToken {
                text .tokenText { style: "errand-cost" }
            }
            text .chevron { style: "tool-chevron" }
        }
        // body（展开时）
        if .expanded {
            col {
                style: "errand-body"
                text .task { style: "errand-task" }
                if .hasContent {
                    text .contentText { style: "errand-content" }
                }
                if .hasToolCalls {
                    col {
                        style: "errand-tool-calls"
                        for etc in .toolCallsList {
                            col {
                                style: "errand-sub-tool"
                                row {
                                    style: "errand-sub-tool-header"
                                    text .etc.name { style: "errand-sub-tool-name" }
                                    text .etc.status { class: if .etc.status == "completed" { "errand-sub-tool-status completed" } else { if .etc.status == "failed" { "errand-sub-tool-status failed" } else { "errand-sub-tool-status running" } } }
                                }
                                if .etc.result != "" {
                                    text .etc.result { style: "errand-sub-tool-result" }
                                }
                            }
                        }
                    }
                }
                if .showResult {
                    col {
                        style: "errand-result"
                        text "Result" { style: "errand-result-label" }
                        text .resultText { style: "errand-result-text" }
                    }
                }
            }
        }
    }
}
