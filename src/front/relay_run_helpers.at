// relay_run_helpers.at — RelayRunBox 纯渲染 helpers（替代 relay_run_helpers.ts 的纯函数部分）
//
// Plan 028 T12（M3）：F1 字典承载 statusLabel/professionIcon；`??`/`||` 兜底。
// 订阅/加载/审批 6 个 useRelay 依赖 fn 仍在 relay_run_helpers.ts —— 待 T16
// relay_store.at（F8 平台协议）落地后并入。

/** 在当前 run 或 runs 列表里找 run（currentRun 优先 + find 兜底；
 * 严格按 runId 匹配——找不到返回 None（历史回放/失效态由调用方处理）。 */
fn relayFindRun(runs obj, currentRun obj, runId str) obj {
    if currentRun != None {
        if currentRun.run_id == runId { return currentRun }
    }
    let found = runs.find(r => r.run_id == runId)
    return found ?? None
}

/** 状态→中文标签。 */
fn relayStatusLabel(status str) str {
    let labels map = {
        "running": "运行中", "completed": "已完成", "failed": "失败",
        "waiting_approval": "待审批", "idle": "就绪", "paused": "已暂停",
        "interrupted": "已中断"
    }
    let out = labels[status] ?? status
    if out == None { return "..." }
    return out
}

/** 状态→class 段（completed/failed/gate/running）。 */
fn relayStatusClass(status str) str {
    if status == "completed" { return "completed" }
    if status == "failed" { return "failed" }
    if status == "waiting_approval" { return "gate" }
    // 试用修复：run 失效（serve 重启清空内存态）/ 历史回放的已中断态
    if status == "missing" { return "missing" }
    if status == "interrupted" { return "missing" }
    return "running"
}


/** 工具条目的操作目标（与聊天侧工具卡口径一致：path/cmd/seq/section/task…）。 */
fn relayToolTarget(entry obj) str {
    let a = entry.arguments ?? {}
    if a.path != None { return relayClipText(a.path, 60) }
    if a.cmd != None { return relayClipText(a.cmd, 60) }
    if a.seq != None { return "plan " + a.seq }
    if a.section_id != None { return a.section_id }
    if a.query != None { return relayClipText(a.query, 60) }
    if a.pattern != None { return relayClipText(a.pattern, 60) }
    return ""
}

fn relayClipText(s str, n int) str {
    if s.length > n {
        return s.substring(0, n - 1) + "…"
    }
    return s
}


/** 收起态预览行（最多 3 行，旧→新排列）：最新为流式文本/思考时取其尾部 3 行；
 * 否则取最近 3 条动态各一行。行对象结构见 relayEntryPreviewRow（定义于
 * 阶段 Log 行一节，与阶段行共用中文标签口径）。 */
fn relayPreviewLines(entries Value) Value {
    let rows = entries ?? []
    let out list = []
    // 找最新一条可展示 entry（工具或带内容）
    var latest Value = None
    var i int = rows.length - 1
    while i >= 0 {
        let ty = rows[i].type ?? ""
        let c = rows[i].content ?? ""
        if ty == "tool" || ty == "tool_call" || c != "" {
            latest = rows[i]
            i = -1
        } else {
            i = i - 1
        }
    }
    if latest == None { return out }
    let lty = latest.type ?? ""
    if lty == "text" || lty == "thinking" {
        // 流式文本：尾部 3 个非空行
        let lines = (latest.content ?? "").split("\n")
        let tail list = []
        var j int = lines.length - 1
        while j >= 0 {
            if lines[j] != "" {
                tail.push(lines[j])
                if tail.length >= 3 { j = -1 } else { j = j - 1 }
            } else {
                j = j - 1
            }
        }
        var k int = tail.length - 1
        while k >= 0 {
            let ln = tail[k]
            if ln.length > 100 {
                out.push({ mark: "", name: "", target: "", text: "…" + ln.substring(ln.length - 100), text_class: "preview-text" })
            } else {
                out.push({ mark: "", name: "", target: "", text: ln, text_class: "preview-text" })
            }
            k = k - 1
        }
        return out
    }
    // 其它：最近 3 条动态
    let items list = []
    var m int = rows.length - 1
    while m >= 0 {
        let row = relayEntryPreviewRow(rows[m])
        if row != None {
            items.push(row)
            if items.length >= 3 { m = -1 } else { m = m - 1 }
        } else {
            m = m - 1
        }
    }
    var n int = items.length - 1
    while n >= 0 {
        out.push(items[n])
        n = n - 1
    }
    return out
}

/** 步骤 id → 中文标签（进度悬浮列表用）。 */
fn relayStepLabel(id str) str {
    let labels map = {
        "plan": "方案制定", "execute": "计划执行", "review": "审查验收", "document": "文档沉淀"
    }
    return labels[id] ?? id
}

/** 'Step "xxx"' / "Step 'xxx'" → xxx（双引号=SSE 实时路径，单引号=会话
 * 回放路径——两种都收，否则回放视图抽不出阶段名）。 */
fn relayStepIdOf(content str) str {
    let dq = content.indexOf("\"")
    let sq = content.indexOf("'")
    var start int = -1
    var q str = "\""
    if dq != -1 {
        start = dq
        q = "\""
    }
    if sq != -1 {
        if start == -1 || sq < start {
            start = sq
            q = "'"
        }
    }
    if start == -1 { return "" }
    let rest = content.substring(start + 1)
    let e = rest.indexOf(q)
    if e == -1 { return rest }
    return rest.substring(0, e)
}

/** 分割线标签（阶段/门禁/终态统一口径）：step_* 用中文阶段名。 */
fn relayDividerLabel(ty str, content str) str {
    if ty == "step_started" || ty == "step_completed" {
        let sid = relayStepIdOf(content)
        return relayStepLabel(sid)
    }
    if ty == "gate_waiting" { return "等待审批" }
    if ty == "run_completed" { return "Run 完成" }
    if ty == "run_failed" || ty == "error" { return relayClipText(content, 70) }
    return relayClipText(content, 70)
}

// ─── 阶段 Log 行（PLAN-031 批次四：[icon][类型·着色][阶段名][动作][短尾线]）───

/** entry.type → 阶段行类型标签（阶段/审批/Run）。 */
fn relayPhaseKind(ty str) str {
    if ty == "step_started" || ty == "step_completed" { return "阶段" }
    if ty == "gate_waiting" { return "审批" }
    if ty == "run_completed" { return "Run" }
    return "事件"
}

/** entry.type → 动作词（开始/完成/等待/失败）。 */
fn relayPhaseAction(ty str) str {
    if ty == "step_started" { return "开始" }
    if ty == "step_completed" { return "完成" }
    if ty == "gate_waiting" { return "等待" }
    if ty == "run_completed" { return "完成" }
    if ty == "run_failed" { return "失败" }
    return "记录"
}

/** entry.type → 阶段行 icon。 */
fn relayPhaseIcon(ty str) str {
    if ty == "step_started" { return "▶" }
    if ty == "step_completed" { return "✓" }
    if ty == "gate_waiting" { return "⏸" }
    if ty == "run_completed" { return "✅" }
    if ty == "run_failed" { return "✗" }
    return "•"
}

/** 阶段行配色 class：phase-line + ph-{kind}（类型着色：阶段蓝/审批琥珀/完成绿/失败红）。 */
fn relayPhaseClass(ty str) str {
    if ty == "step_started" { return "phase-line ph-step" }
    if ty == "step_completed" { return "phase-line ph-step done" }
    if ty == "gate_waiting" { return "phase-line ph-gate" }
    if ty == "run_completed" { return "phase-line ph-done" }
    if ty == "run_failed" || ty == "error" { return "phase-line ph-fail" }
    return "phase-line ph-step"
}

/** 阶段行文本：step 与 gate 类型用阶段名（Gate 与 Step 同构解析）；错误显示摘要。 */
fn relayPhaseText(ty str, content str) str {
    if ty == "step_started" || ty == "step_completed" {
        return relayStepLabel(relayStepIdOf(content))
    }
    if ty == "gate_waiting" {
        let gid = relayStepIdOf(content)
        if gid != "" { return relayStepLabel(gid) }
        return ""
    }
    if ty == "run_failed" || ty == "error" { return relayClipText(content, 60) }
    return ""
}

/** 阶段块可展开详情：
 *  - step_completed：'Step "x" completed: <handoff 摘要>' 冒号后摘要；
 *  - gate_waiting：审批点的确定性说明（标题栏已示阶段名）；
 *  其余类型无详情（返回 ""）。 */
fn relayPhaseDetail(ty str, content str) str {
    if ty == "step_completed" {
        let marker = "completed:"
        let i = content.indexOf(marker)
        if i == -1 { return "" }
        return content.substring(i + marker.length).trim()
    }
    if ty == "gate_waiting" {
        let gid = relayStepIdOf(content)
        if gid == "" { return "" }
        let glabel = relayStepLabel(gid)
        return "阶段「" + glabel + "」开始前的人工审批点：批准后流程继续执行；拒绝将附修改意见回到该阶段。"
    }
    return ""
}

/** 收起态预览行的阶段/终态条目 → 与 Run 内阶段块标题栏同构的紧凑行
 *（着色 mark + 阶段名 + 着色动作；不带详情）。 */
fn relayEntryPreviewRow(e Value) Value {
    let ty = e.type ?? ""
    if ty == "tool" || ty == "tool_call" {
        return { mark: "🔧", mark_class: "", name: e.tool_name ?? "", target: relayToolTarget(e), text: "", text_class: "" }
    }
    let c = e.content ?? ""
    if ty == "step_started" {
        return { mark: "▶", mark_class: "pm-info", name: relayPhaseText(ty, c), target: "", text: "开始", text_class: "preview-act-info" }
    }
    if ty == "step_completed" {
        return { mark: "✓", mark_class: "pm-ok", name: relayPhaseText(ty, c), target: "", text: "完成", text_class: "preview-act-ok" }
    }
    if ty == "gate_waiting" {
        return { mark: "⏸", mark_class: "pm-warn", name: "", target: "", text: "等待审批", text_class: "preview-act-warn" }
    }
    if ty == "run_completed" {
        return { mark: "✅", mark_class: "pm-ok", name: "Run", target: "", text: "完成", text_class: "preview-act-ok" }
    }
    if ty == "run_failed" || ty == "error" {
        return { mark: "❌", mark_class: "pm-err", name: "", target: "", text: relayClipText(c, 70), text_class: "preview-act-err" }
    }
    // turn 级噪音不进预览
    if ty == "complete" || ty == "budget_warning" || ty == "budget_exceeded" { return None }
    if c == "" { return None }
    if ty == "thinking" { return { mark: "💭", mark_class: "", name: "", target: "", text: relayClipText(c, 90), text_class: "preview-text" } }
    return { mark: "", mark_class: "", name: "", target: "", text: relayClipText(c, 100), text_class: "preview-text" }
}

/** 工具卡是否为"文档读取型"（📄 图标 + 结果按 Markdown 展示于展开子窗，
 * 字号小一号）：读类工具或结果较长。 */
fn relayToolIsDocKind(entry Value) bool {
    let n = entry.tool_name ?? ""
    if n == "read_plan" || n == "read_file" || n == "list_plans" || n == "get_plan" {
        return true
    }
    let r = entry.result ?? ""
    return r.length > 400
}

// ─── 工具展开视图（PLAN-031 批次八：按工具类型分形态展示）─────────────────

/** 工具显示名（run_command/shell → cmd）。 */
fn relayToolDisplayName(name str) str {
    if name == "run_command" || name == "shell" { return "cmd" }
    return name
}

/** 路径 → 代码块语言（fenced markdown 高亮用）。 */
fn relayLangOf(path str) str {
    if path.ends_with(".rs") { return "rust" }
    if path.ends_with(".ts") { return "typescript" }
    if path.ends_with(".vue") { return "vue" }
    if path.ends_with(".js") { return "javascript" }
    if path.ends_with(".json") { return "json" }
    if path.ends_with(".md") { return "markdown" }
    if path.ends_with(".css") { return "css" }
    if path.ends_with(".html") { return "html" }
    if path.ends_with(".py") { return "python" }
    if path.ends_with(".sh") || path.ends_with(".ps1") { return "shell" }
    if path.ends_with(".toml") { return "toml" }
    if path.ends_with(".yaml") || path.ends_with(".yml") { return "yaml" }
    return ""
}

/** list_dir（"name <dir>"/"name <file NB>"）/ glob（裸路径）结果 →
 * 文件浏览清单条目 [{is_dir, name, size}]。 */
fn relayParseListing(result str) Value {
    let out list = []
    let lines = result.split("\n")
    var i int = 0
    while i < lines.length {
        let ln = lines[i].trim()
        if ln != "" {
            if ln.contains(" <dir>") {
                out.push({ is_dir: true, name: ln.substring(0, ln.length - 6), size: "" })
            } else {
                if ln.contains(" <file ") {
                    let ci = ln.indexOf(" <file ")
                    let name = ln.substring(0, ci)
                    let sz = ln.substring(ci + 7)
                    if sz.ends_with(">") { sz = sz.substring(0, sz.length - 1) }
                    out.push({ is_dir: false, name: name, size: sz })
                } else {
                    out.push({ is_dir: false, name: ln, size: "" })
                }
            }
        }
        i = i + 1
    }
    return out
}

/** 工具条目 → 展开视图（统一键集，模板按 kind 分支）：
 *  cmd（终端块）/ diff（左右对照）/ write（写入内容）/ file（读取内容+
 *  参数 chips）/ listing（文件浏览）/ doc（文档 Markdown）/ generic。 */
fn relayToolView(entry Value) Value {
    let n = entry.tool_name ?? ""
    let a = entry.arguments ?? {}
    let r = entry.result ?? ""
    if n == "run_command" || n == "shell" {
        return { kind: "cmd", cmd: a.cmd ?? a.command ?? "", force: a.force == true, path: "", old_s: "", new_s: "", content: "", body: "", items: [], chips: [], result: r }
    }
    if n == "edit_file" || n == "update_file" || n == "replace" {
        if a.old_string != None {
            return { kind: "diff", cmd: "", force: false, path: a.path ?? "", old_s: a.old_string ?? "", new_s: a.new_string ?? "", content: "", body: "", items: [], chips: [], result: r }
        }
    }
    if n == "write_file" {
        return { kind: "write", cmd: "", force: false, path: a.path ?? "", old_s: "", new_s: "", content: a.content ?? "", body: "", items: [], chips: [], result: r }
    }
    if n == "read_file" {
        // 参数里除 path 外的读取范围类参数 → chips（行号/起止等）
        let chips list = []
        var ks list = ["offset", "limit", "start", "end", "line", "lines", "from", "to", "anchor", "until"]
        var ki int = 0
        while ki < ks.length {
            let k = ks[ki]
            if a[k] != None { chips.push({ label: k + ": " + a[k] }) }
            ki = ki + 1
        }
        return { kind: "file", cmd: "", force: false, path: a.path ?? "", old_s: "", new_s: "", content: "", body: r, items: [], chips: chips, result: r }
    }
    if n == "list_dir" || n == "glob" {
        let base = a.path ?? ""
        if base == "" { base = a.pattern ?? "" }
        return { kind: "listing", cmd: "", force: false, path: base, old_s: "", new_s: "", content: "", body: "", items: relayParseListing(r), chips: [], result: r }
    }
    if relayToolIsDocKind(entry) {
        return { kind: "doc", cmd: "", force: false, path: "", old_s: "", new_s: "", content: "", body: r, items: [], chips: [], result: r }
    }
    return { kind: "generic", cmd: "", force: false, path: "", old_s: "", new_s: "", content: "", body: "", items: [], chips: [], result: r }
}

/** fenced 代码块文本（Markdown 渲染高亮）。 */
fn relayFenced(lang str, content str) str {
    if lang == "" {
        return "```\n" + content + "\n```"
    }
    return "```" + lang + "\n" + content + "\n```"
}

/** 文本条目 → 文档块视图：PLAN_FILE 行抽为独立文件 chip；正文 ≥600 字符
 * 或含 PLAN_FILE → 折叠文档块（头部标题=首个 # 标题，展开渲染 Markdown）。 */
fn relayTextPlanFile(content str) str {
    let lines = content.split("\n")
    var i int = 0
    while i < lines.length {
        if lines[i].trim().starts_with("PLAN_FILE:") {
            return lines[i].trim().substring(10).trim()
        }
        i = i + 1
    }
    return ""
}

fn relayTextBody(content str) str {
    let lines = content.split("\n")
    var body str = ""
    var i int = 0
    while i < lines.length {
        if lines[i].trim().starts_with("PLAN_FILE:") == false {
            body = body + lines[i] + "\n"
        }
        i = i + 1
    }
    if body == "\n" { return "" }
    if body.length > 0 { return body.substring(0, body.length - 1) }
    return body
}

fn relayIsDoc(content str) bool {
    if relayTextPlanFile(content) != "" { return true }
    return relayTextBody(content).length > 600
}

fn relayDocTitle(content str) str {
    let lines = content.split("\n")
    var i int = 0
    while i < lines.length {
        let ln = lines[i].trim()
        if ln.starts_with("# ") {
            let t = ln.substring(2).trim()
            if t != "" { return relayClipText(t, 56) }
        }
        i = i + 1
    }
    return "文档"
}

/** 徽标显示的 1-based 步骤位置（后端 current_step 是 0-based"即将执行"索引；
 * 完成态钉在 total，避免越界显示 total+1）。 */
fn relayBadgePos(cur int, total int, status str) int {
    if total <= 0 { return 0 }
    if status == "completed" { return total }
    if cur + 1 > total { return total }
    return cur + 1
}

/** run.steps → 进度视图行（悬浮列表 + 迷你分段条共用）：
 * {label, mark, seg_class, mark_class}——class 串在 fn 里拼好，
 * 模板只做字段绑定。失败 run 的当前步后端标 pending，这里按 status 修正为 ✗。 */
fn relayStepViews(steps Value, current int, status str) Value {
    let out list = []
    var idx int = 0
    for st in (steps ?? []) {
        var cls str = "pending"
        var mark str = "○"
        if idx < current {
            cls = "done"
            mark = "✓"
        }
        if idx == current {
            if status == "completed" {
                cls = "done"
                mark = "✓"
            }
            if status == "running" {
                cls = "active"
                mark = "▶"
            }
            if status == "waiting_approval" {
                cls = "gate"
                mark = "⏸"
            }
            if status == "failed" {
                cls = "failed"
                mark = "✗"
            }
        }
        out.push({
            label: relayStepLabel(st.id ?? ""),
            mark: mark,
            seg_class: "seg " + cls,
            mark_class: "pop-mark " + cls
        })
        idx = idx + 1
    }
    return out
}

/** 职业→图标。 */
fn relayProfessionIcon(id str) str {
    let icons map = {
        "assistant": "📥", "advisor": "💡", "architect": "🏗️", "planner": "📝",
        "coder": "💻", "tester": "🧪", "reviewer": "🔍", "documenter": "📚",
        "plan-dev": "📝"
    }
    return icons[id] ?? "⚙️"
}

/** run_completed 载荷（snake_case）→ ReportCard props（camelCase + 默认值）。 */
fn relayReportView(r Value) Value {
    return {
        runId: r.run_id ?? "",
        title: r.title ?? "",
        summary: r.summary ?? "",
        goalsMet: r.goals_met ?? "—",
        testsPass: r.tests_pass ?? "—",
        driftDetected: r.drift_detected ?? "None",
        cost: r.cost ?? "—",
        confidence: r.confidence ?? "Medium",
        deliverables: r.deliverables ?? [],
        filesChanged: r.files_changed ?? [],
        toolCalls: r.tool_calls ?? 0,
        durationS: r.duration_s ?? 0
    }
}

/** run?.title || runId。 */
fn relayRunTitle(run obj, runId str) str {
    if run == None { return runId }
    return run.title || runId
}

/** run?.waiting_for_gate（None 安全）。 */
fn relayWaitingGate(run obj) obj {
    if run == None { return None }
    return run.waiting_for_gate ?? None
}

/** entry-<type> class。 */
fn relayEntryClass(entryType str) str {
    return "log-entry entry-" + entryType
}

/** run 的会话日志条目（无则空数组）。 */
fn relaySessionLogFor(logs obj, runId str) obj {
    return logs[runId] ?? []
}

// ─── 工具视图访问器（模板调用实参必须带字段访问——裸变量实参解析失败，
//     故全部走 (tool_name, arguments, result) 字段形参）───

fn relayTVKind(n str, a Value, r str) str { return relayToolView({ tool_name: n, arguments: a, result: r }).kind }
fn relayTVCmdOf(a Value) str {
    if a == None { return "" }
    return a.cmd ?? a.command ?? ""
}
fn relayTVForceOf(a Value) bool {
    if a == None { return false }
    return a.force == true
}
fn relayTVPathOf(a Value) str {
    if a == None { return "" }
    let p = a.path ?? ""
    if p != "" { return p }
    return a.pattern ?? ""
}
fn relayTVOldOf(a Value) str {
    if a == None { return "" }
    return a.old_string ?? ""
}
fn relayTVNewOf(a Value) str {
    if a == None { return "" }
    return a.new_string ?? ""
}
fn relayTVContentOf(a Value) str {
    if a == None { return "" }
    return a.content ?? ""
}

fn relayToolView3(n str, a Value, r str) Value {
    return relayToolView({ tool_name: n, arguments: a, result: r })
}

/** cmd 结果是否为错误：PAUSED 拦截 / 框架 [tool error: ...] / 非零退出码
 *（RunCommand 对失败命令追加 [exit: N]）。 */
fn relayCmdIsError(r str) bool {
    if r.starts_with("PAUSED") { return true }
    if r.contains("[tool error:") { return true }
    let i = r.indexOf("[exit: ")
    if i == -1 { return false }
    let rest = r.substring(i + 7)
    let j = rest.indexOf("]")
    if j == -1 { return false }
    let code = rest.substring(0, j)
    return code != "0"
}

/** cmd 结果块 class：错误态红底红字。 */
fn relayCmdResultClass(r str) str {
    if relayCmdIsError(r) { return "tool-result tv-err" }
    return "tool-result"
}

/** cmd 结果文本：错误态统一红色 Error: 前缀。 */
fn relayCmdResultText(r str) str {
    if relayCmdIsError(r) { return "Error: " + r }
    return r
}

/** 模板 text 位不支持"字符串 + fn 调用"——终端行与代码块包装。 */
fn relayTVCmdLine(a Value) str {
    return "$ " + relayTVCmdOf(a)
}

/** write_file：args → fenced 代码块（语言按路径推断）。 */
fn relayWriteFence(a Value) str {
    return relayFenced(relayLangOf(relayTVPathOf(a)), relayTVContentOf(a))
}

/** read_file：args+result → fenced 代码块。 */
fn relayFileFence(a Value, r str) str {
    return relayFenced(relayLangOf(relayTVPathOf(a)), r)
}
