// relay_run_helpers.at — RelayRunBox 纯渲染 helpers（替代 relay_run_helpers.ts 的纯函数部分）
//
// Plan 028 T12（M3）：F1 字典承载 statusLabel/professionIcon；`??`/`||` 兜底。
// 订阅/加载/审批 6 个 useRelay 依赖 fn 仍在 relay_run_helpers.ts —— 待 T16
// relay_store.at（F8 平台协议）落地后并入。

/** 在当前 run 或 runs 列表里找 run（currentRun 优先 + find 兜底；
 * 严格按 runId 匹配——找不到返回 None（历史回放/失效态由调用方处理）。 */
fn relayFindRun(runs obj, currentRun obj, runId str) obj {
    if currentRun != None {
        if currentRun.run_id == runId { return currentRun }
    }
    let found = runs.find(r => r.run_id == runId)
    return found ?? None
}

/** 状态→中文标签。 */
fn relayStatusLabel(status str) str {
    let labels map = {
        "running": "运行中", "completed": "已完成", "failed": "失败",
        "waiting_approval": "待审批", "idle": "就绪", "paused": "已暂停",
        "interrupted": "已中断"
    }
    let out = labels[status] ?? status
    if out == None { return "..." }
    return out
}

/** 状态→class 段（completed/failed/gate/running）。 */
fn relayStatusClass(status str) str {
    if status == "completed" { return "completed" }
    if status == "failed" { return "failed" }
    if status == "waiting_approval" { return "gate" }
    // 试用修复：run 失效（serve 重启清空内存态）/ 历史回放的已中断态
    if status == "missing" { return "missing" }
    if status == "interrupted" { return "missing" }
    return "running"
}


/** 工具条目的操作目标（与聊天侧工具卡口径一致：path/cmd/seq/section/task…）。 */
fn relayToolTarget(entry obj) str {
    let a = entry.arguments ?? {}
    if a.path != None { return relayClipText(a.path, 60) }
    if a.cmd != None { return relayClipText(a.cmd, 60) }
    if a.seq != None { return "plan " + a.seq }
    if a.section_id != None { return a.section_id }
    if a.query != None { return relayClipText(a.query, 60) }
    if a.pattern != None { return relayClipText(a.pattern, 60) }
    return ""
}

fn relayClipText(s str, n int) str {
    if s.length > n {
        return s.substring(0, n - 1) + "…"
    }
    return s
}


/** 单条日志 → 预览行对象 {mark, name, target, text, text_class}
 *（工具行 name+target 分色——对齐 Block 头 tool-name/tool-target 口径；
 *  无可展示内容返回 None）。 */
fn relayEntryPreviewRow(e Value) Value {
    let ty = e.type ?? ""
    if ty == "tool" || ty == "tool_call" {
        return { mark: "🔧", name: e.tool_name ?? "", target: relayToolTarget(e), text: "", text_class: "" }
    }
    let c = e.content ?? ""
    if c == "" { return None }
    if ty == "step_started" { return { mark: "▶", name: "", target: "", text: c, text_class: "preview-text" } }
    if ty == "step_completed" { return { mark: "✓", name: "", target: "", text: c, text_class: "preview-ok" } }
    if ty == "gate_waiting" { return { mark: "⏸", name: "", target: "", text: c, text_class: "preview-warn" } }
    if ty == "run_completed" { return { mark: "✅", name: "", target: "", text: c, text_class: "preview-ok" } }
    if ty == "run_failed" || ty == "error" { return { mark: "❌", name: "", target: "", text: c, text_class: "preview-err" } }
    // turn 级噪音不进预览
    if ty == "complete" || ty == "budget_warning" || ty == "budget_exceeded" { return None }
    if ty == "thinking" { return { mark: "💭", name: "", target: "", text: relayClipText(c, 90), text_class: "preview-text" } }
    return { mark: "", name: "", target: "", text: relayClipText(c, 100), text_class: "preview-text" }
}

/** 收起态预览行（最多 3 行，旧→新排列）：最新为流式文本/思考时取其尾部 3 行；
 * 否则取最近 3 条动态各一行。行对象结构见 relayEntryPreviewRow。 */
fn relayPreviewLines(entries Value) Value {
    let list = entries ?? []
    let out list = []
    // 找最新一条可展示 entry（工具或带内容）
    var latest Value = None
    var i int = list.length - 1
    while i >= 0 {
        let ty = list[i].type ?? ""
        let c = list[i].content ?? ""
        if ty == "tool" || ty == "tool_call" || c != "" {
            latest = list[i]
            i = -1
        } else {
            i = i - 1
        }
    }
    if latest == None { return out }
    let lty = latest.type ?? ""
    if lty == "text" || lty == "thinking" {
        // 流式文本：尾部 3 个非空行
        let lines = (latest.content ?? "").split("\n")
        let tail list = []
        var j int = lines.length - 1
        while j >= 0 {
            if lines[j] != "" {
                tail.push(lines[j])
                if tail.length >= 3 { j = -1 } else { j = j - 1 }
            } else {
                j = j - 1
            }
        }
        var k int = tail.length - 1
        while k >= 0 {
            let ln = tail[k]
            if ln.length > 100 {
                out.push({ mark: "", name: "", target: "", text: "…" + ln.substring(ln.length - 100), text_class: "preview-text" })
            } else {
                out.push({ mark: "", name: "", target: "", text: ln, text_class: "preview-text" })
            }
            k = k - 1
        }
        return out
    }
    // 其它：最近 3 条动态
    let items list = []
    var m int = list.length - 1
    while m >= 0 {
        let row = relayEntryPreviewRow(list[m])
        if row != None {
            items.push(row)
            if items.length >= 3 { m = -1 } else { m = m - 1 }
        } else {
            m = m - 1
        }
    }
    var n int = items.length - 1
    while n >= 0 {
        out.push(items[n])
        n = n - 1
    }
    return out
}

/** 步骤 id → 中文标签（进度悬浮列表用）。 */
fn relayStepLabel(id str) str {
    let labels map = {
        "plan": "方案", "execute": "执行", "review": "审查", "document": "文档"
    }
    return labels[id] ?? id
}

/** 徽标显示的 1-based 步骤位置（后端 current_step 是 0-based"即将执行"索引；
 * 完成态钉在 total，避免越界显示 total+1）。 */
fn relayBadgePos(cur int, total int, status str) int {
    if total <= 0 { return 0 }
    if status == "completed" { return total }
    if cur + 1 > total { return total }
    return cur + 1
}

/** run.steps → 进度视图行（悬浮列表 + 迷你分段条共用）：
 * {label, mark, seg_class, mark_class}——class 串在 fn 里拼好，
 * 模板只做字段绑定。失败 run 的当前步后端标 pending，这里按 status 修正为 ✗。 */
fn relayStepViews(steps Value, current int, status str) Value {
    let out list = []
    var idx int = 0
    for st in (steps ?? []) {
        var cls str = "pending"
        var mark str = "○"
        if idx < current {
            cls = "done"
            mark = "✓"
        }
        if idx == current {
            if status == "completed" {
                cls = "done"
                mark = "✓"
            }
            if status == "running" {
                cls = "active"
                mark = "▶"
            }
            if status == "waiting_approval" {
                cls = "gate"
                mark = "⏸"
            }
            if status == "failed" {
                cls = "failed"
                mark = "✗"
            }
        }
        out.push({
            label: relayStepLabel(st.id ?? ""),
            mark: mark,
            seg_class: "seg " + cls,
            mark_class: "pop-mark " + cls
        })
        idx = idx + 1
    }
    return out
}

/** 职业→图标。 */
fn relayProfessionIcon(id str) str {
    let icons map = {
        "assistant": "📥", "advisor": "💡", "architect": "🏗️", "planner": "📝",
        "coder": "💻", "tester": "🧪", "reviewer": "🔍", "documenter": "📚",
        "plan-dev": "📝"
    }
    return icons[id] ?? "⚙️"
}

/** run_completed 载荷（snake_case）→ ReportCard props（camelCase + 默认值）。 */
fn relayReportView(r Value) Value {
    return {
        runId: r.run_id ?? "",
        title: r.title ?? "",
        summary: r.summary ?? "",
        goalsMet: r.goals_met ?? "—",
        testsPass: r.tests_pass ?? "—",
        driftDetected: r.drift_detected ?? "None",
        cost: r.cost ?? "—",
        confidence: r.confidence ?? "Medium",
        deliverables: r.deliverables ?? [],
        filesChanged: r.files_changed ?? [],
        toolCalls: r.tool_calls ?? 0,
        durationS: r.duration_s ?? 0
    }
}

/** run?.title || runId。 */
fn relayRunTitle(run obj, runId str) str {
    if run == None { return runId }
    return run.title || runId
}

/** run?.waiting_for_gate（None 安全）。 */
fn relayWaitingGate(run obj) obj {
    if run == None { return None }
    return run.waiting_for_gate ?? None
}

/** entry-<type> class。 */
fn relayEntryClass(entryType str) str {
    return "log-entry entry-" + entryType
}

/** run 的会话日志条目（无则空数组）。 */
fn relaySessionLogFor(logs obj, runId str) obj {
    return logs[runId] ?? []
}
