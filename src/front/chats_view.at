// chats_view.at — Forge 聊天视图（对应 web/src/views/ChatsView.vue）
//
// ChatsView.vue 2767 行：session-sidebar + chats-body(header/canvas/input-bar)。
// Phase 7a: 骨架——session 列表 + 消息列表 + 输入框 + 发送 + 流式 draft。
// Phase 7b: SSE 回写 + 流式 markdown draft。
// Phase 7c: mention + errand/relay/task_plan 内联卡片。
// PLAN-049 T6：会话壳自定义类全量迁内联工具类（双轨收敛,style{} 块删除）。
//   - 消息列表按 role 分支（user/assistant），tool_calls 用 if-else-if 编排 4 类卡片。
//   - 输入框替换为 MentionInput 逃生舱（v-html backdrop 无法 .at 表达）。
//   - 卡片走 use{component} 逃生舱（@click toggle 无法 .at 表达）。

use store: ForgeStore
// #4 回流：会话删除按钮所需的 API 函数。
use back.api: chats_delete_session, chats_delete_all_sessions

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web relay_command_match from "src/front/relay_commands.at"
use.web platformRunRelayCommand from "src/front/ports/platform.at"
use.web.fn extractRunId, isMsgStreaming, messageBlocks, estimateTokens, thinkLabel, isBlockStreaming, msgTimeLabel, toolArgsJson, withExpansion from "src/front/forge_helpers.at"
use.web.fn relayReportView from "src/front/relay_run_helpers.at"
use.web component Markdown from "src/front/ports/renderer.at"
use.web component Copy from "src/front/ports/icons.at"
// PLAN-059 T9 顺手修复:UserMessage 是原生 .at 组件,须走 use 组件别名形态
// （codegen 导入已生成的 @/components/UserMessage.vue）——4700cdc 内联化时
// 误用 use.web 指向 .at 源模块,ext 镜像无此 ts 模块,vue-tsc TS2305 拦截。
use user_message: UserMessage
use.web.fn chatSearchFilter, chatLastMessageId, chatBranchLabel, chatBranchEntries, chatActivePath from "src/front/forge_helpers.at"
// PLAN-051 T8: SendInput 净空口径统一（原 .send(mention_trim(.text)) 调用位
// 形态，实参内移后宿主侧复用同一 helper）。
use.web.fn mention_trim from "src/front/mention_helpers.at"
use.web getQuestions, hasQuestionnaire from "src/front/questionnaire.at"
use.web questionnaireSingleChecked, questionnaireMultiChecked, questionnaireToggleAnswer, questionnaireOtherKey, questionnaireCanSubmit, questionnairePlaceholder from "src/front/questionnaire_helpers.at"
use.web component Plus, Trash2, Search, Info from "src/front/ports/icons.at"
use.web useT from "src/front/ports/composables.at"
// PLAN-059 T9:删除确认切 alert-dialog 单源双轨——533 浮层通道合回后
// （a2r codegen alert-dialog 家族臂 + child_emit 大小写折叠,gallery
// /alertdialog 编译轨四断言过）,VM 渲染真模态、onconfirm/oncancel 派发
// 直达本视图 handler。PLAN-058 三期的 web 薄适配器（DeleteConfirmDialog.vue,
// 已删除）与 VM 内联确认行（web CSS .session-delete-strip 抑制,已删除）
// 一并退役——单源单实现。

// PLAN-037 P1: cross-file component refs (native alias form).
use mention_input: MentionInput
use nav_sidebar: NavSidebar
use nav_item: NavListItem
use content_header: ContentHeader
use mention_dropdown: MentionDropdown
use relay_run_box: RelayRunBox
use questionnaire_card: QuestionnaireCard
use gate_card: GateCard
use secretary_message_wrapper: SecretaryMessageWrapper
use secretary_message: SecretaryMessage
use session_info: SessionInfo

widget ChatsView {

    setup {
        let t = useT()
    }

    msg Msg {
        Init,
        NewSession,
        OnSearchInput(str),
        // PLAN-058: 删除两步确认——Ask* 只置 pending，Confirm* 才真正调删除
        // API（替代原 DeleteSession/DeleteAllSessions 直删）。
        AskDelete(str),
        AskDeleteAll,
        CancelDelete,
        ConfirmDelete(str),
        SelectSession(str),
        SendInput(str),
        StopStream,
        ApproveGate,
        RejectGate,
        SecretaryApprove,
        SecretaryReject,
        SecretarySnooze,
        OnQuestionnaireSubmit(str),
        // PLAN-043 补遗:分支切换事件（043 只加了视图调用,漏了 msg 声明——
        // 旧 CLI 解析失败被 stale gen 掩盖,新 CLI 重建时暴露为 0 参 emit）。
        // PLAN-055 ⑤: RetryFrom 随"⑂ 重试"按钮删除（孤儿清理）。
        BranchTo(str, str),
        // 2026-09-03:会话卡 × hover 显隐（mouse-area 命中区驱动;web 侧
        // CSS .session-item:hover 双保险,语义一致）。
        HoverSession(str),
        HoverSessionClear,
        // 消息卡展开/copy(内联后为本视图消息;冻结实参沿 HoverSession 先例)。
        ToggleThink(str),
        ToolToggleKey(str),
        CopyMessageContent(str),
    }

    model {
        var input str = ""
        var sidebar_collapsed bool = false
        var chat_search str = ""
        // PLAN-058: 待确认删除目标（会话 id 或 "__all__"；空串=无待确认）。
        // 沿 chat_search 先例的视图态 str 字段（VM 对 str 字段 SET/比较双轨实证）。
        var delete_pending_id str = ""
        // PLAN-058 三期:alert-dialog 受控 open（web 侧 v-model:open 需
        // state_ref bool——字面量/表达式会让整树退化成 div,vue.rs:10863）。
        var delete_confirm_open bool = false
        // 2026-09-03:当前 hover 的会话 id(× 按钮显隐;空串=无 hover)。
        var hover_session_id str = ""
        // 消息卡展开态(顶层 own-state;子件 prop 快照/handler 写 prop 双缺陷
        // 的绕行——renderMsgs computed 并入消息克隆,视图读纯 dot 路径)。
        var msg_think_open str = ""
        var msg_tool_open str = ""
    }

    // Plan 028 T15：搜索过滤（原 useChatSearch composable → F2 多参 fn 直调）
    computed {
        // PLAN-043: 先按活跃路径投影再套搜索过滤。
        filteredMessages => chatSearchFilter(chatActivePath(.store.messages, .store.active_leaf), .chat_search)
        lastMsgId => chatLastMessageId(.filteredMessages)
        // PLAN-043: 分叉切换器数据（for-in 迭代器仅支持纯 dot 路径,fn 调用与
        // 动态索引均破坏 UI parser——扁平 {for_id, sib} 条目在此预算,视图按
        // for_id 相等匹配渲染兄弟按钮）。
        branchEntries => chatBranchEntries(.store.messages)
        // 消息渲染列表:克隆消息并入展开态/流式标志/有序块——视图循环读纯
        // dot 路径(for-in 源限 dot 路径),展开切换=own-state 写→computed 重算。
        // 【2026-09-04 二修】msgs 改传 store 原生列表——filteredMessages 是
        // computed 构建列表,穿 fn 边界后 for-in 零迭代(051 T8 返回值错位族,
        // 探针实证 len=3 而 body 0 次执行)。搜索过滤暂让位渲染正确性,
        // chatActivePath/搜索过滤损失挂账 536 同族。
        renderMsgs => withExpansion({ list: .store.messages })
    }

    // PLAN-049 T6：branch-row/branch-btn/retry-btn 已迁视图内联工具类（块删除）。
    view {
        row {
            style: "flex flex-row h-full overflow-hidden"
            // Session Sidebar（Plan 023 §3.1：共用 NavSidebar——header + list slot）
            NavSidebar {
                title: t("chat.sessions")
                collapsed: .sidebar_collapsed
                width_class: "w-[220px]"
                slot(name: "actions") {
                    // Plan 407：lucide 图标作 button 子节点（parser 增强后原生支持）。
                    // PLAN-055: icon-only 方钮（variant="icon" 语义经单源类表达，
                    // 两轨一致——gen 侧 shadcn Button 无 icon variant，VM 侧默认
                    // 预设(紫底 + h-10 px-4)由后置类逐项覆盖）。px-0/py-0 显式
                    // 清预设内边距（414 R13：负内容宽 → 图标不可见）；
                    // text-muted-foreground 双主题自适应（深色下浅色图标）。
                    button {
                        onclick: .NewSession
                        style: "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent border border-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                        title: t("chat.newSession")
                        // 2026-09-03:图标 16→20(用户对拍 VM 图标观感偏小,整体抬档;
                        // web 端 lucide size 同步,两轨一致)。
                        Plus { size: 20 }
                    }
                    button {
                        // PLAN-058: 直删改两步确认；Trash2（use.web，VM 空内容）
                        // 改 "×" 字形——VM 轨可见，消除头部隐形可点删除区。
                        onclick: .AskDeleteAll
                        style: "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent border border-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                        title: t("chat.deleteAllSessions")
                        text "×"
                    }
                }
                slot(name: "list") {
                    col {
                        style: "flex-1 overflow-y-auto px-2"
                        // PLAN-059 T9:VM 内联确认行暂返场兜底——解释器轨对
                        // ChatsView 上下文的 alert-dialog open 绑定不渲染
                        // （四个形态探针全灭:根位/字面量/空 trigger;gallery
                        // 同模式同形态可渲染,D-GAP 深水区,归 auto-lang 536
                        // 候补）。web 轨 CSS .session-delete-strip 抑制不变,
                        // 走上方 alert-dialog;解释器修复后本行退役。
                        if .delete_confirm_open {
                            row {
                                style: "session-delete-strip flex items-center gap-2 w-full px-1 py-1.5 mb-1"
                                if .delete_pending_id == "__all__" {
                                    span {
                                        style: "text-xs text-destructive"
                                        text t("chat.confirmDeleteAll")
                                    }
                                }
                                if .delete_pending_id != "__all__" {
                                    span {
                                        style: "text-xs text-destructive"
                                        text t("chat.confirmDeleteSession")
                                    }
                                }
                                span {
                                    style: "text-xs font-medium text-destructive border border-destructive/40 rounded px-1.5 py-0.5 cursor-pointer hover:bg-destructive/10"
                                    onclick.stop: .ConfirmDelete(.delete_pending_id)
                                    text t("chat.confirmDelete")
                                }
                                span {
                                    style: "text-xs text-muted-foreground border border-border rounded px-1.5 py-0.5 cursor-pointer hover:bg-accent"
                                    onclick.stop: .CancelDelete
                                    text t("chat.cancel")
                                }
                            }
                        }
                        for s in .store.session_list {
                            button {
                                key: .s.id
                                onclick: .SelectSession(.s.id)
                                // PLAN-055 T15: 删 title=.s.id 悬停 tooltip（用户
                                // 对拍 ②a——chat id 对用户无信息量）。
                                class: if .s.id == .store.session_id {
                                    "session-item relative h-auto w-full flex flex-col items-start justify-start gap-0.5 text-left py-2.5 px-3 mb-1.5 rounded-lg border border-primary/25 bg-primary/10 text-primary hover:bg-primary/15 hover:text-primary"
                                } else {
                                    "session-item relative h-auto w-full flex flex-col items-start justify-start gap-0.5 text-left py-2.5 px-3 mb-1.5 rounded-lg border border-transparent bg-card hover:border-border hover:bg-accent text-foreground"
                                }
                                // 标题行 justify-between：× 在标题同排右缘。悬停
                                // 显隐：内容包 mouse-area(Plan 484 hover 命中区,
                                // iced mouse_area on_enter/on_exit / vue div
                                // @mouseenter),进/出事件驱动 hover_session_id,
                                // × 仅 hover 该卡时渲染——web 另有 CSS
                                // .session-item:hover 双保险,两轨语义一致
                                // （用户对拍 2026-09-03:× 须 hover 才现）。
                                mouse-area {
                                    style: "w-full"
                                    onmouseenter: .HoverSession(.s.id)
                                    onmouseleave: .HoverSessionClear
                                    row {
                                        style: "flex items-start justify-between w-full gap-1"
                                        span {
                                            style: if .s.id == .store.session_id {
                                                "text-[13.6px] font-medium text-primary flex-1 min-w-0 break-all leading-[1.45]"
                                            } else {
                                                "text-[13.6px] text-foreground flex-1 min-w-0 break-all leading-[1.45]"
                                            }
                                            text .s.name
                                        }
                                        // PLAN-055 T15/T16 + PLAN-058 两步删除:
                                        // 字形化 ×(Trash2 use.web 在 VM 为空形)+
                                        // AskDelete 二次确认。absolute 类仅 web
                                        // 消费(右上角精放),VM 编译轨不消费、
                                        // 流内承载于标题行右缘。
                                        if .hover_session_id == .s.id {
                                            span {
                                                style: "session-delete-btn absolute right-[4px] top-[4px] w-5 h-5 flex items-center justify-center shrink-0 opacity-40 bg-transparent border-none p-0 text-muted-foreground text-sm leading-none cursor-pointer hover:opacity-100 hover:text-destructive"
                                                onclick.stop: .AskDelete(.s.id)
                                                title: t("chat.deleteSession")
                                                text "×"
                                            }
                                        }
                                    }
                                    row {
                                        style: "flex items-center gap-1 w-full"
                                        span {
                                            style: "text-xs text-muted-foreground"
                                            text t("chat.msgs", { count: .s.message_count })
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Main Chat Area
            col {
                style: "flex-1 flex flex-col min-w-0 overflow-hidden"
                // header（Plan 023 §3.1：共用 ContentHeader——标题 + middle 搜索 + actions）
                ContentHeader {
                    title: t("chat.title")
                    slot(name: "middle") {
                        // 搜索框（居中，对齐原版 .header-search）
                        div {
                            // PLAN-051 P2-③: 补 min-w-[200px] w-[320px]——VM 轨
                            // flex-[0_1_320px] 任意值不支持整类丢弃 → 搜索框塌 0
                            // 被挤压；web 侧仅极窄窗行为微改进（原可压到 0）。
                            style: "flex items-center gap-[5px] max-w-[320px] min-w-[200px] w-[320px] flex-[0_1_320px] px-3 py-1.5 bg-muted-foreground/5 border border-muted-foreground/10 rounded-md text-muted-foreground"
                            Search { size: 16, class: "shrink-0" }
                            input {
                                style: "w-full text-[13px] text-foreground bg-transparent border-none outline-none placeholder:text-muted-foreground"
                                value: .chat_search
                                oninput: .OnSearchInput($event)
                                placeholder: t("chat.searchPlaceholder")
                            }
                        }
                    }
                    slot(name: "actions") {
                        // 右侧 SessionInfo 组件（info icon + tooltip，对齐原版）
                        div {
                            style: "flex items-center gap-[5px] shrink-0"
                            SessionInfo
                        }
                    }
                }
                // canvas（SecretaryMessage/GateCard/ReportCard + 消息列表 + 流式 draft）
                col {
                    style: "flex-1 overflow-y-auto p-4 flex flex-col gap-10"
                    // SecretaryMessageWrapper：gate_reached 触发 useGateInbox.registerGate →
                    // currentSecretary 驱动审批消息条（B 类批4。wrapper 内部 v-if gate 控制显隐）。
                    SecretaryMessageWrapper {
                        onapprove: .SecretaryApprove
                        onreject: .SecretaryReject
                        onsnooze: .SecretarySnooze
                    }
                    // GateCard：gate_reached 事件触发，显示待审批 spec 变更（7.3）
                    if .store.current_gate != None {
                        GateCard {
                            title: ""
                            profession: ""
                            changes: .store.pending_spec_changes
                            onapprove: .ApproveGate
                            onreject: .RejectGate
                        }
                    }
                    // ReportCard：run_completed 事件触发，显示 relay 报告（7.3）
                    if .store.report_data != None {
                        ReportCard {
                            report: .store.report_data
                            deckMeta: None
                            deckHtml: ""
                        }
                    }
                    for rm in .renderMsgs {
                        col {
                            key: .rm.id
                            // PLAN-043: 同分叉点的兄弟分支切换器（PLAN-055 ⑤：
                            // "⑂ 重试"按钮删除——用户对拍裁决，重试语义由分支
                            // 切换器与新发消息承载）。
                            row {
                                style: "flex gap-1 mb-[2px]"
                                for be in .branchEntries {
                                    if be.for_id == .rm.id {
                                        button {
                                            // R006(strict):v-for 项需 :key。
                                            key: be.sib.id
                                            // PLAN-055: 显式高度——VM button 默认
                                            // size 预设 h-10 会把 pill 撑成大块。
                                            style: "text-[11px] h-[22px] py-[1px] px-2 rounded-full border border-border bg-transparent text-muted-foreground cursor-pointer max-w-[160px] truncate"
                                            text "⑂ " + chatBranchLabel(be.sib.content)
                                            onclick: .BranchTo(be.sib.id, "navigate")
                                        }
                                    }
                                }
                            }
                            // 【2026-09-04】消息卡内联（ChatMessage 子件退役）——
                            // VM 子件 prop 构建期快照 + handler 写 prop 崩溃
                            // (Invalid object ID)双缺陷,唯顶层 own-state 全链
                            // 实证可用;展开态走 msg_think_open/msg_tool_open。
                            col {
                                class: if .rm.role == "user" { "flex flex-col gap-[3px] max-w-[85%] self-end items-end" } else { "flex flex-col gap-[5px] self-stretch items-stretch max-w-full" }
                                row {
                                    style: if .rm.role == "user" { "flex items-center gap-2 px-1 justify-end" } else { "flex items-center gap-2 px-1" }
                                    if .rm.role == "user" {
                                        text "🧑 You" { style: "text-[13.6px] font-semibold text-primary" }
                                    } else {
                                        text "🤖 AI" { style: "text-[13.6px] font-semibold text-muted-foreground" }
                                    }
                                    if msgTimeLabel(.rm.created_at) != "" {
                                        text msgTimeLabel(.rm.created_at) { style: "text-xs text-muted-foreground" }
                                    }
                                }
                                if .rm.role == "user" {
                                    col {
                                        style: "msg-bubble-user self-end px-[14px] py-[10px] rounded-xl rounded-br text-[15px] leading-[1.6] break-words bg-primary text-primary-foreground"
                                        UserMessage(content: .rm.content)
                                    }
                                } else {
                                    col {
                                        style: "msg-bubble-ai flex flex-col gap-3 py-[11px] px-[3px] border-t border-b border-border/60"
                                        for block in .rm.blocks {
                                            if .block.kind == "text" {
                                                col {
                                                    style: "px-[2px] py-[1px] bg-transparent border-none text-foreground rounded-none"
                                                    Markdown(source: .block.text, streaming: isBlockStreaming(.rm.streaming, .rm.blocks, .block))
                                                }
                                            } else if .block.kind == "thinking" {
                                                col {
                                                    class: "think-block w-full box-border rounded-lg border border-border bg-muted/40 max-w-full overflow-hidden"
                                                    button {
                                                        onclick: .ToggleThink(.rm.id)
                                                        style: "think-header w-full flex items-center gap-[6px] py-[6px] px-[10px] text-[12.5px] text-muted-foreground cursor-pointer select-none hover:bg-muted/50 border-none bg-transparent text-left"
                                                        text "💭"
                                                        text thinkLabel(estimateTokens(.block.text), .rm.streaming)
                                                        span {
                                                            style: "tool-chevron ml-auto"
                                                            if .msg_think_open == .rm.id {
                                                                text "▲" { style: "text-[11px] text-muted-foreground" }
                                                            } else {
                                                                text "▼" { style: "text-[11px] text-muted-foreground" }
                                                            }
                                                        }
                                                    }
                                                    if .msg_think_open == .rm.id {
                                                        div {
                                                            style: "think-content my-0 py-[9px] px-[12px] text-[13.5px] leading-[1.5] font-mono whitespace-pre-wrap break-words text-muted-foreground max-h-[240px] overflow-y-auto border-t border-border"
                                                            text .block.text
                                                        }
                                                    }
                                                }
                                            } else {
                                                col {
                                                    style: "tool-block-slot w-full"
                                                    if .block.tc.name == "dispatch" {
                                                        ErrandCard {
                                                            tc: .block.tc
                                                            errands: .store.errands
                                                        }
                                                    } else if .block.tc.name == "spawn_relay" {
                                                        if extractRunId(.block.tc) != "" {
                                                            RelayRunBox {
                                                                runId: extractRunId(.block.tc)
                                                            }
                                                        } else {
                                                            col {
                                                                class: "tool-card border border-border rounded-lg w-full"
                                                                row {
                                                                    onclick: .ToolToggleKey(.block.tkey)
                                                                    style: "tool-header flex items-center gap-2 py-[6px] px-[10px] min-w-0 cursor-pointer"
                                                                    text "🔧" { style: "tool-icon text-[14px] leading-none shrink-0" }
                                                                    text .block.tc.name { style: "tool-name flex-1 min-w-0 truncate text-[13.3px] font-medium text-foreground" }
                                                                    text .block.tc.status { style: "tool-status text-[11.7px] font-medium shrink-0 text-blue-500" }
                                                                    if .msg_tool_open == .block.tkey {
                                                                        text "▲" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                                                    } else {
                                                                        text "▼" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    } else if .block.tc.name == "task_plan" {
                                                        TaskPlanCard {
                                                            tc: .block.tc
                                                            taskPlans: .store.task_plans
                                                        }
                                                    } else if .block.tc.name == "report" {
                                                        ReportCard {
                                                            report: relayReportView(.block.tc.arguments)
                                                        }
                                                    } else {
                                                        col {
                                                            class: if .block.tc.status == "failed" { "tool-card failed border border-border rounded-lg w-full" } else { if .block.tc.status == "running" { "tool-card running border border-border rounded-lg w-full" } else { "tool-card completed border border-border rounded-lg w-full" } }
                                                            row {
                                                                onclick: .ToolToggleKey(.block.tkey)
                                                                style: "tool-header flex items-center gap-2 py-[6px] px-[10px] min-w-0 cursor-pointer"
                                                                text "🔧" { style: "tool-icon text-[14px] leading-none shrink-0" }
                                                                text .block.tc.name { style: "tool-name flex-1 min-w-0 truncate text-[13.3px] font-medium text-foreground" }
                                                                for seg in .block.summary {
                                                                    text .seg.text { class: if .seg.type == "path" { "tool-seg seg-path text-[12.5px] font-medium font-mono shrink-0 text-info" } else { if .seg.type == "pattern" { "tool-seg seg-pattern text-[12.5px] font-medium font-mono shrink-0 text-primary" } else { if .seg.type == "desc" { "tool-seg seg-desc text-[12.5px] font-medium font-mono shrink-0 text-foreground" } else { "tool-seg seg-loc text-[12.5px] font-medium font-mono shrink-0 text-muted-foreground" } } } }
                                                                }
                                                                text .block.tc.status { class: if .block.tc.status == "completed" { "tool-status completed text-[11.7px] font-medium shrink-0 text-green-500" } else { if .block.tc.status == "failed" { "tool-status failed text-[11.7px] font-medium shrink-0 text-red-500" } else { "tool-status running text-[11.7px] font-medium shrink-0 text-blue-500" } } }
                                                                if .msg_tool_open == .block.tkey {
                                                                    text "▲" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                                                } else {
                                                                    text "▼" { style: "tool-chevron text-[11px] text-muted-foreground shrink-0" }
                                                                }
                                                            }
                                                            if .msg_tool_open == .block.tkey {
                                                                col {
                                                                    style: "tool-body border-t border-border px-[10px] py-[8px]"
                                                                    col {
                                                                        style: "tool-section mb-[6px]"
                                                                        text "ARGUMENTS" { style: "tool-section-title text-[11.7px] font-medium tracking-wide text-muted-foreground mb-[3px]" }
                                                                        div {
                                                                            style: "tool-code bg-muted-foreground/5 rounded px-[6px] py-[6px] font-mono text-[13.3px] text-muted-foreground whitespace-pre-wrap break-words"
                                                                            text toolArgsJson(.block.tc)
                                                                        }
                                                                    }
                                                                    if .block.tc.result != "" {
                                                                        col {
                                                                            style: "tool-section mb-[6px]"
                                                                            text "RESULT" { style: "tool-section-title text-[11.7px] font-medium tracking-wide text-muted-foreground mb-[3px]" }
                                                                            Markdown(source: .block.tc.result, streaming: false)
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // AI 消息工具栏（copy 靠左,2026-09-03 裁定）。
                                        row {
                                            style: "flex items-center justify-start gap-1 mt-[2px] px-[3px]"
                                            button {
                                                onclick: .CopyMessageContent(.rm.content)
                                                style: "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                                                title: "Copy"
                                                Copy { size: 16 }
                                            }
                                        }
                                    }
                                    if .rm.error != "" {
                                        text .rm.error { style: "text-destructive text-[14px] py-2 px-3 bg-destructive/10 rounded-lg self-start max-w-full" }
                                    }
                                }
                            }
                            // 问卷卡片（专门的提问 block）：解析 assistant 消息里的
                            // 问卷 JSON/问题列表渲染为可选项表单。仅随最新一条消息
                            // 显示（lastMessageId 来自 useChatSearch composable，
                            // .at if 条件不支持多参 fn）——已回答的旧问题不再常驻表单。
                            if .rm.role == "assistant" {
                                if hasQuestionnaire(.rm) {
                                    if .rm.id == .lastMsgId {
                                        QuestionnaireCard {
                                            questions: getQuestions(.rm)
                                            onsubmit: .OnQuestionnaireSubmit($event)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // 流式等待指示：内容本身由 forge_stream 回写进 assistant 消息
                    // （messages 循环里的 ChatMessage 气泡），不在此重复渲染
                    // current_draft——此前 draft 区和气泡双写导致 AI 回复显示两遍。
                    // 仅在首个 delta/thinking 到达前显示等待指示（pulse 动画）。
                    if .store.streaming {
                        if .store.current_draft == "" && .store.thinking == "" {
                            col {
                                text "AI 思考中..."
                            }
                        }
                    }
                    if .store.error != "" {
                        text .store.error { style: "text-destructive text-[14px] py-2 px-3 bg-destructive/10 rounded-lg self-start max-w-full" }
                    }
                }
                // input bar（MentionInput 逃生舱；onsend/oncancel 避开原生 submit/stop 名）
                MentionInput {
                    disabled: .store.streaming
                    // .at 无可选 props：professions 必填，传空串走 helper 兜底
                    // （props.professions > 动态 configs > DEFAULT_PROFESSIONS）。
                    professions: ""
                    onsend: .SendInput($event)
                    oncancel: .StopStream
                }
            }
            // PLAN-059 T9:删除确认 alert-dialog 单源（无 trigger 受控形态,
            // open 绑 state_ref bool;title 单删/全删分流,action 回执
            // .delete_pending_id 分流）。置于视图根部——058 T13/首次实测均证
            // 深嵌(slot list col 内)时 VM 解释轨整树丢弃,视图根部/gallery
            // demo 形态才渲染。
            alert-dialog (open: .delete_confirm_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        if .delete_pending_id == "__all__" {
                            alert-dialog-title (text: t("chat.confirmDeleteAll")) {}
                        }
                        if .delete_pending_id != "__all__" {
                            alert-dialog-title (text: t("chat.confirmDeleteSession")) {}
                        }
                        alert-dialog-description (text: t("chat.confirmIrreversible")) {}
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel (text: t("chat.cancel"), onclick: .CancelDelete) {}
                        alert-dialog-action (text: t("chat.confirmDelete"), onclick: .ConfirmDelete(.delete_pending_id)) {}
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            ForgeStore.Init();
            // AgentConfigs 由 MentionInput 挂载时 Init（ professions 拉取）。
        }

        // PLAN-051 P3-②: 单参 oninput 双轨契约——vue codegen 自动包
        // ($event.target).value 传入，两轨 val 均为纯文本；此前 val.target.value
        // 在 VM 得 0（GET_FIELD on Str）、在 web 得 undefined。
        .OnSearchInput(val) -> { .chat_search = val }

        .NewSession -> { store.NewSession() }

        // 2026-09-03:hover 会话 × 显隐(mouse-area onmouseenter/onmouseleave;
        // 离开清空,进入置 id——相邻卡先 clear 后 enter,无抖动)。
        .HoverSession(id) -> { .hover_session_id = id }
        .HoverSessionClear -> { .hover_session_id = "" }

        // 消息卡展开/copy(内联后同 widget;冻结实参+own-state 写,全实证链)。
        .ToggleThink(id) -> {
            if .msg_think_open == id { .msg_think_open = "" } else { .msg_think_open = id }
        }
        .ToolToggleKey(key) -> {
            if .msg_tool_open == key { .msg_tool_open = "" } else { .msg_tool_open = key }
        }
        .CopyMessageContent(text) -> { dom.copy_text(text) }

        // PLAN-058 三期:Ask* 置 pending + open（alert-dialog 受控态）;取消
        // （含 reka-ui ESC/遮罩关闭路径,统一折算 oncancel）与 SelectSession
        // 复位双字段;ConfirmDelete 分流单删/全删（target 注入）并复位。
        .AskDelete(id) -> {
            .delete_pending_id = id;
            .delete_confirm_open = true
        }

        .AskDeleteAll -> {
            .delete_pending_id = "__all__";
            .delete_confirm_open = true
        }

        .CancelDelete -> {
            .delete_pending_id = "";
            .delete_confirm_open = false
        }

        // PLAN-058 三期:ConfirmDelete 统一确认入口——target 为会话 id 走单删,
        // "__all__"(alert-dialog action 回执 .delete_pending_id)走全删;双字段一并复位。
        .ConfirmDelete(id) -> {
            if id == "__all__" {
                chats_delete_all_sessions();
                store.session_id = "";
                store.messages = [];
            } else {
                chats_delete_session(id);
            }
            .delete_pending_id = "";
            .delete_confirm_open = false;
            store.LoadSessionList()
        }

        .SelectSession(id) -> {
            .delete_pending_id = "";
            .delete_confirm_open = false;
            store.SwitchSession(id)
        }

        // SendInput(text): MentionInput 的 onsubmit 回调。先检测 /relay//superpower//spec1
        // 命令（relay_command_match 非 None 表示已处理，runner 接线执行），
        // 否则走普通发送 + SSE 流。
        // PLAN-051 T8: 消费回调实参 text——原读 .text（统一态下是 MentionInput
        // 的字段，子 handler 已先清空 → 守卫恒假，发送被静默丢弃）。沿 017-chat
        // SendMessage(text) 的参数契约；mention_trim 统一净空口径。
        .SendInput(text) -> {
            let tt = mention_trim(text)
            if tt != "" {
                let cmd = relay_command_match(tt);
                .input = "";
                if cmd == None {
                    store.Send(tt);
                    store.StartStream(.store.session_id, .store.workspace, .store.token, tt)
                } else {
                    platformRunRelayCommand(cmd)
                }
            }
        }

        // StopStream: 停止 SSE 流。
        .StopStream -> {
            store.StopStream()
        }

        // B 类批4：ApproveGate/RejectGate 调真实 API（store.ApproveGate/RejectGate
        // 内部调 chats_approve/chats_reject_all + 清 current_gate）。
        .ApproveGate -> {
            store.ApproveGate()
        }

        .RejectGate -> {
            store.RejectGate()
        }

        // B 类批4：SecretaryMessage 审批按钮。wrapper 内部已调 useGateInbox.resolveGate/
        // dismissSecretary（本地态），widget handler 留作未来真实 API 接入点。
        .SecretaryApprove -> { store.ApproveGate() }
        .SecretaryReject -> { store.RejectGate() }
        .SecretarySnooze -> { store.ClearGate() }

        // OnQuestionnaireSubmit(text): 问卷提交。载荷已是格式化文本
        // （QuestionnaireCard 内 formatQuestionnaireAnswers："Q1: A; Q2: B"），
        // 直接作为用户消息发回 + 乐观插入 + 启动 SSE。
        .OnQuestionnaireSubmit(text) -> {
            if .text != "" {
                store.Send(.text);
                store.StartStream(.store.session_id, .store.workspace, .store.token, .text)
            }
        }
    }
}
