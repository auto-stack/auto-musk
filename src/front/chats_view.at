// chats_view.at — Forge 聊天视图（对应 web/src/views/ChatsView.vue）
//
// ChatsView.vue 2767 行：session-sidebar + chats-body(header/canvas/input-bar)。
// Phase 7a: 骨架——session 列表 + 消息列表 + 输入框 + 发送 + 流式 draft。
// Phase 7b: SSE 回写 + 流式 markdown draft。
// Phase 7c: mention + errand/relay/task_plan 内联卡片。
//   - 消息列表按 role 分支（user/assistant），tool_calls 用 if-else-if 编排 4 类卡片。
//   - 输入框替换为 MentionInput 逃生舱（v-html backdrop 无法 .at 表达）。
//   - 卡片走 use{component} 逃生舱（@click toggle 无法 .at 表达）。

use store: ForgeStore
// #4 回流：会话删除按钮所需的 API 函数。
use back.api: chats_delete_session, chats_delete_all_sessions

widget ChatsView {
    use {
        fn: startForgeStream, stopForgeStream from "src/front/forge_stream.ts"
        // B 类批3：/relay//superpower//spec1 命令路由（逃生舱 fn，同步检测+异步执行）。
        fn: handleRelayCommand from "src/front/relay_commands.ts"
        // forge_helpers 是逃生舱卡片组件的内部依赖，声明 renderMentions 仅为触发 ext 复制
        // （codegen ext 复制只看 use 块，不递归逃生舱组件的相对 import）。
        fn: renderMentions, extractRunId from "src/front/forge_helpers.ts"
        // questionnaire 解析纯函数（QuestionnaireCard 的数据源）。
        fn: getQuestions, hasQuestionnaire from "src/front/questionnaire.ts"
        component: MentionInput from "src/front/components/MentionInput.vue"
        // MentionDropdown/AgentAvatar 是 MentionInput 的内部依赖，同理声明触发复制。
        component: MentionDropdown from "src/front/components/MentionDropdown.vue"
        component: AgentAvatar from "src/front/components/AgentAvatar.vue"
        // Plan 023 P3：ErrandCard 已原生化为 component fn（src/front/errand_card.at），逃生舱 .vue 已删除。
        // B 类批3：RelayCard 状态展示版 → RelayRunBox 完整交互（subscribeToRun 日志 + resolveGate 审批）。
        component: RelayRunBox from "src/front/components/RelayRunBox.vue"
        // Plan 023 P3：TaskPlanCard 已原生化为 component fn（src/front/task_plan_card.at），逃生舱 .vue 已删除。
        // Plan 023 P3：GenericToolCard 已原生化为 component fn（src/front/generic_tool_card.at），逃生舱 .vue 已删除。
        // B 类批3：useRelay/useEventRouter/useGateInbox（relay 完整链路 + gate 事件路由）。
        composable: useRelay from "src/front/composables/useRelay.ts"
        composable: useEventRouter from "src/front/composables/useEventRouter.ts"
        composable: useGateInbox from "src/front/composables/useGateInbox.ts"
        // Phase 7.3 续：StreamingRenderer/ReportCard/QuestionnaireCard/GateCard。
        component: StreamingRenderer from "src/front/components/StreamingRenderer.vue"
        component: ReportCard from "src/front/components/ReportCard.vue"
        component: QuestionnaireCard from "src/front/components/QuestionnaireCard.vue"
        // Phase 7.3 续 codegen 限制1 修复后：直接用 QuestionnaireCard + getQuestions fn 调用
        // （不再需要 QuestionnaireMessage 包装组件）。
        component: GateCard from "src/front/components/GateCard.vue"
        // B 类批4：SecretaryMessageWrapper（包装 SecretaryMessage，规避 composable
        // facade ref 解包限制；内部用 useGateInbox.currentSecretary 驱动）。
        component: SecretaryMessageWrapper from "src/front/components/SecretaryMessageWrapper.vue"
        component: SecretaryMessage from "src/front/components/SecretaryMessage.vue"
        // StreamingTable/useStreamingDocument 是 StreamingRenderer 的内部依赖，声明触发复制。
        component: StreamingTable from "src/front/components/StreamingTable.vue"
        fn: useStreamingDocument from "src/front/composables/useStreamingDocument.ts"
        // Phase 7.4→Plan 023 P3：UserMessage 已原生化为 component fn
        // （src/front/user_message.at），逃生舱 .vue 已删除。
        // ChatMessage.vue 改用 @/components/UserMessage.vue 引用生成版。
        // forge_helpers 仍需声明（component fn 的 use{fn} 依赖 + 其他逃生舱卡片）。
        // Plan 022-B→Plan 023 P3：ChatMessage 已原生化为 component fn
        // （src/front/chat_message.at），逃生舱 .vue 已删除。
        // 依赖 UserMessage（已原生）+ StreamingRenderer（逃生舱）+ msgTimeLabel fn。
        component: ChatMessage
        // SessionInfo：会话信息 tooltip（Chat ID 复制 + 消息数 + token 消耗）。
        component: SessionInfo from "src/front/components/SessionInfo.vue"
        // B 类批1：useAgentConfigs（动态 profession 列表，替代 DEFAULT_PROFESSIONS 硬编码）。
        composable: useAgentConfigs from "src/front/composables/useAgentConfigs.ts"
        // Plan 407：lucide 图标（toolbar emoji→图标）+ i18n t()（text 节点本地化）。
        // Plan 407 parser 增强后，组件可作 button 子节点、t() 可作 text primary prop。
        // t 走 composable 包装 useT（const t = useT()，见 app.at 注释）。
        component: Plus, Trash2, Search, Info from "lucide-vue-next"
        composable: useT from "src/front/composables/useT.ts"
        // 技术债 #2：消息搜索过滤（search ref + filteredMessages computed）
        composable: useChatSearch from "src/front/composables/useChatSearch.ts"
        // 技术债：键盘快捷键（Ctrl+Shift+S 聚焦搜索 / Ctrl+Shift+N 新建会话）
        composable: useKeyboardShortcuts from "src/front/composables/useKeyboardShortcuts.ts"
    }

    msg Msg {
        Init,
        NewSession,
        OnSearchInput(str),
        DeleteSession(str),
        DeleteAllSessions,
        SelectSession(str),
        SendInput(str),
        StopStream,
        ApproveGate,
        RejectGate,
        SecretaryApprove,
        SecretaryReject,
        SecretarySnooze,
        OnQuestionnaireSubmit(str),
    }

    model {
        var input str = ""
        var sidebar_collapsed bool = false
        var chat_search str = ""
    }

    view {
        row {
            style: "chats-view"
            // Session Sidebar
            col {
                style: if .sidebar_collapsed { "session-sidebar collapsed" } else { "session-sidebar" }
                row {
                    style: "sidebar-header"
                    text t("chat.sessions") { style: "sidebar-title" }
                    // Plan 407：lucide 图标作 button 子节点（parser 增强后原生支持）。
                    button {
                        onclick: .NewSession
                        style: "sidebar-new-btn"
                        title: t("chat.newSession")
                        Plus { size: 14 }
                    }
                    button {
                        onclick: .DeleteAllSessions
                        style: "sidebar-new-btn"
                        title: t("chat.deleteAllSessions")
                        Trash2 { size: 14 }
                    }
                }
                col {
                    style: "session-list"
                    for s in .store.session_list {
                        button {
                            key: .s.id
                            onclick: .SelectSession(.s.id)
                            style: if .s.id == .store.session_id {
                                "session-item active"
                            } else {
                                "session-item"
                            }
                            col {
                                style: "session-preview"
                                text .s.name { style: "session-name" }
                                text t("chat.msgs", { count: .s.message_count }) { style: "session-count" }
                            }
                            // #4 回流：会话项 hover 删除按钮（Trash2 图标 + onclick.stop 阻止冒泡）
                            span {
                                style: "session-delete-btn"
                                onclick.stop: .DeleteSession(.s.id)
                                title: t("chat.deleteSession")
                                Trash2 { size: 12 }
                            }
                        }
                    }
                }
            }
            // Main Chat Area
            col {
                style: "chats-body"
                // header
                row {
                    style: "chats-header"
                    // 标题（固定 t('chat.title')，对齐原版）
                    div {
                        style: "header-title-row"
                        text t("chat.title") { style: "chats-title" }
                    }
                    // 搜索框（居中，对齐原版 .header-search）
                    div {
                        style: "header-search"
                        Search { size: 13 }
                        input {
                            style: "search-input"
                            value: .chatSearch.search
                            oninput: .OnSearchInput($event)
                            placeholder: t("chat.searchPlaceholder")
                        }
                    }
                    // 右侧 SessionInfo 组件（info icon + tooltip，对齐原版）
                    div {
                        style: "header-actions"
                        SessionInfo
                    }
                }
                // canvas（SecretaryMessage/GateCard/ReportCard + 消息列表 + 流式 draft）
                col {
                    style: "chats-canvas"
                    // SecretaryMessageWrapper：gate_reached 触发 useGateInbox.registerGate →
                    // currentSecretary 驱动审批消息条（B 类批4。wrapper 内部 v-if gate 控制显隐）。
                    SecretaryMessageWrapper {
                        onapprove: .SecretaryApprove
                        onreject: .SecretaryReject
                        onsnooze: .SecretarySnooze
                    }
                    // GateCard：gate_reached 事件触发，显示待审批 spec 变更（7.3）
                    if .store.current_gate != None {
                        GateCard {
                            changes: .store.pending_spec_changes
                            onapprove: .ApproveGate
                            onreject: .RejectGate
                        }
                    }
                    // ReportCard：run_completed 事件触发，显示 relay 报告（7.3）
                    if .store.report_data != None {
                        ReportCard {
                            report: .store.report_data
                        }
                    }
                    for msg in .chatSearch.filteredMessages {
                        col {
                            key: .msg.id
                            // ChatMessage 独立组件渲染 header + 气泡 + thinking
                            ChatMessage {
                                msg: .msg
                                is_streaming: false
                            }
                            // 问卷卡片（assistant 消息内含问卷时显示，7.3。
                            // codegen 限制1 修复后直接用 getQuestions fn 调用绑定）
                            if .msg.role == "assistant" {
                                if hasQuestionnaire(.msg) {
                                    QuestionnaireCard {
                                        questions: getQuestions(.msg)
                                        onsubmit: .OnQuestionnaireSubmit($event)
                                    }
                                }
                            }
                            // tool_calls 内联卡片（if-else-if 编排 4 类）
                            for tc in .msg.tool_calls {
                                if .tc.name == "dispatch" {
                                    ErrandCard {
                                        tc: .tc
                                        errands: .store.errands
                                    }
                                } else if .tc.name == "spawn_relay" {
                                    RelayRunBox {
                                        runId: extractRunId(.tc)
                                    }
                                } else if .tc.name == "task_plan" {
                                    TaskPlanCard {
                                        tc: .tc
                                        taskPlans: .store.task_plans
                                    }
                                } else {
                                    GenericToolCard {
                                        tc: .tc
                                    }
                                }
                            }
                        }
                    }
                    // 流式 draft（streaming 时显示，7.3 换 StreamingRenderer 增量解析）
                    if .store.streaming {
                        if .store.thinking != "" {
                            text .store.thinking { style: "msg-thinking" }
                        }
                        if .store.current_draft != "" {
                            col {
                                style: "msg assistant-msg draft"
                                StreamingRenderer {
                                    source: .store.current_draft
                                    streaming: .store.streaming
                                }
                            }
                        }
                    }
                    if .store.error != "" {
                        text .store.error { style: "msg-error" }
                    }
                }
                // input bar（MentionInput 逃生舱；onsend/oncancel 避开原生 submit/stop 名）
                MentionInput {
                    disabled: .store.streaming
                    onsend: .SendInput($event)
                    oncancel: .StopStream
                }
            }
        }
    }

    on {
        .Init -> {
            store.Init();
            agentConfigs.loadConfigs()
        }

        .OnSearchInput(val) -> { chatSearch.search = val.target.value }

        .NewSession -> { store.NewSession() }

        .DeleteSession(id) -> {
            chats_delete_session(id);
            store.LoadSessionList()
        }

        .DeleteAllSessions -> {
            chats_delete_all_sessions();
            store.session_id = "";
            store.messages = [];
            store.LoadSessionList()
        }

        .SelectSession(id) -> { store.SwitchSession(id) }

        // SendInput(text): MentionInput 的 onsubmit 回调。先检测 /relay//superpower//spec1
        // 命令（handleRelayCommand 返回 true 表示已处理），否则走普通发送 + SSE 流。
        .SendInput(text) -> {
            if .text.trim() != "" {
                let handled = handleRelayCommand(.text);
                .input = "";
                if !handled {
                    store.Send(.text);
                    startForgeStream(.store.session_id, .store.workspace, .store.token, .text)
                }
            }
        }

        // StopStream: 停止 SSE 流。
        .StopStream -> {
            stopForgeStream();
            store.StopStream()
        }

        // B 类批4：ApproveGate/RejectGate 调真实 API（store.ApproveGate/RejectGate
        // 内部调 chats_approve/chats_reject_all + 清 current_gate）。
        .ApproveGate -> {
            store.ApproveGate()
        }

        .RejectGate -> {
            store.RejectGate()
        }

        // B 类批4：SecretaryMessage 审批按钮。wrapper 内部已调 useGateInbox.resolveGate/
        // dismissSecretary（本地态），widget handler 留作未来真实 API 接入点。
        .SecretaryApprove -> { store.ApproveGate() }
        .SecretaryReject -> { store.RejectGate() }
        .SecretarySnooze -> { store.ClearGate() }

        // OnQuestionnaireSubmit(answers): 问卷提交，把答案作为用户消息发回 + 启动 SSE。
        .OnQuestionnaireSubmit(answers) -> {
            store.Send(.answers);
            startForgeStream(.store.session_id, .store.workspace, .store.token)
        }
    }
}
