// chats_view.at — Forge 聊天视图（对应 web/src/views/ChatsView.vue）
//
// ChatsView.vue 2767 行：session-sidebar + chats-body(header/canvas/input-bar)。
// Phase 7a: 骨架——session 列表 + 消息列表 + 输入框 + 发送 + 流式 draft。
// Phase 7b: SSE 回写 + 流式 markdown draft。
// Phase 7c: mention + errand/relay/task_plan 内联卡片。
//   - 消息列表按 role 分支（user/assistant），tool_calls 用 if-else-if 编排 4 类卡片。
//   - 输入框替换为 MentionInput 逃生舱（v-html backdrop 无法 .at 表达）。
//   - 卡片走 use{component} 逃生舱（@click toggle 无法 .at 表达）。

use store: ForgeStore
// #4 回流：会话删除按钮所需的 API 函数。
use back.api: chats_delete_session, chats_delete_all_sessions

widget ChatsView {
    use {
        fn: startForgeStream, stopForgeStream from "src/front/forge_stream.ts"
        // B 类批3：/relay//superpower//spec1 命令路由（逃生舱 fn，同步检测+异步执行）。
        fn: handleRelayCommand from "src/front/relay_commands.ts"
        // forge_helpers 是逃生舱卡片组件的内部依赖，声明 renderMentions 仅为触发 ext 复制
        // （codegen ext 复制只看 use 块，不递归逃生舱组件的相对 import）。
        fn: renderMentions, extractRunId, isMsgStreaming, messageBlocks, estimateTokens, thinkLabel, isBlockStreaming from "src/front/forge_helpers.ts"
        // questionnaire 解析纯函数（QuestionnaireCard 的数据源）。
        fn: getQuestions, hasQuestionnaire from "src/front/questionnaire.ts"
        // Plan 023 队列 B5：MentionInput 已原生化为 component fn（src/front/mention_input.at），
        // 逃生舱 .vue 已删除（v-html backdrop 已原生 + MentionDropdown 已原生）。
        component: MentionInput
        // Plan 023 §3.1：共用 NavSidebar + ContentHeader（三视图二级导航/内容标题栏收敛）。
        component: NavSidebar
        component: ContentHeader
        // mention_helpers 是 MentionDropdown component fn 的 use{fn} 依赖，声明仅为触发 ext 复制。
        fn: mentionFiltered, mentionPosition, mentionCurrentId, mentionClampIndex, mentionIndexOf from "src/front/mention_helpers.ts"
        // Plan 023 队列 B3：MentionDropdown 已原生化为 component fn（src/front/mention_dropdown.at），
        // 逃生舱 .vue 已删除（MentionInput.vue 改用 @/components/MentionDropdown.vue 引用生成版）。
        component: MentionDropdown
        // Plan 023 P3：AgentAvatar 已原生化为 component fn（src/front/agent_avatar.at），
        // MentionDropdown.vue + SecretaryMessage.vue 改用 @/components/AgentAvatar.vue 引用生成版。
        // Plan 023 P3：ErrandCard 已原生化为 component fn（src/front/errand_card.at），逃生舱 .vue 已删除。
        // relay_run_helpers 是 RelayRunBox component fn 的 use{fn} 依赖，声明仅为触发 ext 复制。
        fn: relayRunSubscribe, relayRunUnsubscribe, relayRunLoad, relayRunApprove, relayRunReject, relaySessionLogFor, relayFindRun, relayStatusLabel, relayStatusClass, relayProfessionIcon, relayRunTitle, relayWaitingGate, relayEntryClass from "src/front/relay_run_helpers.ts"
        // Plan 023 队列 A3：RelayRunBox 已原生化为 component fn（src/front/relay_run_box.at），
        // 逃生舱 .vue 已删除（subscribeToRun 日志 + resolveGate 审批）。
        component: RelayRunBox
        // Plan 023 P3：TaskPlanCard 已原生化为 component fn（src/front/task_plan_card.at），逃生舱 .vue 已删除。
        // Plan 023 P3：GenericToolCard 已原生化为 component fn（src/front/generic_tool_card.at），逃生舱 .vue 已删除。
        // B 类批3：useRelay/useEventRouter/useGateInbox（relay 完整链路 + gate 事件路由）。
        composable: useRelay from "src/front/composables/useRelay.ts"
        composable: useEventRouter from "src/front/composables/useEventRouter.ts"
        composable: useGateInbox from "src/front/composables/useGateInbox.ts"
        // Phase 7.3 续：StreamingRenderer/ReportCard/QuestionnaireCard/GateCard。
        component: StreamingRenderer from "src/front/components/StreamingRenderer.vue"
        // Plan 023 P3：ReportCard 已原生化为 component fn（src/front/report_card.at），逃生舱 .vue 已删除。
        // questionnaire_helpers 是 QuestionnaireCard component fn 的 use{fn} 依赖，声明仅为触发 ext 复制。
        fn: questionnaireSingleChecked, questionnaireMultiChecked, questionnaireToggleAnswer, questionnaireOtherKey, questionnaireCanSubmit, questionnairePlaceholder from "src/front/questionnaire_helpers.ts"
        // Plan 023 队列 B1：QuestionnaireCard 已原生化为 component fn（src/front/questionnaire_card.at），
        // 逃生舱 .vue 已删除。
        component: QuestionnaireCard
        // Phase 7.3 续 codegen 限制1 修复后：直接用 QuestionnaireCard + getQuestions fn 调用
        // （不再需要 QuestionnaireMessage 包装组件）。
        // gate_helpers 是 GateCard component fn 的 use{fn} 依赖，声明仅为触发 ext 复制。
        fn: gateToggleExpanded, gateWithExpanded, gateInitEditedSpecs, gateTitleText from "src/front/gate_helpers.ts"
        // Plan 023 队列 B2：GateCard 已原生化为 component fn（src/front/gate_card.at），
        // 逃生舱 .vue 已删除。
        component: GateCard
        // B 类批4→Plan 023 队列 B 续：SecretaryMessageWrapper 已原生化为 component fn
        // （src/front/secretary_message_wrapper.at，§10.4 facade refs 修复后），逃生舱 .vue 已删除。
        component: SecretaryMessageWrapper
        // secretary_helpers 是 SecretaryMessage component fn 的 use{fn} 依赖，声明仅为触发 ext 复制。
        fn: secretaryFormatElapsed from "src/front/secretary_helpers.ts"
        // Plan 023 队列 B4：SecretaryMessage 已原生化为 component fn（src/front/secretary_message.at），
        // 逃生舱 .vue 已删除（SecretaryMessageWrapper.vue 改用 @/components/SecretaryMessage.vue 引用生成版）。
        component: SecretaryMessage
        // Plan 023 P3：StreamingTable 已原生化为 component fn（src/front/streaming_table.at），
        // StreamingRenderer.vue 改用 @/components/StreamingTable.vue 引用生成版。
        // useStreamingDocument 仍是 StreamingRenderer 的内部依赖，声明触发复制。
        fn: useStreamingDocument from "src/front/composables/useStreamingDocument.ts"
        // Phase 7.4→Plan 023 P3：UserMessage 已原生化为 component fn
        // （src/front/user_message.at），逃生舱 .vue 已删除。
        // ChatMessage.vue 改用 @/components/UserMessage.vue 引用生成版。
        // forge_helpers 仍需声明（component fn 的 use{fn} 依赖 + 其他逃生舱卡片）。
        // Plan 022-B→Plan 023 P3：ChatMessage 已原生化为 component fn
        // （src/front/chat_message.at），逃生舱 .vue 已删除。
        // 依赖 UserMessage（已原生）+ StreamingRenderer（逃生舱）+ msgTimeLabel fn。
        component: ChatMessage
        // session_info_helpers 是 SessionInfo component fn 的 use{fn} 依赖，声明仅为触发 ext 复制。
        fn: sessionTokenCost, sessionCopyId, sessionCopied, sessionMessageCount from "src/front/session_info_helpers.ts"
        // Plan 023 队列 B 续：SessionInfo 已原生化为 component fn（src/front/session_info.at，
        // store + 宿主全局），逃生舱 .vue 已删除。
        component: SessionInfo
        // B 类批1：useAgentConfigs（动态 profession 列表，替代 DEFAULT_PROFESSIONS 硬编码）。
        composable: useAgentConfigs from "src/front/composables/useAgentConfigs.ts"
        // Plan 407：lucide 图标（toolbar emoji→图标）+ i18n t()（text 节点本地化）。
        // Plan 407 parser 增强后，组件可作 button 子节点、t() 可作 text primary prop。
        // t 走 composable 包装 useT（const t = useT()，见 app.at 注释）。
        component: Plus, Trash2, Search, Info from "lucide-vue-next"
        composable: useT from "src/front/composables/useT.ts"
        // 技术债 #2：消息搜索过滤（search ref + filteredMessages computed）
        composable: useChatSearch from "src/front/composables/useChatSearch.ts"
        // 技术债：键盘快捷键（Ctrl+Shift+S 聚焦搜索 / Ctrl+Shift+N 新建会话）
        composable: useKeyboardShortcuts from "src/front/composables/useKeyboardShortcuts.ts"
    }

    msg Msg {
        Init,
        NewSession,
        OnSearchInput(str),
        DeleteSession(str),
        DeleteAllSessions,
        SelectSession(str),
        SendInput(str),
        StopStream,
        ApproveGate,
        RejectGate,
        SecretaryApprove,
        SecretaryReject,
        SecretarySnooze,
        OnQuestionnaireSubmit(str),
    }

    model {
        var input str = ""
        var sidebar_collapsed bool = false
        var chat_search str = ""
    }

    view {
        row {
            style: "chats-view"
            // Session Sidebar（Plan 023 §3.1：共用 NavSidebar——header + list slot）
            NavSidebar {
                title: t("chat.sessions")
                collapsed: .sidebar_collapsed
                slot(name: "actions") {
                    // Plan 407：lucide 图标作 button 子节点（parser 增强后原生支持）。
                    button {
                        onclick: .NewSession
                        style: "sidebar-new-btn"
                        title: t("chat.newSession")
                        Plus { size: 14 }
                    }
                    button {
                        onclick: .DeleteAllSessions
                        style: "sidebar-new-btn"
                        title: t("chat.deleteAllSessions")
                        Trash2 { size: 14 }
                    }
                }
                slot(name: "list") {
                    col {
                        style: "session-list"
                        for s in .store.session_list {
                            button {
                                key: .s.id
                                onclick: .SelectSession(.s.id)
                                style: if .s.id == .store.session_id {
                                    "session-item active"
                                } else {
                                    "session-item"
                                }
                                col {
                                    style: "session-preview"
                                    text .s.name { style: "session-name" }
                                    text t("chat.msgs", { count: .s.message_count }) { style: "session-count" }
                                }
                                // #4 回流：会话项 hover 删除按钮（Trash2 图标 + onclick.stop 阻止冒泡）
                                span {
                                    style: "session-delete-btn"
                                    onclick.stop: .DeleteSession(.s.id)
                                    title: t("chat.deleteSession")
                                    Trash2 { size: 12 }
                                }
                            }
                        }
                    }
                }
            }
            // Main Chat Area
            col {
                style: "chats-body"
                // header（Plan 023 §3.1：共用 ContentHeader——标题 + middle 搜索 + actions）
                ContentHeader {
                    title: t("chat.title")
                    slot(name: "middle") {
                        // 搜索框（居中，对齐原版 .header-search）
                        div {
                            style: "header-search"
                            Search { size: 13 }
                            input {
                                style: "search-input"
                                value: .chatSearch.search
                                oninput: .OnSearchInput($event)
                                placeholder: t("chat.searchPlaceholder")
                            }
                        }
                    }
                    slot(name: "actions") {
                        // 右侧 SessionInfo 组件（info icon + tooltip，对齐原版）
                        div {
                            style: "header-actions"
                            SessionInfo
                        }
                    }
                }
                // canvas（SecretaryMessage/GateCard/ReportCard + 消息列表 + 流式 draft）
                col {
                    style: "chats-canvas"
                    // SecretaryMessageWrapper：gate_reached 触发 useGateInbox.registerGate →
                    // currentSecretary 驱动审批消息条（B 类批4。wrapper 内部 v-if gate 控制显隐）。
                    SecretaryMessageWrapper {
                        onapprove: .SecretaryApprove
                        onreject: .SecretaryReject
                        onsnooze: .SecretarySnooze
                    }
                    // GateCard：gate_reached 事件触发，显示待审批 spec 变更（7.3）
                    if .store.current_gate != None {
                        GateCard {
                            title: ""
                            profession: ""
                            changes: .store.pending_spec_changes
                            onapprove: .ApproveGate
                            onreject: .RejectGate
                        }
                    }
                    // ReportCard：run_completed 事件触发，显示 relay 报告（7.3）
                    if .store.report_data != None {
                        ReportCard {
                            report: .store.report_data
                        }
                    }
                    for msg in .chatSearch.filteredMessages {
                        col {
                            key: .msg.id
                            // ChatMessage 独立组件：有序 block 流（文本/思考/工具），
                            // 工具卡随 block 内联渲染（不再后置循环）。
                            ChatMessage {
                                msg: .msg
                                is_streaming: isMsgStreaming(.store.streaming, .store.messages, .msg)
                                errands: .store.errands
                                relays: .store.relays
                                task_plans: .store.task_plans
                            }
                            // 问卷卡片（专门的提问 block）：解析 assistant 消息里的
                            // 问卷 JSON/问题列表渲染为可选项表单。仅随最新一条消息
                            // 显示（lastMessageId 来自 useChatSearch composable，
                            // .at if 条件不支持多参 fn）——已回答的旧问题不再常驻表单。
                            if .msg.role == "assistant" {
                                if hasQuestionnaire(.msg) {
                                    if .msg.id == .chatSearch.lastMessageId {
                                        QuestionnaireCard {
                                            questions: getQuestions(.msg)
                                            onsubmit: .OnQuestionnaireSubmit($event)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // 流式等待指示：内容本身由 forge_stream 回写进 assistant 消息
                    // （messages 循环里的 ChatMessage 气泡），不在此重复渲染
                    // current_draft——此前 draft 区和气泡双写导致 AI 回复显示两遍。
                    // 仅在首个 delta/thinking 到达前显示等待指示（pulse 动画）。
                    if .store.streaming {
                        if .store.current_draft == "" && .store.thinking == "" {
                            col {
                                style: "msg assistant-msg thinking-dots"
                                text "AI 思考中..."
                            }
                        }
                    }
                    if .store.error != "" {
                        text .store.error { style: "msg-error" }
                    }
                }
                // input bar（MentionInput 逃生舱；onsend/oncancel 避开原生 submit/stop 名）
                MentionInput {
                    disabled: .store.streaming
                    // .at 无可选 props：professions 必填，传空串走 helper 兜底
                    // （props.professions > 动态 configs > DEFAULT_PROFESSIONS）。
                    professions: ""
                    onsend: .SendInput($event)
                    oncancel: .StopStream
                }
            }
        }
    }

    on {
        .Init -> {
            store.Init();
            agentConfigs.loadConfigs()
        }

        .OnSearchInput(val) -> { chatSearch.search = val.target.value }

        .NewSession -> { store.NewSession() }

        .DeleteSession(id) -> {
            chats_delete_session(id);
            store.LoadSessionList()
        }

        .DeleteAllSessions -> {
            chats_delete_all_sessions();
            store.session_id = "";
            store.messages = [];
            store.LoadSessionList()
        }

        .SelectSession(id) -> { store.SwitchSession(id) }

        // SendInput(text): MentionInput 的 onsubmit 回调。先检测 /relay//superpower//spec1
        // 命令（handleRelayCommand 返回 true 表示已处理），否则走普通发送 + SSE 流。
        .SendInput(text) -> {
            if .text.trim() != "" {
                let handled = handleRelayCommand(.text);
                .input = "";
                if !handled {
                    store.Send(.text);
                    startForgeStream(.store.session_id, .store.workspace, .store.token, .text)
                }
            }
        }

        // StopStream: 停止 SSE 流。
        .StopStream -> {
            stopForgeStream();
            store.StopStream()
        }

        // B 类批4：ApproveGate/RejectGate 调真实 API（store.ApproveGate/RejectGate
        // 内部调 chats_approve/chats_reject_all + 清 current_gate）。
        .ApproveGate -> {
            store.ApproveGate()
        }

        .RejectGate -> {
            store.RejectGate()
        }

        // B 类批4：SecretaryMessage 审批按钮。wrapper 内部已调 useGateInbox.resolveGate/
        // dismissSecretary（本地态），widget handler 留作未来真实 API 接入点。
        .SecretaryApprove -> { store.ApproveGate() }
        .SecretaryReject -> { store.RejectGate() }
        .SecretarySnooze -> { store.ClearGate() }

        // OnQuestionnaireSubmit(text): 问卷提交。载荷已是格式化文本
        // （QuestionnaireCard 内 formatQuestionnaireAnswers："Q1: A; Q2: B"），
        // 直接作为用户消息发回 + 乐观插入 + 启动 SSE。
        .OnQuestionnaireSubmit(text) -> {
            if .text != "" {
                store.Send(.text);
                startForgeStream(.store.session_id, .store.workspace, .store.token, .text)
            }
        }
    }
}
