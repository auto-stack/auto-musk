// chats_view.at — Forge 聊天视图（对应 web/src/views/ChatsView.vue）
//
// ChatsView.vue 2767 行：session-sidebar + chats-body(header/canvas/input-bar)。
// Phase 7a: 骨架——session 列表 + 消息列表 + 输入框 + 发送 + 流式 draft。
// Phase 7b: SSE 回写 + 流式 markdown draft。
// Phase 7c: mention + errand/relay/task_plan 内联卡片。
// PLAN-049 T6：会话壳自定义类全量迁内联工具类（双轨收敛,style{} 块删除）。
//   - 消息列表按 role 分支（user/assistant），tool_calls 用 if-else-if 编排 4 类卡片。
//   - 输入框替换为 MentionInput 逃生舱（v-html backdrop 无法 .at 表达）。
//   - 卡片走 use{component} 逃生舱（@click toggle 无法 .at 表达）。

use store: ForgeStore
// PLAN-093 T-08:跨 store 依赖（PLAN-048——第二 store 发独立 facade
// canvasStore；元素附件 chip 实时读拾取面，发送时冻结快照）。
use store: CanvasStore
// #4 回流：会话删除按钮所需的 API 函数。
use back.api: chats_delete_session, chats_delete_all_sessions

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web relay_command_match from "src/front/relay_commands.at"
use.web platformRunRelayCommand from "src/front/ports/platform.at"
use.web platformFocusComposer from "src/front/ports/platform.at"
use.web.fn extractRunId, isMsgStreaming, messageBlocks, estimateTokens, thinkLabel, isBlockStreaming from "src/front/forge_helpers.at"
use.web.fn chatSearchFilter, chatLastMessageId, chatBranchLabel, chatBranchEntries, chatActivePath from "src/front/forge_helpers.at"
// PLAN-051 T8: SendInput 净空口径统一（原 .send(mention_trim(.text)) 调用位
// 形态，实参内移后宿主侧复用同一 helper）。
use.web.fn mention_trim from "src/front/mention_helpers.at"
use.web getQuestions, hasQuestionnaire from "src/front/questionnaire.at"
use.web questionnaireSingleChecked, questionnaireMultiChecked, questionnaireToggleAnswer, questionnaireOtherKey, questionnaireCanSubmit, questionnairePlaceholder from "src/front/questionnaire_helpers.at"
// PLAN-092 T-01: Copy/CopyCheck 入口（会话 id 信息条复制态，session_info.at 先例）。
use.web component Plus, Trash2, Search, Info, Copy, CopyCheck from "src/front/ports/icons.at"
use.web useT from "src/front/ports/composables.at"
// PLAN-058 三期:删除确认 web 轨 = AutoUI alert-dialog（components/
// DeleteConfirmDialog.vue 薄适配:ui/alert-dialog 标准件组合,直连绑定沿
// renderer.web.at→MarkdownRender.vue 先例）。
// PLAN-536 T9：改走端口链（ports/delete_confirm.at → vm.at/web.at 目标
// 门控,同 renderer 域）——VM 轨由 delete_confirm.vm.at 的 alert-dialog
// 受控 open 模态承接,web 轨 facade re-export 原 .vue 适配器。
// PLAN-059 T9:536 绑定根修+vm.at 真源实机复验通过后,VM 内联确认行
// （session-delete-strip）与 web CSS 抑制规则退役——单源双轨。
use.web component DeleteConfirmDialog from "src/front/ports/delete_confirm.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use mention_input: MentionInput
use nav_sidebar: NavSidebar
use nav_item: NavListItem
use content_header: ContentHeader
use mention_dropdown: MentionDropdown
use relay_run_box: RelayRunBox
use questionnaire_card: QuestionnaireCard
use gate_card: GateCard
use secretary_message_wrapper: SecretaryMessageWrapper
use secretary_message: SecretaryMessage
use chat_message: ChatMessage
// PLAN-087 T-07: 实况画布面板（chats 右侧第三列；cv_open 驱动显隐）。
use canvas_panel: CanvasPanel, CanvasStudioSlot
// PLAN-093 T-06:帧点选委托（幂等单例安装；VM 桩空实现）。
use.web installCanvasFrameClicks, installCanvasSourceScroll, canvasClearPick from "src/front/ports/canvas.at"

widget ChatsView {

    setup {
        let t = useT()
        // PLAN-093 T-06:委托安装承接位——71c302b 移除面板侧两次调用时
        // 未落此位，画布直点链路中断（几何取证 B/D2 实证）。setup 先于
        // 帧 img 存在，capture load 打标不缺拍。
        installCanvasFrameClicks()
        // PLAN-093 T-07:源码面板行定位安装（幂等单例；MutationObserver
        // 高亮行出现/位移时容器居中——web 门面 DOM 面）。
        installCanvasSourceScroll()
    }

    msg Msg {
        Init,
        NewSession,
        OnSearchInput(str),
        // PLAN-064: 思考档位选择（value: ""|off|low|high|max；"" = 跟随默认）。
        PickThinking(str),
        // PLAN-067 T-05: 审批模式选择（value: human|auto）。
        PickApproval(str),
        // PLAN-058: 删除两步确认——Ask* 只置 pending，Confirm* 才真正调删除
        // API（替代原 DeleteSession/DeleteAllSessions 直删）。
        AskDelete(str),
        AskDeleteAll,
        CancelDelete,
        ConfirmDelete(str),
        SelectSession(str),
        // PLAN-083 T-03：历史向上翻页（转发 ForgeStore.LoadOlder——
        // "加载更早的消息" pill，V-3）。
        LoadOlder,
        // PLAN-071 需求⑤ T-25：取消在途运行（转发 ForgeStore）。
        // PLAN-071 需求⑨：按钮迁入 ChatMessage 工具栏（子件直调
        // ForgeStore.CancelRun），本视图级消息与 handler 退役。
        SendInput(str),
        StopStream,
        ApproveGate,
        RejectGate,
        SecretaryApprove,
        SecretaryReject,
        SecretarySnooze,
        OnQuestionnaireSubmit(str),
        // PLAN-043 补遗:分支切换事件（043 只加了视图调用,漏了 msg 声明——
        // 旧 CLI 解析失败被 stale gen 掩盖,新 CLI 重建时暴露为 0 参 emit）。
        // PLAN-055 ⑤: RetryFrom 随"⑂ 重试"按钮删除（孤儿清理）。
        BranchTo(str, str),
        // PLAN-060 T2:分叉入口（ChatMessage onfork 路由;mid=分叉锚消息）。
        ForkFrom(str),
        // 2026-09-04 恢复（PLAN-059 T9 用户实机对拍）：会话卡 × hover 显隐
        // （mouse-area 命中区驱动;web 侧 CSS .session-item:hover 双保险）。
        // 536 重测的兄弟浮 × 形态在 VM 实机三连败：× 几何落左上、常显、
        // 悬浮层抢卡片点击（点卡片弹删除框不出内容）——回归 mouse-area
        // 标题行右缘形态（此前 HoverSession 活体实证）。
        HoverSession(str),
        HoverSessionClear,
        // PLAN-093 T-05:应用设计模式开关（studio 布局;侧栏偏好进出保存/
        // 恢复;模式归本组件视图域——跨 store 写入无先例;工作台槽与启动流
        // 见 canvas_panel.at CanvasStudioSlot）。
        ToggleStudio,
        // ── PLAN-084 T-04/T-06：重命名与头部工具 ──
        // StartRename: 进入行内重命名（列表行铅笔；预填当前名）。
        StartRename(str),
        // RenameDraft: 重命名输入框 oninput（视图态 str 字段，chat_search 先例）。
        RenameDraft(str),
        // ConfirmRename: Enter/✓ 提交（空名/未变更静默收场）；CancelRename: Esc/✕。
        ConfirmRename,
        CancelRename,
        // ToggleSearch: 头部 search icon 展开/收起 middle 搜索框（搜索框
        // 自 ChatHeader middle 常驻改为 icon 触发，用户裁定）。
        ToggleSearch,
        // ToggleArchived: 会话列表"已归档"过滤开关（转发 store.SetShowArchived）。
        ToggleArchived,
        // RenameFromHeader: 头部铅笔——标题在 middle 槽进入行内编辑。
        RenameFromHeader,
        // ArchiveRow(id, archived): 行内归档/取消归档（转发 store.ArchiveSession）。
        ArchiveRow(str, bool),
        // ToggleEarlier: "更早"分组折叠切换（转发 store.SetEarlierCollapsed）。
        ToggleEarlier,
        // ── PLAN-092 T-01：会话 id 信息入口（084 退役 SessionInfo 的紧凑回归）──
        // ToggleSessionInfo: 头部 i icon 展开/收起会话 id 信息条。
        ToggleSessionInfo,
        // CopySessionId: 复制当前会话 id（dom.copy_text；✓ 态常驻至下次复制，
        // 029 已登记 setTimeout 自动复位不可表达）。
        CopySessionId,
        // PLAN-093 T-05 §5.2 窄层（<768）：工作台页签（画布/对话/结构）。
        StudioTabSet(str),
        // PLAN-093 T-08:元素附件 chip（移除/聚焦 composer——不改文本）。
        CtxModifyFocus,
        CtxRemove,
        // PLAN-093 T-08:队列条目移除（按文本匹配首个）。
        QueueRemoveText(str),
    }

    model {
        var input str = ""
        var sidebar_collapsed bool = false
        // PLAN-093 T-05:进 studio 前的侧栏折叠态（退出恢复）。
        var sidebar_prev bool = false
        // studio 模式（本组件视图状态——跨 store 写入无先例,模式归视图域;
        // canvas 数据仍单源 CanvasStore）。
        var studio_mode bool = false
        // PLAN-093 T-05 §5.2 窄层（<768）：工作台页签（画布/对话/结构；
        // 宽层忽略——塌缩类仅窄层消费）。
        var studio_tab str = "canvas"
        var chat_search str = ""
        // PLAN-058: 待确认删除目标（会话 id 或 "__all__"；空串=无待确认）。
        // 沿 chat_search 先例的视图态 str 字段（VM 对 str 字段 SET/比较双轨实证）。
        var delete_pending_id str = ""
        // PLAN-058 三期:alert-dialog 受控 open（web 侧 v-model:open 需
        // state_ref bool——字面量/表达式会让整树退化成 div,vue.rs:10863）。
        var delete_confirm_open bool = false
        // 当前 hover 的会话 id(× 按钮显隐;空串=无 hover)。
        var hover_session_id str = ""
        // ── PLAN-084 T-04/T-06 ──
        // 行内重命名目标会话 id + 草稿（"" = 非编辑态；VM 对 str 字段
        // SET/比较双轨实证，沿 delete_pending_id 先例）。
        var renaming_id str = ""
        var rename_draft str = ""
        // 头部搜索框展开态（icon 触发；收起时 middle 槽为空）。
        var search_open bool = false
        // 头部标题行内编辑态（middle 槽换输入框）。
        var header_renaming bool = false
        // ── PLAN-092 T-01 ──
        // 会话 id 信息条展开态（头部 i icon 触发）。
        var info_open bool = false
        // 复制完成态（Copy → CopyCheck，常驻至下次复制）。
        var info_copied bool = false
    }

    // Plan 028 T15：搜索过滤（原 useChatSearch composable → F2 多参 fn 直调）
    computed {
        // PLAN-071 需求⑥：流式状态行——深度思考期可见，不再凭空消失。
        // PLAN-043: 先按活跃路径投影再套搜索过滤。
        filteredMessages => chatSearchFilter(chatActivePath(.store.messages, .store.active_leaf), .chat_search)
        lastMsgId => chatLastMessageId(.filteredMessages)
        // PLAN-083 T-03：翻页 pill 文案（text 位 if 表达式不受支持，R046）。
        olderLabel => if .store.older_loading { "正在加载更早消息…" } else { "加载更早的消息" }
        // PLAN-043: 分叉切换器数据（for-in 迭代器仅支持纯 dot 路径,fn 调用与
        // 动态索引均破坏 UI parser——扁平 {for_id, sib} 条目在此预算,视图按
        // for_id 相等匹配渲染兄弟按钮）。
        branchEntries => chatBranchEntries(.store.messages)
        // PLAN-084 T-03: 时间分组标记行（今天/昨天/更早 拍平一维：header
        // 行 + session 行交替，空组剪除；数据源开关在 helper 内分支——
        // 规避 VM computed 内 if+fn 未证面，T-07 冒烟实证列表空后定案）。
        // PLAN-084 T-07 二分探针（临时）：静态行——判定 computed/fn 调用 vs 渲染循环。
        // PLAN-084 T-03: 分组标记行改由 store handler 域维护（.store.session_rows）
        // ——视图 computed 内 use.web.fn 调用在 VM 侧静默返空（T-07 冒烟实证）。
        // PLAN-092 T-01: 会话 id 展示文本（空态 —，session_info.at 先例；
        // 纯 dot 路径 if——VM 侧 olderLabel 同构先例）。
        sessionIdText => if .store.session_id != "" { .store.session_id } else { "—" }
        // ── PLAN-093 T-05 §5.2 宽度分层（对话列 360/320、窄层页签塌缩、
        // studio 内容行反转右置）——单层链 computed（080 实证：嵌套 if
        // 分支值 codegen 丢 return），宽度源 = ForgeStore.fw_win_w ──
        chatTierClass => if .store.fw_win_w >= 1280 { "w-[360px] shrink-0" } else { "w-[320px] shrink-0" }
        chatTabClass => if .studio_tab == "chat" { "flex-1" } else { "w-0" }
        chatModeClass => if .store.fw_win_w < 768 { .chatTabClass } else { .chatTierClass }
        chatColClass => if .studio_mode { .chatModeClass + " flex flex-col min-w-0 overflow-hidden" } else { "flex-1 flex flex-col min-w-0 overflow-hidden" }
        panelTabClass => if .studio_tab == "chat" { "w-0" } else { "flex-1" }
        panelStudioClass => if .store.fw_win_w < 768 { .panelTabClass + " h-full flex flex-col overflow-hidden" } else { "flex-1 min-w-0 h-full flex flex-col overflow-hidden border-l border-border bg-card" }
        panelSlotClass => if .studio_mode { .panelStudioClass } else { "shrink-0 h-full flex flex-col overflow-hidden" }
        contentRowClass => if .studio_mode { "flex flex-row-reverse flex-1 min-w-0 h-full overflow-hidden" } else { "flex flex-row flex-1 min-w-0 h-full overflow-hidden" }
        narrowStudio => if .store.fw_win_w < 768 { true } else { false }
    }

    // PLAN-049 T6：branch-row/branch-btn/retry-btn 已迁视图内联工具类（块删除）。
    view {
        row {
            style: "flex flex-row h-full overflow-hidden"
            // Session Sidebar（Plan 023 §3.1：共用 NavSidebar——header + list slot）
            NavSidebar {
                title: t("chat.sessions")
                collapsed: .sidebar_collapsed
                width_class: "w-[240px]"
                slot(name: "actions") {
                    // Plan 407：lucide 图标作 button 子节点（parser 增强后原生支持）。
                    // PLAN-055: icon-only 方钮（variant="icon" 语义经单源类表达，
                    // 两轨一致——gen 侧 shadcn Button 无 icon variant，VM 侧默认
                    // 预设(紫底 + h-10 px-4)由后置类逐项覆盖）。px-0/py-0 显式
                    // 清预设内边距（414 R13：负内容宽 → 图标不可见）；
                    // text-muted-foreground 双主题自适应（深色下浅色图标）。
                    button {
                        onclick: .NewSession
                        style: "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                        title: t("chat.newSession")
                        Plus { size: 16 }
                    }
                    // PLAN-084 T-05: "已归档"过滤开关（开启=列表切已归档面，
                    // 行内 hover 出 📤 取消归档；激活态反色提示）。
                    button {
                        onclick: .ToggleArchived
                        style: if .store.show_archived {
                            "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-accent text-foreground hover:bg-accent cursor-pointer"
                        } else {
                            "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                        }
                        title: t("chat.archivedToggle")
                        icon (name: "archive", size: 15) {}
                    }
                    button {
                        // PLAN-058: 直删改两步确认；Trash2（use.web，VM 空内容）
                        // 改 "×" 字形——VM 轨可见，消除头部隐形可点删除区。
                        onclick: .AskDeleteAll
                        style: "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                        title: t("chat.deleteAllSessions")
                        text "×"
                    }
                }
                slot(name: "list") {
                    col {
                        style: "flex-1 overflow-y-auto px-2 pt-1.5"
                        // PLAN-058 三期→PLAN-059 T9 定稿:删除确认单源双轨——
                        // DeleteConfirmDialog 端口链(vm.at 真源/web.at facade),
                        // VM alert-dialog 受控 open 模态(536 绑定根修+vm.at
                        // 真源后渲染成立,实机 T9 复验)。VM 内联确认行
                        // (session-delete-strip)与 web CSS 抑制规则退役。
                        // PLAN-084 UAT⑨: 关闭态不挂载——VM 受控 open=false
                        // 仍占布局（“今天”上方 ~60px 空白根因，实测）；web 轨
                        // v-model:open 语义不受影响（挂载时机后移，plan 058
                        // 受控语义不变）。
                        if .delete_confirm_open {
                            DeleteConfirmDialog {
                                open: .delete_confirm_open
                                target: .delete_pending_id
                                session_title: t("chat.confirmDeleteSession")
                                all_title: t("chat.confirmDeleteAll")
                                confirm_text: t("chat.confirmDelete")
                                cancel_text: t("chat.cancel")
                                onconfirm: .ConfirmDelete($event)
                                oncancel: .CancelDelete
                            }
                        }
                        // PLAN-083 T-03：切 workspace 骨架——列表未到时脉冲
                        // 占位行（两段式首跳回填前的可见中间态，V-1）。
                        if .store.ws_loading && .store.session_list.length == 0 {
                            col {
                                style: "flex flex-col gap-1.5 px-1 pt-1"
                                div { style: "h-[52px] rounded-lg bg-muted animate-pulse" }
                                div { style: "h-[52px] rounded-lg bg-muted animate-pulse" }
                                div { style: "h-[52px] rounded-lg bg-muted animate-pulse" }
                            }
                        }
        // PLAN-084 T-03: 时间分组标记行（今天/昨天/更早 拍平一维：header
        // 行 + session 行交替，空组剪除；组头文案经 t(.r.label_key) 动态
        // key——useT 普通 closure 两轨可用）。数据源随"已归档"开关切换
        // （helper 内分支，computed 无 if——VM computed 内 if+fn 未证面
        // 规避，T-07 冒烟实证后定案）。
        // for 体单子元素带 key（div 包 if/else）：for 体为 if/else 时
        // codegen 走 template v-for 包裹、key 塌 self.*（vue-tsc 红实锤）。
        // PLAN-084 T-03/T-04: 视图单层 for 直读 store 字段（handler 域分组）。
        // for 体单子元素带 key（div 包 if/else）：for 体为 if/else 时 codegen
        // 走 template v-for 包裹、key 塌 self.*（vue-tsc 红实锤）。
        // PLAN-084 T-03/T-04: 视图单层 for 直读 store 字段（handler 域分组）。
        // for 体单子元素带 key（div 包 if/else）：for 体为 if/else 时 codegen
        // 走 template v-for 包裹、key 塌 self.*（vue-tsc 红实锤）。
        // 组头文案：gkey 三分支 + 字面量 t()——t(动态 key) 在 VM 返空
        // （T-07 冒烟实锤；t(字面量, params) 有旧列表先例）。
        for r in .store.session_rows {
            div {
                key: .r.row_key
                if r.row_kind == "header" {
                    row {
                        style: "flex items-center px-1 pt-2 pb-1 w-full"
                        if r.gkey == "today" {
                            span {
                                style: "text-[11px] font-medium text-muted-foreground tracking-wide"
                                text t("chat.groupToday")
                            }
                        } else {
                            if r.gkey == "yesterday" {
                                span {
                                    style: "text-[11px] font-medium text-muted-foreground tracking-wide"
                                    text t("chat.groupYesterday")
                                }
                            } else {
                                // PLAN-084 UAT⑦+⑧: "更早"头行可点折叠/展开（默认
                                // 折叠）；显式 button（带 onclick 的 span 会被
                                // codegen 升格成默认样式 button——字体变大的根因
                                // ①），text-[11px] 与今天/昨天对齐；chevron 用
                                // lucide icon 右缘对齐（justify-between）。
                                button {
                                    key: .r.gkey
                                    onclick: .ToggleEarlier
                                    style: "w-full flex items-center justify-between px-1 pt-2 pb-1 bg-transparent text-[11px] font-medium text-muted-foreground tracking-wide cursor-pointer hover:text-foreground"
                                    span {
                                        style: "text-[11px]"
                                        text t("chat.groupEarlier")
                                        text " "
                                        text "" + .r.gcount
                                    }
                                    if .store.earlier_collapsed {
                                        icon (name: "chevron-right", size: 12) {}
                                    }
                                    if .store.earlier_collapsed == false {
                                        icon (name: "chevron-down", size: 12) {}
                                    }
                                }
                            }
                        }
                    }
                } else {
                    button {
                        key: .r.sid
                        onclick: .SelectSession(.r.sid)
                        class: if .r.sid == .store.session_id {
                            "session-item relative h-auto w-full flex flex-col items-start justify-start gap-0.5 text-left py-2 px-3 mb-1 rounded-lg border border-transparent bg-primary/10 text-primary hover:bg-primary/20"
                        } else {
                            "session-item relative h-auto w-full flex flex-col items-start justify-start gap-0.5 text-left py-2 px-3 mb-1 rounded-lg border border-transparent bg-transparent hover:bg-accent/40 text-foreground"
                        }
                        mouse-area {
                            style: "w-full"
                            onmouseenter: .HoverSession(.r.sid)
                            onmouseleave: .HoverSessionClear
                            // PLAN-084 UAT⑤：hover 工具组回归。mouse-area 子树
                            // 旧解析器仅支持单臂 if（S002 <else> 实锤）——所有
                            // 分支单臂化；行内 class 预计算进 store（scls）。
                            if .renaming_id == .r.sid {
                                row {
                                    style: "flex items-center w-full gap-1"
                                    input {
                                        style: "flex-1 min-w-0 h-6 text-[13.6px] text-foreground bg-background border border-primary/40 rounded px-1.5 outline-none"
                                        value: .rename_draft
                                        oninput: .RenameDraft($event)
                                    }
                                    span {
                                        style: "w-5 h-5 flex items-center justify-center shrink-0 rounded-md text-sm cursor-pointer text-muted-foreground hover:bg-accent hover:text-foreground"
                                        onclick.stop: .ConfirmRename
                                        text "✓"
                                    }
                                    span {
                                        style: "w-5 h-5 flex items-center justify-center shrink-0 rounded-md text-sm cursor-pointer text-muted-foreground hover:bg-accent hover:text-foreground"
                                        onclick.stop: .CancelRename
                                        text "✕"
                                    }
                                }
                            }
                            row {
                                style: "flex items-start w-full gap-1"
                                span {
                                    title: .r.sname
                                    style: .r.scls
                                    text .r.sname
                                }
                            }
                            // PLAN-084 UAT⑨: 卡片内 hover 全名行撤除（用户否定
                            // 卡片内形态）——浮空 tooltip 需 auto-lang 运行时
                            // 接线（title prop→iced tooltip；tooltip prop 仅
                            // sidebar_menu_button 原生件持有），债已登记。
                            row {
                                style: "flex items-center justify-between w-full gap-1"
                                span {
                                    style: "text-sm text-muted-foreground leading-5"
                                    text t("chat.msgs", { count: .r.scount })
                                }
                                if .hover_session_id == .r.sid {
                                    row {
                                        style: "flex items-center gap-0.5 shrink-0"
                                        span {
                                            style: "w-5 h-5 flex items-center justify-center shrink-0 rounded-md p-0 text-muted-foreground text-sm leading-none cursor-pointer hover:bg-accent/40 hover:text-foreground"
                                            onclick.stop: .StartRenameRow(.r.sid, .r.sname)
                                            title: t("chat.renameSession")
                                            text "✎"
                                        }
                                        // 2026-09-23 用户实报：归档 icon 不渲染——
                                        // span+onclick 升格 button 只保留拍平文本，
                                        // icon（Image）子节点被静默丢弃（VM 坑 #24，
                                        // ✎/× 为 text 子节点幸存）。显式 button 走
                                        // icon 子节点臂（rail/头部同款已实证）。
                                        if .store.show_archived {
                                            button {
                                                style: "w-5 h-5 flex items-center justify-center shrink-0 rounded-md p-0 text-muted-foreground text-sm leading-none cursor-pointer hover:bg-accent/40 hover:text-foreground"
                                                onclick.stop: .ArchiveRow(.r.sid, false)
                                                title: t("chat.unarchiveSession")
                                                icon (name: "archive-restore", size: 13) {}
                                            }
                                        }
                                        if .store.show_archived == false {
                                            button {
                                                style: "w-5 h-5 flex items-center justify-center shrink-0 rounded-md p-0 text-muted-foreground text-sm leading-none cursor-pointer hover:bg-accent/40 hover:text-foreground"
                                                onclick.stop: .ArchiveRow(.r.sid, true)
                                                title: t("chat.archiveSession")
                                                icon (name: "archive", size: 13) {}
                                            }
                                        }
                                        span {
                                            style: "session-delete-btn w-5 h-5 flex items-center justify-center shrink-0 rounded-md p-0 text-muted-foreground text-sm leading-none cursor-pointer hover:bg-accent/40 hover:text-destructive"
                                            onclick.stop: .AskDelete(.r.sid)
                                            title: t("chat.deleteSession")
                                            text "×"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
                }
            }
            }
            // PLAN-093 T-05 §5.2:内容域包装（studio 窄层页签条 + 可反转
            // 内容行）——对话右置经行反转（VM Plan 412 支持），聊天列体
            // 原位不动保持单实例；宽度分层类见 computed 链。
            col {
                style: "flex-1 min-w-0 h-full flex flex-col overflow-hidden"
                if .studio_mode {
                    if .narrowStudio {
                        row {
                            style: "h-9 shrink-0 items-center gap-1 px-2 border-b border-border bg-card"
                            button {
                                onclick: .StudioTabSet("canvas")
                                style: if .studio_tab == "canvas" {
                                    "h-7 px-3 rounded-md bg-accent text-foreground text-[12px] cursor-pointer"
                                } else {
                                    "h-7 px-3 rounded-md bg-transparent text-muted-foreground hover:bg-accent cursor-pointer"
                                }
                                text t("canvas.tabCanvas")
                            }
                            button {
                                onclick: .StudioTabSet("chat")
                                style: if .studio_tab == "chat" {
                                    "h-7 px-3 rounded-md bg-accent text-foreground text-[12px] cursor-pointer"
                                } else {
                                    "h-7 px-3 rounded-md bg-transparent text-muted-foreground hover:bg-accent cursor-pointer"
                                }
                                text t("canvas.tabChat")
                            }
                            button {
                                onclick: .StudioTabSet("structure")
                                style: if .studio_tab == "structure" {
                                    "h-7 px-3 rounded-md bg-accent text-foreground text-[12px] cursor-pointer"
                                } else {
                                    "h-7 px-3 rounded-md bg-transparent text-muted-foreground hover:bg-accent cursor-pointer"
                                }
                                text t("canvas.tabStructure")
                            }
                        }
                    }
                }
                row {
                    style: [.contentRowClass]
            // Main Chat Area（PLAN-093 T-05:studio 分层宽 360/320;<768
            // 页签塌缩 w-0/flex-1——单实例不重挂）
            col {
                style: [.chatColClass]
                // header（Plan 023 §3.1：共用 ContentHeader）。
                // PLAN-084 T-06: 静态"聊天"标题 → 会话名（无选中回退"聊天"）
                // + agent 身份徽章（mode→role）+ 流式状态点；middle 搜索框
                // 退役为 search icon 触发（点击展开/收起）；actions =
                // ✎ 重命名（标题行内编辑入口）+ 🔍 search + 📥 归档。
                ContentHeader {
                    title: .store.header_title
                    fallback: t("chat.title")
                    // PLAN-084 UAT⑧：subtitle（agent 角色徽章）退役——一会话
                    // 未来可能切换多 agent，角色标识易误导（用户裁定）。
                    status: .store.header_status
                    slot(name: "middle") {
                        // 头部标题行内编辑态：middle 槽换输入框（Enter 提交/
                        // Esc 取消；沿行内重命名同一草稿与 handler）。
                        if .header_renaming {
                            div {
                                style: "flex items-center gap-1 max-w-[320px] min-w-[200px] w-[320px]"
                                input {
                                    style: "flex-1 min-w-0 text-[14px] text-foreground bg-background border border-primary/40 rounded-md px-2 py-1 outline-none"
                                    value: .rename_draft
                                    oninput: .RenameDraft($event)
                                    onkeydown.enter.prevent: .ConfirmRename
                                    onkeydown.esc.prevent: .CancelRename
                                }
                            }
                        } else {
                            if .search_open {
                                // 搜索框（原常驻形态，PLAN-084 改 icon 触发展开；
                                // 过滤逻辑 chatSearchFilter 不动）。
                                div {
                                    // PLAN-051 P2-③: 补 min-w-[200px] w-[320px]——VM 轨
                                    // flex-[0_1_320px] 任意值不支持整类丢弃 → 搜索框塌 0
                                    // 被挤压；web 侧仅极窄窗行为微改进（原可压到 0）。
                                    style: "flex items-center gap-[5px] max-w-[320px] min-w-[200px] w-[320px] flex-[0_1_320px] px-3 py-1.5 bg-muted-foreground/5 border border-muted-foreground/10 rounded-md text-muted-foreground"
                                    Search { size: 13, class: "shrink-0" }
                                    input {
                                        style: "w-full text-[13px] text-foreground bg-transparent border-none outline-none placeholder:text-muted-foreground"
                                        value: .chat_search
                                        oninput: .OnSearchInput($event)
                                        placeholder: t("chat.searchPlaceholder")
                                    }
                                }
                            }
                        }
                    }
                    slot(name: "actions") {
                        // PLAN-084 T-06: 工具栏 = ✎ 重命名 + 🔍 搜索 + 📥 归档
                        // （SessionInfo info popover 退役——chat id/消息数/token
                        // 成本入口收敛，KNOWN-DEBT 登记找回路径）。
                        div {
                            style: "flex items-center gap-1 shrink-0"
                            button {
                                onclick: .RenameFromHeader
                                style: "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                                title: t("chat.renameSession")
                                text "✎"
                            }
                            button {
                                onclick: .ToggleSearch
                                style: if .search_open {
                                    "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-accent border border-transparent text-foreground cursor-pointer"
                                } else {
                                    "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent border border-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                                }
                                title: t("chat.searchPlaceholder")
                                Search { size: 15 }
                            }
                            button {
                                onclick: .ArchiveRow(.store.session_id, true)
                                style: "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                                title: t("chat.archiveSession")
                                icon (name: "archive", size: 15) {}
                            }
                            // PLAN-092 T-01: 会话 id 信息入口（084 退役 SessionInfo
                            // 的紧凑回归——仅 id + 复制，token 求和等重逻辑不回归）。
                            button {
                                onclick: .ToggleSessionInfo
                                style: if .info_open {
                                    "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-accent border border-transparent text-foreground cursor-pointer"
                                } else {
                                    "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent border border-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                                }
                                title: t("chat.chatId")
                                Info { size: 15 }
                            }
                            // PLAN-093 T-05:应用设计模式入口（会话头部常驻;
                            // 进出同一钮,激活态反色——studio 布局见面板槽三分支）。
                            button {
                                onclick: .ToggleStudio
                                style: if .studio_mode {
                                    "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-accent border border-transparent text-foreground cursor-pointer"
                                } else {
                                    "inline-flex items-center justify-center h-7 w-7 px-0 py-0 rounded-md bg-transparent border border-transparent text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                                }
                                title: t("canvas.studioToggle")
                                icon (name: "layout-grid", size: 15) {}
                            }
                        }
                    }
                }
                // PLAN-092 T-01: 会话 id 信息条（i icon 展开；弱色单行——
                // id 空态显示 —，session_info.at 先例；复制成功 CopyCheck
                // 常驻至下次复制）。无 tooltip（084-D3 债）。
                if .info_open {
                    div {
                        style: "flex items-center gap-2 shrink-0 px-5 py-1.5 border-b border-border bg-muted/40"
                        span {
                            style: "text-xs text-muted-foreground shrink-0"
                            text t("chat.chatId")
                        }
                        code {
                            style: "text-xs text-foreground flex-1 min-w-0 font-mono truncate"
                            text .sessionIdText
                        }
                        button {
                            onclick: .CopySessionId
                            style: "flex items-center justify-center w-6 h-6 border-none rounded bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground shrink-0 cursor-pointer"
                            title: t("chat.copyChatId")
                            if .info_copied {
                                CopyCheck { size: 13 }
                            } else {
                                Copy { size: 13 }
                            }
                        }
                    }
                }
                // canvas（SecretaryMessage/GateCard/ReportCard + 消息列表 + 流式 draft）
                col {
                    style: "flex-1 overflow-y-auto p-4 flex flex-col gap-6 w-full max-w-[960px] mx-auto"
                    // SecretaryMessageWrapper：gate_reached 触发 useGateInbox.registerGate →
                    // currentSecretary 驱动审批消息条（B 类批4。wrapper 内部 v-if gate 控制显隐）。
                    SecretaryMessageWrapper {
                        onapprove: .SecretaryApprove
                        onreject: .SecretaryReject
                        onsnooze: .SecretarySnooze
                    }
                    // GateCard：gate_reached 事件触发，显示待审批 spec 变更（7.3）
                    if .store.current_gate != None {
                        GateCard {
                            title: ""
                            profession: ""
                            changes: .store.pending_spec_changes
                            onapprove: .ApproveGate
                            onreject: .RejectGate
                        }
                    }
                    // ReportCard：run_completed 事件触发，显示 relay 报告（7.3）
                    if .store.report_data != None {
                        ReportCard {
                            report: .store.report_data
                            deckMeta: None
                            deckHtml: ""
                        }
                    }
                    // PLAN-083 T-03（V-3）：历史向上翻页 pill——has_more 游标
                    // 驱动（滚动到顶自动触发的桥接属后续增量；显式按钮双轨
                    // 可靠，语义=按需到达）。
                    if .store.has_more {
                        button {
                            onclick: .LoadOlder
                            style: "self-center shrink-0 h-7 px-3 py-0 mb-2 rounded-full border border-border bg-card text-muted-foreground text-xs hover:bg-accent cursor-pointer"
                            text .olderLabel
                        }
                    }
                    // PLAN-083 T-03：首屏骨架——详情未到且无消息时的脉冲
                    // 占位（两段式第二跳回填前的可见中间态）。
                    if .store.ws_loading && .store.messages.length == 0 {
                        col {
                            style: "flex flex-col gap-3 w-full"
                            div { style: "h-16 rounded-xl bg-muted animate-pulse" }
                            div { style: "h-10 w-2/3 rounded-xl bg-muted animate-pulse" }
                            div { style: "h-24 rounded-xl bg-muted animate-pulse" }
                        }
                    }
                    for msg in .filteredMessages {
                        col {
                            key: .msg.id
                            // PLAN-043: 同分叉点的兄弟分支切换器（PLAN-055 ⑤：
                            // "⑂ 重试"按钮删除——用户对拍裁决，重试语义由分支
                            // 切换器与新发消息承载）。
                            row {
                                style: "flex gap-1 mb-[2px]"
                                for be in .branchEntries {
                                    if be.for_id == .msg.id {
                                        button {
                                            // R006(strict):v-for 项需 :key。
                                            key: be.sib.id
                                            // PLAN-055: 显式高度——VM button 默认
                                            // size 预设 h-10 会把 pill 撑成大块。
                                            style: "text-[11px] h-[22px] py-[1px] px-2 rounded-full border border-border bg-transparent text-muted-foreground cursor-pointer max-w-[160px] truncate"
                                            text "⑂ " + chatBranchLabel(be.sib.content)
                                            onclick: .BranchTo(be.sib.id, "navigate")
                                        }
                                    }
                                }
                            }
                            // ChatMessage 独立组件: 有序 block 流.
                            // 工具卡随 block 内联渲染.
                            ChatMessage {
                                msg: .msg
                                is_streaming: isMsgStreaming(.store.streaming, .store.messages, .msg)
                                errands: .store.errands
                                relays: .store.relays
                                task_plans: .store.task_plans
                                // PLAN-055 T13 + PLAN-059 T9 三次定案：展开键列表
                                // 经 prop 下传（子件 computed 读 store 前缀不可达,
                                // 只读自身 props;prop 每帧重建刷新）。
                                think_open: .store.think_open
                                tool_open: .store.tool_open
                                // PLAN-077 T-04：onfork 双端皆断（VM 派发键
                                // "on"+msg 名折叠 = onforkfrom ≠ onfork；Vue
                                // @fork 对 emit('ForkFrom') 不命中）——改 snake
                                // 全名形 on_fork_from：VM 折叠剥下划线命中，
                                // Vue snake_to_pascal → @ForkFrom 命中 emit。
                                on_fork_from: .ForkFrom($event)
                            }
                            // 问卷卡片（专门的提问 block）：解析 assistant 消息里的
                            // 问卷 JSON/问题列表渲染为可选项表单。仅随最新一条消息
                            // 显示（lastMessageId 来自 useChatSearch composable，
                            // .at if 条件不支持多参 fn）——已回答的旧问题不再常驻表单。
                            if .msg.role == "assistant" {
                                if hasQuestionnaire(.msg) {
                                    if .msg.id == .lastMsgId {
                                        QuestionnaireCard {
                                            questions: getQuestions(.msg)
                                            onsubmit: .OnQuestionnaireSubmit($event)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // 流式等待指示：内容本身由 forge_stream 回写进 assistant 消息
                    // （messages 循环里的 ChatMessage 气泡），不在此重复渲染
                    // current_draft——此前 draft 区和气泡双写导致 AI 回复显示两遍。
                    // 仅在首个 delta/thinking 到达前显示等待指示（pulse 动画）。
                    // PLAN-071 需求⑥→⑧：思考期反馈由乐观气泡内的
                    // ThinkBlock 半开态承载（本状态行组件已删除——与
                    // ThinkBlock 双重显示，用户裁定冗余）。
                    // PLAN-071 需求⑨：启动窗口等待点与停止按钮均迁入
                    // ChatMessage 气泡（等待点 = 气泡内三点动画；停止钮 =
                    // 气泡工具栏复制/分叉旁）——本画布级独立停止按钮退役。
                    // PLAN-093 T-08:队列条目级 UI（逐条文本 + 附件标 + 移除）。
                    if .store.pending_msgs.length > 0 {
                        col {
                            style: "shrink-0 mx-4 mb-1 rounded-md border border-border bg-muted/40 overflow-hidden"
                            for q in .store.pending_msgs {
                                row {
                                    style: "items-center gap-2 px-3 py-1 border-b border-border last:border-b-0"
                                    span {
                                        style: "text-[11px] text-muted-foreground shrink-0"
                                        text "⏳"
                                    }
                                    if q.ctx != None {
                                        span {
                                            style: "text-[10px] text-primary shrink-0"
                                            text "📎"
                                        }
                                    }
                                    span {
                                        style: "flex-1 min-w-0 text-[11.5px] text-foreground/80 truncate"
                                        text q.text
                                    }
                                    button {
                                        onclick: .QueueRemoveText(q.text)
                                        style: "shrink-0 w-5 h-5 px-0 flex items-center justify-center rounded-md bg-transparent text-muted-foreground hover:bg-accent text-[10px] cursor-pointer border-none"
                                        title: "移除"
                                        text "×"
                                    }
                                }
                            }
                        }
                    }
                    if .store.error != "" {
                        text .store.error { style: "text-destructive text-[14px] py-2 px-3 bg-destructive/10 rounded-lg self-start max-w-full" }
                    }
                }
                // input bar（MentionInput 逃生舱；onsend/oncancel 避开原生 submit/stop 名）。
                // PLAN-064 独立思考档位行已收编进 composer 工具栏（zcode/codex
                // 式一体化改版,2026-09-07）——档位经 thinkingLevel prop 下入、
                // pick 事件上抛,落库仍走 PickThinking → store.SetThinkingLevel
                // （UI 态 + PATCH 持久化到会话；档位生效于下一次发送,流式中禁用）。
                // PLAN-093 T-08:元素附件 chip（composer 上方；实时读
                // canvasStore 拾取面——移除/聚焦不改文本，SendInput 冻结）。
                if canvasStore.cv_picked_id != "" {
                    row {
                        style: "shrink-0 items-center gap-2 px-4 py-1.5 border-t border-border bg-muted/40"
                        span {
                            style: "text-[11px] text-foreground truncate flex-1 min-w-0"
                            if canvasStore.cv_picked_label != "" {
                                text t("canvas.ctxSelected") + "：" + canvasStore.cv_picked_kind + " · " + canvasStore.cv_picked_label
                            } else {
                                text t("canvas.ctxSelected") + "：" + canvasStore.cv_picked_kind
                            }
                        }
                        button {
                            onclick: .CtxModifyFocus
                            style: "shrink-0 h-6 px-2 rounded-md bg-transparent text-muted-foreground hover:bg-accent text-[11px] cursor-pointer border-none"
                            title: t("canvas.ctxModify")
                            text t("canvas.ctxModify")
                        }
                        button {
                            onclick: .CtxRemove
                            style: "shrink-0 w-5 h-5 px-0 flex items-center justify-center rounded-md bg-transparent text-muted-foreground hover:bg-accent text-[11px] cursor-pointer border-none"
                            title: t("canvas.ctxRemove")
                            text "×"
                        }
                    }
                }
                MentionInput {
                    disabled: .store.streaming
                    // .at 无可选 props：professions 必填，传空串走 helper 兜底
                    // （props.professions > 动态 configs > DEFAULT_PROFESSIONS）。
                    professions: ""
                    thinkingLevel: .store.thinking_level
                    // PLAN-067 T-05: 审批模式（human|auto）同款下入/上抛——
                    // 落库走 PickApproval → store.SetApprovalMode（UI 态 +
                    // PATCH 持久化;后端 relay driver 遇 gate 读会话模式）。
                    approvalMode: .store.approval_mode
                    onsend: .SendInput($event)
                    oncancel: .StopStream
                    onpick: .PickThinking($event)
                    onpickapproval: .PickApproval($event)
                }
            }
            // PLAN-087 T-07 + PLAN-093 T-05: 实况画布面板——工作台槽升主区
            // （flex-1;两列/空工作台/页签分支在 CanvasStore 域子件内），正常
            // 520 右列 CanvasPanel；<768 页签塌缩。
            col {
                style: [.panelSlotClass]
                if .studio_mode {
                    CanvasStudioSlot { tab: .studio_tab }
                } else {
                    CanvasPanel {}
                }
            }
                }
            }
        }
    }

    on {
        .Init -> {
            ForgeStore.Init();
            // AgentConfigs 由 MentionInput 挂载时 Init（ professions 拉取）。
        }

        // PLAN-093 T-05:studio 进出——侧栏偏好保存/恢复（退出还原进入前
        // 的折叠态;进入强制收起给工作台让宽）。
        .ToggleStudio -> {
            if .studio_mode {
                .studio_mode = false
                .sidebar_collapsed = .sidebar_prev
            } else {
                .studio_mode = true
                .sidebar_prev = .sidebar_collapsed
                .sidebar_collapsed = true
            }
        }

        // PLAN-093 T-05 §5.2 窄层：工作台页签切换（画布/对话/结构）。
        .StudioTabSet(val) -> {
            .studio_tab = val
        }

        // PLAN-093 T-08:附件 chip 动作——聚焦现有 composer（不发送、
        // 不改文本）；移除走 CanvasStore.ClearPick（后端+本地双面）。
        .CtxModifyFocus -> {
            platformFocusComposer()
        }
        .CtxRemove -> {
            // 后端 {clear:true}（防轮询回填）+ CanvasStore 投影清（双面）。
            canvasClearPick().await
            canvasStore.ClearPick()
        }

        // PLAN-051 P3-②: 单参 oninput 双轨契约——vue codegen 自动包
        // ($event.target).value 传入，两轨 val 均为纯文本；此前 val.target.value
        // 在 VM 得 0（GET_FIELD on Str）、在 web 得 undefined。
        .OnSearchInput(val) -> { .chat_search = val }

        // PLAN-064: 档位选择→store（UI 态 + PATCH 持久化到会话）。
        .PickThinking(level) -> { store.SetThinkingLevel(level) }

        // PLAN-067 T-05: 审批模式落库（UI 态 + PATCH 持久化到会话）。
        .PickApproval(mode) -> { store.SetApprovalMode(mode) }

        // PLAN-061 T16 (D22):新建会话后自动聚焦 composer(此前需手点输入框)。
        .NewSession -> {
            store.NewSession()
            platformFocusComposer()
        }

        // PLAN-058 三期:Ask* 置 pending + open（alert-dialog 受控态）;取消
        // （含 reka-ui ESC/遮罩关闭路径,统一折算 oncancel）与 SelectSession
        // 复位双字段;ConfirmDelete 分流单删/全删（target 注入）并复位。
        .AskDelete(id) -> {
            .delete_pending_id = id;
            .delete_confirm_open = true
        }

        .AskDeleteAll -> {
            .delete_pending_id = "__all__";
            .delete_confirm_open = true
        }

        .CancelDelete -> {
            .delete_pending_id = "";
            .delete_confirm_open = false
        }

        // PLAN-058 三期:ConfirmDelete 统一确认入口——target 为会话 id 走单删,
        // "__all__"(DeleteConfirmDialog target 注入)走全删;双字段一并复位。
        .ConfirmDelete(id) -> {
            if id == "__all__" {
                chats_delete_all_sessions();
                store.session_id = "";
                store.messages = [];
            } else {
                chats_delete_session(id);
            }
            .delete_pending_id = "";
            .delete_confirm_open = false;
            store.LoadSessionList()
        }

        // PLAN-060 T2:分叉——经 store.BranchTo fork 模式调 chats_fork_session,
        // 重载后列表出新会话、原消息树出新分支（切换器随之可见）。
        .ForkFrom(mid str) -> {
            store.BranchTo(mid, "fork")
        }

        // PLAN-071 需求⑨：CancelRun handler 随画布级停止按钮退役
        // （ChatMessage 工具栏停止钮直调 ForgeStore.CancelRun）。
        .SelectSession(id) -> {
            .delete_pending_id = "";
            .delete_confirm_open = false;
            store.SwitchSession(id)
        }

        // PLAN-083 T-03：历史向上翻页（has_more 游标驱动，回填前插合并）。
        .LoadOlder -> {
            store.LoadOlder()
        }

        // 2026-09-04:hover 会话 × 显隐(mouse-area onmouseenter/onmouseleave;
        // 离开清空,进入置 id——相邻卡先 clear 后 enter,无抖动)。
        .HoverSession(id) -> { .hover_session_id = id }
        .HoverSessionClear -> { .hover_session_id = "" }

        // ── PLAN-084 T-04/T-06：重命名 / 搜索 / 归档视图 ──────────────

        // StartRename(id): 行进入编辑态，草稿预填当前名（两表都查——归档
        // 视图下的行在 archived_list）。
        .StartRename(id) -> {
            .renaming_id = id;
            .rename_draft = id
        }

        // StartRenameRow(id, name): 行内铅笔直接携带行名（视图侧不再查表——
        // use.web.fn 视图调用 VM 侧不可靠，T-07 实证）。
        .StartRenameRow(id, name) -> {
            .renaming_id = id;
            .rename_draft = name
        }

        .RenameDraft(val) -> { .rename_draft = val }

        // ConfirmRename: 空 draft 静默收场（不落空名）；头部/行内两态一并
        // 复位。净空口径 mention_trim 与发送链一致。
        .ConfirmRename -> {
            let nn = mention_trim(.rename_draft)
            if nn != "" {
                store.RenameSession(.renaming_id, nn)
            }
            .renaming_id = "";
            .header_renaming = false;
            .rename_draft = ""
        }

        .CancelRename -> {
            .renaming_id = "";
            .header_renaming = false;
            .rename_draft = ""
        }

        // RenameFromHeader: 头部铅笔——预填当前会话名并收起搜索框。
        .RenameFromHeader -> {
            if .store.session_id != "" {
                .header_renaming = true;
                .search_open = false;
                .rename_draft = .store.header_title
            }
        }

        .ToggleSearch -> {
            if .search_open {
                .search_open = false
            } else {
                .search_open = true;
                .header_renaming = false
            }
        }

        // ── PLAN-092 T-01：会话 id 信息入口 ──
        // ToggleSessionInfo: i icon 展开/收起信息条（与搜索框互斥收起行内编辑，
        // 沿 ToggleSearch 先例）。
        .ToggleSessionInfo -> {
            if .info_open {
                .info_open = false
            } else {
                .info_open = true;
                .header_renaming = false
            }
        }

        // CopySessionId: dom.copy_text 直拷（029 T21 先例）；✓ 态常驻至下次
        // 复制——收起再展开不清除，仅下次 CopyId 覆盖。
        // CopySessionId: dom.copy_text 直拷（029 T21 先例）；✓ 态常驻至下次
        // 复制——收起再展开不清除，仅下次 CopyId 覆盖。
        // KNOWN-DEBT 092-D1：VM 轨 dom.copy_text native 静默失效（0927 实机
        // 三探针定罪：handler 正常进入/字段读 len=24 正确/native 调用后无
        // 剪贴板写入，let 绑定形态中止、裸调用形态静默空转；web 轨
        // navigator.clipboard 正常）。auto-lang 平台债（2926 native 在视图
        // handler 上下文），id 可见性半臂不受影响。
        .CopySessionId -> {
            dom.copy_text(.store.session_id);
            .info_copied = true
        }

        // ToggleArchived: 归档过滤开关（无 ! 取反语法，显式双臂）。切出
        // 归档视图时一并退出行内编辑态。
        // ToggleEarlier: "更早"折叠切换（当前态经 store 读，显式双臂转发）。
        .ToggleEarlier -> {
            if .store.earlier_collapsed {
                store.SetEarlierCollapsed(false)
            } else {
                store.SetEarlierCollapsed(true)
            }
        }

        .ToggleArchived -> {
            if .store.show_archived {
                store.SetShowArchived(false)
            } else {
                store.SetShowArchived(true)
            }
            .renaming_id = "";
            .header_renaming = false
        }

        .ArchiveRow(id, archived) -> { store.ArchiveSession(id, archived) }

        // SendInput(text): MentionInput 的 onsubmit 回调。先检测 /relay//superpower//spec1
        // 命令（relay_command_match 非 None 表示已处理，runner 接线执行），
        // 否则走普通发送 + SSE 流。
        // PLAN-051 T8: 消费回调实参 text——原读 .text（统一态下是 MentionInput
        // 的字段，子 handler 已先清空 → 守卫恒假，发送被静默丢弃）。沿 017-chat
        // SendMessage(text) 的参数契约；mention_trim 统一净空口径。
        .SendInput(text) -> {
            let tt = mention_trim(text)
            if tt != "" {
                let cmd = relay_command_match(tt);
                .input = "";
                if cmd == None {
                    // PLAN-093 T-08:附件快照冻结——确认普通消息后（命令/
                    // mention 不受上下文影响）；快照 = 当前拾取面字段值。
                    var ctx = None
                    if canvasStore.cv_picked_id != "" {
                        ctx = { version: "1", workspace_id: .store.workspace, conversation_id: .store.session_id, generation_id: canvasStore.cv_gen, frame_seq: canvasStore.cv_seq, app_path: canvasStore.cv_app, vnode_id: canvasStore.cv_picked_id, kind: canvasStore.cv_picked_kind, label: canvasStore.cv_picked_label, source_path: canvasStore.cv_picked_source_path, source_line: canvasStore.cv_picked_source_line }
                    }
                    // PLAN-071 需求⑮：运行在途时消息入队（画布显示排队指示
                    // 条，流式收束后 store.FlushQueue 自动按 FIFO 发送），
                    // 不再触发后端 busy 拒绝链路（后者保留为跨标签页兜底）。
                    if .store.streaming {
                        if ctx == None {
                            store.QueueMessage(tt)
                        } else {
                            store.QueueWithCtx(tt, ctx)
                        }
                    } else {
                        if ctx == None {
                            store.Send(tt)
                        } else {
                            store.SendWithCtx(tt, ctx)
                        }
                    }
                } else {
                    platformRunRelayCommand(cmd)
                }
            }
        }

        // StopStream: 停止 SSE 流。
        .StopStream -> {
            store.StopStream()
        }

        // B 类批4：ApproveGate/RejectGate 调真实 API（store.ApproveGate/RejectGate
        // 内部调 chats_approve/chats_reject_all + 清 current_gate）。
        .ApproveGate -> {
            store.ApproveGate()
        }

        .RejectGate -> {
            store.RejectGate()
        }

        // B 类批4：SecretaryMessage 审批按钮。wrapper 内部已调 useGateInbox.resolveGate/
        // dismissSecretary（本地态），widget handler 留作未来真实 API 接入点。
        .SecretaryApprove -> { store.ApproveGate() }
        .SecretaryReject -> { store.RejectGate() }
        .SecretarySnooze -> { store.ClearGate() }

        // OnQuestionnaireSubmit(text): 问卷提交。载荷已是格式化文本
        // （QuestionnaireCard 内 formatQuestionnaireAnswers："Q1: A; Q2: B"），
        // 直接作为用户消息发回 + 乐观插入 + 启动 SSE。
        .OnQuestionnaireSubmit(text) -> {
            if .text != "" {
                store.Send(.text);
                store.StartStream(.store.session_id, .store.workspace, .store.token, .text)
            }
        }
    }
}
