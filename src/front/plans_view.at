// plans_view.at — Plans 视图（对应 web/src/views/PlansView.vue）
//
// PLAN-024 任务6：plan 列表 + 详情 + 状态流转 + merge 沉淀。
// 0923 用户裁定三修：①已归档栏目（折叠组头，include_archived 同车分流）；
// ②详情正文走 Markdown 组件（autodown 引擎；meta/正文改读 store 标量——
// plans_frontmatter.ts 的 use.web fn 在 VM computed 静默返空=视图坑 #1）；
// ③「编辑」按钮退役（编辑态机制保留 handler 域不删，未来换入口可复用）。

use store: PlansStore

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web useT from "src/front/ports/composables.at"
use.web component Plus from "src/front/ports/icons.at"
// PLAN-063 T8 (D4): 详情 = frontmatter 元数据 chips + Markdown 正文
// (复用聊天轨 Markdown 组件;裸文本/无围栏 md 回退 body=原文)。
use.web component Markdown from "src/front/ports/renderer.at"

// PLAN-037 P1: cross-file component refs (native alias form).
use nav_sidebar: NavSidebar
use content_header: ContentHeader

widget PlansView {

    setup {
        let t = useT()
    }

    msg Msg {
        Init,
        Reload,
        SelectPlan(int),
        StartCreate,
        ConfirmCreate,
        CancelCreate,
        StartEdit,
        CancelEdit,
        SaveEdit,
        ArchiveCurrent,
        MergeCurrent,
        TransitionTo(str),
        CreateNameChanged,
        EditContentChanged,
        ToggleArchived,
    }

    model {
        var selected_seq Option<int> = None
        var creating bool = false
        var new_name str = ""
        var editing bool = false
        var edit_content str = ""
        // 已归档栏目折叠态（chats「更早」同款：头行常驻，行默认收起）。
        var archived_open bool = false
        // PLAN-060 T3:流转目标状态常量——VM builder 丢弃纯字面量事件参数的
        // 按钮（onclick: .TransitionTo(.st_drafting) 整钮不渲染,实机快照实证;
        // gen vue 侧正常）,dot-path 实参是渲染安全形。
        var st_drafting str = "drafting"
        var st_executing str = "executing"
        var st_execution_done str = "execution_done"
        var st_reviewed str = "reviewed"
    }

    computed {
        // PLAN-071 需求⑫：选中高亮以 store.current 为准——Init 自动选中
        // 第一篇后（store 内 LoadPlan 异步完成）高亮与内容保持一致；
        // selected_seq 保留为无选中时的回退。
        selectedSeq => if .store.current != None { .store.current.seq } else { .selected_seq }
    }

    view {
        col {
            style: "flex flex-col h-full overflow-hidden"
        row {
            style: "flex flex-row h-full overflow-hidden"
            // 左侧 plan 列表
            NavSidebar {
                title: t("plans.title")
                collapsed: false
                width_class: "w-[240px]"
                slot(name: "actions") {
                    button {
                        onclick: .StartCreate
                        style: "inline-flex items-center justify-center h-[26px] px-2 text-xs border border-border rounded-md bg-transparent text-foreground hover:bg-accent"
                        title: t("plans.newPlan")
                        Plus { size: 14 }
                    }
                }
                slot(name: "list") {
                    col {
                        // PLAN-071 需求⑪：列表容器与会话/规范对齐（滚动 + 顶距），
                        // 原 plans-nav-list 单行按钮列表退役。
                        style: "flex-1 overflow-y-auto px-2 pt-3"
                        if .store.loading {
                            text t("plans.loading")
                        } else if .store.error != "" {
                            text t("workspaceUi.loadFailed") { style: "text-sm text-muted-foreground p-3" }
                            button { onclick: .Reload; style: "h-8 px-3 rounded-md bg-muted text-foreground text-sm"; text t("workspaceUi.retry") }
                        } else {
                            for plan in .store.plans {
                                button {
                                    key: .plan.seq
                                    onclick: .SelectPlan(.plan.seq)
                                    // PLAN-071 需求⑪：与会话/规范二级导航同构的
                                    // 两行盒（session-item 形态）——标题行
                                    // truncate + 悬停全名，副标题行 = 状态 badge
                                    // （draft/executing/execution_done/reviewed/
                                    // archived 等原样展示）。
                                    class: if .plan.seq == .selectedSeq {
                                        "session-item h-auto w-full text-left flex flex-col items-start justify-start gap-0.5 py-2 px-3 mb-1 rounded-lg border border-transparent bg-primary/10 text-primary cursor-pointer"
                                    } else {
                                        "session-item h-auto w-full text-left flex flex-col items-start gap-0.5 py-2 px-3 mb-1 rounded-lg border border-transparent bg-transparent hover:bg-accent text-foreground cursor-pointer"
                                    }
                                    span {
                                        title: .plan.id + " — " + .plan.feature_name
                                        style: "text-[13.6px] font-medium truncate max-w-full"
                                        text .plan.id
                                        text " — "
                                        text .plan.feature_name
                                    }
                                    // PLAN-091 T-04（065-F1 余项）：状态徽标
                                    // 本地化——静态键 if-chain（VM t 动态键
                                    // quirk 规避），未知状态回退原始值。
                                    span {
                                        style: "px-2 py-0.5 rounded-md text-xs bg-accent text-foreground"
                                        if .plan.status == "drafting" {
                                            text t("plans.statusDrafting")
                                        } else if .plan.status == "executing" {
                                            text t("plans.statusExecuting")
                                        } else if .plan.status == "execution_done" {
                                            text t("plans.statusExecutionDone")
                                        } else if .plan.status == "reviewed" {
                                            text t("plans.statusReviewed")
                                        } else if .plan.status == "archived" {
                                            text t("plans.statusArchived")
                                        } else {
                                            text .plan.status
                                        }
                                    }
                                }
                            }
                            // 0923 用户裁定：已归档栏目——折叠组头（chats
                            // 「更早」同构：头行常驻+计数+右缘 chevron，行
                            // 默认收起）。点击归档行 plans_get 直读 archived/
                            // 文件（plans.rs:655 既有语义）。
                            if .store.archived_count > 0 {
                                button {
                                    onclick: .ToggleArchived
                                    style: "w-full flex items-center justify-between px-3 py-1.5 mb-1 rounded-md text-muted-foreground hover:bg-accent/40 cursor-pointer"
                                    span {
                                        style: "text-[11px]"
                                        text t("plans.archivedSection")
                                        text " "
                                        text "" + .store.archived_count
                                    }
                                    if .archived_open {
                                        icon (name: "chevron-down", size: 12) {}
                                    }
                                    if .archived_open == false {
                                        icon (name: "chevron-right", size: 12) {}
                                    }
                                }
                                if .archived_open {
                                    for plan in .store.archived_plans {
                                        button {
                                            // R001 去重：归档臂 key 加 arc- 前缀
                                            //（与活跃臂同 seq 不再撞键；R046
                                            // 安全拼接）。
                                            key: "arc-" + .plan.seq
                                            onclick: .SelectPlan(.plan.seq)
                                            class: if .plan.seq == .selectedSeq {
                                                "session-item h-auto w-full text-left flex flex-col items-start justify-start gap-0.5 py-2 px-3 mb-1 rounded-lg border border-transparent bg-primary/10 text-primary cursor-pointer"
                                            } else {
                                                "session-item h-auto w-full text-left flex flex-col items-start gap-0.5 py-2 px-3 mb-1 rounded-lg border border-transparent bg-transparent hover:bg-accent text-muted-foreground cursor-pointer"
                                            }
                                            span {
                                                title: .plan.id + " — " + .plan.feature_name
                                                style: "text-[13.6px] font-medium truncate max-w-full"
                                                text .plan.id
                                                text " — "
                                                text .plan.feature_name
                                            }
                                            // PLAN-091 T-04：归档栏徽标同链路
                                            // 本地化（archived 恒命中，其余
                                            // 分支兜异常数据）。
                                            span {
                                                style: "px-2 py-0.5 rounded-md text-xs bg-accent text-foreground"
                                                if .plan.status == "drafting" {
                                                    text t("plans.statusDrafting")
                                                } else if .plan.status == "executing" {
                                                    text t("plans.statusExecuting")
                                                } else if .plan.status == "execution_done" {
                                                    text t("plans.statusExecutionDone")
                                                } else if .plan.status == "reviewed" {
                                                    text t("plans.statusReviewed")
                                                } else if .plan.status == "archived" {
                                                    text t("plans.statusArchived")
                                                } else {
                                                    text .plan.status
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // 右侧主内容区
            col {
                style: "flex-1 flex flex-col min-w-0 overflow-hidden"
                if .store.current != None {
                    ContentHeader {
                        title: .store.current.id
                        slot(name: "actions") {
                            // PLAN-060 T3:状态流转触发面（TransitionTo 此前孤儿——
                            // 048 DEGRADED 清单里唯一 plans 域缺口）。四态按钮组,
                            // 当前态自身隐藏;后端校验非法迁移。
                            row {
                                style: "flex gap-1 mr-2 items-center"
                                button {
                                    onclick: .TransitionTo(.st_drafting)
                                    style: "py-1 px-2 rounded text-[11px] cursor-pointer border border-border bg-transparent text-muted-foreground hover:bg-accent"
                                    text t("workspaceUi.draft")
                                }
                                button {
                                    onclick: .TransitionTo(.st_executing)
                                    style: "py-1 px-2 rounded text-[11px] cursor-pointer border border-border bg-transparent text-muted-foreground hover:bg-accent"
                                    text t("workspaceUi.executing")
                                }
                                button {
                                    onclick: .TransitionTo(.st_execution_done)
                                    style: "py-1 px-2 rounded text-[11px] cursor-pointer border border-border bg-transparent text-muted-foreground hover:bg-accent"
                                    text t("workspaceUi.done")
                                }
                                button {
                                    onclick: .TransitionTo(.st_reviewed)
                                    style: "py-1 px-2 rounded text-[11px] cursor-pointer border border-border bg-transparent text-muted-foreground hover:bg-accent"
                                    text t("workspaceUi.reviewed")
                                }
                            }
                            button {
                                onclick: .ArchiveCurrent
                                style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border"
                                text t("plans.archive")
                            }
                            if .store.current.status == "reviewed" {
                                button {
                                    onclick: .MergeCurrent
                                    style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border bg-primary text-primary-foreground border-primary hover:opacity-90"
                                    text t("plans.mergeToSpec")
                                }
                            }
                        }
                    }
                    col {
                        style: "flex-1 overflow-y-auto p-5"
                        if .editing {
                            textarea {
                                value: .edit_content
                                oninput: .EditContentChanged
                                style: "w-full min-h-[200px] p-3 border border-border rounded-md bg-background text-foreground text-sm font-mono"
                            }
                            row {
                                style: "flex gap-2 justify-end"
                                button {
                                    onclick: .SaveEdit
                                    style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-primary hover:text-primary-foreground hover:border-primary"
                                    text t("plans.save")
                                }
                                button {
                                    onclick: .CancelEdit
                                    style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-accent"
                                    text t("plans.cancel")
                                }
                            }
                        } else {
                            // PLAN-063 T8 (D4): meta chips + Markdown 正文。
                            // 0923：chips 改读后端权威字段（PlanFile
                            // id/status/feature_name）+ store 拆好的步进标尺；
                            // 正文读 store.current_body（视图坑 #1 处方）。
                            col {
                                style: "flex flex-col gap-3"
                                if .store.current.id != "" {
                                    row {
                                        style: "flex flex-wrap items-center gap-2"
                                        span { style: "px-2 py-0.5 rounded-md text-xs font-mono bg-primary/10 text-primary", text .store.current.id }
                                        // PLAN-091 T-04（065-F1 余项）：详情
                                        // 状态 chip 本地化，未知状态回退原值。
                                        span {
                                            style: "px-2 py-0.5 rounded-md text-xs bg-accent text-foreground"
                                            if .store.current.status == "drafting" {
                                                text t("plans.statusDrafting")
                                            } else if .store.current.status == "executing" {
                                                text t("plans.statusExecuting")
                                            } else if .store.current.status == "execution_done" {
                                                text t("plans.statusExecutionDone")
                                            } else if .store.current.status == "reviewed" {
                                                text t("plans.statusReviewed")
                                            } else if .store.current.status == "archived" {
                                                text t("plans.statusArchived")
                                            } else {
                                                text .store.current.status
                                            }
                                        }
                                        if .store.current_step_label != "" {
                                            span { style: "px-2 py-0.5 rounded-md text-xs font-mono bg-muted text-muted-foreground", text .store.current_step_label }
                                        }
                                        if .store.current.feature_name != "" {
                                            span { style: "text-sm text-muted-foreground", text .store.current.feature_name }
                                        }
                                    }
                                }
                                Markdown(source: .store.current_body, streaming: false)
                            }
                        }
                    }
                } else {
                    col {
                        style: "flex-1 flex flex-col items-center justify-center p-8 gap-4 text-center"
                        if .store.loading {
                            text t("plans.loading") { style: "text-sm text-muted-foreground" }
                        } else {
                            text t("workspaceUi.plansEmptyTitle") { style: "text-xl font-semibold text-foreground" }
                            text t("workspaceUi.plansEmptyBody") { style: "text-sm text-muted-foreground max-w-[400px] leading-6" }
                            button { onclick: .StartCreate; style: "h-9 px-4 rounded-lg bg-primary text-primary-foreground text-sm font-medium hover:opacity-90"; text t("plans.newPlan") }
                        }
                    }
                }
            }
        }
        // 新建 plan 对话框
        if .creating {
            col {
                style: "fixed inset-0 bg-black/50 flex items-center justify-center z-50"
                col {
                    style: "bg-card border border-border rounded-lg p-6 w-full max-w-md flex flex-col gap-3"
                    h3 t("plans.newPlan") {}
                    label t("plans.featureName")
                    input {
                        value: .new_name
                        oninput: .CreateNameChanged
                        style: "py-2 px-2.5 border border-border rounded-md bg-background text-foreground text-sm"
                    }
                    row {
                        style: "flex gap-2 justify-end"
                        button {
                            onclick: .ConfirmCreate
                            style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-primary hover:text-primary-foreground hover:border-primary"
                            text t("plans.create")
                        }
                        button {
                            onclick: .CancelCreate
                            style: "py-1.5 px-[14px] rounded-md text-[13px] cursor-pointer bg-card text-foreground border border-border hover:bg-accent"
                            text t("plans.cancel")
                        }
                    }
                }
            }
        }
        }
    }

    on {
        .Reload -> { PlansStore.LoadPlans() }
        .Init -> {
            // PLAN-081：web 轨挂载期 Init 派发；App.ShowPlans 代派兜底
            // （VM 轨子件 Init 不派发——PLAN-048 T5 口径，FilesView 同款
            // 守卫防双拉）。
            if .store.plans_loaded != true {
                PlansStore.Init()
            }
        }

        .SelectPlan(seq) -> {
            .selected_seq = seq;
            .editing = false;
            store.LoadPlan(seq)
        }

        .StartCreate -> {
            .new_name = "";
            .creating = true
        }

        .ConfirmCreate -> {
            if .new_name != "" {
                store.CreatePlan(.new_name);
                .creating = false
            }
        }

        .CancelCreate -> {
            .creating = false
        }

        .StartEdit -> {
            if .store.current != None {
                .edit_content = .store.current.content;
                .editing = true
            }
        }

        .CancelEdit -> {
            .editing = false
        }

        .SaveEdit -> {
            if .store.current != None {
                store.UpdatePlan(.store.current.seq, .edit_content);
                .editing = false
            }
        }

        .ArchiveCurrent -> {
            if .store.current != None {
                store.ArchivePlan(.store.current.seq)
            }
        }

        .MergeCurrent -> {
            if .store.current != None {
                store.MergePlan(.store.current.seq)
            }
        }

        .TransitionTo(status) -> {
            if .store.current != None {
                store.TransitionPlan(.store.current.seq, status)
            }
        }

        // v-model marker handlers（U5）
        .CreateNameChanged -> { .new_name = .new_name }
        .EditContentChanged -> { .edit_content = .edit_content }

        // 已归档栏目折叠切换（chats ToggleEarlier 同款视图本地态）。
        .ToggleArchived -> {
            if .archived_open {
                .archived_open = false
            } else {
                .archived_open = true
            }
        }
    }
}
