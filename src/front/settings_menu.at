// settings_menu.at — SettingsMenu 组件（Plan 023 队列 A4：最复杂 async 逃生舱原生化）
//
// 对标 src/front/components/SettingsMenu.vue（逃生舱，已删除）。
// 验证 §10.7 async handler（SetForgeMode/OpenAutoOs .await）+ §10.4 composable
// facade refs（mode/current/locale 自动 .value）+ §10.3 宿主全局。
//
// 关键转换：
//   - useI18n/useTheme/useAccentColor → composable facade（refs 标注 ref 字段）
//   - 语言切换/forge mode/autoos 深链 → settings_helpers.ts fn（.at 无法表达
//     composable ref 赋值 + fetch 链式 + window.open）
//   - themeOptions computed 数组（含 lucide 图标）→ 静态渲染 3 个按钮
//   - document 点击外部关闭 + menuRef template ref + <transition> → 舍弃
//     （PLAN-059 T9 起 dialog 家族原生外点/ESC 关闭;PLAN-080 T-04 起弹层
//     再迁 popover 嵌套锚定形态——就近浮层、非 modal，ws-btn 同款）
//   - accent 动态 style（per-item brand1）→ style: 字符串拼接（P12 缺陷 9）
//
// 样式：逃生舱 scoped 由 inject_styles.ts 全局兜底（.settings-* 等）。

use store: VisualStore

// PLAN-037 Phase 3: web ecosystem imports (use.web).
use.web component Settings, Check, Sun, Moon, Monitor, ExternalLink from "src/front/ports/icons.at"
use.web settings_open_autoos from "src/front/settings_forge_helpers.at"
use.web settingsInitLocale, settingsChangeLocale from "src/front/ports/composables.at"
use.web useI18n from "src/front/ports/composables.at"

// PLAN-071 r4（需求③-3）：collapsed 收缩形态——齿轮 icon 触发，dialog 不变。
widget SettingsMenu(collapsed: bool) {

    setup {
        let i18n = useI18n()
        refs i18n: [locale]
    }
    computed {
        accentCurrent => .store.accent
        themeMode => .store.mode
        isLocaleEn => .currentLocale == "en"
        isLocaleZh => .currentLocale == "zh"
        triggerIconSize => if .collapsed { 24 } else { 16 }
        // PLAN-081 需求③c：收缩态包装层不可带 border-t——边框容器在 VM 轨
        // 几何左移子元素（齿轮实测左偏 8px，去 border 即归位=A/B 实证；
        // 逐项排除 placement/class-vs-style/title-label 三假设）。分隔线改
        // 独立元素（外层 col items-center 居中、w-10 与钮同宽）。展开态
        // wrapper 带 border 的全宽行布局不变。
        wrapperStyle => if .collapsed { "settings-menu-wrapper pt-2 mt-2" } else { "settings-menu-wrapper border-t border-white/10 pt-2 mt-2" }
    }
    // PLAN-082 T-07：GSD/Check forge mode 机制退役（用户裁定），消息面收缩。
    msg Msg { SetAccent(str), SetThemeLight, SetThemeDark, SetThemeAuto, ChangeLocale(str), OpenAutoOs }
    // PLAN-059 T9:开关态改 dialog 受控形态（无 trigger,open 绑 state_ref
    // bool——chats_view 删除确认 alert-dialog 同款已验证模式）。触发行留在
    // dialog 外自持 onclick（parser 铸造形态的 toggle 会落内层按钮,与 web
    // 侧 reka DialogTrigger 包裹层自动开合叠加双翻转,永不弹开——实机探针
    // 定案走受控）;web DialogContent 自带 X/遮罩/ESC 关闭（reka 经
    // v-model:open 回写）;VM Modal 卡片经底部关闭钮关闭（ESC/外点 dismiss
    // 不接线,与 alert 族同口径,家族债已在案）。
    model {
        var currentLocale str = ""
        var autoOsError str = ""
    }
    on {
        .Init -> {
            // VisualStore.Init 常驻挂载即触发（主题/强调色启动应用，对齐原
            // composable onMounted 自初始化）。
            VisualStore.Init();
            .currentLocale = settingsInitLocale();
        }
        .SetAccent(name) -> { store.SetAccent(name) }
        .SetThemeLight -> { store.SetMode("light") }
        .SetThemeDark -> { store.SetMode("dark") }
        .SetThemeAuto -> { store.SetMode("auto") }
        .ChangeLocale(l) -> {
            settingsChangeLocale(l);
            .currentLocale = l
        }
        .OpenAutoOs -> {
            .autoOsError = "";
            .autoOsError = settings_open_autoos().await
        }
    }
    // Plan 029 T22：原 inject_styles 全局兜底下放（scoped 生效于本组件 DOM）。
    style {
  .settings-menu-wrapper { position: relative; width: 100%; }
  .settings-trigger {
    display: flex; align-items: center; gap: 0.5rem;
    width: 100%; height: 36px; padding: 0 0.5rem; border: none; border-radius: 6px;
    background: transparent; color: hsl(var(--muted-foreground)); cursor: pointer;
    transition: all 0.15s; text-align: left; font-size: 0.875rem;
  }
  .settings-trigger:hover { background: hsl(var(--accent)); color: hsl(var(--foreground)); }
  .settings-trigger.open { background: hsl(var(--accent)); color: hsl(var(--primary)); }
  /* PLAN-059 T9:手搓 .settings-panel（absolute 流内承载）随 dialog 家族切换
     退役——面板 chrome 归 DialogContent（web 居中模态+遮罩+X 关闭）与 VM
     Modal 浮层。 */
  .settings-section { padding: 0.4rem 0; }
  .settings-section + .settings-section { border-top: 1px solid hsl(var(--border)); }
  .settings-section-title {
    font-size: 0.7rem; font-weight: 600; color: hsl(var(--muted-foreground));
    text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.4rem; padding: 0 0.3rem;
  }
  .mode-toggle { display: flex; gap: 0.35rem; padding: 0 0.3rem; }
  .mode-btn {
    flex: 1; padding: 0.3rem 0; border: 1px solid hsl(var(--border)); border-radius: 6px;
    background: transparent; color: hsl(var(--foreground)); font-size: 0.78rem; font-weight: 600;
    cursor: pointer; transition: all 0.15s;
  }
  .mode-btn:hover { background: hsl(var(--accent)); }
  .mode-btn.active { background: hsl(var(--primary)); border-color: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }
  .accent-swatches { display: flex; gap: 0.5rem; padding: 0 0.3rem; }
  .accent-swatches > button {
    width: 24px; height: 24px; border-radius: 50%; border: 2px solid transparent;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    color: #fff; transition: transform 0.1s; padding: 0; min-width: 24px;
  }
  .accent-swatches > button:hover { transform: scale(1.1); }
  .accent-swatches > button:has(svg) { border-color: hsl(var(--foreground)); }
  .theme-options { display: flex; flex-direction: column; gap: 2px; }
  .theme-option {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.5rem;
    border: none; border-radius: 6px; background: transparent; color: hsl(var(--foreground));
    font-size: 0.82rem; cursor: pointer; text-align: left; width: 100%;
  }
  .theme-option:hover { background: hsl(var(--accent)); }
  .theme-option.active { background: hsl(var(--primary) / 0.08); color: hsl(var(--primary)); }
  .theme-option .check { margin-left: auto; }
  .theme-option-label { flex: 1; }
  .language-options { display: flex; flex-direction: column; gap: 2px; }
  .language-option {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.5rem;
    border: none; border-radius: 6px; background: transparent; color: hsl(var(--foreground));
    font-size: 0.82rem; cursor: pointer; text-align: left; width: 100%;
  }
  .language-option:hover { background: hsl(var(--accent)); }
  .language-option.active { background: hsl(var(--primary) / 0.08); color: hsl(var(--primary)); }
  .lang-code { font-weight: 700; min-width: 1.5rem; }
  .lang-name { flex: 1; }
  .language-option .check { margin-left: auto; }
  .deep-link-btn {
    display: flex; align-items: center; gap: 0.5rem; width: 100%; padding: 0.35rem 0.5rem;
    border: 1px solid hsl(var(--border)); border-radius: 6px; background: transparent;
    color: hsl(var(--foreground)); font-size: 0.78rem; cursor: pointer; text-align: left;
    transition: background 0.15s;
  }
  .deep-link-btn:hover { background: hsl(var(--accent)); }
  .deep-link-label { flex: 1; }
  .deep-link-error {
    margin-top: 0.3rem; padding: 0.2rem 0.5rem; font-size: 0.7rem;
    color: hsl(var(--destructive)); background: hsl(var(--destructive) / 0.08); border-radius: 4px;
  }
    }

    view {
        // PLAN-058 二期：根容器带 border-t 分割线（与上方 WorkspaceSelector
        // 分隔）+ pt/mt 间距——分割线归属本组件，app.at 侧不再放独立空 div。
        // PLAN-081 需求③c：VM 轨收缩态 border 容器几何左移子元素（见
        // wrapperStyle 注）——收缩态分隔线改独立短划元素，wrapper 裸奔。
        // 背景式短划线（h-px）——border 式在 VM 轨引边框容器几何位移
        //（见 wrapperStyle 注）；且 if 分支子节点 style 在 VM 构建期被丢弃
        //（PLAN-081 实证），故用无条件节点 + style 三元（hidden=VM 不渲染）。
        div { style: if .collapsed { "w-10 h-px bg-border mt-2" } else { "hidden" } }
        // PLAN-058 二期：icon+文字全宽行（与上方导航项同形）。面板由 dialog
        // 受控形态承载（open: .isOpen,VM Modal 居中卡 / web 居中模态）。
        div {
            style: .wrapperStyle
            // PLAN-080 F-4：popover 标签不再挂 class——class 在两轨语义错位
            //（web 落 Popover wrapper div 无几何效果、面板走 PopoverContent
            // 缺省 w-72；VM 落 content 列且顶替 PLAN-528 W9 缺省 chrome——
            // w-80=320 无 bg/border/p-4，内宽 308 vs web 241 实证）。摘除后
            // 双轨同归缺省面板 chrome（w-72 + p-4），宽度差收敛。
            popover {
                popover-trigger (as_child: true) {
                    // 无 onclick——解释器注入内部 toggle（web 侧 reka
                    // PopoverTrigger 原生开合；ws-btn 同款已验证形态）。
                    button {
                        // PLAN-081 需求③c：收缩态改 style: 属性（与 ws 触发
                        // 钮同款机制，行为等价 class:，此处统一书写面）。
                        style: if .collapsed { "rail-trigger-24 settings-trigger w-10 h-10 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" } else { "settings-trigger w-full flex items-center gap-2 rounded-md px-2 h-9 bg-transparent text-muted-foreground" }
                        // PLAN-081 需求③c：与 border 位移复合的第二因素——
                        // title 经 EE03 尾段进按钮 label，VM 轨额外文本参与
                        // 内容布局把图标推左（border 去除后单留它仍偏 8px，
                        // 双因素 A/B 分离实证）。收缩态不挂 title（tooltip
                        // 牺牲）；展开态保留。
                        title: if .collapsed { "" } else { i18n.t("settings.title") }
                        Settings { size: .triggerIconSize }
                        if .collapsed {
                        } else {
                            span {
                                style: "flex-1 text-left text-sm"
                                text i18n.t("settings.title")
                            }
                        }
                    }
                }
                popover-content {
                    // ── Accent Section（PLAN-082 T-07：参照 widgets-gallery
                    // settings.at 的 commons 形态——五色圆点显式按钮横排
                    // （for 在 VM 被包装为列=竖排根因，r5/r6 同族），选中态
                    // 圆点内 Check；色值与 VisualStore.visual_palettes 同源）──
                    div {
                        style: "settings-section w-full p-1.5"
                        div {
                            style: "settings-section-title w-full text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5 px-0.5"
                            text i18n.t("settings.accent")
                        }
                        row {
                            style: "items-center gap-2.5 py-1 px-0.5"
                            button {
                                onclick: .SetAccent("indigo")
                                class: "w-6 h-6 rounded-full flex items-center justify-center text-white border-2 border-transparent hover:scale-110 bg-indigo-500"
                                if .accentCurrent == "indigo" {
                                    Check { size: 12 }
                                }
                            }
                            button {
                                onclick: .SetAccent("coral")
                                class: "w-6 h-6 rounded-full flex items-center justify-center text-white border-2 border-transparent hover:scale-110 bg-rose-500"
                                if .accentCurrent == "coral" {
                                    Check { size: 12 }
                                }
                            }
                            button {
                                onclick: .SetAccent("ocean")
                                class: "w-6 h-6 rounded-full flex items-center justify-center text-white border-2 border-transparent hover:scale-110 bg-blue-500"
                                if .accentCurrent == "ocean" {
                                    Check { size: 12 }
                                }
                            }
                            button {
                                onclick: .SetAccent("sage")
                                class: "w-6 h-6 rounded-full flex items-center justify-center text-white border-2 border-transparent hover:scale-110 bg-emerald-500"
                                if .accentCurrent == "sage" {
                                    Check { size: 12 }
                                }
                            }
                            button {
                                onclick: .SetAccent("amber")
                                class: "w-6 h-6 rounded-full flex items-center justify-center text-white border-2 border-transparent hover:scale-110 bg-amber-500"
                                if .accentCurrent == "amber" {
                                    Check { size: 12 }
                                }
                            }
                        }
                    }
                    // ── Theme Section（PLAN-082 T-07：外观三段 icon toggle 组
                    // ——用户裁定形态（Monitor/Sun/Moon 横排、选中 bg-primary），
                    // 替换原竖排文字列表；显式 row 免包装列）──
                    // ── Theme Section（旧 for 版 Accent 竖排段已退役——
                    // PLAN-082 T-07：for 在 VM 被包装为列，圆点改显式按钮
                    // 横排（见上方 Accent Section），此处仅存 Theme toggle）──
                    div {
                        style: "settings-section w-full p-1.5"
                        div {
                            style: "settings-section-title w-full text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5 px-0.5"
                            text i18n.t("settings.theme")
                        }
                        row {
                            style: "gap-1 p-1 rounded-lg bg-muted/40 w-full"
                            button {
                                onclick: .SetThemeLight
                                class: if .themeMode == "light" { "flex-1 h-8 flex items-center justify-center rounded-md bg-primary text-primary-foreground" } else { "flex-1 h-8 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }
                                Sun { size: 14 }
                            }
                            button {
                                onclick: .SetThemeDark
                                class: if .themeMode == "dark" { "flex-1 h-8 flex items-center justify-center rounded-md bg-primary text-primary-foreground" } else { "flex-1 h-8 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }
                                Moon { size: 14 }
                            }
                            button {
                                onclick: .SetThemeAuto
                                class: if .themeMode == "auto" { "flex-1 h-8 flex items-center justify-center rounded-md bg-primary text-primary-foreground" } else { "flex-1 h-8 flex items-center justify-center rounded-md text-muted-foreground hover:bg-accent" }
                                Monitor { size: 14 }
                            }
                        }
                    }
                    // ── Language Section ──
                    div {
                        style: "settings-section w-full p-1.5"
                        div {
                            style: "settings-section-title w-full text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5 px-0.5"
                            text i18n.t("settings.language")
                        }
                        col {
                            style: "gap-0.5"
                            button {
                                onclick: .ChangeLocale("en")
                                class: if .isLocaleEn { "w-full rounded-md bg-primary/10 text-primary hover:bg-accent" } else { "w-full rounded-md text-foreground hover:bg-accent" }
                                row {
                                    style: "items-center gap-2 w-full py-1.5 px-2"
                                    text "English" { style: "flex-1 text-left text-sm" }
                                    if .isLocaleEn {
                                        Check { size: 12 }
                                    }
                                }
                            }
                            button {
                                onclick: .ChangeLocale("zh")
                                class: if .isLocaleZh { "w-full rounded-md bg-primary/10 text-primary hover:bg-accent" } else { "w-full rounded-md text-foreground hover:bg-accent" }
                                row {
                                    style: "items-center gap-2 w-full py-1.5 px-2"
                                    text "中文" { style: "flex-1 text-left text-sm" }
                                    if .isLocaleZh {
                                        Check { size: 12 }
                                    }
                                }
                            }
                        }
                    }
                    // ── AutoOS Settings deep-link ──
                    div {
                        style: "settings-section w-full p-1.5"
                        div {
                            style: "settings-section-title w-full text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5 px-0.5"
                            text "AutoOS"
                        }
                        button {
                            onclick: .OpenAutoOs
                            style: "deep-link-btn w-full flex items-center gap-2 rounded-md border border-border px-2 py-1.5 text-left text-sm text-foreground hover:bg-accent bg-transparent"
                            row {
                                style: "items-center gap-2 w-full"
                                ExternalLink { size: 14 }
                                text i18n.t("settings.openSystemSettings") { style: "flex-1 text-left text-sm" }
                            }
                        }
                        if .autoOsError != "" {
                            div {
                                style: "deep-link-error"
                                text .autoOsError
                            }
                        }
                    }
                }
            }
        }
    }
}
