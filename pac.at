// pac.at - auto-musk Workspace Config
// auto-forge 的 Auto 实现版本（移植自 auto-forge 03087fb）。
// 后端用 AutoVM 脚本运行（待 auto-lang #[api] server 修复后激活）。
// 参照 examples/ui/015-notes 的单包结构（scene:ui + render:vue + api 指向后端）。

name: "auto-musk"
version: "0.1.0"

scene: "ui"
render: "vue"
api: "rust"

// Plan 022 Phase 2 + Plan 407: i18n (vue-i18n) — locale files copied to src/locales/
// and wired into createI18n in main.ts. default_locale = 第一个文件 stem（zh 在前→中文默认）。
// Plan 407 扩充了 nav/chat/app key，配合 .at text t() 表达式实现完整 i18n。
i18n: ["src/front/i18n/zh.json", "src/front/i18n/en.json"]

// Plan 022 Phase 6 → PLAN-038 Phase 3: 渲染真源切换 @autodown/vue（vendored 快照,
// 来源 ../auto-down,再生 scripts/vendor-autodown-vue.mjs;file: 直链上游被其
// workspace:* 依赖阻塞,故 vendor shim 入库）。路径相对 gen/front/vue/。
// markstream-vue 保留直依赖：.at 内置 markdown 元素（auto-lang codegen 硬编码
// 绑定）+ platform:markdown 的 setCustomComponents 注册仍直接引用——其消灭属
// auto-down 侧 008 草稿 + auto-lang 跟进（PLAN-038 T13 证据行登记）。
npm_deps: {
  // 注:本对象为 auto-man 行式解析,条目间不加逗号（尾逗号会被误计入版本串）
  "@autodown/vue": "file:../../../vendor/@autodown/vue"
  "markstream-vue": "^0.0.14-beta.8"
}
