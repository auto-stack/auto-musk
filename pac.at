// pac.at - auto-musk Workspace Config
// auto-forge 的 Auto 实现版本（移植自 auto-forge 03087fb）。
// 后端用 AutoVM 脚本运行（待 auto-lang #[api] server 修复后激活）。
// 参照 examples/ui/015-notes 的单包结构（scene:ui + render:vue + api 指向后端）。

name: "auto-musk"
version: "0.1.0"

scene: "ui"
render: "vue"
api: "rust"

// Plan 022 Phase 2 + Plan 407: i18n (vue-i18n) — locale files copied to src/locales/
// and wired into createI18n in main.ts. default_locale = 第一个文件 stem（zh 在前→中文默认）。
// Plan 407 扩充了 nav/chat/app key，配合 .at text t() 表达式实现完整 i18n。
i18n: ["src/front/i18n/zh.json", "src/front/i18n/en.json"]

// Plan 022 Phase 6: markdown rendering (markstream-vue) for WikiView/SpecsView.
// (Phase 3 auto-detection is best-effort; declare explicitly for reliability.)
npm_deps: ["markstream-vue@0.0.14-beta.8"]
