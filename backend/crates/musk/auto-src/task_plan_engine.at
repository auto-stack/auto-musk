/// task_plan_engine.at — port of backend/crates/musk/src/relay/task_plan_engine.rs
/// (Plan 020 Phase B: TaskPlan 引擎层 .at 移植)。对齐 hw 672 行。
///
/// 移植策略:
/// - 全部数据类型 + 纯逻辑移植:TaskPlanContext / RunRequest /
///   RunExecutionResult / TaskPlanStatus / PhaseStatus / PhaseState /
///   TaskPlanRunState / TaskPlanEngine + new / validate / topological_order
///   (迭代 DFS,与 hw 递归 dfs 同序)/ build_run_request / set_phase_status /
///   broadcast。
/// - execute 的 pluggable executor(hw 闭包参数 F: Fn(RunRequest) -> Fut)以
///   pub spec TaskPlanExecutor(#[async_trait]) 表达:execute 接收
///   Arc<dyn TaskPlanExecutor>,生产/测试分别以 hw 结构实现该 trait。
/// - hw 并行 phase 是"先建 future 再逐个 await"——无真并发,顺序 await 与
///   串行等价 → .at 统一按序 run_one(hw build_run_request 纯读,惰性构建
///   不可观测)。
/// - 3 个副作用 extern:task_plan_uuidish(hex 纳秒)、task_plan_broadcast
///   (SSE bus)、handoff_resolve_path(HandoffStore 读取)。
/// - 事件 payload 用单一 DTO(Option 字段 skip-none),与 hw json! 逐键等价。

use.rust std::collections::{HashMap, HashSet}
use.rust std::sync::Arc
use.rust serde::{Serialize, Deserialize}
use.rust serde_json::Value
use.rust serde_json::to_value
use.rust crate::server::AppState
use.rust crate::relay::handoff_store::HandoffStore
use.rust crate::auto_generated::task_plan::{Phase, PhaseMode, RunRef, TaskMode, TaskPlan}
use.rust crate::auto_generated::relay_flows::get_builtin_flow
use.rust auto_ai_agent::orchestration::HandoffDocument

// ============================================================
// 类型
// ============================================================

/// Shared context needed to execute a TaskPlan instance (hw TaskPlanContext)。
#[derive(Clone)]
pub type TaskPlanContext {
    state AppState
    workspace_id str
}

/// A request to execute a single relay run inside a TaskPlan.
#[derive(Clone, Debug)]
pub type RunRequest {
    task_plan_id str
    phase_name str
    phase_index uint
    run_ref RunRef
    run_id str
    parent_run_id Option<str>
    root_run_id str
    task_text str
    mode TaskMode
}

/// Result of executing a single relay run.
#[derive(Clone, Debug)]
pub type RunExecutionResult {
    run_id str
    /// Terminal status string from the run store (e.g. "completed", "failed").
    status str
    handoff Option<HandoffDocument>
    error Option<str>
}

/// Overall status of a TaskPlan execution.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum TaskPlanStatus {
    Pending
    Running
    Completed
    Failed
    Paused
}

/// Status of an individual phase within a TaskPlan execution.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum PhaseStatus {
    Pending
    Running
    Completed
    Failed
}

/// Per-phase execution state.
#[derive(Debug, Clone)]
pub type PhaseState {
    status PhaseStatus
    run_results HashMap<str, RunExecutionResult>
}

/// Per-run execution state tracked by the engine.
#[derive(Debug, Clone)]
pub type TaskPlanRunState {
    run_id str
    phase_name str
    run_name str
    status str
    handoff Option<HandoffDocument>
}

/// Deterministic executor for TaskPlan instances.
#[derive(Debug, Clone)]
pub type TaskPlanEngine {
    plan TaskPlan
    instance_id str
    initial_input str
    status TaskPlanStatus
    phase_states HashMap<str, PhaseState>
    run_states HashMap<str, TaskPlanRunState>
}

/// Pluggable single-run executor(hw execute 的 F: Fn(RunRequest) -> Fut)。
/// 生产/测试分别实现:生产用 drive_task_plan_run(hw,Phase F 接线),
/// parity 测试用假 executor。
pub spec TaskPlanExecutor {
    fn run(req RunRequest) ~Result<RunExecutionResult, str>
}

// ============================================================
// 事件 payload DTO(与 hw json! 逐键等价;Option 字段 skip-none)
// ============================================================

#[derive(Serialize)]
pub type TaskPlanEvtPayload {
    task_plan_id str
    instance_id str
    #[serde(default, skip_serializing_if = "Option::is_none")]
    phase Option<str>
    #[serde(default, skip_serializing_if = "Option::is_none")]
    mode Option<str>
    #[serde(default, skip_serializing_if = "Option::is_none")]
    run Option<str>
    #[serde(default, skip_serializing_if = "Option::is_none")]
    run_id Option<str>
    #[serde(default, skip_serializing_if = "Option::is_none")]
    status Option<str>
    #[serde(default, skip_serializing_if = "Option::is_none")]
    error Option<str>
}

// ============================================================
// TaskPlanEngine 方法
// ============================================================

ext TaskPlanEngine {
    /// Create a new engine for a plan (hw new;instance_id = plan.id-uuidish)。
    pub static fn new(plan TaskPlan, initial_input str) TaskPlanEngine {
        let instance_id = plan.id.clone() + "-" + task_plan_uuidish()
        var phase_states HashMap<str, PhaseState> = HashMap.new()
        for phase in plan.phases.clone() {
            phase_states.insert(
                phase.name.clone(),
                PhaseState(status: PhaseStatus.Pending, run_results: HashMap.new())
            )
        }
        return TaskPlanEngine(
            plan: plan,
            instance_id: instance_id,
            initial_input: initial_input,
            status: TaskPlanStatus.Pending,
            phase_states: phase_states,
            run_states: HashMap.new()
        )
    }

    /// Validate that the plan can be executed (plan.validate + flow refs)。
    pub fn validate() Result<(), str> {
        is self.plan.validate() {
            Err(e) -> return Err(e.to_string()),
            Ok(_) -> {}
        }
        for phase in self.plan.phases.clone() {
            for run in phase.runs.clone() {
                is get_builtin_flow(run.flow_id.view) {
                    Some(_) -> {},
                    None -> return Err("run '" + run.name + "' references unknown flow '" + run.flow_id + "'")
                }
            }
        }
        return Ok(())
    }

    /// Execute the plan to completion using the provided run executor。
    pub mut fn execute(handoffs HandoffStore, executor Arc<dyn TaskPlanExecutor>) ~Result<(), str> {
        is self.validate() {
            Err(e) -> return Err(e),
            Ok(_) -> {}
        }

        self.status = TaskPlanStatus.Running
        task_plan_broadcast(
            self.instance_id,
            "task_plan_started",
            to_value(TaskPlanEvtPayload(task_plan_id: self.plan.id.clone(), instance_id: self.instance_id.clone(), phase: None, mode: None, run: None, run_id: None, status: None, error: None)).unwrap()
        )

        let order_result = self.topological_order()
        var order List<str> = []
        is order_result {
            Err(e) -> return Err(e),
            Ok(o) -> { order = o }
        }

        for phase_name in order {
            let phase = self.find_phase(phase_name.view)
            var phase_obj Phase = Phase.new("")
            var have_phase bool = true
            is phase {
                None -> { return Err("phase '" + phase_name + "' disappeared") },
                Some(p) -> { phase_obj = p }
            }

            self.set_phase_status(phase_obj.name.view, PhaseStatus.Running)
            task_plan_broadcast(
                self.instance_id,
                "phase_started",
                to_value(TaskPlanEvtPayload(task_plan_id: self.plan.id.clone(), instance_id: self.instance_id.clone(), phase: Some(phase_obj.name.clone()), mode: Some(phase_mode_str(phase_obj.mode)), run: None, run_id: None, status: None, error: None)).unwrap()
            )

            let phase_index = self.find_phase_index(phase_obj.name.view)
            let run_refs = phase_obj.runs.clone()

            // Serial/parallel 统一按序执行(hw 并行无真并发,语义等价)。
            var run_names List<str> = []
            var run_results List<RunExecutionResult> = []
            for run_ref in run_refs {
                // input_from 解析在 execute 侧完成(hw 在 build_run_request 内;
                // a2r 局部 fn 参数按值传递,store 无法借出 → 预解析为
                // "## Input from..." 文本列表传入)。
                var resolved_inputs List<str> = []
                for path in run_ref.input_from.clone() {
                    let full_path = self.plan.id.clone() + "." + path
                    is handoff_resolve_path(handoffs.view, full_path.view) {
                        Some(value) -> { resolved_inputs.push("## Input from " + path + "\n\n" + value) },
                        None -> { resolved_inputs.push("## Input from " + path + "\n\n(resolved value missing)") }
                    }
                }
                let req = self.build_run_request(phase_obj.clone(), phase_index, run_ref.clone(), resolved_inputs)
                let one = self.run_one(executor.clone(), req).await
                is one {
                    Err(e) -> return Err(e),
                    Ok(r) -> {
                        run_names.push(run_ref.name.clone())
                        run_results.push(r)
                    }
                }
            }

            var phase_failed bool = false
            var failure_error Option<str> = None
            var i uint = 0
            for run_name in run_names.clone() {
            // 预绑定:a2r 对"循环变量直接作嵌套调用实参的字面量字段"的类型推断会错位
            let run_name_owned = run_name.clone()
                let result = run_results[i].clone()
                if result.status != "completed" {
                    phase_failed = true
                    let default_msg = "run '" + run_name + "' ended with status '" + result.status + "'"
                    is result.error {
                        Some(e) -> { failure_error = Some(e) },
                        None -> { failure_error = Some(default_msg) }
                    }
                }
                is result.handoff.clone() {
                    Some(h) -> {
                        is handoffs.save(self.plan.id.view, phase_obj.name.view, run_name.view, h.view) {
                            Ok(_) -> {},
                            Err(e) -> { /* tracing::warn! 不移植——纯日志 */ }
                        }
                    },
                    None -> {}
                }
                self.run_states.insert(
                    result.run_id.clone(),
                    TaskPlanRunState(
                        run_id: result.run_id.clone(),
                        phase_name: phase_obj.name.clone(),
                        run_name: run_name_owned,
                        status: result.status.clone(),
                        handoff: result.handoff.clone()
                    )
                )
                i = i + 1
            }

            // phase_states.run_results 汇总(replace-in-map 模式)。
            is self.phase_states.get(phase_obj.name.view) {
                Some(state) -> {
                    var new_state = state.clone()
                    var j uint = 0
                    for run_name in run_names.clone() {
                        new_state.run_results.insert(run_name, run_results[j].clone())
                        j = j + 1
                    }
                    self.phase_states.insert(phase_obj.name.clone(), new_state)
                },
                None -> {}
            }

            if phase_failed {
                self.set_phase_status(phase_obj.name.view, PhaseStatus.Failed)
                let error = failure_error.unwrap_or_default()
                task_plan_broadcast(
                    self.instance_id,
                    "phase_failed",
                    to_value(TaskPlanEvtPayload(task_plan_id: self.plan.id.clone(), instance_id: self.instance_id.clone(), phase: Some(phase_obj.name.clone()), mode: None, run: None, run_id: None, status: None, error: Some(error.clone()))).unwrap()
                )
                self.status = TaskPlanStatus.Failed
                task_plan_broadcast(
                    self.instance_id,
                    "task_plan_failed",
                    to_value(TaskPlanEvtPayload(task_plan_id: self.plan.id.clone(), instance_id: self.instance_id.clone(), phase: Some(phase_obj.name.clone()), mode: None, run: None, run_id: None, status: None, error: Some(error.clone()))).unwrap()
                )
                return Err(error)
            }

            self.set_phase_status(phase_obj.name.view, PhaseStatus.Completed)
            task_plan_broadcast(
                self.instance_id,
                "phase_completed",
                to_value(TaskPlanEvtPayload(task_plan_id: self.plan.id.clone(), instance_id: self.instance_id.clone(), phase: Some(phase_obj.name.clone()), mode: None, run: None, run_id: None, status: None, error: None)).unwrap()
            )
        }

        self.status = TaskPlanStatus.Completed
        task_plan_broadcast(
            self.instance_id,
            "task_plan_completed",
            to_value(TaskPlanEvtPayload(task_plan_id: self.plan.id.clone(), instance_id: self.instance_id.clone(), phase: None, mode: None, run: None, run_id: None, status: None, error: None)).unwrap()
        )
        return Ok(())
    }

    /// Execute a single run through the supplied executor (hw run_one)。
    fn run_one(executor Arc<dyn TaskPlanExecutor>, req RunRequest) ~Result<RunExecutionResult, str> {
        task_plan_broadcast(
            self.instance_id,
            "run_started",
            to_value(TaskPlanEvtPayload(task_plan_id: self.plan.id.clone(), instance_id: self.instance_id.clone(), phase: Some(req.phase_name.clone()), mode: None, run: Some(req.run_ref.name.clone()), run_id: Some(req.run_id.clone()), status: None, error: None)).unwrap()
        )

        let run_name = req.run_ref.name.clone()
        let phase_name = req.phase_name.clone()
        let result = executor.run(req).await
        is result {
            Err(e) -> return Err("executor error: " + e),
            Ok(r) -> {
                task_plan_broadcast(
                    self.instance_id,
                    "run_completed",
                    to_value(TaskPlanEvtPayload(task_plan_id: self.plan.id.clone(), instance_id: self.instance_id.clone(), phase: Some(phase_name), mode: None, run: Some(run_name), run_id: Some(r.run_id.clone()), status: Some(r.status.clone()), error: None)).unwrap()
                )
                return Ok(r)
            }
        }
    }

    /// Build the execution request for a single run。input_from 的解析结果
    /// (已格式化的 "## Input from..." 文本)由 execute 传入 resolved_inputs
    /// (与 run_ref.input_from 平行;hw 在方法内直接读 store,a2r 按值参数
    /// 无法借出 store,故前移)。
    fn build_run_request(phase Phase, phase_index uint, run_ref RunRef, resolved_inputs List<str>) RunRequest {
        let run_id = self.instance_id.clone() + "--" + phase.name + "--" + run_ref.name + "--" + task_plan_uuidish()

        var task_parts List<str> = []
        is run_ref.input.clone() {
            Some(input) -> { task_parts.push(input.clone()) },
            None -> {
                if phase_index == 0 {
                    task_parts.push(self.initial_input.clone())
                }
            }
        }

        var from_i uint = 0
        for path in run_ref.input_from.clone() {
            let text = resolved_inputs[from_i].clone()
            task_parts.push(text)
            from_i = from_i + 1
        }

        is run_ref.context.clone() {
            Some(context) -> { task_parts.push("## Context\n\n" + context) },
            None -> {}
        }

        // hw task_parts.join("\n\n")(a2r 无 List.join)。
        var task_text str = ""
        var first_part bool = true
        for part in task_parts.clone() {
            if first_part {
                task_text = part
                first_part = false
            } else {
                task_text = task_text + "\n\n" + part
            }
        }

        var mode TaskMode = self.plan.default_mode
        is run_ref.mode_override.clone() {
            Some(m) -> { mode = m },
            None -> {}
        }

        return RunRequest(
            task_plan_id: self.plan.id.clone(),
            phase_name: phase.name.clone(),
            phase_index: phase_index,
            run_ref: run_ref,
            run_id: run_id,
            parent_run_id: None,
            root_run_id: self.instance_id.clone(),
            task_text: task_text,
            mode: mode
        )
    }

    fn set_phase_status(phase_name str, status PhaseStatus) {
        is self.phase_states.get(phase_name.clone()) {
            Some(state) -> {
                var new_state = state.clone()
                new_state.status = status
                self.phase_states.insert(phase_name, new_state)
            },
            None -> {}
        }
    }

    /// Topological order(hw 递归 dfs 的迭代等价;同序 + 同 cycle 报错)。
    pub fn topological_order() Result<List<str>, str> {
        var visited HashSet<str> = HashSet.new()
        var on_stack HashSet<str> = HashSet.new()
        var order List<str> = []

        for phase in self.plan.phases.clone() {
            if visited.contains(phase.name.clone()) {
                continue
            }
            // 迭代 DFS 帧:(node, next_dep_index) 并行列表(plan 013 B5)。
            var nodes List<str> = [phase.name.clone()]
            var indices List<int> = [0]
            let _ bool = on_stack.insert(phase.name.clone())
            while nodes.len() > 0 {
                let node = nodes[nodes.len() - 1].clone()
                let idx = indices[indices.len() - 1]
                let deps = self.dep_names(node.view)
                if idx < deps.len() {
                    // advance this frame's index
                    indices.pop()
                    indices.push(idx + 1)
                    let dependency = deps[idx]
                    if on_stack.contains(dependency.clone()) {
                        return Err("cycle detected at phase '" + dependency + "'")
                    }
                    if visited.contains(dependency.clone()) {
                        continue
                    }
                    nodes.push(dependency.clone())
                    indices.push(0)
                    let _ bool = on_stack.insert(dependency)
                } else {
                    // all deps done → pop frame, record post-order
                    nodes.pop()
                    indices.pop()
                    let _ bool = on_stack.remove(node.view)
                    let _ bool = visited.insert(node.clone())
                    order.push(node)
                }
            }
        }
        return Ok(order)
    }

    fn dep_names(name str) List<str> {
        for phase in self.plan.phases.clone() {
            if phase.name == name {
                return phase.depends_on.clone()
            }
        }
        return []
    }

    fn find_phase(name str) Option<Phase> {
        for phase in self.plan.phases.clone() {
            if phase.name == name {
                return Some(phase)
            }
        }
        return None
    }

    fn find_phase_index(name str) uint {
        var i uint = 0
        for phase in self.plan.phases.clone() {
            if phase.name == name {
                return i
            }
            i = i + 1
        }
        return 0
    }
}

/// PhaseMode → 小写字符串(hw `format!("{:?}", mode).to_lowercase()`)。
fn phase_mode_str(mode PhaseMode) str {
    is mode {
        PhaseMode.Serial -> return "serial",
        PhaseMode.Parallel -> return "parallel"
    }
}

// ============================================================
// Plan 020 Phase H — RelayTaskPlanExecutor: ag 版单 run 执行内核
// (替代 hand-written DriveTaskPlanExecutor 透传 hw drive_task_plan_run)。
// 5 步顺序逻辑(等价 hw task_plan_engine.rs:472-513):start_run → drive_run
// (复用 Phase G 的 ag drive_run)→ 读 run status → 组装 RunExecutionResult。
// 注:execute 接收 Arc<dyn TaskPlanExecutor>;此 struct 实现 TaskPlanExecutor。
// ============================================================

// 携带 ctx 的 ag executor(字段对齐 hw TaskPlanContext)。声明为实现 TaskPlanExecutor
// (同 DriveStreamSink as DriveSink 模式);ext 块定义 run 方法,把 drive_task_plan_run
// 的逻辑全在 ag 表达(经 extern 委托 hw store + ag drive_run)。
#[derive(Clone)]
pub type RelayTaskPlanExecutor as TaskPlanExecutor {
    ctx TaskPlanContext
}

ext RelayTaskPlanExecutor {
    fn run(req RunRequest) ~Result<RunExecutionResult, str> {
        // ctx.state 是 owned AppState;extern 收 &Arc<AppState> — 一次性包 Arc。
        let state Arc<AppState> = Arc.new(self.ctx.state.clone())
        // 1. start_run:在 run store 注册一个 relay run(flow_id 来自 run_ref)。
        task_plan_start_run(state.view, self.ctx.workspace_id.view, req.run_id.view, req.run_ref.flow_id.view, req.task_text.view)
        // 2. drive_run:复用 Phase G 的 ag drive_run(推进到终态)。
        let _ = drive_run(state.view, self.ctx.workspace_id.view, req.run_id.view).await
        // 3. 读回 run status;丢失则报错(hw:496-497)。
        let status_opt = task_plan_run_status(state.view, self.ctx.workspace_id.view, req.run_id.view)
        is status_opt {
            None -> return Err("run " + req.run_id + " disappeared after execution"),
            Some(status) -> {
                // 4. status==completed → error=None;否则 error=Some("run ended with status '...'")。
                var error_msg Option<str> = None
                if status != "completed" {
                    error_msg = Some("run ended with status '" + status + "'")
                }
                // 5. 读回 handoff;组装 RunExecutionResult(hw:505-513)。
                let handoff = task_plan_last_handoff(state.view, self.ctx.workspace_id.view, req.run_id.view)
                return Ok(RunExecutionResult(run_id: req.run_id, status: status, handoff: handoff, error: error_msg))
            }
        }
    }
}
