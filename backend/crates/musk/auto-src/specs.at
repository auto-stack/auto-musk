/// specs.at — PoC: Spec Ledger data-model subset, ported from
/// backend/crates/musk/src/specs.rs.
///
/// Goal: validate whether a2r can transpile a real, axum-free data-model
/// slice of auto-musk back to compiling Rust. Scope (v2): the two scalar
/// enums (SectionType / SpecStatus) + string conversions + SpecItem struct
/// + factory (exercises String/Vec/Option/u64 fields + time bridge).
///
/// Notes on porting choices (cross-referenced to auto-lang-creator skill):
/// - A 类规则: 函数体不写 `::` 路径; 返回类型用空格不用 `->`; 字段/参数
///   类型用空格; 模式匹配用 `is` + `->`; 无分号。
/// - A15: now_sec() via `use.rust a2r_std::time` + `time.now_sec()`.

use.rust a2r_std::time
use.rust serde::{Serialize, Deserialize}
use.rust std::collections::{HashSet, HashMap}
/// - Rust 的 SectionType 是无 repr 的 unit 枚举 (Goals, Architecture, ...)。
///   Auto 的 scalar enum 形态是 `VARIANT = N` (见 02_types/002_enum)。这里先
///   用 scalar 形态 (显式数字) — 这是 PoC 的第一个待测点: a2r 对此能否生成
///   可编译的 Rust enum + Display。

// ============================================================
// SectionType — the 7 spec-section kinds (scalar enum)
// ============================================================

#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
enum SectionType {
    Goals = 1
    Architecture = 2
    Designs = 3
    Plans = 4
    Tests = 5
    Reviews = 6
    Reports = 7
}

ext SectionType {
    /// snake_case string id (e.g. "goals", "architecture").
    /// NOTE: a2r auto-generates `from_id` for scalar enums, so we only
    /// hand-write `as_str` + `display_title` here.
    pub fn as_str() str {
        is self {
            SectionType.Goals -> return "goals",
            SectionType.Architecture -> return "architecture",
            SectionType.Designs -> return "designs",
            SectionType.Plans -> return "plans",
            SectionType.Tests -> return "tests",
            SectionType.Reviews -> return "reviews",
            SectionType.Reports -> return "reports"
        }
    }

    /// display title with emoji (for .ad file headers).
    pub fn display_title() str {
        is self {
            SectionType.Goals -> return "Goals",
            SectionType.Architecture -> return "Architecture",
            SectionType.Designs -> return "Designs",
            SectionType.Plans -> return "Plans",
            SectionType.Tests -> return "Tests",
            SectionType.Reviews -> return "Reviews",
            SectionType.Reports -> return "Reports"
        }
    }
}

// ============================================================
// SpecStatus — spec item/section lifecycle (23 variants)
// ============================================================

#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
enum SpecStatus {
    Empty = 1
    Proposed = 2
    Draft = 3
    UnderReview = 4
    Approved = 5
    InProgress = 6
    InImplementation = 7
    Implemented = 8
    Verified = 9
    Done = 10
    Archived = 11
    Rejected = 12
    Backlog = 13
    Ready = 14
    InReview = 15
    Blocked = 16
    Superseded = 17
    Outdated = 18
    Stable = 19
    Deprecated = 20
    Published = 21
    Analysed = 22
    Obsolete = 23
}

ext SpecStatus {
    /// snake_case string.
    pub fn to_str() str {
        is self {
            SpecStatus.Empty -> return "empty",
            SpecStatus.Proposed -> return "proposed",
            SpecStatus.Draft -> return "draft",
            SpecStatus.UnderReview -> return "under_review",
            SpecStatus.Approved -> return "approved",
            SpecStatus.InProgress -> return "in_progress",
            SpecStatus.InImplementation -> return "in_implementation",
            SpecStatus.Implemented -> return "implemented",
            SpecStatus.Verified -> return "verified",
            SpecStatus.Done -> return "done",
            SpecStatus.Archived -> return "archived",
            SpecStatus.Rejected -> return "rejected",
            SpecStatus.Backlog -> return "backlog",
            SpecStatus.Ready -> return "ready",
            SpecStatus.InReview -> return "in_review",
            SpecStatus.Blocked -> return "blocked",
            SpecStatus.Superseded -> return "superseded",
            SpecStatus.Outdated -> return "outdated",
            SpecStatus.Stable -> return "stable",
            SpecStatus.Deprecated -> return "deprecated",
            SpecStatus.Published -> return "published",
            SpecStatus.Analysed -> return "analysed",
            SpecStatus.Obsolete -> return "obsolete"
        }
    }

    /// Parse from a string. Unknown -> Draft (lossy).
    /// A21: str 的 `is` 匹配会被 a2r 渲染成 unstable 的 str_as_str —— 改用
    /// Map 查表（避开字符串 is 匹配；A4: get() 返回 Option 需 ?? 兜底）。
    pub static fn from_str_lossy(s str) SpecStatus {
        var table Map<str, SpecStatus> = Map.new()
        table.insert("empty", SpecStatus.Empty)
        table.insert("proposed", SpecStatus.Proposed)
        table.insert("draft", SpecStatus.Draft)
        table.insert("under_review", SpecStatus.UnderReview)
        table.insert("approved", SpecStatus.Approved)
        table.insert("in_progress", SpecStatus.InProgress)
        table.insert("in_implementation", SpecStatus.InImplementation)
        table.insert("implemented", SpecStatus.Implemented)
        table.insert("verified", SpecStatus.Verified)
        table.insert("done", SpecStatus.Done)
        table.insert("archived", SpecStatus.Archived)
        table.insert("rejected", SpecStatus.Rejected)
        table.insert("backlog", SpecStatus.Backlog)
        table.insert("ready", SpecStatus.Ready)
        table.insert("in_review", SpecStatus.InReview)
        table.insert("blocked", SpecStatus.Blocked)
        table.insert("superseded", SpecStatus.Superseded)
        table.insert("outdated", SpecStatus.Outdated)
        table.insert("stable", SpecStatus.Stable)
        table.insert("deprecated", SpecStatus.Deprecated)
        table.insert("published", SpecStatus.Published)
        table.insert("analysed", SpecStatus.Analysed)
        table.insert("obsolete", SpecStatus.Obsolete)
        // A4: map.get() 返回 Option<&T> —— is 解构 + .clone()（trap23 A4 已验证形态）。
        is table.get(s) {
            Some(v) -> return v.clone(),
            None -> return SpecStatus.Draft
        }
    }
}

// ============================================================
// SpecItem — the minimal spec unit (struct + factory)
// ============================================================

/// The minimal spec unit (one Goal, one Architecture decision, ...).
/// - id: type-prefixed number (G1, A3, S1.1)
/// - depends_on: manually-declared forward deps (item IDs)
/// - related: derived reverse-links (filled by rebuild_relations, later)
/// - tags: label list
#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecItem {
    id str
    title str
    content str
    status SpecStatus
    depends_on List<str>
    related List<str>
    priority Option<str>
    assignee Option<str>
    test_file Option<str>
    file Option<str>
    milestone Option<str>
    module Option<str>
    tags List<str>
    created_at u64
    modified_at u64
    completed_at Option<u64>
}

ext SpecItem {
    /// Factory: create with id + title, status Empty, timestamps = now.
    /// Rust 原版用 impl Into<String> — Auto 无 trait 约束参数，简化为 str。
    /// A15: now_sec() via time bridge. A8: id/title owned，多次用需 clone。
    pub static fn new(id str, title str) SpecItem {
        let now u64 = time.now_sec() as u64
        return SpecItem(
            id: id.clone(),
            title: title.clone(),
            content: "".to_string(),
            status: SpecStatus.Empty,
            depends_on: [],
            related: [],
            priority: None,
            assignee: None,
            test_file: None,
            file: None,
            milestone: None,
            module: None,
            tags: [],
            created_at: now,
            modified_at: now,
            completed_at: None
        )
    }
}

// ============================================================
// SpecsSection — a container for one of the 7 section kinds
// ============================================================

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecsSection {
    id str
    section_type SectionType
    title str
    items List<SpecItem>
    status SpecStatus
    content str
    depends_on List<str>
    last_modified u64
    last_verified Option<u64>
}

ext SpecsSection {
    /// Factory: empty section of the given type (title = display title).
    /// st is Copy in Rust; in Auto the owned value is consumed by the first
    /// method call, so derive fields from copies.
    pub static fn new(st SectionType) SpecsSection {
        return SpecsSection(
            id: st.as_str(),
            section_type: st,
            title: st.display_title(),
            items: [],
            status: SpecStatus.Empty,
            content: "".to_string(),
            depends_on: [],
            last_modified: time.now_sec() as u64,
            last_verified: None
        )
    }
}

// ============================================================
// SpecsDocument — the root (Document -> Section[] -> Item[])
// ============================================================

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecsDocument {
    project str
    version u64
    sections List<SpecsSection>
}

ext SpecsDocument {
    /// Factory: a document with all 7 empty sections.
    pub static fn new(project str) SpecsDocument {
        return SpecsDocument(
            project: project.clone(),
            version: 0,
            sections: [
                SpecsSection.new(SectionType.Goals),
                SpecsSection.new(SectionType.Architecture),
                SpecsSection.new(SectionType.Designs),
                SpecsSection.new(SectionType.Plans),
                SpecsSection.new(SectionType.Tests),
                SpecsSection.new(SectionType.Reviews),
                SpecsSection.new(SectionType.Reports)
            ]
        )
    }
}

// ============================================================
// SpecChange — a pending spec change (for LLM-proposed edits)
// ============================================================

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecChange {
    section_id str
    item_id str
    title Option<str>
    content Option<str>
    status Option<SpecStatus>
    reason str
}

// ============================================================
// State machine — per-section valid status transitions
// ============================================================

/// Per-section-type state-machine configuration.
/// A7 待测点: Vec<(SpecStatus, SpecStatus)> 作为字段类型 — Auto tuple 有限制。
#[derive(Clone, Debug)]
pub type SectionConfig {
    section_type SectionType
    allowed_statuses List<SpecStatus>
    allowed_transitions List<(SpecStatus, SpecStatus)>
}

ext SectionConfig {
    /// The state machine for a given section type.
    pub static fn for_type(st SectionType) SectionConfig {
        is st {
            SectionType.Goals -> return SectionConfig(
                section_type: st,
                allowed_statuses: [SpecStatus.Empty, SpecStatus.Proposed, SpecStatus.Analysed, SpecStatus.Approved, SpecStatus.InProgress, SpecStatus.Implemented, SpecStatus.Verified, SpecStatus.Done, SpecStatus.Archived],
                allowed_transitions: [(SpecStatus.Empty, SpecStatus.Proposed), (SpecStatus.Proposed, SpecStatus.Analysed), (SpecStatus.Analysed, SpecStatus.Approved), (SpecStatus.Approved, SpecStatus.InProgress), (SpecStatus.InProgress, SpecStatus.Implemented), (SpecStatus.Implemented, SpecStatus.Verified), (SpecStatus.Verified, SpecStatus.Done), (SpecStatus.Done, SpecStatus.Archived), (SpecStatus.InProgress, SpecStatus.Archived)]
            ),
            SectionType.Architecture -> return SectionConfig.for_arch_designs(st),
            SectionType.Designs -> return SectionConfig.for_arch_designs(st),
            SectionType.Plans -> return SectionConfig(
                section_type: st,
                allowed_statuses: [SpecStatus.Empty, SpecStatus.Draft, SpecStatus.Approved, SpecStatus.InProgress, SpecStatus.Done, SpecStatus.Obsolete],
                allowed_transitions: [(SpecStatus.Empty, SpecStatus.Draft), (SpecStatus.Draft, SpecStatus.Approved), (SpecStatus.Approved, SpecStatus.InProgress), (SpecStatus.InProgress, SpecStatus.Done), (SpecStatus.Done, SpecStatus.Obsolete)]
            ),
            SectionType.Tests -> return SectionConfig(
                section_type: st,
                allowed_statuses: [SpecStatus.Empty, SpecStatus.Draft, SpecStatus.Implemented, SpecStatus.Done, SpecStatus.Verified, SpecStatus.Blocked],
                allowed_transitions: [(SpecStatus.Empty, SpecStatus.Draft), (SpecStatus.Draft, SpecStatus.Implemented), (SpecStatus.Implemented, SpecStatus.Done), (SpecStatus.Done, SpecStatus.Verified), (SpecStatus.Implemented, SpecStatus.Blocked), (SpecStatus.Blocked, SpecStatus.Implemented)]
            ),
            SectionType.Reviews -> return SectionConfig.for_reviews_reports(st),
            SectionType.Reports -> return SectionConfig.for_reviews_reports(st)
        }
    }

    // Architecture / Designs 共用（Auto 的 is 不支持 A | B 多模式合并）。
    static fn for_arch_designs(st SectionType) SectionConfig {
        return SectionConfig(
            section_type: st,
            allowed_statuses: [SpecStatus.Empty, SpecStatus.Draft, SpecStatus.UnderReview, SpecStatus.Approved, SpecStatus.Rejected, SpecStatus.Superseded, SpecStatus.Outdated],
            allowed_transitions: [(SpecStatus.Empty, SpecStatus.Draft), (SpecStatus.Draft, SpecStatus.UnderReview), (SpecStatus.UnderReview, SpecStatus.Approved), (SpecStatus.UnderReview, SpecStatus.Rejected), (SpecStatus.Approved, SpecStatus.Superseded), (SpecStatus.Approved, SpecStatus.Outdated)]
        )
    }

    // Reviews / Reports 共用。
    static fn for_reviews_reports(st SectionType) SectionConfig {
        return SectionConfig(
            section_type: st,
            allowed_statuses: [SpecStatus.Empty, SpecStatus.Draft, SpecStatus.Published],
            allowed_transitions: [(SpecStatus.Empty, SpecStatus.Draft), (SpecStatus.Draft, SpecStatus.Published)]
        )
    }

    /// Is `from_status -> to_status` a legal transition? Idempotent (equal)
    /// always allowed; otherwise the pair must be in allowed_transitions.
    /// A22: `from`/`to` 是 Auto 保留字 — 参数名改为 from_status/to_status。
    /// A7: .contains((tuple)) 不支持 — 改用 for 循环逐对比较。
    pub fn can_transition(from_status SpecStatus, to_status SpecStatus) bool {
        if from_status == to_status {
            return true
        }
        for pair in self.allowed_transitions {
            if pair[0] == from_status {
                if pair[1] == to_status {
                    return true
                }
            }
        }
        return false
    }
}

// ============================================================
// Relation graph — derived reverse-links (related)
// ============================================================

// 原版用 regex::Regex 匹配 spec ID (a2r-8/9 限制: r"..." 误解析 + str/&str
// 不匹配)。改为遍历 known ID 集合用 str_contains 检查 —— 语义等价(scan_refs
// 本来就 filter known.contains),仅放弃 regex 的 \b 词边界(spec ID 实际独立
// 出现,影响可忽略)。

/// Collect all spec item IDs present in the document (across all sections).
fn all_ids(doc SpecsDocument) HashSet<str> {
    var set HashSet<str> = HashSet.new()
    for section in doc.sections {
        for item in section.items {
            set.insert(item.id.clone())
        }
    }
    return set
}

/// Scan text for references to known item IDs (deduped). Only references to
/// IDs that actually exist in known are kept.
fn scan_refs(text str, known HashSet<str>) List<str> {
    var refs List<str> = []
    for id in known {
        if text.contains(id) {
            refs.push(id.clone())
        }
    }
    refs.sort()
    return refs
}

// NOTE: rebuild_relations() is NOT ported to Auto yet. The original uses a
// HashMap<String, Vec<String>> reverse-edge accumulator, and a2r mishandles
// std HashMap method calls on composite-generic value types:
//   - insert(k, List_value) spuriously injects .to_string() on the Vec (E0599)
//   - remove(key) / contains_key(key) don't add & to a String key (E0308)
// Options (plan 014): #[rs] escape hatch, hand-written Rust retained, or wait
// for a2r to fix composite-generic HashMap method handling. all_ids + scan_refs
// above ARE ported and verified; only the HashMap-accumulation loop is blocked.

// ============================================================
// Derived statuses — auto-advance item/section status from relations
// ============================================================

// 原版 derive_statuses 在函数内定义局部 struct Snap —— a2r 不支持函数内类型，
// 提到顶层。纯内部快照，无需 serde derive。
// a2r-4: 无显式 derive 时 a2r 自动加全量含 PartialOrd/Ord，会传播要求字段实现
// Ord（SectionType/SpecStatus 没有）—— 显式只 derive Clone, Debug。
#[derive(Clone, Debug)]
type Snap {
    id str
    section_type SectionType
    status SpecStatus
    related List<str>
}

/// Linear lookup in the snap list by id — returns Option<Snap> (owned clone).
/// 用 List 线性查找替代 HashMap.get（a2r-10: HashMap 复合泛型方法调用有缺陷）。
fn find_snap(snap List<Snap>, id str) Option<Snap> {
    for s in snap {
        if s.id == id {
            return Some(s.clone())
        }
    }
    return None
}

// 原版用 matches!(s, Empty|Proposed|Analysed|Approved|InProgress) —— Auto 无多模式，
// 用 is 链等价。
fn is_goal_advanceable(s SpecStatus) bool {
    is s {
        SpecStatus.Empty -> return true,
        SpecStatus.Proposed -> return true,
        SpecStatus.Analysed -> return true,
        SpecStatus.Approved -> return true,
        SpecStatus.InProgress -> return true,
        else -> return false
    }
}

// 原版 matches!(s, Done|Verified)。
fn is_test_done(s SpecStatus) bool {
    is s {
        SpecStatus.Done -> return true,
        SpecStatus.Verified -> return true,
        else -> return false
    }
}

// 否定形式（Auto 无逻辑非运算符 not/!，用否定语义函数替代 not is_test_done）。
fn is_test_pending(s SpecStatus) bool {
    is s {
        SpecStatus.Done -> return false,
        SpecStatus.Verified -> return false,
        else -> return true
    }
}

/// The "done-ish" terminal status for a section type (used by aggregate rule).
fn section_complete_status(st SectionType) SpecStatus {
    is st {
        SectionType.Goals -> return SpecStatus.Archived,
        SectionType.Architecture -> return SpecStatus.Approved,
        SectionType.Designs -> return SpecStatus.Approved,
        SectionType.Plans -> return SpecStatus.Done,
        SectionType.Tests -> return SpecStatus.Verified,
        SectionType.Reviews -> return SpecStatus.Published,
        SectionType.Reports -> return SpecStatus.Published
    }
}

// NOTE: derive_statuses() is NOT ported to Auto yet. It needs to mutate
// item.status / section.status in place while iterating &mut self.sections.
// a2r has two compounding gaps here (a2r-11):
//   - `for section in self.sections` in a mut fn generates a MOVE (`for section
//     in self.sections`), not `&mut self.sections`; `for mut x` is rejected
//     ("'mut' is not supported as a storage modifier").
//   - indexed mutable assignment `self.items[i].field = v` compiles to
//     `self.items[i].clone().field = v` (writes to a clone — no effect).
// Auto has no idiom for mutable-borrow iteration / in-place nested mutation,
// so this method needs an escape hatch or hand-written Rust. The helper fns
// above (Snap, find_snap, is_goal_advanceable, is_test_done, is_test_pending,
// section_complete_status) ARE ported and verified; only the mutating driver
// is blocked.
