/// specs.at — PoC: Spec Ledger data-model subset, ported from
/// backend/crates/musk/src/specs.rs.
///
/// Goal: validate whether a2r can transpile a real, axum-free data-model
/// slice of auto-musk back to compiling Rust. Scope (v2): the two scalar
/// enums (SectionType / SpecStatus) + string conversions + SpecItem struct
/// + factory (exercises String/Vec/Option/u64 fields + time bridge).
///
/// Notes on porting choices (cross-referenced to auto-lang-creator skill):
/// - A 类规则: 函数体不写 `::` 路径; 返回类型用空格不用 `->`; 字段/参数
///   类型用空格; 模式匹配用 `is` + `->`; 无分号。
/// - A15: now_sec() via `use.rust a2r_std::time` + `time.now_sec()`.

use.rust a2r_std::time
use.rust serde::{Serialize, Deserialize}
use.rust std::collections::{HashSet, HashMap}
use.rust std::fs
use.rust std::path::PathBuf
use.rust serde_json::{to_string_pretty, from_slice}
/// - Rust 的 SectionType 是无 repr 的 unit 枚举 (Goals, Architecture, ...)。
///   Auto 的 scalar enum 形态是 `VARIANT = N` (见 02_types/002_enum)。这里先
///   用 scalar 形态 (显式数字) — 这是 PoC 的第一个待测点: a2r 对此能否生成
///   可编译的 Rust enum + Display。

// ============================================================
// SectionType — the 7 spec-section kinds (scalar enum)
// ============================================================

#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
enum SectionType {
    Goals = 1
    Architecture = 2
    Designs = 3
    Plans = 4
    Tests = 5
    Reviews = 6
    Reports = 7
}

ext SectionType {
    /// snake_case string id (e.g. "goals", "architecture").
    /// NOTE: a2r auto-generates `from_id` for scalar enums, so we only
    /// hand-write `as_str` + `display_title` here.
    pub fn as_str() str {
        is self {
            SectionType.Goals -> return "goals",
            SectionType.Architecture -> return "architecture",
            SectionType.Designs -> return "designs",
            SectionType.Plans -> return "plans",
            SectionType.Tests -> return "tests",
            SectionType.Reviews -> return "reviews",
            SectionType.Reports -> return "reports"
        }
    }

    /// display title with emoji (for .ad file headers).
    pub fn display_title() str {
        is self {
            SectionType.Goals -> return "Goals",
            SectionType.Architecture -> return "Architecture",
            SectionType.Designs -> return "Designs",
            SectionType.Plans -> return "Plans",
            SectionType.Tests -> return "Tests",
            SectionType.Reviews -> return "Reviews",
            SectionType.Reports -> return "Reports"
        }
    }
}

// ============================================================
// SpecStatus — spec item/section lifecycle (23 variants)
// ============================================================

#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
enum SpecStatus {
    Empty = 1
    Proposed = 2
    Draft = 3
    UnderReview = 4
    Approved = 5
    InProgress = 6
    InImplementation = 7
    Implemented = 8
    Verified = 9
    Done = 10
    Archived = 11
    Rejected = 12
    Backlog = 13
    Ready = 14
    InReview = 15
    Blocked = 16
    Superseded = 17
    Outdated = 18
    Stable = 19
    Deprecated = 20
    Published = 21
    Analysed = 22
    Obsolete = 23
}

ext SpecStatus {
    /// snake_case string.
    pub fn to_str() str {
        is self {
            SpecStatus.Empty -> return "empty",
            SpecStatus.Proposed -> return "proposed",
            SpecStatus.Draft -> return "draft",
            SpecStatus.UnderReview -> return "under_review",
            SpecStatus.Approved -> return "approved",
            SpecStatus.InProgress -> return "in_progress",
            SpecStatus.InImplementation -> return "in_implementation",
            SpecStatus.Implemented -> return "implemented",
            SpecStatus.Verified -> return "verified",
            SpecStatus.Done -> return "done",
            SpecStatus.Archived -> return "archived",
            SpecStatus.Rejected -> return "rejected",
            SpecStatus.Backlog -> return "backlog",
            SpecStatus.Ready -> return "ready",
            SpecStatus.InReview -> return "in_review",
            SpecStatus.Blocked -> return "blocked",
            SpecStatus.Superseded -> return "superseded",
            SpecStatus.Outdated -> return "outdated",
            SpecStatus.Stable -> return "stable",
            SpecStatus.Deprecated -> return "deprecated",
            SpecStatus.Published -> return "published",
            SpecStatus.Analysed -> return "analysed",
            SpecStatus.Obsolete -> return "obsolete"
        }
    }

    /// Parse from a string. Unknown -> Draft (lossy).
    /// A21: str 的 `is` 匹配会被 a2r 渲染成 unstable 的 str_as_str —— 改用
    /// Map 查表（避开字符串 is 匹配；A4: get() 返回 Option 需 ?? 兜底）。
    pub static fn from_str_lossy(s str) SpecStatus {
        var table Map<str, SpecStatus> = Map.new()
        table.insert("empty", SpecStatus.Empty)
        table.insert("proposed", SpecStatus.Proposed)
        table.insert("draft", SpecStatus.Draft)
        table.insert("under_review", SpecStatus.UnderReview)
        table.insert("approved", SpecStatus.Approved)
        table.insert("in_progress", SpecStatus.InProgress)
        table.insert("in_implementation", SpecStatus.InImplementation)
        table.insert("implemented", SpecStatus.Implemented)
        table.insert("verified", SpecStatus.Verified)
        table.insert("done", SpecStatus.Done)
        table.insert("archived", SpecStatus.Archived)
        table.insert("rejected", SpecStatus.Rejected)
        table.insert("backlog", SpecStatus.Backlog)
        table.insert("ready", SpecStatus.Ready)
        table.insert("in_review", SpecStatus.InReview)
        table.insert("blocked", SpecStatus.Blocked)
        table.insert("superseded", SpecStatus.Superseded)
        table.insert("outdated", SpecStatus.Outdated)
        table.insert("stable", SpecStatus.Stable)
        table.insert("deprecated", SpecStatus.Deprecated)
        table.insert("published", SpecStatus.Published)
        table.insert("analysed", SpecStatus.Analysed)
        table.insert("obsolete", SpecStatus.Obsolete)
        // A4: map.get() 返回 Option<&T> —— is 解构 + .clone()（trap23 A4 已验证形态）。
        is table.get(s) {
            Some(v) -> return v.clone(),
            None -> return SpecStatus.Draft
        }
    }
}

// ============================================================
// SpecItem — the minimal spec unit (struct + factory)
// ============================================================

/// The minimal spec unit (one Goal, one Architecture decision, ...).
/// - id: type-prefixed number (G1, A3, S1.1)
/// - depends_on: manually-declared forward deps (item IDs)
/// - related: derived reverse-links (filled by rebuild_relations, later)
/// - tags: label list
#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecItem {
    id str
    title str
    content str
    status SpecStatus
    depends_on List<str>
    related List<str>
    priority Option<str>
    assignee Option<str>
    test_file Option<str>
    file Option<str>
    milestone Option<str>
    module Option<str>
    tags List<str>
    created_at u64
    modified_at u64
    completed_at Option<u64>
}

ext SpecItem {
    /// Factory: create with id + title, status Empty, timestamps = now.
    /// Rust 原版用 impl Into<String> — Auto 无 trait 约束参数，简化为 str。
    /// A15: now_sec() via time bridge. A8: id/title owned，多次用需 clone。
    pub static fn new(id str, title str) SpecItem {
        let now u64 = time.now_sec() as u64
        return SpecItem(
            id: id.clone(),
            title: title.clone(),
            content: "".to_string(),
            status: SpecStatus.Empty,
            depends_on: [],
            related: [],
            priority: None,
            assignee: None,
            test_file: None,
            file: None,
            milestone: None,
            module: None,
            tags: [],
            created_at: now,
            modified_at: now,
            completed_at: None
        )
    }
}

// ============================================================
// SpecsSection — a container for one of the 7 section kinds
// ============================================================

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecsSection {
    id str
    section_type SectionType
    title str
    items List<SpecItem>
    status SpecStatus
    content str
    depends_on List<str>
    last_modified u64
    last_verified Option<u64>
}

ext SpecsSection {
    /// Factory: empty section of the given type (title = display title).
    /// st is Copy in Rust; in Auto the owned value is consumed by the first
    /// method call, so derive fields from copies.
    pub static fn new(st SectionType) SpecsSection {
        return SpecsSection(
            id: st.as_str(),
            section_type: st,
            title: st.display_title(),
            items: [],
            status: SpecStatus.Empty,
            content: "".to_string(),
            depends_on: [],
            last_modified: time.now_sec() as u64,
            last_verified: None
        )
    }
}

// ============================================================
// SpecsDocument — the root (Document -> Section[] -> Item[])
// ============================================================

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecsDocument {
    project str
    version u64
    sections List<SpecsSection>
}

ext SpecsDocument {
    /// Factory: a document with all 7 empty sections.
    pub static fn new(project str) SpecsDocument {
        return SpecsDocument(
            project: project.clone(),
            version: 0,
            sections: [
                SpecsSection.new(SectionType.Goals),
                SpecsSection.new(SectionType.Architecture),
                SpecsSection.new(SectionType.Designs),
                SpecsSection.new(SectionType.Plans),
                SpecsSection.new(SectionType.Tests),
                SpecsSection.new(SectionType.Reviews),
                SpecsSection.new(SectionType.Reports)
            ]
        )
    }
}

// ============================================================
// SpecChange — a pending spec change (for LLM-proposed edits)
// ============================================================

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecChange {
    section_id str
    item_id str
    title Option<str>
    content Option<str>
    status Option<SpecStatus>
    reason str
}

// ============================================================
// State machine — per-section valid status transitions
// ============================================================

/// Per-section-type state-machine configuration.
/// A7 待测点: Vec<(SpecStatus, SpecStatus)> 作为字段类型 — Auto tuple 有限制。
#[derive(Clone, Debug)]
pub type SectionConfig {
    section_type SectionType
    allowed_statuses List<SpecStatus>
    allowed_transitions List<(SpecStatus, SpecStatus)>
}

ext SectionConfig {
    /// The state machine for a given section type.
    pub static fn for_type(st SectionType) SectionConfig {
        is st {
            SectionType.Goals -> return SectionConfig(
                section_type: st,
                allowed_statuses: [SpecStatus.Empty, SpecStatus.Proposed, SpecStatus.Analysed, SpecStatus.Approved, SpecStatus.InProgress, SpecStatus.Implemented, SpecStatus.Verified, SpecStatus.Done, SpecStatus.Archived],
                allowed_transitions: [(SpecStatus.Empty, SpecStatus.Proposed), (SpecStatus.Proposed, SpecStatus.Analysed), (SpecStatus.Analysed, SpecStatus.Approved), (SpecStatus.Approved, SpecStatus.InProgress), (SpecStatus.InProgress, SpecStatus.Implemented), (SpecStatus.Implemented, SpecStatus.Verified), (SpecStatus.Verified, SpecStatus.Done), (SpecStatus.Done, SpecStatus.Archived), (SpecStatus.InProgress, SpecStatus.Archived)]
            ),
            SectionType.Architecture -> return SectionConfig.for_arch_designs(st),
            SectionType.Designs -> return SectionConfig.for_arch_designs(st),
            SectionType.Plans -> return SectionConfig(
                section_type: st,
                allowed_statuses: [SpecStatus.Empty, SpecStatus.Draft, SpecStatus.Approved, SpecStatus.InProgress, SpecStatus.Done, SpecStatus.Obsolete],
                allowed_transitions: [(SpecStatus.Empty, SpecStatus.Draft), (SpecStatus.Draft, SpecStatus.Approved), (SpecStatus.Approved, SpecStatus.InProgress), (SpecStatus.InProgress, SpecStatus.Done), (SpecStatus.Done, SpecStatus.Obsolete)]
            ),
            SectionType.Tests -> return SectionConfig(
                section_type: st,
                allowed_statuses: [SpecStatus.Empty, SpecStatus.Draft, SpecStatus.Implemented, SpecStatus.Done, SpecStatus.Verified, SpecStatus.Blocked],
                allowed_transitions: [(SpecStatus.Empty, SpecStatus.Draft), (SpecStatus.Draft, SpecStatus.Implemented), (SpecStatus.Implemented, SpecStatus.Done), (SpecStatus.Done, SpecStatus.Verified), (SpecStatus.Implemented, SpecStatus.Blocked), (SpecStatus.Blocked, SpecStatus.Implemented)]
            ),
            SectionType.Reviews -> return SectionConfig.for_reviews_reports(st),
            SectionType.Reports -> return SectionConfig.for_reviews_reports(st)
        }
    }

    // Architecture / Designs 共用（Auto 的 is 不支持 A | B 多模式合并）。
    static fn for_arch_designs(st SectionType) SectionConfig {
        return SectionConfig(
            section_type: st,
            allowed_statuses: [SpecStatus.Empty, SpecStatus.Draft, SpecStatus.UnderReview, SpecStatus.Approved, SpecStatus.Rejected, SpecStatus.Superseded, SpecStatus.Outdated],
            allowed_transitions: [(SpecStatus.Empty, SpecStatus.Draft), (SpecStatus.Draft, SpecStatus.UnderReview), (SpecStatus.UnderReview, SpecStatus.Approved), (SpecStatus.UnderReview, SpecStatus.Rejected), (SpecStatus.Approved, SpecStatus.Superseded), (SpecStatus.Approved, SpecStatus.Outdated)]
        )
    }

    // Reviews / Reports 共用。
    static fn for_reviews_reports(st SectionType) SectionConfig {
        return SectionConfig(
            section_type: st,
            allowed_statuses: [SpecStatus.Empty, SpecStatus.Draft, SpecStatus.Published],
            allowed_transitions: [(SpecStatus.Empty, SpecStatus.Draft), (SpecStatus.Draft, SpecStatus.Published)]
        )
    }

    /// Is `from_status -> to_status` a legal transition? Idempotent (equal)
    /// always allowed; otherwise the pair must be in allowed_transitions.
    /// A22: `from`/`to` 是 Auto 保留字 — 参数名改为 from_status/to_status。
    /// A7: .contains((tuple)) 不支持 — 改用 for 循环逐对比较。
    pub fn can_transition(from_status SpecStatus, to_status SpecStatus) bool {
        if from_status == to_status {
            return true
        }
        for pair in self.allowed_transitions {
            if pair[0] == from_status {
                if pair[1] == to_status {
                    return true
                }
            }
        }
        return false
    }
}

// ============================================================
// Relation graph — derived reverse-links (related)
// ============================================================

// 原版用 regex::Regex 匹配 spec ID (a2r-8/9 限制: r"..." 误解析 + str/&str
// 不匹配)。改为遍历 known ID 集合用 str_contains 检查 —— 语义等价(scan_refs
// 本来就 filter known.contains),仅放弃 regex 的 \b 词边界(spec ID 实际独立
// 出现,影响可忽略)。

/// Collect all spec item IDs present in the document (across all sections).
fn all_ids(doc SpecsDocument) HashSet<str> {
    var set HashSet<str> = HashSet.new()
    for section in doc.sections {
        for item in section.items {
            set.insert(item.id.clone())
        }
    }
    return set
}

/// Scan text for references to known item IDs (deduped). Only references to
/// IDs that actually exist in known are kept.
fn scan_refs(text str, known HashSet<str>) List<str> {
    var refs List<str> = []
    for id in known {
        if text.contains(id) {
            refs.push(id.clone())
        }
    }
    refs.sort()
    return refs
}

// NOTE: rebuild_relations() originally used HashMap<String, Vec<String>> to
// accumulate reverse edges. a2r-10 mishandles composite-generic HashMap method
// calls (insert injects .to_string() on Vec values; remove/contains_key omit &
// on String keys). Workaround: use a List<ReverseEntry> (target_id + referrers)
// with linear lookup instead of HashMap. Plus a2r-11 workaround (whole-field
// reassign instead of in-place item.related mutation).

type ReverseEntry {
    target_id str
    referrers List<str>
}

/// Linear lookup: find or create the ReverseEntry for target_id in the list.
/// (replaces HashMap.entry(); a2r-10 blocks HashMap on composite generics.)
fn upsert_reverse(entries List<ReverseEntry>, target_id str) ReverseEntry {
    for e in entries.clone() {
        if e.target_id == target_id {
            return e
        }
    }
    let fresh ReverseEntry = ReverseEntry(target_id: target_id.clone(), referrers: [])
    return fresh
}

ext SpecsDocument {
    /// Rebuild every item's derived `related` field (reverse-links).
    /// For each forward edge A -> B (from depends_on + content-scanned refs),
    /// B's related list gains A. After scan, each related list is sorted+deduped.
    pub mut fn rebuild_relations() void {
        var known HashSet<str> = all_ids(self.clone())
        // reverse edges, accumulated as a List (NOT HashMap — a2r-10)
        var reverse List<ReverseEntry> = []

        for section in self.sections.clone() {
            for item in section.items.clone() {
                var forwards List<str> = item.depends_on.clone()
                let scanned List<str> = scan_refs(item.content.clone(), known.clone())
                for s in scanned.clone() {
                    forwards.push(s.clone())
                }
                forwards.sort()
                // record reverse edge: for each target, referrer=item.id.
                // a2r-11: can't mutate an element yielded by `for e in list`;
                // rebuild the reverse list with an updated entry instead.
                for target in forwards.clone() {
                    var updated_reverse List<ReverseEntry> = []
                    var target_found bool = false
                    for e in reverse.clone() {
                        if e.target_id == target {
                            target_found = true
                            var more List<str> = e.referrers.clone()
                            more.push(item.id.clone())
                            let updated ReverseEntry = ReverseEntry(target_id: e.target_id.clone(), referrers: more)
                            updated_reverse.push(updated)
                        } else {
                            updated_reverse.push(e)
                        }
                    }
                    if target_found == false {
                        let entry ReverseEntry = ReverseEntry(target_id: target.clone(), referrers: [item.id.clone()])
                        updated_reverse.push(entry)
                    }
                    reverse = updated_reverse
                }
            }
        }

        // Build new sections with updated related fields (whole-field reassign,
        // per a2r-11 workaround).
        var new_sections List<SpecsSection> = []
        for section in self.sections.clone() {
            var new_items List<SpecItem> = []
            for item in section.items.clone() {
                // find reverse entry for this item's id
                var new_related List<str> = []
                for e in reverse.clone() {
                    if e.target_id == item.id {
                        new_related = e.referrers.clone()
                    }
                }
                new_related.sort()
                // dedup (simple: rebuild without consecutive dups after sort)
                var deduped List<str> = []
                var prev str = ""
                for r in new_related.clone() {
                    if r != prev {
                        deduped.push(r.clone())
                    }
                    prev = r.clone()
                }
                // copy item with updated related (a2r-12: bind to var before push)
                let new_item SpecItem = SpecItem(
                    id: item.id.clone(),
                    title: item.title.clone(),
                    content: item.content.clone(),
                    status: item.status,
                    depends_on: item.depends_on.clone(),
                    related: deduped,
                    priority: item.priority.clone(),
                    assignee: item.assignee.clone(),
                    test_file: item.test_file.clone(),
                    file: item.file.clone(),
                    milestone: item.milestone.clone(),
                    module: item.module.clone(),
                    tags: item.tags.clone(),
                    created_at: item.created_at,
                    modified_at: item.modified_at,
                    completed_at: item.completed_at
                )
                new_items.push(new_item)
            }
            let new_section SpecsSection = SpecsSection(
                id: section.id.clone(),
                section_type: section.section_type,
                title: section.title.clone(),
                items: new_items,
                status: section.status,
                content: section.content.clone(),
                depends_on: section.depends_on.clone(),
                last_modified: section.last_modified,
                last_verified: section.last_verified.clone()
            )
            new_sections.push(new_section)
        }
        self.sections = new_sections
    }
}

// ============================================================
// Derived statuses — auto-advance item/section status from relations
// ============================================================

// 原版 derive_statuses 在函数内定义局部 struct Snap —— a2r 不支持函数内类型，
// 提到顶层。纯内部快照，无需 serde derive。
// a2r-4: 无显式 derive 时 a2r 自动加全量含 PartialOrd/Ord，会传播要求字段实现
// Ord（SectionType/SpecStatus 没有）—— 显式只 derive Clone, Debug。
#[derive(Clone, Debug)]
type Snap {
    id str
    section_type SectionType
    status SpecStatus
    related List<str>
}

/// Linear lookup in the snap list by id — returns Option<Snap> (owned clone).
/// 用 List 线性查找替代 HashMap.get（a2r-10: HashMap 复合泛型方法调用有缺陷）。
fn find_snap(snap List<Snap>, id str) Option<Snap> {
    for s in snap {
        if s.id == id {
            return Some(s.clone())
        }
    }
    return None
}

// 原版用 matches!(s, Empty|Proposed|Analysed|Approved|InProgress) —— Auto 无多模式，
// 用 is 链等价。
fn is_goal_advanceable(s SpecStatus) bool {
    is s {
        SpecStatus.Empty -> return true,
        SpecStatus.Proposed -> return true,
        SpecStatus.Analysed -> return true,
        SpecStatus.Approved -> return true,
        SpecStatus.InProgress -> return true,
        else -> return false
    }
}

// 原版 matches!(s, Done|Verified)。
fn is_test_done(s SpecStatus) bool {
    is s {
        SpecStatus.Done -> return true,
        SpecStatus.Verified -> return true,
        else -> return false
    }
}

// 否定形式（Auto 无逻辑非运算符 not/!，用否定语义函数替代 not is_test_done）。
fn is_test_pending(s SpecStatus) bool {
    is s {
        SpecStatus.Done -> return false,
        SpecStatus.Verified -> return false,
        else -> return true
    }
}

/// The "done-ish" terminal status for a section type (used by aggregate rule).
fn section_complete_status(st SectionType) SpecStatus {
    is st {
        SectionType.Goals -> return SpecStatus.Archived,
        SectionType.Architecture -> return SpecStatus.Approved,
        SectionType.Designs -> return SpecStatus.Approved,
        SectionType.Plans -> return SpecStatus.Done,
        SectionType.Tests -> return SpecStatus.Verified,
        SectionType.Reviews -> return SpecStatus.Published,
        SectionType.Reports -> return SpecStatus.Published
    }
}

// NOTE: derive_statuses() is NOT ported to Auto yet. It needs to mutate
// item.status / section.status in place while iterating &mut self.sections.
// a2r has two compounding gaps here (a2r-11):
//   - `for section in self.sections` in a mut fn generates a MOVE (`for section
//     in self.sections`), not `&mut self.sections`; `for mut x` is rejected
//     ("'mut' is not supported as a storage modifier").
//   - indexed mutable assignment `self.items[i].field = v` compiles to
//     `self.items[i].clone().field = v` (writes to a clone — no effect).
// Auto has no idiom for mutable-borrow iteration / in-place nested mutation,
// so this method needs an escape hatch or hand-written Rust. The helper fns
// above (Snap, find_snap, is_goal_advanceable, is_test_done, is_test_pending,
// section_complete_status) ARE ported and verified; only the mutating driver
// is blocked.

ext SpecsDocument {
    /// Derive (auto-advance) statuses from the relation graph (see plan 014).
    /// WORKAROUND for a2r-11 (no mutable-borrow iteration / in-place nested
    /// mutation): instead of mutating item.status in place, build NEW lists of
    /// sections/items with updated statuses and whole-field reassign
    /// self.sections at the end (a2r handles `self.field = new_list` fine).
    pub mut fn derive_statuses() void {
        // Snapshot as a flat List<Snap> for read-only cross-section lookup.
        var snap List<Snap> = []
        for section in self.sections.clone() {
            for item in section.items.clone() {
                snap.push(Snap(
                    id: item.id.clone(),
                    section_type: section.section_type,
                    status: item.status,
                    related: item.related.clone()
                ))
            }
        }

        let goal_cfg SectionConfig = SectionConfig.for_type(SectionType.Goals)

        // Build new sections list (whole-field reassign pattern).
        var new_sections List<SpecsSection> = []
        for section in self.sections.clone() {
            var new_section_status SpecStatus = section.status
            var new_last_modified u64 = section.last_modified

            // Build new items list for this section.
            var new_items List<SpecItem> = []
            for item in section.items.clone() {
                var new_status SpecStatus = item.status
                var new_item_modified u64 = item.modified_at

                if section.section_type == SectionType.Goals {
                    let forwards List<str> = item.depends_on.clone()
                    var related_plans_all_done bool = true
                    var has_any_plan bool = false
                    for rid in forwards.clone() {
                        is find_snap(snap.clone(), rid) {
                            Some(x) -> {
                                if x.section_type == SectionType.Plans {
                                    has_any_plan = true
                                    if x.status != SpecStatus.Done {
                                        related_plans_all_done = false
                                    }
                                }
                            },
                            None -> {}
                        }
                    }

                    // Rule 1: Goal -> Implemented
                    if has_any_plan {
                        if related_plans_all_done {
                            if is_goal_advanceable(item.status) {
                                if goal_cfg.can_transition(item.status, SpecStatus.Implemented) {
                                    new_status = SpecStatus.Implemented
                                    new_item_modified = time.now_sec() as u64
                                }
                            }
                        }
                    }

                    // Rule 2: Goal -> Verified
                    if new_status == SpecStatus.Implemented {
                        var tests_ok bool = true
                        var has_tests bool = false
                        var has_review_published bool = false
                        for rid in forwards.clone() {
                            is find_snap(snap.clone(), rid) {
                                Some(x) -> {
                                    if x.section_type == SectionType.Tests {
                                        has_tests = true
                                        if is_test_pending(x.status) {
                                            tests_ok = false
                                        }
                                    }
                                    if x.section_type == SectionType.Reviews {
                                        if x.status == SpecStatus.Published {
                                            has_review_published = true
                                        }
                                    }
                                },
                                None -> {}
                            }
                        }
                        if has_tests {
                            if tests_ok {
                                if has_review_published {
                                    if goal_cfg.can_transition(SpecStatus.Implemented, SpecStatus.Verified) {
                                        new_status = SpecStatus.Verified
                                        new_item_modified = time.now_sec() as u64
                                    }
                                }
                            }
                        }
                    }
                }

                // copy item with possibly-updated status.
                // a2r-12: struct literal as a .push() arg in an ext method of
                // a DIFFERENT type fails type-check ("field type mismatch").
                // Workaround: bind to a local var first, then push.
                let new_item SpecItem = SpecItem(
                    id: item.id.clone(),
                    title: item.title.clone(),
                    content: item.content.clone(),
                    status: new_status,
                    depends_on: item.depends_on.clone(),
                    related: item.related.clone(),
                    priority: item.priority.clone(),
                    assignee: item.assignee.clone(),
                    test_file: item.test_file.clone(),
                    file: item.file.clone(),
                    milestone: item.milestone.clone(),
                    module: item.module.clone(),
                    tags: item.tags.clone(),
                    created_at: item.created_at,
                    modified_at: new_item_modified,
                    completed_at: item.completed_at
                )
                new_items.push(new_item)
            }

            // Rule 3: section aggregate status
            var all_items_empty bool = section.items.len() == 0
            if all_items_empty {
                // empty section: no aggregate change
            } else {
                let done_status SpecStatus = section_complete_status(section.section_type)
                let cfg SectionConfig = SectionConfig.for_type(section.section_type)
                var all_done bool = true
                for it in new_items.clone() {
                    if it.status != done_status {
                        all_done = false
                    }
                }
                if all_done {
                    if cfg.can_transition(new_section_status, done_status) {
                        if new_section_status != done_status {
                            new_section_status = done_status
                            new_last_modified = time.now_sec() as u64
                        }
                    }
                } else {
                    var any_non_empty bool = false
                    for it in new_items.clone() {
                        if it.status != SpecStatus.Empty {
                            any_non_empty = true
                        }
                    }
                    if any_non_empty {
                        if cfg.can_transition(new_section_status, SpecStatus.Draft) {
                            if new_section_status == SpecStatus.Empty {
                                new_section_status = SpecStatus.Draft
                                new_last_modified = time.now_sec() as u64
                            }
                        }
                    }
                }
            }

            // copy section with possibly-updated status + new items.
            // a2r-12 workaround: bind to local var first, then push.
            let new_section SpecsSection = SpecsSection(
                id: section.id.clone(),
                section_type: section.section_type,
                title: section.title.clone(),
                items: new_items,
                status: new_section_status,
                content: section.content.clone(),
                depends_on: section.depends_on.clone(),
                last_modified: new_last_modified,
                last_verified: section.last_verified.clone()
            )
            new_sections.push(new_section)
        }

        // whole-field reassign (a2r handles this; in-place element mutation
        // would compile to a no-op clone write per a2r-11)
        self.sections = new_sections
    }
}

// ============================================================
// Overview & drift-check
// ============================================================

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SectionOverview {
    id str
    section_type SectionType
    title str
    status SpecStatus
    item_count uint
    status_counts List<(str, uint)>
}

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type SpecsOverview {
    project str
    version u64
    total_items uint
    sections List<SectionOverview>
}

ext SpecsDocument {
    /// Build an aggregate overview (per-section item counts + status dist).
    pub fn overview() SpecsOverview {
        var sections List<SectionOverview> = []
        var total uint = 0
        for s in self.sections.clone() {
            // count items per status (simple two-pass, no BTreeMap)
            var seen List<str> = []
            var counts List<(str, uint)> = []
            for it in s.items.clone() {
                let st str = it.status.to_str()
                var found bool = false
                for pair in counts.clone() {
                    if pair[0] == st {
                        found = true
                    }
                }
                if found == false {
                    seen.push(st.clone())
                }
            }
            // tally each seen status
            for st in seen.clone() {
                var n uint = 0
                for it in s.items.clone() {
                    if it.status.to_str() == st {
                        n = n + 1u
                    }
                }
                counts.push((st.clone(), n))
            }
            let count uint = s.items.len() as uint
            total = total + count
            // a2r-12: bind struct literal to var before push
            let so SectionOverview = SectionOverview(
                id: s.id.clone(),
                section_type: s.section_type,
                title: s.title.clone(),
                status: s.status,
                item_count: count,
                status_counts: counts
            )
            sections.push(so)
        }
        let result SpecsOverview = SpecsOverview(
            project: self.project.clone(),
            version: self.version,
            total_items: total,
            sections: sections
        )
        return result
    }
}

// ============================================================
// SpecsStore — JSON file persistence + CRUD
// ============================================================

/// A file-backed spec store. The whole document is serialized to one JSON file.
pub type SpecsStore {
    path PathBuf
}

ext SpecsStore {
    /// Open (or create) a store at path.
    pub static fn new(path PathBuf) SpecsStore {
        return SpecsStore(path: path)
    }

    /// Load the document; create an empty one (persisted) if absent.
    /// a2r-13: .view marks a borrow (&) for &T params. serde_json fn calls
    /// need explicit `use.rust serde_json::{fn}` then bare `fn(...)` (not
    /// `serde_json.fn` — that becomes a value access, E0423). Result types
    /// left unannotated so a2r infers them, unwrapped via is-match.
    pub fn load() SpecsDocument {
        let read_result = fs.read(self.path.clone())
        is read_result {
            Ok(bytes) -> {
                let parse_result = from_slice(bytes.view)
                is parse_result {
                    Ok(doc) -> return doc,
                    Err(e) -> return SpecsDocument.new("project")
                }
            },
            Err(e) -> {
                // NotFound or other error -> create + persist empty doc
                let doc SpecsDocument = SpecsDocument.new("project")
                self.save(doc.clone())
                return doc
            }
        }
    }

    /// Persist the document.
    pub fn save(doc SpecsDocument) void {
        // ensure parent dir exists.
        let parent = self.path.parent()
        is parent {
            Some(p) -> {
                let mkdir_result = fs.create_dir_all(p.clone())
                is mkdir_result {
                    Ok(ok) -> {},
                    Err(e) -> {}
                }
            },
            None -> {}
        }
        // serialize to JSON string, then write.
        // (use to_string_pretty -> String, then fs.write(&str,&str); avoids the
        // Vec<u8> vs &str mismatch a2r hits when mapping fs.write to a2r_std.)
        let json_result = to_string_pretty(doc.view)
        is json_result {
            Ok(json) -> {
                // a2r maps fs.write to a2r_std::fs::write which returns bool
                // (not std::fs::write's Result); just call it, ignore outcome.
                let ok bool = fs.write(self.path.clone(), json)
            },
            Err(e) -> {}
        }
    }

    /// Upsert an item into a section, bumping the document version. Creates
    /// the item if item.id is new, replaces it otherwise. Rebuilds relations.
    /// a2r-11: returns the updated doc (whole-field rebuild) instead of
    /// mutating in place; returns Option to signal section-not-found (None).
    pub fn upsert_item(doc SpecsDocument, section_id str, item SpecItem) Option<SpecsDocument> {
        var section_found bool = false
        var new_sections List<SpecsSection> = []
        for s in doc.sections.clone() {
            if s.id == section_id {
                section_found = true
                // build new items list: replace if id matches, else append
                var item_found bool = false
                var new_items List<SpecItem> = []
                for existing in s.items.clone() {
                    if existing.id == item.id {
                        item_found = true
                        new_items.push(item.clone())
                    } else {
                        new_items.push(existing)
                    }
                }
                if item_found == false {
                    new_items.push(item.clone())
                }
                let now u64 = time.now_sec() as u64
                let updated_section SpecsSection = SpecsSection(
                    id: s.id.clone(),
                    section_type: s.section_type,
                    title: s.title.clone(),
                    items: new_items,
                    status: s.status,
                    content: s.content.clone(),
                    depends_on: s.depends_on.clone(),
                    last_modified: now,
                    last_verified: s.last_verified.clone()
                )
                new_sections.push(updated_section)
            } else {
                new_sections.push(s)
            }
        }
        if section_found == false {
            return None
        }
        // rebuild new doc with bumped version + rebuilt relations + derived
        var new_doc SpecsDocument = SpecsDocument(project: doc.project.clone(), version: doc.version + 1u, sections: new_sections)
        new_doc.rebuild_relations()
        new_doc.derive_statuses()
        return Some(new_doc)
    }

    /// Transition an item's status (validates via per-section state machine).
    /// Returns Option<SpecsDocument> — None if section/item not found OR the
    /// transition is invalid for that section type.
    pub fn transition_item(doc SpecsDocument, section_id str, item_id str, new_status SpecStatus) Option<SpecsDocument> {
        var section_found bool = false
        var new_sections List<SpecsSection> = []
        var transition_ok bool = false
        for s in doc.sections.clone() {
            if s.id == section_id {
                section_found = true
                let cfg SectionConfig = SectionConfig.for_type(s.section_type)
                var new_items List<SpecItem> = []
                for it in s.items.clone() {
                    if it.id == item_id {
                        if cfg.can_transition(it.status, new_status) {
                            transition_ok = true
                            let now u64 = time.now_sec() as u64
                            var completed Option<u64> = it.completed_at.clone()
                            if new_status == SpecStatus.Done {
                                completed = Some(now)
                            }
                            let updated SpecItem = SpecItem(
                                id: it.id.clone(),
                                title: it.title.clone(),
                                content: it.content.clone(),
                                status: new_status,
                                depends_on: it.depends_on.clone(),
                                related: it.related.clone(),
                                priority: it.priority.clone(),
                                assignee: it.assignee.clone(),
                                test_file: it.test_file.clone(),
                                file: it.file.clone(),
                                milestone: it.milestone.clone(),
                                module: it.module.clone(),
                                tags: it.tags.clone(),
                                created_at: it.created_at,
                                modified_at: now,
                                completed_at: completed
                            )
                            new_items.push(updated)
                        } else {
                            new_items.push(it)
                        }
                    } else {
                        new_items.push(it)
                    }
                }
                let now u64 = time.now_sec() as u64
                let updated_section SpecsSection = SpecsSection(
                    id: s.id.clone(),
                    section_type: s.section_type,
                    title: s.title.clone(),
                    items: new_items,
                    status: s.status,
                    content: s.content.clone(),
                    depends_on: s.depends_on.clone(),
                    last_modified: now,
                    last_verified: s.last_verified.clone()
                )
                new_sections.push(updated_section)
            } else {
                new_sections.push(s)
            }
        }
        if section_found == false {
            return None
        }
        if transition_ok == false {
            return None
        }
        let new_doc SpecsDocument = SpecsDocument(project: doc.project.clone(), version: doc.version + 1u, sections: new_sections)
        return Some(new_doc)
    }

    /// Delete an item. Returns (updated_doc, removed) — removed is true if the
    /// item existed. Rebuilds relations on success.
    pub fn delete_item(doc SpecsDocument, section_id str, item_id str) Option<SpecsDocument> {
        var section_found bool = false
        var any_removed bool = false
        var new_sections List<SpecsSection> = []
        for s in doc.sections.clone() {
            if s.id == section_id {
                section_found = true
                var new_items List<SpecItem> = []
                for it in s.items.clone() {
                    if it.id == item_id {
                        any_removed = true
                    } else {
                        new_items.push(it)
                    }
                }
                if any_removed {
                    let now u64 = time.now_sec() as u64
                    let updated_section SpecsSection = SpecsSection(
                        id: s.id.clone(),
                        section_type: s.section_type,
                        title: s.title.clone(),
                        items: new_items,
                        status: s.status,
                        content: s.content.clone(),
                        depends_on: s.depends_on.clone(),
                        last_modified: now,
                        last_verified: s.last_verified.clone()
                    )
                    new_sections.push(updated_section)
                } else {
                    new_sections.push(s)
                }
            } else {
                new_sections.push(s)
            }
        }
        if section_found == false {
            return None
        }
        if any_removed == false {
            return None
        }
        var new_doc SpecsDocument = SpecsDocument(project: doc.project.clone(), version: doc.version + 1u, sections: new_sections)
        new_doc.rebuild_relations()
        new_doc.derive_statuses()
        return Some(new_doc)
    }

    /// Drift check: compare in-memory doc against disk. Returns (disk_version,
    /// drifted) — drifted is true if disk version differs.
    pub fn drift_check(doc SpecsDocument) Option<(u64, bool)> {
        let disk SpecsDocument = self.load()
        let drifted bool = disk.version != doc.version
        return Some((disk.version, drifted))
    }
}
