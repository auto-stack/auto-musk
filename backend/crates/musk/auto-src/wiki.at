/// wiki.at — Wiki Knowledge Layer 数据层 + 纯 CRUD (Plan 018 Phase 3 试点)。
///
/// Ported from backend/crates/musk/src/wiki.rs, flattened to the portable
/// subset per the Phase 2 pattern:
/// - data model (WikiPage/WikiSource/WikiPageMeta/TreeNode/WikiManifest) -> Auto
/// - WikiStore 纯 Mutex CRUD + fs + serde_json -> Auto
/// - axum 路由/handler (wiki_routes/wiki_tree/.../Multipart) + API DTO +
///   guess_mime -> 手写边界 (axum/async/&'static str 是 a2r 盲区)
///
/// a2r 惯用法注记(本轮探测确认):
/// - `or`/`and` 关键字不支持 -> 布尔组合用嵌套 if
/// - `sort_by(fn-ref)` 不支持 -> 手动插入排序(comes_first)
/// - Result 链式 `.ok()` 不支持 -> `is` 匹配逐层展开
/// - Mutex guard 迭代: `for pair in guard` -> 发射 `&guard`
/// - TreeNode size/modified: file 节点省略 metadata(见 build_tree 内注记)

use.rust std::collections::HashMap
// 仅 PathBuf(std::path::Path 与 axum::extract::Path 重名,a2r 不支持 use-as 别名,
// 故不导入 std::path::Path —— 该类型未被数据层使用)。
use.rust std::path::PathBuf
use.rust std::sync::Mutex
use.rust std::fs
use.rust std::fs::DirEntry
use.rust serde::{Serialize, Deserialize}
use.rust serde_json::{to_string_pretty, from_str}
use.rust std::time::{SystemTime, Duration}

// ============================================================
// Data model
// ============================================================

/// WikiSource: 与手写版完全对齐 —— 无判别值 + snake_case wire 格式。
/// 手写版用手动 `impl Default` 返回 Custom; a2r 丢弃 `#[default]` 且
/// enum 上 derive(Default) 必须带 `#[default]`(E0665), 所以不 derive
/// Default —— load() 里显式 `WikiSource.Custom` 兜底, 行为一致。
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum WikiSource {
    Manual
    Guide
    ApiRef
    Custom
}

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type WikiPage {
    slug str
    title str
    content str
    source_type WikiSource
    tags List<str>
    version uint
    created_at u64
    updated_at u64
}

#[derive(Clone, Debug, Serialize, Deserialize)]
pub type WikiPageMeta {
    slug str
    title str
    source_type WikiSource
    tags List<str>
    version uint
    updated_at u64
}

/// Internal manifest shape (private in the hand-written version).
#[derive(Clone, Debug, Serialize, Deserialize)]
pub type WikiManifest {
    pages List<WikiPageMeta>
}

/// Tree node — recursive (folders carry children).
#[derive(Clone, Debug, Serialize, Deserialize)]
pub type TreeNode {
    name str
    path str
    #[serde(rename = "type")]
    node_type str
    #[serde(default, skip_serializing_if = "Option::is_none")]
    children Option<List<TreeNode>>
    #[serde(default, skip_serializing_if = "Option::is_none")]
    size Option<u64>
    #[serde(default, skip_serializing_if = "Option::is_none")]
    modified Option<u64>
}

// ============================================================
// WikiStore — Mutex<HashMap> cache + fs persistence
// ============================================================

/// Seconds since the UNIX epoch (used for page timestamps).
fn now() u64 {
    let elapsed = SystemTime.now().duration_since(SystemTime.UNIX_EPOCH).unwrap_or_default()
    return elapsed.as_secs()
}

/// 单项目 wiki 存储: wiki_dir 放 .md + _manifest.json; raw_dir 放上传资源。
/// pages 是懒加载内存缓存; 磁盘是源, 每次变更落盘。
#[derive(Debug)]
pub type WikiStore {
    wiki_dir PathBuf
    raw_dir PathBuf
    pages Mutex<HashMap<str, WikiPage>>
}

ext WikiStore {
    pub static fn new(wiki_dir PathBuf, raw_dir PathBuf) WikiStore {
        let m1 = fs.create_dir_all(wiki_dir.clone())
        is m1 {
            Ok(ok) -> {},
            Err(e) -> {}
        }
        let m2 = fs.create_dir_all(raw_dir.clone())
        is m2 {
            Ok(ok) -> {},
            Err(e) -> {}
        }
        let store WikiStore = WikiStore(
            wiki_dir: wiki_dir,
            raw_dir: raw_dir,
            pages: Mutex.new(HashMap.new())
        )
        return store
    }

    /// 从磁盘加载(或刷新)页面缓存: 读 manifest 元数据 + 每个 .md 内容。
    /// 幂等 — 任何读操作前调用都安全。
    pub fn load() void {
        var guard = self.pages.lock().unwrap()
        guard.clear()

        // manifest: _manifest.json 优先, 回退 manifest.json。
        // manifest 是 list(WikiManifest.pages: Vec<WikiPageMeta>), 用 List +
        // find_meta 线性查找是数据结构决定(非 HashMap.get 变通 — 之前注释误归因)。
        var metas List<WikiPageMeta> = []
        let r1 = fs.read_to_string(self.wiki_dir.join("_manifest.json"))
        is r1 {
            Ok(c) -> {
                let pr = parse_manifest(c)
                is pr {
                    Ok(m) -> {
                        for p in m.pages {
                            metas.push(p)
                        }
                    },
                    Err(e) -> {}
                }
            },
            Err(e) -> {
                let r2 = fs.read_to_string(self.wiki_dir.join("manifest.json"))
                is r2 {
                    Ok(c2) -> {
                        let pr2 = parse_manifest(c2)
                        is pr2 {
                            Ok(m2) -> {
                                for p in m2.pages {
                                    metas.push(p)
                                }
                            },
                            Err(e2) -> {}
                        }
                    },
                    Err(e2) -> {}
                }
            }
        }

        let slugs_res = walk_md_files(self.wiki_dir, "")
        is slugs_res {
            Ok(slugs) -> {
                for slug in slugs {
                    let page_path PathBuf = self.wiki_dir.join(slug.clone() + ".md")
                    let read_res = fs.read_to_string(page_path)
                    is read_res {
                        Ok(content) -> {
                            let meta = find_meta(metas.clone(), slug)
                            var source_type WikiSource = WikiSource.Custom
                            var tags List<str> = []
                            var version uint = 1
                            var updated_at u64 = 0
                            var title str = slug.clone()
                            is meta {
                                Some(m) -> {
                                    title = m.title.clone()
                                    source_type = m.source_type
                                    tags = m.tags.clone()
                                    version = m.version
                                    updated_at = m.updated_at
                                },
                                None -> {}
                            }
                            let page WikiPage = WikiPage(
                                slug: slug.clone(),
                                title: title,
                                content: content,
                                source_type: source_type,
                                tags: tags,
                                version: version,
                                created_at: updated_at,
                                updated_at: updated_at
                            )
                            guard.insert(slug.to_string(), page)
                        },
                        Err(e) -> {}
                    }
                }
            },
            Err(e) -> {}
        }
    }

    /// 列出所有页面元数据。
    pub fn list_pages() List<WikiPageMeta> {
        var result List<WikiPageMeta> = []
        var guard = self.pages.lock().unwrap()
        for pair in guard.iter() {
            let p = pair[1]
            result.push(WikiPageMeta(
                slug: p.slug.clone(),
                title: p.title.clone(),
                source_type: p.source_type,
                tags: p.tags.clone(),
                version: p.version,
                updated_at: p.updated_at
            ))
        }
        return result
    }

    /// 取单个页面(克隆)。
    pub fn get_page(slug str) Option<WikiPage> {
        var guard = self.pages.lock().unwrap()
        is guard.get(slug) {
            Some(p) -> return Some(p.clone()),
            None -> return None
        }
    }

    /// 全文搜索(content/title 含 query, 不区分大小写)。
    pub fn search(query str) List<WikiPage> {
        let q str = query.to_lower()
        var result List<WikiPage> = []
        var guard = self.pages.lock().unwrap()
        for pair in guard.iter() {
            let p = pair[1]
            let in_content = p.content.to_lower().contains(q.clone())
            let in_title = p.title.to_lower().contains(q.clone())
            if in_content {
                result.push(p.clone())
            } else if in_title {
                result.push(p.clone())
            }
        }
        return result
    }

    // ═══════════════════════════════════════════════════════════════════
    // WRITE 路径(Plan 020 Phase C 补全;对齐 hw wiki.rs 247-338 行)
    // ═══════════════════════════════════════════════════════════════════
    //
    // a2r 惯用法:Mutex guard 在 `is guard.get(...)` 后自动 drop(§14 W2),
    // 故「检查 → 落盘 → 再锁缓存」跨两次锁——hw 持锁全程,单测/行为等价
    // (并发窗口差异文档化)。

    /// 创建页面:盖时间戳/版本 → 写 .md → 缓存 + manifest。
    pub fn create_page(page WikiPage) Result<WikiPage, str> {
        var guard = self.pages.lock().unwrap()
        is guard.get(page.slug.view) {
            Some(_) -> return Err("Page '" + page.slug + "' already exists"),
            None -> {}
        }
        let now_t = now()
        var new_page WikiPage = WikiPage(
            slug: page.slug.clone(),
            title: page.title.clone(),
            content: page.content.clone(),
            source_type: page.source_type,
            tags: page.tags.clone(),
            version: 1,
            created_at: now_t,
            updated_at: now_t
        )
        let page_path = self.wiki_dir.join(new_page.slug.clone() + ".md")
        wiki_ensure_parent(page_path.clone())
        is wiki_write_page(page_path, new_page.content.view) {
            Err(e) -> return Err(e),
            Ok(_) -> {}
        }
        var guard2 = self.pages.lock().unwrap()
        let _ Option<WikiPage> = guard2.insert(new_page.slug.clone(), new_page.clone())
        is guard2.get(new_page.slug.view) {
            Some(_) -> {},
            None -> {}
        }
        self.save_manifest()
        return Ok(new_page)
    }

    /// 更新页面内容/标题/标签, 版本 +1, 写 .md + manifest。
    pub fn update_page(slug str, content str, title Option<str>, tags Option<List<str>>) Result<WikiPage, str> {
        var guard = self.pages.lock().unwrap()
        var existing Option<WikiPage> = None
        is guard.get(slug) {
            None -> return Err("Page '" + slug + "' not found"),
            Some(p) -> { existing = Some(p.clone()) }
        }
        // guard 自动 drop(§14 W2)后才可二次 lock
        is existing {
            None -> return Err("Page '" + slug + "' not found"),
            Some(page) -> {
                var new_page WikiPage = page.clone()
                new_page.content = content.to_string()
                is title {
                    Some(t) -> { new_page.title = t },
                    None -> {}
                }
                is tags {
                    Some(t2) -> { new_page.tags = t2 },
                    None -> {}
                }
                new_page.version = new_page.version + 1
                new_page.updated_at = now()
                let page_path = self.wiki_dir.join(new_page.slug.clone() + ".md")
                wiki_ensure_parent(page_path.clone())
                is wiki_write_page(page_path, new_page.content.view) {
                    Err(e) -> return Err(e),
                    Ok(_) -> {}
                }
                // 缓存插入走独立锁作用域 helper(a2r 在嵌套臂内的
                // `is guard.get` 不发射 drop(guard)→ 二次 lock 死锁)。
                self.cache_insert(new_page.clone())
                self.save_manifest()
                return Ok(new_page)
            }
        }
    }

    /// 缓存插入(独立锁作用域;供 write 路径在嵌套臂内调用)。
    fn cache_insert(page WikiPage) {
        var guard = self.pages.lock().unwrap()
        let _ Option<WikiPage> = guard.insert(page.slug.clone(), page.clone())
    }

    /// 删除页面: 移除缓存 + 删 .md + manifest。
    pub fn delete_page(slug str) Result<(), str> {
        var guard = self.pages.lock().unwrap()
        is guard.get(slug) {
            None -> return Err("Page '" + slug + "' not found"),
            Some(_) -> {}
        }
        var guard2 = self.pages.lock().unwrap()
        let removed = guard2.remove(slug)
        is removed {
            None -> return Err("Page '" + slug + "' not found"),
            Some(_) -> {}
        }
        let page_path = self.wiki_dir.join(slug.clone() + ".md")
        if page_path.exists() {
            wiki_delete_file(page_path.clone())
        }
        is guard2.get(slug) {
            Some(_) -> {},
            None -> {}
        }
        self.save_manifest()
        return Ok(())
    }

    /// 把所有页面元数据写成 _manifest.json(hw save_manifest; 最佳努力)。
    fn save_manifest() {
        var metas List<WikiPageMeta> = []
        var guard = self.pages.lock().unwrap()
        for pair in guard.iter() {
            let p = pair[1]
            metas.push(WikiPageMeta(
                slug: p.slug.clone(),
                title: p.title.clone(),
                source_type: p.source_type,
                tags: p.tags.clone(),
                version: p.version,
                updated_at: p.updated_at
            ))
        }
        let manifest WikiManifest = WikiManifest(pages: metas)
        let json_res = to_string_pretty(manifest.view)
        is json_res {
            Ok(json) -> {
                let path = self.wiki_dir.join("_manifest.json")
                is wiki_write_page(path, json.view) {
                    Ok(_) -> {},
                    Err(_) -> {}
                }
            },
            Err(_) -> {}
        }
    }
}

// ============================================================
// fs 辅助 — 递归目录遍历 / 树构建
// ============================================================

/// 解析 manifest 文本为 WikiManifest。
fn parse_manifest(content str) Result<WikiManifest, str> {
    let pr = from_str(content)
    is pr {
        Ok(m) -> return Ok(m),
        Err(e) -> return Err(e.to_string())
    }
}

/// 在 manifest 元数据列表里线性查找 slug(manifest 是 Vec<WikiPageMeta>,非 HashMap)。
fn find_meta(metas List<WikiPageMeta>, slug str) Option<WikiPageMeta> {
    for m in metas {
        if m.slug == slug {
            return Some(m.clone())
        }
    }
    return None
}

/// 递归收集 .md 文件(slug = 相对路径去 .md 扩展名)。
pub fn walk_md_files(root PathBuf, prefix str) Result<List<str>, str> {
    var result List<str> = []
    let dir_res = fs.read_dir(root)
    is dir_res {
        Err(e) -> return Err(e.to_string()),
        Ok(dir) -> {
            for entry in dir.flatten() {
                let name str = entry.file_name().to_string_lossy().to_string()
                if name.starts_with(".") {
                    continue
                }
                if name == "_manifest.json" {
                    continue
                }
                if name == "manifest.json" {
                    continue
                }
                var path str = name.clone()
                if prefix.len() > 0u {
                    path = prefix + "/" + name
                }
                let is_dir = entry.path().is_dir()
                if is_dir {
                    let sub = walk_md_files(entry.path(), path)
                    is sub {
                        Ok(slugs) -> {
                            for s in slugs {
                                result.push(s)
                            }
                        },
                        Err(e) -> return Err(e)
                    }
                } else if name.ends_with(".md") {
                    let slug str = path.trim_end_matches(".md").to_string()
                    result.push(slug)
                }
            }
        }
    }
    return Ok(result)
}

/// 文件夹在前 + 字母序 —— 插入排序(a2r 无 sort_by)。
fn comes_first(a TreeNode, b TreeNode) bool {
    if a.node_type == "folder" {
        if b.node_type != "folder" {
            return true
        }
        if a.name < b.name {
            return true
        }
        return false
    }
    if b.node_type == "folder" {
        return false
    }
    if a.name < b.name {
        return true
    }
    return false
}

fn insert_sorted(list List<TreeNode>, item TreeNode) List<TreeNode> {
    var result List<TreeNode> = []
    var inserted bool = false
    for e in list {
        if inserted == false {
            if comes_first(item.clone(), e.clone()) {
                result.push(item.clone())
                inserted = true
            }
        }
        result.push(e)
    }
    if inserted == false {
        result.push(item)
    }
    return result
}

/// 构建目录树(文件夹在前, 字母序)。
/// Plan 391 D1: extract file size as Option<u64> from a DirEntry's metadata.
/// 独立辅助 fn —— store 路径的 `let sz u64 = m.len()` 抑制 as i32 cast,
/// 使 size 能喂 Option<u64>(is 分支体内多语句的 let 会被 a2r 压缩丢变量,
/// 故抽成 fn)。modified 暂不取(duration_since 方法链, 留 None)。
fn file_size(entry @DirEntry) Option<u64> {
    let meta_opt = entry.metadata()
    is meta_opt {
        Ok(m) -> {
            let sz u64 = m.len()
            return Some(sz)
        }
        Err(_) -> return None
    }
}

pub fn build_tree(root PathBuf, prefix str) List<TreeNode> {
    var entries List<TreeNode> = []
    let dir_res = fs.read_dir(root)
    is dir_res {
        Err(e) -> return entries,
        Ok(dir) -> {
            for entry in dir.flatten() {
                let name str = entry.file_name().to_string_lossy().to_string()
                if name.starts_with(".") {
                    continue
                }
                if name == "_manifest.json" {
                    continue
                }
                if name == "manifest.json" {
                    continue
                }
                var path str = name.clone()
                if prefix.len() > 0u {
                    path = prefix + "/" + name
                }
                let entry_path = entry.path()
                let is_dir = entry_path.is_dir()
                if is_dir {
                    let children = build_tree(entry_path, path)
                    let node TreeNode = TreeNode(
                        name: name,
                        path: path,
                        node_type: "folder",
                        children: Some(children),
                        size: None,
                        modified: None
                    )
                    entries = insert_sorted(entries, node)
                } else {
                    // Plan 391 D1 闭环: file 节点 size 从 fs::Metadata.len() 取真实值。
                    // 此前 a2r 的 Auto int 模型把 .len() 强转 as i32(无法喂 Option<u64>),
                    // 迫使 size=None。D1 修复后, 辅助 fn file_size 内的 let sz u64 = m.len()
                    // (store 路径) 抑制 cast, 可取真实值。
                    // modified 涉及 duration_since(UNIX_EPOCH) 方法链, 暂留 None(文档化)。
                    let size_opt Option<u64> = file_size(entry)
                    let node TreeNode = TreeNode(
                        name: name,
                        path: path,
                        node_type: "file",
                        children: None,
                        size: size_opt,
                        modified: None
                    )
                    entries = insert_sorted(entries, node)
                }
            }
        }
    }
    return entries
}

/// 递归去掉 .md 扩展名 — 构建新列表(避免 a2r-11 可变借用遍历)。
pub fn strip_md_extensions(nodes List<TreeNode>) List<TreeNode> {
    var result List<TreeNode> = []
    for node in nodes {
        var name str = node.name.clone()
        var path str = node.path.clone()
        if node.node_type == "file" {
            if name.ends_with(".md") {
                name = name.trim_end_matches(".md").to_string()
                path = path.trim_end_matches(".md").to_string()
            }
        }
        var children Option<List<TreeNode>> = node.children.clone()
        is children {
            Some(c) -> {
                let stripped = strip_md_extensions(c)
                children = Some(stripped)
            },
            None -> {}
        }
        result.push(TreeNode(
            name: name,
            path: path,
            node_type: node.node_type.clone(),
            children: children,
            size: node.size,
            modified: node.modified
        ))
    }
    return result
}

// ═══════════════════════════════════════════════════════════════════
// HTTP 层(Plan 020 Phase D;对齐 hw wiki.rs 459-716 行)
// ═══════════════════════════════════════════════════════════════════
//
// 策略(018/019 已固化):handler 全部 Auto(extractor + ~Response + 错误包络);
// ws.wiki 访问 / fs 副作用 / Multipart 经 extern 委托。树构建走 .at 内的
// build_tree + strip_md_extensions(hw 语义已由 parity_wiki 验证)。
// 错误响应与 hw 逐字对齐:validate_path 失败 → text "Invalid path" 400;
// create 冲突 → text 409;update/delete 缺失 → text 404;raw 内部错 → text 500。
// 204 成功响应(hw `StatusCode::NO_CONTENT`)→ empty_response。

use.rust axum::Router
use.rust axum::routing::{get, post, put, delete}
use.rust axum::extract::{Query, Path, State, Multipart, DefaultBodyLimit}
use.rust axum::Json
use.rust axum::response::Response
use.rust serde_json::Value
use.rust crate::server::AppState

#[derive(Debug, Deserialize)]
pub type WorkspaceQuery { workspace Option<str> }

// ─── API DTOs(对齐 hw wiki.rs 408-457) ─────────────────────────────────────

#[derive(Serialize)]
pub type WikiListResponse { pages List<Value> }

#[derive(Serialize)]
pub type WikiPageResponse { page Value }

#[derive(Deserialize)]
pub type CreatePageRequest {
    slug str
    title str
    content str
    #[serde(default)]
    source_type WikiSource
    #[serde(default)]
    tags List<str>
}

#[derive(Deserialize)]
pub type UpdatePageRequest {
    content str
    title Option<str>
    tags Option<List<str>>
}

#[derive(Deserialize)]
pub type SearchRequest { query str }

#[derive(Serialize)]
pub type SearchResponse { results List<Value> }

#[derive(Deserialize)]
pub type MkdirRequest { path str }

#[derive(Deserialize)]
pub type UploadQuery {
    #[serde(default)]
    prefix str
    #[serde(default)]
    workspace Option<str>
}

// ─── Path validation(hw validate_path:拒绝 .. / 绝对路径) ─────────────────

/// hw validate_path 的等价 bool 版:true = 非法路径。
fn path_invalid(path str) bool {
    if path.contains("..") {
        return true
    }
    if path.starts_with("/") {
        return true
    }
    if path.starts_with("\\") {
        return true
    }
    return false
}

// ─── Wiki handlers ─────────────────────────────────────────────────────────

/// GET /api/forge/wiki/{project}/tree — wiki 页面目录树(去 .md 后缀)。
pub fn wiki_tree(s State<AppState>, q Query<WorkspaceQuery>, p Path<str>) ~Response {
    let wiki_dir PathBuf = ws_wiki_dir(s.view, q)
    let tree List<TreeNode> = build_tree(wiki_dir, "")
    let stripped List<TreeNode> = strip_md_extensions(tree)
    return ok_response(stripped)
}

/// GET /api/forge/raw/{project}/tree — raw 资源目录树(真实文件名)。
pub fn raw_tree(s State<AppState>, q Query<WorkspaceQuery>, p Path<str>) ~Response {
    let raw_dir PathBuf = ws_raw_dir(s.view, q)
    let _ = fs.create_dir_all(raw_dir.clone())
    let tree List<TreeNode> = build_tree(raw_dir, "")
    return ok_response(tree)
}

/// GET /api/forge/wiki/{project}/pages — list all page metadata。
pub fn list_pages(s State<AppState>, q Query<WorkspaceQuery>, p Path<str>) ~Response {
    let resp Value = ws_wiki_list(s.view, q)
    return ok_response(resp)
}

/// GET /api/forge/wiki/{project}/page/{*slug} — read a single page。
pub fn get_page(s State<AppState>, q Query<WorkspaceQuery>, p Path<(str, str)>) ~Response {
    let slug str = path_second(p.view)
    if path_invalid(slug.view) {
        return text_response("Invalid path", 400)
    }
    let page Value = ws_wiki_get(s.view, q, slug.view)
    if value_is_null(page.view) {
        return empty_response(404)
    }
    return ok_response(WikiPageResponse(page: page))
}

/// POST /api/forge/wiki/{project}/pages — create a new page。
pub fn create_page(s State<AppState>, q Query<WorkspaceQuery>, p Path<str>, body Json<CreatePageRequest>) ~Response {
    let slug str = body.slug.clone()
    if path_invalid(slug.view) {
        return text_response("Invalid path", 400)
    }
    let resp Value = ws_wiki_create(s.view, q, body)
    if resp_is_err(resp.view) {
        return text_response(resp_err_message(resp.view), resp_err_code(resp.view))
    }
    return ok_response(WikiPageResponse(page: resp))
}

/// PUT /api/forge/wiki/{project}/page/{*slug} — update page content/meta。
pub fn update_page(s State<AppState>, q Query<WorkspaceQuery>, p Path<(str, str)>, body Json<UpdatePageRequest>) ~Response {
    let slug str = path_second(p.view)
    if path_invalid(slug.view) {
        return text_response("Invalid path", 400)
    }
    let title Option<str> = body.title.clone()
    let tags Option<List<str>> = body.tags.clone()
    let resp Value = ws_wiki_update(s.view, q, slug.view, body.content.view, title, tags)
    if resp_is_err(resp.view) {
        return text_response(resp_err_message(resp.view), resp_err_code(resp.view))
    }
    return ok_response(WikiPageResponse(page: resp))
}

/// DELETE /api/forge/wiki/{project}/page/{*slug} — delete a page。
pub fn delete_page(s State<AppState>, q Query<WorkspaceQuery>, p Path<(str, str)>) ~Response {
    let slug str = path_second(p.view)
    if path_invalid(slug.view) {
        return text_response("Invalid path", 400)
    }
    let resp Value = ws_wiki_delete(s.view, q, slug.view)
    if resp_is_err(resp.view) {
        return text_response(resp_err_message(resp.view), resp_err_code(resp.view))
    }
    return empty_response(204)
}

/// POST /api/forge/wiki/{project}/search — full-text search across pages。
pub fn search(s State<AppState>, q Query<WorkspaceQuery>, p Path<str>, body Json<SearchRequest>) ~Response {
    let resp Value = ws_wiki_search(s.view, q, body.query.view)
    return ok_response(resp)
}

// ─── Raw handlers ──────────────────────────────────────────────────────────

/// POST /api/forge/raw/{project}/upload?prefix= — multipart upload。
pub fn raw_upload(s State<AppState>, p Path<str>, q Query<UploadQuery>, m Multipart) ~Response {
    let prefix str = q.prefix.clone()
    if prefix.len() > 0u {
        if path_invalid(prefix.view) {
            return text_response("Invalid path", 400)
        }
    }
    let resp Value = wiki_raw_upload(s.view, q, prefix.view, m).await
    if resp_is_err(resp.view) {
        return text_response(resp_err_message(resp.view), resp_err_code(resp.view))
    }
    return ok_response(resp)
}

/// GET /api/forge/raw/{project}/file/{*path} — serve a raw file by path。
/// extern 直接构造 Response(文件字节 + Content-Type;404 空响应)。
pub fn raw_file(s State<AppState>, q Query<WorkspaceQuery>, p Path<(str, str)>) ~Response {
    let path str = path_second(p.view)
    if path_invalid(path.view) {
        return text_response("Invalid path", 400)
    }
    return wiki_raw_file(s.view, q, path.view)
}

/// DELETE /api/forge/raw/{project}/file/{*path} — delete a raw file or folder。
pub fn raw_delete(s State<AppState>, q Query<WorkspaceQuery>, p Path<(str, str)>) ~Response {
    let path str = path_second(p.view)
    if path_invalid(path.view) {
        return text_response("Invalid path", 400)
    }
    let resp Value = wiki_raw_delete(s.view, q, path.view)
    if resp_is_err(resp.view) {
        return text_response(resp_err_message(resp.view), resp_err_code(resp.view))
    }
    return empty_response(204)
}

/// POST /api/forge/raw/{project}/mkdir — create a folder (recursively)。
pub fn raw_mkdir(s State<AppState>, q Query<WorkspaceQuery>, p Path<str>, body Json<MkdirRequest>) ~Response {
    let req_path str = body.path.clone()
    if path_invalid(req_path.view) {
        return text_response("Invalid path", 400)
    }
    let resp Value = wiki_raw_mkdir(s.view, q, req_path.view)
    if resp_is_err(resp.view) {
        return text_response(resp_err_message(resp.view), resp_err_code(resp.view))
    }
    return empty_response(204)
}

// ─── Router ────────────────────────────────────────────────────────────────

/// All wiki/raw routes。Routes use the full `/api/forge/...` paths the frontend
/// 
/// (useWiki.ts) hardcodes, so this is `.merge`-ed into the main router without
/// any prefix(与 hw wiki.rs wiki_routes 完全一致)。
pub fn wiki_routes() Router<AppState> {
    var app = Router.new()
    app = app.route("/api/forge/wiki/{project}/tree", get(wiki_tree))
    app = app.route("/api/forge/wiki/{project}/pages", get(list_pages).post(create_page))
    app = app.route("/api/forge/wiki/{project}/search", post(search))
    app = app.route("/api/forge/wiki/{project}/page/{*slug}", get(get_page).put(update_page).delete(delete_page))
    app = app.route("/api/forge/raw/{project}/tree", get(raw_tree))
    app = app.route("/api/forge/raw/{project}/upload", post(raw_upload).layer(DefaultBodyLimit.max(52428800)))
    app = app.route("/api/forge/raw/{project}/mkdir", post(raw_mkdir))
    app = app.route("/api/forge/raw/{project}/file/{*path}", get(raw_file).delete(raw_delete))
    return app
}

