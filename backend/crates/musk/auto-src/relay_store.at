/// relay_store.at — ported from backend/crates/musk/src/relay/store.rs.
///
/// Run store data model. Strategy (plan 014 mixed):
/// - RunEvent (hetero enum, 15 variants) + RunSummary + StepState + GateState
///   + RunMetadata + StartRunRequest + StartRunStep -> Auto
/// - RunState / RunEntry (contain upstream types crate::relay::{StepRecord,
///   PipelineEngine}) -> hand-written Rust (those are auto_ai_agent types
///   that can't be re-declared as plain data)
/// - RunStore (Mutex<HashMap> + disk persistence) -> hand-written Rust (Mutex)
///
/// Cross-module: GateType re-declared as scalar enum (real one in
/// crate::relay, from auto_ai_agent::orchestration).

use.rust serde::{Serialize, Deserialize}
use.rust std::collections::HashMap
use.rust std::time::{SystemTime, Duration}

fn now_secs() u64 {
    let now = SystemTime.now()
    let elapsed = now.elapsed().unwrap()
    return elapsed.as_secs()
}

// ============================================================
// Cross-module: GateType (mirrors crate::relay::GateType)
// ============================================================

#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum GateType {
    Auto = 1
    Human = 2
}

// ============================================================
// RunEvent — SSE stream events (hetero enum, 15 variants)
// ============================================================

/// A run event for SSE streaming + history replay. Tagged so the frontend's
/// event_type switch maps 1:1.
#[derive(Clone, Debug, Serialize, Deserialize)]
#[serde(tag = "type", rename_all = "snake_case")]
pub tag RunEvent {
    StepStarted { timestamp u64, step_id str, role_id str }
    StepCompleted { timestamp u64, step_id str, handoff_summary str }
    GateWaiting { timestamp u64, step_id str, gate str }
    GateResolved { timestamp u64, step_id str, decision str }
    RunCompleted { timestamp u64 }
    RunFailed { timestamp u64, error str }
    TokenSpend { timestamp u64, cumulative u64, step_tokens u64 }
    RelayUpdate { timestamp u64, step_id str, role_id str, status str }
    TurnDelta { timestamp u64, role_id str, text str }
    TurnToolCall { timestamp u64, role_id str, tool_id str, tool_name str, arguments Value }
    TurnToolResult { timestamp u64, role_id str, tool_id str, result str }
    TurnComplete { timestamp u64, role_id str }
    TurnError { timestamp u64, role_id str, message str }
    TurnBudgetWarning { timestamp u64, role_id str, remaining u64 }
    TurnBudgetExceeded { timestamp u64, role_id str }
}

use.rust serde_json::Value

ext RunEvent {
    /// Snake-case event_type the frontend switches on.
    /// (a2r tag-union is-match generates match Variant{..} arms.)
    pub fn event_type() str {
        is self {
            RunEvent.StepStarted -> return "step_started",
            RunEvent.StepCompleted -> return "step_completed",
            RunEvent.GateWaiting -> return "gate_waiting",
            RunEvent.GateResolved -> return "gate_resolved",
            RunEvent.RunCompleted -> return "run_completed",
            RunEvent.RunFailed -> return "run_failed",
            RunEvent.TokenSpend -> return "token_spend",
            RunEvent.RelayUpdate -> return "relay_update",
            RunEvent.TurnDelta -> return "turn_delta",
            RunEvent.TurnToolCall -> return "turn_tool_call",
            RunEvent.TurnToolResult -> return "turn_tool_result",
            RunEvent.TurnComplete -> return "turn_complete",
            RunEvent.TurnError -> return "turn_error",
            RunEvent.TurnBudgetWarning -> return "turn_budget_warning",
            RunEvent.TurnBudgetExceeded -> return "turn_budget_exceeded"
        }
    }

    /// The timestamp carried by every variant.
    /// NOTE: a2r misparses named-field tag-union destructuring
    /// (`Variant(e)` binds e to the first field and omits `..`, E0027). The
    /// original timestamp() stays hand-written in relay/store.rs; event_type()
    /// above (no destructuring) ports cleanly.
}

// ============================================================
// Read-model structs (no upstream types)
// ============================================================

/// Lightweight summary for list views.
#[derive(Clone, Debug, Serialize)]
pub type RunSummary {
    run_id str
    status str
    current_step uint
    total_steps uint
    current_profession Option<str>
    cumulative_tokens u64
    created_at u64
    updated_at u64
    #[serde(skip_serializing_if = "Option::is_none")]
    title Option<str>
    #[serde(skip_serializing_if = "Option::is_none")]
    task Option<str>
}

/// One step's state in a run.
#[derive(Clone, Debug, Serialize)]
pub type StepState {
    id str
    role_id str
    status str
    gate str
}

/// A gate waiting for resolution.
#[derive(Clone, Debug, Serialize)]
pub type GateState {
    step_id str
    role_id str
    since u64
}

/// Run metadata (title/task/origin/workspace + TaskPlan tracing)。对齐 hw
/// store.rs 全字段(wire parity;hw 各字段 #[serde(default)] 对 Option 冗余,
/// a2r Option 默认 None 等价)。
#[derive(Clone, Debug, Serialize, Deserialize, Default)]
pub type RunMetadata {
    title Option<str>
    initial_task Option<str>
    originating_chat_session Option<str>
    workspace_id Option<str>
    task_plan_id Option<str>
    task_run_name Option<str>
    phase_name Option<str>
    phase_index Option<uint>
    parent_run_id Option<str>
    root_run_id Option<str>
}

/// Request body for POST /api/forge/relay/runs.
/// `steps` 带 #[serde(default)] 对齐 hw store.rs:212(缺省请求体可省略 steps)。
#[derive(Clone, Debug, Deserialize)]
pub type StartRunRequest {
    run_id Option<str>
    flow_id Option<str>
    #[serde(default)]
    steps List<StartRunStep>
    task Option<str>
}

#[derive(Clone, Debug, Deserialize)]
pub type StartRunStep {
    id str
    role_id str
    gate Option<GateType>
}

// NOTE: RunState and RunEntry contain upstream crate::relay types
// (StepRecord, PipelineEngine) from auto_ai_agent::orchestration — those can't
// be re-declared as plain data, so they stay hand-written in relay/store.rs.
// RunStore (Mutex<HashMap> + disk IO) also stays hand-written (Mutex).
// The 7 structs + RunEvent above are the pure-data read models the frontend
// consumes and they port cleanly.
