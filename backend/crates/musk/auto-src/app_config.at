/// app_config.at — ported from backend/crates/musk/src/app_config.rs.
///
/// musk 运行时配置。Strategy (plan 014 mixed):
/// - MuskAppConfig / HarnessSelection structs + effective_* pure logic -> Auto
/// - load / parse_from_at / to_at_source (auto_atom/auto_val + AtomSource) ->
///   hand-written Rust (upstream crate APIs a2r can't express)
/// - apply_to_env / apply_app_config (env mutation) -> hand-written Rust

use.rust serde::{Serialize, Deserialize}
use.rust std::env

// ============================================================
// Config structs
// ============================================================

/// The app's harness selection: which OS-level harnesses it uses.
#[derive(Clone, Debug, Default, Serialize, Deserialize)]
pub type HarnessSelection {
    #[serde(default)]
    roles List<str>
    #[serde(default)]
    skills List<str>
    #[serde(default)]
    modes List<str>
}

/// musk runtime config (single source: ~/.config/autoos/apps/musk/config.at).
#[derive(Clone, Debug, Default, Serialize, Deserialize)]
pub type MuskAppConfig {
    #[serde(default)]
    daemon_url Option<str>
    #[serde(default)]
    default_mode Option<str>
    /// Forge 执行模式 "gsd"/"check"(Plan 022 遗留:useForgeMode 后端持久化)。
    #[serde(default)]
    forge_mode Option<str>
    #[serde(default)]
    context_file Option<str>
    #[serde(default)]
    serve_addr Option<str>
    #[serde(default)]
    auto_start_daemon Option<bool>
    #[serde(default)]
    harness HarnessSelection
}

ext MuskAppConfig {
    /// Effective daemon URL, merging: file < env `AAID_URL` < compiled default.
    /// (与 hw app_config.rs:150 一致;Plan 021 Phase B1 闭合原 env 覆盖缺失。)
    pub fn effective_daemon_url() str {
        is self.daemon_url.clone() {
            Some(url) -> return url,
            None -> {
                let env_opt Option<str> = env::var("AAID_URL").ok()
                is env_opt {
                    Some(u) -> return u,
                    None -> return "http://127.0.0.1:17654"
                }
            }
        }
    }

    /// Effective default mode (configured or "superpowers").
    pub fn effective_default_mode() str {
        is self.default_mode {
            Some(mode) -> return mode.clone(),
            None -> return "superpowers"
        }
    }

    /// Effective forge execution mode ("gsd" default; only "check" flips).
    pub fn effective_forge_mode() str {
        is self.forge_mode.clone() {
            Some(mode) -> {
                if mode == "check" {
                    return "check"
                };
                return "gsd"
            },
            None -> return "gsd"
        }
    }

    /// Effective serve addr (configured or default).
    pub fn effective_serve_addr() str {
        is self.serve_addr {
            Some(addr) -> return addr.clone(),
            None -> return "127.0.0.1:8080"
        }
    }

    /// Whether auto-start daemon is on (configured or default false).
    pub fn effective_auto_start() bool {
        is self.auto_start_daemon {
            Some(b) -> return b,
            None -> return false
        }
    }
}

// NOTE: load / parse_from_at / to_at_source (auto_atom/auto_val .at parse +
// AtomSource serialize), apply_to_env / apply_app_config (std::env mutation),
// and musk_config_path (path discovery) stay hand-written in app_config.rs.
// They use auto-lang upstream crate APIs and env mutation — a2r blind spots.
// The structs + effective_* defaults above port cleanly; load() populates the
// struct, effective_* read it.
