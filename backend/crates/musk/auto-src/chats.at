/// chats.at — ported from backend/crates/musk/src/chats.rs.
///
/// Persistent multi-turn chat sessions. Strategy (plan 014 mixed):
/// - data model (Role/ToolCall/ChatMessage/ChatSession/ChatSessionSummary)
///   + summary/append pure logic -> Auto
/// - new_id (rand) -> hand-written Rust (rand crate API, like auth.rs)
/// - ChatStore IO (load/save) -> Auto (specs.rs pattern: .view + serde_json)
///
/// Cross-module types: 自 C1(approve_spec_change 移植)起,SpecChange/SpecStatus/
/// SpecItem/SpecsDocument/SpecsSection/SpecsStore 直接引用真实
/// crate::auto_generated::specs(不再 self-contained mirror —— mirror 只有
/// Empty/Draft 两个 SpecStatus,无法支撑 approve 的完整状态机)。ChatSession 与
/// hw 一样携带 Vec<crate::specs::SpecChange>。

use.rust serde::{Serialize, Deserialize}
use.rust std::collections::HashMap
use.rust std::path::PathBuf
use.rust std::fs
use.rust std::time::{SystemTime, Duration}
use.rust serde_json::{to_string_pretty, from_slice}
use.rust crate::auto_generated::specs::{SpecChange, SpecItem, SpecsDocument, SpecsSection, SpecsStore}

fn now_sec() u64 {
    let now = SystemTime.now()
    let elapsed = now.elapsed().unwrap()
    return elapsed.as_secs()
}

// ============================================================
// Role / ToolCall / ChatMessage
// ============================================================

/// Who produced a message.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "lowercase")]
pub enum Role {
    User = 1
    Assistant = 2
    Tool = 3
}

/// A tool call recorded on an assistant message.
#[derive(Clone, Debug, Serialize, Deserialize)]
pub type ToolCall {
    #[serde(rename = "name", alias = "tool")]
    tool str
    #[serde(rename = "arguments", alias = "args")]
    args Value
    result str
    #[serde(default = "default_status", skip_serializing_if = "is_default_status")]
    status str
    #[serde(default, skip_serializing_if = "String::is_empty")]
    id str
}

/// Default tool-call status (used by serde `default = "default_status"`).
fn default_status() str {
    return "success"
}

/// Whether a tool-call status is the default (used by serde skip_serializing_if).
fn is_default_status(s str) bool {
    return s == "success"
}

// serde_json::Value re-aliased (a2r renders 'Value' -> serde_json::Value via
// the implicit serde_json import). args/result are JSON blobs.
use.rust serde_json::Value

/// A single chat message.
#[derive(Clone, Debug, Serialize, Deserialize)]
pub type ChatMessage {
    id str
    role Role
    content str
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    tool_calls List<ToolCall>
    created_at u64
}

ext ChatMessage {
    /// Factory: a user message. new_id() is hand-written Rust (rand).
    pub static fn user(content str) ChatMessage {
        return ChatMessage(
            id: new_id(8u),
            role: Role.User,
            content: content.clone(),
            tool_calls: [],
            created_at: now_sec()
        )
    }

    /// Factory: an assistant message.
    pub static fn assistant(content str) ChatMessage {
        return ChatMessage(
            id: new_id(8u),
            role: Role.Assistant,
            content: content.clone(),
            tool_calls: [],
            created_at: now_sec()
        )
    }
}

// ============================================================
// ChatSession + summary
// ============================================================

/// A persisted multi-turn chat session.
#[derive(Clone, Debug, Serialize, Deserialize)]
pub type ChatSession {
    id str
    name str
    mode str
    messages List<ChatMessage>
    created_at u64
    updated_at u64
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pending_spec_changes List<SpecChange>
    #[serde(default, skip_serializing_if = "Option::is_none")]
    workspace_id Option<str>
}

/// A lightweight summary for list views (no message bodies).
#[derive(Clone, Debug, Serialize, Deserialize)]
pub type ChatSessionSummary {
    id str
    name str
    mode str
    message_count uint
    preview str
    updated_at u64
}

ext ChatSession {
    /// Factory: a new empty session. new_id() is hand-written Rust (rand).
    pub static fn new(mode str, workspace_id Option<str>) ChatSession {
        let now u64 = now_sec()
        return ChatSession(
            id: new_id(12u),
            name: "New chat".to_string(),
            mode: mode.clone(),
            messages: [],
            created_at: now,
            updated_at: now,
            pending_spec_changes: [],
            workspace_id: workspace_id
        )
    }

    /// Build a list-view summary. Preview = last user message, truncated.
    /// iterator chain (iter/rev/find/map/chars/take/collect) rewritten as a
    /// reverse for-loop + a simple substring truncation.
    pub fn summary() ChatSessionSummary {
        // find last user message (reverse scan)
        var preview str = ""
        var i int = self.messages.len() as int - 1
        var done bool = false
        while done == false {
            if i < 0 {
                done = true
            } else {
                let m = self.messages[i]
                if m.role == Role.User {
                    preview = m.content.clone()
                    done = true
                } else {
                    i = i - 1
                }
            }
        }
        // truncate to 80 chars (best-effort: substring; full grapheme handling
        // is the original's chars().take(80) — a2r has no chars iterator, so we
        // slice by byte length, acceptable for ASCII-dominated chat previews).
        if preview.len() > 80u {
            preview = preview.substring(0, 80) + "…"
        }
        let result ChatSessionSummary = ChatSessionSummary(
            id: self.id.clone(),
            name: self.name.clone(),
            mode: self.mode.clone(),
            message_count: self.messages.len() as uint,
            preview: preview,
            updated_at: self.updated_at
        )
        return result
    }

    /// Append a message + bump updated_at. Auto-names from first user msg.
    /// a2r-11: build new messages list + whole-field reassign.
    /// 命名 `push_message`(非 hw 的 `append`):a2r 的 String 方法重映射表把
    /// `.append(...)` 无条件改写为 `.push_str(...)`(对 struct receiver 也误伤),
    /// 文档化 a2r 缺口。行为与 hw append 完全一致。
    pub mut fn push_message(msg ChatMessage) void {
        var new_messages List<ChatMessage> = self.messages.clone()
        new_messages.push(msg)
        var new_name str = self.name.clone()
        if self.name == "New chat" {
            // find first user message
            var found bool = false
            for m in new_messages.clone() {
                if found == false {
                    if m.role == Role.User {
                        var nm str = m.content.clone()
                        if nm.len() > 40u {
                            nm = nm.substring(0, 40) + ""
                        }
                        new_name = nm.trim() + ""
                        found = true
                    }
                }
            }
        }
        self.messages = new_messages
        self.updated_at = now_sec()
        self.name = new_name
    }
}

/// Insert a session into the map. Returns void so calls are safe as block
/// tails: `HashMap::insert` returns `Option<V>`, and a2r omits the trailing
/// `;` on if/else branch tails — a bare insert tail would leak `Option<V>`
/// as the branch type (E0308). Documented a2r codegen gap.
/// `k String` 为 owned 参数(Auto str 参数会映射成 &str;String 经 use.rust)。
fn map_insert(mut m HashMap<str, ChatSession>, k String, v ChatSession) void {
    let old Option<ChatSession> = m.insert(k, v)
}

/// Apply one SpecChange to a specs doc via the ag specs store (mirror of hw
/// apply_spec_change), 返回更新后的 doc 供调用方保存。跨模块调用标记:
/// - `.mut` → `&mut d`(a2r 的 fn_mut_params 只注册当前转译单元,对
///   crate::auto_generated::specs 的方法不注入 &mut;且 `mut p T` 参数发射
///   `p: &mut T` 缺 `mut` 绑定,`&mut p` 重借会 E0596 —— 所以按值收 doc +
///   `var d` 本地可变绑定,文档化 a2r 缺口)
/// - `.view` → `&field`(&str 参数;未知 callee 不自动 borrow owned String)
fn apply_spec_change_to_doc(doc SpecsDocument, store SpecsStore, change SpecChange) Result<SpecsDocument, str> {
    var d SpecsDocument = doc
    is change.status {
        Some(st) -> {
            let r Result<bool, str> = store.transition_item(d.mut, change.section_id.view, change.item_id.view, st)
            is r {
                Ok(ok) -> return Ok(d),
                Err(e) -> return Err(e)
            }
        },
        None -> {
            // 找 existing item(线性查找,s 是 &SpecsSection)
            var existing Option<SpecItem> = None
            for s in d.sections {
                if s.id == change.section_id {
                    for it in s.items {
                        if it.id == change.item_id {
                            existing = Some(it.clone())
                        }
                    }
                }
            }
            var item SpecItem = SpecItem.new(change.item_id.view, "")
            is existing {
                Some(e) -> { item = e },
                None -> {}
            }
            is change.title {
                Some(t) -> { item.title = t.clone() },
                None -> {}
            }
            is change.content {
                Some(c) -> { item.content = c.clone() },
                None -> {}
            }
            if item.title.len() == 0 {
                if item.content.len() == 0 {
                    item.title = "(empty)".to_string()
                }
            }
            let r Result<bool, str> = store.upsert_item(d.mut, change.section_id.view, item)
            is r {
                Ok(ok) -> return Ok(d),
                Err(e) -> return Err(e)
            }
        }
    }
}

// ============================================================
// ChatStore — JSON file persistence
// ============================================================

/// JSON-file-backed store of chat sessions, keyed by session id.
#[derive(Clone, Debug)]
pub type ChatStore {
    path PathBuf
}

ext ChatStore {
    /// Open a store at an explicit path.
    pub static fn at(path PathBuf) ChatStore {
        return ChatStore(path: path)
    }

    /// Load all sessions (empty map if missing/corrupt).
    pub fn load_map() HashMap<str, ChatSession> {
        let read_result = fs.read(self.path.clone())
        is read_result {
            Ok(bytes) -> {
                let parse_result = from_slice(bytes.view)
                is parse_result {
                    Ok(map) -> return map,
                    Err(e) -> return HashMap.new()
                }
            },
            Err(e) -> return HashMap.new()
        }
    }

    /// Persist the session map to disk.
    pub fn save_map(map HashMap<str, ChatSession>) bool {
        let parent = self.path.parent()
        is parent {
            Some(p) -> {
                let mkdir_result = fs.create_dir_all(p.clone())
                is mkdir_result {
                    Ok(ok) -> {},
                    Err(e) -> {}
                }
            },
            None -> {}
        }
        let json_result = to_string_pretty(map.view)
        is json_result {
            Ok(json) -> {
                let ok bool = fs.write(self.path.clone(), json)
                return ok
            },
            Err(e) -> return false
        }
    }
    /// Create + persist a new session; return it.
    /// C1: hw 签名 io::Result<ChatSession>(io::Error 不可表达 → Result<ChatSession,
    /// str>,文档化残差);session.id 由 new_id() 手写生成。
    pub fn create(mode str, workspace_id Option<str>) Result<ChatSession, str> {
        let session ChatSession = ChatSession.new(mode, workspace_id)
        var map HashMap<str, ChatSession> = self.load_map()
        map_insert(map, session.id.clone(), session.clone())
        if self.save_map(map) == false {
            return Err("write failed")
        }
        return Ok(session)
    }

    /// List all sessions as summaries, newest first (by updated_at desc).
    /// hw 用 sort_by(|a, b| b.updated_at.cmp(&a.updated_at)) —— a2r List 无闭包
    /// sort_by;手动稳定插入排序(降序;同刻保持原序,与 hw 稳定序一致)。
    pub fn list() List<ChatSessionSummary> {
        var map HashMap<str, ChatSession> = self.load_map()
        var summaries List<ChatSessionSummary> = []
        for s in map.values() {
            summaries.push(s.summary())
        }
        var sorted List<ChatSessionSummary> = []
        for s in summaries.clone() {
            var inserted bool = false
            var new_list List<ChatSessionSummary> = []
            for e in sorted.clone() {
                if inserted == false {
                    if s.updated_at > e.updated_at {
                        new_list.push(s.clone())
                        inserted = true
                    }
                }
                new_list.push(e)
            }
            if inserted == false {
                new_list.push(s.clone())
            }
            sorted = new_list
        }
        return sorted
    }

    /// Get one full session by id (no persistence side effect, like hw's
    /// load_map().remove(id) — the map isn't saved back).
    pub fn get(id str) Option<ChatSession> {
        var map HashMap<str, ChatSession> = self.load_map()
        var found Option<ChatSession> = None
        for s in map.values() {
            if s.id == id {
                found = Some(s.clone())
            }
        }
        return found
    }

    /// Rename a session. Ok(Some(updated)) if found; Ok(None) if not.
    /// not-found 分支写 `return Ok(target)`(target 此刻为 None)而非字面
    /// `Ok(None)`——a2r 的 fix_result_none_unit 会把字面 `Ok(None)` 无条件改写成
    /// `Ok(())`(破坏 Result<Option<T>, _> 的返回类型),文档化 a2r 缺口。
    pub fn rename(id str, name str) Result<Option<ChatSession>, str> {
        var map HashMap<str, ChatSession> = self.load_map()
        var target Option<ChatSession> = None
        var found bool = false
        var updated_map HashMap<str, ChatSession> = HashMap.new()
        for s in map.values() {
            if s.id == id {
                found = true
                var renamed ChatSession = s.clone()
                renamed.name = name.to_string()
                renamed.updated_at = now_sec()
                map_insert(updated_map, renamed.id.clone(), renamed.clone())
                target = Some(renamed)
            } else {
                map_insert(updated_map, s.id.clone(), s.clone())
            }
        }
        if found == false {
            return Ok(target)
        }
        if self.save_map(updated_map) == false {
            return Err("write failed")
        }
        return Ok(target)
    }

    /// Delete one session; return whether it existed.
    pub fn delete(id str) Result<bool, str> {
        var map HashMap<str, ChatSession> = self.load_map()
        var existed bool = false
        var updated_map HashMap<str, ChatSession> = HashMap.new()
        for s in map.values() {
            if s.id == id {
                existed = true
            } else {
                map_insert(updated_map, s.id.clone(), s.clone())
            }
        }
        if existed == false {
            return Ok(false)
        }
        if self.save_map(updated_map) == false {
            return Err("write failed")
        }
        return Ok(true)
    }

    /// Delete all sessions.
    pub fn delete_all() Result<bool, str> {
        var empty HashMap<str, ChatSession> = HashMap.new()
        if self.save_map(empty) == false {
            return Err("write failed")
        }
        return Ok(true)
    }

    /// Append a message to a session and persist. Ok(Some(updated)) or
    /// Ok(None) if the id wasn't found.
    pub fn append_message(id str, msg ChatMessage) Result<Option<ChatSession>, str> {
        var map HashMap<str, ChatSession> = self.load_map()
        var target Option<ChatSession> = None
        var found bool = false
        var updated_map HashMap<str, ChatSession> = HashMap.new()
        for s in map.values() {
            if s.id == id {
                found = true
                var updated ChatSession = s.clone()
                updated.push_message(msg.clone())
                map_insert(updated_map, updated.id.clone(), updated.clone())
                target = Some(updated)
            } else {
                map_insert(updated_map, s.id.clone(), s.clone())
            }
        }
        if found == false {
            return Ok(target)
        }
        if self.save_map(updated_map) == false {
            return Err("write failed")
        }
        return Ok(target)
    }

    /// Queue a spec change proposed by the agent (not yet applied). Returns
    /// the updated session, or Ok(None) if the id wasn't found.
    pub fn queue_spec_change(id str, change SpecChange) Result<Option<ChatSession>, str> {
        var map HashMap<str, ChatSession> = self.load_map()
        var target Option<ChatSession> = None
        var found bool = false
        var updated_map HashMap<str, ChatSession> = HashMap.new()
        for s in map.values() {
            if s.id == id {
                found = true
                var updated ChatSession = s.clone()
                updated.pending_spec_changes.push(change.clone())
                updated.updated_at = now_sec()
                map_insert(updated_map, updated.id.clone(), updated.clone())
                target = Some(updated)
            } else {
                map_insert(updated_map, s.id.clone(), s.clone())
            }
        }
        if found == false {
            return Ok(target)
        }
        if self.save_map(updated_map) == false {
            return Err("write failed")
        }
        return Ok(target)
    }

    /// Reject (discard) the spec change at `index` without applying it.
    /// Err if session not found OR index out of range (hw 同语义)。
    pub fn reject_spec_change(id str, index uint) Result<Option<ChatSession>, str> {
        var map HashMap<str, ChatSession> = self.load_map()
        var target Option<ChatSession> = None
        var found bool = false
        var updated_map HashMap<str, ChatSession> = HashMap.new()
        for s in map.values() {
            if s.id == id {
                found = true
                if index >= s.pending_spec_changes.len() as uint {
                    return Err("pending change index out of range")
                }
                // rebuild pending list without index
                var new_pending List<SpecChange> = []
                var i uint = 0
                for c in s.pending_spec_changes.clone() {
                    if i != index {
                        new_pending.push(c)
                    }
                    i = i + 1u
                }
                var updated ChatSession = s.clone()
                updated.pending_spec_changes = new_pending
                updated.updated_at = now_sec()
                map_insert(updated_map, updated.id.clone(), updated.clone())
                target = Some(updated)
            } else {
                map_insert(updated_map, s.id.clone(), s.clone())
            }
        }
        if found == false {
            return Err("session '" + id + "' not found")
        }
        if self.save_map(updated_map) == false {
            return Err("write failed")
        }
        return Ok(target)
    }

    /// Reject all pending spec changes for a session.
    pub fn reject_all_spec_changes(id str) Result<Option<ChatSession>, str> {
        var map HashMap<str, ChatSession> = self.load_map()
        var target Option<ChatSession> = None
        var found bool = false
        var updated_map HashMap<str, ChatSession> = HashMap.new()
        for s in map.values() {
            if s.id == id {
                found = true
                var updated ChatSession = s.clone()
                updated.pending_spec_changes = []
                updated.updated_at = now_sec()
                map_insert(updated_map, updated.id.clone(), updated.clone())
                target = Some(updated)
            } else {
                map_insert(updated_map, s.id.clone(), s.clone())
            }
        }
        if found == false {
            return Err("session '" + id + "' not found")
        }
        if self.save_map(updated_map) == false {
            return Err("write failed")
        }
        return Ok(target)
    }

    /// Approve the spec change at `index`: apply it to the specs doc (upsert
    /// or status transition via the ag specs store), then remove it from the
    /// pending queue. Returns the applied change + updated session, or Err if
    /// session/index not found. 残差: hw 取 `&SpecsStore`,a2r 无法表达 & 方法
    /// 参数 —— by-value + clone,文档化。
    pub fn approve_spec_change(id str, index uint, specs SpecsStore) Result<Option<(SpecChange, ChatSession)>, str> {
        var map HashMap<str, ChatSession> = self.load_map()
        var target Option<(SpecChange, ChatSession)> = None
        var found bool = false
        var updated_map HashMap<str, ChatSession> = HashMap.new()
        for s in map.values() {
            if s.id == id {
                found = true
                if index >= s.pending_spec_changes.len() as uint {
                    return Err("pending change index out of range")
                }
                // 提取 index 处的 change + 重建 pending 列表
                var pending List<SpecChange> = []
                var change_at Option<SpecChange> = None
                var i uint = 0
                for c in s.pending_spec_changes.clone() {
                    if i == index {
                        change_at = Some(c.clone())
                    } else {
                        pending.push(c)
                    }
                    i = i + 1u
                }
                var change SpecChange = SpecChange(section_id: "", item_id: "", title: None, content: None, status: None, reason: "")
                is change_at {
                    Some(c) -> { change = c },
                    None -> {}
                }
                // 应用进 specs 文档(specs 走 clone —— 后面还要 specs.save(doc))
                let doc_result Result<SpecsDocument, str> = specs.load()
                is doc_result {
                    Ok(d) -> {
                        var doc SpecsDocument = d
                        let apply_result Result<SpecsDocument, str> = apply_spec_change_to_doc(doc, specs.clone(), change.clone())
                        is apply_result {
                            Ok(updated_doc) -> {
                                let save_result Result<str, str> = specs.save(updated_doc)
                                is save_result {
                                    Ok(so) -> {},
                                    Err(se) -> return Err(se)
                                }
                            },
                            Err(ae) -> return Err(ae)
                        }
                    },
                    Err(e) -> return Err(e)
                }
                // 重建 session(去掉已批准的 change)+ 保存 chats
                var updated ChatSession = s.clone()
                updated.pending_spec_changes = pending
                updated.updated_at = now_sec()
                map_insert(updated_map, updated.id.clone(), updated.clone())
                let pair = (change.clone(), updated.clone())
                target = Some(pair)
            } else {
                map_insert(updated_map, s.id.clone(), s.clone())
            }
        }
        if found == false {
            return Err("session '" + id + "' not found")
        }
        if self.save_map(updated_map) == false {
            return Err("write failed")
        }
        return Ok(target)
    }
}
