use.rust clap::Parser

// main.at — CLI entrypoint data model.
// NOTE: only the `Cli` struct is expressed in Auto here. The actual main()
// / run_main() / make_client() / NoDaemonClient live in the hand-written
// main.rs (binary entrypoint) and depend on many extern symbols not available
// in this module. Keeping them here would produce "cannot find function"
// errors, so they are intentionally omitted from the Auto version.

#[derive(Parser)]
type Cli {
    cmd str
}
