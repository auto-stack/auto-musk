/// server_stream.at — daemon/SSE handler (server.rs 的 🔴→🟡 部分).
///
/// 之前判为 🔴 的 6 个 daemon/SSE handler，经 Plan 380 P1-dyn(Arc<dyn T>) +
/// Plan 321(async_stream ~Stream+yield) 后重新评估为可移植。本文件移植它们。
///
/// 流式 handler 的 dyn Fn 闭包 → named sink struct（Arc<dyn StreamSink>，P1-dyn）。
/// json!() 宏 → DTO。impl IntoResponse → concrete Response/Result。

use.rust axum::Json
use.rust axum::http::StatusCode
use.rust axum::response::Response
use.rust axum::response::sse::{Event, KeepAlive, Sse}
use.rust std::sync::Arc
use.rust std::convert::Infallible
use.rust std::collections::HashMap
use.rust serde::{Serialize, Deserialize}
use.rust serde_json::Value

// AppState (opaque extern — real one in server.rs with Arc<dyn Client>)
use.rust crate::server::AppState
use.rust axum::extract::{State}
use.rust axum::extract::{Path}
use.rust axum::extract::{Query}
use.rust crate::tools::{ReadFile, WriteFile, RunCommand}

// ============================================================
// DTOs for daemon/SSE handlers (replacing json!() macros)
// ============================================================

#[derive(Debug, Deserialize)]
pub type WorkflowRunRequest { task str, workflow str }

#[derive(Debug, Serialize)]
pub type WorkflowRunResponse { steps HashMap<str, str>, outputs HashMap<str, str> }

// WorkflowEvent DTO (replaces workflow_event_to_json's json!() every branch)
#[derive(Debug, Serialize)]
pub tag WorkflowEventDto {
    StepStart { step_id str, role str, input str }
    StepDone { step_id str, output str }
    StepSkipped { step_id str }
    Finished { steps HashMap<str, str>, outputs HashMap<str, str> }
}

// StreamEvent DTO (replaces stream_event_to_json's json!() every branch)
#[derive(Debug, Serialize)]
pub tag SseEventDto {
    Delta { text str }
    ToolStart { tool str, args str }
    Tool { tool str, args str, result str }
    Warning { text str }
    Done { output str, turns int, tool_calls List<ToolCallOut> }
    Cancelled
    Error { message str }
}

#[derive(Debug, Serialize)]
pub type ToolCallOut { tool str, args str, result str }

#[derive(Debug, Deserialize)]
pub type WorkspaceQuery { workspace Option<str> }

// mpsc channel pair (tx/rx as opaque Value)
#[derive(Clone)]
pub type Channel { tx Value, rx Value }

// ============================================================
// shared_tools — Vec<Arc<dyn Tool>> (P1-dyn)
// ============================================================

fn shared_tools() List<Arc<dyn Tool>> {
    var tools List<Arc<dyn Tool>> = []
    tools.push(Arc.new(ReadFile()))
    tools.push(Arc.new(WriteFile()))
    tools.push(Arc.new(RunCommand()))
    return tools
}

// Tool unit structs (extern — real impls in tools.rs)

// ============================================================
// workflow_event_to_dto — replaces workflow_event_to_json (json!→DTO)
// ============================================================

fn workflow_event_to_dto(ev) WorkflowEventDto {
    return workflow_event_map(ev)
}

// extern:上游 WorkflowEvent 匹配（auto_ai_agent 类型，在 .at 侧当不透明值）

// ============================================================
// workflow_run — 🟢 最干净的 daemon handler
// POST /api/workflow/run (concrete Result return)
// ============================================================

fn workflow_run(s State<AppState>, q Query<WorkspaceQuery>, body Json<WorkflowRunRequest>) ~Json<WorkflowRunResponse> {
    let resp = wf_run(s, q, body).await
    return Json(resp)
}

// extern: serve 侧提供的 workflow 执行（构建 Agent + wf.run().await + DTO 映射）

// ============================================================
// workflow_run_stream — 🟡 SSE (mpsc + spawn + ~Stream + yield)
// POST /api/workflow/run/stream
// ============================================================

fn workflow_run_stream(s State<AppState>, q Query<WorkspaceQuery>, body Json<WorkflowRunRequest>) ~Response {
    let ch = mpsc_channel()
    let tx = ch.tx
    let rx = ch.rx
    let sink = WorkflowStreamSink(tx: tx)
    wf_run_with_progress(s, q, body, Arc.new(sink)).await
    let stream = workflow_sse_stream(rx)
    var sse = Sse.new(stream)
    var ka = KeepAlive.new()
    ka = ka.interval_secs(15)
    return sse.keep_alive(ka).into_response()
}

fn workflow_sse_stream(rx) ~Stream<Result<Event, Infallible>> {
    while true {
        let msg = mpsc_recv(rx).await
        if msg_is_none(msg) {
            // channel closed
        } else {
            let dto = workflow_event_to_dto(msg)
            let event = Event.default().event("workflow").json_data(dto)
            yield Ok(event)
        }
    }
}

// StreamSink for workflow events (replaces dyn Fn closure)
spec StreamSink {
    fn on_event(ev)
}

type WorkflowStreamSink as StreamSink {
    tx Value

    fn on_event(ev) {
        let dto = workflow_event_to_dto(ev)
        mpsc_try_send(self.tx, dto)
    }
}



// extern: mpsc + workflow 执行 + tool_safety

// ============================================================
// run_stream_handler — 🟡 SSE (同 recipe)
// POST /api/run/stream
// ============================================================

fn run_stream_handler(s State<AppState>, q Query<WorkspaceQuery>, body Json<RunRequest>) ~Response {
    let ch = mpsc_channel()
    let tx = ch.tx
    let rx = ch.rx
    let sink = RunStreamSink(tx: tx)
    agent_run_stream(s, q, body, Arc.new(sink)).await
    let stream = run_sse_stream(rx)
    var sse = Sse.new(stream)
    var ka = KeepAlive.new()
    ka = ka.interval_secs(15)
    return sse.keep_alive(ka).into_response()
}

fn run_sse_stream(rx) ~Stream<Result<Event, Infallible>> {
    while true {
        let msg = mpsc_recv(rx).await
        if msg_is_none(msg) {
            // channel closed
        } else {
            let dto = stream_event_to_dto(msg)
            let event = Event.default().event("run").json_data(dto)
            yield Ok(event)
        }
    }
}

type RunStreamSink as StreamSink {
    tx Value

    fn on_event(ev) {
        let dto = stream_event_to_dto(ev)
        mpsc_try_send(self.tx, dto)
    }
}



fn stream_event_to_dto(ev) SseEventDto {
    return stream_event_map(ev)
}


#[derive(Debug, Deserialize)]
pub type RunRequest { task str, mode Option<str> }

// ============================================================
// conversation_stream — 🟡 SSE (Sse builder, no spawn)
// GET /api/conversations/{id}/stream
// ============================================================

fn conversation_stream(s State<AppState>, p Path<str>, q Query<WorkspaceQuery>) ~Response {
    let rx = conversations_subscribe(s, q)
    let id = path_inner(p)
    let stream = conv_event_stream(rx, id)
    var sse = Sse.new(stream)
    var ka = KeepAlive.new()
    ka = ka.interval_secs(15)
    return sse.keep_alive(ka).into_response()
}

fn conv_event_stream(rx, id str) ~Stream<Result<Event, Infallible>> {
    while true {
        let msg = broadcast_recv(rx).await
        if msg_is_none(msg) {
            // lagged or closed
        } else {
            let ev = msg_unwrap(msg)
            if conv_event_matches(ev, id) {
                let dto = ConvEventDto(conversation_id: conv_event_id(ev), turn: conv_event_turn(ev), status: conv_event_status(ev))
                let event = Event.default().event("conversation_event").json_data(dto)
                yield Ok(event)
            }
        }
    }
}

#[derive(Debug, Serialize)]
pub type ConvEventDto { conversation_id str, turn Option<str>, status Option<str> }


// ============================================================
// run / run_inner — 🟡 daemon handler (non-stream)
// POST /api/run
// ============================================================

fn run(s State<AppState>, q Query<WorkspaceQuery>, body Json<RunRequest>) ~Json<RunResponse> {
    let resp = agent_run(s, q, body).await
    return Json(resp)
}

#[derive(Debug, Serialize)]
pub type RunResponse { output str, tool_calls List<ToolCallOut> }


// ============================================================
// chat_stream — 🟡 最大改写 (SSE + agent.run_stream + history)
// GET /api/chats/session/{id}/stream
// ============================================================

fn chat_stream(s State<AppState>, p Path<str>, q Query<WorkspaceQuery>) ~Response {
    let ch = mpsc_channel()
    let tx = ch.tx
    let rx = ch.rx
    let sink = ChatStreamSink(tx: tx)
    chat_run_stream(s, q, p, Arc.new(sink)).await
    let stream = chat_sse_stream(rx)
    var sse = Sse.new(stream)
    var ka = KeepAlive.new()
    ka = ka.interval_secs(15)
    return sse.keep_alive(ka).into_response()
}

fn chat_sse_stream(rx) ~Stream<Result<Event, Infallible>> {
    while true {
        let msg = mpsc_recv(rx).await
        if msg_is_none(msg) {
            // closed
        } else {
            let dto = stream_event_to_dto(msg)
            let event = Event.default().event("chat").json_data(dto)
            yield Ok(event)
        }
    }
}

type ChatStreamSink as StreamSink {
    tx Value

    fn on_event(ev) {
        let dto = stream_event_to_dto(ev)
        mpsc_try_send(self.tx, dto)
    }
}



