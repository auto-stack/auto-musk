use.rust auto_ai_agent::{parse_at_workflow, Workflow}
use.rust std::fs

const FEATURE_DEV_AT str = #{ read_text("../workflows/feature-dev.at") }

pub fn builtin_names() List<str> {
    return ["feature-dev"]
}

pub fn load(spec_input str) Result<Workflow, str> {
    if spec_input == "feature-dev" {
        let r = parse_at_workflow(FEATURE_DEV_AT)
        is r {
            Ok(w) -> return Ok(w),
            Err(e) -> return Err(e.to_string())
        }
    }
    let content = fs.read_to_string(spec_input).unwrap()
    let r2 = parse_at_workflow(content.view)
    is r2 {
        Ok(w) -> return Ok(w),
        Err(e) -> return Err(e.to_string())
    }
}
