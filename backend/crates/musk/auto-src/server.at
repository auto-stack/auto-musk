/// server.at — ported from backend/crates/musk/src/server.rs (axum HTTP layer).
///
/// 全量移植 server.rs 的可移植 handler（45/52）。Strategy (plan 014):
/// - DTO struct + 所有 🟡 handler（json! 改 DTO、整体 extractor 参数、具体返回类型）-> Auto
/// - 7 个 🔴 handler（daemon/SSE/reqwest: run/run_stream/chat_stream/conversation_stream/
///   workflow_run/workflow_run_stream/settings_link）+ serve() 外壳（静态文件/CORS/
///   TcpListener/axum::serve）-> 手写 Rust
///
/// 关键转换规则（Plan 379 + 380 P0 后）:
/// - `impl IntoResponse` 多分支 -> 统一 `~Json<T>` 返回（错误也用 DTO，状态码在外壳层处理）
/// - `json!({"k":v})` -> 新建 DTO struct
/// - `State(s): State<AppState>` -> `s State<AppState>`（整体参数，函数体内访问 s.auth 等）
/// - `Path(id): Path<T>` -> `p Path<T>`
/// - handler 定义在 build_router 之前（a2r 单遍）

use.rust axum::Router
use.rust axum::routing::{get, post, delete, put, patch}
use.rust axum::Json
use.rust axum::response::Response
use.rust axum::extract::{State, Path, Query}
use.rust axum::http::HeaderMap
use.rust serde::{Serialize, Deserialize}
use.rust serde_json::Value

// ============================================================
// AppState (opaque — real one in server.rs has Arc<dyn Client>; here we
// declare only the field shapes handlers touch, as opaque extern refs)
// ============================================================

// AppState stays hand-written in server.rs (Arc<dyn Client> field). Handlers
// here declare `s State<AppState>` and access s.auth / s.registry — these are
// extern (the real AppState provides them). For isolated transpile/verify we
// treat AppState as an opaque extern type.
use.rust crate::server::AppState

// ============================================================
// Response DTOs (replacing json!() macros with typed structs)
// ============================================================

#[derive(Debug, Serialize)]
pub type StatusOk { status str }

#[derive(Debug, Serialize, Deserialize)]
pub type ApiError { error str }

#[derive(Debug, Serialize)]
pub type Deleted { status str, id str }

#[derive(Debug, Serialize)]
pub type Saved { status str, name str }

