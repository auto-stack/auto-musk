// ============================================================
// Handler helpers (pure functions)
// ============================================================

/// Extract bearer token from Authorization header.
fn bearer_token(headers HeaderMap) Option<str> {
    // upstream: headers.get("authorization")?.to_str(); simplified here
    return auth_header_token(headers)
}

// auth_header_token / WorkspaceQuery::id_or_default / store accessors are
// extern (provided by server.rs / AppState). Declared as extern fns for the
// isolated transpile; the real impls are hand-written Rust.

// ============================================================
// Health
// ============================================================

fn health() ~Json<StatusOk> {
    return Json(StatusOk(status: "ok"))
}

// ============================================================
// Auth handlers (use state.auth — extern AuthStore methods)
// ============================================================

pub fn auth_login(s State<AppState>, body Json<LoginRequest>) ~Response {
    // 单次 login(auth_login_result 返回 (token, role)),避免 split 版两次 login
    // 产生两个不同 session(role 查 session#1、token 是 session#2 → me() 失配)。
    // C3 状态码模型:失败返回 401(经 err_response),与手写版一致。
    let username str = body.username.clone()
    let pair = auth_login_result(s.view, username.clone(), body.password.clone())
    let token str = pair[0]
    let role str = pair[1]
    if token.len() > 0u {
        return ok_response(LoginResponse(token: token, user: UserInfo(username: username, role: role)))
    }
    return err_response("invalid credentials", 401u)
}

pub fn auth_me(s State<AppState>, headers HeaderMap) ~Response {
    // 与手写版一致:只返回 user;缺 token / 失效 session → 401。
    let token str = auth_token_from_headers(s.view, headers)
    if token.len() == 0u {
        return err_response("missing Authorization header", 401u)
    }
    let username str = auth_username_from_token(s.view, token.view)
    if username.len() == 0u {
        return err_response("invalid or expired session", 401u)
    }
    let role str = auth_role_from_token(s.view, token.view)
    return ok_response(UserInfo(username: username, role: role))
}

pub fn auth_logout(s State<AppState>, headers HeaderMap) ~Json<StatusOk> {
    auth_logout_token(s.view, headers)
    return Json(StatusOk(status: "logged out"))
}


