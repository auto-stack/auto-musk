mode {
    name : "superpowers"
    description : "Full agent with skills + brainstorm/plan/execute. Best for complex multi-step tasks."
    role : "assistant"
    skills : true
    tools : [
        read_file, write_file, edit_file,
        search, list_dir, list_symbols, glob,
        run_command, skill, spawn_relay, dispatch, bring_in
    ]
    workflow : "feature-dev"
    context_file : ".musk.md"
    extra_system_prompt : ""
}
